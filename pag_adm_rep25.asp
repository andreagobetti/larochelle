<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()da=request("da")a=request("a")ordina=request("ordina")if ordina="" then ordina="r"%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body><div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Ricarico articoli</a></div>        <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;" >        <!-- Colonna CORPO INIZIO-->                <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >               <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr >             <td colspan="4" style="border-bottom:1px solid;">Filtra per ricarico da <input name="da" id="da" type="text" value="<%=da%>" size="4">               a <input name="a" type="text" value="<%=a%>" size="4" id="a">              Cerca dati mancanti<input type="checkbox" name="dati_mancanti">              <select name="ordina" id="ordina">	              <option value="r" <%if ordina="r" then response.write " selected" %>>Ordina per: Ricarico</option>	              <option value="d" <%if ordina="d" then response.write " selected" %>>Ordina per: Data revisione</option>              </select>	                            <input type="submit" name="Submit" value="Visualizza" style="FONT: 12px;">              <span style="float: right;">                <button id="esporta_excel">Esporta excel</button>              <script>$(function () {    $("#esporta_excel").on("click", function (e) {				e.preventDefault();				var str_link="pag_adm_rep25_excel.asp?da="+$("#da").val()+"&a="+$("#a").val()+"&ordina="+$("#ordina").val();						window.location = str_link;								});			  });			  </script>              </span>              </td>          </tr></table></form>		<%sql="select prodotti.IDpro, prodotti.codice, prodotti.articolo, varianti_a.variante_a, varianti_b.variante_b, prodotti.prezzo, prodotti.costo, prodotti.data_agg_costo, magazzino.inventario, magazzino.quantita_riordino AS riordino, magazzino.data_aggiornamento, magazzino.quantita_magazzino, magazzino.db_ven, varianti_a.prezzo_ve_va, varianti_a.prezzo_ac_va, IF(prezzo_ve_va >0, (prezzo_ve_va-prezzo_ac_va)/prezzo_ac_va*100,(prezzo-costo)/costo*100) as ricarico FROM ((magazzino RIGHT JOIN prodotti ON magazzino.idpro = prodotti.IDpro) LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara) LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb "filtro=falseif isnumeric(da) and isnumeric(a) and a<>"" and da<>"" then	if da>a then		tmp=a		a=da		da=a	end if	sql=sql&" having ricarico between "&da& " and "&a	filtro=trueelseif request("dati_mancanti")<>"" thensql=sql&" having ricarico is null"end ifif ordina="r" then	sql=sql&" order by ricarico desc"else	sql=sql&" order by data_agg_costo"end ifPaginazioneString="&da="&da&"&a="&a&"&ordina="&ordinacall paginazione_start(sql,200,"")%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">	        <%if filtro then %>          <tr>             <td colspan="7" class="ui-widget-header">Articoli con ricarico da <%=da%> a <%=a%></td>          </tr>          <%end if %>          <tr style="border-bottom:1px solid;">            <td bgcolor="#E5E5E5" >&nbsp;</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Codice</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Articolo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Varianti</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Prezzo di vendita</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Prezzo di acquisto</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data revisione</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Ricarico %</td>          </tr>          <%totale=0iRecordsShown = 0Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>          <tr style="border-bottom:1px solid;">            <td ><input name="" type="checkbox" value=""></td>             <td ><a href="product.asp?idpro=<%=objPagingRS("idpro")%>"><%=objPagingRS("codice")%></a></td>            <td ><%=objPagingRS("articolo")%></td>            <td ><%=codifica_varianti_ordine(objPagingRS("variante_a"), "", objPagingRS("variante_b"), "")%></td>            <%	            prezzo=objPagingRS("prezzo")	            costo=objPagingRS("costo")	            if not isnull(objPagingRS("prezzo_ve_va")) then	            if cdbl(objPagingRS("prezzo_ve_va"))>0 then		            prezzo=objPagingRS("prezzo_ve_va")		            costo=objPagingRS("prezzo_ac_va")	            end if	            end if	            %>            <td align="right"><%=prezzo%></td>            <td align="right"><%=costo%></td>            <%	            if not isnull(objPagingRS("data_agg_costo")) then	            	ricarico=formatdatetime(objPagingRS("data_agg_costo"),0)	            else		            ricarico=""		        end if	            %>            <td align="right"><%=ricarico%></td>                        <%	            if not isnull(objPagingRS("ricarico")) then	            	ricarico=formatnumber(objPagingRS("ricarico"),0)	            else		            ricarico="???"		        end if	            %>            <td align="right"><%=ricarico%></td>          </tr>          <% 		iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(8,true)		%>        </table></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>