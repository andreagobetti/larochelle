<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include file="ClasseOrdine.asp"--><%idord=Request("idord")nord=Request("nord")dove=Request("dove")oper=lcase(request("oper"))tabella=lcase(request("tabella"))str_add2log="<b>Querystring</b>:"aggiornato=trueselect case tabella	case "ordini"	cosa="ordine"	case "preventivi"	cosa="preventivo"	case "ordini_fornitori"	cosa="ordine fornitore"end selectif tabella="" then 	add2log "Errore, manca dove o errato:"&str_add2log,3	response.write "Errore, contesto errato o non specificato" 	response.endend ifif tabella<>"" then	if oper="riordina" then		getItems = Request.QueryString("id[]")		'split them junks into array		getItems = Split(getItems, ",")		'For each one, define and then execute the sql statement		i_max=UBound(getItems)		i_max=i_max*2		For i = LBound(getiTems) TO i_max step 2		   sql_update = "UPDATE "&tabella&"_dett SET ordine = " & i & " WHERE iddett = " & getItems(i/2)		   'execute this bitch		   conn.Execute sql_update		   'below used for debugging - comment out		   'Response.Write("ID " & getItems(i) & " was set to position " & i)			'response.write "."		Next		response.write  (i/2)&" articoli ordinati correttamente"		'add2log "Elementi ["&cosa&"="&idord&";"&nord&"] ordinati da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",1	elseif request.querystring("aggiungisotto")<>"" then		iddett=request.querystring("iddett")		sql="select * from "&tabella&"_dett where iddett="&iddett		Set rs = Server.CreateObject("ADODB.Recordset")		rs.Open sql, conn, 3, 3		ordine=rs("ordine")		rs.addnew		rs("idord")=idord		rs("ordine")=ordine+1		rs("quantita")=-1		'rs("codice_ordine")=null		rs("articolo_ordine")=""		rs("modificato")=true		rs.update		response.write rs("iddett")		rs.close		Set rs = Nothing		call riordina_dettaglio(idord,tabella)		'add2log "Aggiunto riga sotto ["&cosa&"="&idord&";"&nord&"] da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",1	elseif request.querystring("aggiungisopra")<>"" then		iddett=request.querystring("iddett")		sql="select * from "&tabella&"_dett where iddett="&iddett		Set rs = Server.CreateObject("ADODB.Recordset")		rs.Open sql, conn, 3, 3		ordine=rs("ordine")		rs.addnew		rs("idord")=idord		rs("ordine")=ordine-1		rs("quantita")=-1		'rs("codice_ordine")=null		rs("articolo_ordine")=""		rs("modificato")=true		rs.update		response.write rs("iddett")		rs.close		Set rs = Nothing		call riordina_dettaglio(idord,tabella)		'add2log "Aggiunto riga sopra ["&cosa&"="&idord&";"&nord&"] da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",1	elseif instr(oper,"elimina")>0 then		iddett=request.querystring("iddett")		sql="select * from "&tabella&"_dett where iddett="&iddett		Set rs = Server.CreateObject("ADODB.Recordset")		rs.Open sql, conn, 3, 3		add2log "Modificato ["&replace(tabella_singolare(tabella)," ","_")&"="&idord&"]"&nord&"[/"&replace(tabella_singolare(tabella)," ","_")&"]"&vbcrlf&"Eliminato riga <b>"&rs("articolo_ordine")&"</b> quantita: "&rs("quantita"),2		rs.delete		rs.close		Set rs = Nothing		call aggiorna_ordine(idord, tabella, false)		call riordina_dettaglio(idord,tabella)		'add2log "Eliminato riga ["&cosa&"="&idord&";"&nord&"] da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",1		'response.write "riga_eliminata"	elseif oper="salva_nota" or oper="modifica_nota" then		'iddett=cint(request.querystring("iddett"))		sql="select * from "&tabella&" where idord="&idord		Set rs = Server.CreateObject("ADODB.Recordset")		rs.Open sql, conn, 3, 3		nota=trim(request.form("nota"))		session("test_nota")=nota		nota=replace(nota,"</p><p>","<br>")		nota=replace(nota,"<p>","")		nota=replace(nota,"</p>","")		if oper="modifica_nota" then modifica_nota=" (nota modificata)"		nota= now()&" <b>"&session("nominativo")&"</b>"&modifica_nota&":<br>"&nota		if isnull(rs("note_gestore")) or len(trim(rs("note_gestore")))=0 or oper="modifica_nota"  then			rs("note_gestore")=nota		else			rs("note_gestore")=rs("note_gestore")&"<hr />"& nota		end if				rs.update		nota=rs("note_gestore")		rs.close		set rs=nothing		response.write nota	elseif oper="delete_file" then		call elimina_allegato(request("id_file"))		response.write "Allegato eliminato"	elseif oper="registro" then		cosa=request.querystring("cosa")		id=request.querystring("id")		if cosa<>"" and id<>"" then			sql="select * from log " 			sql=sql & " where instr([evento],'["&cosa&"="& id&";')"			sql=sql&" order by idlog desc"			Set rs = Server.CreateObject("ADODB.Recordset")			rs.Open sql, conn, 3, 3	%>            <div align="left" style="border: 1px solid gray; background: #E5E5E5; padding-top: 5px; padding-bottom:5px;">			<%			do while not rs.eof			response.write rs("data")&" "			response.write rs("causale")&" "			response.write rs("evento")&"<br>"			rs.movenext			loop			%>            </div>		  <%			rs.close			set rs=nothing		  end if	end if				if instr(oper,"tbody")>0  then		set ordine= (new ClasseOrdine)(array(tabella,idord,"totali"))		'Aggiungo articolo		if request("aggiungiarticolo")="si" then			n=ordine.aggiungi(request("aggiungo"))		end if				if tabella="ordini" then	'-------------------------------------------		'set ordine= (new ClasseOrdine)(array(tabella,idord,"totali"))			ordine.elenco_articoli()			ordine.elenco_totali()			set ordine = Nothing			end if	if tabella="ordini_fornitori" then	sql1="select ordini_fornitori.*, utenti_fornitori.importo_minimo FROM ordini_fornitori LEFT JOIN utenti_fornitori ON ordini_fornitori.iduser = utenti_fornitori.iduser where idord="&idord			Set rs1 = Server.CreateObject("ADODB.Recordset")		rs1.open sql1,conn,3,3		nord=rs1("nord")		stato=rs1("stato")        sql=replace(ordini_dett_esteso,"ordini",tabella)&" where idord="&idord &" order by ordine "		set rs=conn.execute(sql)	%>	<tbody id="tab_ordine_body">            <%totord=0	  do while not rs.eof			%>            <tr valign="middle" <%if rs("modificato")=true then response.write ("bgcolor='#FFcc00'")%> id="id_<%=rs("iddett")%>">		      <td align="center" style="border-bottom: 1px solid gray; padding-bottom:10px; padding-top:10px;"><input type="hidden" name="iddett<%=rs("iddett")%>" value="SI">              <%if stato<=1 then%>              <input type="hidden" name="selcs<%=rs("iddett")%>" id="selcs_<%=rs("iddett")%>" class="selezione">              <div class="div_icona"><span class="ui-icon ui-icon-triangle-1-s ui-state-default ui-corner-all left_menu" id="<%=rs("iddett")%>" data-ordine="<%=rs("ordine")%>" ></span></div>              <div class="div_icona"><span class="ui-icon ui-icon-arrowthick-2-n-s ui-state-default ui-corner-all handle" ></span></div><div id="sel_<%=rs("iddett")%>" class="ui-state-default ui-corner-all div_icona"></div><%end if%>                            <b><a href="product.asp?idpro=<%=RS("idpro")%>" title="Clicca per la scheda prodotto" ><%=RS("codice_ordine")%></a></b>              </td>               <td style="border-bottom: 1px solid gray;"><%if rs("codice_ordine")<>"" then%><%=rs("articolo_ordine")%><%else %><input type="text" name="articolo<%=rs("iddett")%>" size="" value="<%=rs("articolo_ordine")%>" style="width:99%;"><%end if%><br>               <%					txt=""					if rs("var1")<>"" then						txt ="&nbsp;" & rs("variante1_ordine") & ": " & rs("var1") 					end if					if rs("var2")<>"" then						txt =txt & "&nbsp;" & rs("variante2_ordine") & ": " & rs("var2")					end if					response.write txt			  %>     </td>              <td align="right" style="border-bottom: 1px solid gray;">			 <%			  	prezzoeff=rs("prezzo")                if stato>1 then %>              <%=formatcurrency(prezzoeff,2)%>              <%else %>				<input type="text" name="prezzo<%=rs("iddett")%>" size="8" value="<%=FormatNumber(rs("prezzo"),2,,,0)%>" style="text-align:right;" class="chkchge">              <%end if%>				</td>                <%				stile=""				if rs("quantita")>rs("quantita_magazzino") then stile=" color:red;"				%>              <td align="center" valign="middle" style="border-bottom: 1px solid gray;<%=stile%>"><%=rs("um")%>&nbsp;                <%if stato>1 then %>                <%=rs("quantita")%>                <%else %>                <input type="text" name="quantita<%=rs("iddett")%>" size="3" value="<%=rs("quantita")%>" style="text-align:right;">              <%end if%>              /<%=CancellettoSeNull(rs("quantita_magazzino"))%></td>              <td align="right" valign="middle" nowrap style="border-bottom: 1px solid gray;">&#8364; <%=FormatNumber((prezzoeff*rs("quantita")),2)%></td>            </tr><%			totord=totord+round(prezzoeff*rs("quantita"),2)            rs.movenext			loop			set rs=nothing			%>			</tbody>          			<tbody id="tab_ordine_totali">            <tr valign="middle" align="right" >              <td colspan="5" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;">Totale IVA esclusa: &#8364; <%=FormatNumber(totord,2)%></td>            </tr>            <tr valign="middle" align="right" >              <td colspan="5" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;">IVA <%=iva(rs1("data"))%>%: <%if rs1("iva_0")=true then			  response.write "Esenzione stato estero"			  else			   response.write "&#8364; "&FormatNumber(totord*iva(rs1("data"))/100,2)			   totord=totord*(1+iva(rs1("data"))/100)			   end if%></td>            </tr>            <%			totord=round(totord,2)			rs1("totale")=totord			rs1.update					if isnull(rs1("importo_minimo")) or rs1("importo_minimo")=0 then	colore="bgcolor='#E5E5E5'"elseif rs1("importo_minimo")<rs1("totale") then	importo_minimo="Importo minimo ordine: "&formatcurrency(rs1("importo_minimo"),2)&" "	colore="bgcolor='#99FF99'"else	importo_minimo="Importo minimo ordine: "&formatcurrency(rs1("importo_minimo"),2)&" "	colore="bgcolor='#FFCCCC'"end if 			%>			<%			if importo_minimo<>"" then			%>			    <tr valign="middle" align="right" <%=colore%>>              <td colspan="5" style="border-bottom: 1px solid gray; padding-top: 3px; padding-bottom:3px;"><%=importo_minimo%></td>            </tr>			<%end if%>			            <tr valign="middle" align="right" <%=colore%>>              <td colspan="5" style="border-bottom: 1px solid gray; padding-top: 3px; padding-bottom:3px;"><input type="hidden" name="versione" value="<%=rs1("versione")%>"><b>Totale: &#8364; <%=FormatNumber(totord,2)%></b></td>            </tr>            <%if utente_andrea then%>				<tr valign="middle" align="right" >					<td colspan="5" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;"><b>Versione<%=rs1("versione")%></b></td>				</tr>				<%end if%>			</tbody>			<%			rs1.close			set rs1=nothing			end if			'add2log "Tabella idord "&idord&" aggiornata",1	end if	if tabella="preventivi" then		sql1="select * FROM "&tabella&" where idord="&idord		Set rs1 = Server.CreateObject("ADODB.Recordset")		rs1.open sql1,conn,3,3		nord=rs1("nord")		stato=rs1("stato")		'Conversione decimal in dbl		totale_ordine=cdbl(rs1("totale"))		trasporto=cdbl(rs1("trasporto"))		sconto_ordine=cdbl(rs1("sconto_ordine"))		imposta_ordine=cdbl(rs1("imposta_ordine"))        sql=replace(ordini_dett_esteso,"ordini",tabella)&" where idord="&idord &" order by ordine "		set rs=conn.execute(sql)%>                      <tbody id="tab_ordine_body">            <%totord=0	  do while not rs.eof			%>      <tr valign="middle" <%if rs("modificato")=true then response.write ("bgcolor='#FFcc00'")%> id="id_<%=rs("iddett")%>">		      <td align="center" style="border-bottom: 1px solid gray; padding-bottom:10px; padding-top:10px;"><input type="hidden" name="iddett<%=rs("iddett")%>" value="SI">                           <%if stato<=1 then%>              <input type="hidden" name="selcs<%=rs("iddett")%>" id="selcs_<%=rs("iddett")%>" class="selezione">              <div class="div_icona"><span class="ui-icon ui-icon-triangle-1-s ui-state-default ui-corner-all left_menu" id="<%=rs("iddett")%>" data-ordine="<%=rs("ordine")%>" ></span></div>              <div class="div_icona"><span class="ui-icon ui-icon-arrowthick-2-n-s ui-state-default ui-corner-all handle" ></span></div><div id="sel_<%=rs("iddett")%>" class="ui-state-default ui-corner-all div_icona"></div><%end if%>                            <b><a href="product.asp?idpro=<%=RS("idpro")%>" title="Clicca per la scheda prodotto" ><%=RS("codice_ordine")%></a></b>            </td>              <td style="border-bottom: 1px solid gray;"><%if rs("codice_ordine")<>"" then%><%=rs("articolo_ordine")%><%else%><input type="text" name="articolo<%=rs("iddett")%>" size="" value="<%=rs("articolo_ordine")%>" style="width:99%;"><%end if%><br>               <%					txt=""					if rs("var1")<>"" then						txt ="&nbsp;" & rs("variante1_ordine") & ": " & rs("var1") 					end if					if rs("var2")<>"" then						txt =txt & "&nbsp;" & rs("variante2_ordine") & ": " & rs("var2")					end if					response.write txt			  %>     </td>              <td align="right" style="border-bottom: 1px solid gray;"><%			  	prezzoeff=rs("prezzo")                if stato>1 then %>                <%=formatcurrency(prezzoeff,2)%>                <%else %>					<input type="text" name="prezzo<%=rs("iddett")%>" size="8" value="<%=FormatNumber(rs("prezzo"),2,,,0)%>" style="text-align:right;" class="chkchge">                <%end if%>								<%				prezzoeff=prezzoeff-(rs("sconto_prodotto")/100)*prezzoeff				%></td>                <%				stile=""				'if rs("quantita")>rs("quantità") then stile=" color:red;"				%>              <td align="center" valign="middle" style="border-bottom: 1px solid gray;<%=stile%>"><%=rs("um")%>&nbsp;                <%if stato>1 then %>                <%=rs("quantita")%>                <%else%>                <input type="text" name="quantita<%=rs("iddett")%>" size="3" value="<%=rs("quantita")%>" style="text-align:right;">              <%end if%>              /<%'=CancellettoSeNull(rs("quantità"))%></td>              <td align="center" valign="middle" style="border-bottom: 1px solid gray;">&nbsp;                <%if stato>1 then %>                <%=FormatNumber(rs("sconto_prodotto"),2)%>                <%else%>                <input type="text" name="sconto_prodotto<%=rs("iddett")%>" size="4" value="<%=FormatNumber(rs("sconto_prodotto"),2)%>" style="text-align:right;">                <%end if%></td>              <td align="right" valign="middle" nowrap style="border-bottom: 1px solid gray;"><%=formatcurrency((prezzoeff*rs("quantita")),2)%></td>            </tr><%			totord=totord+round(prezzoeff*rs("quantita"),2)            rs.movenext			loop			set rs=nothing			%>                        </tbody>			<tbody id="tab_ordine_totali">				<tr valign="middle" align="right" >					<td colspan="6" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;">Spese di trasporto (<%=tipo_trasporto(rs1("tipo_trasporto"))%>): &#8364;					  <%if stato>1 then %>						  <%=FormatNumber(rs1("trasporto"),2)%>					  <%else %>						  <input type="text" name="trasporto" size="7" value="<%=FormatNumber(rs1("trasporto"),2)%>" style="text-align:right;" id="trasporto">					  <%end if%>					</td>				</tr>				<%totord=totord+trasporto%>				<tr valign="middle" align="right" >					<td colspan="6" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;">Totale IVA esclusa: &#8364; <span id="iva_esclusa"><%=FormatNumber(totord,2)%></span>					</td>				</tr>				<%				testo_esenzione=" "&trattamento_iva(rs1("trattamento_iva_ordine"))				if esenzione_iva(rs1("trattamento_iva_ordine")) then					valore_iva=0					if rs1("trattamento_iva_ordine")=10 then						valore_iva=totord*iva(rs1("data"))/100						testo_esenzione=""					end if				else					valore_iva=totord*iva(rs1("data"))/100					totord=totord*(1+iva(rs1("data"))/100)				end if				%>				<tr valign="middle" align="right" >				<td colspan="6" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;">IVA <span id="iva"><%=iva(rs1("data"))%></span>%<%=testo_esenzione%>: &#8364; <span id="valore_iva"><%=FormatNumber(valore_iva)%></span></td>				</tr>				<%if rs1("trattamento_iva_ordine")=10 then%>					<tr valign="middle" align="right" >						<td colspan="6" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;"><%=trattamento_iva(rs1("trattamento_iva_ordine"))%>: &#8364; <span id="valore_iva">-<%=FormatNumber(valore_iva)%></span></td>					</tr>				<%end if%>				<tr valign="middle" align="right" >					<td colspan="6" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;">Sconto: &#8364;					  <%if stato>1 then %>						  <%=FormatNumber(rs1("sconto_ordine"),2)%>					  <%else %>						  <input type="text" name="sconto_ordine" size="7" value="<%=FormatNumber(sconto_ordine,2)%>" style="text-align:right;" id="sconto_ordine">					  <%end if %>					</td>				</tr>				<%				if sconto_ordine>0 then totord=totord-sconto_ordine				totord=round(totord,2)				if totale_ordine<>totord and aggiornato=false then					add2log "Discordanza totale [ordine="&idord &";"&nord&"]<br>Totale database:"&rs1("totale")&"<br>Totale ricalcolato:"&totord&"<br>Trasporto:"&rs1("trasporto")&"<br>Sconto ordine:"&sconto_ordine,2				end if				rs1("totale")=totord				rs1.update								%>				<tr valign="middle" align="right" >					<td colspan="6" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;"><input type="hidden" name="versione" value="<%=rs1("versione")%>"><b>Totale: &#8364; <span id="totale"><%=FormatNumber(totord,2)%></span></b>					</td>				</tr>				<%if utente_andrea then%>				<tr valign="middle" align="right" >					<td colspan="6" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;"><b>Versione<%=rs1("versione")%></b></td>				</tr>				<%end if									rs1.close				Set rs1 = Nothing				%>			</tbody>	<%	end ifend if	call connclose()call CheckConnChiusa()%>