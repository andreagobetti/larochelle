er-bottom:1px solid;">  Articolo da aggiungere                <input name="testo" type="text" style="font-size:16px; height: 22px; width:240px;" size="45" autocomplete=off onKeyUp="ajax_showOptions(this,'articolo',event)">         <input type="hidden" id="testo_hidden" name="idpro"><input type="hidden" name="aggiungi"> <input type="button" value="Aggiungi" onClick="Valida_aggiungi()"></td>            </tr>          </table><%sql="select articoli_consigliati_prodotti.*, prodotti.codice, prodotti.articolo "sql=sql &" FROM articoli_consigliati_prodotti INNER JOIN prodotti ON articoli_consigliati_prodotti.idpro = prodotti.IDpro WHERE (((articoli_consigliati_prodotti.id_pro_consigliati)="& id_pro_consigliati &")) "sql= sql & "ORDER BY codice;"'set rs=conn.execute(sql)rs.Open sql,conn,3,3%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header">Articoli visualizzati <%=rs.recordcount%></td>            </tr>            <tr>               <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Elimina&nbsp;</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Correlazioni</td>            </tr>            <%	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="elimina" value="<%=rs("id")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=rs("codice") & " " & rs("articolo")%></td>            </tr>            <%	rs.movenext	loop	rs.close	set rs=nothing	conn.Close	Set conn=Nothing	%>          </table>			<%end if			conn.Close	Set conn=Nothingend if%>        </form>  <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><script src="Jquery/Js/fancyBox/jquery.fancybox.js"></script><script type="text/javascript" src="Jquery/js/jquery.validate.min.js"></script><script type="text/javascript" src="Jquery/js/jquery.validate.min_it.js"></script><script>jQuery(document).ready(function ($) {      $('#apriFileManager').click().fancybox({			  'width'	: 900,			  'height'	: 600,			  'type'	: 'iframe',			  'autoScale'   : false,			  'autoResize': false,			  'minHeight':600,			  'href':'filemanager123/dialog.php?type=1&field_id=ImmagineBrand&fldr=brands'      });});</script><script type="text/javascript" language="javascript">	function responsive_filemanager_callback(field_id){	console.log(field_id);	var url=jQuery('#'+field_id).val();	//alert('update '+field_id+" with "+url);	$("#immagine").attr("src", url);		$("#immagine").load(function(){		var h=100,w=170		$(this).removeAttr('width').removeAttr('height')		var actualHeight =$(this).height(),actualWidth=$(this).width()		$(this).attr({height:h,width:w}).data({height: actualHeight, width: actualWidth})		console.log(this.src,actualHeight,actualWidth)		var testo="";		if (actualWidth < 165 || actualWidth > 175) {			testo="<br>La larghezza dell'immagine è di "+actualWidth+"pixel";			}		if (actualHeight < 98 || actualHeight > 101) {			testo+="<br>L'altezza dell'immagine è di "+actualHeight+"pixel";			}		if (testo!=""){			testo+="<br><b>Immagine non conforme</b><br>Le dimensioni dell'immagine devono essere:<br>Larghezza: 170pixel  Altezza: 100pixel"			$("#msg").html(testo);			immagineok=false;					}		else		{				$("#msg").html("");				immagineok=true;		}				})				//your code}$(function() {	responsive_filemanager_callback("ImmagineBrand");});</script></body></html><%rsClosesub mappacatselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM settori WHERE idpadre = " & id &" and idsettore<>"&escludi&" order by nome_settore;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("idsettore") &""""		if int(val)=int(rs_order("idsettore")) then response.write " selected"		response.write ">" &spaceing& rs_order("nome_settore")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappacatselezione(layer+1,rs_order("idsettore"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	sub riordina()			sql="select * from brand  order by ordine;"			Set rs = Server.CreateObject("ADODB.Recordset")			rs.open sql, conn,3,3			ordine=10			do while not rs.eof			rs("ordine")=ordine			rs.update			ordine=ordine+10			rs.movenext			loop			rs.close			Set rs = NothingEnd Sub	%>