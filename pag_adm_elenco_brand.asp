mg src="<%=testo%>" <%if testo<>"" then %> style="display: hidden;"<%end if%> id="immagine" ><input type="hidden" name="ImmagineBrand" value="<%=testo%>" id="ImmagineBrand">   <span id="msg"></span> <br><input type="button" id="apriFileManager" value="Seleziona immagine"><br>				Dimensione immagine brand: 170px X 100px          </td>            </tr>                        <tr>              <td valign="top">Visualizza in Home page</td>              <td><%val=""				if oper="edit" then					if rs("in_home")=1 then val=" checked"				elseif oper="new" then					val=""				else					val=request.form("in_home")					if val="si" then val=" checked"				end if				if val<>" checked" then val=""				%>              <input type="checkbox" name="in_home" value="si" title="Visualizza nella home page" <%response.write val%><%if view="view" then response.write " disabled"%>></td>            </tr>			<%if error<>"" then			  		val=request.form("link")				elseif oper="edit" then					val=rs("link")			  	elseif oper="new" then			  		val=""				end if%>            <tr>              <td align="right" valign="top">Collegamento</td>              <td><input type="text" name="link" id="link" value="<%=val%>" size="40">Collega a settore              <%			  if instr(val,"idsettore=")>0 then				  val=estrainumero(val)			  else				  val=null			  end if			  %><select name="settore" id="settore" >              <option value="">Nessuno</option><%Set rsm=conn.execute("select * from settori where idpadre=0 "&where&" order by nome_settore ;")do while not rsm.eofresponse.write "<option value=""" & rsm("idsettore") &""""if int(val)=int(rsm("idsettore")) then response.write " selected"response.write ">" & rsm("nome_settore")& "</option>"call mappacatselezione(1,rsm("idsettore"),val,idsettore)rsm.movenextlooprsm.close%></select><script>$(function () {    $("#settore").on("change", function (e) {				//e.preventDefault();				var val=$("#settore").val();				if (val=