<%t_inizio=timer()%><!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/ClasseOrdine.asp" --><%	iduser=request("iduser")	idord=request("idord")		if request.form("calcola")<>"" then		calcola=true	else		calcola=false	end if	if request.form("aggiungi")<>"" then		set ordine= (new ClasseOrdine)(array("aggiungi_spettanze",idord,iduser))		set ordine_Dictionary = Nothing		call connclose()		Response.redirect "pag_adm_ordini.asp?idord="&idord	end if	oper=request("oper")	if oper="" then		oper="view"	end if'response.write oper%><!--#include virtual="/sub_head_adm.asp" --><link rel="stylesheet" href="Jquery/Js/stickyRows/stickyRows.css"><style>	 th {  position: relative;  padding: 10px;	border: 1px solid black;}th span {  transform-origin: 0 50%;  transform: rotate(-90deg);   white-space: nowrap;   display: block;  position: absolute;  bottom: 0;  left: 50%;}tr {	border-bottom:1px solid;}#spettanze td{	border: 1px solid black;}.legenda{	padding:3px; margin:3px;	}.spett{	text-align: center;	width: 20px;}</style></head><body><div id="wrap"><div id="header"><%=titolo_top%>         <!-- Box CORPO INIZIO-->		<%barra=0%>			<div id="barra_fissa">			  <!--#include virtual="/sub_barra_adminsf2.asp" -->			</div>		<%			set rs_ordine=conn.execute ("select ordini.nord, ordini.iduser from ordini where idord="&idord)	 			iduser=rs_ordine("iduser")			nord=rs_ordine("nord")			set rs_ordine = nothing			if oper="add" then				testo="Carica spettanze"			else				testo="Spettanze"			end if						%>         <div class="ui-widget-header ui-corner-top titolo_admin">			<a href="<%="pag_adm_ordini.asp?idord="&idord%>">Ordine <%=nord%></a> > <a href="<%=questofile&"?idord="&idord%>"><%=testo%></a> <a href="pdf_spettanze.asp?idord=<%=idord%>">PDF</a><span class="pull-right"><a href="pag_adm_spettanze_situaz.asp?idord=<%=idord%>" class="grigio">Situazione spettanze</a></span>	    </div>							    	    <div class="ui-widget-header" style="padding: 5px;">		    <%			    response.write get_denominazione(iduser)			    %>	    </div>	    <%		    		    if oper="add" then			    set rs_dipendenti=conn.execute ("(select dipendenti.iddip, cognome, nome,sesso from dipendenti inner join utenti_dipendenti on dipendenti.iddip = utenti_dipendenti.iddip where utenti_dipendenti.iduser="&iduser&" order by sesso desc, cognome,nome) union ( select 0 as iddip , 'Scorta tecnica' as cognome,'' as nome, 'A' as sesso ) order by sesso desc, cognome, nome")		    else			    sql="(select dipendenti.iddip, cognome, nome,sesso from dipendenti inner join utenti_dipendenti on dipendenti.iddip = utenti_dipendenti.iddip inner join (select distinct iddip from ordini_dett_spettanze inner join ordini_dett on ordini_dett_spettanze.iddett = ordini_dett.iddett where idord="&idord&") t on dipendenti.iddip = t.iddip  order by sesso desc, cognome,nome) union ( select 0 as iddip , 'Scorta tecnica' as cognome,'' as nome, 'A' as sesso ) order by sesso desc, cognome, nome"			    set rs_dipendenti=conn.execute (sql)			end if		    arrDipendenti=rs_dipendenti.getrows()					    ubound_arrDipendenti=ubound(arrDipendenti,2)		    		    	    %>	    <form method="POST" action="<%=questofile%>">			<table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1" id="spettanze">				<thead id="thead-top">				<tr > 					<th >Articolo</th>		            <%		            for n = 0 to ubound_arrDipendenti		            %>		            <th class="dipendenti" id="iddip<%=arrDipendenti(0,n)%>"><%=dipendente_colorato(  arrDipendenti(1,n)&" "&arrDipendenti(2,n),arrDipendenti(3,n),"" )%></th>		            <%		            Next		            		            %>				</tr>				</thead>				<tbody>					<%					if oper="add" then						sql="select prodotti_spettanze.id, prodotti.idpro, prodotti_spettanze.idvara,prodotti_spettanze.idvarb, prodotti.codice, prodotti.articolo, varianti_a.variante_a,  varianti_b.variante_b from ((prodotti_spettanze INNER JOIN prodotti on prodotti_spettanze.idpro=prodotti.idpro) left join varianti_a on prodotti_spettanze.idvara = varianti_a.idvara ) left join varianti_b on prodotti_spettanze.idvarb = varianti_b.idvarb where iduser="&iduser&" order by prodotti.codice"					else						sql="select  idpro, codice_ordine, articolo_ordine, ordini_dett.iddett, quantita, ordini_dett_note.nota from ordini_dett left join ordini_dett_note on ordini_dett.iddett = ordini_dett_note.iddett where idord="&idord&"  order by ordine"					end if										set rs_prodotti=conn.execute(sql)										if oper="add" and rs_prodotti.eof then					%>					<tr>						<td colspan="<%=ubound_arrDipendenti+2%>" align="center">							<b>Per questo cliente non ci sono articoli predefiniti per aggiungere le spettanze </b>						</td>					</tr>					<%											end if										do while not rs_prodotti.EOF						html_riga=""						if oper="add" then							articolo=rs_prodotti("codice")&" "&rs_prodotti("articolo")						else							articolo=rs_prodotti("codice_ordine")&" "&rs_prodotti("articolo_ordine")							nota=rs_prodotti("nota")							if not isnull(nota) then nota="<br>Nota:<span  class=""notaarticolo"">"&nota&"</span>"							quantita_articolo=rs_prodotti("quantita")							tot_in_ordine=0							tot_pronto=0							tot_consegnato=0						end if													quantita_tot=0							'Loop su dipendenti				            for n = 0 to ubound_arrDipendenti					        'val=request.form("quantita_"&rs_prodotti("idpro")&"_"&rs_prodotti("idvara")&"_"&rs_prodotti("idvarb")&"_"&arrDipendenti(1,n))							testocella=""							if oper="add" then								testocella="<input type=""text"" name=""quantita_"&rs_prodotti("idpro")&"_"&rs_prodotti("idvara")&"_"&rs_prodotti("idvarb")&"_"&arrDipendenti(0,n)&""" class=""spett"" value="""">"														else						        if isnull(rs_prodotti("idpro")    ) then									set rs_spettanze=conn.execute("select ordini_dett_spettanze.* ,ordini_dett.iddett, ordini_dett.varianti_ordine from ordini_dett_spettanze inner join ordini_dett on ordini_dett_spettanze.iddett = ordini_dett.iddett where ordini_dett.iddett= "&rs_prodotti("iddett")&" and iddip="&arrDipendenti(0,n)&" and idord="&idord)								else									set rs_spettanze=conn.execute("select ordini_dett_spettanze.* ,ordini_dett.iddett, ordini_dett.varianti_ordine from ordini_dett_spettanze inner join ordini_dett on ordini_dett_spettanze.iddett = ordini_dett.iddett  where ordini_dett.idpro= "&rs_prodotti("idpro")&" and iddip="&arrDipendenti(0,n)&" and idord="&idord)								end if								val=0								varianti_ordine=""								classe=""								quantita=0																do while not rs_spettanze.eof									classe=""									quantita= rs_spettanze("quantita")									txt=avanzamento(quantita,rs_spettanze("in_ordine"),rs_spettanze("pronto"),rs_spettanze("consegnato"),classe)									varianti_ordine=""'rs_spettanze("iddett")									if rs_spettanze("varianti_ordine")<>"" then										varianti_ordine=varianti_ordine&"<br>"&rs_spettanze("varianti_ordine")									end if									testocella=quantita&varianti_ordine																												if txt<>"" then testocella=testocella& "<br>"&txt									tot_in_ordine=tot_in_ordine+rs_spettanze("in_ordine")									tot_pronto=tot_pronto+rs_spettanze("pronto")									tot_consegnato=tot_consegnato+rs_spettanze("consegnato")									quantita_tot=quantita_tot+quantita								rs_spettanze.movenext								loop								classe_articolo_v=classe_articolo(quantita_articolo,tot_in_ordine,tot_pronto,tot_consegnato)							end if							 							html_riga=html_riga&"<td align=""center"" class="""&classe&""">"&testocella&"</td>"				            Next																			%>						<tr >						<td class="<%=classe_articolo_v%> articoli" id="idpro<%=rs_prodotti("idpro")%>"><%=articolo%><span class="pull-right"><%=quantita_articolo%></span><%=nota%></td>						<%=html_riga%>						</tr>						<%						rs_prodotti.MoveNext						Loop												set rs_prodotti = Nothing						call connclose()						%>				</tbody>				<%if oper="add" then %>				<tfoot>					<tr>						<td colspan="<%=ubound_arrDipendenti+3%>">							<input type="hidden" name="iduser" value="<%=iduser%>"><input type="hidden" name="idord" value="<%=idord%>"> <input type="submit" name="calcola" Value="Calcola totali" disabled> <input type="submit" name="aggiungi" Value="Aggiungi a ordine">						</td>					</tr>				</tfoot>				<%end if %>			</table>			<p style="text-align: center;"><span style="width:50px;" class="in_ordines legenda">In ordine</span> <span style="width:50px;" class="prontos legenda">Pronto</span> <span style="width:50px;" class="consegnatos legenda">Consegnato</span> </p>	    </form></div><script src="Jquery/Js/stickyRows/stickyRows.js"></script><script>$(function() {    var header_height = 0;    $('table th span').each(function() {        if ($(this).outerWidth() > header_height) header_height = $(this).outerWidth();    });    $('table th').height(header_height);    	$('#spettanze').stickyRows();    });	</script><%	txt_timer=txt_timer&"T fine:"&FormatNumber(timer() - t_inizio, 2)&" "%><div id="footer"><%=txt_timer%></div><%	stick_in_parent=false					%>		<script>$(function() {		$(".spett").click(function(){				$('.articoli').each(function(i, obj) {			$(obj).css('background','');					});		$('.dipendenti').each(function(i, obj) {			$(obj).css('background','');					});						var string=$(this).attr('name');		console.log(string);		var array = string.split('_');		var idpro=array[1];		var iddip=array[4];		$("#idpro"+idpro).css("background",'#dfff26');		$("#iddip"+iddip).css("background",'#dfff26');			});			});				</script>			<!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%function classe_articolo(quantita,tot_in_ordine,tot_pronto,tot_consegnato)	quantita=cdbl(quantita)	classe_articolo=""	if tot_consegnato=quantita then		classe_articolo="consegnatos"	elseif tot_pronto=quantita then		classe_articolo="prontos"	elseif tot_in_ordine=quantita then		classe_articolo="in_ordines"	end ifend functionfunction avanzamento(quantita, in_ordine,pronto,consegnato,byref classe)	txt2=""		if in_ordine>0 then			if in_ordine>=quantita then				classe="in_ordines"			else				call concatena_stringa(txt2,",","<span class=""in_ordines"">"&in_ordine&"</span>")			end if		end if		if pronto>0 then			if pronto>=quantita then				classe="prontos"			else				call concatena_stringa(txt2,",","<span class=""prontos"">"&pronto&"</span>")			end if		end if		if consegnato>0 then			if consegnato>=quantita then				classe="consegnatos"			else				call concatena_stringa(txt2,",","<span class=""consegnatos"">"&consegnato&"</span>")			end if		end if		avanzamento=txt2end function%>