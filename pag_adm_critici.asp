<!--#include virtual="/setup.asp" --><!--#include virtual="/paginazione.asp" --><!--#include file="JSON_latest.asp"--><!--#include virtual="/parser.asp" --><%	on error resume nextif not utente_admin then call login()if request.form("elimina_id")<>"" then	idlog=request.form("elimina_id")	conn.execute "DELETE FROM log WHERE idlog="&idlog&";"	Response.ContentType = "application/json; charset=utf-8"	Response.CodePage = 65001	Set Js = jsObject()	js("success")=true	js("Message")="eliminato"	js.Flush	set js=Nothing	call connclose()	response.endend ifif request.QueryString("pulisci")="v" then		conn.execute "DELETE FROM log WHERE (((log.causale)<=1));"end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body><div id="wrap"><div id="header"><%=titolo_top%> <!-- Box CORPO INIZIO--><%barra=0%>	<div id="barra_fissa">  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>" class="Amministra_piccolo">Registro Eventi</a></div></div>        <!-- Colonna CORPO INIZIO-->		<%		cosa=request.querystring("cosa")		id=request.querystring("id")		sql="select * from log " if not utente_andrea then where=" causale>0 "if cosa<>"" and id<>"" then	if where<>"" then where=where & " and "	where=where & " instr([evento],'["&cosa&"="& id&"]')"end ifcerca=request("cerca")causale=request("causale")if cerca<>"" then 'elenco in base al testo cercato		if where<>"" then where=where & " and "		'parole=split(cerca," ")		where = where & " instr( evento,'" &cerca& "')>0 "	testoricerca=" trovati per: "&testo	PaginazioneString="cerca="&cercaend ifif causale<>"" then		if where<>"" then where=where & " and "		where= where& " causale="&causale	PaginazioneString=PaginazioneString&"&causale="&causaleend ifif where<>"" then where=" where "&wheresql=sql&wheresql=sql&" order by idlog desc"if mysql_server<>"" then	'MYSQL	call paginazione_start(SQL,200,"mysql")else	'ACCESS	call paginazione_start(SQL,200,"access")end if%>       <table width="100%" border="0" cellpadding="2" cellspacing="0" bordercolor="#CCCCCC" class="tabella1">          <tr>             <td colspan="4" bgcolor="#E5E5E5">Eventi critici: <%=lngTotalRecords%> elementi</td>          </tr>          <tr >             <td colspan="4" style="border-bottom:1px solid;"><form name="form1" method="post" action="<%=questofile%>"><input name="cerca" type="text" size="50" value="<%=cerca%>"/>             <select name="causale" onchange="this.form.submit();">	            <option value="">Tutti</option>	            <option value="1" <%if causale="1" then response.write " selected"%>>Informativi</option>	            <option value="2" <%if causale="2" then response.write " selected"%>>Attenzione</option>	            <option value="3" <%if causale="3" then response.write " selected"%>>Gravi</option>	            <%if utente_andrea then %>	            <option value="0" <%if causale="0" then response.write " selected"%>>Zero</option>	            <option value="-1" <%if causale="-1" then response.write " selected"%>>-1</option>	            <%end if %>            </select>	            <input type="submit" name="cerca_button" value="Cerca"/><%if session("iduser")=1 then	            if mysql_server<>"" then             set rs=conn.execute ("select Count(log.idlog) AS ConteggioDiidlog, Min(log.data) AS MinDidata FROM log WHERE (((log.causale)=1));")            if not rs.eof then	            if isnull(rs("MinDidata")) then	            else		            mindata=formatdatetime(rs("MinDidata"),2)		        end if	                                %> <span style="float:right;"><a href="<%=questofile%>?pulisci=v">Elimina <%=rs("ConteggioDiidlog")%> dal <%=mindata%> <img src="images/sem_verde_t.gif" width="21" height="22" border="0"></a>              </span><%	              end if	        end if	        set rs = Nothing	        end if	        %></form></td>          </tr>          <tr>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">               <p>&nbsp;Data</p></td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>            <td align="left" bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Evento&nbsp;</td>            <td align="center" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Dettagli</td>          </tr>          <%Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>          <tr id="<%=objPagingRS("idlog")%>">             <td style="border-bottom:1px solid;" >	            	            <%if utente_andrea then		             response.write "<br><a href="""&questofile&"?elimina="&objPagingRS("idlog")&""" class=""elimina"">"&objPagingRS("data")&"</a>" 		        else			        response.write objPagingRS("data")			    end if		        		        		        %></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"> <%		  	testo=objPagingRS("causale")		  select case testo		  case 1			  txt="sem_verde_t.gif"		  case 2			  txt="sem_giallo_t.gif"		  case 3		  	txt="sem_rosso_t.gif"		  case 0		  	txt=""		  case else  		  	txt="sem_rosso_t.gif"		  %>		  <img src="/images/<%=txt%>" width="20" height="20">		  <%		  end select		  if txt<>"" then		  %> <img src="/images/<%=txt%>" width="20" height="20">		  <%			  end if			  			  %>		  		  </td>            <td style="border-bottom:1px solid;"> <%txt=objPagingRS("evento")			'response.write parser(objPagingRS("evento"))			txt=FormatText(txt)		  response.write left(txt,instr(txt,vbcrlf))		  'response.write objPagingRS("evento")		  %>             </td>            <td class="corpobox" style="border-bottom:1px solid;">			<%txt=mid(txt,instr(txt,vbcrlf)+1)%>			<%=replace(replace(txt,vbcrlf,"<br>"),"|","<br>")%> </td>          </tr>          <% 			iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(4,true)	%>        </table>       <!-- Box CORPO FINE--></div><%	txt_timer=txt_timer&"T fine:"&FormatNumber(timer() - t_inizio, 2)&" "%><div id="footer"><%=txt_timer%></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><script>$(function(){	$(".elimina").click(function(e){		e.preventDefault();		var idlog= $(this).closest("tr").attr("id");		$.ajax({				url     : "<%=questofile%>",				type    : "post",				cache: false,				dataType: 'json',				data	: "elimina_id="+idlog,				success: function(data){					//alert(data.Message);					$("#"+idlog).remove();					console.log("eliminato");				}				,error: function(xhr, textStatus, error){						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};						toastr.error('Errore nel caricamento della pagina');				      console.log("xhr.statusText:"+xhr.statusText);				      console.log("xhr.responseText:"+xhr.responseText);				      console.log("textStatus:"+textStatus);				      console.log("error:"+error);					  }			});			console.log(idlog);	});});</script></body></html>