<%sql="select * from files where idcosa="&id_tipo_allegato &" and cosa="&tipo_allegatoset rs_files=conn.execute(sql)if request("noscript")="" then%><script>	$(function() {			$(".delete_file").on("click", function (e) {				var id_file=$(this).closest("span").attr("id").substring(8);			    $("#dialog").html("Vuoi eliminare l'allegato?");			    $("#dialog").dialog({				    autoOpen: true,			        resizable: false,			        modal: true,			        title: "Richiesta conferma",			        height: "auto",			        width: "auto",			        buttons: {				        			            "No": function () {			                $(this).dialog('close');			                //callback(false);							},			            "Si": function () {			                $(this).dialog('close');							$.ajaxSetup({ cache: false });																		$.get("pag_adm_ordini_ajax.asp?tabella=file&oper=delete_file&id_file="+id_file, function(result){											//alert("qui");											if (result.toLowerCase().indexOf("errore") != -1)											{												toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};												toastr.error(result);												 											}											else											{												$("#id_file_"+id_file).remove();												//$( "span[id^='id_file_"+id_file+"']" ).remove();												toastr.options = {"positionClass": "toast-bottom-right"};												toastr.success(result);											}												//$("#Aggiorna_ordine").trigger("click");											});					            }			            			        }			    });							});										});		</script><%end if	%>		<div id="elenco_allegati">		<%	if not rs_files.eof then	 %><table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1" >    <tr>		<td  class="ui-widget-header">Files allegati</td>    </tr>    <tr id="tr_allegati<%=tipo_allegato%>">		<td><%		do until rs_files.EOF		%>		<span id="id_file_<%=rs_files("idfiles")%>"><a id="bottone" href="<%=rs_files("path")&rs_files("filename")%>" target="new"><%=rs_files("filename")%></a><a class=" delete_file" >Cancella</a>&nbsp;&nbsp;</span><%		rs_files.movenext		loop%>		</td>	</tr></table><script>	$(function() {			$(".delete_file" ).button({icons: {primary: "ui-icon-trash"},text: false});				});</script><%end if		%>			</div><%rs_files.closeset rs_files = Nothing%>