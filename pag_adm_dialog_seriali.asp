<!--#include virtual="/setup.asp" --><!--#include file="JSON_latest.asp"--><%if session("idadmin") = "" then call login()nord=request("nord")idord=request("idord")oper=request("oper")if oper="salva_seriale" then	sql="select sum(quantita*numeri_di_serie) from ordini_dett where numeri_di_serie>0 and idord="&idord	n_seriali_neccessari=cint(conn.execute(sql)(0))		sql="select count(id) from numeri_seriali  where idord="&idord		n_seriali_caricati=cint(conn.execute(sql)(0))		n_seriali_mancanti=n_seriali_neccessari-n_seriali_caricati	txt_log="n_seriali_neccessari:"&n_seriali_neccessari&" n_seriali_caricati:"&n_seriali_caricati&" n_seriali_mancanti:"&n_seriali_mancanti			'ciclo su ordini_dett	sql="select iddett from ordini_dett  where numeri_di_serie>0 and idord="&idord	set rs=conn.execute (sql)	do while not rs.eof			seriali=split(request("seriale_"&rs("iddett")),",")		n_seriali=ubound(seriali)		Set Js = jsObject()		'if (n_seriali+1)<=n_seriali_mancanti then		if n_seriali>-1 then			for n=0 to n_seriali				conn.execute ("update numeri_seriali set idord="&idord&",iddett="&rs("iddett")&" where id="&seriali(n))			Next		end if		rs.MoveNext	loop	Js("success")=true	'else	'	Js("success")=false	'	Js("message")="Numeri di serie inviati ("&n_seriali+1&") superiori al numero neccessario ("&n_seriali_mancanti&")"	'end if			call add2log("Ricevuto "&n_seriali&" Assegno seriali:"&request("seriale")&" su ordine "&idord&vbcrlf&txt_log,2)	js.Flush	set js=Nothing	call ResponseEnd()		end ifselect case oper	case "annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case else		oper="new"		if request("idpro_a")<>"" then oper="view"end selectif oper="add" or oper="update" then	'controlliend iftabella=cosatabellaid="idord"%><script Language="JavaScript"> $(function() {	$( "input" ).tooltip();});</script><%'response.write "ordine:"&ordine%><form id="form_aggiungi_seriali" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;" >  <input type="hidden" name="cosa" value="<%=cosa%>" />  <input type="hidden" name="dove" value="<%=dove%>" />  <input type="hidden" name="ordine" value="<%=ordine%>" />  <input type="hidden" name="iddett" value="<%=iddett%>" />  <input type="hidden" name="idord" value="<%=idord%>" />  <input type="hidden" name="nord" value="<%=nord%>" />  <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">    <%	    sql="select ordini_dett.*, magazzino.idmag, magazzino.db_ven from (ordini_dett INNER JOIN prodotti ON ordini_dett.idpro = prodotti.idpro) inner join magazzino on ( ordini_dett.idvarb = magazzino.idvarb) AND ( ordini_dett.idvara = magazzino.idvara) AND ( ordini_dett.idpro = magazzino.idpro) where numeri_di_serie>0 and idord="&idord	    	    	        set rs = conn.Execute(sql)    do while not rs.eof    	if rs("db_ven")=0 then			call elenca_seriali(idord,rs("iddett"),rs("idpro"),rs("articolo_ordine"),rs("quantita"))		else			response.write "<!-- Cerca seriali db -->"			call cerca_seriali_db(rs("idmag"),rs("iddett"),rs("quantita")) 		end if							    rs.MoveNext	    Loop	    set rs = nothing	    %>  </table>  <script>		  $(document).ready(function () {	      $('input[type="checkbox"]').click(function(event) {		      var classe=$(this).attr("class");		      var mancanti=$(this).closest("td").attr("data-mancanti");		      console.log("classe:"+classe+" mancanti:"+mancanti);			    if (this.checked && $('input.'+classe+':checked').length > mancanti) {			        event.preventDefault();			        this.checked = false;			    }			});			});		</script>  <br />  <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">    <tr align="right">      <td  align="left" style="border-bottom:1px solid;">Inserisci seriale</td>    </tr>    <tr align="right">      <td  align="left" style="border-bottom:1px solid;">	      <%if false then %>	      <input name="numero_di_serie" id="numero_di_serie" type="text"  size="45" autocomplete="off" placeholder="Numero di serie">	      <%end if %>        <input type="button" value="Aggiungi" id="salva_seriale">        <br />         </td>    </tr>    </table>  <%	  call connclose()	  	  %>  <script type="text/javascript">  $(document).ready(function () {	//Inizializzo select articolo					$('#numero_di_serie').select2({		dropdownCssClass: 'ui-dialog',		placeholder: 'Numero di serie',		minimumInputLength: 1,		allowClear: true,		ajax: {			quietMillis: 150,			url: "ajax_function.asp?select2=seriali&liberi=si",			dataType: 'json',			data: function (term, page) {				return {					term: term				};			},			results: function (data) {				return {					results: data				};			}		}	});		$("#salva_seriale").click(function(e){		var dati=$( "#form_aggiungi_seriali" ).serialize();		console.log("dati:"+dati);		$.ajax({			url     : "pag_adm_dialog_seriali.asp?oper=salva_seriale&idord=<%=idord%>",			type    : "post",			dataType: "json",			cache	: false,			data	: dati,			success: function(data){				//console.log(data.success);				//alert(data.Message);									if (data.success){					//$("#quantitamagazzino").html( data.quantita_magazzino );					$.ajax({						url     : "pag_adm_ordini_ajax.asp?tabella=ordini&oper=tbody&idord=<%=idord%>",						type    : "post",						cache: false,						//dataType: 'json',						data	: dati,																		success: function(data){							//alert(data.Message);														$("#tab_articoli_body").remove();							$("#tab_articoli_totali").remove();							$('#tab_articoli_testa').after(data);							aggiorna_ordine=false;						}						,error: function(xhr, textStatus, error){							toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};							toastr.error("Errore nell'aggiornamento dei dati");																					var txt="xhr.statusText : " + xhr.statusText+"<br>xhr.responseText : " + xhr.responseText+"<br>textStatus : " + textStatus+"<br>error : " + error+"<br>Useragent : "+navigator.userAgent;							invia_errore("Errore in salva_seriale()",stringa_dati+txt );							//$.ajax({							//	cache: false,							//	url     : "searcher.asp",							//	type    : "post",							//	data	: "txt_errore="+ encodeURIComponent(txt)							//});													}					});																										$("#dialog").dialog("close");				}				else				{					alert(data.message);				}			}			,error: function(xhr, textStatus, error){				console.log("Errore ricerca quantita");				invia_errore("Errore in quantitamagazzino()",xhr.statusText+xhr.responseText+textStatus+error );			      				  }		});							});		});</script></form><%call CheckConnChiusa()sub cerca_seriali_db(idmag_ven,iddett,quantita)	dim rs_db	sql="select distinta_base.*, magazzino.db_ven, magazzino.idmag, prodotti.articolo, prodotti.richiedi_seriale  FROM magazzino inner JOIN distinta_base ON distinta_base.idmag_acq = magazzino.idmag INNER JOIN prodotti on magazzino.idpro = prodotti.idpro where distinta_base.idmag_ven="&idmag_ven	response.write sql	set rs_db = conn.execute ( sql)	do while not rs_db.EOF		if rs_db("richiedi_seriale")=1 then			call elenca_seriali(idord,iddett,rs_db("idpro_acq"),rs_db("articolo"),quantita)		end if					rs_db.MoveNext	loop			end subsub elenca_seriali(idord,iddett,idpro,articolo,quantita)	dim n_seriali_caricati, n_seriali_mancanti	sql="select count(id) from numeri_seriali  where iddett="&iddett&" and idpro="&idpro	n_seriali_caricati=cint(conn.execute(sql)(0))	n_seriali_mancanti=cint(quantita)-n_seriali_caricati			if n_seriali_mancanti>0 then			    %>			    <!--<%="iddett:"&iddett%>-->			    <tr align="right" >			      <td  align="left" valign="bottom" style="border-bottom:1px solid; " data-mancanti="<%=n_seriali_mancanti%>">				      				      <%					      response.write "<b>"&articolo&"</b><br>"&"Selezionare "&n_seriali_mancanti&" numeri di serie:"					      set seriali=conn.execute ("select numeri_seriali.* from numeri_seriali where idpro="&idpro&" and iddett is null")					      if seriali.eof then					      						      Response.write "<span class=""rosso"">Nessun seriale disponibile per questo articolo</span>"						  else							  %>							<%								do while not seriali.EOF									response.write "<label><input type=""checkbox"" name=""seriale_"&iddett&""" value="""&seriali("id")&""" class=""cb"&idpro&""">"&seriali("seriale")&"</label> "									seriali.MoveNext								loop								%>							  <%						  end if					  set seriali = Nothing				      %>				      			      </td>			    </tr>			    <%		    end if	end sub%>