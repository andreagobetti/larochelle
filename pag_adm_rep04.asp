<!--#include virtual="/setup.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()damese=request.form("damese")amese=request.form("amese")anno=request.form("anno")if damese="" then	damese=month(date())end ifif amese="" then	amese=month(date())end ifif anno="" then	anno=year(date())end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><script>function aggiusta_amese(){	if (document.getElementById('AMESE').selectedIndex<document.getElementById('DAMESE').selectedIndex){	document.getElementById('AMESE').selectedIndex = document.getElementById('DAMESE').selectedIndex;	}}function aggiusta_damese(){	if (document.getElementById('AMESE').selectedIndex<document.getElementById('DAMESE').selectedIndex){	document.getElementById('DAMESE').selectedIndex = document.getElementById('AMESE').selectedIndex;	}}</script></head><body><div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Elenco incassi</a></div>        <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;" >        <!-- Colonna CORPO INIZIO-->                <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >               <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr >             <td colspan="4" style="border-bottom:1px solid;">Dal mese              <select name="DAMESE" onChange="aggiusta_amese();" id="DAMESE">                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(damese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select> al mese              <select name="AMESE" onChange="aggiusta_damese();" id="AMESE">                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(amese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select>               Anno              <input name="anno" type="text" value="<%=anno%>" size="4">              <input type="submit" name="Submit" value="Visualizza" style="FONT: 12px;"></td>          </tr></table></form>        <%if amese<>"" and damese<>"" then%>		<%sql="select incassi.*, ordini.azienda, ordini.nome, ordini.cognome, ordini.cf, ordini.piva, fatture.idfat FROM ((incassi INNER JOIN ordini ON incassi.idord = ordini.idord) LEFT JOIN ordini_fatture ON ordini.idord = ordini_fatture.idord) LEFT JOIN fatture ON ordini_fatture.idfat = fatture.IDfat where ordini.stato=6 and ordini.eliminato=0 " sql=sql & " and month(incassi.data)>="&damese &" and month(incassi.data)<="&amese &" and year(incassi.data)="&anno &" and incassi.causale>0 "sql=sql&" order by incassi.data"call paginazione_start(sql,10000,"access")%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="7" class="ui-widget-header">incassi dal mese di <%=nome_mese(damese)%>&nbsp;al mese di <%=nome_mese(amese)%>&nbsp;<%=anno%>: <%=lngtotalrecords%> elementi</td>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">               <p>&nbsp;Data incasso</p></td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Ord./Fatt.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Cliente</td>            <td align="left" bgcolor="#E5E5E5" style="border-bottom:1px solid;">C.F./P.IVA</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Importo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Pagamento</td>          </tr>          <%totale=0iRecordsShown = 0Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>          <tr>            <td style="border-bottom:1px solid;"><input name="" type="checkbox" value=""></td>             <td style="border-bottom:1px solid;"><%if objPagingRS("data")<>"" then%><%=formatDateTime(objPagingRS("data"), vbShortDate)%><%end if%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("idord")%>/<%=objPagingRS("idfat")%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("azienda")%><br><%=objPagingRS("cognome")%>&nbsp;<%=objPagingRS("nome")%></td>            <td align="left" nowrap style="border-bottom:1px solid;"><%=objPagingRS("cf")%><br><%=objPagingRS("piva")%></td>            <td align="right" nowrap style="border-bottom:1px solid;"> <%=formatcurrency(objPagingRS("importo"),2)%></td>            <td style="border-bottom:1px solid;" class="corpobox"><%=objPagingRS("tipo_pagamento")%></td>          </tr>          <% 		totale=totale+cdbl(objPagingRS("importo"))		iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	%>          <tr>             <td colspan="7" align="right"><b>Totale incassi: <%=formatcurrency(totale,2)%></b>              </td>          </tr>          <%	          	          call paginazione_end(7,true)	          	          %>        </table><%end if%>        <!-- Colonna CORPO FINE--> <!-- Box CORPO FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>