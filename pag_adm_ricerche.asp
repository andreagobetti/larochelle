<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()if request.QueryString("cancella_1")<>"" then	conn.execute "delete FROM ricerche;"end ifif request.QueryString("cancella_3")<>"" then	conn.execute "DELETE ricerche.click FROM ricerche WHERE (((ricerche.click)<3));"end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body><div id="wrap"><div id="header"><%=titolo_top%> <!-- Box CORPO INIZIO--><%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>" class="Amministra_piccolo">Ricerche</a></div>        <!-- Colonna CORPO INIZIO-->        <!-- INIZIO BLOCCO CENTRALE -->                  <%'set rs=conn.execute("select * from ricerche order by click desc, parola")rs.Open "select * from ricerche order by click desc, parola",conn,3,3%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr class="ui-widget-header">             <td colspan="2">Ricerche uniche nel sito: <%=rs.recordcount%> elementi</td>            <td align="right"><a href="<%=questofile%>?cancella_3=si">Cancella &lt;3 ricorrenze</a> <a href="<%=questofile%>?cancella_1=si">Cancella tutto</a></td>          </tr>          <tr>             <td style="border-bottom: 1px solid;"><b>&nbsp;Parola&nbsp;</b></td>            <td style="border-bottom: 1px solid;"><b>&nbsp;Volte&nbsp;</b></td>            <td style="border-bottom: 1px solid;">&nbsp;</td>          </tr><%do until rs.EOF%>          <tr>             <td nowrap style="border-bottom: 1px solid;">&nbsp;<%=rs("parola")%>&nbsp;</td>            <td style="border-bottom: 1px solid;"><%=rs("click")%></td>            <td width="50%" style="border-bottom: 1px solid;">&nbsp;</td>          </tr>          <%rs.movenextlooprs.CloseSet rs=Nothingconn.CloseSet conn=Nothing%>        </table>        <!-- FINE BLOCCO CENTRALE --></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%rsClose%>