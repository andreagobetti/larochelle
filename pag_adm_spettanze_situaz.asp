<%t_inizio=timer()%><!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/ClasseOrdine.asp" --><%	iduser=request("iduser")	idord=request("idord")	m_tabella="ordini"	if request.form("rettifica")<>"" then		rettifica=true					end if	if request.form("salva")<>"" then		'set ordine= (new ClasseOrdine)(array("apri","ordini",idord))		'call ordine.aggiorna_quantita_spettanze()		set ordine= (new ClasseOrdine)(array("aggiorna_quantita_spettanze",m_tabella,idord))		set ordine = nothing		rettifica=false	end if	'response.write oper%><!--#include virtual="/sub_head_adm.asp" --><style>	 th {  position: relative;  padding: 10px;}th span {  transform-origin: 0 50%;  transform: rotate(-90deg);   white-space: nowrap;   display: block;  position: absolute;  bottom: 0;  left: 50%;}.dipendente{	font-weight: bold;}.denominazione{	font-weight: bold;	font-size: large;}.grado{	font-weight: 100;}#accessori{	border: 1px solid black;	padding: 10px;}#accessori label {	float: left;	width: 150px;	margin-bottom: 5px;	font-weight: bold;	}#accessori input[type="text"] {	/*width: 500px;*/	margin-bottom: 5px;}/*tabella rilievo taglie */#accessori input.taglie[type="text"] {	width: 60px;	margin-bottom: 5px;}#accessori input[type="radio"] {	width: 30px;	margin-bottom: 5px;	margin-right: 10px;}#accessori input[type="checkbox"] {	margin-bottom: 5px;	margin-left: 20px;}#accessori textarea {	width: 550px;	height: 50px;	margin-bottom: 5px;}#accessori br {	clear: left;}.option{	padding-left: 20px;	padding-right: 20px;	padding-top: 3px;	padding-bottom: 3px;}.green{	background-color: #99FF99;	margin-left: 2px;}.articolo_ordine{	border: 1px solid black;}.quantita{	border: 1px solid black;	text-align: center;}.row-dipendente{	padding-top: 5px;	border-top: 2px solid black !important;}</style></head><body><div id="wrap"><div id="header"><%=titolo_top%>         <!-- Box CORPO INIZIO-->		<%barra=0%>		<div id="barra_fissa">			  <!--#include virtual="/sub_barra_adminsf2.asp" -->		<%			set rs_ordine=conn.execute ("select ordini.nord, ordini.iduser from ordini where idord="&idord)	 			iduser=rs_ordine("iduser")			nord=rs_ordine("nord")			set rs_ordine = nothing						%>         <div class="ui-widget-header ui-corner-top titolo_admin">			<a href="<%="pag_adm_ordini.asp?idord="&idord%>">Ordine <%=nord%></a> > <a href="<%=questofile&"?idord="&idord%>">Situazione spettanze</a>			<span class="pull-right"><a href="pag_adm_spettanze_vert.asp?idord=<%=idord%>" class="grigio">Spettanze per agente</a></span>	    </div>	    </div>	    	    <div class="ui-widget-header denominazione" style="padding: 5px;">		    <%			    response.write get_denominazione(iduser)			    %>	    </div>		<%		set ordine= (new ClasseOrdine)(array("apri","ordini",idord))		call ordine.elenco_dipendenti								%>	    <form method="POST" action="<%=questofile%>" id="form-avanz-spettanze">		  <input type="hidden" name="idord" value="<%=idord%>" >		  <%if rettifica then %>		  <input type="hidden" name="rettifica" value="si" >		  <%end if %>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">	      <tr style="border-bottom: 1px solid gray; background: #E5E5E5; font-size:11px;">		      <td>Codice		      </td>		      <td>Articolo		      </td>		      <td align="center">Quantit&agrave;		      </td>	      </tr>	          <%		          		sql="select ordini_dett.*, magazzino.quantita_magazzino,magazzino.idmag, magazzino.Data_arrivo, magazzino.quantita_riordino, magazzino.quantita_ordinata, varianti_a.variante_a, varianti_b.variante_b, prodotti.idfor, prodotti.codice, ordini_dett_note.nota FRom (((magazzino RIGHT JoIN ordini_dett oN (magazzino.idvarb = ordini_dett.idvarb) AND (magazzino.idvara = ordini_dett.idvara) AND (magazzino.idpro = ordini_dett.idpro)) LEFT JoIN varianti_b oN ordini_dett.idvarb = varianti_b.IDvarb) LEFT JoIN varianti_a oN ordini_dett.idvara = varianti_a.IDvara ) left join prodotti on  magazzino.idpro = prodotti.idpro left join ordini_dett_note on ordini_dett.iddett = ordini_dett_note.iddett where  "		        sql=replace(sql,"ordini",m_tabella)        sql=sql&"  idord="&idord &" order by ordine,iddett;"		set rs=conn.execute(sql)		stringa_iddett=""		quantita_totale=0		do while not rs.eof			quantita_totale=quantita_totale+cdbl(rs("quantita"))			stile_cella=""			txt_spettanze= dettaglio_spettanze( m_tabella, rs("iddett"), rs("quantita"),true,stile_cella)			%>	          <tr valign="top" style="border-top: 1px solid black; padding-bottom:10px; padding-top:10px;" class="<%=stile_cella%>">			      <td align="center" >              <b><a href="<%="product.asp?idpro=" & RS("idpro")%>" title="Clicca per le opzioni" class="menu_idpro" data-idmag="<%=RS("idmag")%>" data-idpro="<%=RS("idpro")%>"><%=RS("codice_ordine")%></a></b><%if utente_andrea then %><%=RS("idmag")%><%end if %>            </td>            <td >				<%=rs("articolo_ordine")%>	            <%if rs("varianti_ordine")<>"" then response.write "<br>"&rs("varianti_ordine")        			nota=rs("nota")					if not isnull(nota) then response.write "<br>Nota:<span  class=""notaarticolo"">"&nota&"</span>"					response.write txt_spettanze	            %>	        </td>            <td align="center" valign="top" style="<%=stile%>"><%=rs("um")%>&nbsp;              <%=rs("quantita")%>			</td>          </tr>          <%            rs.movenext			loop			set rs = nothing			call connclose()			if rettifica then				testo_salva="Salva rettifiche"			else				testo_salva="Salva"			end if			%>			</table>			<input type="hidden" id="quantita_totale" value="<%=quantita_totale%>">			<div class="ui-dialog-buttonpane ui-widget-content ui-helper-clearfix">				<div class="ui-dialog-buttonset" style="text-align: center;">				<input type="submit" name="salva" value="<%=testo_salva%>" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">				<input type="button"  value="DDT" id="pulsante_crea_ddt_fattura" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">				<%if not rettifica then %>				<input type="submit" name="rettifica" value="Rettifica" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">				<%end if %>				</div>			</div>		    	    </form>	    		In ordine<input type="text" class="in_ordine" disabled> Pronto<input type="text" class="pronto" disabled>In consegna<input type="text" class="consegna" disabled> SHIFT + click per impostare quantità totale</div><%if false then %>			<script type="text/javascript" src="Jquery/js/jquery.validate.min.js"></script>			<script type="text/javascript" src="Jquery/js/jquery.validate.min_it.js"></script><%end if %>			<script type="text/javascript" src="Jquery/Js/jquery.mobile-events.min.js"></script>			<script>				$(function() {				    var classi=["in_ordine","pronto","consegna"];				    var form = $("#form-avanz-spettanze");				    var idord=<%=idord%>;				    var nord=<%=nord%>;				    //				    form.validate({//				        invalidHandler: function(event, validator) {//				            // 'this' refers to the form//				            var errors = validator.numberOfInvalids();//				            if (errors) {//				                var message = errors == 1 ?//				                    'You missed 1 field. It has been highlighted' ://				                    'You missed ' + errors + ' fields. They have been highlighted';//				                console.log(message);//				            } else {//				                console.log("nessuno");//				            }//				        },//				        submitHandler: function(form) {//				            console.log("submit");//				            form.submit();//				        }//				    });				    $('.do').bind('doubletap', function(e) { 						    imposta_valore(this);					});				    $(".do").click(function(e) {					    if(e.shiftKey){						    imposta_valore(this);						}					});										function imposta_valore(obj){							var id=trova_id($(obj));						    //var id=$(this).attr("id").replace(replace, "");						    console.log("id:"+id);						    var quantita=$("#quantitam"+id).val();						    console.log("quantita:"+quantita);						    $(obj).val(quantita);					}																				$(".do").focusout(function(){						var id=trova_id($(this));						console.log("focusout"+id);						elabora_riga(id);					});										function elabora_riga(id){												var quantita=$("#quantitam"+id).val();						var consegnato=0;						var pronto=$("#pronto"+id).val();						var prontomax=quantita-consegnato;						if(pronto>prontomax){							pronto=prontomax;							$("#pronto"+id).val(pronto);							}						var in_ordine=$("#in_ordine"+id).val();						var in_ordinemax=quantita-consegnato-pronto;						if(in_ordine>in_ordinemax){							in_ordine=in_ordinemax;							$("#in_ordine"+id).val(in_ordine);							}						var in_consegna=$("#consegna"+id).val();						var in_consegnamax=quantita-consegnato;						if(in_consegna>in_consegnamax){							in_consegna=in_consegnamax;							$("#consegna"+id).val(in_consegna);							}																				console.log("quantita:"+quantita+" pronto:"+pronto+" prontomax:"+prontomax+" in_ordine:"+in_ordine+" in_ordinemax:"+in_ordinemax+" in_consegna:"+in_consegna+" in_consegnamax:"+in_consegnamax);					}					function trova_id(obj){												for (var i = 0; i < classi.length; i++) {							if($(obj).hasClass(classi[i])){							    console.log(classi[i]);							    var sostituisci=classi[i];						    }						}					    var id=$(obj).attr("name").replace(sostituisci, "");						return id;					}									    $("#pulsante_crea_ddt_fattura").click(function(e) {					    var quantita_totale=Number($("#quantita_totale").val());					    					    //Conto il totale di in consegna					    var totale_in_consegna=0;					    $( ".consegna" ).each(function( index ) {						    totale_in_consegna+=Number($( this ).val());						});						console.log("quantita_totale:"+quantita_totale+" totale_in_consegna:"+totale_in_consegna);						var bodydialog="";					    if(totale_in_consegna==0){			                titledialog = "Crea ddt";			                bodydialog = "Non hai selezionato nessun articolo in consegna, vuoi generare un ddt per tutti gli articoli dell'ordine?";			                //Create the buttons object			                var buttons = {			                    "NO": function() {			                        $("#dialog").dialog('close');			                    },			                    "SI": function() {			                        apridialog("completo");			                    }			                };						    					    }					    if(totale_in_consegna==quantita_totale){			                        apridialog("completo");						    						    						    					    }					    					    					    					    					    					    if (bodydialog!=''){				        $("#dialog").html(bodydialog);			            $("#dialog").dialog({				            autoOpen: true,				            modal: true,				            resizable: false,				            width: 600,				            height: "auto",				            title: titledialog,				            buttons: buttons				        });					    } else{						    	                        apridialog("parziale");					    }					    					    					    					    				        posizione_errore = "pulsante_crea_ddt_fattura";				    });						function apridialog(parziale){						if(parziale=='completo'){							titolo=" completo";						}						else{							titolo=" parziale";						}										        $("#dialog").html("Attendi...");				        $.ajax({				            url: "pag_adm_dialog_creafattura.asp?idord=" + idord + "&nord=" + nord,				            type: "post",				            cache: false,				            //dataType: 'json',				            data	: {					            cosa: 'D',				            	ddt_o_fattura: 'D',				            	parziale: parziale				            },				            success: function(data) {					            				                $("#dialog").html(data);						        $("#dialog").dialog({						            autoOpen: true,						            modal: true,						            resizable: true,						            width: 600,						            height: 'auto',						            title: "Crea ddt"+titolo,						            buttons:{}						        });				            },				            error: function(xhr, textStatus, error) {				                toastr.options = {				                    "positionClass": "toast-bottom-right",				                    "timeOut": "0",				                    "extendedTimeOut": "0",				                    "closeButton": true				                };				                toastr.error('Errore nel caricamento della pagina');								                var txt = "xhr.statusText : " + xhr.statusText + "<br>xhr.responseText : " + xhr.responseText + "<br>textStatus : " + textStatus + "<br>error : " + error + "<br>Useragent : " + navigator.userAgent;				                invia_errore("Errore in pulsante_crea_ddt_fattura()", txt);												            }				        });																	}														});				</script><%	txt_timer=txt_timer&"T fine:"&FormatNumber(timer() - t_inizio, 2)&" "%><div id="footer"><%=txt_timer%></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>