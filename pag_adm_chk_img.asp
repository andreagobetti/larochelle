<!--#include virtual="/setup.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()if request("chk")<>"" then	dim numeroErrori,numImmagini,oraInizio	numeroErrori=0	numImmagini=0	oraInizio=now()	response.buffer = false	Server.ScriptTimeout=60*3	sql="select files.*  FROM files where cosa=4"	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 3,3	Set Jpeg = Server.CreateObject("Persits.Jpeg")	Set objFile = Server.CreateObject ("Scripting.filesystemObject")	'On Error Resume Next 	session("analisiimmagini")=time()&"Inizio analisi files "&"<br>"	do while not rs.eof		if (numImmagini Mod 100) = 0 Then			session("analisiimmagini")=session("analisiimmagini")&time()&"Analisi numImmagini:"&numImmagini&"<br> "		End if		'session("analisiimmagini")=session("analisiimmagini")&now()&"Analisi idfiles:"&rs("idfiles")&" "		imgurl=Server.MapPath(rs("path")&rs("filename"))		If not objFile.FileExists (imgurl) Then				rs("chk")="Size kko: IMMAGINE MANCANTE"				conn.execute ("update prodotti set fileimg='no_img.jpg' where idpro="&RS("idcosa"))		Else				Jpeg.Open imgurl				rs("chk")=chk_immagine(jpeg.OriginalWidth,jpeg.OriginalHeight)		end if		if Err.Number <> 0 then			rs("chk")=left("Size kko:"&Err.Description,39)			session("analisiimmagini")=session("analisiimmagini")&time()&"Errore su idfiles:"&rs("idfiles")&Err.Description&"<br>"			Err.clear			numeroErrori=numeroErrori+1		end if		conn.execute ("update prodotti set fileimg='"&rs("filename")&"' where idpro="&rs("idcosa"))		rs.update		if numeroErrori>20 or numImmagini>3500 then			session("analisiimmagini")=session("analisiimmagini")&time()&"MoveLAST<br>"			exit do			end if		numImmagini=numImmagini+1		rs.movenext	loop	rs.close	sql="select prodotti.idpro FROM prodotti LEFT JOIN (select files.*  FROM files where cosa=4 )  AS files ON prodotti.IDpro = files.idcosa WHERE (((files.idfiles) Is Null));"	set rs=conn.execute(sql)	do while not rs.EOF		conn.execute ("update prodotti set fileimg='no_img.jpg' where idpro="&RS("idpro"))		rs.MoveNext	loop		set Jpeg=nothing	set objFile=nothing	set rs=Nothingend ifif request("aggiustaratio")<>"" then		sql="select files.* FROM files where cosa=4 and (instr(chk,'ratio ko')>1 or  instr(chk,'ratio kko')>1)"		Set rs_files = Server.CreateObject("ADODB.Recordset")	rs_files.Open sql , conn, 0,2	do while not rs_files.EOF			'ricostruisco il nome per il nuovo file		savefolder=upl_img_cat	'"/public/img_prod/"		inizio_nome="IMG_"		id_tipo_allegato=rs_files("idcosa")		if rs_files("ordine")>2 then			n_file= rs_files("ordine")/2		else			n_file=1			rs_files("ordine")=0		end if		fine_nome=replace(time(),":","")				fileName=rs_files("filename")		if InStr(fileName, ".") > 0 then 			estensione = "." & Right(fileName, Len(fileName) - InStrRev(fileName, ".")) 		else 			estensione = ".tmp" 		end if 		newname = inizio_nome&id_tipo_allegato&"_"&n_file&"_"&fine_nome&estensione		Set Jpeg = Server.CreateObject("Persits.Jpeg")		' Open source image		imgurl=rs_files("path")&rs_files("filename")		Set fs = Server.CreateObject("Scripting.filesystemObject")		if fs.FileExists(Server.MapPath(imgurl)) then 			Jpeg.Open Server.MapPath(imgurl)			' 800px x 1120px, rapporto larghezza/altezza: 0.70 - 0.73				AspectRatio=jpeg.OriginalWidth/jpeg.OriginalHeight			testo_log="Dimensioni immagine:"&jpeg.OriginalWidth&"x"&jpeg.OriginalHeight&":"&roundup(AspectRatio,2)			if AspectRatio>0.73 then	'Altezza troppo bassa, immagine larga				'Calcolo altezza ottimale				optimalHeight=jpeg.OriginalWidth/0.7142								testo_log=testo_log&"<br>Aumento altezza a:"&int(optimalHeight)					'Calcolo delta				deltaHeight=int((optimalheight-jpeg.OriginalHeight)/2)					'Croppo in negativo solo in Y				jpeg.Canvas.Brush.Color = &HFFFFFF				jpeg.Crop 0, deltaHeight*-1, jpeg.OriginalWidth , jpeg.originalHeight + deltaHeight				modificato=true			elseif AspectRatio<0.70 then	'Larghezza troppo bassa, immagine alta				'Calcolo larghezza ottimale				optimalWidth=jpeg.OriginalHeight*0.7142				testo_log=testo_log&"<br>Aumento larghezza a:"&int(optimalWidth)								'Calcolo delta				deltaWidth=int((optimalWidth-jpeg.OriginalWidth)/2)					'Croppo in negativo solo in X				jpeg.Canvas.Brush.Color = &HFFFFFF				jpeg.Crop deltaWidth*-1, 0, jpeg.OriginalWidth+deltaWidth , jpeg.OriginalHeight				modificato=true			else				testo_log=testo_log&"<br>Immagine conforme"			end if			if modificato then				testo_log=testo_log&"<br>Dimensione finale:"&jpeg.width&"x"&jpeg.height&":"&roundup(jpeg.width/jpeg.height,2)				rs_files("chk")=chk_immagine(jpeg.width,jpeg.height)				Jpeg.Save Server.MapPath(imgurl)								Dim fs				' Creo una istanza dell'offetto filesystemObject					if not fs.FileExists(Server.MapPath(savefolder&newname)) then 					' rinominiamo il file da , a					fs.MoveFile Server.MapPath(imgurl),Server.MapPath(savefolder&newname)							' Faccio pulizia					Set fs = Nothing					rs_files("path")=savefolder					rs_files("filename")=newname					idpro=rs_files("idcosa")					idfile=rs_files("idfiles")					rs_files.update					'Apro prodotti per modificare il nome del file					Set rs_prodotti = Server.CreateObject("ADODB.Recordset")					sql="select prodotti.* from prodotti where idpro="&idpro					rs_prodotti.Open sql , conn, 0,3					if not rs_prodotti.eof then						if rs_prodotti("fileimg")=fileName then rs_prodotti("fileimg")=newname						rs_prodotti.update						txt_log="Ridimensionata immagine [articolo="& rs_prodotti("idpro")&"]"&rs_prodotti("codice")&"[/articolo] eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]"						add2log txt_log&vbcrlf&testo_log&vbcrlf&imgurl&vbcrlf&savefolder&newname&vbcrlf&"idfiles:"&idfile,2							end if				else					txt_log="Ridimensionamento FALLITO immagine [articolo="& rs_prodotti("idpro")&"]"&rs_prodotti("codice")&"[/articolo] eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin], file destinazione esistente"					add2log txt_log&vbcrlf&testo_log&vbcrlf&imgurl&vbcrlf&savefolder&newname&vbcrlf&"idfiles:"&idfile,2				end if			else				rs_files("chk")="Size kko: IMMAGINE MANCANTE"				rs_files.Update 			end if		end if				rs_files.MoveNext			loop	rs_files.Close	set rs_files=nothingend if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body><div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa">  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>" class="Amministra_piccolo">Conformità immagini</a></div></div>        <%	        if session("analisiimmagini")<>"" then		        'Response.write session("analisiimmagini")	        end if	        	        	        %><!-- Box CORPO INIZIO-->		<%sql="select Count(files.idfiles) AS ConteggioDiidfiles  FROM files where cosa=4 and (instr(chk,'ratio ko')>1 or  instr(chk,'ratio kko')>1)"	set conteggio=conn.execute (sql)ratioko=conteggio("ConteggioDiidfiles")sql="select Count(files.idfiles) AS ConteggioDiidfiles  FROM files where cosa=4"	set conteggio=conn.execute (sql)all=conteggio("ConteggioDiidfiles")sql="select Count(files.idfiles) AS ConteggioDiidfiles  FROM files where cosa=4 and (instr(chk,'ize ko')>1 or  instr(chk,'ize kko')>1)"	set conteggio=conn.execute (sql)sizeko=conteggio("ConteggioDiidfiles")sql="select Count(files.idfiles) AS ConteggioDiidfiles  FROM files where cosa=4 and instr(chk,'MANCANTE')>1 "	set conteggio=conn.execute (sql)corrotta=conteggio("ConteggioDiidfiles")strfiltro=request("filtro")if strfiltro="" then	filtro="instr(chk,'ko')>1"elseif strfiltro="ratioko" then	filtro="(instr(chk,'ratio ko')>1 or  instr(chk,'ratio kko')>1)"elseif strfiltro="sizeko" then	filtro="(instr(chk,'ize ko')>1 or  instr(chk,'ize kko')>1)"elseif strfiltro="corrotta" then	filtro="instr(chk,'MANCANTE')>1"end ifpaginazionestring="&filtro="&strfiltro	sql="select prodotti.idpro,prodotti.codice,prodotti.articolo, files.filename, files.path, files.idfiles,files.chk FROM prodotti inner JOIN (select files.*  FROM files where cosa=4 and "&filtro&" )  AS files ON prodotti.IDpro = files.idcosa "call paginazione_start(sql,100,"access")%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="2" class="ui-widget-header">Conteggio immagini: <a href="<%=questofile%>?filtro=">Non conformi <%=objPagingRS.recordcount%></a>, <%if session("iduser")=1 then %><a href="<%=questofile%>?aggiustaratio=true"> Aggiusta</a> <%end if%><a href="<%=questofile%>?filtro=ratioko">Ratio ko <%=ratioko%></a>, <a href="<%=questofile%>?filtro=sizeko">Size ko <%=sizeko%></a>, <a href="<%=questofile%>?filtro=corrotta">CORROTTE <%=corrotta%></a></td>          </tr>          <tr>             <td colspan="2" class="ui-widget-header"><span style="float: right;"><a href="<%=questofile%>?chk=si">Esegui nuova verifica di tutte le <%=all%> immagini</a></span></td>          </tr>          <tr>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">               <p>&nbsp;Articolo</p></td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Anomalia</td>          </tr><%	sql="select prodotti.idpro, prodotti.codice, prodotti.articolo, files.filename, files.path, files.idfiles, files.idfiles, prodotti.fileimg FROM prodotti LEFT JOIN (select files.*  FROM files where cosa=4 )  AS files ON prodotti.IDpro = files.idcosa WHERE (((files.idfiles) Is Null));"set rs=conn.execute(sql)		colore="bgcolor='#FF0000'"          do while not rs.eof	%>               <tr <%=colore%>>             <td style="border-bottom:1px solid;"><a href="pag_adm_artic.asp?modifica=<%=RS("idpro")%>" target="_blank"><%=RS("codice")&" "&RS("articolo")%></a></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;">IMMAGINE MANCANTE</td>          </tr>		  <%			  rs.MoveNext			  loop			  Set rs = Nothing			  Do While iRecordsShown < iPageSize And Not objPagingRS.EOFif instr(objPagingRS("chk"),"Ratio kko")>0 then	colore="bgcolor='#FF0000'"elseif instr(objPagingRS("chk"),"kko")>0 then	colore="bgcolor='#FF4500'"elseif instr(objPagingRS("chk"),"ko")>0 then	colore="bgcolor='#FFA500'"else	colore=""end if%>          <tr <%=colore%>>             <td style="border-bottom:1px solid;"><a href="pag_adm_artic.asp?modifica=<%=objPagingRS("idpro")%>" target="_blank"><%=objPagingRS("codice")&" "&objPagingRS("articolo")%></a></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("chk")%>	   </td>          </tr>          <% 		  iRecordsShown = iRecordsShown + 1		 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(2,true)	%>                 </table>       <!-- Box CORPO FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>