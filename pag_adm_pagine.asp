<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()dim rs_newsidnews=request("idnews")oper=lcase(request("oper"))if oper="elimina" then		conn.execute("DELETE  idnews FROM news WHERE idnews=" & idnews)		add2log "Eliminato contenuto idnews"&request.form("id")&" da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",3		oper="list"		idnews=""end ifif oper="add" or oper="update" then	sqlbase="select news.* from news "	Set rs = Server.CreateObject("ADODB.Recordset")		if oper="add" then		rs.Open sqlbase, conn, 3, 3		rs.addnew		operazione="Aggiunto"		rs("tipo")="pagina"		rs("data")=now()	else		sql= sqlbase & " where idnews=" & idnews		rs.Open sql, conn, 3, 3		operazione="Modificato"	end if	if trim(request.form("data"))<>"" then rs("data")=trim(request.form("data"))	rs("titolo")=firstup(trim(request.form("titolo")))	rs("titolo_en")=firstup(trim(request.form("titolo_en")))	rs("testo")=trim(request.form("testo"))	rs("testo_en")=trim(request.form("testo_en"))	if request.form("visualizza")<>"" then		rs("visualizza")=1	else		rs("visualizza")=0	end if	'rs("tipo")="pagina"	rs.update	add2log operazione&" contenuto "&rs("titolo")&" da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",3	rs.close	call riordina (trim(request.form("tipo")))	oper="list"	idnews=""	'response.redirect Request.ServerVariables("Script_Name")end ifif isnumeric(idnews) and idnews<>"" and oper="" then oper="edit"select case oper	case "annulla"		oper="view"	case "new"		IconaPuls="fa-list"		LinkPuls="oper=list"	case "edit"		IconaPuls="fa-list"		LinkPuls="oper=list"		TitlePuls="Visualizza lista"	case else		oper="list"		IconaPuls="fa-plus"		LinkPuls="oper=new"		TitlePuls="Aggiungi nuovo"end selectsub riordina(tipo)	sql="select * from news where stato='0' and tipo='" & tipo&"' order by ordine;"	'response.write sql	rs.open sql, conn,3,3	'response.end	ordine=10	do while not rs.eof	rs("ordine")=ordine	rs.update	ordine=ordine+10	rs.movenext	loop	rs.closeend subcss_form=true%><!--#include virtual="/config/header_inc.asp" -->        <section id="content">        	<div id="breadcrumb-container">        		<div class="container">					<ul class="breadcrumb">						<li><a href="/">Home</a></li>						<li class="active" href="<%=questofile%>">Contenuti</li>					</ul>        		</div>        	</div>        	<div class="container">	        	<div class="row">		        	<div class="col-md-12">		        		<header class="content-title">							<h1 class="title">Contenuti								<span class="pull-right">								<%if oper="list" then%>								  <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-expanded="false">								    Filtro <span class="caret"></span>								  </button>								  <ul class="dropdown-menu" role="menu">								    <li><a href="<%=questofile%>?tipo=pagina">Pagine</a></li>								    <li><a href="<%=questofile%>?tipo=contenuto">Contenuti Home</a></li>								    <li><a href="#">...</a></li>								    <li class="divider"></li>								    <li><a href="#">...</a></li>								  </ul>								  <%end if%>								<a href="<%=questofile%>?<%=LinkPuls%>" title="" class="btn btn-info"><i class="fa <%=IconaPuls%> fa-lg"></i></a>								</span>							</h1>						</header>		        	</div>	        	</div>						        		<%if oper="list" then%>        		<div class="row">					<table class="table checkout-table" >						<thead>							<tr>								<th class="table-title" style="width: 300px;"></th>								<th class="table-title">Titolo</th>								<th class="table-title">Tipo</th>							</tr>						</thead>													<tbody>						<%													sql="select * from news "						tipo=request.querystring("tipo")						if tipo<>"" then							if tipo="contenuto" then								sql=sql&" where tipo like 'contenuto%'"							else							sql=sql& " where tipo='"&request.querystring("tipo")&"' "							end if						end if						Set rs_news=conn.Execute(sql)						do while not rs_news.EOF						%>							<tr>								<td class="">									<a href="<%=questofile%>?idnews=<%=rs_news("idnews")%>" class="btn btn-info btn-sm" ><i class="fa fa-pencil fa-lg"></i></a><a href="#" class="btn btn-info btn-sm" onclick="copyToClipboard('single-page.asp?id=<%=rs_news("idnews")%>&chk=<%=chkDataUser(rs_news("data"))%>');"><i class="fa fa-link fa-lg"></i></a></td>								<td class=""><span class="pull-left"><%=rs_news("titolo")%></span></td>								<td class="">									<%=tipo_contenuto(rs_news("tipo"))%>																	</td>							</tr>							<%							rs_news.MoveNext							loop							%>						</tbody>					</table>        						</div><!-- End .row -->				<%end if%>				<%if oper="edit" or oper="new" then						if oper="edit" then		'response.write "OPER:" & oper		sql="select news.* from news  where idnews =" & idnews		set rs_news=conn.execute(sql)		if rs_news.eof then NonTrovato=true		end if		if NonTrovato then %>				Non trovato		<% 		else		dim ValoreCampo			%>						<form action="<%=questofile%>" method="post" id="form">				<input type="hidden" name="idnews" value="<%=idnews%>">          		<%if error<>"" then			  		ValoreCampo=request.form("data")				elseif oper="edit" then					ValoreCampo=rs_news("data")			  	elseif oper="new" then			  		ValoreCampo=formatdatetime(date(),2)				end if%>				<div class="input-group">					<span class="input-group-addon"><span class="input-text">Data</span></span>					<input type="text"  class="form-control input-lg col-md-4" placeholder="Data della pagina" name="data" value="<%=ValoreCampo%>">				</div><!-- End .input-group -->				<div class="tab-container clearfix">	                <ul class="nav-tabs nav-justified clearfix">	                  <li class="active"><a href="#it" data-toggle="tab">Italiano</a></li>	                  <li class=""><a href="#en" data-toggle="tab">Inglese</a></li>	                </ul>                    <div class="tab-content clearfix">                        <div class="tab-pane active" id="it">	                                        	                                        			          		<%if error<>"" then						  		ValoreCampo=request.form("titolo")							elseif oper="edit" then								ValoreCampo=rs_news("titolo")						  	elseif oper="new" then						  		ValoreCampo=""							end if%>							<div class="input-group">								<span class="input-group-addon"><span class="input-text">Titolo</span></span>								<input type="text"  class="form-control input-lg" placeholder="Titolo della pagina" name="titolo" value="<%=ValoreCampo%>">							</div><!-- End .input-group -->							<%if error<>"" then						  		ValoreCampo=request.form("testo")							elseif oper="edit" then								ValoreCampo=rs_news("testo")						  	elseif oper="new" then						  		ValoreCampo=""							end if%>							<div class="panel panel-default">							  <div class="panel-heading textarea-addon">Testo del contenuto</div>	  							<textarea  id="testo_div" class="panel-body mce" style="height: 600px;" name="testo">								<%=ValoreCampo%>	  							</textarea>							</div>        					<input type="hidden" name="testo" id="testo" value=""/>        					<!-- End .col-md-12 -->                        </div><!-- End .tab-pane -->                                                                <div class="tab-pane" id="en">			          		<%if error<>"" then						  		ValoreCampo=request.form("titolo_en")							elseif oper="edit" then								ValoreCampo=rs_news("titolo_en")						  	elseif oper="new" then						  		ValoreCampo=""							end if%>							<div class="input-group">								<span class="input-group-addon"><span class="input-text">Titolo</span></span>								<input type="text"  class="form-control input-lg" placeholder="Titolo della pagina" name="titoloen" value="<%=ValoreCampo%>">							</div><!-- End .input-group -->							<%if error<>"" then						  		ValoreCampo=request.form("testo_en")							elseif oper="edit" then								ValoreCampo=rs_news("testo_en")						  	elseif oper="new" then						  		ValoreCampo=""							end if%>							<div class="panel panel-default">							  <div class="panel-heading textarea-addon">Testo del contenuto</div>	  							<textarea  id="testo_en_div" class="panel-body mce" name="testo_en">								<%=ValoreCampo%>	        					</textarea>							</div>        					<input type="hidden" name="testo_en" id="testo" value=""/>        					<!-- End .col-md-12 -->                        </div><!-- End .tab-pane -->                    </div><!-- End .tab-content -->                </div><!-- End .tab-container -->				<div class="xs-margin"></div><!-- space -->				<%if error<>"" then			  		ValoreCampo=request.form("visualizza")				elseif oper="edit" then					ValoreCampo=rs_news("visualizza")			  	elseif oper="new" then			  		ValoreCampo=true				end if				if ValoreCampo then					ValoreCampo="checked" 				else 					ValoreCampo=""				end if								%>                <div class="input-group">					<span class="input-group-addon"><span class="input-text">Visibile</span></span>					<input type="checkbox" data-on-color="success" data-on-text="Si" data-off-text="No" name="visualizza" class="switch" <%=ValoreCampo%>>				</div><!-- End .input-group -->				<%					dim TestoPulsante					dim OperPulsante					if oper="new" then						TestoPulsante="Aggiungi"						OperPulsante="add"					elseif oper="edit" then						if instr(rs_news("tipo"),"contenuto")>0 then							btnElimina=false						else							btnElimina=true						end if												TestoPulsante="Salva modifiche"						OperPulsante="update"										end if				%>				<div class="row pull-right">				<input type="hidden" name="oper" value="<%=OperPulsante%>" id="oper"><button type="button" class="btn btn-success" id="invia"><%=TestoPulsante%></button>				<%if btnElimina then %>				&nbsp; <button type="button" class="btn btn-danger btn-sm" id="elimina"><i class="fa fa-trash-o fa-lg"></i></button>				<%end if %>         		</div><!-- End .row -->               				</form>				<%end if 'non trovato %>																																							<%end if%>								   			</div><!-- End .container -->                </section><!-- End #content -->	<!--#include virtual="/footer_inc.asp" -->    <!-- END -->	<!--#include virtual="/script_inc.asp" -->	<script language="javascript" type="text/javascript" src="jquery/js/tinymce/tinymce.min.js"></script><script type="text/javascript">		tinymce.init({			    selector: ".mce",	    //inline: true,	<!--#include virtual="/tinymce4_setup1.asp" -->	});	</script>	<script src="js/Jqueryvalidate/jquery.validate.min.js"></script>	<script src="js/Jqueryvalidate/localization/messages_it.min.js"></script>	<script>		$(function() {			$("#elimina").click(function(){				$("#oper").val("elimina");				$("#form").submit();			});			$("#invia").click(function(){				$("#form").submit();			});																});	 function copyToClipboard (text) {	     window.prompt ("Premi Ctrl+C per copiare", text);	 }	</script>    </body></html><%function tipo_contenuto(tipo)	dim risultato	select case tipo	case ""		risultato="Nuovo"		case else		if instr(tipo,"contenuto")>0 then			risultato="Contenuto home"		else					risultato=tipo		end if		end select	tipo_contenuto=risultatoend function		%>