<%'Verifica chiusure 01_12_2015%><!--#include virtual="/setup.asp" --><!--#include file="JSON_latest.asp"--><%if not utente_admin then call login()%><%'------------------------------------oper=request.form("oper")if request.form("elimina")<>"" then	sql="DELETE FROM prodotti_gruppihome WHERE id =" & request.form("elimina") & ";"	conn.execute(sql)	call reset_contenuti_home()end ifif request.form("elimina_gruppo")<>"" then	sql="DELETE FROM gruppihome WHERE idGruppo =" & request.form("idGruppo") & ";"	conn.execute(sql)	call reset_contenuti_home()	oper=""end ifif request.form("aggiungi")<>"" then	Response.ContentType = "application/json; charset=utf-8"	Response.CodePage = 65001	Set Js = jsObject()	set cerco=conn.execute ("select prodotti_gruppihome.* from prodotti_gruppihome where idGruppo="&request("idGruppo")&" and idpro="& request("idpro"))	if cerco.eof then		sql="INSERT INTO prodotti_gruppihome (idGruppo, idpro,ordine) VALUES ("& request("idGruppo")&","& request("idpro")&",0)"				conn.execute sql ,n		'sql="select @@IDENTITY FROM prodotti_gruppihome"		'set rs=conn.Execute(sql)				js("success")=true		js("message")="Articolo aggiunto"'&rs(0)	else		js("success")=false		js("message")="Articolo esistente"	end if	set cerco=Nothing		js.Flush	set js = nothing	call reset_contenuti_home()	response.end	end ifif request("tabella_articoli")<>"" then	call visualizza_articoli(request("tabella_articoli"))	response.end	end ifselect case lcase(request("oper"))	case "annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case else		oper="view"		if request.form("modifica")<>"" then oper="edit"		if request.form("elimina")<>"" then oper="edit"		if request.form("aggiungi")<>"" then oper="edit"end selectif oper="add" or oper="update" then	'controlliend ifif oper="add" or oper="update" then	Set rs = Server.CreateObject("ADODB.Recordset")	sql="select * from gruppihome"	if oper="add" then		rs.Open sql, conn, 3, 3		rs.addnew	else		sql= sql & " where idGruppo=" & request.form("idGruppo")		rs.Open sql, conn, 3, 3	end if	rs("NomeGruppo")=firstup(trim(request.form("NomeGruppo")))	rs("DescrizioneGruppo")=firstup(trim(request.form("DescrizioneGruppo")))	if request.form("visibile")="si" then		rs("visibile")=1	else		rs("visibile")=0	end if	if isnumeric(request.form("ordine")) then		ordine=cint(request.form("ordine"))	else 		ordine=0	end if	rs("ordine")=ordine	rs.update	rs.close	call riordina()	call reset_contenuti_home()	oper="view"end if//response.write oper%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!-- Stile: <%=Application("skins")%> --><!--#include virtual="/sub_head.asp" --><%if oper="edit" then%>	<link rel="stylesheet" type="text/css" href="Jquery/css/select2.css"/><%end if%><% if oper<>"view" then%><script Language="JavaScript"> annulla=false;function Validator(theForm) {if (annulla==true)  { 	return(true);      }   if (theForm.NomeGruppo.value == "")  {     alert("Inserisci un nome per il gruppo.");     theForm.nome_linea.focus();     return (false);   }   return (true); } </script><%end if%></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->         <%barra=0%><div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Gruppi articoli in home</a></div> </div>         <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" <%if oper<>"view" then%> onSubmit="return Validator(this)"<%end if%> style="margin-top:0px;">		        <%sql="select * from gruppihome "if oper="view" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr align="right">               <td colspan="2" style="border-bottom:1px solid;"><a href="<%=questofile%>?oper=new"><strong>Aggiungi gruppo</strong></a></td>            </tr>            <tr>               <%if oper="view" then%>              <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Modifica&nbsp;</td>              <%end if%>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Elenco gruppi</td>            </tr>            <%	sql= sql & "ORDER BY ordine;"	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="modifica" value="<%=rs("idGruppo")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=rs("NomeGruppo")%></td>            </tr>            <%	rs.movenext	loop	rs.close	%>          </table>          <%elseidGruppo=request.form("modifica")if request.form("id")<>"" then idGruppo=request.form("id")if request.form("idGruppo")<>"" then idGruppo=request.form("idGruppo")	sql=sql & " where idGruppo =" & idGruppo	if oper="edit" then		set rs=conn.execute(sql)		testo= "Modifica gruppo"	else		testo= "Nuovo gruppo"	end if		  %>          <input type="hidden" name="idGruppo" value="<%=idGruppo%>">          <%if error<>"" then			  		descrizione=request.form("descrizione")			  	elseif oper="new" then			  		descrizione=""				end if%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header"><%response.write testo%></td>            </tr>            <tr>              <td align="right" valign="top">Nome gruppo</td>              <td><%if error<>"" then			  		testo=request.form("NomeGruppo")				elseif oper="edit" then					testo=rs("NomeGruppo")			  	elseif oper="new" then			  		testo=""				end if%>                  <input type="text" name="NomeGruppo" value="<%=testo%>" size="40" class="richiesto">              </td>            </tr>            <tr>               <td align="right" valign="top">Descrizione</td>              <td>  <%if error<>"" then			  		testo=request.form("DescrizioneGruppo")				elseif oper="edit" then					testo=rs("DescrizioneGruppo")			  	elseif oper="new" then			  		testo=""				end if%> <textarea name="DescrizioneGruppo" cols="40" rows="4"><%=testo%></textarea>              </td>            </tr>            <tr>              <td align="right" valign="top">Ordine di visualizzazione</td>              <td><%if error<>"" then			  		testo=request.form("ordine")				elseif oper="edit" then					testo=rs("ordine")			  	elseif oper="new" then			  		testo=-10				end if%>                                                      <select name="ordine" id="ordine" >              <option value="0">Primo</option><%	              sql="select * from gruppihome"if oper="edit" then sql=sql&" where idgruppo<>"&idGruppo&" order by ordine ;"Set rsm=conn.execute(sql)do while not rsm.eofresponse.write "<option value=""" & rsm("ordine")+5 &""""if int(testo)=int(rsm("ordine")+10) then response.write " selected"response.write ">dopo " & rsm("nomegruppo")& "</option>"rsm.movenextlooprsm.closeset rsm = Nothing%></select>              </td>            </tr>            <tr>              <td align="right" valign="top">Visualizza</td>              <td><%val=""				if oper="edit" then					if rs("visibile") then val=" checked"				elseif oper="new" then					val=""				else					val=request.form("visibile")					if val="si" then val=" checked"				end if				if val<>" checked" then val=""				%>              <input type="checkbox" name="visibile" value="si" title="Visualizza nella home page" <%response.write val%><%if view="view" then response.write " disabled"%>></td>            </tr>            <tr>              <td colspan="2" align="center"> <%		if oper="view" then			txt=puls_new		elseif oper="new" or error<>"" then			txt="Aggiungi"		elseif oper="edit" then			txt="Modifica"		end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Annulla" onClick="annulla=true;">    <%end if%>    <%if oper="edit" and num=0 and error="" then%>    <input type="submit" name="elimina_gruppo" value="Elimina">    <%end if%></td>            </tr>          </table>       <%if oper="edit" thenrs.close%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td class="ui-widget-header">Aggiungi articolo al gruppo</td>            </tr>            <tr>               <td style="border-bottom:1px solid;">  Articolo da aggiungere                         <input type="hidden" id="idpro" name="idpro" style="width: 200px; "><input type="button" value="Aggiungi" id="aggiungi"></td>            </tr>          </table>          <div id="tabella_articoli">                    <%	          call visualizza_articoli(idgruppo)	       %>          </div><script type="text/javascript" src="Jquery/js/select2.js"></script>  <script type="text/javascript">$(document).ready(function () {	$('#idpro').select2({		placeholder: 'Seleziona articolo',		minimumInputLength: 3,		allowClear: true,		ajax: {			quietMillis: 150,			url: "ajax_function.asp?select2=articoli_sel2",			dataType: 'json',			data: function (term, page) {				return {					term: term				};			},			results: function (data) {				return {					results: data				};			}		}	});$("#aggiungi").click(function() {	var idpro=$("#idpro").val();	var idgruppo=<%=idgruppo%>;	console.log ("idpro:"+idpro);	if (idpro == '' ) {		alert("Selezionare un articolo dall\'elenco a discesa");		//document.form1.testo.focus();		return false;	}	$.ajax({		url     : "<%=questofile%>",			type    : "post",			dataType: 'json',			data	: "aggiungi=si&idpro="+idpro+"&idgruppo="+idgruppo,			success: function(data){				console.log(data.message);				//alert(data.Message);				$.get("<%=questofile%>?tabella_articoli="+idgruppo, function(result){				$("#tabella_articoli").html(result);		 });								}			,error:function(xhr, textStatus, error){				console.log("Errore ricerca quantita");			      console.log("xhr.statusText:"+xhr.statusText);			      console.log("xhr.responseText:"+xhr.responseText);			      console.log("textStatus:"+textStatus);			      console.log("error:"+error);				  }		});});});</script>			<%end ifend ifset rs = Nothingcall connclose()%>        </form>  <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%rsClosesub riordina()			sql="select * from gruppihome  order by ordine;"			rs.open sql, conn,3,3			ordine=10			do while not rs.eof			rs("ordine")=ordine			rs.update			ordine=ordine+10			rs.movenext			loop			rs.closeEnd Sub	sub visualizza_articoli(idgruppo)	sql="select SQL_CALC_FOUND_ROWS prodotti_gruppihome.*, prodotti.codice, prodotti.articolo "	sql=sql &" FROM prodotti_gruppihome INNER JOIN prodotti ON prodotti_gruppihome.idpro = prodotti.IDpro WHERE (((prodotti_gruppihome.idGruppo)="& idGruppo &")) "	sql= sql & "ORDER BY codice;"	'set rs=conn.execute(sql)	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql,conn,3,3	lngTotalRecords=clng(conn.Execute("Select Found_Rows();")(0).Value)%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header"><%=lngTotalRecords%> articoli nel gruppo </td>            </tr>            <tr>               <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Rimuovi&nbsp;</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Articoli</td>            </tr>            <%	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="elimina" value="<%=rs("id")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=rs("codice") & " " & rs("articolo")%></td>            </tr>            <%	rs.movenext	loop	rs.close	set rs=nothing	%>          </table>  	<%        end sub%>