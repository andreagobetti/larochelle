<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()mese=request("mese")if mese="" then	mese=0	anno=year(date())else	anno=request("anno")end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%><div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Transazioni Paypal</a></div>    </div><%if false then%>		<form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >       <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>            <td colspan="4" class="ui-widget-header">Spedizioni: </td>          </tr>          <tr>             <td colspan="4" style="border-bottom:1px solid;">Mese              <select name="MESE" onChange="this.form.submit()">                <option value="">Selezionare</option>                <%for n=1 to nome_mese(0)	response.write "<option value='"&n&"'"	if n=cint(mese) then response.write " selected"	response.write  ">" & nome_mese(n)&"</option>"next%>              </select>               Anno              <input type="text" name="anno" value="<%=anno%>">              <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;"></td>          </tr></table></form>		  <%end if%>        <%		mese=1		if mese<>"0" then%>		<%		sql="select * from pagamenti_paypal order by idpayp desc" PaginazioneString = "&mese="&mese&"&anno="&annocall paginazione_start(sql,100,"mysql")%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">		<%if false then%>          <tr>             <td colspan="8" class="ui-widget-header">Spedizioni mese di <%=nome_mese(mese)%> <%=anno%>: <%=objPagingRS.recordcount%> elementi</td>          </tr>		<%end if%>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Transazione</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Cliente</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Importo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Ordine</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Payment status</td>          </tr>          <%iRecordsShown = 0Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>          <tr>            <td style="border-bottom:1px solid;"><input name="" type="checkbox" value=""></td>             <td style="border-bottom:1px solid;"><%=objPagingRS("payment_date")%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><b><%=objPagingRS("pp_txn_id")%></b></td>			<td style="border-bottom:1px solid;"><%=objPagingRS("cust_firstname")&" "&objPagingRS("cust_lastname")&" "&objPagingRS("cust_biz_name")%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("payment_currency")&" "&objPagingRS("mc_gross")%></td>            <td style="border-bottom:1px solid;"><%=objPagingRS("item_number")%></td>            <td style="border-bottom:1px solid;"><%=objPagingRS("payment_status")%></td>          </tr>          <% 			iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(7,true)	%>                  </table><%end if%>        <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>