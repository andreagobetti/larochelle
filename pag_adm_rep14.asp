<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><%if session("idadmin") = "" then call login()width=400 'Larghezza input boxidsettore=request("idsettore")idfornitore=request("idfornitore")if idsettore="" then idsettore=0idpro=request("idpro")if request("idprod")<>"" then	idpro=request("idprod")end ifidprod=idpro%><%oper="view"' Aggiorna quantità%><!--#include virtual="/sub_head_adm.asp" --></head><body> <div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa"> <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-top titolo_admin"><a href="<%=questofile%>">Stampa etichette</a></div></div>        <!-- Colonna CORPO INIZIO-->          <%if oper="view" then	          sql="select magazzino.idmag, magazzino.idpro, magazzino.idvara,magazzino.idvarb, prodotti.codice, varianti_a.variante_a,varianti_b.variante_b from ((magazzino left join prodotti on magazzino.idpro = prodotti.idpro ) left JOIN varianti_a on magazzino.idvara = varianti_a.idvara ) left join varianti_b on magazzino.idvarb = varianti_b.idvarb"	          	          ordine=request.form("ordine")cercain=request.form("cercain")cerca=request.form("cerca")function fullcat(id,tmp)	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	sql_order = "select * FROM settori WHERE idsettore = " & id	rs_order.open sql_order,conn	if not rs_order.eof then			str=tmp&"&lt;"&rs_order("nome_settore") 		tmp=fullcat(rs_order("idpadre"),str)	else	tmp=mid(tmp,5)	end if	fullcat=tmp	rs_order.close	set rs_order=nothingEnd functioniPageSize=grec4pageorder = "&cat="&cat&"&cercain="&cercain&"&cerca="&cercaif Request.QueryString("page")="" then	page = session("page")else	page=Request.QueryString("page")	session("page")=pageend if		%><form id="form1" method="post" action="<%=questofile%>" style="margin-top: 0px;">	<input type="hidden" name="singolo" value="<%=singolo%>">	<div class="ui-widget-content ui-corner-bottom">	<select name="selezione" id="selezione">	<option value="A" <%if idpro<>"" then%>selected<%end if%>>Articolo</option>	<option value="S" <%if idsettore<>0 then%>selected<%end if%>>Settore</option>	<option value="F" <%if idfornitore<>"" then%>selected<%end if%>>Fornitore</option>	</select>			<input type='hidden' name='idsettore' id='idsettore' style="min-width:300px;" value="<%=idsettore%>"/>			<input type='hidden' name='idfornitore' id='idfornitore' value="<%=idfornitore%>"/>			<input type='hidden' name='idprod' id='idprod' value="<%=idprod%>"/>                                         </div><div class="div_spaziatore"></div></form>          <%else          end ifcall connclose()          %> <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><script type="text/javascript" src="Jquery/js/select2.js"></script>  <script type="text/javascript">$(document).ready(function () {	function attiva_select2(Url,Placeholder){		  	$('#idsettore').select2({				placeholder: Placeholder,				minimumInputLength: 1,				//allowClear: true,				ajax: {					quietMillis: 150,	  			url: Url,					dataType: 'json',					data: function (term, page) {						return {							term: term						};					},					results: function (data) {												return {							results: data						};					}				}			});		}	$('#idsettore').on("select2-selecting", function(e) {		var idsettore = e.object.id;		if($("#selezione").val()=="A")		{		  	$('#idprod').val(idsettore);		}		else if($("#selezione").val()=="F")    	{			$('#idfornitore').val(idsettore);    	}    	else    	{			$('#idsettore').val(idsettore);	    	    	}		$("#form1").submit();    });    $("#selezione").on('change', function() {	    		if($("#selezione").val()=="A")		{		  	attiva_select2("ajax_function.asp?select2=articoli_sel2","Cerca articolo");		}			else if($("#selezione").val()=="F")    	{		  	attiva_select2("ajax_function.asp?select2=fornitori_sel2","Cerca fornitore");    	}    	else    	{		  	attiva_select2("ajax_function.asp?select2=settori", "Cerca settore");	    	    	}    });	if($("#selezione").val()=="A")	{	  	attiva_select2("ajax_function.asp?select2=articoli_sel2","Cerca articolo");	}	else if($("#selezione").val()=="F")	{	  	attiva_select2("ajax_function.asp?select2=fornitori_sel2","Cerca fornitore");	}	else	{	  	attiva_select2("ajax_function.asp?select2=settori", "Cerca settore");    		}        });</script></body></html><%function aggiungi_virgola(str_A, str_B)	dim virgola	virgola=""	if str_A<>"" then virgola=","	aggiungi_virgola=str_A&virgola&str_Bend functionsub mappacatselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM settori WHERE idpadre = " & id &" and idsettore<>"&escludi&" order by nome_settore;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("idsettore") &""""		if int(val)=int(rs_order("idsettore")) then response.write " selected"		response.write ">" &spaceing& rs_order("nome_settore")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappacatselezione(layer+1,rs_order("idsettore"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	%>