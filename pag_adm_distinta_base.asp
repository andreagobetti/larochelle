<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()dbg=false'------------------------------------oper=lcase(request.form("oper"))fase="uno"if request.form("elimina")<>"" then	txt_log="Eliminata voce distinta base"	set rs_db=conn.execute ("select * from distinta_base WHERE iddb =" & request.form("iddb") & ";")	'Articolo venduto	idpro_acq=rs_db("idpro_acq")	idvara_acq=rs_db("idvara_acq")	idvarb_acq=rs_db("idvarb_acq")	'Articolo di acquisto	idpro=rs_db("idpro_ven")	idvara_ven=rs_db("idvara_ven")	idvarb_ven=rs_db("idvarb_ven")		conn.execute("DELETE FROM distinta_base WHERE iddb =" & request.form("iddb") & ";")		txt_log=txt_log&imposta_dbven_dbacq(idpro,idvara_ven,idvarb_ven,idpro_acq,idvara_acq,idvarb_acq)	add2log txt_log,2	end ifif dbg then response.write "Oper prima di analisi:"&oper&"<br>"select case lcase(request("oper"))	case "annulla"		oper="list"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "salva modifiche"		oper="update"	case "avanti"		oper="add"		fase="due"		if dbg then response.write "fase due:"&oper	case else		oper="list"		if request.form("modifica")<>"" then oper="edit"		if request.form("aggiungi")<>"" then oper="edit"		if request.form("dettaglio")<>"" then oper="dettaglio"		if request.form("cerca_dbven")<>"" then oper="cerca_dbven"		if request.form("cerca_dbacq")<>"" then oper="cerca_dbacq"end selectif oper="add" or oper="update" then	'controlliend ifif oper="add" or oper="update" thenif dbg then response.Write("idpro"&request.form("idpro")&"idvara"&request.form("idvara")&"|quantità"&request.form("quantità"))	Set rs = Server.CreateObject("ADODB.Recordset")	sql="select * from distinta_base"	if oper="add" then		rs.Open sql, conn, 1, 2		rs.addnew		idpro=request.form("idpro")		rs("idpro_ven")=idpro		if request.form("idvara")<>"" then 			idvara=request.form("idvara")		else			idvara=0		end if		rs("idvara_ven")=idvara		if request.form("idvarb")<>"" then 			idvarb=request.form("idvarb")		else			idvarb=0		end if		rs("idvarb_ven")=idvarb				idpro_acq=request.form("idpro_acq")		rs("idpro_acq")=idpro_acq		if request.form("idvara_liv1")<>"" then			idvara_acq=request.form("idvara_liv1")		else			idvara_acq=0		end if		rs("idvara_acq")=idvara_acq				if request.form("idvarb_liv1")<>"" then			idvarb_acq=request.form("idvarb_liv1")		else			idvarb_acq=0		end if		rs("idvarb_acq")=idvarb_acq				rs("idmag_ven")=conn.execute("select idmag from magazzino where idpro="&idpro&" and idvara="&idvara&" and idvarb="&idvarb)(0)		rs("idmag_acq")=conn.execute("select idmag from magazzino where idpro="&idpro_acq&" and idvara="&idvara_acq&" and idvarb="&idvarb_acq)(0)						txt_log="Aggiunto"	else		sql= sql & " where iddb=" & request.form("iddb")		rs.Open sql, conn, 1, 2		idvara=rs("idvara_ven")		idvarb=rs("idvarb_ven")		idpro=rs("idpro_ven")		idpro_acq=rs("idpro_acq")		idvara_acq=rs("idvara_acq")		idvarb_acq=rs("idvarb_acq")		txt_log="Modificato"	end if								rs("quantita")=aggiusta_decimale(request.form("quantita"),"asp")		rs.update	rs.close		set rs = Nothing	txt_log_fine=imposta_dbven_dbacq(idpro,idvara,idvarb,idpro_acq,idvara_acq,idvarb_acq)	'Raccolgo dati per log	txt_log=txt_log&" distinta base [articolo="& idpro&"]"&conn.execute ("select prodotti.codice from prodotti where idpro="&idpro)(0)&"[/articolo] "	if idvara=0 then		txt_log=txt_log&", variante A: nessuna"	else		txt_log=txt_log&", variante A: "&conn.execute("select varianti_a.variante_a from varianti_a where idvara="&idvara)(0)	end if	if idvarb=0 then		txt_log=txt_log&", variante B: nessuna"	else		txt_log=txt_log&", variante B: "&conn.execute("select varianti_b.variante_b from varianti_b where idvarb="&idvarb)(0)	end if	call add2log(txt_log&txt_log_fine,2)	oper="dettaglio"	dettaglio=idpro&"|"&idvara&"|"&idvarb		end iffunction imposta_dbven_dbacq(idpro_ven,idvara_ven,idvarb_ven,idpro_acq,idvara_acq,idvarb_acq)	dim db_acq,db_ven,txt		db_acq=clng(conn.execute ("select count(*) from distinta_base where idpro_acq="&idpro_acq&" and idvara_acq="&idvara_acq&" and idvarb_acq="&idvarb_acq)(0))	db_ven=clng(conn.execute ("select count(*) from distinta_base where idpro_ven="&idpro_ven&" and idvara_ven="&idvara_ven&" and idvarb_ven="&idvarb_ven)(0))	txt="trovato "& db_acq&" per idpro_acq:"&idpro_acq&" idvara_acq:"&idvara_acq&" idvarb_acq:"&idvarb_acq&", trovato "& db_ven&" per idpro_ven:"&idpro_ven&" idvara_ven:"&idvara_ven&" idvarb_ven:"&idvarb_ven&", "	if db_acq>0 then db_acq=1	if db_ven>0 then db_ven=1		sql1="UPDATE magazzino SET magazzino.db_ven = "&db_ven&"  where idpro="&idpro_ven&" and idvara="&idvara_ven&" and idvarb="&idvarb_ven	conn.execute sql1,n1	sql2="UPDATE magazzino SET magazzino.db_acq = "&db_acq&"  where idpro="&idpro_acq&" and idvara="&idvara_acq&" and idvarb="&idvarb_acq	conn.execute sql2,n2		imposta_dbven_dbacq=txt&", impostato db_ven:"&db_ven&"/"&n1&" db_acq:"&db_acq&"/"&n2	end functionif dbg then response.write "Oper dopo analisi:"&oper'response.write queryeform()if utente_andrea then response.write "[soloio]"&"oper:"&oper&" fase:"&fase&"[/soloio]"%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><% if oper<>"view" then%><style type="text/css">/*ui-autocomplete*/	.ui-autocomplete-loading {		background: white url('images/ui-anim_basic_16x16.gif') right center no-repeat;	}	.ui-autocomplete {		max-height: 500px;		overflow-y: auto;		/* prevent horizontal scrollbar */		overflow-x: hidden;	}	/* IE 6 doesn't support max-height	 * we use height instead, but this forces the menu to always be this tall	 */	* html .ui-autocomplete {		height: 500px;	}/*ui-autocomplete con immagini*/DIV.list_item_container {    height: 102px;    padding: 3px;}DIV.image {    width: 100px;    height: 100px;    float: left;	margin-right:5px;}DIV.description {    font-style: italic;    font-size: 0.9em;    color: gray;}DIV.label {	font-weight:bold;    font-size: 1.2em;}</style><%end if%></head><body><div id="wrap"><div id="header"><%=titolo_top%> <!-- Box CORPO INIZIO--><%barra=0%>	<div id="barra_fissa">  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>" class="Amministra_piccolo">Distinte base</a></div></div>        <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         <form name="form1" id="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;">          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="" class="ui-widget-header">Distinta base</td>            </tr>            <tr>               <td colspan="" style="border-bottom:1px solid;"><input type="button" id="ricerca" value="Ricerca" style="FONT: 12px;"><span style="float:right;"><a href="<%=questofile%>?oper=new"><strong>Aggiungi elemento db</strong></a></span></td>            </tr>				  <%if filtro then					display=""				else					display="display: none;"			  end if			  			  %>			<tr style="border-bottom:1px solid; <%=display%>" id="tr_ricerca">			<td  colspan="">				<input type='hidden' name='cerca_idpro' id='cerca_idpro' style="width:350px;" />		        <input type='hidden' name='cerca_idvara' id='cerca_idvara' style="width:150px;" class="step1"/>		        <input type='hidden' name='cerca_idvarb' id='cerca_idvarb' style="width:150px;" class="step1"/>				<input type='submit' name='cerca_dbven' id='cerca_dbven' style="width:150px;" value="Vedi articoli di vendita" disabled="disabled"/>				<input type='submit' name='cerca_dbacq' id='cerca_dbacq' style="width:150px;" value="Vedi articoli di acquisto" disabled="disabled"/> per quantit&agrave; <input type='text' name='moltiplicatore' id='moltiplicatore'  value="0" disabled="disabled"/>			</td>			</tr>          </table>        <%if oper="cerca_dbven" then	idpro=request("cerca_idpro")	idvara=request("cerca_idvara")	idvarb=request("cerca_idvarb")	sql_prodotto="select concat_ws(' ',prodotti.codice,prodotti.articolo, varianti_a.variante_a, varianti_b.variante_b) FROM (prodotti LEFT JOIN varianti_a ON prodotti.IDpro = varianti_a.idpro) LEFT JOIN varianti_b ON prodotti.IDpro = varianti_b.idpro WHERE prodotti.IDpro= "&idpro	if idvara<>"" then		sql_prodotto=sql_prodotto &" AND varianti_a.IDvara="& idvara	else		varf1=0	end if	if idvarb<>"" then		sql_prodotto=sql_prodotto &" AND varianti_b.IDvarb="& idvarb	else		varf2=0	end if	on error resume next	articolo=conn.execute (sql_prodotto)(0)	if err.number<>0 then		response.write sql_prodotto		response.end	end if'articolo=rs("codice")&" "&rs("articolo")&" "&rs("variante_a")&" "&rs("variante_b")		if idvara="" then idvara=0	if idvarb="" then idvarb=0	sql="select DISTINCT prodotti.codice, prodotti.articolo, varianti_a.variante_a, varianti_b.variante_b, distinta_base.idpro_ven, distinta_base.idvara_ven, distinta_base.idvarb_ven,distinta_base.quantita FROM ((distinta_base INNER JOIN prodotti ON distinta_base.idpro_ven = prodotti.IDpro) LEFT JOIN varianti_a ON distinta_base.idvara_ven = varianti_a.IDvara) LEFT JOIN varianti_b ON distinta_base.idvarb_ven = varianti_b.IDvarb where  distinta_base.idpro_acq="&idpro&" and distinta_base.idvara_acq="&idvara&" and distinta_base.idvarb_acq="&idvarb	%>				<!--FASE cerca_dbven-->	          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td bgcolor="#E5E5E5" style="border-bottom:1px solid;" colspan="5">Articoli in qui viene utilizzato <%=articolo%></td>                          </tr>            <tr>               <td align="center" style="border-bottom:1px solid;"></td>              <td style="border-bottom:1px solid;">Articolo</td>              <td style="border-bottom:1px solid;">Variante A</td>              <td style="border-bottom:1px solid;">Variante B</td>              <td style="border-bottom:1px solid;">Quantit&agrave;</td>            </tr>            <%	'sql= sql & "ORDER BY prodotti.codice;"	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="dettaglio" value="<%=rs("idpro_ven")&"|"&rs("idvara_ven")&"|"&rs("idvarb_ven")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=rs("codice")&" "&rs("articolo")%></td>              <td style="border-bottom:1px solid;"><%=rs("variante_a")%></td>              <td style="border-bottom:1px solid;"><%=rs("variante_b")%></td>              <td style="border-bottom:1px solid;" align="right"><%=rs("quantita")%></td>            </tr>            <%	rs.movenext	loop	rs.close	Set rs = Nothingend ifif oper="cerca_dbacq" then	idpro=request("cerca_idpro")	idvara=request("cerca_idvara")	idvarb=request("cerca_idvarb")	if idvara="" then idvara=0	if idvarb="" then idvarb=0		sql="select prodotti.IDpro, prodotti.codice, prodotti.articolo, prodotti.prezzo, magazzino.*, varianti_a.variante_a, varianti_b.variante_b FROM ((magazzino RIGHT JOIN prodotti ON magazzino.idpro = prodotti.IDpro) LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara) LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb where magazzino.idpro="&idpro&" and magazzino.idvara="&idvara&" and magazzino.idvarb="&idvarb		singolo=true		if instr(sql,"where")>0 then sql=sql&" and " else sql=sql&" where "		sql=sql & " magazzino.idpro=" & idpro		elenca=true		set rs=conn.execute(sql)                                    %>                      <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1" id="tabella">            <thead>            <tr bgcolor="#E5E5E5" >               <td  style="border-bottom: 1px solid;">&nbsp;Codice</td>              <td align="center" style="border-bottom: 1px solid;">Articolo</td>              <td  style="border-bottom: 1px solid;">Variante A</td>              <td align="center" style="border-bottom: 1px solid;">Variante B</td>              <td align="center" style="border-bottom: 1px solid;">Quantit&agrave;</td>              <td align="center" style="border-bottom: 1px solid;">Quantit&agrave; necessaria</td>              <td align="center" style="border-bottom: 1px solid;">Giacenza</td>            </tr>            </thead>            <tbody>            <%			stringa_idmag=""		iRecordsShown = 0		dentro_db=false		livello=0		Do While Not RS.EOF		call rigamagazzino(rs("idmag"),rs("quantita_magazzino"),1,rs("idpro"),rs("codice"),rs("articolo"),rs("prezzo"),rs("variante_a"),rs("variante_b"),rs("data_aggiornamento"),rs("db_ven"),rs("db_acq"),rs("idvara"),rs("idvarb"))					RS.MoveNext		singolo=false	Loop	set rs=Nothing	%></tbody><%	end if	%>			<%	        	        	        if oper="list" thensql="select DISTINCT prodotti.codice, prodotti.articolo, varianti_a.variante_a, varianti_b.variante_b, distinta_base.idpro_ven, distinta_base.idvara_ven, distinta_base.idvarb_ven FROM ((distinta_base INNER JOIN prodotti ON distinta_base.idpro_ven = prodotti.IDpro) LEFT JOIN varianti_a ON distinta_base.idvara_ven = varianti_a.IDvara) LEFT JOIN varianti_b ON distinta_base.idvarb_ven = varianti_b.IDvarb "%>			<!--LIST-->          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="4" class="ui-widget-header">Distinta base</td>            </tr>            <tr>               <%if oper="list" then%>              <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Modifica&nbsp;</td>              <%end if%>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Articoli in vendita</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>            </tr>            <%	sql= sql & "ORDER BY prodotti.codice;"	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="dettaglio" value="<%=rs("idpro_ven")&"|"&rs("idvara_ven")&"|"&rs("idvarb_ven")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=rs("codice")&" "&rs("articolo")%></td>              <td style="border-bottom:1px solid;"><%=rs("variante_a")%></td>              <td style="border-bottom:1px solid;"><%=rs("variante_b")%></td>            </tr>            <%	rs.movenext	loop	rs.close	Set rs = Nothing	%>          </table><%elseif oper="dettaglio" then	if dettaglio="" then dettaglio=request.form("dettaglio")		dettaglio=split(dettaglio,"|")	sql="select distinta_base.IDdb,distinta_base.idpro_ven, prodotti.codice, prodotti.articolo, varianti_a.variante_a,varianti_a.idvara, varianti_b.variante_b,varianti_b.idvarb FROM varianti_b RIGHT JOIN (varianti_a RIGHT JOIN (distinta_base INNER JOIN prodotti ON distinta_base.idpro_ven = prodotti.IDpro) ON varianti_a.IDvara = distinta_base.idvara_ven) ON varianti_b.IDvarb = distinta_base.idvarb_ven where idpro_ven="&dettaglio(0)&" and idvara_ven="&dettaglio(1)&" and idvarb_ven="&dettaglio(2)		set rs_db=conn.execute(sql)	articolo=rs_db("codice")&" "&rs_db("articolo")&" "&rs_db("variante_a")&" "&rs_db("variante_b")		if utente_andrea then articolo=articolo&" iddb:"&rs_db("iddb")	if dettaglio(1)>0 and isnull(rs_db("variante_a")) then		response.write "Variante a idvara:"&