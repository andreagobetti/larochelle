lder: 'Seleziona articolo',		minimumInputLength: 3,		allowClear: true,		ajax: {			quietMillis: 150,			url: "ajax_function.asp?select2=articoli_sel2&opt=attivi",			dataType: 'json',			data: function (term, page) {				return {					term: term				};			},			results: function (data) {				return {					results: data				};			}		}	});	$("#idpro_acq").on('change', function (e) {		//console.log("valore idpro val:"+$("#idpro").select2('val'))		//console.log("valore idpro data:"+$("#idpro").select2('data').id)		var data = $("#idpro_acq").select2('data');		$.ajaxSetup({			cache: false		});		varianti_liv1 = 0;		$.getJSON("ajax_function.asp?select2=varianti&term=" + data.id)			.done(function (json) {				//console.log(json);				//Verifico se ha varianti				if (json.var_a == "true") {					varianti += 1;					idvara_acq = true;				}				if (json.var_b == "true") {					varianti += 1;					idvarb_acq = true;				}				if (json.var_a == "false" && json.var_b == "false") {					quantita();				}				if (json.var_a == "true") {					$.getJSON("ajax_function.asp?select2=vara&prezzo=si&term=" + data.id)						.done(function (json) {							//Inizializzo select variante A							$('#vara_liv1').select2({								data: json,								placeholder: 'Variante A'							});							//quantita();							console.log("qui");							$("#vara_liv1").on('change', function (e) {								//console.log("change");								verifica();							});						});				} else {					$('#vara_liv1').select2("destroy");				}				if (json.var_b == "true") {					$.getJSON("ajax_function.asp?select2=varb&term=" + data.id)						.done(function (json) {							//Inizializzo select variante A							$('#varb_liv1').select2({								data: json,								placeholder: 'Variante B'							});							//quantita();							$("#varb_liv1").on('change', function (e) {								verifica();							});						});				} else {					$('#varb_liv1').select2("destroy");				}			})			.fail(function (jqxhr, textStatus, error) {				var err = textStatus + ", " + error;				console.log("Request Failed: " + err);			});	});						function verifica() {		var verifica = true;		console.log("verifica");		if (idvara_ven) {			var vara = $("#vara").select2('val');			console.log(vara.id);			if (vara.id == "") {				verifica = false;			}		}		if (idvarb_ven) {			var varb = $("#varb").select2('val');			console.log(varb);			if (varb.id == "") {				verifica = false;				//console.log("Verifica varb false");			}		}		if ($("#quantita").val() == "") {			verifica = false;			//console.log("Verifica quantita false");		}		//console.log("Fine verifica: "+verifica);		if (verifica) {			$("#ordina").removeAttr('disabled');			$("#ordina").focus();			$("#quantita").show();		} else {			//$("#ordina").hide();			$("#ordina").attr('disabled', 'disabled');		}	}	function quantita() {		$("#quantita").show();		$("#quantita").on('change', function (e) {			verifica();		});		$("#ordina").show()	}		$("#ricerca").click(function(e){		$("#tr_ricerca").toggle();	});});<%if oper<>"list" then %>	$('#form1').validate({       ignore: "",       ignoreTitle: true,             rules: {						idpro:{ required:true},			idvara:{ required: {				depends: function(element) {				return idvara_ven;				}				}},			idvarb:{ required: {				depends: function(element) {				return idvarb_ven;				}				}},			idpro_acq:{ required:true},			idvara_liv1:{ required: {				depends: function(element) {				return idvara_acq;				}				}},			idvarb_liv1:{ required: {				depends: function(element) {				return idvarb_acq;				}				}},																quantita:{ required: true}														},		messages:{					idpro:"Specificare prodotto di vendita",					idvara:"Specificare variante A di vendita",					idvarb:"Specificare variante B di vendita",					idpro_acq:"Specificare prodotto di acquisto",					idvara_liv1:"Specificare variante A di acquisto",					idvarb_liv1:"Specificare variante B di acquisto",																			},	          invalidHandler: function(e, validator){		        }   });<%end if %></script></body></html><%	sub rigamagazzino(idmag,quantita_magazzino,quantita,idpro,codice,articolo,prezzo,variante_a,variante_b,data_aggiornamento,db_ven,db_acq,idvara,idvarb)dim stileif instr(stringa_idmag,"|"&idmag&"|")=0 then	if stringa_idmag="" then stringa_idmag="|"	stringa_idmag=stringa_idmag&idmag&"|"	stile=""	if quantita_magazzino<quantita_riordino then stile="style='background:red;''"	if idpro_tmp<>idpro or singolo then		nuovo=true		idpro_tmp=idpro	else		nuovo=false	end if	classe_db_acq=""	if db_ven then		readonly=" readonly"		stile="style='background:gray; text-align: right;'"	elseif db_acq then		stile="style='background:yellow; text-align: right;'"		readonly=""		stile_bordo=""			else		stile="style='text-align: right;'"		readonly=""		stile_bordo=""	end if	if dentro_db then		classe_db_acq="db_acq"		for n=1 to livello		icona=icona+"<span class=""ui-icon ui-icon-carat-1-sw"" style=""float: left;""></span>"		next	else		icona=""	end if	%>            <tr id="id_<%=idmag%>" class="<%=classe_db_acq%>"> 			<td style="border-bottom: 1px solid;" nowrap><%=icona%><%if idpro_tmp<>"" and nuovo then%><input type="hidden" name="idpro" value="<%=idpro_tmp%>"/><%end if %><input name="test<%=idmag%>" type="hidden" value="si" /><%if nuovo then%><a href="product.asp?idpro=<%=idpro%>" class="menu_idpro" data-idpro="<%=idpro_tmp%>"><%=codice%></a><%end if%></td>			<td style="border-bottom: 1px solid; "><%if nuovo then%><input name="testidpro<%=idpro_tmp%>" type="hidden" value="si" /><%=articolo%><%end if%></td>              <td align="right" style="border-bottom: 1px solid; "><%=variante_a%></td>              <td align="center" style="border-bottom: 1px solid; "><%=variante_b%></td>              <td align="center" style="border-bottom: 1px solid;  white-space: nowrap;" > <%=quantita%>  </td>              <td align="center" style="border-bottom: 1px solid;  white-space: nowrap;" > <%=roundup(quantita*request("moltiplicatore"),2)%> </td>              <td align="center" style="border-bottom: 1px solid;  white-space: nowrap;" > <%=quantita_magazzino%> </td>            </tr>            <% 				if true then			if db_ven=1  then				dentro_db=true						sql="select distinta_base.* from distinta_base WHERE (((distinta_base.idpro_ven)="&idpro&") AND ((distinta_base.idvara_ven)="&idvara&") AND ((distinta_base.idvarb_ven)="&idvarb&"));"									set rs_db=conn.execute (sql)			if rs_db.eof then				call add2log("Non trovato db per "&sql,0)			else				livello=livello+1				 do while not rs_db.eof					'esegui nuovo loop su magazzino							sql="select prodotti.IDpro, prodotti.codice, prodotti.articolo, prodotti.prezzo, magazzino.*, varianti_a.variante_a, varianti_b.variante_b FROM ((magazzino RIGHT JOIN prodotti ON magazzino.idpro = prodotti.IDpro) LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara) LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb where magazzino.idpro="&rs_db("idpro_acq") &" and magazzino.idvara="&rs_db("idvara_acq")&" and magazzino.idvarb="&rs_db("idvarb_acq")							set rs2=conn.execute (sql)							if not rs2.eof then								call rigamagazzino(rs2("idmag"),rs2("quantita_magazzino"),rs_db("quantita"),rs2("idpro"),rs2("codice"),rs2("articolo"),rs2("prezzo"),rs2("variante_a"),rs2("variante_b"),rs2("data_aggiornamento"),rs2("db_ven"),rs2("db_acq"),rs2("idvara"),rs2("idvarb"))							end if					rs_db.movenext				loop			dentro_db=false			end if											end if	end ifelse	if utente_andrea then response.write "<tr class=""db_acq""><td colspan=""8"" style=""border-bottom: 1px solid;"" >"&codice&" "&articolo&" "&variante_a&" "&variante_b&" gi&agrave; visualizzato</td></tr>"end ifend sub		%>