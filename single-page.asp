<%'Verifica chiusure 30_11_2015%><!--#include virtual="/setup.asp" --><%	idnews=request("id")	chk=request("chk")if idnews="" or chk="" then 	session("codice_errore")=3	session("oggetto_errore")=idnews	call connclose()	response.redirect ("404.asp")end ifif not isnumeric(idnews) or not isnumeric(chk) then	call determina_sqlinjection(idnews&chk)	session("codice_errore")=3	session("oggetto_errore")=idnews	call connclose()	response.redirect ("404.asp")end ifsql="select * from news where stato='0' and idnews="&idnews&" order by ordine;"set rs_news=conn.execute(sql)if rs_news.eof then	session("codice_errore")=3	session("oggetto_errore")=idnews	set rs_news = Nothing	call connclose()	response.redirect ("404.asp")elseif chkDataUser(rs_news("data"))<>chk then	session("codice_errore")=4	session("oggetto_errore")=idnews	set rs_news = Nothing	call connclose()	response.redirect ("404.asp")end ifmeta_title=rs_news("titolo"&lingua)	%><!--#include virtual="/config/header_inc.asp" -->        <section id="content">        	<div id="breadcrumb-container">        		<div class="container">					<ul class="breadcrumb">						<li><a href="/">Home</a></li>						<li class="active"><%=rs_news("titolo"&lingua)%></li>					</ul>        		</div>        	</div>        	<div class="container">        		<div class="row">        			<div class="col-md-12">						<header class="content-title">							<h1 class="title"><%=rs_news("titolo"&lingua)%><%if session("idadmin")<>"" then%><a href="pag_adm_cont.asp?modifica=<%=idnews%>" title="Modifica pagina" class="edit-item pull-right" style="margin-right: -30px;"><i class="fa fa-pencil" style="font-size: 0.7em;"></i></a><%end if%></h1>						</header>        				<div class="xs-margin"></div><!-- space -->        				<div class="row">        					<div class="col-md-12 col-sm-12 col-xs-12 articles-container">							<%=rs_news("testo"&lingua)%>							<%set rs_news = Nothing %>        					</div><!-- End .col-md-12 -->        				</div><!-- End .row -->        			</div><!-- End .col-md-12 -->        		</div><!-- End .row -->			</div><!-- End .container -->        </section><!-- End #content -->	<!--#include virtual="/footer_inc.asp" -->    <!-- END -->	<!--#include virtual="/script_inc.asp" -->    </body></html>