<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><%if session("idadmin") = "" then call login()damese=request.form("damese")amese=request.form("amese")anno=request.form("anno")if damese="" then	damese=month(date())end ifif amese="" then	amese=month(date())end ifif anno="" then	anno=year(date())end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><script>$(function () {    $("#esporta_excel").on("click", function (e) {				e.preventDefault();				//Usare serialize sul form				//var str_link="pag_adm_rep11_excel.asp?iva="+$("#iva").val()+"&provincia="+$("#provincia").val()+"&regione="+$("#regione").val()+"&agente="+$("#agente").val()+"&tipologia="+$("#tipologia").val()+"&ordini="+$("#ordini").val()+"&fatture="+$("#fatture").val()+"&anno="+$("#anno").val()+"&cli_for="+$("#cli_for").val();				str_link="pag_adm_rep11_excel.asp?"+$("#form1").serialize();				window.location = str_link;								});	$("#damese").change(function(){		console.log("damese:"+$("#damese").val()+" amese:"+$("#amese").val());		if (Number($("#damese").val())>Number($("#amese").val())){		$("#amese").val($("#damese").val()) ;		}	});	$("#amese").change(function(){		if (Number($("#damese").val())>Number($("#amese").val())){		$("#damese").val($("#amese").val()) ;		}	});});</script></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%>		<div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-top titolo_admin"><a href="<%=questofile%>">Esporta elenco utenti</a></div>    		</div>       		<form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >               <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1"><tr >             <td style="border-bottom:1px solid;">    			<select name="cli_for" id="cli_for" >				<option value="C" <%if val="C" then response.write " selected"%>>Solo Clienti</option>				<option value="F" <%if val="F" then response.write " selected"%>>Solo fornitori</option>			</select>			<select name="tipo" id="tipo" >				<option value="" <%if val="" then response.write " selected"%>>Tipo: Tutti</option>				<option value="S" <%if val="S" then response.write " selected"%>>Società</option>				<option value="D" <%if val="D" then response.write " selected"%>>Ditta individuale</option>				<option value="P" <%if val="P" then response.write " selected"%>>Privato</option>				<option value="N" <%if val="N" then response.write " selected"%>>Non specificato</option>			</select>				              <select name="iva" id="iva">                              <option value="">IVA: Tutti</option>                              <option value="1" <%if request("iva")="1" then%> selected <%end if%>>Iva Vs. carico ex art.17</option>                              <option value="2" <%if request("iva")="2" then%> selected <%end if%>>Escluso Iva Vs. carico ex art.17</option>              </select><% 				set rs_comuni=conn.execute("select * from elenco_province order by denominazione_provincia")				val=request("provincia")%>              <select name="provincia" id="provincia" >                <option value="">Province: Tutti</option>                <%				do while not rs_comuni.eof								response.write "<option value='"&rs_comuni("sigla_automobilistica")&"'"				if rs_comuni("sigla_automobilistica")=val then response.write " selected "				response.write ">" & rs_comuni("denominazione_provincia")&"</option>"				rs_comuni.movenext				loop				rs_comuni.close				set rs_comuni=nothing				%>              </select>			<select name="regione" id="regione" >                <option value="">Regioni: Tutte</option>                <%				set rs_regioni=conn.execute ("select DISTINCT elenco_province.Codice_regione, elenco_province.Denominazione_regione FROM elenco_province order by Denominazione_regione")				do while not rs_regioni.eof					response.write "<option value='"&rs_regioni("Codice_regione")&"'"					if rs_regioni("Codice_regione")=val then response.write " selected "					response.write ">" & rs_regioni("Denominazione_regione")&"</option>"					rs_regioni.movenext				loop				rs_regioni.close				set rs_regioni=nothing			%>			</select>                       <%				set rs=conn.execute("select * from utenti_tipologia order by tipologia")		  			  %>         <select name="tipologia"  id="tipologia">                <option value="">Tipologie: Tutte</option>                <%				val=request("tipologia")				do while not rs.eofresponse.write "<option value='"&rs("id")&"'"if cstr(rs("id"))=val then response.write " selected "response.write ">" & rs("tipologia")&"</option>"rs.movenextlooprs.close%>              </select>  <%	set rs=conn.execute("select * from agenti order by nominativo")					val=request("agente")				  %>         <select name="agente" id="agente" >                <option value="">agenti: Tutti</option>				<option value="-1" <%if val="-1" then response.write " selected"%>>Mostra colonna</option>                <%				do while not rs.eofresponse.write "<option value='"&rs("idagente")&"'"if cstr(rs("idagente"))=val then response.write " selected "response.write ">" & rs("nominativo")&"</option>"rs.movenextlooprs.closeset rs = nothingcall connclose()%>              </select>			<select name="ordini" id="ordini" >				<option value="">ordini: Tutti</option>				<option value="1" <%if val="1" then response.write " selected"%>>Con ordini</option>				<option value="2" <%if val="2" then response.write " selected"%>>Senza ordini</option>			</select>			<select name="fatture" id="fatture" >				<option value="">fatture: Tutti</option>				<option value="1" <%if val="1" then response.write " selected"%>>Con fatture</option>				<option value="2" <%if val="2" then response.write " selected"%>>Senza fatture</option>			</select>              Anno (ordini o fatture)              <input name="anno" id="anno" type="text" value="" size="4">                                          <button id="esporta_excel">Esporta excel</button>                           </td>          </tr></table></form>                       <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>