<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()damese=request.form("damese")amese=request.form("amese")anno=request.form("anno")if damese="" then	damese=month(date())end ifif amese="" then	amese=month(date())end ifif anno="" then	anno=year(date())end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><script>$(function() {	$("#damese").change(function(){		console.log("damese:"+$("#damese").val()+" amese:"+$("#amese").val());		if (Number($("#damese").val())>Number($("#amese").val())){		$("#amese").val($("#damese").val()) ;		}	});	$("#amese").change(function(){		if (Number($("#damese").val())>Number($("#amese").val())){		$("#damese").val($("#amese").val()) ;		}	});});</script></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%><div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Report ordini mese</a></div>    </div>       <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >               <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr >             <td style="border-bottom:1px solid;">Dal mese              <select name="DAMESE" id="damese" >                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(damese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select> al mese              <select name="AMESE" id="amese">                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(amese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select>               Anno              <input name="anno" id="anno" type="text" value="<%=anno%>" size="4"> <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;">  <button id="esporta_excel">Esporta excel</button>              <script>$(function () {    $("#esporta_excel").on("click", function (e) {				e.preventDefault();				var str_link="pag_adm_rep10_excel.asp?damese="+$("#damese").val()+"&amese="+$("#amese").val()+"&anno="+$("#anno").val()+"&iva="+$("#iva").val()+"&provincia="+$("#provincia").val()+"&agente="+$("#agente").val()+"&tipologia="+$("#tipologia").val();						window.location = str_link;								});			  });			  </script>                            </td>          </tr>          <tr >             <td style="border-bottom:1px solid;">                            <select name="iva" id="iva">                              <option value="">Qualsiasi IVA</option>							  <option value="-1" <%if request("iva")="-1" then%> selected <%end if%>>Distinzione IVA</option>                              <option value="1" <%if request("iva")="1" then%> selected <%end if%>>Iva ad esigibilit&agrave; differita o Vs. carico</option>                              <option value="2" <%if request("iva")="2" then%> selected <%end if%>>Escluso Iva ad esigibilit&agrave; differita o Vs. carico</option>              </select><%				set rs_comuni=conn.execute("select * from elenco_province order by denominazione_provincia")				val=request("provincia")%>              <select name="provincia" id="provincia" >                <option value="">Qualsiasi provincia</option>				<option value="raggruppa"<%if val="raggruppa" then response.write " selected"%>>Raggruppa per provincia</option>                <%				do while not rs_comuni.eof				response.write "<option value='"&rs_comuni("sigla_automobilistica")&"'"if rs_comuni("sigla_automobilistica")=val then response.write " selected "response.write ">" & rs_comuni("denominazione_provincia")&"</option>"rs_comuni.movenextlooprs_comuni.closeset rs_comuni=nothing%>              </select>     			  			  <select name="stato_ordine" id="stato_ordine">				  <option value="">Qualsiasi stato ordine</option>				  <%val=request("stato_ordine") %>					<option value="1" <%if val="1" then response.write "selected" %>><%=stato_ordine(1)%></option>					<option value="2" <%if val="2" then response.write "selected" %>><%=stato_ordine(2)%></option>					<option value="3" <%if val="3" then response.write "selected" %>><%=stato_ordine(3)%></option>					<option value="4" <%if val="4" then response.write "selected" %>><%=stato_ordine(4)%></option>					<option value="5" <%if val="5" then response.write "selected" %>><%=stato_ordine(5)%></option>					<option value="6" <%if val="6" then response.write "selected" %>><%=stato_ordine(6)%></option>					<option value="7" <%if val="7" then response.write "selected" %>><%=stato_ordine(7)%></option>			  </select>			  			  			                <%	set rs=conn.execute("select * from utenti_tipologia order by tipologia")		  			  %>         <select name="tipologia"  id="tipologia">                <option value="">Qualsiasi tipologia</option>                <%				val=request("tipologia")				do while not rs.eofresponse.write "<option value='"&rs("id")&"'"if cstr(rs("id"))=val then response.write " selected "response.write ">" & rs("tipologia")&"</option>"rs.movenextlooprs.close%>              </select>  <%	set rs=conn.execute("select * from agenti order by nominativo")					val=request("agente")				  %>         <select name="agente" id="agente" >                <option value="">Qualsiasi agente</option>				<option value="-1" <%if val="-1" then response.write " selected"%>>Mostra colonna</option>                <%				do while not rs.eofresponse.write "<option value='"&rs("idagente")&"'"if cstr(rs("idagente"))=val then response.write " selected "response.write ">" & rs("nominativo")&"</option>"rs.movenextlooprs.closeSet rs = Nothing%>              </select>                           </td>          </tr></table></form>        <%if amese<>"" and damese<>"" then%>		<%sql="select i.Azienda, i.Cognome, i.Nome, agenti.Nominativo, utenti.iduser, i.provincia, ordini.trattamento_iva_ordine, ordini.idord, ordini.nord,ordini.data, utenti.tipologia, ordini.Totale, ordini.stato, ordini.trasporto, ordini.totale_merce_ordine FROM (agenti RIGHT JOIN utenti ON agenti.IDagente = utenti.idagente) INNER JOIN ordini ON utenti.iduser = ordini.iduser inner join utenti_intestazioni i on ordini.idintestazione = i.id "sql=sql & "where tipo_documento='ordine' and month(ordini.data)>="&damese &" and month(ordini.data)<="&amese &" and anno="&anno&" and eliminato=0"filtro_iva=request("iva")colspan=8'Selezione IVAif filtro_iva="1" then	sql=sql& " and (trattamento_iva_ordine=2 or trattamento_iva_ordine=10)"elseif filtro_iva="2" then	sql=sql& " and trattamento_iva_ordine<>2 and trattamento_iva_ordine<>10"elseif filtro_iva="-1" then	separa_iva=true	colspan=colspan+2end ifif request("tipologia")<>"" then sql=sql& " and instr(tipologia,',"&request("tipologia")&",')>0"'Selezione PROVINCIAprovincia=request("provincia")if provincia="raggruppa" then	raggruppa="provincia"	ordine=" order by i.provincia, idord"elseif provincia<>"" then	sql=sql& " and i.provincia='"&request("provincia")&"'"	ordine=" order by idord"else	ordine=" order by idord"end if'stato_ordinestatoordine=request("stato_ordine")if statoordine<>"" then	sql=sql& " and stato="&statoordineend if'Selezione AGENTEagente=request("agente")if agente="-1" then	colspan=colspan+1	mostra_agente=trueelseif agente<>"" then	colspan=colspan+1	mostra_agente=true	sql=sql& " and utenti.idagente="&agente&""	'response.write "filtro agenet"end ifcall paginazione_start( sql&ordine,10000,"access")%>        <table width="100%" border="1" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="<%=colspan%>" class="ui-widget-header">Ordini dal mese di <%=nome_mese(damese)%>&nbsp;al mese di <%=nome_mese(amese)%>&nbsp;<%=anno%></td>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;"><input type="checkbox" value="" id="deseleziona"></td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Ordine.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">ID Cli.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Nominativo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Imponibile</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Totale</td>			<%if separa_iva then%>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">IVA ad esigibilit&agrave; o Vs. carico</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Escluso IVA ad esigibilit&agrave; o Vs. carico</td>			<%end if%>			<%if mostra_agente then%>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Agente</td><%end if%>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Stato</td>          </tr>          <%iRecordsShown = 0Totale=0totaleImpobibile=0provincia="0"n=0Do While iRecordsShown < iPageSize And Not objPagingRS.EOF	n=n+1	totale_ordine=cdbl(objPagingRS("totale"))	imponibile_ordine=cdbl(objPagingRS("totale_merce_ordine"))+cdbl(objPagingRS("trasporto"))	totaleImpobibile=totaleImpobibile+imponibile_ordine	totale=totale+totale_ordine         if raggruppa_coda and provincia<>ucase(objPagingRS("provincia")) then%>                        <tr>                        <td colspan="5"><b>Totali provincia</b></td>            <td  align="right"><strong><%=formatnumber(totale_provincia,2)%></strong></td>			<%if separa_iva then%>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva2,2)%></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva,2)%></td>			<%end if%>                        <td colspan="<%=colspan-6%>"></td>          </tr>          <%	totale_provincia=0	raggruppa_coda=false	totale_iva2=0	totale_iva=0		  end if		  	totale_provincia=totale_provincia+totale_ordineif raggruppa<>"" and provincia<>ucase(objPagingRS("provincia")) then%> <tr>             <td bgcolor="#E5E5E5" colspan="<%=colspan%>" ><b>Provincia di <%=objPagingRS("provincia")%></b></td>          </tr><%	provincia=ucase(objPagingRS("provincia"))	raggruppa_coda=trueend if%>          <tr>            <td style="border-bottom:1px solid;"><input name="" type="checkbox" value="" class="selezione" id="selezione_<%=n%>"></td>             <td style="border-bottom:1px solid;"><a href="pag_adm_ordini.asp?idord=<%=objPagingRS("idord")%>"><%=objPagingRS("Nord")%></a></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=formatDateTime(objPagingRS("data"), vbShortDate)%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("iduser")%></td>            <td nowrap style="border-bottom:1px solid;"><%=objPagingRS("azienda")%></td>                                    <td align="right" class="corpobox" style="border-bottom:1px solid;"><span id="imponibile_<%=n%>"><%=formatnumber(imponibile_ordine,2)%></span></td>            <td align="right" class="corpobox" style="border-bottom:1px solid;"><span id="importo_<%=n%>"><%=formatnumber(totale_ordine,2)%></span></td>			<%if separa_iva then			iva_tipo_2_10=false			%>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%if objPagingRS("trattamento_iva_ordine")=2 or objPagingRS("trattamento_iva_ordine")=10 then			iva_tipo_2_10=true			totale_iva2=totale_iva2+totale_ordine			%><%=formatnumber(totale_ordine,2)%><%end if%></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%if iva_tipo_2_10=false then			totale_iva=totale_iva+objPagingRS("totale")			%><%=formatnumber(objPagingRS("totale"),2)%><%end if%></td>			<%end if%>			<%if mostra_agente then%>            <td style="border-bottom:1px solid;" class="corpobox"><%=objPagingRS("nominativo")%></td>			<%end if%>            <td style="border-bottom:1px solid;" class="corpobox"><%=stato_ordine(objPagingRS("stato"))%></td>          </tr><% 		iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown	objPagingRS.MoveNextLoop         if raggruppa_coda then%>                        <tr>                        <td colspan="5"><b>Totali provincia</b></td>            <td  align="right"><strong><%=formatnumber(totale_provincia,2)%></strong></td>			<%if separa_iva then%>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva2,2)%></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva,2)%></td>			<%end if%>                        <td colspan="<%=colspan-6%>"></td>          </tr>          <%	totale_provincia=0	raggruppa_coda=false	totale_iva2=0	totale_iva=0		  end if%>		<%if separa_iva then%>		 <tr>		<td colspan="<%=colspan-3%>">Totali iva:</td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva2,2)%></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva,2)%></td>            <td ></td>                     </tr>		<%end if%>            		  <tr>            <td colspan="<%=colspan%>" align="right"><strong>Totale imponibile: <%=formatcurrency(totaleImpobibile,2)%></strong></td>          </tr>				  <tr>            <td colspan="<%=colspan%>" align="right"><strong>Totale ordini: <%=formatcurrency(totale,2)%></strong></td>          </tr>              <%if request.querystring("idlog")<>"" then%> <a href="<%=Request.ServerVariables("Script_Name")%>"><b>Visualizza               tutti</b></a> <%end if%> </td>          </tr>        <%end if%>						  <tr id="tr_selezionato" style="display: none; border-bottom:1px solid; border-top:1px solid;">	            <td colspan="<%=colspan%>" align="right"><strong>Totale selezionato: <span id="selezionato"></span></strong></td>	          </tr>        </table>       <!-- Div Content FINE-->       <%	       call paginazione_close()	       call connclose()	       %></div><script>$(function() {	$("#deseleziona").click(function(){		$(this).prop('checked',false);		$(".selezione").prop('checked',false);		$("#tr_selezionato").hide();	});	    $(".selezione").on("change", function (e) {		var importo=0;		var conteggio=0;		$('input[type=checkbox]').each(function () {			if(this.checked){				conteggio++;				id=$(this).attr("id").replace("selezione_", "");				var importo_txt=$("#importo_"+id).text().replace(".","").replace(",", ".");				importo+=parseFloat(importo_txt);									$("#selezionato").html(Number(importo).toLocaleString("it-IT", {minimumFractionDigits: 2}));					$("#tr_selezionato").show();								}		});		if(importo==0){								$("#tr_selezionato").hide();		}		toastr.clear();		toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};		toastr.info(conteggio+" elementi","<b>Totale: "+Number(importo).toLocaleString("it-IT", {minimumFractionDigits: 2})+"</b>");	});});		</script>	<div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>