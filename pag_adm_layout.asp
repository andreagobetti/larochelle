<%'Verifica chiusure 01_12_2015%><!--#include virtual="/setup.asp" --><!--#include virtual="/multidict_cl.asp" --><%if session("idadmin") = "" then call login()if request.querystring("reset")="si" then	call reset_contenuti_home()end ifdim ubound_contenutiDim Dict_contenuti    'The Dict ObjectSet Dict_contenuti = New MultiDimensionalDictionary 'Create an Instance of the ClassDict_contenuti.SetKey = "news" 'Key recordDict_contenuti.SetField "desc", "Notizie"Dict_contenuti.Update 'Bind the record and preapre for the next record'Marche trattatesql="select Count(brand.ID) AS Conteggio FROM brand WHERE (  in_home=true);"set rs_tot=conn.execute (sql)if not rs_tot.eof then	n="("&rs_tot("Conteggio")&" marche)"else 	n=""end ifDict_contenuti.SetKey = "brandslider" 'Key recordDict_contenuti.SetField "desc", "Marche trattate "&nDict_contenuti.Update 'Bind the record and preapre for the next recordfor n=1 to 5	Dict_contenuti.SetKey = "contenuto"&n 'Key record	Dict_contenuti.SetField "desc", "Contenuto libero "&n	Dict_contenuti.Update 'Bind the record and preapre for the next recordnext'Nuovi articolisql="select Count(prodotti.IDpro) AS Conteggio FROM prodotti WHERE visibilita=0 and novita=1;"set rs_tot=conn.execute (sql)if not rs_tot.eof then	n="("&rs_tot("Conteggio")&" articoli)"else 	n=""end ifDict_contenuti.SetKey = "nuoviarticoli" 'Key recordDict_contenuti.SetField "desc", "Nuovi articoli "&nDict_contenuti.Update 'Bind the record and preapre for the next record'Promozionesql="select Count(prodotti.IDpro) AS Conteggio FROM prodotti WHERE visibilita=0 and promozione=1;"set rs_tot=conn.execute (sql)if not rs_tot.eof then	n="("&rs_tot("Conteggio")&" articoli)"else 	n=""end ifDict_contenuti.SetKey = "promozione" 'Key recordDict_contenuti.SetField "desc", "Articoli in promozione "&nDict_contenuti.Update 'Bind the record and preapre for the next record'Slider revolutionDict_contenuti.SetKey = "sliderrev" 'Key recordDict_contenuti.SetField "desc", "Slider revolution "Dict_contenuti.Update 'Bind the record and preapre for the next record'Ricerca marca e modelloDict_contenuti.SetKey = "marcamod" 'Key recordDict_contenuti.SetField "desc", "Ricerca marca e modello"Dict_contenuti.Update 'Bind the record and preapre for the next record'Gruppi homeDict_contenuti.SetKey = "gruppihome" 'Key recordDict_contenuti.SetField "desc", "Gruppi articoli"Dict_contenuti.Update 'Bind the record and preapre for the next record'Selezione materialeDict_contenuti.SetKey = "materiali" 'Key recordDict_contenuti.SetField "desc", "Materiali lavorabili"Dict_contenuti.Update 'Bind the record and preapre for the next recordubound_contenuti=Dict_contenuti.count%><%if request.querystring("ordina")<>"" then	dim modifiche_rs	modifiche_rs=""	'add2log queryeform(),0		'GESTIONE CONTENUTI		str_arr_contenuti=request.form("id[]")		str_arr_db=""		'Creo l'array da db		'if str_arr_contenuti<>"" then			'response.write "<br>varianti:<br>"			arr_contenuti = split(str_arr_contenuti,", ")			iuboud=ubound(arr_contenuti)						'CARICO I CONTENUTI DA FORM IN DICT			Dim Dict    'The Dict Object			Dim Record    'The Record Object			Dim Field    'The Field Object			Set Dict = New MultiDimensionalDictionary 'Create an Instance of the Class						for i = 0 to iuboud					contenuto=arr_contenuti(i)										Dict.SetKey = contenuto 'Key record					Dict.SetField "ordine", i					modifiche_rs=modifiche_rs&"carico "&contenuto&":"&i&" nel dizionario<br>"					Dict.Update 'Bind the record and preapre for the next record			Next															'Creo l'array da db			set rs_settori=conn.execute( "select layout.Contenuto from layout where pagina='index.asp'")			do while not rs_settori.eof				'response.write "trovato tag"&rs("idtag")&"<br>"				if str_arr_db<>"" then str_arr_db=str_arr_db&","				str_arr_db=str_arr_db&rs_settori("Contenuto")				rs_settori.movenext			loop			set rs_settori=nothing			arr_db = split(str_arr_db,",")			'add2log "str_arr_contenuti:"&str_arr_contenuti&" str_arr_db:"&str_arr_db,0						'Trovo record da eliminare			for i = 0 to ubound(arr_db)				found = "false"					for j = 0 to ubound(arr_contenuti)					 if (arr_db(i) = arr_contenuti(j)) then					 found = "true"					 exit for					 end if					next				if found ="false" then					conn.execute "delete from layout where pagina='index.asp' and contenuto='"&arr_db(i) &"'"					modifiche_rs= modifiche_rs&"Eliminato Contenuto "&arr_db(i)&"<br>"				end if			next					'Trovo record da aggiungere		set rs_settori=Server.CreateObject("ADODB.Recordset")		rs_settori.Open "select layout.* from layout where pagina='index.asp'", conn, 1, 3		do while not rs_settori.EOF			'modifiche_rs=modifiche_rs&"verifica nuoviarticoli:"&dict.item("nuoviarticoli","ordine")&"<br>"			'modifiche_rs=modifiche_rs&"Esiste"&dict.Exists(rs_settori("contenuto"),"ordine")&"<br>"			rs_settori("ordine")=cint(dict.item(cstr(rs_settori("contenuto")),"ordine"))						rs_settori.Update 			modifiche_rs=modifiche_rs&"Imposto "&rs_settori("contenuto")& " ordine: "& rs_settori("ordine")&"<br>"			rs_settori.MoveNext		loop				strOutput = "("		for i = 0 to iuboud			found = "false"				for j = 0 to ubound(arr_db)				 if (arr_contenuti(i) = arr_db(j)) then					 found = "true"					 exit for				 end if				next			if found ="false" then				 rs_settori.addnew				 rs_settori("pagina")="index.asp"				 rs_settori("Contenuto")=arr_contenuti(i)				 rs_settori("ordine")=cint(dict.item(cstr(arr_contenuti(i)),"ordine"))				 rs_settori.update				 modifiche_rs= modifiche_rs& "aggiunto Contenuto "&arr_contenuti(i)&"<br>"				 strOutput=strOutput & arr_contenuti(i) & ","				 'ARR2temp = arr_modelli(i)			end if		next		rs_settori.close								set rs_settori=nothing		set dict=nothing'GESTIONE VARIANTE A FINE	'end if	response.write i &" settori aggiornate"	'add2log modifiche_rs,0	add2log "Ordine layout aggiornato da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]"&vbcrlf&str_arr_contenuti,1	reset_contenuti_home()	call ResponseEnd()	response.endend if			select case lcase(request("oper"))	case "","annulla"		oper="list"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case "riordina_az"		call riordina_az(0,0)		oper="list"	case "edit"		oper="edit"		id=request("id")	case else		oper="list"end selectdim layout_vuotilayout_vuoti=0%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!-- Stile: <%=Application("skins")%> --><!--#include virtual="/sub_head.asp" --><%if oper="list" then%>	<style>  #sortable1, #sortable2 {    border: 1px solid #eee;    width: 322px;    min-height: 20px;    list-style-type: none;    margin: 0;    padding: 5px 0 0 0;    float: left;    margin-right: 10px;    cursor: move;  }  #sortable1 li, #sortable2 li {    margin: 0 5px 5px 5px;    padding: 5px;    font-size: 1.2em;    width: 300px;  }    #salva{	  font-size: 12px;  }  #sortable1 {float: right;}  </style>	<script>	 function copyToClipboard (text) {	     window.prompt ("Premi Ctrl+C per copiare", "/category.asp?id="+text);	 }$(document).ready(function(){				$( "#sortable1, #sortable2" ).sortable({		cursor: "move",		connectWith: ".connectedSortable"    }).disableSelection();    	$( "#sortable1" ).sortable({	  update: function( event, ui ) {		  $("#salva").removeAttr("disabled");  		  $("#salva").css('font-size',"16px");	    console.log("font.size"+$("#salva").css("font-size"));	  }	});		    $("#salva").click(function(){	    var ordine=$("#sortable1").sortable("serialize");	    console.log("salva");	    console.log("serialize: "+$("#sortable1").sortable("serialize"));	    console.log("toArray: "+$("#sortable1").sortable("toArray"));	    	    		$.ajax({			cache :false,			url     : "<%=questofile%>?ordina=si",			type    : "post",			dataType: '',			data	: ordine,			success: function(data){				console.log("dati salvati");				toastr.options = {"positionClass": "toast-bottom-right"};				toastr.success("Modifiche salvate");				$("#salva").attr("disabled","disabled");					}			,error:function(xhr, textStatus, error){				      console.log("xhr.statusText:"+xhr.statusText);				      console.log("xhr.responseText:"+xhr.responseText);				      console.log("textStatus:"+textStatus);				      console.log("error:"+error);					  }										});		    	    	    	    	    	        });});</script><%end if%><%if oper<>"list" then%>	<script>	$(function() {		$( "input" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });		$( "select" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });		$( "textarea" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });	});		</script>    	<style>	label {		display: inline-block;		width: 5em;	}	</style>    <script Language="JavaScript"> 	annulla=false;	function Validator(theForm) 	{	if (annulla==true)  { 		return(true);    	  } 		  if (theForm.settore.value == "")  { 		alert("Specificare un nome per il settore.");		theForm.settore.focus();		return (false); 	}		  if (theForm.idpadre.selectedIndex == 0)  { 		alert("Seleziona una posizione per il settore.");		theForm.idpadre.focus(); 		return (false); 	  }	  	  return (true); 	} </script><%end if%></head><body> <div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa"> <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Organizza Home</a><span style="float: right;"><input type="button" value="Aggiorna home" onclick='window.location.href = "<%=questofile%>?reset=si"' ></span></div></div>        <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         <%if oper="list" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">			<tr>				<td align="right">Contenuti visualizzati in home page</td>				<td></td>				<td>Contenuti disponibili</td>			</tr>			<tr>							<td valign="top" >				<ul id="sortable1" class="connectedSortable">					<%						set rs_layout=conn.Execute("select layout.* from layout where pagina='index.asp' order by ordine")						dim stringa_contenuti						stringa_contenuti=""						do while not rs_layout.EOF						stringa_contenuti=stringa_contenuti&"|"&rs_layout("Contenuto")&"|"						%>										  <li class="ui-state-default" id="id_<%=rs_layout("Contenuto")%>"><span class="ui-icon ui-icon-arrow-4" style="float: left;"></span><%=Dict_contenuti.item(cstr(rs_layout("Contenuto")),"desc")%></li>					<%						rs_layout.movenext						loop						set rs_layout = Nothing						call connclose()				  %>				</ul>			</td>			<td valign="middle" align="center"><span class="ui-icon ui-icon-arrowthick-2-e-w" style="float: left;"></span></td>			<td valign="top"> 			<ul id="sortable2" class="connectedSortable">				<%										For Each Record in Dict_contenuti.Records					if instr(stringa_contenuti,"|"&Record&"|")=0 then					%>				<li class="ui-state-highlight" id="id_<%=Record%>"><span class="ui-icon ui-icon-arrow-4" style="float: left;"></span><%=Dict_contenuti.item(Record,"desc")%></li>								<%end if 					next					set Dict_contenuti=Nothing%>			</ul>			</td>			</tr>            <tr>              <td colspan="3" align="center">Ordina e sposta con il mouse</td>            </tr>            <tr>              <td style="border-top:1px solid;" colspan="3" align="center"><input type="button" id="salva" value="Salva modifiche" disabled="disabled"></td>            </tr>          </table>          	<%end if%>                <!-- Colonna CORPO FINE-->      </div>        <div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div>  </body></html><%sub layout(layer,id,testo,testo_dopo)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent idsql_order="select layout.* from layout where pagina='index.asp' order by layout.ordine"'response.write sql_order	rs_order.open sql_order,conn	nodo=true	testo=testo&testo_dopo	testo_dopo=""	if not 	rs_order.eof then 		if layer>0 then testo=testo& "<ol>"	else		nodo=false	end if	do until rs_order.eof				testo=testo&  "<li id=""id_"&rs_order("id")&""""&" class="""&classe&""">"		testo_dopo="<div><span class=""disclose""><span></span></span><span class=""testo"">"&rs_order("contenuto")&"</span><span style=""float:right; text-align:right;"">"		testo_dopo=testo_dopo&"<button style=""font-size:9px;"" onclick=""window.location.href='"&questofile&"?oper=edit&id="&rs_order("id")&"'"">Modifica</button>"		testo_dopo=testo_dopo&"<button style=""font-size:9px;"" onclick=""copyToClipboard("&rs_order("id")&");"">Copia link</button>"		if rs_order("conteggiodiidpro")>0 then			testo_dopo=testo_dopo&"<br><button style=""font-size:9px;"" onclick=""window.location.href='pag_adm_artic.asp?oper=view&idset="&rs_order("id")&"'"">Vedi articoli</button>"		else			layout_vuoti=layout_vuoti+1		end if		if rs_order("conteggiodiidpro")=0 and nodo=false then			layout_vuoti=layout_vuoti+1		end if		testo_dopo=testo_dopo&"</span>"		'if rs_order("nascondi") then testo_dopo=testo_dopo&" - Nascosta"		'if rs_order("nascondi_prezzi") then testo_dopo=testo_dopo&" - Prezzi nascosti"		testo_dopo=testo_dopo&"</div>"		'calling again to find more childs - if not rs_order=nothing	    'call mappacat(layer+1,rs_order("id"),testo,testo_dopo)	'testo=testo& "</li>"&vbcrlf		rs_order.movenext	loop	if nodo=true and layer>0 then testo=testo& "</ol>"&vbcrlf		'closing object	rs_order.close	set rs_order=nothing	if layer=0 then response.write testoEnd Sub	%>