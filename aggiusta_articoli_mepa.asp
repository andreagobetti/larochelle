<!--#include virtual="/setup.asp" --><!--#include virtual="/multidict_cl.asp" --><!--#include virtual="/jsonObject.class.asp" -->	 <%			'Prende campi meta ed imposta in prodotti		on error resume next		set JSON = New JSONobject	    set rs=conn.execute ("select prodotti.*, prodotti_mepa_campi.mepa_campi, prodotti_mepa_campi.idcategoria from prodotti inner join prodotti_mepa_campi on prodotti.idpro = prodotti_mepa_campi.idpro where idcategoria=13   order by descrizione")	    do while not rs.eof 			mepa_campi_JSON=rs("mepa_campi")			idcategoria=rs("idcategoria")			 response.write "Cerco categoria "&idcategoria&"<br>"									set rs2=conn.execute("select id, label, obbligatorio, formato, valori_default from mepa_campi where idcategoria="&idcategoria& " and label like '%Nome commerciale%'")			nome_commerciale=rs2("id")			set rs2=conn.execute("select id, label, obbligatorio, formato, valori_default from mepa_campi where idcategoria="&idcategoria& " and label='Descrizione tecnica'")			if not rs2.eof then				id_Descrizione_tecnica=rs2("id")							else				id_Descrizione_tecnica=0			end if									'response.write mepa_campi_JSON			if mepa_campi_JSON="" then 				mepa_campi_JSON="[]"			end if			JSON.Parse(mepa_campi_JSON)					descrizione=replace(JSON(""&nome_commerciale),"'","''")						sql="update prodotti set articolo='"&descrizione&"'"									if id_Descrizione_tecnica>0 then				Descrizione_tecnica=replace(JSON(""&id_Descrizione_tecnica),"'","''")				if descrizione<>Descrizione_tecnica then					Descrizione_tecnica=descrizione&"<br>"&Descrizione_tecnica				else					Descrizione_tecnica=descrizione				end if			end if			sql=sql&", descrizione='"&descrizione&"'"			sql=sql&" where idpro="&rs("idpro")			conn.execute ( sql)			response.write rs("idpro")&"<br>"&descrizione&"<br>"	    %>	    <%		    		    set rs2 = nothing		    rs.MoveNext		loop		set rs = Nothing	    %>			<%	sub scanJSON(JSONstring)		dim txt			' instantiate the class		set JSON = New JSONobject		set JSONarr = JSON.Parse(JSONstring) 			dim i, item,items	' faster but less readable	for i = 0 to JSONarr.length - 1	    if isObject(JSONarr(i)) then	        set item = JSONarr(i)		        if typeName(item) = "JSONobject" then	            response.write "OBJ:"	            item.write()	            	            response. write item.value("Nome scheda tecnica")	            response. write item.value("Label (nome dell'attributo)")	            txt=JSON.serializeObject(item)		        'call scanJSON(txt)	        else		        'call scanJSON(item.Serialize())	            response.write item	        end if	    else	        item = JSONarr(i)	        response.write item	    end if		    response.write "<br>"	next			end sub			%>