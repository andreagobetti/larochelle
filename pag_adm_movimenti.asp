<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/paginazione.asp" --><!--#include virtual="/pag_adm_movimenti_inc.asp" --><%if session("idadmin") = "" then call login()damese=request.form("damese")amese=request.form("amese")anno=request.form("anno")if damese="" then	damese=month(date())end ifif amese="" then	amese=month(date())end ifif anno="" then	anno=year(date())end if%><!--#include virtual="/sub_head_adm.asp" --><script>function aggiusta_amese(){	if (document.getElementById('AMESE').selectedIndex<document.getElementById('DAMESE').selectedIndex){	document.getElementById('AMESE').selectedIndex = document.getElementById('DAMESE').selectedIndex;	}}function aggiusta_damese(){	if (document.getElementById('AMESE').selectedIndex<document.getElementById('DAMESE').selectedIndex){	document.getElementById('DAMESE').selectedIndex = document.getElementById('AMESE').selectedIndex;	}}</script><link rel="stylesheet" type="text/css" href="Jquery/css/select2.css"/></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Movimenti magazzino</a></div><form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >	   <%if false then %>       <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr >             <td colspan="4" style="border-bottom:1px solid;">Dal mese              <select name="DAMESE" onChange="aggiusta_amese();" id="DAMESE">                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(damese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select> al mese              <select name="AMESE" onChange="aggiusta_damese();" id="AMESE">                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(amese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select>               Anno              <input name="anno" type="text" value="<%=anno%>" size="4">          <script src="Jquery/js/select2.js"></script><br /><input type='hidden' name='idpro' id='idpro' style="width:400px;"/><input type='hidden' name='idvara' id='vara' style="width:200px;"/><input type='hidden' name='idvarb' id='varb' style="width:200px;"/>  <script type="text/javascript">  $(document).ready(function () {  	$('#idpro').select2({  		placeholder: 'Filtra per articolo',  		minimumInputLength: 3,  		allowClear: true,  		ajax: {  			quietMillis: 150,  			url: "ajax_function.asp?select2=articoli_sel2",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  	});  	$("#idpro").on('change', function (e) {  		var data = $(this).select2('data');  		$.getJSON("ajax_function.asp?select2=varianti&term=" + data.id)  			.done(function (json) {  				if (json.var_a == "true") {  					$.getJSON("ajax_function.asp?select2=vara&term=" + data.id)  						.done(function (json) {  							$('#vara').select2({  								data: json,								placeholder: 'Variante A'  							});  						});  				} else {  					$('#vara').select2("destroy");  				}  				if (json.var_b == "true") {  					$.getJSON("ajax_function.asp?select2=varb&term=" + data.id)  						.done(function (json) {  							console.log("risposta varianti:" + JSON.stringify(json));  							$('#varb').select2({  								data: json,								placeholder: 'Variante B'  							});  						});  				} else {  					$('#varb').select2("destroy");  				}  			})  			.fail(function (jqxhr, textStatus, error) {  				var err = textStatus + ", " + error;  				console.log("Request Failed: " + err);  			});  	});  });</script>              <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;">               </td>          </tr></table>          <%end if %>                    </form>          <%	         call elenco_movimenti() 	          call connclose()	       %>       <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%%>