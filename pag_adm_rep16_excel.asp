<%'Verifica chiusure 05_12_2015%><!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><%if session("idadmin") = "" then call login()tdebug=falsedamese=request("damese")amese=request("amese")anno=request("anno")Set metodipagamento = New ClasseMetodipagamento 'Create an Instance of the Classif not tdebug then	Response.ContentType = "application/vnd.ms-excel"else	Response.ContentType = "text/html"end if	if not tdebug then Response.AddHeader "content-disposition", "attachment; filename=fatture_da_saldare_"&nome_mese(damese)&"_"&nome_mese(amese)&"_"&anno&".xls"	sql="select sommadiincassi.SommaDiimporto, fatture.IDFat, fatture.Nfat, fatture.totale_fattura, fatture.data, i.Cognome, i.Nome, i.Azienda, agenti.Nominativo, agenti.IDagente, utenti.iduser, fatture.pagamento, fatture.PA FROM ((fatture LEFT JOIN (select incassi.idfat, Sum(incassi.importo) AS SommaDiimporto FROM incassi GROUP BY incassi.idfat )  AS sommadiincassi ON fatture.IDFat = sommadiincassi.idfat) INNER JOIN utenti ON fatture.iduser = utenti.iduser) LEFT JOIN agenti ON utenti.idagente = agenti.IDagente inner join utenti_intestazioni i on utenti.idintestazione= i.id " sql=sql & "where totale_fattura>0 and (SommaDiimporto<totale_fattura or isnull(SommaDiimporto)) and month(fatture.data)>="&damese &" and month(fatture.data)<="&amese &" and year(fatture.data)="&annoif request("pa")="SI" then sql=sql& " and pa=true "if request("pa")="NO" then sql=sql& " and pa=false "	set rs=conn.execute(sql)	%>    <table  border="1">      <tr bgcolor="#FF66FF">    <th nowrap="nowrap" >Fatt.</th>    <th nowrap="nowrap">Data</th>    <th nowrap="nowrap">ID Cli.</th>    <th nowrap="nowrap">Nominativo</th>     <th nowrap="nowrap">Totale Fattura</th>     <th nowrap="nowrap">Da saldare</th>     <th nowrap="nowrap">Agente</th>    <th nowrap="nowrap">Modalita' pagamento</th>    <th nowrap="nowrap">Pagata il</th>    </tr>    <%	totale=0	da_saldare_tot=0	do until rs.EOF	%>      <tr>    <td nowrap="nowrap"><%=pre_fattura(rs("data"))&rs("nfat")%></td>    <td nowrap="nowrap"><%=formatDateTime(rs("data"), vbShortDate)%></td>    <td nowrap="nowrap"><%=rs("iduser")%></td>	<td nowrap="nowrap"><%=rs("azienda")%></td>	<td nowrap="nowrap"><%=rs("totale_fattura")%></td><%						da_saldare=rs("totale_fattura")-rs("sommadiimporto")			if isnull(da_saldare) then da_saldare=rs("totale_fattura")			da_saldare_tot=da_saldare_tot+da_saldare						%>	<td nowrap="nowrap"><%=da_saldare%></td>    <td nowrap="nowrap"><%=rs("nominativo")%></td>    <td nowrap="nowrap"><%=metodipagamento.descrizione(objPagingRS("pagamento"))%></td>    <td nowrap="nowrap">&nbsp;</td>    </tr>    <%	totale=totale+rs("totale_fattura")	rs.movenext	loop	rs.close	set rs=Nothing	call connclose()     %>          <tr>        <td><b>Totale fatture</b></td>        <td>&nbsp;</td>        <td>&nbsp;</td>        <td>&nbsp;</td>        <td><%=totale%></td>        <td>&nbsp;</td>        <td>&nbsp;</td>        <td>&nbsp;</td>        <td>&nbsp;</td>      </tr>           <tr>        <td><b>Totale da saldare</b></td>        <td>&nbsp;</td>        <td>&nbsp;</td>        <td>&nbsp;</td>                <td>&nbsp;</td>        <td><%=da_saldare_tot%></td>        <td>&nbsp;</td>        <td>&nbsp;</td>        <td>&nbsp;</td>      </tr></table><%	call CheckConnChiusa()	%>