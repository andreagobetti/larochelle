<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()mese=request.form("mese")if mese="" then	mese="14"	anno=year(date())else	anno=request.form("anno")end ifSet metodipagamento = New ClasseMetodipagamento 'Create an Instance of the Class%><!--#include virtual="/sub_head_adm.asp" --></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->         <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">scadenze riba clienti</a></div>                <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >               <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr >             <td colspan="4" style="border-bottom:1px solid;">Periodo              <select name="MESE" onChange="this.form.submit()">				<option value="14" <%if 14=cint(mese) then response.write " selected" %>>Tutte</option>				<option value="13" <%if 13=cint(mese) then response.write " selected" %>>Prossime</option>								<%				for n=1 to nome_mese(0)				response.write "<option value='"&n&"'"				if n=cint(mese) then response.write " selected"				response.write  ">" & nome_mese(n)&"</option>"				next				%>              </select>               Anno              <input name="anno" type="text" value="<%=anno%>" size="4">              <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;"> <%if mese>0 then%>              <a href="pag_adm_rep13_excel.asp?mese=<%=mese%>&amp;anno=<%=anno%>">Esporta excel</a>            <%end if%></td>          </tr></table></form>        <%if mese<>"0" then%>		<%sql="select fatture.*, scadenze.riba, scadenze.data as scadenze_data, scadenze.causale, scadenze.importo, ordini.Cognome, ordini.Nome, ordini.Azienda, scadenze.causale FROM (fatture INNER JOIN scadenze ON fatture.IDFat = scadenze.idfat) INNER JOIN ordini ON fatture.idord = ordini.idord  "if mese=13 then	sql=sql & "where scadenze.data>=date()  "elseif mese=14 then	sql=sql & "where  true "else	sql=sql & "where month(scadenze.data)="&mese &" and year(scadenze.data)="&anno &"  "end ifsql=sql&" and scadenze.riba=1 "sql=sql&" order by scadenze.data"call paginazione_start(sql,200,"access")%>        <table width="100%" border="1" cellpadding="2" cellspacing="0" class="tabella1">          <tr> 		<%if mese=13 then%>            <td colspan="8" class="ui-widget-header">Prossime scadenze: <%=objPagingRS.recordcount%> elementi</td>	<%elseif mese=14 then%>            <td colspan="8" class="ui-widget-header">Tutte le scadenze: <%=objPagingRS.recordcount%> elementi</td><%else %>            <td colspan="8" class="ui-widget-header">scadenze mese di <%=nome_mese(mese)%> <%=anno%>: <%=objPagingRS.recordcount%> elementi</td><%end if %>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>                        <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Scadenza</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Fatt.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">ID Cli.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Nominativo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Importo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Modalit&agrave; pagamento</td>          </tr>          <%totale=0solo_una_volta=trueDo While iRecordsShown < iPageSize And Not objPagingRS.EOFif objPagingRS("scadenze_data")<now() then	colore="bgcolor='#FFCCCC'" 'rosinoelse	colore=""end if%>		  <%if objPagingRS("scadenze_data")>now() and solo_una_volta then%>		  <tr bgcolor="#FFCCCC">            <td colspan="8" style="border-bottom:1px solid;"><b>Totale avere scaduto: <%=formatcurrency(totale,2)%></b></td>          </tr>	  <%	  solo_una_volta=false	  end if%><tr class="coprobox" <%=colore%>>            <td style="border-bottom:1px solid;"><input name="" type="checkbox" value=""></td>                         <td style="border-bottom:1px solid;" class="corpobox"><%=objPagingRS("scadenze_data")%></td>            <td style="border-bottom:1px solid;"><a href="pag_adm_fatture.asp?idfat=<%=objPagingRS("idfat")%>"><%=objPagingRS("NFAT")%></a></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=formatDateTime(objPagingRS("data"), vbShortDate)%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("iduser")%></td>            <td nowrap style="border-bottom:1px solid;"><%=objPagingRS("azienda")%></td>            <td align="right" class="corpobox" style="border-bottom:1px solid;"><%if objPagingRS("importo")<>"" then%><%= formatcurrency(objPagingRS("importo"), 2)%><%end if%></td>            <td style="border-bottom:1px solid;" class="corpobox"><%=metodipagamento.descrizione(objPagingRS("pagamento"))%></td>          </tr>          <% 			  if objPagingRS("importo")<>"" then totale=totale+cdbl(objPagingRS("importo"))		iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(8,true)	%>        </table><%end if%> <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%rsClose%>