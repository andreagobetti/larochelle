<!--#include virtual="/setup.asp" --><!--#include virtual="/multidict_cl.asp" --><!--#include virtual="/jsonObject.class.asp" --><%if session("idadmin") = "" then call login()oper=lcase(request("oper"))select case oper	case "new"		oper="new"	case "modifica tutti"		oper="edit"		idcategoria=request.form("idcategoria")	case "esporta excel"		oper="edit"		response.redirect "pag_adm_articoli_mepa_excel.asp?id="&request.form("idcategoria")	case else		oper="list"		idcategoria=request("mepa_categoria")end select%><!--#include virtual="/sub_head_adm.asp" --><style>	input  {    min-width: 60px;	}	</style></head><body> <div id="wrap"><div id="header"><%=titolo_top%><div id="barra_fissa">  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Articoli MEPA</a></div></div>        <font color="#FF0000"><b><%=error%></b></font>                <%if oper="list" then %>	 <form id="form1" name="form1" method="post" action="<%=questofile%>" style="margin-top:0px;" >  	     <table width="100%" id="elenco" border="0" cellpadding="2" cellspacing="0" class="tabella1">		<tr><td>	 	  <select name="mepa_categoria" id="mepa_categoria" class="select2 bigdrop" placeholder="Seleziona una categoria MEPA">		  <option></option>		<%		Set rsm=conn.execute("select mepa_categorie.*, count(prodotti_mepa_campi.idcategoria) as conteggio from mepa_categorie inner join prodotti_mepa_campi on mepa_categorie.id = prodotti_mepa_campi.idcategoria group by  prodotti_mepa_campi.idcategoria order by descrizione ;")				do while not rsm.eof			response.write "<option value=""" & rsm("id") &""""			if int(idset)=int(rsm("id")) then response.write " selected"			response.write ">" & rsm("descrizione")& " ("&rsm("conteggio")&")</option>"			rsm.movenext		loop		rsm.close		set rsm = Nothing		%>            </select>          </form><script type="text/javascript" src="Jquery/js/select2.js"></script> <script>$(function() {	$(".select2").select2();	$(".bigdrop .select2-results").css("max-height","600px");	$("#mepa_categoria").change(function() { 		 $("#form1").submit();	});});</script></td></tr></table><%if idcategoria<>"" then %>	     <table width="100%" id="elenco" border="0" cellpadding="2" cellspacing="0" class="tabella1">		<tr>			<td class="ui-widget-header ui-corner-top">				Articoli categoria <%=conn.execute("select mepa_categorie.descrizione from mepa_categorie where id="&idcategoria)(0)%> <span style="float: right;"><input type="submit" name="oper" value="Modifica tutti"><input type="submit" name="oper" value="Esporta Excel"><input type="hidden" name="idcategoria" value="<%=idcategoria%>"></span>			</td>		</tr>	    <tr bgcolor="#E5E5E5">		    <td>Descrizione		    </td>	    </tr>	    <%	    set rs=conn.execute ("select prodotti.* from prodotti inner join prodotti_mepa_campi on prodotti.idpro = prodotti_mepa_campi.idpro where idcategoria="&idcategoria&"  order by descrizione")	    do while not rs.eof 	    %>	    <tr>		    <td>			    <%=rs("codice")&" "&rs("articolo")%>		    </td>	    </tr>	    <%		    rs.MoveNext		loop		set rs = Nothing	    %>    </table>		<%end if %>	</form>	<%elseif oper="edit" then		set rs=conn.execute("select id, label, obbligatorio, formato, valori_default from mepa_campi where idcategoria="&idcategoria&" order by id")		arrRS=rs.getrows()		colonne=UBound(arrRS, 2)		Set mepa_campi = New MultiDimensionalDictionary 'Create an Instance of the Class		For i = 0 To colonne				mepa_campi.SetKey = arrRS(0, i) 'id				mepa_campi.SetField "label", arrRS(1, i)				mepa_campi.SetField "obbligatorio", arrRS(2, i)				mepa_campi.SetField "formato", lcase(left(arrRS(3, i),1))				mepa_campi.SetField "valori_default", arrRS(4, i)				mepa_campi.Update 'Bind the record and preapre for the next record									next									%>		<script type="text/javascript" src="Jquery/Js/autosize-input.min.js"></script> 	    <table width="100%" id="elenco" border="0" cellpadding="2" cellspacing="0" class="tabella1">		<tr ><td colspan="<%=colonne+1%>" class="ui-widget-header ui-corner-top">		Articoli categoria <%=conn.execute("select mepa_categorie.descrizione from mepa_categorie where id="&idcategoria)(0)%>		</td></tr>		<tr bgcolor="#E5E5E5">		<%			For Each Record in mepa_campi.Records				Response.Write("<td>" &  mepa_campi.Item(Record, "label") &  "</td>")			Next		%>		</tr>	    <%										set JSON = New JSONobject	    set rs=conn.execute ("select prodotti.*, prodotti_mepa_campi.mepa_campi, prodotti_mepa_campi.id from prodotti inner join prodotti_mepa_campi on prodotti.idpro = prodotti_mepa_campi.idpro where idcategoria="&idcategoria&"  order by descrizione")	    do while not rs.eof 			mepa_campi_JSON=rs("mepa_campi")						'response.write mepa_campi_JSON			if mepa_campi_JSON="" then 				mepa_campi_JSON="[]"			end if			JSON.Parse(mepa_campi_JSON)					    %>	    <tr>		    		    		<%			For Each Record in mepa_campi.Records				response.write "<td>"&"|"&rs("id")&"|"				valori_default=mepa_campi.Item(Record, "valori_default")				richiesto=mepa_campi.Item(Record, "obbligatorio")				if richiesto="S" then					richiesto="richiesto"				else					richiesto=""				end if				valore=JSON(""&Record)				if valori_default="" or isnull(valori_default) then %>												<input type="text" name="mepa_campo_<%=rs("idpro")%>_<%=record%>" class="<%=richiesto%>" id="r_<%=rs("idpro")%>_<%=record%>" value="<%=valore%>">						<script>autosizeInput(document.querySelector('#r_<%=rs("idpro")%>_<%=record%>'),{ minWidth: true });</script>				<%else						arr_option=split(valori_default,"||")												%>						<select name="mepa_campo_<%=record%>">							<% for n=0 to ubound(arr_option) %>							<option value="<%=arr_option(n)%>" <% if valore=arr_option(n) then response.write " selected" %>><%=arr_option(n)%></option>							<%next %>						</select>												<%				end if 			Next		%>		    					    		    	    </tr>	    <%		    rs.MoveNext		loop		set rs = Nothing	    %>    </table>		<%end if %>		       <!-- Div Content FINE--></div><div id="footer"></div><%  	call connclose()	%><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%	sub scanJSON(JSONstring)		dim txt			' instantiate the class		set JSON = New JSONobject		set JSONarr = JSON.Parse(JSONstring) 			dim i, item,items	' faster but less readable	for i = 0 to JSONarr.length - 1	    if isObject(JSONarr(i)) then	        set item = JSONarr(i)		        if typeName(item) = "JSONobject" then	            response.write "OBJ:"	            item.write()	            	            response. write item.value("Nome scheda tecnica")	            response. write item.value("Label (nome dell'attributo)")	            txt=JSON.serializeObject(item)		        'call scanJSON(txt)	        else		        'call scanJSON(item.Serialize())	            response.write item	        end if	    else	        item = JSONarr(i)	        response.write item	    end if		    response.write "<br>"	next			end sub			%>