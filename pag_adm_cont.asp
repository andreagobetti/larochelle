<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()'for each item in Request.Form'  Response.write item & ": " & Request.Form(item) & "<br>"'nextpuls_new="Nuovo contenuto"'------------------------------------if request("dove")<>"" then	if request("dove")="su" then		dove="-15"	else		dove="+15"	end if	sql="UPDATE News SET News.ordine = [ordine]"&dove&" WHERE (((News.IDnews)="&request("id")&"));"	conn.execute sql	Set rs = Server.CreateObject("ADODB.Recordset")	call riordina(request.querystring("tipo"))end ifsqlbase="select * from news "oper=request.form("oper")if request.form("elimina")<>"" then	sql="DELETE   FROM news WHERE idnews=" & request.form("id") 	conn.execute(sql)	sql=""	add2log "Eliminato contenuto idnews"&request.form("id")&" da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",3end ifselect case lcase(request("oper"))	case "annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case else		oper="view"		if request("modifica")<>"" then oper="edit"end selectif oper="add" or oper="update" then	'controlliend ifif oper="add" or oper="update" then	Set rs = Server.CreateObject("ADODB.Recordset")		if oper="add" then		rs.Open sqlbase, conn, 3, 3		rs.addnew		operazione="Aggiunto"	else		sql= sqlbase & " where idnews=" & request.form("id")		rs.Open sql, conn, 3, 3		operazione="Modificato"	end if	if trim(request.form("data"))<>"" then rs("data")=trim(request.form("data"))	rs("titolo")=firstup(trim(request.form("titolo")))	rs("testo")=trim(request.form("testo"))	if edit_lang_en then		rs("titolo_en")=firstup(trim(request.form("titolo_en")))		rs("testo_en")=trim(request.form("testo_en"))	end if	rs("tipo")=trim(request.form("tipo"))	rs("stato")=trim(request.form("stato"))	if request.form("accoda")<>"" then		rs("accoda")=cint(trim(request.form("accoda")))	else		rs("accoda")=null	end if	txt=trim(request.form("ordine2"))	if txt="" then txt=0	rs("ordine")=txt	rs.update	add2log operazione&" contenuto idnews"&rs("idnews")&" tipo"&rs("tipo")&" da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",3	rs.close	call riordina (trim(request.form("tipo")))	oper="view"	'response.redirect Request.ServerVariables("Script_Name")end ifsub riordina(tipo)	sql="select * from news where stato='0' and tipo='" & tipo&"' order by ordine;"	'response.write sql	rs.open sql, conn,3,3	'response.end	ordine=10	do while not rs.eof	rs("ordine")=ordine	rs.update	ordine=ordine+10	rs.movenext	loop	rs.closeend sub%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><SCRIPT language=JavaScript>function editor(from) {   popupWin = window.open('editor/editor.asp?from='+from,'editor','toolbar=no,width=700,height=525,location=no,directories=no,status=no,menubar=no,toolbar=no,resizable=yes,scrollbars=yes');  popupWin.focus();}</script><%if oper="new" or oper="edit" then%><!--#include virtual="/tinymce4_conf4.asp" --><%end if%></head><body><div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa"> <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Gestisci contenuti</a></div></div>        <!-- Box CORPO INIZIO-->		<form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;">        <%		if oper="view" thenordine=request.form("ordine")cercain=request("cercain")if trim(request.form("tipo"))<>"" then cercain=trim(request.form("tipo"))sql=""%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="5" align="right" style="border-bottom:1px solid;"><a href="<%=questofile%>?oper=new&tipo=<%=cercain%>"><strong>Nuovo                 contenuto</strong></a></td>            </tr>            <tr>               <td colspan="5"  style="border-bottom:1px solid;">Ordina per:                 <select name="ordine" style="FONT: 12px;" onChange="this.form.submit()">                  <option value="datad" <%if ordine="datad" then response.write "selected"%>>Data                   dec</option>                  <option value="ordine" <%if ordine="ordine" then response.write selected%>>Ordine</option>                  <option value="titolo" <%if ordine="titolo" then response.write selected%>>Titolo</option>                  <option value="tipo" <%if ordine="tipo" then response.write selected%>>Tipo                   pagina</option>                </select> <%'--------sezione cercaif cercain<>"" then	sql1=""	select case lcase(cercain)	case "n","a","p","t","b","d","s"		sql1=" tipo='"&cercain&"'"		ordine="ordine"		case "pag"		sql1=" tipo='p' or tipo='a'"	case "ha","hb","hd","hs"		sql1=" tipo='"&cercain&"'"		ordine="ordine"	end select	sql=sql & " where " & sql1end if'ordine di defaultif len(ordine)=0 then ordine="datad"if ordine="datad" then 	sql= sql & " order by data desc"elseif ordine="ordine" then 	sql= sql & " order by ordine"elseif ordine="titolo" then 	sql= sql & " order by titolo"elseif ordine="tipo" then 	sql= sql & " order by tipo"else	sql= sql & " order by " & ordine end if%>                Filtro                 <select name="cercain" style="FONT: 12px;" onChange="this.form.submit()">                  <option value="" <%if cercain="" then response.write "selected"%>>Tutti</option>                  <option value="n" <%if cercain="n" then response.write selected%>>News</option>                  <option value="ha" <%if cercain="ha" then response.write selected%>>Home page: Colonna         centrale alto</option>        <option value="hb" <%if cercain="hb" then response.write selected%>>Home page: Colonna         centrale basso</option>        <option value="hd" <%if cercain="hd" then response.write selected%>>Home page: Colonna         destra</option>        <option value="hs" <%if cercain="hs" then response.write selected%>>Home page: Colonna         sinistra</option>                  <option value="p" <%if cercain="p" then response.write selected%>>Pagina                   portale</option>                  <option value="a" <%if cercain="a" then response.write selected%>>Pagina                   anonima</option>                </select> </td>            </tr>            <tr bgcolor="#E5E5E5">               <%if oper="view" then%>              <td align="center"  style="border-bottom:1px solid;">&nbsp;Edit&nbsp;</td>              <%end if%>              <td align="center"  style="border-bottom:1px solid;">&nbsp;Data&nbsp;</td>              <td align="center"  style="border-bottom:1px solid;">&nbsp;Titolo&nbsp;</td>              <td align="center"  style="border-bottom:1px solid;"> Tipo</td>              <td align="center"  style="border-bottom:1px solid;">Ordine</td>            </tr>            <%	sql= sqlbase & sql	'response.write sql	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="modifica" value="<%=rs("idnews")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=formatdatetime(rs("data"),2)%></td>              <td style="border-bottom:1px solid;"><a href="single-page.asp?id=<%=rs("idnews")%>&chk=<%=chkDataUser(rs("data"))%>" target="_blank"><%=rs("idnews")%>-<%=rs("titolo")%></a></td>              <td align="center" style="border-bottom:1px solid;"><%=rs("tipo")%></td>              <td align="center" valign="middle" style="border-bottom:1px solid;"><a href="<%=questofile%>?dove=giu&id=<%=rs("idnews")%>&tipo=<%=rs("tipo")%>" title=" Sposta giu' "><img src="images/fr_giu.gif" width="7" height="4" border="0"></a><%=rs("ordine")%><a href="<%=questofile%>?dove=su&id=<%=rs("idnews")%>&tipo=<%=rs("tipo")%>" title=" Sposta su "><img src="images/fr_su.gif" width="7" height="4" border="0"></a></td>            </tr>            <%	rs.movenext	loop	%>          </table>          <%else	idnews=request("modifica")	if request.form("id")<>"" then idnews=request.form("id")		'response.write "OPER:" & oper		sql=sqlbase & " where idnews =" & idnews%>                  <input type="hidden" name="id" value="<%=idnews%>">          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header"><%					if oper<>"new" then					set rs=conn.execute(sql)			response.write "Modifica contenuto"					else			Response.write "Inserimento nuovo contenuto"		end if		  %>                <input type="hidden" name="cercain" value="<%=request("cercain")%>"></td>            </tr>            <tr>               <td align="right" valign="top">Data</td>              <td> <%if error<>"" then			  		testo=request.form("data")				elseif oper="edit" then					testo=rs("data")			  	elseif oper="new" then			  		testo=""				end if%> <input type="text" name="data" value="<%=testo%>" size="40">              </td>            </tr>            <tr>               <td align="right" valign="top">Titolo</td>              <td> <%if error<>"" then			  		testo=request.form("titolo")				elseif oper="edit" then					testo=rs("titolo")			  	elseif oper="new" then			  		testo=""				end if%> <input type="text" name="titolo" value="<%=fixquotes(testo)%>" size="40">              </td>            </tr>                        <tr>               <td align="left" valign="top"><div  align="right">Testo</div></td>              <td>                  <%if error<>"" then			  		testo=request.form("testo")				elseif oper="edit" then					testo=rs("testo")			  	elseif oper="new" then			  		testo=""				end if%> <textarea name="testo" class="mceEditor" cols="40" rows="20" style="width:100%"><%=Testo%></textarea>               </td>            </tr>			<%if edit_lang_en then%>			<tr>               <td align="right" valign="top">Titolo <img src="images/en.png"/></td>              <td> <%if error<>"" then			  		testo=request.form("titolo_en")				elseif oper="edit" then					testo=rs("titolo_en")			  	elseif oper="new" then			  		testo=""				end if%> <input type="text" name="titolo_en" value="<%=fixquotes(testo)%>" size="40">              </td>            </tr>			            <tr>               <td align="left" valign="top"><div  align="right">Testo <img src="images/en.png"/></div></td>              <td>                  <%if error<>"" then			  		testo=request.form("testo_en")				elseif oper="edit" then					testo=rs("testo_en")			  	elseif oper="new" then			  		testo=""				end if%> <textarea name="testo_en" class="mceEditor" cols="40" rows="20" style="width:100%"><%=Testo%></textarea>               </td>            </tr>			<%end if%>            <tr>               <td align="right" valign="top">Tipo</td>              <td> <%if error<>"" then			  		testo=request.form("tipo")				elseif oper="edit" then					testo=lcase(rs("tipo"))			  	elseif oper="new" then			  		testo=request.querystring("tipo")				end if%> <select name="tipo">                  <option value="n" <%if testo="n" then response.write " selected"%>>News</option>                  <option value="ha" <%if testo="ha" then response.write " selected"%>>HomePage: Colonna                   centrale alto</option>                  <option value="hb" <%if testo="hb" then response.write " selected"%>>HomePage: Colonna                   centrale basso</option>                  <option value="hd" <%if testo="hd" then response.write " selected"%>>HomePage: Colonna                   destra</option>                  <option value="hs" <%if testo="hs" then response.write " selected"%>>HomePage: Colonna                   sinistra</option>                  <option value="p" <%if testo="p" then response.write " selected"%>>Pagina                   portale</option>                  <option value="a" <%if testo="a" then response.write " selected"%>>Pagina                   anonima</option>                  <option value="ln" <%if testo="ln" then response.write " selected"%>>Latest news </option>                  <option value="index-top" <%if testo="index-top" then response.write " selected"%>>Index - top </option>                </select>              </td>            </tr>            <tr>               <td align="right" valign="top">Ordine:</td>              <td> <%if error<>"" then			  		testo=request.form("ordine")				elseif oper="edit" then					testo=rs("ordine")			  	elseif oper="new" then			  		testo=""				end if%> <input type="text" name="ordine2" value="<%=testo%>" size="4">               </td>            </tr>            <tr>              <td align="right" valign="top"> Contenuto da accodare</td>              <td><%if error<>"" then			  		val=request.form("accoda")				elseif oper="edit" then					val=rs("accoda")			  	elseif oper="new" then			  		val=0				end if%>                  <select name="accoda" >              <option value="">Nessuno</option><%Set rsm=conn.execute("select * from news where tipo='p'  order by titolo  ")do while not rsm.eofresponse.write "<option value=""" & rsm("idnews") &""""if int(val)=int(rsm("idnews")) then response.write " selected"response.write ">"&rsm("idnews")&"-" & rsm("titolo")&"</option>"rsm.movenextlooprsm.close%></select></td>            </tr>            <tr>               <td align="right" valign="top">Visibile</td>              <td>			   <%if error<>"" then			  		testo=request.form("stato")				elseif oper="edit" then					testo=rs("stato")			  	elseif oper="new" then			  		testo=0				end if%>  <select name="stato">                  <option value="0" <%if stato=0 then response.write " selected"%>>Si</option>                  <option value="1" <%if stato=1 then response.write " selected"%>>No</option>                </select> </td>            </tr>          </table>        <%if oper="view" then	txt=puls_newelseif oper="new" or error<>"" then	txt="Aggiungi"elseif oper="edit" then	txt="Modifica"end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Annulla">    <%end if%>    <%if oper="edit" and num=0 and error="" then%>    <input type="submit" name="elimina" value="Elimina">    <%end ifend if%>        </form>         <!-- Box CORPO FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%rsClose%>