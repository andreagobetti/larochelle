<%function invia_mail_registrazione(id,nuovo)	dim rs'on error resume next	set fs=Server.CreateObject("Scripting.FileSystemObject")	filename=Server.MapPath("/email/login_inline.html")	if fs.FileExists(filename) then			set t=fs.OpenTextFile(filename,1,false)		html=t.ReadAll		t.close	else		call add2log( "Il file non esiste:"&filename,3)	end if			dim txt_error	txt_error=""		sql="select utenti.* FROM utenti where iduser=" & id	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 1, 3	idintestazione=rs("idintestazione")	passwordInChiaro=gen_passw()	'if id>1 then			'Genera password con numero casuale		set utente= (new Classeutente)(array("new_password",id,passwordInChiaro))	'end if	set rs_i= conn.execute("select * from utenti_intestazioni where id="&idintestazione)	if nuovo then		oggetto="Registrazione su " & nomesito	else		oggetto="Invio dati di accesso per " & nomesito	end if		'Modifico il testo	html=replace(html,"[title]",oggetto)	link="http://" & lcase(nomesito) & "/images/logo_email.png"	'70px x 70 px	html=replace(html,"[logo]",link)		if rs("secondario")=1 then		nome=rs("nome")	else		nome=rs_i("nome")	end if	if isnull(nome) then nome="Utente"	html=replace(html,"[nomesito]",nomesito)	html=Replace(html,"[nome]",nome)	html=replace(html,"[user]",rs("email"))	html=replace(html,"[password]",passwordInChiaro)		link="http://" & lcase(nomesito) & "/login.asp?email_login=" & rs("email") & "&pass=" & passwordInChiaro	html=replace(html,"[link]",link)	set rs_dati_vari=conn.execute ("select dati_vari.* from dati_vari where chiave='mail_fondo'")	if rs_dati_vari.eof then		dati_footer=""		'response.write ubound(dati_vari)			else		dati_footer=rs_dati_vari("valore")	end if	html=replace(html,"[dati_footer]",dati_footer)			'Response.Write(html)						Const cdoSendUsingMethod        = "http://schemas.microsoft.com/cdo/configuration/sendusing"	Const cdoSendUsingPort          = 2	Const cdoSMTPServer             = "http://schemas.microsoft.com/cdo/configuration/smtpserver"	Const cdoSMTPServerPort         = "http://schemas.microsoft.com/cdo/configuration/smtpserverport"	Const cdoSMTPConnectionTimeout  = "http://schemas.microsoft.com/cdo/configuration/smtpconnectiontimeout"	Const cdoSMTPAuthenticate       = "http://schemas.microsoft.com/cdo/configuration/smtpauthenticate"	Const cdoBasic                  = 1	Const cdoSendUserName           = "http://schemas.microsoft.com/cdo/configuration/sendusername"	Const cdoSendPassword           = "http://schemas.microsoft.com/cdo/configuration/sendpassword"	Dim objConfig	Dim objMessage	Dim Campi	Set objConfig = Server.CreateObject("CDO.Configuration")	Set Campi = objConfig.Fields	With Campi	.Item(cdoSendUsingMethod)       = cdoSendUsingPort	.Item(cdoSMTPServer)            = SMTPServer	.Item(cdoSMTPServerPort)        = 25	.Item(cdoSMTPConnectionTimeout) = 30	.Update	End With	Set objMessage = Server.CreateObject("CDO.Message")	Set objMessage.Configuration = objConfig	objMessage.Bodypart.Charset = "UTF-8"		'EMAIL AL VISITATORE	'sql="select * from news where stato='0' and tipo='E0' order by ordine;"	'set rsb=conn.execute(sql)	'if not rsb.eof then	'	HTML = HTML &rsb("testo")	'else	'	add2log "Manca testo per email di registrazione (0)",2	'end if	'rsb.close	'set rsb= nothing	email_utente=rs("email")	objMessage.To =  email_utente	objMessage.From = nomesito  & "<" & Application("email_sito") & ">"	objMessage.ReplyTo = Application("email_sito")	objMessage.Subject = oggetto	objMessage.HtmlBody = html	on error resume next	if instr(Request.ServerVariables("SERVER_NAME"),"aandrea.spotorno")=0 then		objMessage.Send	else		call add2log("Inviao email a:"&email_utente&"<br><div>"&html&"</div>",0)					end if	If err.number <> 0 Then		add2log "Errore invio email di registrazione a [utente="&rs("iduser")&"]"&get_denominazione(id)&"[/utente]"&" Email:"&rs("email"),3		txt_error=" (invio email di regitrazione fallito)"		invia_mail_registrazione=false			else		add2log "Inviata email di registrazione a [utente="&rs("iduser")&"]"&get_denominazione(id)&"[/utente]"&vbcrlf&"Email:"&rs("email"),2		rs("password_inviata")=now()		rs.update		invia_mail_registrazione=true			End If	Set objMessage = Nothing			noti_email_registr=conn.execute("select noti_email_registr from impostazioni")(0)	if id=1 then		noti_email_registr="andicot@gmail.com"	end if	if noti_email_registr<>"" then			'EMAIL AL GESTORE		set fs=Server.CreateObject("Scripting.FileSystemObject")		filename=Server.MapPath("/email/loginadmin_inline.html")		if fs.FileExists(filename) then			set t=fs.OpenTextFile(filename,1,false)			html=t.ReadAll			t.close		else			response.write "Il file non esiste:"&filename		end if		if nuovo then			titolo="Si &egrave; registrato il nuovo utente "&Server.HTMLEncode(denominazione(rs_i("nome"),rs_i("cognome"),rs_i("azienda")))		else			titolo="Inviati dati di accesso a "&Server.HTMLEncode(denominazione(rs_i("nome"),rs_i("cognome"),rs_i("azienda")))					end if				'Modifico il testo		html=replace(html,"[titolo]",oggetto)		link="http://" & lcase(nomesito) & "/images/logo_email.png"			html=replace(html,"[logo]",link)						html=replace(html,"[nomesito]",nomesito)		html=Replace(html,"[nominativo]",rs_i("nome")&" "&rs_i("cognome"))		html=replace(html,"[azienda]",rs_i("azienda"))		html=replace(html,"[email]",rs("email"))		html=replace(html,"[telefono]",rs("telefono"))				link="http://" & lcase(nomesito) & "/pag_adm_user.asp?iduser=" & id		html=replace(html,"[link]",link)		html=replace(html,"[dati_footer]",dati_footer)							Set objMessage = Server.CreateObject("CDO.Message")		Set objMessage.Configuration = objConfig		objMessage.Bodypart.Charset = "UTF-8"		objMessage.From = nomesito  & "<" & Application("email_sito") & ">"				objMessage.to = noti_email_registr		objMessage.Subject = oggetto&txt_error		objMessage.HtmlBody = HTML		if instr(Request.ServerVariables("SERVER_NAME"),"andrea.spotorno")=0 then			objMessage.Send		end if		Set objMessage = Nothing		'add2log "Inviata email di registrazione a [utente="&rs("iduser")&"]"&nominativo(rs("nome"),rs("cognome"),rs("azienda"))&"[/utente]"&vbcrlf&"Email:"&rs("email"),2	end if	rs.close	Set rs = Nothing	Set rs_i = Nothing	end function%>