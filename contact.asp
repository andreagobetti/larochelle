<!--#include virtual="/setup.asp" --><%if request("send-contact")<>"" then	txt_errore=""	'Controllo validazione form eseguita	if request.form("form_valido")="xx" then		txt_errore="Registrazione non valida"		add2log "Bloccato modulo contatti per validazione form bypassata"&vbcrlf&queryeform()&"<br>IP:"&Request.ServerVariables("REMOTE_ADDR"),3	end if		'Controllo email valida	if txt_errore="" then		email=lcase(trim(request.form("contactemail")))		if not validemail(email) then			txt_errore="L'indirizzo email non &egrave; valido"		end if	end if	if txt_errore="" then				if request.form("contactname")="" then			txt_errore="Nome non specificato"		end if	end if	if txt_errore="" then		if request.form("contactsubject")="" then			txt_errore="Oggetto non specificato"		end if	end if	if txt_errore="" then		if request.form("contactmessage")="" then			txt_errore="Messaggio non specificato"		end if	end if	if txt_errore="" then		messaggio_inviato=true	end if		end if		set rs_dati_vari=conn.execute ("select dati_vari.* from dati_vari where chiave='pagina-contacts'")		if rs_dati_vari.eof then			dati_vari=split("||||||||||","||")			'response.write ubound(dati_vari)				else			dati_vari=split(rs_dati_vari("valore"),"||")		end if		set rs_dati_vari = nothingmeta_title="contus"%><!--#include virtual="/config/header_inc.asp" --> <!-- Google map javascript api v3 -->        <script src="//maps.googleapis.com/maps/api/js?key=<%=dati_vari(0)%>&amp;sensor=false"></script>        <section id="content">        	<div id="breadcrumb-container">        		<div class="container">					<ul class="breadcrumb">						<li><a href="/">Home</a></li>						<li class="active"><%=traduci("contus")%></li>					</ul>        		</div>        	</div>        	<div class="container">        		<div class="row">        			<div class="col-md-12">						<header class="content-title">							<h1 class="title"><%=traduci("contus")%> <%if session("idadmin")<>"" then%><a href="pag_adm_setup.asp?cosa=contact" title="Modifica elemento" class=""><i class="fa fa-pencil edit-items"></i></a><%end if%></h1>							<p class="title-desc"><%=traduci("contustxt")%></p>						</header>        				<div class="xs-margin"></div><!-- space -->        					<div class="col-md-12">								<div id="map">									<!-- Google - Map - Api -->									</div><!-- End #map -->        					</div><!-- End .col-md-12 -->        					<div class="col-md-8 col-sm-8 col-xs-12">        						<h2 class="sub-title"><%=traduci("leacom")%></h2>        						<div class="row">								<%if txt_errore<>"" then%>									<div class="alert alert-danger">	                                    <strong>Errore!</strong>&nbsp; <%=txt_errore%>	                                </div>								<%end if%>	        						<%if messaggio_inviato=false then%>									<form name="contact-form" id="contact-form" method="post" action="<%=questofile%>">          								<div class="col-md-6 col-sm-12 col-xs-12">											<div class="input-group">												<span class="input-group-addon"><span class="input-icon input-icon-user"></span><span class="input-text"><%=traduci("nome")%>&#42;</span></span>												<input type="text" name="contactname" id="contactname" required class="form-control input-lg" placeholder="<%=traduci("nomepl")%>">											</div><!-- End .input-group -->        									<div class="input-group">												<span class="input-group-addon"><span class="input-icon input-icon-email"></span><span class="input-text">Email&#42;</span></span>												<input type="email" name="contactemail" id="contactemail" required class="form-control input-lg" placeholder="<%=traduci("emailpl")%>">											</div><!-- End .input-group -->        									<div class="input-group">												<span class="input-group-addon"><span class="input-icon input-icon-subject"></span><span class="input-text"><%=traduci("subject")%>&#42;</span></span>												<input type="text" name="contactsubject" id="contactsubject" required class="form-control input-lg" placeholder="<%=traduci("subjectpl")%>">											</div><!-- End .input-group -->        									<p class="item-desc"><%=traduci("txt10")%></p>        								</div><!-- End .col-md-6 -->        								        								<div class="col-md-6 col-sm-12 col-xs-12">											<div class="input-group textarea-container">												<span class="input-group-addon"><span class="input-icon input-icon-message"></span><span class="input-text"><%=traduci("mess")%>&#42;</span></span>												<textarea name="contactmessage" id="contactmessage" class="form-control" cols="30" rows="6" placeholder="<%=traduci("messpl")%>"></textarea>											</div><!-- End .input-group -->        								<input type="submit" value="<%=traduci("sub")%>" class="btn btn-custom-2 md-margin" name="send-contact">        								</div><!-- End .col-md-6 -->										<input type="hidden" id="form_valido" name="form_valido" value="xx">         							</form>        							<%else %>									<div class="alert alert-success">	                                    <strong>Messaggio inviato!</strong>&nbsp; Il tuo messaggio &egrave; stato inviato	                                </div>        							<%end if%>        						</div><!-- End .row -->        						        					</div><!-- End .col-md-8 -->        					        					<div class="col-md-4 col-sm-4 col-xs-12">        						<h2 class="sub-title"><%=traduci("contdet")%></h2>        						<ul class="contact-details-list">        							<%if dati_vari(2)<>"" then%>        							<li>										<span class="contact-icon contact-icon-phone"></span>										<ul>											<li><%=dati_vari(2)%></li>										</ul>        							</li>        							<%End If%>        							<%if dati_vari(3)<>"" then%>        							<li>										<span class="contact-icon contact-icon-mobile"></span>										<ul>											<li><%=dati_vari(3)%></li>										</ul>        							</li>        							<%End If%>        							<%if dati_vari(4)<>"" then%>        							<li>										<span class="contact-icon contact-icon-email"></span>										<ul>											<li><a href="mailto:<%=dati_vari(4)%>"><%=dati_vari(4)%></a></li>										</ul>        							</li>        							<%end if%>        							<%if dati_vari(5)<>"" then%>        							<li>										<span class="contact-icon contact-icon-skype"></span>										<ul>											<li><%=dati_vari(5)%></li>										</ul>        							</li>        							<%end if%>        						</ul>        					</div><!-- End .col-md-4 -->        				</div><!-- End .row -->        				        			</div><!-- End .col-md-12 -->        		</div><!-- End .row -->			</div><!-- End .container -->                </section><!-- End #content -->	<!--#include virtual="/footer_inc.asp" -->           <!-- END -->	<!--#include virtual="/script_inc.asp" -->	<script src="js/Jqueryvalidate/jquery.validate.min.js"></script>	<script src="js/Jqueryvalidate/localization/messages_it.min.js"></script>	<script>	$(document).ready(function() {	$("#contact-form").validate({		rules: {			contactname: {required:true,minlength:3},			contactsubject: {required: true,minlength: 3},			contactemail:{required:true,email:true},			contactmessage:{required:true}		},		errorElement: "span",	    errorClass: "help-block",	    highlight: function (element, errorClass, validClass) {	        $(element).closest('.input-group').addClass('has-error');	    },	    unhighlight: function (element, errorClass, validClass) {	        $(element).closest('.input-group').removeClass('has-error');	    },	    errorPlacement: function (error, element) {	        if (element.parent('.input-group').length || element.prop('type') === 'checkbox' || element.prop('type') === 'radio') {	            error.insertAfter(element.parent());	        } else {	            error.insertAfter(element);	        }	    },		submitHandler: function(form){            $('#form_valido').val('si');			form.submit();		}	});		        /* change your with your coordinates */        var myLatLng = new google.maps.LatLng(<%=dati_vari(1)%>), // Your coordinates            mappy = {                center: myLatLng,                zoom: 15,                scrollwheel: false,                mapTypeId: google.maps.MapTypeId.ROADMAP,                styles: [{                    "elementType": "geometry",                    "stylers": [{                        "hue": "#000"                    }, {                        "weight": 1                    }, {                        "saturation": -200                    }, {                        "gamma": 0.70                    }, {                        "visibility": "on"                    }]                }]            };        var map = new google.maps.Map(document.getElementById("map"), mappy),        	newpin = 'images/pin.png';        new google.maps.Marker({            position: myLatLng,            map: map,            icon: newpin,            animation: google.maps.Animation.DROP,            title: '<%=nome_sito%>' // Title for marker        });    if (document.getElementById("map")) {        google.maps.event.addDomListener(window, 'load', initialize);    }	var initialize;		});	</script>    </body></html>