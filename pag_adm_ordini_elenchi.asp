le_ddt="RESO"		case 6		causale_ddt="RESO NON CONFORME"		case 7		causale_ddt="RESO DA C/LAVORO"		case 8		causale_ddt="RESO DA C/VISIONE"		case 9		causale_ddt="RESO DA RIPARARE"		case 10		causale_ddt="RESO DA SOSTITUIRE"		case 11		causale_ddt="RESO RIPARATO"		case 12		causale_ddt="RESO RIPARATO IN GARANZIA"		case 13		causale_ddt="SOSTITUZIONE"		case 14		causale_ddt="OMAGGIO"		case 15		causale_ddt="TRASFERIMENTO FIERA"		case 16		causale_ddt="PRESTITO D'USO"		case 17		causale_ddt="COMODATO GRATUITO"		end select	end ifend functionclass cl_Causale_Ddt	'Proprietà	'Public n_Elementi	dim lista,dic_verde,dic_genera_fattura	'Costruttore	Private Sub Class_Initialize()		set lista = Server.CreateObject("System.Collections.Sortedlist")		set dic_verde = Server.CreateObject("Scripting.Dictionary")		set dic_genera_fattura = Server.CreateObject("Scripting.Dictionary")			lista.add "VENDITA",1			dic_verde.add 1,false			dic_genera_fattura.add 1,true			lista.add "CONTO VENDITA",2			dic_verde.add 2,false			dic_genera_fattura.add			 2,true			lista.add "CONTO LAVORAZIONE",3			dic_verde.add 3,true			dic_genera_fattura.add			 3,false			lista.add "CONTO VISIONE",4			dic_verde.add 4,false			dic_genera_fattura.add			 4,true			lista.add "RESO",5			dic_verde.add 5,true			dic_genera_fattura.add			 5,false			lista.add "RESO NON CONFORME",6			dic_verde.add 6,true			dic_genera_fattura.add			 6,false			lista.add "RESO DA C/LAVORO",7			dic_verde.add 7,false			dic_genera_fattura.add			 7,true			lista.add "RESO DA C/VISIONE",8			dic_verde.add 8,true			dic_genera_fattura.add			 8,false			lista.add "RESO DA RIPARARE/SOSTITUIRE",10			dic_verde.add 10,true			dic_genera_fattura.add			 10,false			lista.add "RESO RIPARATO",11			dic_verde.add 11,false			dic_genera_fattura.add			 11,true			lista.add "RESO RIPARATO IN GARANZIA",12			dic_verde.add 12,true			dic_genera_fattura.add			 12,false			lista.add "SOSTITUZIONE",13			dic_verde.add 13,true			dic_genera_fattura.add			 13,false			lista.add "OMAGGIO",14			dic_verde.add 14,true			dic_genera_fattura.add			 14,false			lista.add "TRASFERIMENTO FIERA",15			dic_verde.add 15,true			dic_genera_fattura.add			 15,false			lista.add "PRESTITO D'USO",16			dic_verde.add 16,true			dic_genera_fattura.add			 16,false			lista.add "COMODATO GRATUITO",17			dic_verde.add 17,true			dic_genera_fattura.add			 17,false			lista.add "CAMPIONATURA",18			dic_verde.add 18,true			dic_genera_fattura.add 18,false	end sub	'Distruttore	Private Sub Class_Terminate()		set lista=nothing		set dic_verde = Nothing		set dic_genera_fattura = Nothing	End Sub	Public function elemento(key)		if isnull(key) then			elemento="errore"		else			elemento=lista.getKey(lista.indexofvalue(cint(key)))		end if		'elemento=lista.item(key)	end function	Public function verde(key)		if isnull(key) then			verde="errore"		else			verde = dic_verde.item(cint(key))		end if		'elemento=lista.item(key)	end function	Public function abilita_crea_fattura(key)		if isnull(key) then			abilita_crea_fattura="errore"		else			abilita_crea_fattura = dic_genera_fattura.item(cint(key))		end if		'elemento=lista.item(key)	end function	public Property Get n_Elementi ()	   n_Elementi=lista.count	End Property	public Property Get stampa_option (selezionato)		if selezionato="" then selezionato=1		for i = 0 to lista.count - 1			value=lista.getByIndex(i)			response.write "<option value="""&value&""" data-fattura='"& abilita_crea_fattura(value)&"' "			if value=selezionato then response.write " selected"			response.write ">"&lista.getKey(i) &  genera_fattura(abilita_crea_fattura(value))&"</option>"		next	End Property	private function genera_fattura(true_false)		if true_false then			genera_fattura="&nbsp; (F)"		else			genera_fattura=""		end if	end functionend classfunction porto_ddt(stato)	if not isnumeric(stato) then		porto_ddt=stato	else		select case stato		case 0,-1		porto_ddt=3		case 1		porto_ddt="PORTO FRANCO"		case 2		porto_ddt="PORTO ASSEGNATO"		case 3		porto_ddt="PORTO FRANCO CON ADD. IN FATTURA"		end select	end ifend functionfunction imballo_ddt(stato)	if not isnumeric(stato) then		imballo_ddt=stato	else		select case stato		case 0		imballo_ddt=7		case 1		imballo_ddt="CARTONE"		case 2		imballo_ddt="SCATOLA"		case 3		imballo_ddt="BUSTA"		case 4		imballo_ddt="BORSA"		case 5		imballo_ddt="A VISTA "		case 6		imballo_ddt="BANCALE"		case 7		imballo_ddt="CASSA DI LEGNO"		end select	end ifend functionfunction incaricato_ddt(stato)	if not isnumeric(stato) then		incaricato_ddt=stato	else		select case stato		case 0		incaricato_ddt=3		case 1		incaricato_ddt="DESTINATARIO"		case 2		incaricato_ddt="MITTENTE"		case 3		incaricato_ddt="VETTORE"		end select	end ifend functionfunction metodo_pagamento(stato,parametro)	'stato=-1 elenco select per admin	'stato=-2 elenco radio per checkout	dim rs	dim txt	if stato=-1 then		txt=""		'txt="<!-- parametro: "&parametro&"-->"		if not isnull(parametro) and parametro<>"" then			parametro=cint(parametro)		else			parametro=0		end if		set rs=conn.execute("select metodi_pagamento.id, metodi_pagamento.descrizione from metodi_pagamento order by descrizione")		do while not rs.eof			txt=txt&"<option value='"&rs("id")&"'"			if cint(rs("id"))=parametro then				txt=txt& " selected style='color:red;'"			end if			txt=txt& ">" & rs("descrizione")&"</option>"			rs.MoveNext		loop        'txt=txt&"</select>"		metodo_pagamento=txt	elseif stato=-2 then		txt=""		if parametro<>"" then			if parametro<>0 then				set rs=conn.execute ("select descrizione from metodi_pagamento where id="&parametro)				if not rs.eof then					txt="<div class=""radio"">"&vbcrlf&"<label>"&vbcrlf&"<input type=""radio"" name=""tipopagamento"" id=""pagamento_"&parametro&""" value="""&parametro&""" class=""tipopagamento radio_change"" checked = ""checked"" >"					txt=txt&rs("descrizione")&"</label></div>"				else					call add2log("Metodo di pagamento non trovato:"&parametro,3)				end if			end if		end if		set rs=conn.execute("select id, descrizione,descrizione_checkout, maggiorazione_gestione from metodi_pagamento where in_checkout=1 order by descrizione")		do while not rs.eof			txt=txt&"<div class=""radio"">"&vbcrlf&"<label>"&"<input type=""radio"" name=""tipopagamento"" id=""pagamento_"&rs("id")&""" value="""&rs("id")&""" class=""tipopagamento radio_change"">"&rs("descrizione")&"</label>"			maggiorazione_gestione=cdbl(rs("maggiorazione_gestione"))			if maggiorazione_gestione>0 then				importo_maggiorazione_gestione=subtot_carrello*maggiorazione_gestione/100				txt=txt&"<span class=""pull-right"">"&simbolo_valuta&formatnumber(importo_maggiorazione_gestione,2)&"</span>"			end if			if rs("descrizione_checkout")<>"" then				txt=txt&"<p >"&rs("descrizione_checkout")&"</p>"			end if			txt=txt&"</div>"			rs.MoveNext		loop		metodo_pagamento=txt	else		dim arr(4)		'0 testo		'1 scadenza		'2 ripetizioni		'3 inizio		'4 riba		select case stato		case -1		arr(0)=26		case else			if stato<>"" and stato<>"0" then				set rs=conn.execute("select * from metodi_pagamento where id="&stato)				if not rs.eof then					metodo_pagamento=rs(parametro)				else					call add2log("Non trovato metodo pagamento:"&stato,0)					if parametro="descrizione" then						metodo_pagamento="Non specificato"					else						metodo_pagamento=0					end if				end if			else				if parametro="descrizione" then					metodo_pagamento="Non specificato"				else					metodo_pagamento=0				end if			end if		end select	end ifend functionFunction FineMese(Data, mesi)	if mesi=0 then		FineMese=Data	else		FineMese = DateSerial(Year(Data),Month(Data)+mesi,1)		FineMese = FineMese - 1	end ifEnd Functionfunction causale_pagamento(stato)	if not isnumeric(stato) then		causale_pagamento=stato	else		select case stato		case -1		causale_pagamento=3		case 0		causale_pagamento="SCADENZA DI PAGAMENTO"		case 1		causale_pagamento="ACCONTO"		case 2		causale_pagamento="SALDO"		case 3		causale_pagamento="ALTRO"		end select	end ifend functionfunction trattamento_iva(stato)	if not isnumeric(stato) then		trattamento_iva=""	else		select case stato		case -1		trattamento_iva=12		case 0		trattamento_iva="Normale"		case 1		trattamento_iva="non imponibile art. 71"&vbcrlf&"dpr 633/1971"		case 2		trattamento_iva="Iva ad esigibilità differita ex art. 7, D.L. 185/2008"		case 3		trattamento_iva="Art.8 c D.P.R. 633/72"		case 4		trattamento_iva="non imponibile ex art. 41"&vbcrlf&"della legge 427/93"		case 5		trattamento_iva="fuori campo iva ex art. 7-ter del DPR 633/1972"		case 6		trattamento_iva="non imponibile ex art. 8"&vbcrlf&"del DPR 633/1972"		case 7		trattamento_iva="esente iva art 26"&vbcrlf&"del DPR 633/1972"		case 8		trattamento_iva="fuori campo iva ex art. 15/633"		case 9		trattamento_iva="Art. 2 del DPR 633,  26/10/72"		case 10		trattamento_iva="Iva a Vs. carico ex art. 17-ter,DPR 633/1972"		case 11		trattamento_iva="7-ter, comma 1, lett.a. del D.P.R. 633/1972"        case 12        trattamento_iva="esente iva art. 124 DL 34/2020"		case else		trattamento_iva=""		end select	end ifend functionfunction esenzione_iva(trattamento_iva)	if instr("-1-3-4-5-6-7-8-9-10-11-","-"&trattamento_iva&"-")>0 then		esenzione_iva=true	else		esenzione_iva=false	end ifend functionfunction pagamento_ordine(stato)	if not isnumeric(stato) then		pagamento_ordine=stato	else		select case stato		case 0		pagamento_ordine=4		case 1		pagamento_ordine="Contrassegno"		case 2		pagamento_ordine="Postepay a conf. ordine"		case 3		pagamento_ordine="Paypal a conf. ordine"		case 4		pagamento_ordine="Bonifico bancario a conf. ordine"		case 4		pagamento_ordine=""		case 5		pagamento_ordine=""		case 6		pagamento_ordine=""		case 7		pagamento_ordine=""		end select	end ifend functionfunction tipo_trasporto(stato)	if not isnumeric(stato) then		tipo_trasporto=stato	else		select case stato		case -1		tipo_trasporto=4		case 1		tipo_trasporto="Corriere"		case 2		tipo_trasporto="Altro: specificato nelle note"		case 3		tipo_trasporto="Ritiro presso la nostra sede"		case 4		tipo_trasporto="Corriere proprio (specificare nelle note)"		case 0		tipo_trasporto="Non specificato"		end select	end ifend functionfunction tipo_cliente(stato)		select case stato		case "P"		tipo_cliente="Privato"		case "S"		tipo_cliente="Societ&agrave;"		case "D"		tipo_cliente="Ditta individuale"		case "X"		tipo_cliente="Sconosciuto"		case else		tipo_cliente="Non specificato"		end selectend functionfunction causale_movimento(stato)	if not isnumeric(stato) then		causale_movimento=stato	else		select case stato		case -1		causale_movimento=6		case 1		causale_movimento="Rettifica giacenza"		case 2		causale_movimento="Scarico magazzino per ordine"		case 3		causale_movimento="Carico magazzino per ordine fornitore"		case 4		causale_movimento="Carico magazzino per reso DDT"		case 5		causale_movimento="Scarico magazzino per ordine (DB)"		case 6		causale_movimento="Scarico magazzino per impegno materiale"		end select	end ifend functionfunction get_tipo_ddt(stato)		select case stato		case "completo"		get_tipo_ddt="Completo"		case "parziale"		get_tipo_ddt="Parziale"		case "no_ordine"		get_tipo_ddt="Senza ordine"		end selectend function%>