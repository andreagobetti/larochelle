<%'Verifica chiusure 05_12_2015%><!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()damese=request.form("damese")amese=request.form("amese")anno=request.form("anno")idagente=request("idagente")if idagente<>"" then idagente=cint(idagente)if damese="" then	damese=month(date())end ifif amese="" then	amese=month(date())end ifif anno="" then	anno=year(date())end ifif request("raggruppa")<>"" then	raggruppa=trueelse	raggruppa=falseend ifSet metodipagamento = New ClasseMetodipagamento 'Create an Instance of the Class%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><script>$(function() {	$("#damese").change(function(){		console.log("damese:"+$("#damese").val()+" amese:"+$("#amese").val());		if (Number($("#damese").val())>Number($("#amese").val())){		$("#amese").val($("#damese").val()) ;		}		if (Number($("#damese").val())==13){		$("#amese").val(13) ;		}			});	$("#amese").change(function(){		if (Number($("#damese").val())>Number($("#amese").val())){		$("#damese").val($("#amese").val()) ;		}		if (Number($("#amese").val())==13){		$("#damese").val(13) ;		}	});});</script></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%><div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Report fatture cliente da saldare</a></div>    </div>       <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >               <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr >             <td colspan="4" style="border-bottom:1px solid;">Dal mese              <select name="DAMESE" id="damese">	              <option value="13"<%if 13=cint(damese) then response.write " selected"%>>TUTTE</option>                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(damese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select> al mese              <select name="AMESE" id="amese">	              <option value="13"<%if 13=cint(damese) then response.write " selected"%>>TUTTE</option>                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(amese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select>               Anno              <input name="anno" type="text" value="<%=anno%>" size="4">               			  <select name="PA" <%=disabled%>>			  <option value="">Tutte le fatture</option>			  <option value="SI" <%if request("PA")="SI" then%> selected <%end if%>>Solo PA</option>			  <option value="NO" <%if request("PA")="NO" then%> selected <%end if%>>Escluso PA</option>			  </select>			  Raggruppa cliente              <input type="checkbox" name="raggruppa" value="SI"  <%if request("raggruppa")<>"" then%> checked <%end if%>>              <%set rsm=conn.execute("select * from agenti order by nominativo ;")if not rsm.eof then%>              <select name="idagente" <%=disabled%>>            <option value="">Agente</option>            <%do while not rsm.eofresponse.write "<option value=""" & rsm("idagente") &""""if idagente=rsm("idagente") then response.write " selected"response.write ">" & rsm("nominativo")& "</option>"rsm.movenextloop%></select><%		  end ifrsm.closeset rsm = Nothing%>              <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;">               <a href="pag_adm_rep16_excel.asp?damese=<%=damese%>&amese=<%=amese%>&anno=<%=anno%>&pa=<%if request("pa")<>"" then%>si<%end if%>">Esporta excel</a>              </td>          </tr></table></form>        <%if amese<>"" and damese<>"" then%>		<% sql="select sommadiincassi.SommaDiimporto, fatture.IDFat, fatture.Nfat, fatture.totale_fattura, fatture.data, i.Cognome, i.Nome, i.Azienda, agenti.Nominativo, agenti.IDagente, utenti.iduser, fatture.pagamento, fatture.PA,fatture.fattura_ce FROM ((fatture LEFT JOIN (select incassi.idfat, Sum(incassi.importo) AS SommaDiimporto FROM incassi GROUP BY incassi.idfat )  AS sommadiincassi ON fatture.IDFat = sommadiincassi.idfat) INNER JOIN utenti ON fatture.iduser = utenti.iduser) LEFT JOIN agenti ON utenti.idagente = agenti.IDagente inner join utenti_intestazioni i on utenti.idintestazione= i.id "   sql=sql & "where totale_fattura>0 and (SommaDiimporto<totale_fattura or isnull(SommaDiimporto))"if damese<>13 then 	sql=sql& " and month(fatture.data)>="&damese &" and month(fatture.data)<="&amese &" and year(fatture.data)="&annoend ifif request("idagente")<>"" then sql=sql & " and agenti.idagente="&idagenteif request("pa")="SI" then sql=sql& " and pa=1 "if request("pa")="NO" then sql=sql& " and pa=0 "if raggruppa then	sql=sql&" order by utenti.azienda,utenti.iduser,fatture.idfat"else	sql=sql&" order by fatture.idfat"end ifcall paginazione_start(sql,100000,"access")%>        <table width="100%" border="1" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="9" class="ui-widget-header">fatture dal mese di <%=nome_mese(damese)%>&nbsp;al mese di <%=nome_mese(amese)%>&nbsp;<%=anno%>: <%=objPagingRS.recordcount%> elementi</td>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Fatt.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">ID Cli.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Nominativo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Tot. fattura</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Da saldare</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Agente</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Modalit&agrave; pagamento</td>          </tr>          <%iRecordsShown = 0totale=0da_saldare_tot=0if not objPagingRS.eof then tmp_iduser=objPagingRS("iduser") conta=1sub_totale=0Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>          <tr>            <td style="border-bottom:1px solid;"><input name="" type="checkbox" value=""></td>             <td style="border-bottom:1px solid;" align="right"><a href="pag_adm_fatture.asp?idfat=<%=objPagingRS("idfat")%>"><%=objPagingRS("NFAT")&get_fattura_pa(objPagingRS("pa"),objPagingRS("fattura_ce"))%></a></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=formatDateTime(objPagingRS("data"), vbShortDate)%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("iduser")%></td>            <td nowrap style="border-bottom:1px solid;"><%=objPagingRS("azienda")%></td>			<%			totale_fattura=cdbl(objPagingRS("totale_fattura"))			sommadiimporto=objPagingRS("sommadiimporto")			if isnull(sommadiimporto) then				sommadiimporto=0			else				sommadiimporto=cdbl(sommadiimporto)			end if			da_saldare=totale_fattura-sommadiimporto			if isnull(da_saldare) then da_saldare=totale_fattura			da_saldare_tot=da_saldare_tot+da_saldare						%>            <td align="right" class="corpobox" style="border-bottom:1px solid;"><%=formatcurrency(objPagingRS("totale_fattura"),2)%></td>            <td align="right" class="corpobox" style="border-bottom:1px solid;"><%=formatcurrency(da_saldare)%></td>            <td style="border-bottom:1px solid;" class="corpobox"><%=objPagingRS("nominativo")%></td>            <td style="border-bottom:1px solid;" class="corpobox"><%=metodipagamento.descrizione(objPagingRS("pagamento"))%></td>          </tr>          <% 			  totale=totale+totale_fattura		  sub_totale=sub_totale+totale_fattura		  azienda=objPagingRS("azienda")		iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext		if raggruppa and not objPagingRS.eof then		if tmp_iduser<>objPagingRS("iduser")  then		if conta>1 then		%>          <tr>            <td colspan="9" align="right"><strong>Totale n&deg; <%=conta%> fatture <%=azienda%>: <%=formatcurrency(sub_totale,2)%></strong></td>          </tr>				<%		end if		tmp_iduser=objPagingRS("iduser")		sub_totale=0		conta=1		else			conta=conta+1		end if		end if	Loop	%>          <tr>            <td colspan="5"><strong>Totale fatture:</strong></td>            <td align"right"><strong><%=formatcurrency(totale,2)%></strong></td>            <td colspan="3">&nbsp; </td>          </tr>          <tr>            <td colspan="6"><strong>Totale da saldare:</strong></td>            <td align"right"><strong><%=formatcurrency(da_saldare_tot,2)%></strong></td>            <td colspan="2">&nbsp; </td>          </tr>        </table><%	call paginazione_close()		        end if	        	        		call connclose()%>       <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>