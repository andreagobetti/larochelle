<!--#include virtual="/setup.asp" --><!--#include virtual="/pdf_fattura_inc.asp" --><!--#include file="JSON_latest.asp"--><%idfat=request("idfat")Dim Js,testif idfat<>"" then	Set Js = jsObject()	if idfat="test" then		test=true		sql="select fatture.*, utenti.email, utenti_clienti.email_inoltro_fattura FROM (fatture INNER JOIN utenti ON fatture.iduser = utenti.iduser) LEFT JOIN utenti_clienti ON utenti.iduser = utenti_clienti.iduser"	else		test=false		sql="select fatture.*, utenti.email, utenti_clienti.email_inoltro_fattura FROM (fatture INNER JOIN utenti ON fatture.iduser = utenti.iduser) LEFT JOIN utenti_clienti ON utenti.iduser = utenti_clienti.iduser where idfat="&idfat	end if	Set rs_fattura = conn.execute(sql)	idfat=rs_fattura("idfat")	email_inoltro_fattura=rs_fattura("email_inoltro_fattura")	if datediff("n",rs_fattura("invio_mail"),now())<6 then		js("success")=false		js("Message")="Email inviata meno di 5 minuti"	elseif rs_fattura("email")="" or isnull(rs_fattura("email")) then		js("success")=false		js("Message")="Manca indirizzo email cliente"	elseif test and session("email")="" then		js("success")=false		js("Message")="Manca indirizzo email per invio di test"	elseif rs_fattura("email")<>"" then		set rs_dati_vari=conn.execute ("select dati_vari.* from dati_vari where chiave='invio_fattura'")		if rs_dati_vari.eof then			js("success")=false			js("Message")="Parametri invio email mancanti"			else					dati_vari=split(rs_dati_vari("valore"),"||")			if email_inoltro_fattura="" or isnull(email_inoltro_fattura) then				email_invio=rs_fattura("email")			else				email_invio=email_inoltro_fattura			end if					Filename =pdf_fattura(idfat,"email")			data_fattura=rs_fattura("data")			Const cdoSendUsingMethod        = "http://schemas.microsoft.com/cdo/configuration/sendusing"			Const cdoSendUsingPort          = 2			Const cdoSMTPServer             = "http://schemas.microsoft.com/cdo/configuration/smtpserver"			Const cdoSMTPServerPort         = "http://schemas.microsoft.com/cdo/configuration/smtpserverport"			Const cdoSMTPConnectionTimeout  = "http://schemas.microsoft.com/cdo/configuration/smtpconnectiontimeout"			Const cdoSMTPAuthenticate       = "http://schemas.microsoft.com/cdo/configuration/smtpauthenticate"			Const cdoBasic                  = 1			Const cdoSendUserName           = "http://schemas.microsoft.com/cdo/configuration/sendusername"			Const cdoSendPassword           = "http://schemas.microsoft.com/cdo/configuration/sendpassword"			Dim objConfig			Dim objMessage			Dim Campi			Set objConfig = Server.CreateObject("CDO.Configuration")			Set Campi = objConfig.Fields			With Campi			.Item(cdoSendUsingMethod)       = cdoSendUsingPort			.Item(cdoSMTPServer)            = SMTPServer			.Item(cdoSMTPServerPort)        = 25			.Item(cdoSMTPConnectionTimeout) = 30			.Update			End With							Set objMessage = Server.CreateObject("CDO.Message")			Set objMessage.Configuration = objConfig			objMessage.Bodypart.Charset = "UTF-8"						HTML=replace(dati_vari(1),vbcrlf,"<br>")			HTML=replace(HTML,"[MESE]",nome_mese(month(data_fattura))&" "&year(data_fattura))			if test then				HTML=HTML&"<hr><p><strong>Email di test, non inviata al cliente</strong></p><hr>"				email_invio=session("email")			end if								objMessage.To =  email_invio			if dati_vari(2)<>"" then objMessage.Bcc = dati_vari(2)			objMessage.From = nomesito  & "<" & Application("email_sito") & ">"			objMessage.Subject = replace(dati_vari(0),"[MESE]",nome_mese(month(data_fattura))&" "&year(data_fattura))			objMessage.HtmlBody = "<!DOCTYPE html PUBLIC ""-//W3C//DTD XHTML 1.0 Transitional//EN"" ""http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd""><html xmlns=""http://www.w3.org/1999/xhtml""><head><meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" /><title></title></head><body>"&HTML&"</body></html>"			objMessage.AddAttachment Server.MapPath("\public\fatturepdf\"&Filename)			on error resume next			objMessage.Send			if err.number<>0 then				add2log "Errore invio email fattura [fattura="&idfat&"]"&rs_fattura("nfat")&"[/fattura] a "&email_invio&" eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]" ,3				js("success")=false				js("Message")="Errore nell'invio della mail a "&email_invio			else				js("success")=true				js("Message")="Fattura inviata"				messaggio_inviato=true				add2log "Invio email fattura [fattura="&idfat&"]"&rs_fattura("nfat")&"[/fattura] eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]" ,2			end if			on error goto 0			Set objMessage = Nothing			Set objConfig = Nothing			if not test then				conn.execute ("UPDATE fatture SET invio_mail=now() WHERE idfat="&idfat)				'rs_fattura("invio_mail")=now()				'rs_fattura.update			end if					end if			set rs_dati_vari = Nothing	else		js("success")=false		js("Message")="Condizione di errore non identificata"	end if	rs_fattura.close	set rs_fattura=nothing	Response.ContentType = "application/json; charset=utf-8"	Response.CodePage = 65001	js.Flush	set js=Nothing	call connclose()	end if%>