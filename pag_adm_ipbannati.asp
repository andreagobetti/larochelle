<!--#include virtual="/setup.asp" --><!--#include virtual="/paginazione.asp" --><%if not utente_admin then call login()ip=request("modifica")if ip<>"" then	conn.execute "delete from ip_bannati where ip='"&ip&"'",n	if n=0 then		errore="Eliminazione non riuscita"	else		call carica_ip_bannati()		add2log "Eliminato "&ip&" da elenco ip bannati eseguita da [admin="&session("iduser")&"]"&session("nominativo")&"[/admin]",2			end ifend ifoper="list"'response.write oper%><!--#include virtual="/regioni_inc.asp" --><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body><div id="wrap"><div id="header"><%=titolo_top%> <!-- Box CORPO INIZIO-->      	  <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>" class="Amministra_piccolo">Elenco ip bannati</a></div>            <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;" >          <!-- Colonna CORPO INIZIO-->          <%		sql="select ip, prima_visita, ultima_visita, numero_visite  from ip_bannati order by ultima_visita desc"		iPageSize=100		strSql = sql		%><%=response.write (errore)%>                 <table width="100%" border="0" cellpadding="2" cellspacing="0" bordercolor="#CCCCCC" class="tabella1">            <tr>              <td align="center" bgcolor="#E5E5E5"><p>Rimuovi</p></td>              <td bgcolor="#E5E5E5">IP</td>                            <td align="center" bgcolor="#E5E5E5">Inizio ban</td>              <td align="center" bgcolor="#E5E5E5">Ultimo accesso</td>              <td align="center" bgcolor="#E5E5E5">Numero accessi dopo ban</td>            </tr>            <%call paginazione_start(strsql,ipagesize,"mysql")Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>            <tr>              <td align="center" style="border-bottom:1px solid;"><input type="radio" name="modifica" value="<%=objPagingRS("ip")%>" onClick="this.form.submit()"></td>              <td style="border-bottom:1px solid;"><b><%=objPagingRS("ip")%></b></td>              <td align="center" style="border-bottom:1px solid;"><%=livello_admin(objPagingRS("prima_visita"))%></td>              <td align="center" style="border-bottom:1px solid;"><%=objPagingRS("ultima_visita")%></td>              <td align="center" style="border-bottom:1px solid;"><%=objPagingRS("numero_visite")%></td>            </tr>            <% 			iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(5,true)            %>            </table>        </form>                <!-- Box CORPO FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%rsClose%>