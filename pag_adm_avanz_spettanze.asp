<%t_inizio=timer()%><!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/ClasseOrdine.asp" --><%	iduser=request("iduser")	idord=request("idord")	m_tabella="ordini"	if request.form("rettifica")<>"" then		rettifica=true					end if	if request.form("salva")<>"" then		'set ordine= (new ClasseOrdine)(array("apri","ordini",idord))		'call ordine.aggiorna_quantita_spettanze()		set ordine= (new ClasseOrdine)(array("aggiorna_quantita_spettanze",m_tabella,idord))		set ordine = nothing		rettifica=false	end if		'response.write oper%><!--#include virtual="/sub_head_adm.asp" --></head><body><div id="wrap"><div id="header"><%=titolo_top%>         <!-- Box CORPO INIZIO-->		<%barra=0%>	<div id="barra_fissa">			  <!--#include virtual="/sub_barra_adminsf2.asp" -->		<%			set rs_ordine=conn.execute ("select ordini.nord, ordini.iduser from ordini where idord="&idord)	 			iduser=rs_ordine("iduser")			nord=rs_ordine("nord")			set rs_ordine = nothing						%>         <div class="ui-widget-header ui-corner-top titolo_admin">			<a href="<%="pag_adm_ordini.asp?idord="&idord%>">Ordine <%=nord%></a> >> <a href="<%=questofile&"?idord="&idord%>">Situazione spettanze</a>	    </div>	    </div>	    	    <div class="ui-widget-header" style="padding: 5px;">		    <%			    set rs=conn.execute("select utenti.nome, utenti.cognome, utenti.azienda from utenti where iduser="&iduser)			    response.write denominazione(rs(0),rs(1),rs(2))			    set rs = nothing			    %>	    </div>		<%		set ordine= (new ClasseOrdine)(array("apri","ordini",idord))		call ordine.elenco_dipendenti								%>		In ordine<input type="text" class="in_ordine" disabled> Pronto<input type="text" class="pronto" disabled>In consegna<input type="text" class="consegna" disabled> SHIFT + click per impostare quantità totale	    <form method="POST" action="<%=questofile%>" id="form-avanz-spettanze">		  <input type="hidden" name="idord" value="<%=idord%>" >		  <%if rettifica then %>		  <input type="hidden" name="rettifica" value="si" >		  <%end if %>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">	      <tr style="border-bottom: 1px solid gray; background: #E5E5E5; font-size:11px;">		      <td>Codice		      </td>		      <td>Articolo		      </td>		      <td align="center">Quantit&agrave;		      </td>	      </tr>	          <%		          		sql="select ordini_dett.*, magazzino.quantita_magazzino,magazzino.idmag, magazzino.Data_arrivo, magazzino.quantita_riordino, magazzino.quantita_ordinata, varianti_a.variante_a, varianti_b.variante_b, prodotti.idfor, prodotti.codice FRom (((magazzino RIGHT JoIN ordini_dett oN (magazzino.idvarb = ordini_dett.idvarb) AND (magazzino.idvara = ordini_dett.idvara) AND (magazzino.idpro = ordini_dett.idpro)) LEFT JoIN varianti_b oN ordini_dett.idvarb = varianti_b.IDvarb) LEFT JoIN varianti_a oN ordini_dett.idvara = varianti_a.IDvara ) left join prodotti on  magazzino.idpro = prodotti.idpro where codice_ordine<>'' "		        sql=replace(sql,"ordini",m_tabella)        sql=sql&" and idord="&idord &" order by ordine,iddett;"		set rs=conn.execute(sql)		stringa_iddett=""		do while not rs.eof			stile_cella=""			txt_spettanze= dettaglio_spettanze( m_tabella, rs("iddett"), rs("quantita"),true,stile_cella)			%>	          <tr valign="top" style="border-top: 1px solid black; padding-bottom:10px; padding-top:10px;" class="<%=stile_cella%>">			      <td align="center" >              <b><a href="<%="product.asp?idpro=" & RS("idpro")%>" title="Clicca per le opzioni" class="menu_idpro" data-idmag="<%=RS("idmag")%>" data-idpro="<%=RS("idpro")%>"><%=RS("codice_ordine")%></a></b><%if utente_andrea then %><%=RS("idmag")%><%end if %>            </td>            <td >				<%=rs("articolo_ordine")%>	            <%if rs("varianti_ordine")<>"" then response.write "<br>"&rs("varianti_ordine")					response.write txt_spettanze	            %>	        </td>            <td align="center" valign="top" style="<%=stile%>"><%=rs("um")%>&nbsp;              <%=rs("quantita")%>			</td>          </tr>          <%            rs.movenext			loop			set rs = nothing			call connclose()			if rettifica then				testo_salva="Salva rettifiche"			else				testo_salva="Salva"			end if			%>			</table>						<div class="ui-dialog-buttonpane ui-widget-content ui-helper-clearfix">				<div class="ui-dialog-buttonset" style="text-align: center;">				<input type="submit" name="salva" value="<%=testo_salva%>" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">				<input type="submit" name="salva" value="DDT" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">				<%if not rettifica then %>				<input type="submit" name="rettifica" value="Rettifica" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">				<%end if %>				</div>			</div>		    	    </form></div><%if false then %>			<script type="text/javascript" src="Jquery/js/jquery.validate.min.js"></script>			<script type="text/javascript" src="Jquery/js/jquery.validate.min_it.js"></script><%end if %>			<script>				$(function() {				    var classi=["in_ordine","pronto","consegna"];				    var form = $("#form-avanz-spettanze");				    //				    form.validate({//				        invalidHandler: function(event, validator) {//				            // 'this' refers to the form//				            var errors = validator.numberOfInvalids();//				            if (errors) {//				                var message = errors == 1 ?//				                    'You missed 1 field. It has been highlighted' ://				                    'You missed ' + errors + ' fields. They have been highlighted';//				                console.log(message);//				            } else {//				                console.log("nessuno");//				            }//				        },//				        submitHandler: function(form) {//				            console.log("submit");//				            form.submit();//				        }//				    });				    				    $(".do").click(function(e) {					    if(e.shiftKey){							var id=trova_id($(this));						    //var id=$(this).attr("id").replace(replace, "");						    console.log("id:"+id);						    var quantita=$("#quantitam"+id).val();						    console.log("quantita:"+quantita);						    $(this).val(quantita);						}					});										$(".do").focusout(function(){						var id=trova_id($(this));						console.log("focusout"+id);						elabora_riga(id);					});										function elabora_riga(id){												var quantita=$("#quantitam"+id).val();						var consegnato=0;						var pronto=$("#pronto"+id).val();						var prontomax=quantita-consegnato;						if(pronto>prontomax){							pronto=prontomax;							$("#pronto"+id).val(pronto);							}						var in_ordine=$("#in_ordine"+id).val();						var in_ordinemax=quantita-consegnato-pronto;						if(in_ordine>in_ordinemax){							in_ordine=in_ordinemax;							$("#in_ordine"+id).val(in_ordine);							}						var in_consegna=$("#consegna"+id).val();						var in_consegnamax=quantita-consegnato;						if(in_consegna>in_consegnamax){							in_consegna=in_consegnamax;							$("#consegna"+id).val(in_consegna);							}																				console.log("quantita:"+quantita+" pronto:"+pronto+" prontomax:"+prontomax+" in_ordine:"+in_ordine+" in_ordinemax:"+in_ordinemax+" in_consegna:"+in_consegna+" in_consegnamax:"+in_consegnamax);					}					function trova_id(obj){												for (var i = 0; i < classi.length; i++) {							if($(obj).hasClass(classi[i])){							    console.log(classi[i]);							    var sostituisci=classi[i];						    }						}					    var id=$(obj).attr("name").replace(sostituisci, "");						return id;					}																								});				</script><%	txt_timer=txt_timer&"T fine:"&FormatNumber(timer() - t_inizio, 2)&" "%><div id="footer"><%=txt_timer%></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>