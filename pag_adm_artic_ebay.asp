per<>"new" then%>        <button   style="FONT: 12px;" id="elimina">Elimina</button>                <%end if%>        <button   style="FONT: 12px;" id="annulla">Annulla</button>      </div>      <%if cancellabile=false then%>      <div class="div_testo" style="text-align:center;"><%=cancellabile_testo%></div>      <%end if%>            <div id="tabs">        <ul>          <li><a href="#tabs-1">Dati principali</a></li>          <li><a href="#tabs-2">Altri dati</a></li>          <%if rs("status")<>"" then %>          <li><a href="#tabs-3">Dati inserzione</a></li>          <%end if %>          <%if false then %>          <li><a href="#tabs-4">Altri dati</a></li>          <li><a href="#tabs-5">Opzioni</a></li>          <li><a href="#tabs-6">ordini</a></li>          <li><a href="#tabs-7">Allegati</a></li>          <li><a href="#tabs-8">Immagini</a></li>          <%end if %>        </ul>        <div id="tabs-1" class="tab-panel">          <%if oper<>"new" then%>          <label style="width:100%; padding-bottom:5px;"> Articolo inserito il <%=rs("data_creato")%>, ultima modifica il <%=rs("data_modificato")%></label>          <label style="width:100%; padding-bottom:5px;"> Codice: <a href="product.asp?idpro=<%=rs("idpro")%>" target="_blank"><%=rs("codice")%></a></label>          <br/>          <%end if%>                              <%if oper="edit" then	val=rs("title")	maxlength= rs("title").DefinedSizeelseif oper="new" then	maxlength= rs("title").DefinedSizeelse	val=request.form("title")end if%>          <label>Title</Label>          <input name="title" id="title" type="text" value="<%=val%>" maxlength="<%=maxlength%>" class="richiesto" title="Titolo dell'oggetto inserito nell'inserzione. Non è consentito utilizzare l'HTML. Lunghezza massima: 80 caratteri" ><br>Titolo dell'oggetto inserito nell'inserzione. Non è consentito utilizzare l'HTML. Lunghezza massima: 80 caratteri          <br/>                  <%if false then %>		<label>Note</label>		<%if oper="edit" then			val=rs("note")		else	      	val=request.form("note")		end if		%>		<br/>		<textarea name="note" id="note" style="width:100%; height:200px;"><%=val%></textarea>Lunghezza massima: 495 caratteri<br>		<%end if %>         		<%if oper="edit" then	val=rs("category_1")elseif oper="new" then	val="0"else	val=request.form("category_1")end if%>          <label>Category 1</Label>          <input name="category_1" type="text" value="<%=val%>" maxlength="<%=10%>" class="" ><br>Categoria principale in cui l'oggetto viene messo in venditalunghezza massima: 10 caratteri<br>Inserire l'ID della categoria ebay: <a href="http://pics.ebaystatic.com/aw/pics/it/categorychanges/IT_Category_Changes_May2016.pdf" target="_blank"><b>Lista completa categorie PDF</b></a>, <a href="http://pics.ebaystatic.com/aw/pics/it/categorychanges/IT_New_Structure_May2016.pdf" target="_blank"><b>Struttura delle categorie PDF</b></a>          <br/>                    <label>Store Category</Label>			<%			if oper="edit" then				val=rs("store_category")			elseif oper="new" then				val=""			else				val=request.form("store_category")			end if			val=val&""							tmp=split(conn.execute("select impostazioni_ebay.store_categories from impostazioni_ebay where id=1")(0),vbcrlf)	              %>	              <!--<%=val %>-->                 <select name="store_category">	             <option value="">Seleziona categoria dello store</option>                  <%				for n=0 to ubound(tmp)										if instr(tmp(n),":")>0 then 'Ci sono i 2 punti								tmp2=split(tmp(n),":")								riga=trim(tmp2(1))								codice=tmp2(0)							else 						'Non ci sono i 2 punti								riga=ucase(tmp(n))								codice=riga							end if							codice=codice&""												response.write "<option value='"&codice&"'"					if val=codice then response.write " selected"					response.write ">" & riga&"</option>"				next				%>                </select>																	<br>Categorie personalizzate per la suddivisione degli oggetti all'interno del Negozio. I proprietari dei Negozi possono creare fino a 19 categorie personalizzate (l'ulteriore categoria del Negozio non può essere personalizzata e conserva il valore "Altro"). Se specificato, deve essere un numero compreso tra 0 e 20. Se specifichi un numero non valido (per esempio 21), il valore verrà reimpostato automaticamente a 1 (Altro).          <br/>		  <label>Quantity</Label>			<%			if oper="edit" then				val=rs("quantity")			elseif oper="new" then				val="1"			else				val=request.form("quantity")			end if			%>          <input name="quantity" type="text" value="<%=val%>" maxlength="<%=10%>" class="richiesto" >          <br/>		   <label>Duration</label>          <%if oper="edit" then	val=rs("duration")elseif oper="new" then	val=10else	val=request.form("duration")end if%>          <select  name="duration">            <option value="GTC" <%if val="GTC" then response.write " selected"%> >Senza scadenza</option>            <option value="30" <%if val="30" then response.write " selected"%> >30</option>            <option value="10" <%if val="10" then response.write " selected"%> >10</option>            <option value="7" <%if val="7" then response.write " selected"%> >7</option>            <option value="5" <%if val="5" then response.write " selected"%> >5</option>            <option value="3" <%if val="3" then response.write " selected"%> >3</option>          </select><br>Numero di giorni durante i quali l'inserzione sarà in corso.          <br />		   <label>Starting price</Label>			<%			if oper="edit" then				val=rs("starting_price")			elseif oper="new" then				val="1"			else				val=request.form("starting_price")			end if			%>          <input name="starting_price" type="text" value="<%=val%>" maxlength="<%=10%>" class="richiesto" ><br><span class="rosso"><b>Attenzione: Prezzo iva compresa</b></span><br>Per le inserzioni in formato d'asta, indica l'offerta minima. Per l’ inserzioni Compralo Subito, indica il prezzo fisso. Possono essere inseriti solo numeri nel formato valuta standard (0,00). Non sono ammessi caratteri o lettere speciali.          <br/>           <%if oper="edit" then      	val=rs("description")      else      	val=request.form("description")      end if      %>		<label>Description</label>		<br/>		<textarea name="description" class="mceEditor" id="description" style="width:100%; height:500px;"><%=val%></textarea>          </div>                    <div id="tabs-2" class="tab-panel">	          		<label>Format</label>          <input type="radio" name="format" value="9" <%if rs("format")=9 or oper="new" then response.write " checked"%> />Inserzione Compralo Subito          <input type="radio" name="format" value="1" <%if rs("format")=1 then response.write " checked"%> />Astra online		  <br>            <label>SubtitleText</label>          <%			if oper="edit" then				val=rs("SubtitleText")				maxlength= rs("SubtitleText").DefinedSize			elseif oper="new" then				maxlength= rs("SubtitleText").DefinedSize			else				val=request.form("SubtitleText")			end if			%>          <input name="SubtitleText" type="text"  value="<%=val%>" maxlength="<%=maxlength%>"  title="Inserisci la descrizione breve dell'articolo, campo alfanumerico, campo obbligatorio, massimo <%=maxlength%> caratteri" ><br>		  Sottotitolo da utilizzare accanto al titolo (facoltativo). Fornisce ulteriori parole chiave per la ricerca nei titoli e nelle descrizioni effettuata dagli acquirenti. Non è consentito utilizzare l'HTML. Lunghezza massima: 80 caratteri. <b>Impostando un valore viene attivata la funzionalità e vengono applicate le relative tariffe.</b>          <br/>          <label>Category 2</Label>			<%			if oper="edit" then				val=rs("category_2")			elseif oper="new" then				val=""			else				val=request.form("category_2")			end if			%>          <input name="category_2" type="text" value="<%=val%>" maxlength="<%=10%>" class="" ><br>Seconda categoria, facoltativa, in cui l'oggetto viene messo in vendita (la tariffa d'inserzione viene raddoppiata), lunghezza massima: 10 caratteri          <br/>					<label>Reserve price</Label>			<%			if oper="edit" then				val=rs("reserve_price")			elseif oper="new" then				val="1"			else				val=request.form("reserve_price")			end if			%>          <input name="reserve_price" type="text" value="<%=val%>" maxlength="<%=10%>" class="richiesto" ><br>Solo per le inserzioni in formato d'asta, indica il prezzo minimo (il Prezzo di riserva deve essere superiore al Prezzo di partenza). Il Prezzo di riserva non è supportato in tutte le categorie.          <br/>                 <%if oper="edit" then      	val=rs("payment_instructions")      else      	val=request.form("payment_instructions")      end if      %>		<label>payment_instructions</label>		<br/>		<textarea name="payment_instructions" class="" style="width:100%; height:200px;"><%=val%></textarea><br>Istruzioni per l'acquirente, ad esempio termini di pagamento e regole sulla restituzione.Lunghezza massima: 500 caratteri<br>          <label>Insurance Option</Label>			<%			if oper="edit" then				val=rs("insurance_option")			elseif oper="new" then				val=""			else				val=request.form("insurance_option")			end if			%>          <input name="insurance_option" type="text" value="<%=val%>" maxlength="<%=10%>" class="" ><br>Per conoscere i valori validi, vedi la pagina relativa al formato CSV di Turbo Lister.          <br/>    <label>Accept Paypal</label>          <%val=""if oper="edit" then	if rs("accept_paypal")=1 then val=" checked"elseif oper="new" then	val=" checked"else	val=request.form("accept_paypal")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="accept_paypal" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Indica se accetti pagamenti con PayPal. Se il campo è impostato su Sì, devi specificare anche un indirizzo email nel campo "PayPal email address".          <br /> <label>Accept MO Cashiers</label>          <%val=""if oper="edit" then	if rs("accept_MO_Cashiers")=1 then val=" checked"elseif oper="new" then	val=" checked"else	val=request.form("accept_MO_Cashiers")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="accept_MO_Cashiers" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Indica se accetti pagamenti con vaglia postale.          <br /><label>Accept Personal Check</label>          <%val=""if oper="edit" then	if rs("Accept_Personal_Check")=1 then val=" checked"elseif oper="new" then	val=" checked"else	val=request.form("Accept_Personal_Check")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="Accept_Personal_Check" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Indica se accetti pagamenti con vaglia postale.          <br /><label>Accept Visa/Mastercard</label>          <%val=""if oper="edit" then	if rs("accept_visa")=1 then val=" checked"elseif oper="new" then	val=" checked"else	val=request.form("accept_visa")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="accept_visa" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Indica se accetti pagamenti con Visa/CartaSì e MasterCard/EuroCard. Non disponibile per tutti i siti eBay.          <br /><label>Accept COD</label>          <%val=""if oper="edit" then	if rs("accept_cod")=1 then val=" checked"elseif oper="new" then	val=" checked"else	val=request.form("accept_cod")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="accept_cod" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Indica se accetti pagamenti in contrassegno. Non disponibile per tutti i siti eBay.          <br /><label>Accept Money Xfer</label>          <%val=""if oper="edit" then	if rs("accept_money_xfer")=1 then val=" checked"elseif oper="new" then	val=" checked"else	val=request.form("accept_money_xfer")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="accept_money_xfer" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Indica se accetti pagamenti con bonifico bancario. Non disponibile per tutti i siti eBay.          <br />		  <%if false then %><label>Gallery</label>          <%val=""if oper="edit" then	if rs("gallery")=1 then val=" checked"elseif oper="new" then	val=" checked"else	val=request.form("gallery")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="gallery" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Opzione di vendita che consente di aggiungere l'oggetto alla Galleria (<b><b>è prevista una tariffa aggiuntiva</b></b>).          <br /><label>Gallery Plus</label>          <%val=""if oper="edit" then	if rs("gallery_plus")=1 then val=" checked"elseif oper="new" then	val=""'" checked"else	val=request.form("gallery_plus")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="gallery_plus" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Opzione di vendita che consente di aggiungere l'oggetto alla Galleria (<b>è prevista una tariffa aggiuntiva</b>).          <br /><label>Gallery Featured</label>          <%val=""if oper="edit" then	if rs("gallery_featured")=1 then val=" checked"elseif oper="new" then	val=""'" checked"else	val=request.form("gallery_featured")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="gallery_featured" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Opzione di vendita che consente di aggiungere l'oggetto alla Galleria (<b>è prevista una tariffa aggiuntiva</b>).          <br />          <label>Gallery url</Label>			<%			if oper="edit" then				val=rs("gallery_url")			elseif oper="new" then				val=""			else				val=request.form("gallery_url")			end if			%>          <input name="gallery_url" type="text" value="<%=val%>" maxlength="<%=45%>" class="" ><br>URL della foto per la Galleria. Se viene specificato un URL e i campi Galleria e In Vetrina della Galleria sono impostati su (0), l'oggetto verrà comunque messo in vendita nella Galleria (con la relativa tariffa).          <br/><label>Bold</label>          <%val=""if oper="edit" then	if rs("bold")=1 then val=" checked"elseif oper="new" then	val=""'" checked"else	val=request.form("bold")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="bold" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Opzione di vendita che consente di mostrare il titolo dell'oggetto in grassetto nei risultati della ricerca. Non si applica al sottotitolo dell'oggetto (SubtitleText), se specificato (<b>è prevista una tariffa aggiuntiva</b>).          <br /><label>Highlight</label>          <%val=""if oper="edit" then	if rs("highlight")=1 then val=" checked"elseif oper="new" then	val=""'" checked"else	val=request.form("highlight")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="highlight" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Opzione di vendita che consente di mostrare l'oggetto evidenziato nei risultati della ricerca (<b>è prevista una tariffa aggiuntiva</b>).          <br /><label>Featured Plus</label>          <%val=""if oper="edit" then	if rs("featured_plus")=1 then val=" checked"elseif oper="new" then	val=""'" checked"else	val=request.form("featured_plus")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>          <input type="checkbox" name="featured_plus" value="si" <%response.write val%><%if view="view" then response.write " disabled"%>><br>Opzione di vendita che consente di mostrare l'inserzione all'inizio dell'elenco all'interno della categoria specifica. Disponibile solo per gli account con Punteggio di feedback pari almeno a 10. Non applicabile agli oggetti dei Negozi eBay (7) (<b>è prevista una tariffa aggiuntiva</b>).          <br />		  <%end if %>          <label>ShippingType</Label>			<%			if oper="edit" then				val=rs("shippingtype")			elseif oper="new" then				val="1"			else				val=request.form("shippingtype")			end if			%>          <input name="shippingtype" type="text" value="<%=val%>" maxlength="<%=45%>" class="" ><br>Per conoscere i valori validi, vedi la pagina relativa al formato CSV di Turbo Lister.           <br/>          <label>ShippingPackage</Label>			<%			if oper="edit" then				val=rs("shippingpackage")			elseif oper="new" then				val=""			else				val=request.form("shippingpackage")			end if			%>          <input name="shippingpackage" type="text" value="<%=val%>" maxlength="<%=45%>" class="" ><br>URL della foto per la Galleria. Se viene specificato un URL e i campi Galleria e In Vetrina della Galleria sono impostati su (0), l'oggetto verrà comunque messo in vendita nella Galleria (con la relativa tariffa).          <br/>          <label>ShippingIrregular</label>          <%val=""if oper="edit" then	if rs("shippingirregular")=1 then val=" checked"elseif oper="new" then	val=""'" checked"else	val=request.form("shippingirregular")	if val="si" then val=" checked"end ifif val<>" 