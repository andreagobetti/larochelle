s).prop("checked"));	});			  });	  </script>    <table width="100%" id="elenco" border="0" cellpadding="2" cellspacing="0" class="tabella1">			<tr style="border-bottom:1px solid;"><td><label><input type="checkbox" id="checkAll" checked/></label></td><td>Articolo</td><td>eBay</td><td>Prezzo</td><td>Inizio<br>Fine</td><td>Giorni</td><td></td></tr>        <%			'response.write "cercain"&cercain			'set rs=conn.execute(sql)			Set rs = Server.CreateObject("ADODB.Recordset")			sql="select prodotti_ebay.*, prodotti.codice from prodotti_ebay inner join prodotti on prodotti_ebay.idpro=prodotti.idpro"			rs.Open sql,conn,3,3			if rs.eof then %>				<tr>					<td align="center" style="border-bottom:1px solid;" colspan="7">Nessun articolo </td>				</tr>				<tr>		    <%else %>		      		            <%				do until rs.EOF				colore=""				attiva=false					giornitot=datediff("d",rs("starttime"),rs("endtime"))					giorni=datediff("d",now(),rs("endtime"))					if giorni<0 or not isnumeric(giorni) then						'Inserzione scaduta						colore=""					else						attiva=true						select case rs("status")						case "warning"								colore="bgcolor='#ffff80'" 'Giallino 						case "failure"							colore="bgcolor='#FFCCCC'" 'Rosino						case else							colore="bgcolor='#99FF99'" 'Verdino						end select						colore_barra="33ff33"						if giorni<=2 then							colore_barra="ff1a1a"						end if						percentuale=roundup((giorni/giornitot*100),0)					end if					if isnull(rs("endtime")) then						'Inserzione mai attivata						if rs("status")="failure" then							colore="bgcolor='#FFCCCC'" 'Rosino						elseif rs("status")="warning" then							colore="bgcolor='#ffff80'" 'Giallino 						else							colore=""						end if					end if		%>		<tr  <%=colore%>>			<td><input type="checkbox" class="checkboxenabled" name="includi" value="<%=rs("idebay")%>" <%if attiva=false then %>checked <%end if %>></td>			<td><%=rs("codice")%> &nbsp; <%=rs("title")%></td>			<td><%