<%If Request.ServerVariables("HTTPS")="off" Then	strSecureURL = "https://"	strSecureURL = strSecureURL & Request.ServerVariables("SERVER_NAME")	strSecureURL = strSecureURL & Request.ServerVariables("URL")&"?"&Request.ServerVariables("QUERY_STRING")	Response.Status="301 Moved Permanently"	Response.AddHeader "Location",strSecureURLEnd Ifdim t_iniziot_inizio=timer()dim conn'Versione CSS o JAVASCRIPTconst ver_js_css=21Response.CharSet = "UTF-8"Response.CodePage = 65001Response.LCID = 1040if questofile="" then questofile=Request.ServerVariables("Script_Name")if questofile<>"/404.asp" then  if instr(Application("ip_bannati"),Request.ServerVariables("REMOTE_ADDR"))>0 then	session("codice_errore")=5	response.redirect "404.asp"  end ifend if%><!--#include virtual="/config/mdb.asp" --><%'---------------VARIABILI'--voce selezionata imput boxconst selected="selected style='color: red;'"'---------------FUNZIONIsub get_application()	if  Application("ConfigOk")<> true then		dim rs		Set rs = Server.CreateObject("ADODB.Recordset")		testo="ConfigOk:"&Application("ConfigOk")&vbcrlf	'IMPOSTAZIONI-----------------------------------------------------------------------		sql="select * from impostazioni order by id"		rs.Open sql, conn, 3, 3		rs.movefirst		Application.Lock		Application("brwstitle")=rs("brwstitle")		Application("prezzo")=rs("prezzo")		Application("grec4page")=rs("grec4page")		Application("email_sito")=rs("email_sito")		Application("imgdir")=rs("imgdir")		Application("elencoum")=rs("elencoum")		Application("tag_desc")=rs("tag_desc")		Application("tag_key")=rs("tag_key")		Application("moduli")=rs("moduli")		'modifiche da portale		Application("skins")=rs("skins")		Application("main_page")=rs("main_page")		'Application("top")=rs("top")		Application("img_email")=rs("img_email")		Application("dim_img_b")=rs("dim_img_b")		Application("dim_img_s")=rs("dim_img_s")		Application("bottom")=rs("bottom")		Application("contatore")=rs("contatore")		Application("email_suppl")=rs("email_suppl")		Application("head")=rs("head")		Application("codice_chat")=rs("codice_chat")		Application("testo_settore")=rs("testo_settore")		Application("testo_categoria")=rs("testo_categoria")		Application("escludi_sito_suggerito")=rs("escludi_sito_suggerito")		Application("intestazione_ddt")=rs("intestazione_ddt")		Application("banca_appoggio")=rs("banca_appoggio")		Application("iban")=rs("iban")		Application("ultimo_backup")=rs("ultimo_backup")		Application("metodi_incasso")=rs("metodi_incasso")		Application("scopri_prezzi")=rs("scopri_prezzi")		Application("codice_paypal")=rs("codice_paypal")		Application("pagamento_immediato")=rs("pagamento_immediato")		Application("mipiace")=rs("mipiace")		Application("Pagamenti_ordine")=rs("Pagamenti_ordine")		Application("riavvio_server")=now()		Application("filigrana")=rs("filigrana")		Application("testo_filigrana")=rs("testo_filigrana")		Application("width_filigrana")=rs("width_filigrana")		Application("azzera_numerazioni")=rs("azzera_numerazioni")		Application("rl_t_refresh")=rs("rl_t_refresh")		Application("rl_t_toll")=rs("rl_t_toll")		Application("rl_t_idle")=rs("rl_t_idle")		'Application("data_inventario")=rs("data_inventario")		Application("ip_bannati")=rs("ip_bannati")		Application("dati_trasporto")=rs("dati_trasporto")		Application("settore_sup")=rs("settore_sup")		Application("settore_lat")=rs("settore_lat")		Application("logBoot")=rs("logBoot")		Application("minimo_preventivo")=rs("minimo_preventivo")		Application("category_predefinito")=rs("category_predefinito")		Application("prezzi_con_iva")=rs("prezzi_con_iva")		Application("disponibilita_auto")=rs("disponibilita_auto")		'Application("consenti_acquisti")=rs("consenti_acquisti")		'Application("consenti_registrazione")=rs("consenti_registrazione")		if Application("prezzi_con_iva")>0 then Application("prezzi_con_iva")=iva(date())		rs.close		rs.Open "select * from banche where predefinita=true", conn, 3, 3		if not rs.eof then			Application("banca")=rs("idbanca")		else			Application("banca")="1"		end if		rs.close		rs.Open "select * from utenti_tipologia where colore<>''", conn, 3, 3		do while not rs.eof			str_tipologia=str_tipologia&rs("id")&"|"&rs("tipologia")&"|"&rs("colore")			rs.movenext			if not rs.eof then str_tipologia=str_tipologia&"||"		loop		rs.close		'NOTE		'set rs=conn.execute("SELECT max(ultima_risposta) FROM `messaggi_discussioni`")		'if rs.eof then		'	Application("ultima_nota")=now()		'else		'	Application("ultima_nota")=rs(0)		'end if		'APPUNTI		set rs=conn.execute("SELECT max(data) FROM `appunti` where pubblico=1")		if rs.eof then			Application("time_ultimo_appunto")=now()		else			Application("time_ultimo_appunto")=rs(0)		end if		set rs=nothing		Application("str_tipologia")=str_tipologia		if Application("ConfigOk")="" then			'conn.Execute "INSERT INTO riavvio_server (data) VALUES (now())"			add2log "Riavvio server, variabili application perse"&vbcrlf&testo,1		else			add2log "Configurazione sito aggiornata"&vbcrlf&testo,1		end if		Application("ConfigOk") = true		'application("cache_settori")=""		Application.UnLock	end ifend subsub ResponseEnd()	call rsclose()	response.endend subsub rsclose()	on error resume next	rs.Close	set rs = Nothing	objPagingRS.Close	Set objPagingRS = Nothing	conn.Close	set conn = Nothing	conn.Close	set conn=nothingend subsub connclose()	conn.Close	set conn = Nothingend subfunction toglivcl(str)	if right(str,2)=VbCrLf then		str=left(str,len(str)-2)		str=toglivcl(str)	end if	toglivcl=strend functionfunction Get_last_id(tabella)	on error resume next	Get_last_id = clng(conn.execute(" select @@IDENTITY FROM "&tabella)(0))	if err.number<>0 then		response.write tabella		response.end	end if	'call add2log("Get_last_id "&tabella&":"&Get_last_id,0)end functionfunction fixquotes(byval str)	if isnull(str) then		fixquotes=""		exit function	end if	fixquotes=replace(str,"'","''")	fixquotes=replace(str,"""","&quot;")end function'Funzioni di conversione datifunction converti_typevar14(val)	'Se tipo decimale converte in double, altrimenti ritorna lo stesso tipo	if not isnull(val) then		if VarType(val)=14 then			converti_typevar14=cdbl(val)		else			converti_typevar14=val		end if	else		converti_typevar14=val	end ifend functionfunction converti_bool(bbool)	'Converte true e false in 1 e 0	if bbool then		converti_bool=1	else		converti_bool=0	end ifend functionsub tabellagetrow(rsArray)	' If the array is a large grid of data, you identify' the columns as (rsArray, 1) and the rows as (rsArray, 2)' A single item in the array is located at rsArray(column, row)colStart = LBound(rsArray, 1)colEnd   = UBound(rsArray, 1)rowStart = LBound(rsArray, 2)rowEnd   = UBound(rsArray, 2)' Loop through all rows of the array and display the dataResponse.Write("<table>" & chr(13))For row=rowStart to rowEnd   Response.Write("<tr>" & chr(13))   ' For each row we loop through every column   For col=colStart to colEnd      Response.Write(chr(9) & "<td>" & rsArray(col,row) & "</td>" & chr(13))   Next   Response.Write("</tr>" & chr(13))NextResponse.Write("</table>" & chr(13))end subfunction aggiusta_decimale (numero,asp_sql)	if asp_sql="asp" then		'Toglie il punto e mette la virgola		aggiusta_decimale=replace(numero,".",",")	else	'"sql"		'Toglie la virgola e mette il punto		aggiusta_decimale=replace(numero,",",".")	end if	if aggiusta_decimale="" then aggiusta_decimale=0end function'Permessi ADMINfunction ha_il_permesso(quale)	if instr(session("permessi"),quale&"=1")>0 then		ha_il_permesso=true	else		ha_il_permesso=false	end ifend functionfunction utente_ha_il_permesso(quale)	if instr(session("permessi_utente"),quale&"=1")>0 then		utente_ha_il_permesso=true	else		utente_ha_il_permesso=false	end ifend functionsub via_senza_permesso(quale)	dim tab	if not ha_il_permesso(quale) then		call add2log("Tentativo di esecuzione senza permesso "&quale&vbcrlf&queryeform()&"HTTP_REFERER:"&Request.ServerVariables("HTTP_REFERER"),3)		call connclose()		if request.querystring("tab")<>"" then			tab="?tab=si"		end if		Response.redirect "pag_adm_no_permessi.asp"&tab	end ifend sub'Funzioni di conversione stringhefunction AllFirstUp (frase)	'Converte prima lettera di ogni parola in uppercase	dim i	frase = Split(frase, " ")	for i = 0 to ubound(frase)	    frase(i) = UCase ( Mid(frase(i), 1, 1) ) & LCase ( Mid(frase(i), 2) )	next	AllFirstUp = Join (frase, " ")end functionfunction FirstUp (frase)	'Converte prima lettera di tutta la stringa in uppercase	FirstUp = ucase(left(frase,1)) & mid(frase,2)end functionfunction valore_vuoto(valore)	'Restituisce true se il campo è vuoto o null	if valore="" or isnull(valore) then		valore_vuoto=true	else		valore_vuoto=false	end ifend functionfunction determina_tipo_cliente(azienda,cf,piva)			if valore_vuoto(piva) and valore_vuoto(azienda) then				'Privato				determina_tipo_cliente="P"			elseif isnumeric(cf) or valore_vuoto(azienda)= false then				'Società				determina_tipo_cliente="S"			else				determina_tipo_cliente="D"			end ifend functionfunction calcola_ricarico(prezzo,costo)	if costo>0 then		calcola_ricarico=formatnumber((prezzo-costo)/costo*100,2)	else		calcola_ricarico="???"	end ifend functionfunction instrcount(str,serc)	c=0	for i=1 to len(str)		n=instr(i,str,serc)		if n>0 then			c=c+1			i=n		else			exit for		end if	next	instrcount=cend functionsub campiform()		'Elenca i campi del form	for each item in Request.Form	Response.write item & ": " & Request.Form(item) & "<br>"	nextend sub'----------------------------------------------------------------------function applica_iva(prezzo_senza_iva)	applica_iva=prezzo_senza_iva*(1+Application("prezzi_con_iva")/100)end function'----------------------------------------------------------------------function pulisci(str)	pulisci=str	call determina_sqlinjection(str)	pulisci=replace(pulisci,"'"," ")end function'----------------------------------------------------------------------sub reconfig()	Application("ConfigOk")= "ko"end sub'----------------------------------------------------------------------sub debug(txt)	application("debug")=application("debug")&"<br>"&formatdatetime(now(),3)&"-"&questofile&":"&txtend subsub test_rs(testo)	if (IsObject(rs)) then			if not ( rs is Nothing) then				response.write "<b>RS aperto: "&testo&"<br>"			end if		end ifend sub'----------------------------------------------------------------------sub add2log(evento,causale)		'Aggiunge evento al registro	dim numrec, chiudi_conn	'1 Icona verde	'2 Icona gialla	'3 icona rossa	'4	'5	if utente_user then evento=evento&vbcrlf&"[Iduser="&sessionIDUser&"] "&session("nominativo")	if SessionIdGuest<>"" then		if SessionIdGuest>0 then evento=evento&vbcrlf&"[IdGuest="&SessionIdGuest&"]"	end if	evento=evento&vbcrlf&"IP:"	if session("bot")<>false then		evento=evento&session("bot")	else		evento=evento&Request.ServerVariables("REMOTE_ADDR")	end if	evento=evento&vbcrlf&"File: "&questofile	if mysql_server="" then		if (IsObject(conn)) then			if ( conn is Nothing) then				Set conn = Server.CreateObject("ADODB.Connection")				conn.Open mdb			end if		end if		dim rs_log		Set rs_log = Server.CreateObject("ADODB.Recordset")		rs_log.Open "log", conn, 1, 3		rs_log.addnew		rs_log("evento")=evento		rs_log("causale")=causale		rs_log.update		rs_log.close		set rs_log=nothing		sql="INSERT INTO log SET "		sql=sql&" data=now(),"		sql=sql&" evento='"&replace(evento,"'","''")&"',"		sql=sql&" causale="&causale		'on error resume next		'response.write sql		'conn.Execute sql,numrec		If Err.Number = 0 Then		Else			'Response.write("Error Save ["&sql&"]<br> ("&Err.Description&")")		End If		on error goto 0	else		'Set conn = Server.CreateObject("ADODB.Connection")		'conn.Open "server="&mysql_server&";uid="&mysql_uid&";pwd="&mysql_pwd&";database="&mysql_database&";driver=MySQL ODBC 3.51 Driver"		on error resume next		'Set conn = Server.CreateObject("ADODB.Connection")		'conn.Open "server="&mysql_server&";uid="&mysql_uid&";pwd="&mysql_pwd&";database="&mysql_database&";driver=MySQL ODBC 3.51 Driver"		sql="INSERT INTO log SET "		sql=sql&" data=now(),"		sql=sql&" evento='"&replace(evento,"'","''")&"',"		sql=sql&" causale="&causale		conn.Execute sql,numrec		If Err.Number = 0 Then		Else			if utente_andrea then Response.write("Error Save ["&sql&"]<br> ("&Err.Description&") chiudi_conn="&chiudi_conn)		End If		'conn.Close		'set conn = Nothing	end if	'if session("iduser")=1 then	'	call visualizza_toastr(evento)	'end ifend subsub visualizza_toastr(evento)dim testo	testo=evento	testo=replace(testo,vbcrlf,"<br>")	if session("visualizza_messaggio")<>"" then session("visualizza_messaggio")=session("visualizza_messaggio")&"||"	if instr(testo,"|")=0 then testo="info|"&testo	session("visualizza_messaggio")=session("visualizza_messaggio")&testoend subfunction soloio(testo)	if session("soloio")<>"" then		soloio="[soloio]"&testo&"[/soloio]"	else		soloio=""	end ifend function'----------------------------------------------------------------------function allCookiesdim txt	For Each cookie in Request.Cookies		If request(cookie).HasKeys Then			For Each key in Request.Cookies(cookie)			  	txt=txt&cookie&"."&key &"="& request.Cookies(cookie)(key)&"|"			Next		Else			  	txt=txt&cookie&"="& request.Cookies(cookie)&"|"		End If	Next	allCookies="<b>Cookies:</b><br>"&txtend functionfunction allSession	dim txt,ii	for ii = 0 to Session.Contents.Count		txt=txt&Session.Contents.key(ii) &"="& Session.Contents.item(ii)&"|"	next	allSession=txtend function'----------------------------------------------------------------------sub logga(cosa,id)	if utente_admin then exit sub	'Skip per admin	if SessionIdGuest=0 and (  cint(Application("logBoot"))=0 )  then exit sub	'Skip per boot	logtxt=""	select case cosa	case "ric"		logtxt="Cercato parole: " & id		id=0	case "lost"		logtxt="Richiesta password: " & id		id=0	case "new"		'if request.cookies(nomesito)("idloged")="" then		'	logtxt="Cookie disabilitati"		'else			exit sub		'end if	end select	Set rsc = Server.CreateObject("ADODB.Recordset")	logsql="select * from log_action"	rsc.Open logsql, conn, 3, 3	rsc.addnew	rsc("data")=now()	rsc("idloged")=SessionIdGuest	if id="" then id=0	rsc("idpro")=id	if logtxt="" then		rsc("testo")=cosa	else		rsc("testo")=left(logtxt,50)	end if	if session("iduser")<>"" then		rsc("iduse")=session("iduser")	end if	if session("bot")<>"" then		rsc("ip")=session("bot")	else		rsc("ip")=Request.ServerVariables("REMOTE_ADDR")	end if	rsc.update	rsc.close	set rsc = Nothingend subsub login()	if request("comebackto") <> "" then		sReferer = request("comebackto")		sGoBackTo = replace( request.querystring,"comebackto=","")	end if	'Seleziono il metodo di login	sql=""	if request.form("email_login")<>"" and request.form("password_login")<>"" then 'LOGIN DA FORM		come="form"		email=trim(pulisci(Request.Form("email_login")))		password=trim(pulisci(Request.form("password_login")))		sql="select * FROM utenti WHERE email='" & email  & "'"		error="Dati per l'accesso errati."	elseif request.cookies(nomesito)("remlogin")="true" and request.cookies(nomesito)("iduser")<>"" and request.cookies(nomesito)("chk")<>"" then		'sostituire remlogin con autologin		'Trovati cookie		come="cookies"		tmpiduser=trim(pulisci(request.cookies(nomesito)("iduser")))		if isnumeric(tmpiduser) then sql="select * FROM utenti WHERE iduser=" & tmpiduser	else		response.redirect "login.asp?comebackto="&questofile	end if	if sql<>"" then		dim rs		Set rs = Server.CreateObject("ADODB.Recordset")		rs.Open sql, conn, 3, 3		lngTotalRecords=clng(conn.Execute("Select Found_Rows();")(0).Value)		login_ok=false		if lngTotalRecords = 1 then			if come="cookies" then				if chkDataUser(rs("data"))=chkDataUser(request.cookies(nomesito)("chk")) then login_ok=true			elseif come="form" then				passwordmd5=h.hash(password)				passwordmd5db=rs("password_md5")				if passwordmd5db=passwordmd5 then					login_ok=true				else					'cerco nella password di riserva					set rs_password_reset = Server.CreateObject("ADODB.Recordset")					rs_password_reset.open "select * from password_reset where iduser="&rs("iduser"),conn,3,3					if not rs_password_reset.eof then						call add2log("passwordmd5db:"&passwordmd5&" newpassword:"&rs_password_reset("newpassword"),0)						if rs_password_reset("newpassword")=passwordmd5 then							'La password secondaria coincide							login_ok=true							'metto la password secondaria nella principale							rs("password_md5")=rs_password_reset("newpassword")							'Elimino la password secondaria							rs_password_reset.delete						end if					end if					rs_password_reset.close					set rs_password_reset = nothing				end if			end if		end if		if login_ok=true then			session("cache_carrellino")=""			if rs("abilitato")=false then				error="Accesso non abilitato"			else				utente_user=true				SessionIDUser=rs("iduser")				session("iduser") = SessionIDUser				'----------------------------------------------------------------------------------------				'In errore prima di big update				set rs_i = conn.execute("select * from utenti_intestazioni where id="&rs("idintestazione"))				if not rs_i.eof then					denominazione_v=denominazione(rs_i("nome") , rs_i("cognome"),rs_i("azienda"))					nominativo_v=nominativo(rs_i("nome") , rs_i("cognome"),rs_i("azienda"))				else					call add2log("Manca intestazione per utente id:"&rs("iduser"),3)				end if				set rs_i = Nothing				'--------------------------------------------------------------------------				session("email")=rs("email")'verificare dove usata				if rs("secondario")>0 then					session("iduserDipendenti")=rs("secondario")					'Eredita i permessi dall'account principale					set rs_permessi=conn.execute("select * from utenti where iduser="&rs("secondario"))					session("vedi_prezzi")=rs_permessi("vedi_prezzi")					if rs_permessi("permessi_utente")<>"" then session("permessi_utente")=rs_permessi("permessi_utente")					set rs_permessi = nothing				else					session("iduserDipendenti")=rs("iduser")					session("vedi_prezzi")=rs("vedi_prezzi")					if rs("permessi_utente")<>"" then session("permessi_utente")=rs("permessi_utente")				end if				'--------------------------------------------------------------------------				if rs("lingua")="en" then					session("lingua")="_en"					lingua="_en"				end if				'trasferisco carrello				'errore da vedere				'--------------------------------------------------------------------------				if SessionIdGuest<>"" then 'forse meglio utilizzare il request.coockie				'--------------------------------------------------------------------------					conn.execute "UPDATE carrello SET carrello.iduser = "&session("iduser")&", carrello.idloged=Null WHERE (((carrello.idloged)="&SessionIdGuest&"));",num				end if				response.cookies(nomesito).expires = date()+10				response.cookies(nomesito)("user") = rs("iduser")				rs("lastvisit")=now()				rs("numvisit")=rs("numvisit")+1				'Cerco Admin				set rs_admin=conn.execute ("select admin.admin_l, admin.fine, admin.permessi from admin where iduser="&SessionIDUser)				utente_admin=false				if not rs_admin.eof then					if rs_admin("admin_l")>0 and isnull(rs_admin("fine")) then						utente_admin=true						session("permessi")=rs_admin("permessi")						session("admin_l")=rs_admin("admin_l")						session("nominativo")=nominativo_v						set rs_agente=conn.execute("select agenti.* from agenti where iduser="&SessionIDUser)						if not rs_agente.eof then							session("idagente")=rs_agente("idagente")							session("permessi_agente")=rs_agente("clienti_p