<%sub elenco_movimenti()	dim idvara,idvarb	if idpro="" then idpro=request("idpro")	if idmag="" then idmag=request("idmag")	if idpro<>"" then		response.write "Cerco idpro"		if instr(idpro,"|")>0 then			arr=split(idpro,"|")			idpro=arr(0)			idvara=arr(1)			idvarb=arr(2)						erase arr		end if			if idvara="" then idvara=0		if idvarb="" then idvarb=0		'Cerco idmag da idpro		sql="select idmag from magazzino where idpro="&idpro&" and idvara="&idvara&" and idvarb="&idvarb		on error resume next		set arr=conn.execute (sql)		if err.number<>0 then			Response.write sql			response.end		end if		on error goto 0		if not arr.eof then			idmag=arr(0)					end if		set arr = Nothing			elseif idmag<>"" then 		response.write "Cerco idmag"		'cerco per idmag		sql="select idpro, idvara, idvarb from magazzino where idmag="&idmag		set arr=conn.execute (sql)		if not arr.eof then			idpro=arr(0)			idvara=arr(1)			idvarb=arr(2)		else			response.write "idmag: "&idmag&" non trovato"		end if		set arr= Nothing	end if		colspan=8prodotto=falsevarianti=falseif idvara>0 or idvarb>0 then	varianti=trueend ifif idmag="" then		'sql="select prodotti.articolo, magazzino_movimenti.*, ordini.nord, ordini.nome, ordini.cognome, ordini.azienda, varianti_a.variante_a, varianti_b.variante_b, prodotti.codice FROM ((magazzino_movimenti INNER JOIN prodotti ON magazzino_movimenti.idpro = prodotti.IDpro) LEFT JOIN varianti_a ON (magazzino_movimenti.idpro = varianti_a.idpro) AND (magazzino_movimenti.IDvarA = varianti_a.IDvara)) LEFT JOIN varianti_b ON (magazzino_movimenti.idpro = varianti_b.idpro) AND (magazzino_movimenti.IDvarB = varianti_b.IDvarb) LEFT JOIN ordini on magazzino_movimenti.idord = ordini.idord "	sql="select magazzino_movimenti.*, prodotti.codice, prodotti.articolo, varianti_a.variante_a, varianti_b.variante_b, ordini.nord, ordini.nome, ordini.cognome, ordini.azienda, ordini_fornitori.nord as f_nord, ordini_fornitori.nome as f_nome, ordini_fornitori.cognome as f_cognome, ordini_fornitori.azienda as f_azienda from (((((magazzino_movimenti inner join magazzino on magazzino_movimenti.idmag= magazzino.idmag) inner join prodotti on magazzino.idpro=prodotti.idpro) left join varianti_a on magazzino.idvara = varianti_a.idvara) left join varianti_b on magazzino.idvarb = varianti_b.idvarb) left join ordini on magazzino_movimenti.idord = ordini.idord) left join ordini_fornitori on magazzino_movimenti.idfor =  ordini_fornitori.idord"	elseif idmag<>"" then	'sql="select magazzino_movimenti.*, ordini.nord, ordini.nome, ordini.cognome, ordini.azienda, varianti_a.variante_a, varianti_b.variante_b FROM (magazzino_movimenti LEFT JOIN varianti_a ON (magazzino_movimenti.idpro = varianti_a.idpro) AND (magazzino_movimenti.IDvarA = varianti_a.IDvara)) LEFT JOIN varianti_b ON (magazzino_movimenti.idpro = varianti_b.idpro) AND (magazzino_movimenti.IDvarB = varianti_b.IDvarb) LEFT JOIN ordini on magazzino_movimenti.idord = ordini.idord where idmag="&idmag	sql="select magazzino_movimenti.*, prodotti.codice, prodotti.articolo, varianti_a.variante_a, varianti_b.variante_b, ordini.nord, ordini.nome, ordini.cognome, ordini.azienda, ordini_fornitori.nord as f_nord, ordini_fornitori.nome as f_nome, ordini_fornitori.cognome as f_cognome, ordini_fornitori.azienda as f_azienda from (((((magazzino_movimenti inner join magazzino on magazzino_movimenti.idmag= magazzino.idmag) inner join prodotti on magazzino.idpro=prodotti.idpro) left join varianti_a on magazzino.idvara = varianti_a.idvara) left join varianti_b on magazzino.idvarb = varianti_b.idvarb) left join ordini on magazzino_movimenti.idord = ordini.idord) left join ordini_fornitori on magazzino_movimenti.idfor =  ordini_fornitori.idord where magazzino_movimenti.idmag="&idmag	end if'where=" where year(magazzino_movimenti.data)="&annoif idmag<>"" then	prodotto=true	colspan=colspan-2end ifif request("idord")<>"" then where=" where magazzino_movimenti.idord="&request("idord")sql=sql&wheresql=sql&" order by magazzino_movimenti.data desc"order="idlog="&request.querystring("idlog")if utente_andrea then response.write "[soloio]"& sql&"[/soloio]"call paginazione_start(sql,200,"access")'Se è prodotto singolo verifico le variantiif not objPagingRS.eof then	if prodotto then		set rs=conn.execute ("select prodotti.codice, prodotti.articolo from prodotti where idpro="&idpro)		codice=rs(0)		articolo=rs(1)		set rs = Nothing		idmag=conn.execute("select magazzino.idmag from magazzino where idpro="&idpro&" and idvara="&idvara&" and idvarb="&idvarb)(0)	end if	if varianti	then		'Varianti specificate		testo_variante="<br>Variantie "&objPagingRS("variante_a")&"/"&objPagingRS("variante_b")		end if%>        <table width="100%" border="1" cellpadding="2" cellspacing="0" class="tabella1">	        <%if prodotto then %>			<tr> 	            <td colspan="<%=colspan%>" class="ui-widget-header"><a href="#" class="menu_idpro" data-idmag="<%=idmag%>" data-idpro="<%=idpro%>" data-menu-escludi=""><%=codice%></a> <%=articolo%>	            <%= testo_variante%>			</tr>          <%end if %>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>            <%if prodotto=false then %>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Codice</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Articolo</td>            <%end if %>            <%if varianti=false then %>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Varianti</td>            <%end if %>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Quantita</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Causale</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Ordine</td>          </tr>          <%totale=0Do While iRecordsShown < iPageSize And Not objPagingRS.EOF		if objPagingRS("causale")=1 or objPagingRS("causale")=4 or objPagingRS("causale")=3 then			'verde			colore="bgcolor='#99FF99'"		else			colore="bgcolor='#FFCCCC'"		end if%>          <tr <%=colore%>>            <td style="border-bottom:1px solid;"><%=objPagingRS("data")%></td>            <%if prodotto=false then %>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><a href="#" class="menu_idpro" data-idmag="<%=objPagingRS("idmag")%>" data-menu-escludi=""><%=objPagingRS("codice")%></a></td>            <td style="border-bottom:1px solid;"><%=objPagingRS("articolo")%></td>            <%end if %>            <%if varianti=false then %>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("variante_a")%>/<%=objPagingRS("variante_b")%></td>            <%end if %>            <td nowrap style="border-bottom:1px solid;"><%=objPagingRS("quantita")%></td>            <td  class="corpobox" style="border-bottom:1px solid;"><%=causale_movimento(objPagingRS("causale"))%></td>            <td style="border-bottom:1px solid;" class="corpobox"><%if not isnull(objPagingRS("idord")) then %><a href="pag_adm_ordini.asp?idord=<%=objPagingRS("idord")%>"><%=objPagingRS("nord") &" "& denominazione(objPagingRS("nome"),objPagingRS("cognome"),objPagingRS("azienda"))%></a><%end if %><%if not isnull(objPagingRS("idfor")) then %><a href="pag_adm_ordini_fornitori.asp?idord=<%=objPagingRS("idfor")%>"><%=objPagingRS("f_nord") &" "& denominazione(objPagingRS("f_nome"),objPagingRS("f_cognome"),objPagingRS("f_azienda"))%></a><%end if %></td>          </tr>          <% 			iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	end ifcall paginazione_end(colspan,false)%></table><%end sub%>