<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()%><%'------------------------------------oper=request.form("oper")select case lcase(request("oper"))	case "new"		oper="new"	case "genera"		oper="add"	case "modifica"		oper="update"	case else		oper="list"		if request.form("modifica")<>"" then oper="edit"end selectif oper="add" or oper="update" then	'controlliend ifif oper="add" or oper="update" then	txt_error=""	idpro=request.form("idpro")	id_primo=0	id_ultimo=0	quantita=Request.Form("quantita")	seriali=Request.Form("seriali")	elenco_seriali=""	Set rs = Server.CreateObject("ADODB.Recordset")	sql="select * from numeri_seriali"	rs.Open sql, conn, 3, 3	if quantita<>"" then	'Genero per quantita		quantita=cint(quantita)		for n= 1 to quantita			rs.addnew			rs("idpro")=idpro			rs.update			id=Get_last_id("numeri_seriali")			seriale="WL"&year(date())&"-"&aggiungi_zeri( id,4)			if elenco_seriali<>"" then elenco_seriali=elenco_seriali&", "			elenco_seriali=elenco_seriali&seriale			conn.execute ("update numeri_seriali set seriale='"&seriale&"' where id="&id)			if n=1 then id_primo=id			if n=quantita then id_ultimo=id					next		txt_log=" per quantit&agrave; "		stampa_etichetta=true		oper="stampa_etichetta"	end if	if seriali<>"" then		seriali=split(seriali,vbcrlf)		n_seriali=ubound(seriali)		for n= 0 to n_seriali			seriale=trim(seriali(n))			if seriale<>"" then				n=clng(conn.execute("select count(*) from numeri_seriali where idpro="&idpro &" and seriale='"&seriale&"'")(0))				if n=0 then					rs.addnew					rs("idpro")=idpro					rs("seriale")=seriale					rs.update					if elenco_seriali<>"" then elenco_seriali=elenco_seriali&", "					elenco_seriali=elenco_seriali&seriale				else					if txt_error<>"" then txt_error=txt_error&", "					txt_error=txt_error&seriale				end if			end if			if n=0 then id_primo=Get_last_id("numeri_seriali")			if n=n_seriali then id_ultimo=Get_last_id("numeri_seriali")		next		txt_log=" per seriali esistenti "		if request.form("nuova_etichetta")<>"" then			stampa_etichetta=true			oper="stampa_etichetta"		end if	end if	rs.close	set rs=Nothing	call add2log("Generati numeri seriali "&txt_log&" da "&id_primo&" a "& id_ultimo&"("&elenco_seriali&") per articolo "&idpro,2)	conn.execute("update prodotti set richiedi_seriale=1 where idpro="&idpro)end ifif request.form("ristampa")<>"" then	id_primo=request.form("id_primo")	id_ultimo=request.form("id_ultimo")	oper="stampa_etichetta"	stampa_etichetta=true	end if'response.write oper%><!--#include virtual="/sub_head_adm.asp" -->  <%if stampa_etichetta then  copie=request.form("copie")  if copie="" then copie=1   %>   <script language="javascript" type="text/javascript">    <!--	var DATA_FOLDER = "C:\\Users\\public\\Documents\\Etichette\\";    //------------------------------------------------------------------------------    //   Function name   :   DoPrint    //   Description     :   Print, Preview Module    //------------------------------------------------------------------------------    //function DoPrint(strExport)    //{        var strPath = DATA_FOLDER + "EtichettaWL.lbx";		var result;		var objDoc = new ActiveXObject("bpac.Document");		if(objDoc.Open(strPath) != false)		{			console.log("inizio stampa");			<%			set rs=conn.execute ("select numeri_seriali.seriale, prodotti.codice, prodotti.articolo from numeri_seriali inner JOIN prodotti on numeri_seriali.idpro = prodotti.idpro where id between "&id_primo&" and "&id_ultimo)	do while not rs.EOF		%>				objDoc.GetObject("barcode").Text = "<%=rs("seriale")%>";				objDoc.GetObject("codice").Text = "<%=rs("codice")%>";				objDoc.GetObject("articolo").Text = "<%=rs("articolo")%>";								//alert("siamo qui");				//objDoc.SetMediaByName(objDoc.Printer.GetMediaName(), true);								result = objDoc.StartPrint("", 0);				//alert ("StartPrint: "+result);				objDoc.PrintOut(<%=copie%>, 0);				<%			rs.movenext			loop			set rs = nothing											%>						objDoc.Close();				objDoc.EndPrint();			console.log("fine stampa");		}		else{			alert("strPath non trovato:"+strPath);		}   // }       -->    </script>	<%end if %></head><body>  <div id="wrap">    <div id="header">      <%=titolo_top%><%barra=0%><!--#include virtual="/sub_barra_adminsf2.asp" -->      <div class="ui-widget-header ui-corner-all titolo_admin">        <a href="<%=questofile%>">Numeri di serie</a>      </div>        <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         <form name="form1" id="form" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;">		        <%    'response.write "oper:"&oper		if txt_error<>"" then		%>		<div class="ui-widget">			<div class="ui-state-error ui-corner-all" style="padding: 0 .7em;"> 				<p>					<span class="ui-icon ui-icon-alert" 						style="float: left; margin-right: .3em;"></span>					<strong>Numeri di serie già esistenti</strong> 				</p>				<p>					Questi numeri di serie esistono già: <%=txt_error%>				</p>			</div>		</div>		<%		end ifif oper="list" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class=tabella1>            <tr align="right">               <td colspan="2" style="border-bottom:1px solid;"><a href="<%=questofile%>?oper=new"><strong>Genera numeri di serie</strong></a></td>            </tr>            <tr align="center">               <td colspan="2" style="border-bottom:1px solid;">Cerca seriali</td>            </tr>            <tr>	            <td>Per numero di serie<br>		            <input type='hidden' name='cerca_seriale' id='cerca_seriale' style="width:350px;" />	            </td>	            <td>Per articolo<br>		            <input type='hidden' name='cerca_idpro' id='cerca_idpro' style="width:350px;" />	            </td>            </tr>          </table>    <%        idpro=request.querystring("idpro")	    if idpro<>"" then            set rs=conn.Execute("select prodotti.codice, prodotti.articolo from prodotti where idpro="&idpro)	            %>      <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>               <td colspan="2" style="border-bottom:1px solid;"><b><%=rs("codice")&" "&rs("articolo")%></b></td>            </tr>	      <%            set rs=conn.execute("SELECT numeri_seriali.id,numeri_seriali.seriale, ordini.idord, ordini.nord, ordini.data FROM  numeri_seriali LEFT JOIN ordini_dett on numeri_seriali.iddett = ordini_dett.iddett left join ordini ON ordini_dett.idord = ordini.idord where numeri_seriali.idpro="&idpro)                       if rs.eof then %>                       <tr>               <td colspan="2" style="border-bottom:1px solid;">Nessun numero di serie trovato</td>            </tr>                      <%		else	%>            <tr>               <td  style="border-bottom:1px solid;">Numero di serie</td>              <td style="border-bottom:1px solid;">Ordine</td>            </tr>		<%	do until rs.EOF%>            <tr id="seriale_<%=rs("id")%>">               <td nowrap style="border-bottom:1px solid;"><%=rs("seriale")%><%if IsNull(rs("nord")) then %> <a class="delete_img" >Cancella</a><%end if %></td>              <td style="border-bottom:1px solid;">	              <%	              if not isnull(rs("nord")) then%>	              	               <a href="pag_adm_ordini.asp?idord=<%=rs("idord")%>"><%=rs("nord")&"/"&year(rs("data"))%></a><a class="delete_ord" >Rimuovi da ordine</a>	               <%end if	              	              %>	 </td>            </tr>            <%	rs.movenext	loop	end if	%>      </table>      <div id="dialog-confirm" style="display:none;">	</div>	<script>	$(function() {		$(".delete_img" ).button({icons: {primary: "ui-icon-trash"},text: false});		$(".delete_ord" ).button({icons: {primary: "ui-icon-trash"},text: false});		$(".delete_img").on("click", function (e) {			var id=$(this).closest("tr").attr("id").substring(8);			console.log("id seriale:"+id);				$( "#dialog-confirm" ).html("Vuoi eliminare il seriale?");				 $( "#dialog-confirm" ).dialog({				 title:"Conferma eliminazione",			      resizable: false,			      height:140,			      modal: true,			      buttons: {			        "Si": function() {			        			       var dati = {						    id:    	id						}									$.ajax({						url     : "ajax_function.asp?oper=elimina_seriale",						type    : "post",						cache: false,						dataType: 'json',						data	: dati,						success: function(data){							console.log(data);							if (data.success==true){								$("#seriale_"+id).remove();							}else							{								toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};								toastr.error(data.message);							}																				}						,error: function(xhr, textStatus, error){							toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};							toastr.error('Errore in eliminazione seriale');																}					});																									          $( this ).dialog( "close" );			        },			        "No": function() {			          $( this ).dialog( "close" );			        }			      }			    });			});		$(".delete_ord").on("click", function (e) {			var id=$(this).closest("tr").attr("id").substring(8);			var cella=$(this).closest("td");			console.log("id seriale:"+id);				$( "#dialog-confirm" ).html("Vuoi rimuovere il seriale dall'ordine?");				 $( "#dialog-confirm" ).dialog({				 title:"Conferma eliminazione",			      resizable: false,			      height:140,			      modal: true,			      buttons: {			        "Si": function() {			        			       var dati = {						    id:    	id						}									$.ajax({						url     : "ajax_function.asp?oper=elimina_seriale_da_ordine",						type    : "post",						cache: false,						dataType: 'json',						data	: dati,						success: function(data){							console.log(data);							if (data.success==true){								//$("#seriale_"+id).remove();								cella.text("");							}else							{								toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};								toastr.error(data.message);							}																				}						,error: function(xhr, textStatus, error){							toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};							toastr.error('Errore in eliminazione seriale');																}					});																									          $( this ).dialog( "close" );			        },			        "No": function() {			          $( this ).dialog( "close" );			        }			      }			    });			});	      })	      </script>			<%	end if	%>			<% elseif oper="stampa_etichetta" then %>      <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>               <td colspan="2" style="border-bottom:1px solid;">Numeri seriali generati</td>            </tr>	      <%		set rs=conn.execute ("select numeri_seriali.seriale, prodotti.codice, prodotti.articolo from numeri_seriali inner JOIN prodotti on numeri_seriali.idpro = prodotti.idpro where id between "&id_primo&" and "&id_ultimo)           ' set rs=conn.execute("SELECT numeri_seriali.seriale where id between "&id_primo&" and "&id_ultimo)                       if rs.eof then %>                       <tr>               <td colspan="2" style="border-bottom:1px solid;">Nessun numero di serie trovato</td>            </tr>                      <%		else	%>		<%	do until rs.EOF%>            <tr>               <td colspan="2" style="border-bottom:1px solid;"><%=rs("seriale")%></td>            </tr>            <%	rs.movenext	loop	end if	%>			<tr>				<td colspan="2" align="center">				Opzioni di stampa				</td>			</tr>						<tr style="border-bottom:1px solid;" >				<td align="right">				Numero di etichette per ogni seriale				</td>              <td  align="left" width="50%"><input type="hidden" name="id_primo" value="<%=id_primo%>"><input type="hidden" name="id_ultimo" value="<%=id_ultimo%>"> <label><input type="radio" name="copie" id="copie" value="1"  <%if copie=1 then response.write "checked" %> />1</label> <label style="margin-left:20px;"><input type="radio" name="copie" id="copie" value="2" <%if copie=2 then response.write "checked" %>  />2</label> <label style="margin-left:20px;"><input type="radio" name="copie" id="copie" value="3"  <%if copie=3 then response.write "checked" %> />3</label></td>              </tr>              <tr>	              <td colspan="2" align="center">		              <input type="submit" value="Ristampa" name="ristampa" id="ristampa">	              </td>              </tr>      </table>		          <%elseif oper="new" then		  %>          <%if error<>"" then			  		descrizione=request.form("descrizione")			  	elseif oper="new" then			  		descrizione=""				end if				useragent=request.servervariables("HTTP_USER_AGENT")				IE=false								Dim regEx				Set regEx = New RegExp						regex.global = true				regex.IgnoreCase = true								regex.pattern = "MSIE ([0-9]{1,}[\.0-9]{0,})"				Set RegExResults = regEx.Execute(useragent)				If RegExResults.Count > 0 Then					Set oMatch = RegExResults(0)									  versione=cint(oMatch.SubMatches(0))				  if versione>=10 then					  IE=true				  end if				End If 								regex.pattern = "Trident/.*rv:([0-9]{1,}[\.0-9]{0,})"				Set RegExResults = regEx.Execute(useragent)				If RegExResults.Count > 0 Then					Set oMatch = RegExResults(0)									  versione=cint(oMatch.SubMatches(0))				  if versione>=10 then					  IE=true				  end if				End If 				'response.write "IE:"&IE &" versione: "&versione								'response.write request.servervariables("HTTP_USER_AGENT")	if 	(instr(useragent,"MSIE")=0 and instr(useragent,"Trident/7.0")=0) and not utente_andrea then	 %> 		<div class="ui-widget" id="errore_browser">			<div class="ui-state-error ui-corner-all" style="padding: 0 .7em;"> 				<p>					<span class="ui-icon ui-icon-alert" 						style="float: left; margin-right: .3em;"></span>					<strong>Browser non compatibile</strong> 				</p>				<p>					Per procedere con la stampa dei codici a barre &egrave; necessario utilizzare il browser Internet Explorer				</p>			</div>		</div>								 <%else    %>   			<script language="javascript" type="text/javascript">		$(document).ready(function () {			//$("#errore_template").hide();			//$("#errore_componente").hide();			//$("#tabella").hide();			var DATA_FOLDER = "C:\\Users\\public\\Documents\\Etichette\\";			//------------------------------------------------------------------------------			//   Function name   :   DoPrint			//   Description     :   Print, Preview Module			//------------------------------------------------------------------------------			//function DoPrint(strExport)			//{			var strPath = DATA_FOLDER + "EtichettaWL.lbx";			var errori=false;			var objDoc;			<% if not utente_andrea then %>						try{				objDoc= new ActiveXObject("bpac.Document");				console.log("Carico componente bpac.Document");			}			catch(e){				$("#errore_componente").show();				console.log('Il componente per la gestione della stampante non è installato');				errori=true;			}			if (objDoc!=undefined){				if(objDoc.Open(strPath) != false)					{									}				else{										$("#strpath").html(strPath);					//$("#errore_template").attr("style", "visibility: visible");					$("#errore_template").show();					console.log("Non trovo l/'etichetta a questo indirizzo:"+strPath);				errori=true;				}			}						<% end if %>			if (!errori){					console.log("Nessun errore");					$("#tabella").show();					$("#errore_template").hide();					$("#errore_componente").hide();			}						});				   // }       -->    </script>		<div class="ui-widget" id="errore_componente" style="display: none;">			<div class="ui-state-error ui-corner-all" style="padding: 0 .7em;"> 				<p>					<span class="ui-icon ui-icon-alert" 						style="float: left; margin-right: .3em;"></span>					<strong>Software non installato </strong> 				</p>				<p>					Il software per la gestione della stampante non è installato.<br>					Installare i seguenti software: 					<ul>						<li><a href="/brother/qd570w550cita.exe" download>Driver qd570w550cita.exe</a></li>						<li><a href="/brother/bcciw31004.msi" download>SDK bcciw31004.msi</a></li>					</ul>				</p>			</div>		</div>		<div class="ui-widget" id="errore_template" style="display: none;">			<div class="ui-state-error ui-corner-all" style="padding: 0 .7em;"> 				<p>					<span class="ui-icon ui-icon-alert" 						style="float: left; margin-right: .3em;"></span>					<strong>Template di stampa non trovato </strong> 				</p>				<p>					Il template di stampa non è stato trovato.<br>					Verificare la presenza di questo file: <span id="strpath"></span> <br>					Scaricare i seguenti template:					<ul>						<li><a href="/brother/EtichettaWL.lbx.zip" download >Template barcode EtichettaWL.lbx</a></li>					</ul>				</p>			</div>		</div>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1"  id="tabella" style="display: none;">            <tr>               <td colspan="2" class="ui-widget-header">Genera numeri seriali</td>            </tr>            <tr>               <td align="right" valign="top">Articolo</td>              <td>  <input type='hidden' name='idpro' id='cerca_idpro' style="width:350px;" />              </td>            </tr>            <tr>               <td align="center" colspan="2" >Inserisci o la quantità di seriali da generare o i numeri seriali esistenti</td>            </tr>            <tr>              <td align="center" valign="top">Quantità di nuovi seriali da generare<br>				<input type="text" name="quantita" id="quantita" value="1" size="2" class="chk_change"/></td>              </td>              <td align="center" valign="top">Numeri di serie esistenti da aggiungere al database<br>uno su ogni riga<br>				<textarea name="seriali" value="" id="seriali" rows="6" cols="40" class="chk_change"></textarea><br>				<input type="checkbox" name="nuova_etichetta" value="si">Ristampa etichetta per seriale esistente              </td>            </tr>			<tr>				<td colspan="2" align="center">				Opzioni di stampa				</td>			</tr>						<tr>				<td align="right">				Numero di etichette per ogni seriale				</td>				<td>				<label><input type="radio" name="copie" id="copie" value="1"  checked />1</label> <label style="margin-left:20px;"><input type="radio" name="copie" id="copie" value="2"  />2</label> <label style="margin-left:20px;"><input type="radio" name="copie" id="copie" value="3"  />3</label>				</td>			</tr>            			<tr>				<td colspan="2" align="center">					<input type="submit" name="oper" value="Genera">				</td>							</tr>          </table>                                          		<script src="js/Jqueryvalidate/jquery.validate.min.js"></script>		<script src="js/Jqueryvalidate/localization/messages_it.min.js"></script>		<script>		$(document).ready(function () {			var validator=$("#form").validate({				ignore: [], //Per select2			rules: {				idpro: {required: true},			    quantita: {			        required: function(element) {			            return $("#seriali").val()=="";			        }			    },			    seriali: {			        required: function(element) {			            return $("#quantita").val()=="";			        }			    }				},		    	        submitHandler: function(form){				form.submit();			}		});									$('.chk_change').keypress(function(e) { // text written		        svuota(this);		    });		    $('.chk_change').keyup(function(e) {	        if (e.keyCode == 8 || e.keyCode == 46) { //backspace and delete key		        svuota(this);	        } else { // rest ignore	            e.preventDefault();	        }		    });		    $('.chk_change').bind('paste', function(e) { // text pasted		        svuota(this);		    });			$('.chk_change').click(function(e){			svuota();			});			$('#quantita').click(function(e){						$(this).val("");			});		});		function svuota(obj){			console.log("cambiato"+$(obj).attr("id"));						if ($(obj).attr("id")=="quantita"){				$("#seriali").val("");			}else{				$("#quantita").val("");			}		}					     </script>                  <%	end if 'MSIEend if%><script>		$(document).ready(function () {		//Inizializzo select articolo			$('#cerca_idpro').select2({				placeholder: 'Seleziona articolo',				minimumInputLength: 0,				allowClear: true,				ajax: {					quietMillis: 150,					url: "ajax_function.asp?select2=articoli_sel2&opt=seriali",					dataType: 'json',					data: function (term, page) {						return {							term: term						};					},					results: function (data) {						return {							results: data						};					}				}			});						<%if oper="list" then %>			$('#cerca_idpro').on("select2-selecting", function(e) { 		   // what you would like to happen			   var id=e.object.id;			   console.log("Prodotto"+ id )			   if (id != null){				   location.href="<%=questofile%>?idpro="+id;			   }			});			<%end if %>			$('#cerca_seriale').select2({				placeholder: 'Inserisci numero di serie',				minimumInputLength: 1,				allowClear: true,				ajax: {					quietMillis: 150,					url: "ajax_function.asp?select2=seriali",					dataType: 'json',					data: function (term, page) {						return {							term: term						};					},					results: function (data) {						return {							results: data						};					},									}