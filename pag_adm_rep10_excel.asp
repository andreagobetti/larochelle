<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><%if session("idadmin") = "" then call login()tdebug=falsedamese=request("damese")amese=request("amese")	anno=request("anno")if not tdebug then	Response.ContentType = "application/vnd.ms-excel"else	Response.ContentType = "text/html"end ifcall add2log ("Scaricato report ordini excel:"&queryeform(),0)	if not tdebug then Response.AddHeader "content-disposition", "attachment; filename=ordini_"&nome_mese(damese)&"_"&nome_mese(amese)&"_"&anno&".xls"sql="select utenti.Azienda, utenti.Cognome, utenti.Nome, agenti.Nominativo, utenti.iduser, utenti.provincia,utenti.trattamento_iva, ordini.idord, ordini.nord,ordini.data, utenti.tipologia, ordini.Totale FROM (agenti RIGHT JOIN utenti ON agenti.IDagente = utenti.idagente) INNER JOIN ordini ON utenti.iduser = ordini.iduser "sql=sql & "where month(ordini.data)>="&damese &" and month(ordini.data)<="&amese &" and year(ordini.data)="&annofiltro_iva=request("iva")colspan=7'Selezione IVAif filtro_iva="1" then	sql=sql& " and (trattamento_iva_ordine=2 or trattamento_iva_ordine=10)"elseif filtro_iva="2" then	sql=sql& " and trattamento_iva_ordine<>2 and trattamento_iva_ordine<>10"elseif filtro_iva="-1" then	separa_iva=true	colspan=colspan+2end ifif request("tipologia")<>"" then sql=sql& " and instr(tipologia,',"&request("tipologia")&",')>0"'Selezione PROVINCIAprovincia=request("provincia")if provincia="raggruppa" then	raggruppa="provincia"	ordine=" order by utenti.provincia, idord"elseif provincia<>"" then	sql=sql& " and utenti.provincia='"&request("provincia")&"'"	ordine=" order by idord"else	ordine=" order by idord"end if'Selezione AGENTEagente=request("agente")if agente="-1" then	colspan=colspan+1	mostra_agente=trueelseif agente<>"" then	colspan=colspan+1	mostra_agente=true	sql=sql& " and utenti.idagente="&agente&""	'response.write "filtro agenet"end ifrs.Open sql&ordine, conn, 3, 3%>        <table width="100%" border="1" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="<%=colspan%>" class="ui-widget-header">ordini dal mese di <%=nome_mese(damese)%>&nbsp;al mese di <%=nome_mese(amese)%>&nbsp;<%=anno%>: <%=rs.recordcount%> elementi</td>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Ordine.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">ID Cli.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Nominativo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Tot. fattura</td>			<%if separa_iva then%>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">IVA ad esigibilit&agrave; o Vs. carico</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Escluso IVA ad esigibilit&agrave; o Vs. carico</td>			<%end if%>			<%if mostra_agente then%>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Agente</td><%end if%>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;"></td>          </tr>          <%Totale=0provincia="0"Do While Not rs.EOF	totale_ordine=cdbl(rs("totale"))	totale=totale+totale_ordine         if raggruppa_coda and provincia<>ucase(rs("provincia")) then%>                        <tr>                        <td colspan="5"><b>Totali provincia</b></td>            <td  align="right"><strong><%=formatnumber(totale_provincia,2)%></strong></td>			<%if separa_iva then%>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva2,2)%></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva,2)%></td>			<%end if%>                        <td colspan="<%=colspan-6%>"></td>          </tr>          <%	totale_provincia=0	raggruppa_coda=false	totale_iva2=0	totale_iva=0		  end if		  	totale_provincia=totale_provincia+totale_ordineif raggruppa<>"" and provincia<>ucase(rs("provincia")) then%> <tr>             <td bgcolor="#E5E5E5" colspan="<%=colspan%>" ><b>Provincia di <%=rs("provincia")%></b></td>          </tr><%	provincia=ucase(rs("provincia"))	raggruppa_coda=trueend if%>          <tr>            <td style="border-bottom:1px solid;"><input name="" type="checkbox" value=""></td>             <td style="border-bottom:1px solid;"><%=rs("Nord")%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=formatDateTime(rs("data"), vbShortDate)%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=rs("iduser")%></td>            <td nowrap style="border-bottom:1px solid;"><%=rs("azienda")%></td>            <td align="right" class="corpobox" style="border-bottom:1px solid;"><%=formatnumber(totale_ordine,2)%></td>			<%if separa_iva then			iva_tipo_2_10=false			%>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%if rs("trattamento_iva")=2 or rs("trattamento_iva")=10 then			totale_iva2=totale_iva2+totale_ordine			iva_tipo_2_10=true			%><%=formatnumber(totale_ordine,2)%><%end if%></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%if iva_tipo_2_10=false then			totale_iva=totale_iva+totale_ordine			%><%=formatnumber(totale_ordine,2)%><%end if%></td>			<%end if%>			<%if mostra_agente then%>            <td style="border-bottom:1px solid;" class="corpobox"><%=rs("nominativo")%></td>			<%end if%>            <td style="border-bottom:1px solid;" class="corpobox"></td>          </tr><% 		rs.MoveNextLoop         if raggruppa_coda then%>                        <tr>                        <td colspan="5"><b>Totali provincia</b></td>            <td  align="right"><strong><%=formatnumber(totale_provincia,2)%></strong></td>			<%if separa_iva then%>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva2,2)%></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva,2)%></td>			<%end if%>                        <td colspan="<%=colspan-6%>"></td>          </tr>          <%	totale_provincia=0	raggruppa_coda=false	totale_iva2=0	totale_iva=0		  end if%>		<%if separa_iva then%>		 <tr>		<td colspan="<%=colspan-3%>">Totali iva:</td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva2,2)%></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatnumber(totale_iva,2)%></td>            <td ></td>                     </tr>					<%end if%>            		              <tr>            <td colspan="<%=colspan%>" align="right"><strong>Totale ordini: <%=formatnumber(totale,2)%></strong></td>          </tr>              </table>              <%if request.querystring("idlog")<>"" then%> <a href="<%=Request.ServerVariables("Script_Name")%>"><b>Visualizza               tutti</b></a> <%end if%> </td>          </tr><%	call rsclose()	%>