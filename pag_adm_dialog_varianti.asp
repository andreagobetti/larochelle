<!--#include virtual="/setup.asp" -->        <form name="form1" id="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;">		        <%sql="select * from varianti  "%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">              <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Inserisci&nbsp;</td>              <td nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">Descrizione</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Voci</td>            </tr>            <%	sql= sql & "ORDER BY descrizione;"	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="button" class="inserisci" value="Aggiungi" data-id="<%=rs("id")%>" data-elenco="<%=replace(rs("elenco"),vbcrlf,"|")%>" >               </td>              <td nowrap style="border-bottom:1px solid;"><%=rs("descrizione")%></td>              <td style="border-bottom:1px solid;"><%=rs("elenco")%></td>            </tr>            <%	rs.movenext	loop	%>          </table>                    <script>	          $(function() {			  	$(".inserisci").click(function(e){				  	e.preventDefault();				  	var id=$(this).attr("data-id");				  	var elenco=$(this).attr("data-elenco");				  	console.log("id:"+id);				  			          aggiungi_righe_varianti(id,elenco);			  	});			  				  				  	})	          	          	          	          </script>        