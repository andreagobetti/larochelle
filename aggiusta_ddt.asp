<!--#include virtual="/setup.asp" --><!--#include file="jsonObject.class.asp"--><!--#include virtual="/ClasseOrdine.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><%sql="SELECT idord, nord, arrotondamento, tipo_documento,totale_merce_ordine  FROM `ordini` WHERE `tipo_documento`= 'ddt' and totale_merce_ordine=0"set rsp=conn.execute(sql)do while not rsp.eof	response.write "Processo idord:"&rsp("idord")& "tipo: "&rsp("tipo_documento")&" nord:"&rsp("nord")&"<br>"	'conn.execute("update ordini set arrotondamento=0 where idord="&rsp("idord"))	set ordine= (new ClasseOrdine)(array("apri","ordini",rsp("idord")))	if rsp("tipo_documento")="ordine" then			n=ordine.CalcolaTotaleMerce(false)	else		n=ordine.calcolo_totale_merce_ddt(rsp("idord"))	end if	rsp.movenext	set ordine = nothingloop	%>