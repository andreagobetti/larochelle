<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()%><%		if request.querystring("ordina")<>"" then	array_=Request.QueryString	'add2log array_,1	array_=replace(array_,"null","0")	'add2log "inizio ordina categoria",1	'response.write array_	array_=split(array_,"&")	For i = LBound(array_)+1 TO UBound(array_)		idmen=mid(array_(i),4,instr(array_(i),"]")-4)		idpadre=mid(array_(i),instr(array_(i),"=")+1,len(array_(i)))		'add2log "idpadre"&idpadre&"idmen"&idmen&"ordine"&i,2			   sql_update = "UPDATE marca_modello SET idpadre = " & idpadre &" WHERE id = " & idmen	   'Response.Write(sql_update&"<br>")	   'execute this bitch	   'add2log "sql_update: "&sql_update,1	   conn.Execute sql_update	   'add2log "aggiornato idmen"&idmen,1	   'below used for debugging - comment out	   	'Response.Write(sql_update&"<br>")	Next	call imposta_modello()	response.write i &" voci menu aggiornate"	add2log "Modificata gerarchia marca e modello [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2	response.endend ifoper=request.form("oper")if request.form("elimina")<>"" then		rs.Open "select * FROM marca_modello WHERE id=" & request.form("id")  , conn, 3,2		add2log "Eliminato [marca_modello="&rs("id")&"]"&rs("nome")&"[/nome] eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",3		rs.delete		rs.close		response.redirect questofileend ifselect case lcase(request("oper"))	case "","annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case "riordina_az"		call riordina_az(0,0)		oper="view"	case "edit"		oper="edit"		id=request("id")	case else		oper="view"end selectif oper="add" or oper="update" then	if request.form("nome")="" then		error="Inserire il nome della nome"		oper="edit"	end ifend ifif oper="add" or oper="update" then	idpadre=request.form("idpadre")	if idpadre="" then idpadre=0	sql="select * from marca_modello"	Set rs = Server.CreateObject("ADODB.Recordset")	if oper="add" then		rs.Open sql, conn, 3, 3		rs.addnew		session("tmp_marca_idpadre")=idpadre	else		sql= sql & " where id=" & request.form("id")		rs.Open sql, conn, 3, 3	end if	rs("nome")=request.form("nome")	rs("idnonno")=0	rs("nomeconmarca")=""	rs("idpadre")=idpadre	rs.update	if oper="add" then		txt= "Aggiunto"	else		txt= "Modifica"	end if	add2log txt&" [marca_modello="&rs("id")&"]"&rs("nome")&"[/nome] eseguita da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2	rs.close	call imposta_modello()	set rs = nothing	oper="view"end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!-- Stile: <%=Application("skins")%> --><!--#include virtual="/sub_head.asp" --><%if oper="view" then%><script src="Jquery/js/jquery.mjs.nestedSortable.js"></script>	<style type="text/css">		.placeholder {			outline: 1px dashed #4183C4;			/*-webkit-border-radius: 3px;			-moz-border-radius: 3px;			border-radius: 3px;			margin: -1px;*/			width:300px;		}		.mjs-nestedSortable-error {			background: #fbe3e4;			border-color: transparent;		}		ol {			margin: 0;			padding: 0;			padding-left: 30px;		}		ol.sortable, ol.sortable ol {			margin: 0 0 0 75px; /*spostamento*/			padding: 0;			list-style-type: none;		}		ol.sortable {			margin: 1em 0;		}		.sortable li {			margin: 5px 0 0 0;			padding: 0;		}		.sortable li div  {			width:350px;			border: 1px solid #d4d4d4;			-webkit-border-radius: 3px;			-moz-border-radius: 3px;			border-radius: 3px;			border-color: #D4D4D4 #D4D4D4 #BCBCBC;			padding: 6px;			margin: 0;			cursor: move;			background: #f6f6f6;			background: -moz-linear-gradient(top,  #ffffff 0%, #f6f6f6 47%, #ededed 100%);			background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#ffffff), color-stop(47%,#f6f6f6), color-stop(100%,#ededed));			background: -webkit-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: -o-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: -ms-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: linear-gradient(to bottom,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ffffff', endColorstr='#ededed',GradientType=0 );		}		.sortable li.mjs-nestedSortable-branch div {			background: -moz-linear-gradient(top,  #ffffff 0%, #f6f6f6 47%, #f0ece9 100%);			background: -webkit-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#f0ece9 100%);		}		.sortable li.mjs-nestedSortable-leaf div {			background: -moz-linear-gradient(top,  #ffffff 0%, #f6f6f6 47%, #bcccbc 100%);			background: -webkit-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#bcccbc 100%);		}		li.mjs-nestedSortable-collapsed.mjs-nestedSortable-hovering div {			border-color: #999;			background: #fafafa;		}		.disclose {			cursor: pointer;			width: 10px;			display: none;		}		.sortable li.mjs-nestedSortable-collapsed > ol {			display: none;		}		.sortable li.mjs-nestedSortable-branch > div > .disclose {			display: inline-block;		}		.sortable li.mjs-nestedSortable-collapsed > div > .disclose > span:before {			content: '+  ';			font-weight:bold;			font-size:130%;		}		.testo  {			padding-left:5px;		}		.sortable li.mjs-nestedSortable-expanded > div > .disclose > span:before {			content: '-  ';			font-weight:bold;			font-size:150%;		}	</style>	<script>	$(document).ready(function(){		$('ol.sortable').nestedSortable({			forcePlaceholderSize: true,			handle: 'div',			helper:	'clone',			items: 'li',			opacity: .6,			placeholder: 'placeholder',		//	revert: 250,			tabSize: 25,			tolerance: 'pointer',			toleranceElement: '> div',		//	maxLevels: 3,			isTree: true,			expandOnHover: 700,			startCollapsed: true,			            update: function () {				var ordine = $('ol.sortable').nestedSortable('serialize'); 				//alert(ordine);				$("#info").load("<%=questofile%>?ordina=si&"+ordine);				toastr.options = {"positionClass": "toast-bottom-right"};				toastr.success("Posizioni aggiornate");		    }														});		$('.disclose').on('click', function() {			$(this).closest('li').toggleClass('mjs-nestedSortable-collapsed').toggleClass('mjs-nestedSortable-expanded');		})		$('#espandi').on('click', function() {			$(".mjs-nestedSortable-collapsed").toggleClass('mjs-nestedSortable-collapsed').addClass('mjs-nestedSortable-expanded');		})		$('#comprimi').on('click', function() {			$(".mjs-nestedSortable-expanded").toggleClass('mjs-nestedSortable-expanded').addClass('mjs-nestedSortable-collapsed');		})				$("#ordina").click(function() { 			var ordine = $('ol.sortable').nestedSortable('serialize'); 			//alert(ordine);			$("#info").load("<%=questofile%>?ordina=si&"+ordine); 		});		$('#serialize').click(function(){			serialized = $('ol.sortable').nestedSortable('serialize');						$('#serializeOutput').text(serialized+'\n\n');		})		$('#toHierarchy').click(function(e){			hiered = $('ol.sortable').nestedSortable('toHierarchy', {startDepthCount: 0});			hiered = dump(hiered);			(typeof($('#toHierarchyOutput')[0].textContent) != 'undefined') ?			$('#toHierarchyOutput')[0].textContent = hiered : $('#toHierarchyOutput')[0].innerText = hiered;		})		$('#toArray').click(function(e){			arraied = $('ol.sortable').nestedSortable('toArray', {startDepthCount: 0});			arraied = dump(arraied);			(typeof($('#toArrayOutput')[0].textContent) != 'undefined') ?			$('#toArrayOutput')[0].textContent = arraied : $('#toArrayOutput')[0].innerText = arraied;		})	});	function dump(arr,level) {		var dumped_text = "";		if(!level) level = 0;		//The padding given at the beginning of the line.		var level_padding = "";		for(var j=0;j<level+1;j++) level_padding += "    ";		if(typeof(arr) == 'object') { //Array/Hashes/Objects			for(var item in arr) {				var value = arr[item];				if(typeof(value) == 'object') { //If it is an array,					dumped_text += level_padding + "'" + item + "' ...\n";					dumped_text += dump(value,level+1);				} else {					dumped_text += level_padding + "'" + item + "' => \"" + value + "\"\n";				}			}		} else { //Strings/Chars/Numbers etc.			dumped_text = "===>"+arr+"<===("+typeof(arr)+")";		}		return dumped_text;	}</script><%end if%><%if oper<>"view" then%>	<script>	$(function() {		$( "input" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });		$( "select" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });		$( "textarea" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });	});		</script>    	<style>	label {		display: inline-block;		width: 5em;	}	</style>    <script Language="JavaScript"> 	annulla=false;	function Validator(theForm) 	{	if (annulla==true)  { 		return(true);    	  } 		  if (theForm.nome.value == "")  { 		alert("Specificare un nome.");		theForm.nome.focus();		return (false); 	}	return (true); 	} </script><%end if%></head><body> <div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa"> <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Selezione marca e modello</a></div></div>        <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         <%if oper="view" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>              <td style="border-bottom:1px solid;" ><button id="espandi" >Espandi tutto</button><button id="comprimi" >Comprimi tutto</button><span style="float:right;">                <input type="button"  value="Nuovo" style="FONT: 12px;" onclick="window.location.href='<%=questofile%>?oper=new'"></span><div id="info"></div></td>            </tr>            <tr>              <td style="border-bottom:1px solid;" >		        <ol class="sortable"><%	call mappacat(0,0,"","")%></ol>	  			  </td>            </tr>          </table>          <%else          sql="select * from marca_modello where (((marca_modello.id)=" & id & "));"	if oper="edit" then		set rs=conn.execute(sql)		testo= "Modifica elemento"	else		testo= "Nuova elemento"	end if%>		<form name='form1' method='post' action="<%=questofile%>" style="margin-top:0px;" <%if oper<>"view" then%> onSubmit="return Validator(this)"<%end if%>>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" valign="top" class="ui-widget-header"><%=testo%></td>            </tr>            <tr>               <td valign="top">Nome</td>              <td> <input type="hidden" name="id" value="<%=id%>">                 <%if error<>"" then			  		testo=request.form("testo")				elseif oper="edit" then					testo=rs("nome")			  	elseif oper="new" then			  		testo=""				end if%> <input name="nome" type="text" class="richiesto" title="Nome, campo obbligatorio" value="<%=testo%>" size="40">               </td>            </tr>            <tr>               <td valign="top">Posizione</td>              <td>                <%  where=""  if oper="edit" then	val=rs("idpadre")else	if request.form("nome")<>"" then		val=cint(request.form("idpadre"))	else		val=cint(session("tmp_marca_idpadre"))	end ifend if%>                <select name="idpadre" class="richiesto">				<option value="0" <%if val=0 then response.Write(" selected")%>>Principale</option>"              <%				call mappacatselezione(0,0,val,id)				%></select> </td>            </tr>            <%			if oper="edit" then			cancellabile=true		sql="select Count(*) AS num FROM marca_modello where idpadre="& id &";"		num=clng(conn.execute(sql)(0))		if num>0 then			cancellabile=false			testo=testo&"Non è possibile eliminare questa nome perchè contiene <b>"&num&"</b> sottomarca_modello."		end if		if cancellabile=false then			%>            <tr>              <td colspan="2" align="center" valign="top"><%=testo%></td>            </tr>            <%end if			end if%>            <tr>              <td colspan="2" align="center" valign="top"><%if oper="view" then	txt=puls_newelseif oper="new" or error<>"" then	txt="Aggiungi"elseif oper="edit" then	txt="Modifica"end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Annulla" onClick="annulla=true;">    <%end if%>    <%if oper="edit" and cancellabile=true and error="" then%>    <input type="submit" name="elimina" value="Elimina">    <%end if%></td>            </tr>          </table></form>         <%end if	set rs = nothing%>        <!-- Colonna CORPO FINE-->      </div>    <div id="footer"></div>    <%	    call connclose()	    %><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%sub mappacat(layer,id,testo,testo_dopo)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id		sql_order="select marca_modello.Id, marca_modello.Nome, marca_modello.idpadre, Count(marca_modello_1.id) AS ConteggioDiid FROM marca_modello LEFT JOIN marca_modello AS marca_modello_1 ON marca_modello.Id = marca_modello_1.IdPadre GROUP BY marca_modello.Id, marca_modello.Nome, marca_modello.idpadre  HAVING (((marca_modello.idpadre)=" & id & ")) ORDER BY marca_modello.nome"	rs_order.open sql_order,conn	nodo=true	testo=testo&testo_dopo	testo_dopo=""	if not 	rs_order.eof then 		if layer>0 then testo=testo& "<ol>"	else		nodo=false	end if	do until rs_order.eof		'if rs_order("conteggiodiidpro")=0 and rs_order("ConteggioDiid")=0 then classe="" else classe=""				testo=testo&  "<li id=""id_"&rs_order("id")&""""&">"		testo_dopo="<div style="""&classe&"""><span class=""disclose""><span></span></span><span class=""testo"">"&rs_order("nome")&"</span><span style=""float:right; text-align:right;"">"		testo_dopo=testo_dopo&"<button style=""font-size:9px;"" onclick=""window.location.href='"&questofile&"?oper=edit&id="&rs_order("id")&"'"">Modifica</button>"		'if rs_order("conteggiodiidpro")>0 then testo_dopo=testo_dopo&"<br><button style=""font-size:9px;"" onclick=""window.location.href='pag_adm_artic.asp?oper=view&id="&rs_order("id")&"'"">Vedi articoli</button>"		testo_dopo=testo_dopo&"</span><br>&nbsp;&nbsp;"&"0"&" articoli"		testo_dopo=testo_dopo&"</span><br>&nbsp;&nbsp;"		if clng(rs_order("conteggiodiid"))>0 then testo_dopo=testo_dopo&" - "&rs_order("conteggiodiid")&" sottospecie"		testo_dopo=testo_dopo&"</div>"		'calling again to find more childs - if not rs_order=nothing	    call mappacat(layer+1,rs_order("id"),testo,testo_dopo)	'testo=testo& "</li>"&vbcrlf		rs_order.movenext	loop	if nodo=true and layer>0 then testo=testo& "</ol>"&vbcrlf	'closing object	rs_order.close	set rs_order=nothing	if layer=0 then response.write testoEnd Sub	sub mappacatselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM marca_modello WHERE idpadre = " & id &" and id<>"&escludi&" order by nome;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("id") &""""		if int(val)=int(rs_order("id")) then response.write " selected"		response.write ">" &spaceing& rs_order("nome")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappacatselezione(layer+1,rs_order("id"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	sub imposta_modello()	dim rs_marca_modello	set rs_marca_modello=server.createObject("adodb.recordset")	rs_marca_modello.open "select marca_modello.* from marca_modello " ,conn,1,3	do while not rs_marca_modello.EOF		set rs_ricerca=conn.execute ("select marca_modello.* from marca_modello where idpadre="&rs_marca_modello("id"))		rs_marca_modello("modello")=rs_ricerca.eof		if rs_marca_modello("idpadre")>0 then			str=cerca_nonno(rs_marca_modello("idpadre"),str)			'response.write str&"<br>"			str=split(str,"|")			rs_marca_modello("idnonno")=str(0)			rs_marca_modello("nomeconmarca")=str(1)&" "&rs_marca_modello("nome")		else			rs_marca_modello("idnonno")=0			rs_marca_modello("nomeconmarca")=""		end if		rs_marca_modello.Update 		rs_marca_modello.MoveNext	loopend sub		function cerca_nonno(id,tmp)	dim rs_modello	set rs_modello=conn.execute ("select * FROM marca_modello WHERE id = " & id&";")			if not rs_modello.eof then		tmp=cerca_nonno(rs_modello("idpadre"),rs_modello("id")&"|"&rs_modello("nome"))	end if	cerca_nonno=tmp	set rs_modello=nothingEnd function%>