<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()iduser=request("iduser")' AggiornaIF Request( "aggiorna" ) <> "" THEN	sql = "select idcar, quantita FROM carrello WHERE iduser=" & iduser	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 3, 3	WHILE NOT RS.EOF	newQ = TRIM( Request( "quantita" & RS( "idcar" ) ) )	IF newQ = "" OR newQ = "0" or TRIM(Request("elimina"&RS( "idcar")))="SI" THEN	  RS.Delete	ELSE	  IF isNumeric( newQ ) THEN		RS("quantita") = newQ		rs.update	  END IF	END IF	RS.MoveNext	WEND	RS.Close	session("nelcarrello")=""END IF' SvuotaIF Request("svuota") <> "" THEN	sql = "delete FROM carrello WHERE iduser=" & iduser	conn.execute(sql)END IF%><!--#include virtual="/regioni_inc.asp" --><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application(appURL&"brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!-- Stile: <%=Application(appURL&"skins")%> --><!--#include virtual="/sub_head.asp" --></head><body> <div id="wrap"><div id="header"><%=application(appURL&"top")%> <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Carrello utente</a></div><% 		sql="select * FROM utenti where iduser="&iduserset rs=conn.execute(sql)if rs.eof then fase="due"%>         <table width="100%" border="1" cellpadding="0" cellspacing="0" bordercolor="#E5E5E5" class="tabella1">      <tr>        <td colspan="3" class="ui-widget-header">Dati cliente<input name="idord" type="hidden" value="<%=idord%>"></td>      </tr>       <tr>        <td align="left" bgcolor="#E5E5E5">Azienda/Indirizzo/Cap Citt&agrave;/Regione</td>                     <td bgcolor="#E5E5E5">Nominativo/Email/Telefoni</td>      </tr> <tr >        <td width="33%" style="border-bottom:1px solid;"><b><%=rs("azienda")%></b><br>          <%=rs("Indirizzo")%> <br><%=rs("cap")%> - <%=rs("citta")%> (<%=rs("provincia") & ")<br>" & regione(rs("regione"))%><br>Partita Iva: <%=rs("piva")%><br>Codice Fiscale: <%=rs("cf")%></td>                  <td width="33%" style="border-bottom:1px solid;"><b><%=rs("cognome")%>&nbsp;<%=rs("nome")%></b><br>          <a href='mailto:<%=rs("email")%>'><%=rs("email")%></a><br>Telefono: <%=rs("telefono")%><br>Fax: <%=rs("fax")%><br>Cellulare: <%=rs("cellulare")%></td>      </tr>    </table>    <%rs.closesql="select * FROM carrello_esteso where iduser="&iduserrs.Open sql, conn, 3, 3set rs=conn.execute(sql)if rs.eof then fase="due"%>                      	    <%if fase="" then%>      <form name="form1" method="post" action="<%=questofile%>"> <input name="iduser" type="hidden" value="<%=iduser%>">        <table width="100%" border="1" cellpadding="0" cellspacing="0" bordercolor="#E5E5E5" class="tabella1">           <tr>             <td colspan="6" class="ui-widget-header">Il  carrello cliente contiene:</td>           </tr>           <tr>             <td style="border-bottom: 1px solid gray; background: #E5E5E5; font-size:11px;" class=testotabella><b>Codice</b></td>             <td style="border-bottom: 1px solid gray; background: #E5E5E5; font-size:11px;" class=testotabella><b>Articolo</b></td>             <td align="center" class=testotabella style="border-bottom: 1px solid gray; background: #E5E5E5; font-size:11px;"><b>Prezzo<br>               unitario</b></td>             <td align="center" style="border-bottom: 1px solid gray; background: #E5E5E5; font-size:11px;" class=testotabella><b>Quantit&agrave;</b></td>             <td align="center" style="border-bottom: 1px solid gray; background: #E5E5E5; font-size:11px;" class=testotabella><b>Prezzo<br>               totale</b></td>             <td align="center" style="border-bottom: 1px solid gray; background: #E5E5E5; font-size:11px;" class=testotabella><b>Elimina</b></td>           </tr>           <%do while not rs.eof			%>           <tr valign="middle">             <td align="center" style="border-bottom: 1px solid gray;">              <b><a href="dettaglio.asp?idpro=<%=RS("idpro")%>" title="Clicca per la scheda prodotto" ><%=RS("codice")%></a></b> </td>             <td style="border-bottom: 1px solid gray;"><%=rs("articolo")%><br>            <%					txt=""					if rs("idvara")<>""  and rs("idvara")<>0 then						txt ="&nbsp;" & rs("variante1") & ": " & rs("var1") &  rs("variante_a")					end if					if rs("idvarb")<>"" and rs("idvarb")<>0 then						txt =txt & "&nbsp;" & rs("variante2") & ": " & rs("var2") &  rs("variante_b")					end if					response.write txt			  %></td>             <td align="right" style="border-bottom: 1px solid gray;"> <%                promozione=false				if RS("promozione")=True and (RS("prodata")>date() or isnull(RS("prodata"))) then promozione=true																if promozione then					prezzoeff=RS("prezzo")*(1-RS("sconto")/100)					txtprezzo="<s>"&prezzole(RS("prezzo"))&"</s><br><b>" & prezzole(prezzoeff)&"</b>"				else					prezzoeff=RS("prezzo")					txtprezzo=prezzole(prezzoeff)				end if            	response.write txtprezzo				%> </td>             <td align="center" valign="middle" style="border-bottom: 1px solid gray;"><%=rs("um")%><br>               <input type="text" name="quantita<%=rs("idcar")%>" size="4" value="<%=rs("quantita")%>"> </td>             <td align="right" valign="middle" nowrap style="border-bottom: 1px solid gray;"> <%response.write prezzole(prezzoeff*rs("quantita"))%> </td>             <td align="center" valign="middle" style="border-bottom: 1px solid gray;"> <input type="checkbox" name="elimina<%=rs("idcar")%>" value="SI"> </td>           </tr>           <%            totord=totord+(prezzoeff*rs("quantita"))            rs.movenext			loop%>           <tr valign="middle" align="right" >             <td colspan="6" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;"><b>Totale IVA esclusa: <%=prezzole(totord)%></b></td>           </tr>           <tr align="center">             <td colspan="6"> <input type="submit" name="aggiorna" value="Aggiorna il carrello">               <input type="submit" name="Svuota" value="Svuota il carrello" onClick="return confirm('Conferma eliminazione ?');"></td>           </tr>         </table>	    </form> 	     <%else%>           <table border="0" cellpadding="2" cellspacing="0" width="100%"  class="tabella1">           <tr valign="middle">             <td class="ui-widget-header">Carrello</td>           </tr>           <tr valign="middle">             <td align="center" valign="middle"><br> <b>Il carrello non contiene prodotti.</b><br><br> </td>           </tr>         </table>                                          <%end if           Set rs = Nothing           call connclose()           %>     <!-- Colonna CORPO FINE-->   </div>        <div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div>  </body></html><%rsClose%>