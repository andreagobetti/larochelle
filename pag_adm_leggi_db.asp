<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><%if session("idadmin") = "" then call login()width=400 'Larghezza input boxidpro=request("idpro")if request("idprod")<>"" then	idpro=request("idprod")end ifidprod=idpro%><%oper="view"%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><link rel="stylesheet" type="text/css" href="Jquery/css/select2.css"/></head><body> <div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa"> <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">magazzino articoli</a></div></div>        <!-- Colonna CORPO INIZIO-->          <%if oper="view" thenordine=request.form("ordine")cercain=request.form("cercain")cerca=request.form("cerca")	if idpro<>"" then		sql="select prodotti.IDpro, prodotti.codice, prodotti.articolo, prodotti.prezzo, magazzino.*, varianti_a.variante_a, varianti_b.variante_b FROM ((magazzino RIGHT JOIN prodotti ON magazzino.idpro = prodotti.IDpro) LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara) LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb "		singolo=true		if instr(sql,"where")>0 then sql=sql&" and " else sql=sql&" where "		sql=sql & " magazzino.idpro=" & idpro		elenca=true	end ifif ordine="ultimo" then elseif ordine="" then	'ordine iniziale perdefinito 	sql= sql & " order by codice,variante_a,variante_b"else	sql= sql & " order by " & ordine end iffunction fullcat(id,tmp)	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	sql_order = "select * FROM settori WHERE idsettore = " & id	rs_order.open sql_order,conn	if not rs_order.eof then			str=tmp&"&lt;"&rs_order("nome_settore") 		tmp=fullcat(rs_order("idpadre"),str)	else	tmp=mid(tmp,5)	end if	fullcat=tmp	rs_order.close	set rs_order=nothingEnd functioniPageSize=grec4pageorder = "&cat="&cat&"&cercain="&cercain&"&cerca="&cercaif Request.QueryString("page")="" then	page = session("page")else	page=Request.QueryString("page")	session("page")=pageend if		%><form id="form1" method="post" action="<%=questofile%>" style="margin-top: 0px;">	<input type="hidden" name="singolo" value="<%=singolo%>">	<div class="div_testo">			<input type='hidden' name='idsettore' id='idsettore' style="min-width:300px;" value="<%=idsettore%>"/>			<input type='hidden' name='idfornitore' id='idfornitore' value="<%=idfornitore%>"/>			<input type='hidden' name='idprod' id='idprod' value="<%=idprod%>"/>                                         <input type="submit" name="Sottoscorta" value="sottoscorta" /><input type="button" value="Nascondi/Mostra materiali acquisto" id="nascondi_db_acq"/></div><div class="div_spaziatore"></div>            <% if elenca then'response.write sqlset rs=conn.execute(sql)                                    %>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1" id="tabella">            <thead>            <tr bgcolor="#E5E5E5" >               <td  style="border-bottom: 1px solid;">&nbsp;Codice</td>              <td align="center" style="border-bottom: 1px solid;">Articolo</td>              <td align="center" style="border-bottom: 1px solid;">Prezzo</td>              <td  style="border-bottom: 1px solid;">Variante</td>              <td align="center" style="border-bottom: 1px solid;">Variante</td>              <td align="center" style="border-bottom: 1px solid;">Quantit&agrave;</td>            <td align="center" style="border-bottom: 1px solid;">Aggiornato</td>              <td align="center" style="border-bottom: 1px solid;">Riordino</td>            </tr>            </thead>            <tbody>            <%			stringa_idmag=""		iRecordsShown = 0		dentro_db=false		livello=0		Do While Not RS.EOF		call rigamagazzino(rs("idmag"),rs("quantita_magazzino"),rs("quantita_riordino"),rs("idpro"),rs("codice"),rs("articolo"),rs("prezzo"),rs("variante_a"),rs("variante_b"),rs("data_aggiornamento"),rs("db_ven"),rs("db_acq"),rs("idvara"),rs("idvarb"))					RS.MoveNext		singolo=false	Loop	set rs=Nothing	%></tbody>    <tfoot>            </tr>                <tr align="right">              <td colspan="8"><input type="button" value="Aggiorna" id="aggiorna" disabled="disabled"/><input type="hidden" name="aggiorna" id="aggiorna_hidden" /><input type="hidden" name="stringa_idmag" value="<%=stringa_idmag%>" /></td>            </tr>            	    <tr align="center">                          <td colspan="8">	              Articolo presente in db<input type="text"  size="4"  style='background:yellow;' disabled/> &nbsp; Articolo con db, quantità calcolata <input type="text"  size="4"  style='background:gray;' disabled/>              </td></tfoot></table>        <script type="text/javascript" src="Jquery/js/DataTables/jquery.dataTables.min.js"></script>		<script type="text/javascript" charset="utf-8">			$(document).ready(function() {				var tabella=$('.datatabel').dataTable( {    "bPaginate": false,"bSort": false,"oLanguage": {                "sUrl": "Jquery/js/DataTables/italiano.txt"            }  });$("#aggiorna").click(function(){	tabella.fnFilter('');	$("#aggiorna_hidden").val("aggiorna");	$("#form1").submit();		});	$("#nascondi_db_acq").click(function(){				$(".db_acq").toggle();		});	checkQuantitaFieldEdited();function checkQuantitaFieldEdited() {    /*     * If any field is edited,then only it will enable Save button     */    $('.quantita').keypress(function(e) { // text written        enableChgCheckbox(this);    });    $('.quantita').keyup(function(e) {        if (e.keyCode == 8 || e.keyCode == 46) { //backspace and delete key            enableChgCheckbox(this);        } else { // rest ignore            e.preventDefault();        }    });    $('.quantita').bind('paste', function(e) { // text pasted        enableChgCheckbox(this);    });	    	$(':checkbox').change(function(e) { // radio changed		enableAggiorna();		    });}	function enableChgCheckbox(t_this){	//alert("enableSaveBtn");		var tr_id = $(t_this).closest("tr").attr('id'); 		console.log("tr id_"+tr_id);		tr_id=tr_id.replace('id_','');			$("#chg"+tr_id).prop('checked', true);		enableAggiorna();	}function enableAggiorna(){		var numberOfChecked = $('input:checkbox:checked').length;		console.log ("Modificati :"+numberOfChecked);		$("#aggiorna").val("Aggiorna magazzino di "+numberOfChecked+" articoli");		if (numberOfChecked>0){			$("#aggiorna").prop("disabled",false);		}		else{			$("#aggiorna").prop("disabled",true);		}}							} );		</script>    <%end if%></form>          <%else          end ifcall connclose()          %> <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><script type="text/javascript" src="Jquery/js/select2.js"></script>  <script type="text/javascript">$(document).ready(function () {	function attiva_select2(Url,Placeholder){		  	$('#idsettore').select2({				placeholder: Placeholder,				minimumInputLength: 1,				//allowClear: true,				ajax: {					quietMillis: 150,	  			url: Url,					dataType: 'json',					data: function (term, page) {						return {							term: term						};					},					results: function (data) {												return {							results: data						};					}				}			});		}	$('#idsettore').on("select2-selecting", function(e) {		var idsettore = e.object.id;		  	$('#idprod').val(idsettore);		$("#form1").submit();    });		  	attiva_select2("ajax_function.asp?select2=articoli_sel2","Cerca articolo");    });</script></body></html><%function aggiungi_virgola(str_A, str_B)	dim virgola	virgola=""	if str_A<>"" then virgola=","	aggiungi_virgola=str_A&virgola&str_Bend functionsub mappacatselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM settori WHERE idpadre = " & id &" and idsettore<>"&escludi&" order by nome_settore;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("idsettore") &""""		if int(val)=int(rs_order("idsettore")) then response.write " selected"		response.write ">" &spaceing& rs_order("nome_settore")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappacatselezione(layer+1,rs_order("idsettore"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	sub rigamagazzino(idmag,quantita_magazzino,quantita_riordino,idpro,codice,articolo,prezzo,variante_a,variante_b,data_aggiornamento,db_ven,db_acq,idvara,idvarb)dim stileif instr(stringa_idmag,"|"&idmag&"|")=0 then	if stringa_idmag="" then stringa_idmag="|"	stringa_idmag=stringa_idmag&idmag&"|"	stile=""	if quantita_magazzino<quantita_riordino then stile="style='background:red;''"	if idpro_tmp<>idpro or singolo then		nuovo=true		idpro_tmp=idpro	else		nuovo=false	end if	classe_db_acq=""	if db_ven then		readonly=" readonly"		stile="style='background:gray; text-align: right;'"	elseif db_acq then		stile="style='background:yellow; text-align: right;'"		readonly=""		stile_bordo=""			else		stile="style='text-align: right;'"		readonly=""		stile_bordo=""	end if	if dentro_db then		classe_db_acq="db_acq"		for n=1 to livello		icona=icona+"<span class=""ui-icon ui-icon-carat-1-sw"" style=""float: left;""></span>"		next	else		icona=""	end if	%>            <tr id="id_<%=idmag%>" class="<%=classe_db_acq%>"> 			<td style="border-bottom: 1px solid;" nowrap><%=icona%><%if idpro_tmp<>"" and nuovo then%><input type="hidden" name="idpro" value="<%=idpro_tmp%>"/><%end if %><input name="test<%=idmag%>" type="hidden" value="si" /><%if nuovo then%><a href="product.asp?idpro=<%=idpro%>" class="menu_idpro" data-idpro="<%=idpro_tmp%>"><%=codice%></a><%end if%></td>			<td style="border-bottom: 1px solid; "><%if nuovo then%><input name="testidpro<%=idpro_tmp%>" type="hidden" value="si" /><%=articolo%><%end if%></td>            <td style="border-bottom: 1px solid; "><%if nuovo then%><%=formatnumber(prezzo,2)%><%end if%></td>              <td align="right" style="border-bottom: 1px solid; "><%=variante_a%></td>                          <td align="center" style="border-bottom: 1px solid; "><%=variante_b%></td>              <td align="center" style="border-bottom: 1px solid;  white-space: nowrap;" ><input type="checkbox" name="chg<%=idmag%>" id="chg<%=idmag%>"> <input type="text" name="quantita<%=idmag%>" value="<%=quantita_magazzino%>" <%=stile%> size="7" <%=readonly%> class="quantita"/><%if session("iduser")=1 then response.write "/"&idmag%> </td>                            <td align="center" style="border-bottom: 1px solid; "><%if isnull(data_aggiornamento) then%>Mai<%else%> <%=formatdatetime(data_aggiornamento,2)%><%end if%></td>              <td align="center" style="border-bottom: 1px solid; "><input type="text" name="riordino<%=idmag%>" value="<%=quantita_riordino%>" size="4"/></td>            </tr>            <% 				if true then			if db_ven=1  then				dentro_db=true						sql="select distinta_base.* from distinta_base WHERE (((distinta_base.idpro_ven)="&idpro&") AND ((distinta_base.idvara_ven)="&idvara&") AND ((distinta_base.idvarb_ven)="&idvarb&"));"									set rs_db=conn.execute (sql)			if rs_db.eof then				call add2log("Non trovato db per "&sql,0)			else				livello=livello+1				 do while not rs_db.eof					'esegui nuovo loop su magazzino							sql="select prodotti.IDpro, prodotti.codice, prodotti.articolo, prodotti.prezzo, magazzino.*, varianti_a.variante_a, varianti_b.variante_b FROM ((magazzino RIGHT JOIN prodotti ON magazzino.idpro = prodotti.IDpro) LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara) LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb where magazzino.idpro="&rs_db("idpro_acq") &" and magazzino.idvara="&rs_db("idvara_acq")&" and magazzino.idvarb="&rs_db("idvarb_acq")							set rs2=conn.execute (sql)							if not rs2.eof then								call rigamagazzino(rs2("idmag"),rs2("quantita_magazzino"),rs2("quantita_riordino"),rs2("idpro"),rs2("codice"),rs2("articolo"),rs2("prezzo"),rs2("variante_a"),rs2("variante_b"),rs2("data_aggiornamento"),rs2("db_ven"),rs2("db_acq"),rs2("idvara"),rs2("idvarb"))							end if					rs_db.movenext				loop			dentro_db=false			end if											end if	end ifelse	if utente_andrea then response.write "<tr class=""db_acq""><td colspan=""8"" style=""border-bottom: 1px solid;"" >"&codice&" "&articolo&" "&variante_a&" "&variante_b&" gi&agrave; visualizzato</td></tr>"end ifend sub%>