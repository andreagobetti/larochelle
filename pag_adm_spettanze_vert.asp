<!--#include virtual="/setup.asp" --><!--#include file="jsonObject.class.asp"--><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/ClasseOrdine.asp" --><%	iduser=request("iduser")	idord=request("idord")	m_tabella="ordini"	if request.form("rettifica")<>"" then		rettifica=true					end if	if request.form("salva")<>"" then		'set ordine= (new ClasseOrdine)(array("apri","ordini",idord))		'call ordine.aggiorna_quantita_spettanze()		set ordine= (new ClasseOrdine)(array("aggiorna_quantita_spettanze",m_tabella,idord))		set ordine = nothing		rettifica=false	end if	'response.write oper%><!--#include virtual="/sub_head_adm.asp" --><style>	 th {  position: relative;  padding: 10px;}th span {  transform-origin: 0 50%;  transform: rotate(-90deg);   white-space: nowrap;   display: block;  position: absolute;  bottom: 0;  left: 50%;}tr {	border-bottom:1px solid;}.dipendente{	font-weight: bold;}.denominazione{	font-weight: bold;	font-size: large;}.grado{	font-weight: 100;}#accessori{	border: 1px solid black;	padding: 10px;}#accessori label {	float: left;	width: 150px;	margin-bottom: 5px;	font-weight: bold;	}#accessori input[type="text"] {	/*width: 500px;*/	margin-bottom: 5px;}/*tabella rilievo taglie */#accessori input.taglie[type="text"] {	width: 60px;	margin-bottom: 5px;}#accessori input[type="radio"] {	width: 30px;	margin-bottom: 5px;	margin-right: 10px;}#accessori input[type="checkbox"] {	margin-bottom: 5px;	margin-left: 20px;}#accessori textarea {	width: 550px;	height: 50px;	margin-bottom: 5px;}#accessori br {	clear: left;}.option{	padding-left: 20px;	padding-right: 20px;	padding-top: 3px;	padding-bottom: 3px;}.green{	background-color: #99FF99;	margin-left: 2px;}.articolo_ordine{	border: 1px solid black;}.quantita{	border: 1px solid black;	text-align: center;}.row-dipendente{	padding-top: 5px;	border-top: 2px solid black !important;}</style></head><body> <div id="wrap">	<div id="header">		<%=titolo_top%>		<!-- Div Content INIZIO-->		<%barra=0%>		<div id="barra_fissa">		<!--#include virtual="/sub_barra_adminsf2.asp" -->		</div>		<%			set rs_ordine=conn.execute ("select ordini.nord, ordini.iduser from ordini where idord="&idord)	 			iduser=rs_ordine("iduser")			nord=rs_ordine("nord")			set rs_ordine = nothing						%>         <div class="ui-widget-header ui-corner-top titolo_admin">			<a href="<%="pag_adm_ordini.asp?idord="&idord%>">Ordine <%=nord%></a> > <a href="<%=questofile&"?idord="&idord%>">Spettanze per agente</a><span class="pull-right"><a href="pag_adm_spettanze_situaz.asp?idord=<%=idord%>" class="grigio">Situazione spettanze</a></span>	    </div>	    <div class="ui-widget-header denominazione" style="padding: 5px;">		    <%			    response.write get_denominazione(iduser)			    %>	    </div><%	call tabella_accessori(iduser)	%>	    <%		    set rs_dipendenti=conn.execute ("select dipendenti.iddip, nominativo from dipendenti inner join utenti_dipendenti on dipendenti.iddip = utenti_dipendenti.iddip  where utenti_dipendenti.iduser="&iduser)		    arrRS=rs_dipendenti.getrows()		    ubound_arrRS=ubound(arrRS,2)	    %>	    <form method="POST" action="<%=questofile%>">		    <input type="hidden" name="idord" value="<%=idord%>">			<table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1" id="spettanze">				<thead >						<tr class="bordo">							<td ></td>							<td ></td>							<td>Consegnato/Quantit&agrave;</td>						</tr>				</thead>				<tbody>					<%						sql="select *, utenti_gradi.nome_grado, utenti_gradi.colore_nominativo from (dipendenti inner join (select iddip from ordini_dett inner join ordini_dett_spettanze on ordini_dett.iddett = ordini_dett_spettanze.iddett where idord="&idord&" group by iddip) as a on dipendenti.iddip = a.iddip) left join utenti_gradi on dipendenti.grado = utenti_gradi.id order by sesso desc, cognome,nome"						set rs_dipendenti=conn.execute (sql)						do while not rs_dipendenti.eof							sql="select  sum(ordini_dett_spettanze.quantita) as quantita, sum(ordini_dett_spettanze.consegnato) as consegnato from ordini_dett inner join ordini_dett_spettanze on ordini_dett.iddett = ordini_dett_spettanze.iddett where iddip="&rs_dipendenti("iddip")&" and idord="&idord							set rs_totali= conn.execute(sql)								tot_quantita=rs_totali("quantita")								tot_consegnato=rs_totali("consegnato")																								%>						<tr>							<td colspan="2" class="dipendente row-dipendente" >								<%=dipendente_colorato(  rs_dipendenti("cognome")&" "&rs_dipendenti("nome"),rs_dipendenti("sesso"),rs_dipendenti("colore_nominativo") )&" "&rs_dipendenti("matricola")%> <span class="grado"><%=rs_dipendenti("nome_grado")%></span>							</td>							<td class="quantita row-dipendente" style="font-weight: bold;">								<%=tot_consegnato%>/<%=tot_quantita%>							</td>						</tr>						<%							sql="select ordini_dett.*, ordini_dett_spettanze.*, ordini_dett_note.nota  from ordini_dett inner join ordini_dett_spettanze on ordini_dett.iddett = ordini_dett_spettanze.iddett left join ordini_dett_note on ordini_dett.iddett=ordini_dett_note.iddett where iddip="&rs_dipendenti("iddip")&" and idord="&idord& " order by ordine"							set rs_spettanze=conn.execute (sql)							do while not rs_spettanze.EOF								txt2=""								span=""								quantita=rs_spettanze("quantita")								if rs_spettanze("in_ordine")>0 then									if rs_spettanze("in_ordine")>=quantita then										span="in_ordines"									else										call concatena_stringa(txt2,",","<span class=""in_ordines"">"&rs_spettanze("in_ordine")&" in ordine</span>")									end if								end if								if rs_spettanze("pronto")>0 then									if rs_spettanze("pronto")>=quantita then										span="prontos"									else										call concatena_stringa(txt2,",","<span class=""prontos"">"&rs_spettanze("pronto")&" pronto</span>")									end if								end if								if rs_spettanze("consegnato")>0 then									if rs_spettanze("consegnato")>=quantita then										span="consegnatos"									else										call concatena_stringa(txt2,",","<span class=""consegnatos"">"&rs_spettanze("consegnato")&" consegnato</span>")									end if								end if								if span<>"" then									txt=txt&span								end if							%>							<tr class="">								<td style="border-right: 0px solid black;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </td>								<td class="articolo_ordine <%=span%>" style="border-left: none;"> 									<%						txt=""			quantita=rs_spettanze("quantita")			max=rs_spettanze("quantita")-rs_spettanze("consegnato")			id=rs_spettanze("id")			in_ordine=rs_spettanze("in_ordine")			pronto= rs_spettanze("pronto")			consegna=""			consegnato=rs_spettanze("consegnato")			if rettifica then				max=rs_spettanze("quantita")			else				if quantita-consegnato<pronto then					pronto=0				end if				end if												'Togliere data-rule-max se non uso validator			txt=txt&"<input type=""hidden"" id=""quantitam"&id&""" value="""&max&""">"			if (rs_spettanze("pronto")+rs_spettanze("in_ordine"))<max or rettifica then				txt=txt&"<input type=""text"" name=""in_ordine"&id&""" id=""in_ordine"&id&""" class=""in_ordine do"" autocomplete=""off"" data-rule-max="""&max&""" value="""&vuotosezero( in_ordine)&""">"			end if			if rs_spettanze("pronto")<max or rettifica then				txt=txt&"<input type=""text"" name=""pronto"&id&""" id=""pronto"&id&""" class=""pronto do"" autocomplete=""off"" data-rule-max="""&max&""" value="""&vuotosezero( pronto)&""">"			end if			if rs_spettanze("consegnato")<quantita or rettifica then				if rettifica then					valore=vuotosezero(consegnato)				else										valore=""				end if				txt=txt&"<input type=""text"" name=""consegna"&id&""" id=""consegna"&id&""" class=""consegna do""  autocomplete=""off"" data-rule-max="""&max&""" value="""&valore&""">&nbsp;"			end if																		nota=rs_spettanze("nota")																if not isnull(nota) then nota="<br>Nota:<span  class=""notaarticolo"">"&nota&"</span>"									response.write txt &rs_spettanze("quantita")&" x "&rs_spettanze("codice_ordine")&"&nbsp;"&rs_spettanze("articolo_ordine")									if txt2<>"" then response.write "<br>"&txt2 									taglia_misura=rs_spettanze("taglia_misura")									if taglia_misura<>"" then response.write "&nbsp;("&taglia_misura&")"									response.write nota									%> 								</td>																<td class="quantita <%=span%>">									<%=rs_spettanze("consegnato")%>/<%=rs_spettanze("quantita")%>								</td>							</tr>							<%								rs_spettanze.MoveNext							loop							rs_dipendenti.movenext						loop												call connclose()						%>				</tbody>			</table>			<div class="ui-dialog-buttonpane ui-widget-content ui-helper-clearfix">				<div class="ui-dialog-buttonset" style="text-align: center;">				<input type="submit" name="salva" value="Salva" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">				<input type="button"  value="DDT" id="pulsante_crea_ddt_fattura" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">				<%if not rettifica then %>				<input type="submit" name="rettifica" value="Rettifica" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">				<%end if %>				</div>			</div>	    </form>        <!-- Div Content FINE-->	</div><!-- End #header --><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><!-- End #wrap -->			<script type="text/javascript" src="Jquery/Js/jquery.mobile-events.min.js"></script><script>				$(function() {						    var classi=["in_ordine","pronto","consegna"];				    var form = $("#form-avanz-spettanze");				    var idord=<%=idord%>;				    var nord=<%=nord%>;    var header_height = 0;    $('table th span').each(function() {        if ($(this).outerWidth() > header_height) header_height = $(this).outerWidth();    });    $('table th').height(header_height);        				    $('.do').bind('doubletap', function(e) { 						    imposta_valore(this);					});    				    $(".do").click(function(e) {					    if(e.shiftKey){						    imposta_valore(this);						}					});										function imposta_valore(obj){							var id=trova_id($(obj));						    //var id=$(this).attr("id").replace(replace, "");						    console.log("id:"+id);						    var quantita=$("#quantitam"+id).val();						    console.log("quantita:"+quantita);						    $(obj).val(quantita);					}					function trova_id(obj){												for (var i = 0; i < classi.length; i++) {							console.log("cerco classe:"+classi[i]);							if($(obj).hasClass(classi[i])){							    console.log("trovata "+classi[i]);							    var sostituisci=classi[i];						    }						}						console.log("name:"+$(obj).attr("name"));					    var id=$(obj).attr("name").replace(sostituisci, "");						return id;					}        });	</script></body></html><%	function vuotosezero(val)	if 	val=0 then vuotosezero="" else vuotosezero=valend function	function green(val)		green=""		if val=1 then green="green"	end function	%>