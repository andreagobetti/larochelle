<script language="vbscript" runat="server">

Sub Application_OnStart 
    Application.Lock 
    Application("collegati") = 0 
    Application.UnLock 
End Sub 

Sub Session_OnStart 
    Application.Lock 
    Application("collegati") = Application("collegati") + 1 
    Application.UnLock 
End Sub 

Sub Session_OnEnd 
    Application.Lock 
    Application("collegati") = Application("collegati") - 1 
    Application.UnLock 
End Sub

</script>