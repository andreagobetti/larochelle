<!--#include virtual="/setup.asp" --><!--#include file="JSON_latest.asp"--><%if session("idadmin") = "" then call login()%><%'------------------------------------oper=request.form("oper")if request.form("elimina")<>"" then	sql="delete FROM prodotti_consigliati WHERE id =" & request.form("elimina") & ";"	conn.execute(sql)end ifif request.form("elimina_gruppo")<>"" then	sql="delete FROM prodotti_consigliati WHERE idconsigliato =" & request.form("idconsigliato") & ";"	conn.execute(sql)	sql="delete FROM articoli_consigliati WHERE id_pro_consigliati =" & request.form("idconsigliato") & ";"	conn.execute(sql)	oper=""end ifif request.form("aggiungi")<>"" then	Response.ContentType = "application/json; charset=utf-8"	Response.CodePage = 65001	Set Js = jsObject()	set cerco=conn.execute ("select prodotti_consigliati.* from prodotti_consigliati where idconsigliato="&request("idconsigliato")&" and idpro="& request("idpro"))	if cerco.eof then		sql="INSERT INTO prodotti_consigliati (idconsigliato, idpro) VALUES ("& request("idconsigliato")&","& request("idpro")&")"		conn.execute(sql)		js("success")=true		js("message")="Articolo aggiunto"	else		js("success")=false		js("message")="Articolo esistente"	end if	set cerco=Nothing		js.Flush	response.end	end ifif request("tabella_articoli")<>"" then	call visualizza_articoli(request("tabella_articoli"))	response.endend ifselect case lcase(request("oper"))	case "annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case else		oper="view"		if request.form("modifica")<>"" then oper="edit"		if request.form("elimina")<>"" then oper="edit"		if request.form("aggiungi")<>"" then oper="edit"end selectif oper="add" or oper="update" then	'controlliend ifif oper="add" or oper="update" then	Set rs = Server.CreateObject("ADODB.Recordset")	sql="select * from articoli_consigliati"	if oper="add" then		rs.Open sql, conn, 3, 3		rs.addnew	else		sql= sql & " where id_pro_consigliati=" & request.form("idconsigliato")		rs.Open sql, conn, 3, 3	end if	rs("nome_ragruppamento")=firstup(trim(request.form("nome_ragruppamento")))	rs("descrizione_ragruppamento")=firstup(trim(request.form("descrizione_ragruppamento")))	rs.update	if oper="add" then		txt= "Aggiunto"	else		txt= "Modificato"	end if	add2log txt&" [correlato="&rs("id_pro_consigliati")&"]"&rs("nome_ragruppamento")&"[/nome] eseguita da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2	rs.close	oper="view"end if//response.write oper%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!-- Stile: <%=Application("skins")%> --><!--#include virtual="/sub_head.asp" --><% if oper<>"view" then%><script Language="JavaScript"> annulla=false;function Validator(theForm) {if (annulla==true)  { 	return(true);      }   if (theForm.nome_ragruppamento.value == "")  {     alert("Inserisci un nome per il raggruppamento.");     theForm.nome_linea.focus();     return (false);   }   return (true); } </script><script type="text/javascript" language="javascript">function Valida_aggiungi() {		if (document.form1.idpro.value == '' ) {		alert("Selezionare un articolo dall\'elenco a discesa");		document.form1.testo.focus();		return false;	}	document.form1.aggiungi.value='aggiungi';	document.form1.submit();} </script><%end if%></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->         <%barra=0%><div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Articoli correlati</a></div> </div>         <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" <%if oper<>"view" then%> onSubmit="return Validator(this)"<%end if%> style="margin-top:0px;">		        <%sql="select articoli_consigliati.id_pro_consigliati, articoli_consigliati.nome_ragruppamento, Count(prodotti_consigliati.Id) AS ConteggioDiId FROM articoli_consigliati LEFT JOIN prodotti_consigliati ON articoli_consigliati.id_pro_consigliati = prodotti_consigliati.idconsigliato GROUP BY articoli_consigliati.id_pro_consigliati, articoli_consigliati.nome_ragruppamento ORDER BY articoli_consigliati.nome_ragruppamento;"if oper="view" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr align="right">               <td colspan="2" style="border-bottom:1px solid;"><a href="<%=questofile%>?oper=new"><strong>Aggiungi ragruppamento</strong></a></td>            </tr>            <tr>               <%if oper="view" then%>              <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Modifica&nbsp;</td>              <%end if%>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Elenco ragruppamenti</td>            </tr>            <%	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="modifica" value="<%=rs("id_pro_consigliati")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=rs("nome_ragruppamento")%> 			  <%if clng(rs("ConteggioDiId"))=>0 then 			  txt_conteggio=rs("ConteggioDiId")&" articoli"			  else			  txt_conteggio="<span class=""rosso"">Vuoto</span>"			  end if			  %>			  (<%=txt_conteggio%>)</td>            </tr>            <%	rs.movenext	loop	rs.close	Set rs = Nothing	%>          </table>          <%elseidconsigliato=request.form("modifica")if request.form("id")<>"" then idconsigliato=request.form("id")if request.form("idconsigliato")<>"" then idconsigliato=request.form("idconsigliato")sql="select articoli_consigliati.* from articoli_consigliati "	sql=sql & " where id_pro_consigliati =" & idconsigliato	if oper="edit" then		set rs=conn.execute(sql)		testo= "Modifica raggruppamento"			else		testo= "Nuovo raggruppamento"	end if		  %>          <input type="hidden" name="idconsigliato" value="<%=idconsigliato%>">          <%if error<>"" then			  		descrizione=request.form("descrizione")			  	elseif oper="new" then			  		descrizione=""				end if%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header"><%response.write testo%></td>            </tr>            <tr>              <td align="right" valign="top">Nome raggruppamento</td>              <td><%if error<>"" then			  		testo=request.form("nome_ragruppamento")				elseif oper="edit" then					testo=rs("nome_ragruppamento")			  	elseif oper="new" then			  		testo=""				end if%>                  <input type="text" name="nome_ragruppamento" value="<%=testo%>" size="40">              </td>            </tr>            <tr>               <td align="right" valign="top">Descrizione</td>              <td>  <%if error<>"" then			  		testo=request.form("descrizione_ragruppamento")				elseif oper="edit" then					testo=rs("descrizione_ragruppamento")					Set rs = Nothing			  	elseif oper="new" then			  		testo=""				end if%> <textarea name="descrizione_ragruppamento" cols="40" rows="4"><%=testo%></textarea>              </td>            </tr>            <tr>              <td colspan="2" align="center"> <%		if oper="view" then			txt=puls_new		elseif oper="new" or error<>"" then			txt="Aggiungi"		elseif oper="edit" then			txt="Modifica"		end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Annulla" onClick="annulla=true;">    <%end if%>    <%if oper="edit" and num=0 and error="" then%>    <input type="submit" name="elimina_gruppo" value="Elimina">    <%end if%></td>            </tr>          </table>       <%if oper="edit" then%><script type="text/javascript" src="Jquery/js/select2.js"></script>  <script type="text/javascript">$(document).ready(function () {	$('#idpro').select2({		placeholder: 'Seleziona articolo',		minimumInputLength: 3,		allowClear: true,		ajax: {			quietMillis: 150,			url: "ajax_function.asp?select2=articoli_sel2",			dataType: 'json',			data: function (term, page) {				return {					term: term				};			},			results: function (data) {				return {					results: data				};			}		}	});	$("#aggiungi").click(function() {		var idpro=$("#idpro").val();		var idconsigliato=<%=idconsigliato%>;		console.log ("idpro:"+idpro);		if (idpro == '' ) {			alert("Selezionare un articolo dall\'elenco a discesa");			//document.form1.testo.focus();			return false;		}		$.ajax({			url     : "<%=questofile%>",				type    : "post",				dataType: 'json',				data	: "aggiungi=si&idpro="+idpro+"&idconsigliato="+idconsigliato,				success: function(data){					console.log(data.message);					//alert(data.Message);					$.get("<%=questofile%>?tabella_articoli="+idconsigliato, function(result){					$("#tabella_articoli").html(result);			 });				}				,error:function(xhr, textStatus, error){					console.log("Errore ricerca quantita");				      console.log("xhr.statusText:"+xhr.statusText);				      console.log("xhr.responseText:"+xhr.responseText);				      console.log("textStatus:"+textStatus);				      console.log("error:"+error);					  }			});		});});</script><table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td class="ui-widget-header">Aggiungi articolo al raggruppamento</td>            </tr>            <tr>               <td style="border-bottom:1px solid;">Articolo da aggiungere                         <input type="hidden" id="idpro" name="idpro" style="width: 200px; "><input type="button" value="Aggiungi" id="aggiungi"></td>            </tr>          </table>                    <div id="tabella_articoli"><%	call visualizza_articoli(idconsigliato)%>                    </div>	<%end ifend ifcall connclose()%>        </form>  <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%sub visualizza_articoli(idconsigliato)	sql="select SQL_CALC_FOUND_ROWS prodotti_consigliati.*, prodotti.codice, prodotti.articolo "	sql=sql &" FROM prodotti_consigliati INNER JOIN prodotti ON prodotti_consigliati.idpro = prodotti.IDpro WHERE (((prodotti_consigliati.idconsigliato)="& idconsigliato &")) "	sql= sql & "ORDER BY codice;"	'set rs=conn.execute(sql)	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql,conn,3,3	lngTotalRecords=clng(conn.Execute("Select Found_Rows();")(0).Value)%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header"><%=lngTotalRecords%> articoli nel ragruppamento </td>            </tr>            <tr>               <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Rimuovi&nbsp;</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Articoli</td>            </tr>            <%	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="elimina" value="<%=rs("id")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=rs("codice") & " " & rs("articolo")%></td>            </tr>            <%	rs.movenext	loop	rs.close	set rs=nothing	%>          </table><%	end sub%>