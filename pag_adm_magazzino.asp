<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/paginazione.asp" --><!--#include virtual="/pag_adm_movimenti_inc.asp" --><!--#include virtual="/classeMagazzino.asp" --><%	if session("idadmin") = "" then call login()width=400 'Larghezza input boxidsettore=request("idsettore")idfornitore=request("idfornitore")idmag=request("idmag")if idsettore="" then idsettore=0idpro=request("idpro")if request("idprod")<>"" then	idpro=request("idprod")end ifif request("elenco_movimenti")<>"" then	idmag=request("elenco_movimenti")	call elenco_movimenti()		response.endend ifidprod=idpro%><%oper="view"' Aggiorna quantitàIF Request.form( "aggiorna" ) <> "" THEN						session("mag_db")=""		set magazzino = new classeMagazzino	call magazzino.aggiorna_da_form()		set magazzino = Nothing			if session("aggiorna_magazzino")<>"" then add2log session("aggiorna_magazzino"),0END IFIF Request.form( "aggiornaold" ) <> "" THEN	session("mag_db")=""	'response.write "aggiorna:true"	'if request("singolo")="True" then	'	sql="select magazzino.*,  prodotti.codice FROM (magazzino INNER JOIN prodotti ON magazzino.idpro = prodotti.IDpro) where magazzino.idpro="&idpro		'response.write "idpro:true"	'elseif idsettore>0 then	'	sql="select magazzino.*, settori_prodotti.idsettore, prodotti.codice FROM (magazzino INNER JOIN prodotti ON magazzino.idpro = prodotti.IDpro) INNER JOIN settori_prodotti ON prodotti.idpro = settori_prodotti.idpro where idsettore="&idsettore	'elseif idfornitore<>"" then	'	sql="select magazzino.*,  prodotti.codice,prodotti.idfor FROM (magazzino INNER JOIN prodotti ON magazzino.idpro = prodotti.IDpro) where idfor=" & cint(idfornitore)	'end if		array_idmag=split(request.form("stringa_idmag"),"|")	n_idmag=ubound(array_idmag)	session("aggiorna_magazzino")="n_idmag:"&n_idmag-1&" Stringa idmag:"&replace(request.form("stringa_idmag"),"|"," ")&"<br>"	for n=1 to n_idmag-1		idmag=array_idmag(n)		IF  Request("chg"&idmag)<>"" THEN			sql="select magazzino.*,  prodotti.codice FROM (magazzino INNER JOIN prodotti ON magazzino.idpro = prodotti.IDpro) where magazzino.idmag="&idmag			'response.write sql			Set rs = conn.Execute(sql)			WHILE NOT RS.EOF				sql_update=""				aggiornato=false				cosa_aggiorna=""					session("mag_db")=""					session("aggiorna_magazzino")=session("aggiorna_magazzino")&"Analizzo "&rs("codice")&": "					if not rs("db_ven") then 						newQ = TRIM( Request( "quantita" & RS( "idmag" ) ) )						IF isNumeric( newQ ) THEN							newq=aggiusta_decimale (newq,"asp")							oldQ=RS("quantita_magazzino")							newq=roundup(newq,2)							if isnull(oldQ) then oldQ=0							if Cdbl(oldQ)<>Cdbl(newQ) or isnull(RS("quantita_magazzino")) then									'response.write "aggiorna:true"									aggiornato=true									quantita_magazzino = roundup(newQ,3)									call movimento_magazzino(rs("idpro"),newQ,rs("idvara"),rs("idvarb"),1,0,rs("idmag")) 'idpro,quantita,idvara,idvarb,causale,idord,idmag									cosa_aggiorna="quantita_magazzino da "&oldQ&" a "& newq									sql_update=aggiungi_virgola(sql_update,"quantita_magazzino="&aggiusta_decimale(quantita_magazzino,"sql"))								end if						END IF						newR = TRIM( Request( "riordino" & RS( "idmag" ) ) )						IF isNumeric( newR ) THEN							oldR=RS("quantita_riordino")							if isnull(oldR) then oldR=0							if Cdbl(newR)<>cdbl(oldR) or isnull(RS("quantita_riordino")) then								quantita_riordino = newR								aggiornato=true								cosa_aggiorna=aggiungi_virgola(cosa_aggiorna,"riordino da "&oldR&" a "&newR)								sql_update=aggiungi_virgola(sql_update,"quantita_riordino="&aggiusta_decimale( quantita_riordino,"sql"))							end if						END IF						data_aggiornamento=now()						sql_update=aggiungi_virgola(sql_update,"data_aggiornamento=now()")						idvara=rs("idvara")						idvarb=rs("idvarb")						if isnull(idvara) then idvara=0						if isnull(idvarb) then idvarb=0						'response.write "UPDATE magazzino SET "&sql_update&" WHERE idmag="&RS( "idmag")						conn.execute ("UPDATE magazzino SET "&sql_update&" WHERE idmag="&RS( "idmag"))						if rs("db_acq") then							session("aggiorna_magazzino")=session("aggiorna_magazzino")&" elemento di acquisto in db, scansiono db."							quantita_massima=null							call aggiorna_magazzino_db(rs("idpro"),idvara,idvarb,quantita_magazzino)						end if					else						session("aggiorna_magazzino")=session("aggiorna_magazzino")&" salto perch&egrave; ha db."					end if															if aggiornato then call add2log ("Aggiornato magazzino [articolo="& rs("idpro")&"]"&rs("codice")&"[/articolo] eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]"&vbcrlf&"Cosa aggiorna: "&cosa_aggiorna , 2)				if session("mag_db")<>"" then session("mag_db")="<br>"&session("mag_db")				session("aggiorna_magazzino")=session("aggiorna_magazzino")&session("mag_db")&"<br>"							RS.MoveNext			WEND			RS.Close		else			session("aggiorna_magazzino")=session("aggiorna_magazzino")&"<br>Salto idmag:"&idmag&" perch&egrave; non modificato"		end if	next	if false then	'ciclo sui prodotti	sql="select prodotti.idpro, prodotti.idsettore, prodotti.articolo, prodotti.prezzo from prodotti"	if request("singolo")="True" then		sql=sql&" where prodotti.idpro="&idpro	else		sql=sql&" where prodotti.idsettore="&idsettore	end if	rs.Open sql, conn, 3, 3	WHILE NOT RS.EOF	IF  Request("testidpro"&RS( "idpro"))="si" THEN		newQ = TRIM( Request( "prezzo" & RS( "idpro" ) ) )		IF isNumeric( newQ ) THEN			rs("prezzo")=aggiusta_decimale(newq,"asp")		END IF		newQ = TRIM( Request( "articolo" & RS( "idpro" ) ) )		RS("articolo") = newQ		'rs("articolo")=Request( "articolo" & RS( "idmag" ) ) 		rs.update	END IF	RS.MoveNext	WEND	RS.Close	end if	if session("aggiorna_magazzino")<>"" then add2log session("aggiorna_magazzino"),0END IF%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><link rel="stylesheet" type="text/css" href="Jquery/css/select2.css"/></head><body> <div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa"> <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Giacenze di magazzino</a></div></div>        <!-- Colonna CORPO INIZIO-->          <%if oper="view" then	          sql="select magazzino.idmag, magazzino.idpro, magazzino.idvara,magazzino.idvarb, prodotti.codice, varianti_a.variante_a,varianti_b.variante_b from ((magazzino left join prodotti on magazzino.idpro = prodotti.idpro ) left JOIN varianti_a on magazzino.idvara = varianti_a.idvara ) left join varianti_b on magazzino.idvarb = varianti_b.idvarb"	          	          ordine=request.form("ordine")cercain=request.form("cercain")cerca=request.form("cerca")anno=year(date())visualizza_movimenti=falseif idsettore>0 then	'sql="select prodotti.IDpro, prodotti.codice, prodotti.articolo, prodotti.prezzo, magazzino.*, varianti_a.variante_a, varianti_b.variante_b FROM (((magazzino RIGHT JOIN prodotti ON magazzino.idpro = prodotti.IDpro) LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara) LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb) INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro "		sql="select magazzino.*, prodotti.codice, prodotti.articolo, prodotti.prezzo, varianti_a.variante_a,varianti_b.variante_b,  storico_ordini.quantita_meno_uno,storico_ordini.quantita_meno_due from ((((magazzino left join prodotti on magazzino.idpro = prodotti.idpro ) left JOIN varianti_a on magazzino.idvara = varianti_a.idvara ) left join varianti_b on magazzino.idvarb = varianti_b.idvarb) left join (select ordini_dett.idpro, ordini_dett.idvara, ordini_dett.idvarb, sum(case when year(data) = "&anno&" then quantita else 0 end) AS quantita_meno_uno, sum(case when year(data) = "&anno-1&" then quantita else 0 end) AS quantita_meno_due  FROM ordini_dett INNER JOIN ordini ON ordini_dett.idord = ordini.idord  where ordini.stato=6 and  ordini.eliminato=0 and ordini.verde=false GROUP BY ordini_dett.idpro, ordini_dett.idvara, ordini_dett.idvarb) as storico_ordini on magazzino.idpro = storico_ordini.idpro and magazzino.idvara = storico_ordini.idvara and magazzino.idvarb = storico_ordini.idvarb ) INNER JOIN settori_prodotti ON magazzino.IDpro = settori_prodotti.IDpro "						sql=sql & " where idsettore=" & cint(idsettore)	singolo=false	elenca=true	elseif idfornitore<>"" then	'sql="select prodotti.IDpro, prodotti.codice, prodotti.articolo, prodotti.prezzo, prodotti.idfor, magazzino.*, varianti_a.variante_a, varianti_b.variante_b FROM (((magazzino RIGHT JOIN prodotti ON magazzino.idpro = prodotti.IDpro) LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara) LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb) "		sql="select magazzino.*, prodotti.codice, prodotti.articolo, prodotti.prezzo, prodotti.idfor,  varianti_a.variante_a,varianti_b.variante_b,  storico_ordini.quantita_meno_uno,storico_ordini.quantita_meno_due from (((magazzino left join prodotti on magazzino.idpro = prodotti.idpro ) left JOIN varianti_a on magazzino.idvara = varianti_a.idvara ) left join varianti_b on magazzino.idvarb = varianti_b.idvarb) left join (select ordini_dett.idpro, ordini_dett.idvara, ordini_dett.idvarb, sum(case when year(data) = "&anno&" then quantita else 0 end) AS quantita_meno_uno, sum(case when year(data) = "&anno-1&" then quantita else 0 end) AS quantita_meno_due  FROM ordini_dett INNER JOIN ordini ON ordini_dett.idord = ordini.idord  where ordini.stato=6 and  ordini.eliminato=0 and ordini.verde=false GROUP BY ordini_dett.idpro, ordini_dett.idvara, ordini_dett.idvarb) as storico_ordini on magazzino.idpro = storico_ordini.idpro and magazzino.idvara = storico_ordini.idvara and magazzino.idvarb = storico_ordini.idvarb "				sql=sql & " where prodotti.idfor=" & cint(idfornitore) &" and db_ven=0 and prodotti.attivo=1"	singolo=false	elenca=trueelse	if idpro<>"" or idmag<>"" then		'sql="select magazzino.*, prodotti.codice, prodotti.articolo, prodotti.prezzo, varianti_a.variante_a,varianti_b.variante_b from ((magazzino left join prodotti on magazzino.idpro = prodotti.idpro ) left JOIN varianti_a on magazzino.idvara = varianti_a.idvara ) left join varianti_b on magazzino.idvarb = varianti_b.idvarb"				sql="select magazzino.*, prodotti.codice, prodotti.articolo, prodotti.prezzo, varianti_a.variante_a,varianti_b.variante_b,  storico_ordini.quantita_meno_uno,storico_ordini.quantita_meno_due from (((magazzino left join prodotti on magazzino.idpro = prodotti.idpro ) left JOIN varianti_a on magazzino.idvara = varianti_a.idvara ) left join varianti_b on magazzino.idvarb = varianti_b.idvarb) left join (select ordini_dett.idpro, ordini_dett.idvara, ordini_dett.idvarb, sum(case when year(data) = "&anno&" then quantita else 0 end) AS quantita_meno_uno, sum(case when year(data) = "&anno-1&" then quantita else 0 end) AS quantita_meno_due  FROM ordini_dett INNER JOIN ordini ON ordini_dett.idord = ordini.idord  where ordini.stato=6 and  ordini.eliminato=0 and ordini.verde=false GROUP BY ordini_dett.idpro, ordini_dett.idvara, ordini_dett.idvarb) as storico_ordini on magazzino.idpro = storico_ordini.idpro and magazzino.idvara = storico_ordini.idvara and magazzino.idvarb = storico_ordini.idvarb "		visualizza_movimenti=true		'if instr(sql,"where")>0 then sql=sql&" and " else sql=sql&" where "		if idpro<>""  then			sql=sql & "where magazzino.idpro=" & idpro		elseif idmag<>"" then			sql=sql & "where magazzino.idmag=" & idmag		end if		elenca=true		singolo=true	end if	'response.write sqlend ifif request("sottoscorta")<>"" then		sql="select magazzino.*, prodotti.codice, prodotti.articolo, prodotti.prezzo, varianti_a.variante_a,varianti_b.variante_b,  storico_ordini.quantita_meno_uno,storico_ordini.quantita_meno_due from (((magazzino left join prodotti on magazzino.idpro = prodotti.idpro ) left JOIN varianti_a on magazzino.idvara = varianti_a.idvara ) left join varianti_b on magazzino.idvarb = varianti_b.idvarb) left join (select ordini_dett.idpro, ordini_dett.idvara, ordini_dett.idvarb, sum(case when year(data) = "&anno&" then quantita else 0 end) AS quantita_meno_uno, sum(case when year(data) = "&anno-1&" then quantita else 0 end) AS quantita_meno_due  FROM ordini_dett INNER JOIN ordini ON ordini_dett.idord = ordini.idord  where ordini.stato=6 and  ordini.eliminato=0 and ordini.verde=false GROUP BY ordini_dett.idpro, ordini_dett.idvara, ordini_dett.idvarb) as storico_ordini on magazzino.idpro = storico_ordini.idpro and magazzino.idvara = storico_ordini.idvara and magazzino.idvarb = storico_ordini.idvarb "				if instr(sql,"where")>0 then sql=sql&" and " else sql=sql&" where "	sql=sql&" quantita_magazzino<quantita_riordino "	elenca=trueend if if ordine="ultimo" then elseif ordine="" then	'ordine iniziale perdefinito 	sql= sql & " order by codice,variante_a,variante_b"else	sql= sql & " order by " & ordine end iffunction fullcat(id,tmp)	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	sql_order = "select * FROM settori WHERE idsettore = " & id	rs_order.open sql_order,conn	if not rs_order.eof then			str=tmp&"&lt;"&rs_order("nome_settore") 		tmp=fullcat(rs_order("idpadre"),str)	else	tmp=mid(tmp,5)	end if	fullcat=tmp	rs_order.close	set rs_order=nothingEnd functioniPageSize=grec4pageorder = "&cat="&cat&"&cercain="&cercain&"&cerca="&cercaif Request.QueryString("page")="" then	page = session("page")else	page=Request.QueryString("page")	session("page")=pageend ifsingolo_tmp=singolo		%><form id="form1" method="post" action="<%=questofile%>" style="margin-top: 0px;">	<input type="hidden" name="singolo" value="<%=singolo%>">	<div class="div_testo">	<select name="selezione" id="selezione">	<option value="A" <%if idpro<>"" then%>selected<%end if%>>Articolo</option>	<option value="S" <%if idsettore<>0 then%>selected<%end if%>>Settore</option>	<option value="F" <%if idfornitore<>"" then%>selected<%end if%>>Fornitore</option>	</select>			<input type='hidden' name='idsettore' id='idsettore' style="min-width:300px;" value="<%=idsettore%>"/>			<input type='hidden' name='idfornitore' id='idfornitore' value="<%=idfornitore%>"/>			<input type='hidden' name='idprod' id='idprod' value="<%=idprod%>"/>                                         <input type="submit" name="Sottoscorta" value="sottoscorta" /><input type="button" value="Nascondi/Mostra materiali vendita" id="nascondi_db_ven"/></div><div class="div_spaziatore"></div>            <% if elenca thenif utente_andrea then response.write "[soloio]"&sql&"[/soloio]"set rs=conn.execute(sql)                                    %>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1" id="tabella">            <thead>            <tr bgcolor="#E5E5E5" >               <td  style="border-bottom: 1px solid;">&nbsp;Codice</td>              <td align="center" style="border-bottom: 1px solid;">Articolo</td>              <td align="center" style="border-bottom: 1px solid;">Prezzo</td>              <td  style="border-bottom: 1px solid;">Variante</td>              <td align="center" style="border-bottom: 1px solid;">Variante</td>              <td align="center" style="border-bottom: 1px solid;">Quantit&agrave;</td>	        <td align="center" style="border-bottom: 1px solid;">Aggiornato</td>	        <td align="center" style="border-bottom: 1px solid;">Venduto <%=anno%></td>	        <td align="center" style="border-bottom: 1px solid;">Venduto <%=anno-1%></td>              <td align="center" style="border-bottom: 1px solid;">Riordino</td>            </tr>            </thead>            <tbody>            <%			stringa_idmag=""		iRecordsShown = 0		dentro_db=false		livello=0		num=0				Do While Not RS.EOF		num=num + 1		call rigamagazzino(rs("idmag"),rs("quantita_magazzino"),rs("quantita_riordino"),rs("idpro"),rs("codice"),rs("articolo"),rs("prezzo"),rs("variante_a"),rs("variante_b"),rs("data_aggiornamento"),rs("db_ven"),rs("db_acq"),rs("idvara"),rs("idvarb"),rs("quantita_meno_uno"),rs("quantita_meno_due"))					RS.MoveNext		singolo=false	Loop	set rs=Nothing	%></tbody>    <tfoot>            </tr>                <tr align="right">              <td colspan="10"></td>            </tr>            	    <tr align="center">                          <td colspan="10">	              Articolo presente in db<input type="text"  size="4"  style='background:yellow;' disabled/> &nbsp; Articolo con db, quantità calcolata <input type="text"  size="4"  style='background:gray;' disabled/> <span style="float: right;"><input type="button" value="Aggiorna" id="aggiorna" disabled="disabled"/><input type="hidden" name="aggiorna" id="aggiorna_hidden" /><input type="hidden" name="stringa_idmag" value="<%=stringa_idmag%>" /></span>              </td></tfoot></table><div id="elenco_movimenti"><%	'if utente_andrea then response.write "[soloio] singolo:"&singolo	if num=1 then 		call elenco_movimenti()	end if				%>	</div><script type="text/javascript" src="Jquery/js/DataTables/jquery.dataTables.min.js"></script><script type="text/javascript" charset="utf-8">$(document).ready(function() {					$("#aggiorna").click(function(){		$("#aggiorna_hidden").val("aggiorna");		$("#form1").submit();		});	$("#nascondi_db_ven").click(function(){				$(".db_ven").toggle();		});	checkQuantitaFieldEdited();function checkQuantitaFieldEdited() {    /*     * If any field is edited,then only it will enable Save button     */    $('.quantita').keypress(function(e) { // text written        enableChgCheckbox(this);    });    $('.quantita').keyup(function(e) {        if (e.keyCode == 8 || e.keyCode == 46) { //backspace and delete key            enableChgCheckbox(this);        } else { // rest ignore            e.preventDefault();        }    });    $('.quantita').bind('paste', function(e) { // text pasted        enableChgCheckbox(this);    });	    	$(':checkbox').change(function(e) { // radio changed		enableAggiorna();		    });}	function enableChgCheckbox(t_this){	//alert("enableSaveBtn");		var tr_id = $(t_this).closest("tr").attr('id'); 		console.log("tr id_"+tr_id);		tr_id=tr_id.replace('id_','');			$("#chg"+tr_id).prop('checked', true);		enableAggiorna();	}function enableAggiorna(){		var numberOfChecked = $('input:checkbox:checked').length;		console.log ("Modificati :"+numberOfChecked);		$("#aggiorna").val("Aggiorna magazzino di "+numberOfChecked+" articoli");		if (numberOfChecked>0){			$("#aggiorna").prop("disabled",false);		}		else{			$("#aggiorna").prop("disabled",true);		}}							} );		</script>    <%end if%></form>          <%else          end if                    call connclose()          %> <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><script type="text/javascript" src="Jquery/js/select2.js"></script>  <script type="text/javascript">$(document).ready(function () {	function attiva_select2(Url,Placeholder){		  	$('#idsettore').select2({				placeholder: Placeholder,				minimumInputLength: 1,				//allowClear: true,				ajax: {					quietMillis: 150,	  			url: Url,					dataType: 'json',					data: function (term, page) {						return {							term: term						};					},					results: function (data) {												return {							results: data						};					}				}			});		}	$('#idsettore').on("select2-selecting", function(e) {		var idsettore = e.object.id;		if($("#selezione").val()=="A")		{		  	$('#idprod').val(idsettore);		}		else if($("#selezione").val()=="F")    	{			$('#idfornitore').val(idsettore);    	}    	else    	{			$('#idsettore').val(idsettore);	    	    	}		$("#form1").submit();    });    $("#selezione").on('change', function() {	    		if($("#selezione").val()=="A")		{		  	attiva_select2("ajax_function.asp?select2=articoli_sel2","Cerca articolo");		}			else if($("#selezione").val()=="F")    	{		  	attiva_select2("ajax_function.asp?select2=fornitori_sel2","Cerca fornitore");    	}    	else    	{		  	attiva_select2("ajax_function.asp?select2=settori", "Cerca settore");	    	    	}    });	if($("#selezione").val()=="A")	{	  	attiva_select2("ajax_function.asp?select2=articoli_sel2","Cerca articolo");	}	else if($("#selezione").val()=="F")	{	  	attiva_select2("ajax_function.asp?select2=fornitori_sel2","Cerca fornitore");	}	else	{	  	attiva_select2("ajax_function.asp?select2=settori", "Cerca settore");    		}        });</script></body></html><%function aggiungi_virgola(str_A, str_B)	dim virgola	virgola=""	if str_A<>"" then virgola=","	aggiungi_virgola=str_A&virgola&str_Bend functionsub mappacatselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM settori WHERE idpadre = " & id &" and idsettore<>"&escludi&" order by nome_settore;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("idsettore") &""""		if int(val)=int(rs_order("idsettore")) then response.write " selected"		response.write ">" &spaceing& rs_order("nome_settore")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappacatselezione(layer+1,rs_order("idsettore"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	sub rigamagazzino(idmag,quantita_magazzino,quantita_riordino,idpro,codice,articolo,prezzo,variante_a,variante_b,data_aggiornamento,db_ven,db_acq,idvara,idvarb,quantita_meno_uno,quantita_meno_due)dim stileif instr(stringa_idmag,"|"&idmag&"|")=0 then	if stringa_idmag="" then stringa_idmag="|"	stringa_idmag=stringa_idmag&idmag&"|"	stile=""	if quantita_magazzino<quantita_riordino then stile="style='background:red;''"	if idpro_tmp<>idpro or singolo then		nuovo=true		idpro_tmp=idpro	else		nuovo=false	end if	classe_db_ven=""	if db_ven=1 then		readonly=" readonly"		stile="style='background:gray; text-align: right;'"		classe_db_ven="db_ven"	elseif db_acq=1 then		stile="style='background:yellow; text-align: right;'"		readonly=""		stile_bordo=""			else		stile="style='text-align: right;'"		readonly=""		stile_bordo=""	end if	if dentro_db then		for n=1 to livello		'icona=icona&"<span class=""ui-icon ui-icon-carat-1-sw"" style=""float: left; ""></span>"		icona=icona&"&gt; &nbsp; "		next	else		icona=""		livello=0	end if	%>            <tr id="id_<%=idmag%>" class="<%=classe_db_ven%>"> 			<td style="border-bottom: 1px solid;" nowrap><%=icona%><%if idpro_tmp<>"" and nuovo then%><input type="hidden" name="idpro" value="<%=idpro_tmp%>"/><%end if %><input name="test<%=idmag%>" type="hidden" value="si" /><%if nuovo then%><a href="#<%=idmag%>" class="menu_idpro" data-idmag="<%=idmag%>" data-idpro="<%=idpro%>" data-menu-escludi="g"><%=codice%></a><%end if%></td>			<td style="border-bottom: 1px solid; "><%if nuovo then%><input name="testidpro<%=idpro_tmp%>" type="hidden" value="si" /><%=articolo%><%end if%></td>            <td style="border-bottom: 1px solid; "><%if nuovo then%><%=formatnumber(prezzo,2)%><%end if%></td>              <td align="right" style="border-bottom: 1px solid; "><%=variante_a%></td>                          <td align="center" style="border-bottom: 1px solid; "><%=variante_b%></td>              <td align="right" style="border-bottom: 1px solid;  white-space: nowrap;" ><%if db_ven=0 then %><input type="checkbox" name="chg" id="chg<%=idmag%>" value="<%=idmag%>"><%end if %> <input type="text" name="quantita<%=idmag%>" value="<%=quantita_magazzino%>" <%=stile%> size="7" <%=readonly%> class="quantita"/><%if session("iduser")=1 then response.write "/"&idmag%> </td>                            <td align="center" style="border-bottom: 1px solid; "><%if isnull(data_aggiornamento) then%>Mai<%else%> <%=formatdatetime(data_aggiornamento,2)%><%end if%></td>                                          <td align="center" style="border-bottom: 1px solid; "><%=quantita_meno_uno%></td>              <td align="center" style="border-bottom: 1px solid; "><%=quantita_meno_due%></td>              <td align="center" style="border-bottom: 1px solid; "><%if db_ven=0 then %><input type="text" name="riordino<%=idmag%>" value="<%=quantita_riordino%>" size="4" class="quantita"/><%end if %></td>            </tr>            <% 				if true then			if db_ven=1  then				dentro_db=true						sql="select distinta_base.* from distinta_base WHERE (((distinta_base.idpro_ven)="&idpro&") AND ((distinta_base.idvara_ven)="&idvara&") AND ((distinta_base.idvarb_ven)="&idvarb&"));"									set rs_db=conn.execute (sql)			if rs_db.eof then				call add2log("Non trovato db per "&sql,0)			else				livello=livello+1				 do while not rs_db.eof					'esegui nuovo loop su magazzino							sql="select prodotti.IDpro, prodotti.codice, prodotti.articolo, prodotti.prezzo, magazzino.*, varianti_a.variante_a, varianti_b.variante_b FROM ((magazzino RIGHT JOIN prodotti ON magazzino.idpro = prodotti.IDpro) LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara) LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb where magazzino.idpro="&rs_db("idpro_acq") &" and magazzino.idvara="&rs_db("idvara_acq")&" and magazzino.idvarb="&rs_db("idvarb_acq")														sql="select magazzino.*, prodotti.codice, prodotti.articolo, prodotti.prezzo, varianti_a.variante_a,varianti_b.variante_b,  storico_ordini.quantita_meno_uno,storico_ordini.quantita_meno_due from (((magazzino left join prodotti on magazzino.idpro = prodotti.idpro ) left JOIN varianti_a on magazzino.idvara = varianti_a.idvara ) left join varianti_b on magazzino.idvarb = varianti_b.idvarb) left join (select ordini_dett.idpro, ordini_dett.idvara, ordini_dett.idvarb, sum(case when year(data) = 2015 then quantita else 0 end) AS quantita_meno_uno, sum(case when year(data) = 2014 then quantita else 0 end) AS quantita_meno_due  FROM ordini_dett INNER JOIN ordini ON ordini_dett.idord = ordini.idord  where ordini.stato=6 and  ordini.eliminato=0 and ordini.verde=false GROUP BY ordini_dett.idpro, ordini_dett.idvara, ordini_dett.idvarb) as storico_ordini on magazzino.idpro = storico_ordini.idpro and magazzino.idvara = storico_ordini.idvara and magazzino.idvarb = storico_ordini.idvarb where magazzino.idpro="&rs_db("idpro_acq") &" and magazzino.idvara="&rs_db("idvara_acq")&" and magazzino.idvarb="&rs_db("idvarb_acq")																					set rs2=conn.execute (sql)							if not rs2.eof then								call rigamagazzino(rs2("idmag"),rs2("quantita_magazzino"),rs2("quantita_riordino"),rs2("idpro"),rs2("codice"),rs2("articolo"),rs2("prezzo"),rs2("variante_a"),rs2("variante_b"),rs2("data_aggiornamento"),rs2("db_ven"),rs2("db_acq"),rs2("idvara"),rs2("idvarb"),rs("quantita_meno_uno"),rs("quantita_meno_due"))							end if					rs_db.movenext				loop			dentro_db=false			end if											end if	end ifelse	if utente_andrea then response.write "<tr class=""db_acq""><td colspan=""10"" style=""border-bottom: 1px solid;"" >"&codice&" "&articolo&" "&variante_a&" "&variante_b&" gi&agrave; visualizzato</td></tr>"end ifend sub						%>