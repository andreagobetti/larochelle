<!--#include virtual="/md5-2.asp"--><!--   http://webdesign.tutsplus.com/articles/creating-a-simple-responsive-html-email--webdesign-12978 --><!--#include virtual="/setup.asp" --><%		if request.form("invia")<>"" then				call invia_mail_registrazione(1)response.write "Email inviata"end if%><form action="<%=questofile%>" method="post">		Email:	<input type="text" name="email" value=""><input type="submit" name="invia" value="Invia">		</form><%		sub invia_mail_registrazione(id)	set fs=Server.CreateObject("Scripting.FileSystemObject")	filename=Server.MapPath("/email/login_inline.html")	if fs.FileExists(filename) then					set t=fs.OpenTextFile(filename,1,false)		html=t.ReadAll		t.close	else		response.write "Il file non esiste:"&filename	end if				dim h	set h = new MD5	dim txt_error	txt_error=""	sql="select utenti.* FROM utenti where iduser=" & id	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 1, 3	if request.QueryString("test")="" then			'Genera password con numero casuale			dim temp_passw					temp_passw=gen_passw()			'rs("password_md5")=h.hash(temp_passw)			'rs.update	end if		'Modifico il testo	html=replace(html,"[title]","Registrazione su " & nomesito)	link="http://" & lcase(nomesito) & "/images/logo_email.png"	html=replace(html,"[logo]",link)			html=replace(html,"[nomesito]",nomesito)	html=Replace(html,"[nome]",rs("nome"))	html=replace(html,"[user]",rs("email"))	html=replace(html,"[password]",temp_passw)		link="http://" & lcase(nomesito) & "/login.asp?email_login=" & rs("email") & "&pass=" & temp_passw	html=replace(html,"[link]",link)	html=replace(html,"[footer]",Application("intestazione_ddt"))			'Response.Write(html)						Const cdoSendUsingMethod        = "http://schemas.microsoft.com/cdo/configuration/sendusing"	Const cdoSendUsingPort          = 2	Const cdoSMTPServer             = "http://schemas.microsoft.com/cdo/configuration/smtpserver"	Const cdoSMTPServerPort         = "http://schemas.microsoft.com/cdo/configuration/smtpserverport"	Const cdoSMTPConnectionTimeout  = "http://schemas.microsoft.com/cdo/configuration/smtpconnectiontimeout"	Const cdoSMTPAuthenticate       = "http://schemas.microsoft.com/cdo/configuration/smtpauthenticate"	Const cdoBasic                  = 1	Const cdoSendUserName           = "http://schemas.microsoft.com/cdo/configuration/sendusername"	Const cdoSendPassword           = "http://schemas.microsoft.com/cdo/configuration/sendpassword"	Dim objConfig	Dim objMessage	Dim Campi	Set objConfig = Server.CreateObject("CDO.Configuration")	Set Campi = objConfig.Fields	With Campi	.Item(cdoSendUsingMethod)       = cdoSendUsingPort	.Item(cdoSMTPServer)            = SMTPServer	.Item(cdoSMTPServerPort)        = 25	.Item(cdoSMTPConnectionTimeout) = 30	.Update	End With	Set objMessage = Server.CreateObject("CDO.Message")	Set objMessage.Configuration = objConfig	objMessage.Bodypart.Charset = "UTF-8"		'EMAIL AL VISITATORE	'sql="select * from news where stato='0' and tipo='E0' order by ordine;"	'set rsb=conn.execute(sql)	'if not rsb.eof then	'	HTML = HTML &rsb("testo")	'else	'	add2log "Manca testo per email di registrazione (0)",2	'end if	'rsb.close	'set rsb= nothing		objMessage.To =  rs("email")	objMessage.From = nomesito  & "<" & Application("email_sito") & ">"	objMessage.Subject = "Registrazione su " & nomesito	objMessage.HtmlBody = html	on error resume next	objMessage.Send	If err.number <> 0 Then		add2log "Errore invio email di registrazione a [utente="&rs("iduser")&"]"&nominativo(rs("nome"),rs("cognome"),rs("azienda"))&"[/utente]"&" Email:"&rs("email"),3		txt_error=" (invio email di regitrazione fallito)"			else		add2log "Inviata email di registrazione a [utente="&rs("iduser")&"]"&nominativo(rs("nome"),rs("cognome"),rs("azienda"))&"[/utente]"&vbcrlf&"Email:"&rs("email"),2		rs("password_inviata")=now()		rs.update			End If	Set objMessage = Nothing					set fs=Server.CreateObject("Scripting.FileSystemObject")	filename=Server.MapPath("/email/loginadmin_inline.html")	if fs.FileExists(filename) then		set t=fs.OpenTextFile(filename,1,false)		html=t.ReadAll		t.close	else		response.write "Il file non esiste:"&filename	end if	'Modifico il testo	html=replace(html,"[title]","Nuova registrazione su " & nomesito)	link="http://" & lcase(nomesito) & "/images/logo_email.png"	html=replace(html,"[logo]",link)			html=replace(html,"[nomesito]",nomesito)	html=Replace(html,"[nominativo]",rs("nome")&" "&rs("cognome"))	html=replace(html,"[email]",rs("email"))	html=replace(html,"[telefono]",rs("telefono"))		link="http://" & lcase(nomesito) & "/pag_adm_user.asp?iduser=" & id	html=replace(html,"[link]",link)	html=replace(html,"[footer]",Application("intestazione_ddt"))					'EMAIL AL GESTORE	Set objMessage = Server.CreateObject("CDO.Message")	Set objMessage.Configuration = objConfig	objMessage.Bodypart.Charset = "UTF-8"	objMessage.From = nomesito  & "<" & Application("email_sito") & ">"	'objMessage.to = Application("email_sito")	objMessage.to = request.form("email")	objMessage.Subject = "Nuova registrazione su " & nomesito&txt_error	objMessage.HtmlBody = HTML	objMessage.Send	Set objMessage = Nothing	'add2log "Inviata email di registrazione a [utente="&rs("iduser")&"]"&nominativo(rs("nome"),rs("cognome"),rs("azienda"))&"[/utente]"&vbcrlf&"Email:"&rs("email"),2	rs.close	Set rs = Nothingend sub%>