<%		if request.form("invia")<>"" then		str_form=""		For Each item In Request.Form		   str_form= str_form&"" & item & "=1," 		Next				sessioN("permessi")=str_form		response.write str_form	end if	permessi=sessioN("permessi")%><form action="<%=questofile%>" method="post">		Permessi:	<table>	<tr>        <td colspan="3" class="ui-widget-header">Permessi specifici</td>      </tr>			<tr>        <td colspan="3" style="background-color: #E5E5E5 ">Articoli</td>	</tr>			<tr>        <td>Crea, modifica</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"A1=1")>0 then val=" checked"				%>			<input name="A1" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Modifica prezzo di vendita</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"A2=1")>0 then val=" checked"				%>			<input name="A2" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Visualizza prezzo di acquisto e ricarico</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"A3=1")>0 then val=" checked"				%>			<input name="A3" id="a3" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Modifica prezzo di acquisto</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"A4=1")>0 then val=" checked"				%>			<input name="A4" id="a4" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Visualizza, modifica fornitore</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"A5=1")>0 then val=" checked"				%>			<input name="A5" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td colspan="3" style="background-color: #E5E5E5 ">Fatture e ddt</td>	</tr>			<tr>        <td>Crea, modifica</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"B1=1")>0 then val=" checked"				%>			<input name="B1" id="b1" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Visualizza, scarica versioni pdf</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"B2=1")>0 then val=" checked"				%>			<input name="B2" id="b2" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td colspan="3" style="background-color: #E5E5E5 ">Ordini e preventivi</td>	</tr>			<tr>        <td>Crea, modifica</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"C1=1")>0 then val=" checked"				%>			<input name="C1" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Cambio lo stato</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"C2=1")>0 then val=" checked"				%>			<input name="C2" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Annulla (fino a stato lavorazione)</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"C3=1")>0 then val=" checked"				%>			<input name="C3" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Elimina</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"C4=1")>0 then val=" checked"				%>			<input name="C4" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td colspan="3" style="background-color: #E5E5E5 ">Ordini a fornitore</td>	</tr>			<tr>        <td>Crea, modifica, cambia stato</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"D1=1")>0 then val=" checked"				%>			<input name="D1" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Visualizza</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"D2=1")>0 then val=" checked"				%>			<input name="D2" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td colspan="3" style="background-color: #E5E5E5 ">Clienti</td>	</tr>			<tr>        <td>Crea, modifica</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"E1=1")>0 then val=" checked"				%>			<input name="E1" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Visualizza</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"E2=1")>0 then val=" checked"				%>			<input name="E2" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<%if mod_dip then %>	<tr>        <td colspan="3" style="background-color: #E5E5E5 ">Dipendenti</td>	</tr>			<tr>        <td>Crea, modifica dipendente</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"E3=1")>0 then val=" checked"				%>			<input name="E3" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Aggiunge, modifica misure</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"E4=1")>0 then val=" checked"				%>			<input name="E4" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>			<%end if %>	<tr>        <td colspan="3" style="background-color: #E5E5E5 ">Magazzino</td>	</tr>			<tr>        <td>Modifica giacenze</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"F1=1")>0 then val=" checked"				%>			<input name="F1" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Visualizza giacenze</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"F2=1")>0 then val=" checked"				%>			<input name="F2" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td colspan="3" style="background-color: #E5E5E5 ">Privilegi admin</td>	</tr>			<tr>        <td>Imposta privilegi</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"Z1=1")>0 then val=" checked"				%>			<input name="Z1" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>			<tr>        <td>ADMIN irrevocabile</td>        <td>&nbsp;</td>        <td><%				val=""				if instr(permessi,"Z2=1")>0 then val=" checked"				%>			<input name="Z2" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>	</table><input type="submit" name="invia" value="Invia">		</form>