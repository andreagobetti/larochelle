<!--#include virtual="/setup.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()'response.write request.formif request.form("modifica")<>"" then	idord=request.form("modifica")	sql="select * FROM ordini WHERE ordini.idord="& idord&";"	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 3, 3	comunicazioni_precedenti= now()&" <b>"&session("nominativo")&"</b>: ripristinato da eliminazione"	if isnull(rs("comunicazioni_precedenti")) or len(trim(rs("comunicazioni_precedenti")))=0  then		rs("comunicazioni_precedenti")=comunicazioni_precedenti	else		rs("comunicazioni_precedenti")=rs("comunicazioni_precedenti")&"<hr />"& comunicazioni_precedenti	end if		rs("eliminato")=false	rs.update	rs.close	response.redirect "pag_adm_ordini.asp?idord="&idordend ifoper="view"tabella="ordini"tabellaid="idord"%><!--#include virtual="/regioni_inc.asp" --><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" /><!--#include virtual="/sub_head.asp" --></head><body><div id="wrap"><div id="header"><%=titolo_top%>         <!-- Box CORPO INIZIO-->	  	  <%barra=4%><div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Recupero ordini eliminati</a></div></div>    <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;" >        <!-- Colonna CORPO INIZIO-->    <%if oper="view" then		sql="select * from ordini where eliminato=1"		if request.querystring("iduser")<>"" then			sql=sql & " where idord=" & request.querystring("idord")&""		end if		cercain=request("cercain")		cerca=request("cerca")		ordine=" order by idord desc"		'-----------sezione ricerca inizio		if cercain<>"" then			select case cercain			case "stato0"				sql1=" stato='0'"			case "stato1"				sql1=" stato='1"			case "stato2"				sql1=" stato='2'"			case "stato3"				sql1=" stato='3'"			case "idord"				sql1=" idord="&cerca			case "iduser"				sql1=" iduser="&cerca			case else				if cercain<>"" then	sql1=" InStr([" & cercain &"],'" & cerca& "')>0"			end select			if instr(sql,"where")=0 then				sql1=" where eliminato=0 and " & sql1			else				sql1=" and " & sql1			end if			sql=sql & sql1		end if		order="&cercain="&cercain&"&cerca="&cerca		'-----------sezione ricerca fine		'response.write sql		call paginazione_start(sql&ordine,50,"access")		%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" bordercolor="#CCCCCC" class="tabella1">      <tr>        <td colspan="5"> Cerca          <input type="text" name="cerca" style="FONT: 12px;" value="<%=cerca%>">          in          <select name="cercain" style="FONT: 12px;" onChange="this.form.submit()">            <option value="" <%if cercain="" then response.write "selected"%>>Visualizza tutti</option>            <option value="idord" <%if cercain="idord" then response.write selected%>>N°ordine</option>            <option value="iduser" <%if cercain="iduser" then response.write selected%>>ID cliente</option>          </select>          <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;"></td>      </tr>      <tr>        <td align="center" bgcolor="#E5E5E5"><p> Ripristina</p></td>        <td align="center" bgcolor="#E5E5E5">N&deg; ordine/Data</td>        <td bgcolor="#E5E5E5">Stato</td>        <td align="left" bgcolor="#E5E5E5">Azienda/Indirizzo/Citt&agrave;/Regione</td>                     <td bgcolor="#E5E5E5">Nominativo/Email</td>           </tr>      <%iRecordsShown = 0Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>      <tr class=coprobox>        <td align="center" style="border-bottom:1px solid;"><input type="radio" name="modifica" value="<%=objPagingRS("idord")%>" onClick="this.form.submit()"></td>        <td align="center" style="border-bottom:1px solid;"><%=objPagingRS("nord")%><br>          <%=objPagingRS("data")%></td>        <td align="center" style="border-bottom:1px solid;"><b><%'=stato_ordine(objPagingRS("stato"))%></b></td>                <td style="border-bottom:1px solid;"><b><%=objPagingRS("azienda")%></b><br>          <%=objPagingRS("Indirizzo")%> <br><%=objPagingRS("citta")%> (<%=objPagingRS("provincia") & ") - " & regione(objPagingRS("regione"))%></td>        <td style="border-bottom:1px solid;"><b><%=objPagingRS("cognome")%>&nbsp;<%=objPagingRS("nome")%></b><br>          </td>          </tr>      <% 			iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(4,true)	%>          </table>    <%elseend if%>    <!-- Colonna CORPO FINE-->    </form></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div>  </body></html><%rsClose%>