ETE FROM log WHERE causale<1 and data<now() - INTERVAL 30 DAY;"		conn.execute sql,num		if num>0 then txt=txt&"Eliminato "&num&" EVENTI LOG livello <1 più vecchi di 30 giorni<br>"		sql="DELETE FROM log WHERE causale=1 and data<now() - INTERVAL 90 DAY;"		conn.execute sql,num		if num>0 then txt=txt&"Eliminato "&num&" EVENTI LOG livello 1 più vecchi di 90 giorni<br>"								'PRENOTAZIONI		sql="DELETE FROM record_locking WHERE fine<now()-- INTERVAL 5 DAY;"		conn.execute sql,num		if num>0 then txt=txt&"Eliminato "&num&" PRENOTAZIONI più vecchie di 5 giorni<br>"						'utenti MAI ACCEDUTI		giorni=180		sql="select utenti.*, utenti.numvisit, utenti.fornitore, utenti.Data, ordini.idord, preventivi.idord FROM (utenti LEFT JOIN ordini ON utenti.iduser = ordini.iduser) LEFT JOIN preventivi ON utenti.iduser = preventivi.iduser WHERE utenti.numvisit=0 AND utenti.non_eliminare=0 AND utenti.fornitore=0  AND ordini.idord Is Null AND preventivi.idord Is Null AND (utenti.Data<now()- interval "&giorni&" day)"		set rs_utenti=conn.execute(sql )		do while not rs_utenti.eof			call concatena_stringa(txt ,"<br>", elimina_utente(rs_utenti("iduser")) )			rs_utenti.MoveNext		loop		rs_utenti.close		set rs_utenti=nothing								'utenti con ultimo accesso più vecchio di		giorni=1800		sql="select utenti.*, utenti.fornitore, utenti.Lastvisit, ordini.idord, preventivi.idord FROM (utenti LEFT JOIN ordini ON utenti.iduser = ordini.iduser) LEFT JOIN preventivi ON utenti.iduser = preventivi.iduser WHERE utenti.fornitore=0 AND utenti.non_eliminare=0 AND ordini.idord Is Null AND preventivi.idord Is Null AND ((utenti.Lastvisit)<now()- interval "&giorni&" day)"		set rs_utenti=conn.execute(sql )		do while not rs_utenti.eof			call concatena_stringa(txt ,"<br>", elimina_utente(rs_utenti("iduser")) )			rs_utenti.MoveNext		loop		rs_utenti.close		set rs_utenti=nothing						'ordini		set rs_ordini=conn.execute("select * from ordini where (ordini.data<now()- interval 180 day) and (eliminato=1)" )		do while not rs_ordini.eof			sql="DELETE   FROM ordini_dett WHERE idord=" & rs_ordini("idord")			conn.execute(sql)			sql="DELETE   FROM ordini_dett_originale WHERE idord=" & rs_ordini("idord")			conn.execute(sql)			sql="DELETE   FROM incassi WHERE idord=" & rs_ordini("idord")			conn.execute(sql)			rs_ordini.MoveNext		loop		rs_ordini.Close		sql="DELETE  from ordini where (ordini.data<now()- interval 180 day) and (eliminato=1)" 		conn.execute sql,num		if num>0 then txt=txt&"Eliminato "&num&" ordini eliminati più vecchi di 180 giorni<br>"		set rs_ordini=nothing				sql="DELETE ordini_dett_originale FROM ordini INNER JOIN ordini_dett_originale ON ordini.idord = ordini_dett_originale.idord WHERE (((ordini.Data)<now()- interval 60 day) and ordini.stato=6);"		conn.execute sql,num		if num>0 then txt=txt&"Eliminato "&num&" dettaglio ordini originale per ordini evasi più vecchi di 60 giorni<br>"								'prodotti		sql="DELETE from prodotti where (data<now() - interval 2 day) and isnull(datamod)"		conn.execute sql,num				'Prodotti in promozione		sql="SELECT prodotti.idpro,prodotti.codice, prodotti.articolo  from prodotti WHERE (((prodotti.Prodata)<curdate()) and prodotti.Promozione = 1);"		set rs_prodotti=conn.execute (sql)		testotmp=""		corpoHTML=""		do while not rs_prodotti.eof			testotmp=testotmp&rs_prodotti("codice")&" "&rs_prodotti("articolo")&"<br>"			rs_prodotti.movenext		loop		set rs_prodotti=nothing		if testotmp<>"" then			testotmp="Prodotti rimossi dall'elenco prodotti in promozione per superamento data:<br>"& testotmp			corpoHTML=corpoHTML&testotmp			txt=txt&testotmp			sql="UPDATE prodotti SET prodotti.Promozione = 0 WHERE (((prodotti.Prodata)<curdate()) and prodotti.Promozione = 1);"			conn.execute sql,num			txt=txt&num&" prodotti rimossi<br>"		end if						'Prodotti novità		sql="SELECT prodotti.idpro,prodotti.codice, prodotti.articolo  from prodotti WHERE (((prodotti.novdata)<curdate()) and prodotti.novita = 1);"		set rs_prodotti=conn.execute (sql)		testotmp=""		do while not rs_prodotti.eof			testotmp=testotmp&rs_prodotti("codice")&" "&rs_prodotti("articolo")&"<br>"			rs_prodotti.movenext		loop		set rs_prodotti=nothing		if testotmp<>"" then			testotmp="Prodotti rimossi dall'elenco prodotti nuovi per superamento data:<br>"& testotmp			corpoHTML=corpoHTML&testotmp			txt=txt&testotmp			sql="UPDATE prodotti SET prodotti.novita = 0  WHERE (((prodotti.novdata)<curdate()) and prodotti.novita = 1);"			conn.execute sql,num			txt=txt&num&" prodotti rimossi<br>"		end if				'CARRELLO		sql="DELETE  from carrello where (data<now()- interval 10 day) and isnull(iduser)"		conn.execute sql,num		if num>0 then txt=txt&"Eliminato "&num&" voci carrello di utenti non registrati più vecchie di 10 giorni<br>"		'IP_BANNATI		sql="DELETE from ip_bannati where (ultima_visita<now()- interval 30 day)"		conn.execute sql,num		if num>0 then txt=txt&"Eliminato "&num&" ip bannati<br>"		if corpoHTML<>"" then			reset_contenuti_home()			call invia_email("tutti","Notifica",corpoHTML)			txt=txt&"Inviata mail:"&corpoHTML&"<br>"		end if				if false then			conn.Close			set conn=nothing			if fs.FileExists(compact) then				fs.DeleteFile compact			end if			gravitaLog=2			txt=txt&CompressDB(dbpath,compact)			Set fs = nothing		end if	else		txt="Pulizia non eseguita minuti:"&minuti&" scheduled:"&scheduled&"query"&queryeform()			end if	'Set conn = Server.CreateObject("ADODB.Connection")	'conn.Open mdb	sql="select * from impostazioni"	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 3, 3	rs.movefirst	Application("ultimo_backup")=now()	rs("ultimo_backup")=Application("ultimo_backup")	rs.update	rs.close	Set rs = Nothing	call carica_ip_bannati()			txt=txt&"<br>"&"Eseguito in:"&FormatNumber(timer() - t_inizio, 2)	add2log txt,gravitaLog	if scheduled then		response.write "eseguito"		call connclose()		response.end	end if		pulizia=txt	end function	function CompressDB(dbpath,destPath)	'se errore nella creazione del backup esci senza ulteriori operazioni	'compatto il db in un file di appoggio	'on error resume next	dim objCompact	set objCompact = Server.CreateObject("JRO.JetEngine")	'response.Write(dbpath&"<br>"&destpath&"<br />")	objCompact.CompactDatabase "Provider=Microsoft.Jet.OLEDB.4.0;" &_  	 "Data source=" &  dbpath, _	   "Provider=Microsoft.Jet.OLEDB.4.0;" &_  	 "Data source=" & destPath	 if err.number<>0 then			CompressDB="Impossibile compattare il database<br>Errore:"&Err.Description&"<br />"&destPath				gravitaLog=3	else		startSize = Getfilesize(dbPath)		endSize = Getfilesize(destPath)		CompressDB="Dimensione prima della compressione:"&startSize&"<br>Dimensione dopo la compressione:"&endSize&"<br>"		dim objFSO		set objFSO = Server.CreateObject("Scripting.filesystemObject")		objFSO.copyfile destPath, dbPath, true		'se esiste sovrascrivilo		set objFSO = nothing 		if err.number<>0 then			CompressDB="Impossibile copiare il database compattato sull'originale<br>Errore:"&Err.Description&"<br />"			gravitaLog=3		end if		'elimino il DB di backup (di appoggio)		errcode = DeleteDB(destPath)	end ifend function'************************************************************************************************function Getfilesize(filepath)  dim fso, f  set fso = Server.CreateObject("Scripting.filesystemObject")  set f = fso.GetFile(filepath)  Getfilesize = FormatNumber(f.Size/1024, 2)  set f = nothing  set fso = nothingend function'************************************************************************************************function DeleteDB(dbpath)	'on error resume next	dim objFSO	set objFSO = Server.CreateObject("Scripting.filesystemObject")	objFSO.deletefile(dbpath)	set objFSO = nothing 	if err.number<>0 then		DeleteDB = -1	end ifend function'************************************************************************************************function mezzanotte()dim intOraintOra=datepart("h", time() )if intOra=0 or intOra=23 then	mezzanotte=trueelse	mezzanotte=falseend ifend functionFunction NumeroSettimanaCorrente()    Dim nsa_anno    nsa_anno = DatePart("yyyy", Now())    NumeroSettimanaCorrente = DateDiff("ww", "1/1/" & nsa_anno, Now()) + 1End Function%>