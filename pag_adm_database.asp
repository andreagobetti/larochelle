<!--#include virtual="/setup.asp" --><%if not utente_admin then call login()if request.form("sql")<>"" then conn.execute(request.form("sql"))%><!--#include virtual="/sub_head_adm.asp" --></head><body> <div id="wrap"><div id="header"><%=titolo_top%><div id="barra_fissa">  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Database</a></div></div>                <!-- Tabella centrale CORPO INIZIO-->                       <table width="100%" border="0" cellspacing="0" cellpadding="2" class="tabella1"><%	sql="select * from impostazioni order by id"	set rs_impostazioni=conn.execute(sql)%>          <tr>            <td colspan="3" align="center">	            <a href="pag_adm_aggiorna_db.asp" target="_blank"><strong>Aggiorna DB</strong></a>	            	            <a href="pag_adm_bkdb.asp"><strong>Backup Database</strong></a> <a href="pag_adm_bkdb.asp?comprimi=si"><strong>Backup e compatta Database</strong></a><br> Ultimo backup: <%=Application("ultimo_backup")%> Ultimo riavvio server: <%=Application("riavvio_server")%> Versione: <%=rs_impostazioni("versione")%>                                    </td>          </tr>          <%	          set rs_impostazioni=Nothing	          %>          <tr>            <td colspan="3">&nbsp;</td>          </tr>        </table><%				if request("orderby")="" then			orderby="sizeinmb desc"		elseif request("orderby")="table_name" then			orderby="table_name"		elseif request("orderby")="table_name" then			orderby="sizeinmb desc"		end if        set rs=conn.execute ("SELECT table_name, table_rows, data_length, index_length, round(((data_length + index_length) / 1024 / 1024),2) as sizeinmb FROM information_schema.TABLES where table_schema = '"&mysql_database&"' order by "&orderby&" ;")            totale=0          %>          <br>          <%	          	        dimensione_db=cdbl(conn.execute("SELECT  ROUND( SUM( data_length + index_length ) /1024 /1024, 1 )  'DB Size in MB' FROM information_schema.tables  where table_schema='"&mysql_database&"';")(0))	          	          	          %>        <table width="100%" border="0" cellspacing="0" cellpadding="2" class="tabella1">        <tr>          <td colspan="6">Database <%=mysql_database%> dimensione: <%=dimensione_db%>MB</td>        </tr>	                <tr>          <td class="c1"><a href="<%=questofile%>?orderby=table_name">table_name</a></td>          <td class="c1">table_rows</td>          <td class="c1">data_length</td>          <td class="c1">index_length</td>          <td class="c1"><a href="<%=questofile%>?orderby=size">Size in MB</a></td>          <td class="c1">%</td>        </tr><%            do while not rs.eof  %>        <tr align="right">          <td align="left"><%=rs(0)%></td>          <td><%=rs(1)%></td>        <td><%=rs(2)%></td>          <td><%=rs(3)%></td>          <td><%=rs(4)%></td>          <td><%=formatnumber(cdbl(rs(4))/dimensione_db*100,2)%></td>        </tr><%        	totale=totale+cdbl(rs(4))            rs.movenext            loop            set rs=Nothing        %>      </table>      <%            response.write "Dimensione totale:"&totale%>								<%if utente_andrea then %>        <table width="100%" border="0" cellspacing="0" cellpadding="2" class="tabella1">          <tr>            <td class="ui-widget-header">Area tecnica/livello utente:<%=session("ADMIN_L")%></td>          </tr>          <tr>            <td><form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" ><input type="text" name="sql" /><input type="submit" name="oper" value="Invia"></form></td>          </tr>        </table>        <%end if %>        <!-- Tabella centrale CORPO FINE--></td>    <%  	          call connclose()  %></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>