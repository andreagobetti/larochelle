<!--#include virtual="/paginazione.asp" --><%sub elenco_articoli()	dim marcamodello, tags	marcamodello=false	tags=true	prezzo_nascosto=0								testo=trim(request("testocerca"))								idsettore=cint(idsettore)								'idtag=request("idtag")								'if sessioN("iduser")=1 then response.write "idsettore:"&idsettore								if idtag<>"" and idsettore>0 then									caso="Idtag e idsettore"									'Elenco per tag									strSql="select prodotti.*, prodotti_tags.idtag, settori_prodotti.IDsettore FROM prodotti_tags INNER JOIN (prodotti INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro) ON prodotti_tags.idpro = settori_prodotti.IDpro WHERE (((prodotti_tags.idtag)="&idtag&") AND ((settori_prodotti.IDsettore)="&idsettore&")) "									'ordinaPer=4								elseif idtag<>"" or idtag>0 then									caso=2									'Elenco per tag									strSql="select  prodotti.*, prodotti_tags.idtag FROM prodotti INNER JOIN prodotti_tags ON prodotti.IDpro = prodotti_tags.idpro WHERE prodotti_tags.idtag="&idtag									ordinaPer=4								elseif idmodello<>"" and idsettore>0 then									caso="idmodello e idsettore"									idmodello=clng(idmodello)									strsql="select prodotti.*, settori_prodotti.IDsettore, prodotti_marca_modello.idmodello FROM (prodotti INNER JOIN prodotti_marca_modello ON prodotti.IDpro = prodotti_marca_modello.idpro) INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro where visibilita=0 and IDsettore="&idsettore&" and idmodello="&idmodello								elseif idsettore>0 then									caso="Solo idsettore"									strSql="select prodotti.*, settori_prodotti.IDsettore FROM prodotti INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro  where visibilita=0 and IDsettore="&idsettore									set rs_settore=conn.execute ("select settori.* from settori where idsettore="&idsettore)									marcamodello=rs_settore("marcamodello")									prezzo_nascosto=rs_settore("nascondi_prezzi")									idpro_virtuali=rs_settore("idpro_virtuali")									set rs_settore= Nothing									sql="select count(*) from settori_prodotti where idsettore="&idsettore									n_articoli=clng(conn.execute(sql)(0))									if n_articoli>0 or idpro_virtuali="" then										strSql="select prodotti.*, settori_prodotti.IDsettore FROM prodotti INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro  where visibilita=0 and IDsettore="&idsettore									else										strSql="select prodotti.*, settori_prodotti.IDsettore FROM prodotti INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro  where visibilita=0 and prodotti.idpro in("&idpro_virtuali&")"									end if								elseif idsettore=-2 and session("idadmin")<>"" then									caso=5									'Elenco non attivi									strSql="select DISTINCTROW prodotti.*, settori_prodotti.IDsettore FROM prodotti INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro  where attivo=false and codice<>''"									strSql="select DISTINCTROW prodotti.* FROM prodotti INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro WHERE (((prodotti.attivo)=False) AND ((prodotti.codice)<>''))"									ricerca="-2"								elseif idsettore=-3 and session("idadmin")<>"" then									'Elenco non in vendita									strSql="select DISTINCTROW prodotti.* FROM prodotti INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro  where visibilita=0 and vendita=false and codice<>''"									ricerca="-3"								elseif idsettore=-4 and session("idadmin")<>"" then									caso="Senza settore"									'Elenco non in vendita									strSql="select prodotti.*, settori_prodotti.ID FROM prodotti LEFT JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro WHERE (((settori_prodotti.ID) Is Null))"									ricerca="-4"								elseif idsettore=-5 and session("idadmin")<>"" then									'Elenco nuovi prodotti									strSql="select prodotti.*, settori_prodotti.IDsettore FROM prodotti INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro  WHERE ( ((prodotti.Attivo)=1) and novita=1)"									ricerca="-5"								elseif idsettore=-6 and session("idadmin")<>"" then									'Elenco prodotti in promozione									strSql="select prodotti.*, settori_prodotti.IDsettore FROM prodotti INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro  WHERE ( ((prodotti.Attivo)=1) and promozione=1)"									ricerca="-5"								elseif idmodello<>"" then									caso=6									'Elenco per modello									strSql="select  prodotti.*, prodotti_marca_modello.idmodello FROM prodotti INNER JOIN prodotti_marca_modello ON prodotti.IDpro = prodotti_marca_modello.idpro WHERE prodotti_marca_modello.idmodello="&idmodello									ordinaPer=4									'strSql="select DISTINCTROW prodotti.*, settori_prodotti.IDsettore, prodotti_marca_modello.idmodello FROM (prodotti INNER JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro) INNER JOIN prodotti_marca_modello ON prodotti.IDpro = prodotti_marca_modello.idpro where idmodello="&idmodello								elseif testo<>"" or idsettore=-1 then									caso=7									'Ricerca									strSql="select prodotti.*  FROM prodotti "									operatore=request("oper")									if operatore="" then operatore=" and "									parole=split(testo," ")									if isarray(parole) then										where=" where visibilita=0 and instr( concat(codice, articolo, descrizione),'" &parole(0)& "')>0 "										for i = 1 to ubound(parole)											where = where & operatore & " instr( concat(codice, articolo, descrizione),'" &parole(i)& "')>0 "										next									else										where=" where visibilita=0 and instr( concat(codice, articolo, descrizione),'" &testo& "')>0 "									end if									strSql=strSql&where									ordinaPer=4								elseif idsettore=0 then									caso="Predefinito"									'Predefinito									tags=false									'if sessioN("iduser")=1 then response.write "idsettore"									'Novità									if Application("category_predefinito")=-1 then										titolo="<h2 class=""title"">"&traduci("nuovi")&"</h2>"										strSql="select prodotti.* from prodotti where prodotti.novita=1 and visibilita=0 ORDER BY prodotti.datamod DESC"									end if									ordinaPer=3								else									'if sessioN("iduser")=1 then response.write "nessuna"								end if						         ' VARIABLES						    	' page		current page						    	' order		order type						    	' iPageSize	number of record 4 page						    	' strSql	sql string whit order type						         if ipSize="" then ipSize=1						         select case ipSize						         case 1						         	iPageSize=15						         case 2						         	iPageSize=1000						         case else						         	iPageSize=15						         	ipSize=1						         end select								if ordinaPer="" then ordinaper=1								select case ordinaper								case 1									strsql=strsql& " order by settori_prodotti.ordine"								case 2									strsql=strsql& " order by prezzo"								case 3									ordinaPer=1								case 4									'Ordine per ricerca									strsql=strsql& " order by codice"									ordinaPer=1								case else									ordinaPer=1						         end select								'if utente_andrea then response.write "sql:"&strSql								ref=idsettore&"_"&iPageCurrent+1&"_"&ordinaPer&"_"&ipsize								if testo<>"" then ref=ref&"&testocerca="&testo								'ref="idsettore="&idsettore&"&page="&iPageCurrent+1&"&ordinaper="&ordinaper&"&ipsize="&ipsize								if utente_andrea then									response.write "caso:"&caso &" queryeform:"&queryeform()&" sql:"&strSql								end if								if strsql<>"" then								call paginazione_start(strsql,ipagesize,"access")								if marcamodello then						        sql="select DISTINCT marca_modello.Nome, marca_modello.Id, settori_prodotti.IDsettore FROM settori_prodotti INNER JOIN (prodotti_marca_modello INNER JOIN marca_modello ON prodotti_marca_modello.idmodello = marca_modello.Id) ON settori_prodotti.IDpro = prodotti_marca_modello.idpro WHERE (((settori_prodotti.IDsettore)="&idsettore&"))"						        set rs_marcamodello=conn.execute (sql)						        %>						        <div class="product-color-filter-container">									<span>Seleziona il modello:</span>									<div class="xs-margin"></div>									<ul class="filter-size-list clearfix" >									<%									do while not rs_marcamodello.eof									ref="idsettore="&idsettore&"&ordinaper="&ordinaper&"&ipsize="&ipsize&"&idmodello="&rs_marcamodello("id")									%>									<li class="active"><a href="<%=questofile%>?<%=ref%>" class="<%if idmodello=rs_marcamodello("id") then%>myhover<%end if%>"><%=rs_marcamodello("nome")%>											</a></li><%										rs_marcamodello.movenext									loop								%>									</ul>								</div><!-- End .product-color-filter-container-->						        <%							    set rs_marcamodello=Nothing							    end if 'marcamodello%>						        <%if tags then						        sql="select DISTINCT tags.Nometag, tags.Idtag, settori_prodotti.IDsettore FROM settori_prodotti INNER JOIN (prodotti_tags INNER JOIN tags ON prodotti_tags.idtag = tags.Idtag) ON settori_prodotti.IDpro = prodotti_tags.idpro WHERE (((settori_prodotti.IDsettore)="&idsettore&"))"						        set rs_tags=conn.execute (sql)						        if not rs_tags.eof then						        %>        						<div class="sm-margin"></div><!-- .space -->						        <div class="product-color-filter-container">									<span><%=traduci("txttag")%>:</span>									<div class="xs-margin"></div>									<ul class="filter-size-list clearfix">									<%									do while not rs_tags.eof									ref="idsettore="&idsettore&"&ordinaper="&ordinaper&"&ipsize="&ipsize&"&idtag="&rs_tags("idtag")									%>									<li class="active"><a href="<%=questofile%>?<%=ref%>" class="tags <%if clng(idtag)=rs_tags("idtag") then%>myhover<%end if%> ch_page"><%=rs_tags("nometag")%>											</a></li><%										rs_tags.movenext									loop								%>									</ul>								</div><!-- End .product-color-filter-container-->						        <%							    end if						        set rs_tags=Nothing						        end if 'tags%>        						<%if riordina then%>						   		<div class="alert alert-info">				                    <strong>Modalità riordino attivata!</strong>&nbsp; Premi <button id="riordina_articoli" type="button" class="btn btn-success btn-xs">SALVA</button> per memorizzare l'ordine impostato.				                </div>						   		<div class="alert alert-success" style="display: none;">				                    <strong>Articoli ordinati!</strong>&nbsp; L'ordine degli articoli è stato salvato.				                </div>        						<%end if%>								<%if mod_larochelle and session("iduser")<>"" then %>								<div class="row">									<div class="container">										<h2>Scarica il catalogo</h2>										<p>											Scarica il nostro <a href="pdf_elenco_prodotti.asp">elenco prodotti completo</a></p>									</div><!-- End .container -->								</div><!-- End .row -->			<%end if %>        						<%=titolo%>        						<div id="category-item-container" class="category-item-container">        						<div class="row">                                    <%                                        iRecordsShown = 0 response.write box_rs_articoli(objPagingRS,3)	                                    %>        						</div><!-- End .row -->        						</div><!-- End .category-item-container -->        						<div class="category-toolbar clearfix">									<div class="toolbox-filter clearfix">										<div class="sort-box">											<span class="separator"><%=traduci("sortby")%>:</span>											<div class="btn-group select-dropdown">												<%if riordina then%>												<button type="button" class="btn select-btn">Riordino attivo</button>												<%else %>												<button type="button" class="btn select-btn"><%=ordina_per(ordinaper)%></button>												<%end if%>												<button type="button" class="btn dropdown-toggle" data-toggle="dropdown">													<i class="fa fa-angle-down"></i>												</button>												<ul class="dropdown-menu" role="menu">													<%for n=1 to ordina_per(-1)			 	                                      ref=idsettore&"_"&iPageCurrent+1&"_"&n&"_"&ipsize													 %>													<li><a class="ch_page" href="<%=questofile%>?param=<%=ref%>"><%=ordina_per(n)%></a></li>													<%next%>												</ul>											</div>										</div>										<%if session("iduser")<>"" and idsettore>0 and clng(lngTotalRecords)>0 then%>										<div class="btn-group select-dropdown category-function-box">											<button type="button" class="btn dropdown-toggle" data-toggle="dropdown">												<span class="category-function-tit">Operazioni: </span><i class="fa fa-angle-down"></i>											</button>											<ul class="dropdown-menu" role="menu">												<li><a href="pdf_listino.asp?id=<%=idsettore%>" id="btn-listino">Scarica elenco prodotti</a></li>												<li><a href="#" id="settore-in-preferiti" data-idset="<%=idsettore%>">Aggiungi tutti a preferiti</a></li>											</ul>										</div>										<%if session("idadmin")<>"" then%>										<div class="btn-group select-dropdown category-function-box">											<button type="button" class="btn dropdown-toggle" data-toggle="dropdown">												<span class="category-function-tit">Opzioni</span><i class="fa fa-angle-down"></i>											</button>											<ul class="dropdown-menu" role="menu">												<li><a href="pag_adm_magazzino.asp?idsettore=<%=idsettore%>" id="btn-listino">magazzino</a></li>												<li><a href="category.asp?idsettore=<%=idsettore%>&riordina=si" id="btn-listino">Riordina</a></li>											</ul>										</div>										<%end if%>										<%end if%>										<%if session("iduser")<>"" and idsettore=0 then %>										<div class="category-function-box">											<a href="pdf_elenco_prodotti.asp"  class="btn btn-custom btn-xs">Scarica elenco prodotti completo</a>										</div>										<%end if %>										<%if false then%>										<div class="view-box">											<a href="category.asp?idsettore=<%=idsettore%>" class="active icon-button icon-grid"><i class="fa fa-th-large"></i></a>											<a href="category-list.asp?idsettore=<%=idsettore%>" class="icon-button icon-list"><i class="fa fa-th-list"></i></a>										</div><!-- End .view-box -->										<%end if%>									</div><!-- End .toolbox-filter -->                                      <%	                                      call pagination(iPageCurrent,iPageCount,ordinaper,ipSize,testo)                                    %><!-- End .toolbox-pagination -->        						</div><!-- End .category-toolbar --><%											call paginazione_close()											end ifend subsub pagination(iPageCurrent,iPageCount,ordinaper,ipSize,testo) %>									<div class="toolbox-pagination clearfix">									<%if ipsize<2 then%>										<ul class="pagination">                                        <%if iPageCurrent>1 then										ref="idsettore="&idsettore&"&ordinaper="&ordinaper&"&ipsize="&ipsize&"&page="&iPageCurrent-1  										if testo<>"" then ref=ref&"&testocerca="&testo                                         %>	<li><a class="ch_page" href="<%=questofile%>?<%= ref%>"><i class="fa fa-angle-left"></i></a></li><%end if%>                                        <%                                          for n=1 to iPageCount                                          if iPageCurrent= n then  classactive="class=""active""" else classactive=""										ref="idsettore="&idsettore&"&ordinaper="&ordinaper&"&ipsize="&ipsize&"&page="&n										if testo<>"" then ref=ref&"&testocerca="&testo                                        %>											<li <%=classactive%>><a class="ch_page" href="<%=questofile%>?<%=ref%>"><%=n%></a></li>                                        <%                                           next                                        %>										 <%if iPageCurrent<iPageCount then										ref="idsettore="&idsettore&"&ordinaper="&ordinaper&"&ipsize="&n&"&page="&iPageCurrent+1										if testo<>"" then ref=ref&"&testocerca="&testo										 %>	<li><a class="ch_page"  href="<%=questofile%>?<%= ref%>"><i class="fa fa-angle-right"></i></a></li><%end if%>										</ul>										<%end if%>										<div class="view-count-box">											<span class="separator"><%=traduci("view")%>:</span>											<div class="btn-group select-dropdown">												<button type="button" class="btn select-btn"><%=vedi_per_pagina(ipsize)%></button>												<button type="button" class="btn dropdown-toggle" data-toggle="dropdown">													<i class="fa fa-angle-down"></i>												</button>												<ul class="dropdown-menu" role="menu">													<%for n=1 to vedi_per_pagina(-1)													ref="idsettore="&idsettore&"&ordinaper="&ordinaper&"&ipsize="&n													 %>													<li><a class="ch_page" href="<%=questofile%>?<%=ref%>"><%=vedi_per_pagina(n)%></a></li>													<%next %>												</ul>											</div>										</div><!-- End .view-count-box -->									</div><%end subfunction ordina_per(stato)	if not isnumeric(stato) then		ordina_per=stato	else		select case stato		case -1		ordina_per=2		case 1		ordina_per=traduci("sort_pred")		case 2		ordina_per=traduci("sort_prez")		end select	end ifend functionfunction vedi_per_pagina(stato)	if not isnumeric(stato) then		vedi_per_pagina=stato	else		select case stato		case -1		vedi_per_pagina=2		case 1		vedi_per_pagina="15"		case 2		vedi_per_pagina=traduci("view_all")		end select	end ifend function%>