		rs.movenext	loop	set rs=nothing	conn.close	set conn=nothing	js.Flush	'session("test_autocomplete")="record:"&iend ifterm=replace(request("term"),"'","''")if  term<>""  then	call determina_sqlinjection(term)	Response.ContentType = "application/json;"	'Response.ContentType = "text/html"	'Response.AddHeader "Content-Type", "application/json;charset=UTF-8"	Response.CodePage = 65001	'Response.CharSet = "UTF-8"	Set Js = jsArray()	i=0	max=25	strArr=""	if request("cosa")="articolihome" then			if isnumeric(term) then				sql="select SQL_CALC_FOUND_ROWS * from prodotti where visibilita=0 and idpro= "&term				lngTotalRecords_prodotti=0				set rs_prodotti=conn.execute (sql)								if not rs_prodotti.eof then					Set Js(Null) = jsObject()					Js(null)("value")=rs_prodotti("articolo"&lingua)					Js(null)("articolo")=rs_prodotti("articolo"&lingua)					Js(null)("codice")=rs_prodotti("codice")&" <strong>ID: "&rs_prodotti("idpro")&"</strong>"					'Js(null)("img")=rs_prodotti("fileimg")					Js(null)("id")=rs_prodotti("idpro")					Js(null)("tipo")="P"									end if				set rs_prodotti=Nothing							end if			Set rs_prodotti = Server.CreateObject("ADODB.Recordset")			sql="select SQL_CALC_FOUND_ROWS idpro,articolo,codice from prodotti where"			sql=sql&" visibilita=0 and "			sql=sql&" CONCAT_WS(  ' ', idpro, articolo"&lingua&", codice ) like '%"&term&"%' order by articolo;"			rs_prodotti.Open sql, conn, 3, 3		'settori			if not rs_prodotti.eof then				lngTotalRecords_prodotti=clng(conn.Execute("Select Found_Rows();")(0).Value)				testo="Trovati "&lngTotalRecords_prodotti& " articoli"			end if			sql="select SQL_CALC_FOUND_ROWS * from settori where nome_settore like '%"&term&"%' and nascondi=false order by nome_settore;"			set rs=conn.execute (sql)			lngTotalRecords=clng(conn.Execute("Select Found_Rows();")(0).Value)			if lngTotalRecords>0 then				if testo="" then					testo="Trovate "&lngTotalRecords& " categorie"				else					testo=testo & " e "&lngTotalRecords&" categorie"				end if			end if				if testo<>"" then				Set Js(Null) = jsObject()				Js(null)("value")=""				Js(null)("articolo")=testo				Js(null)("codice")=""				'Js(null)("img")=""				Js(null)("id")=""				Js(null)("tipo")="D"			end if							do while (not rs.eof) and i<max				Set Js(Null) = jsObject()				Js(null)("value")=trim(rs("nome_settore"))				Js(null)("articolo")="Categoria "&rs("nome_settore"&lingua)				Js(null)("codice")=""				'Js(null)("img")=""				Js(null)("id")=rs("idsettore")				Js(null)("tipo")="S"				rs.movenext				i=i+1			loop			rs.Close			set rs=Nothing										if not rs_prodotti.eof then				tipo="D"				Set Js(Null) = jsObject()				Js(null)("value")=""				if lngTotalRecords_prodotti>max then					Js(null)("articolo")="Visualizzati "&max&" di "&lngTotalRecords_prodotti&" articoli trovati"				else					if i=0 then tipo=""					Js(null)("articolo")="Trovati "&lngTotalRecords_prodotti&" articoli"				end if				Js(null)("codice")=""				'Js(null)("img")=""				Js(null)("id")=""				Js(null)("tipo")=tipo				i=0				do while (not rs_prodotti.eof) and i<max					Set Js(Null) = jsObject()					Js(null)("value")=trim(rs_prodotti("codice") &" "&rs_prodotti("articolo"&lingua))					Js(null)("articolo")=rs_prodotti("articolo"&lingua)					Js(null)("codice")=rs_prodotti("codice")					'Js(null)("img")=rs_prodotti("fileimg")					Js(null)("id")=rs_prodotti("idpro")					Js(null)("tipo")="P"					rs_prodotti.movenext					i=i+1				loop				if lngTotalRecords_prodotti>max then					Set Js(Null) = jsObject()					Js(null)("value")=""					Js(null)("articolo")="vedi tutti i "&lngTotalRecords_prodotti&" articoli"					Js(null)("codice")=""					'Js(null)("img")=""					Js(null)("id")=""					Js(null)("tipo")="T"				end if			end if			rs_prodotti.close			set rs_prodotti=nothing			js.Flush			set js=Nothing			call connclose()		Response.End				end if		add2log "cercato "&vbcrlf&queryeform(),0end ifadd2log "Richiesta non riconosciuta "& vbcrlf&queryeform()&"<br>"&Request.ServerVariables("HTTP_REFERER"),3call rsclose()sub invia_mail_newsletter(email,codice_verifica)	dim txt_error	txt_error=""		Const cdoSendUsingMethod        = "http://schemas.microsoft.com/cdo/configuration/sendusing"	Const cdoSendUsingPort          = 2	Const cdoSMTPServer             = "http://schemas.microsoft.com/cdo/configuration/smtpserver"	Const cdoSMTPServerPort         = "http://schemas.microsoft.com/cdo/configuration/smtpserverport"	Const cdoSMTPConnectionTimeout  = "http://schemas.microsoft.com/cdo/configuration/smtpconnectiontimeout"	Const cdoSMTPAuthenticate       = "http://schemas.microsoft.com/cdo/configuration/smtpauthenticate"	Const cdoBasic                  = 1	Const cdoSendUserName           = "http://schemas.microsoft.com/cdo/configuration/sendusername"	Const cdoSendPassword           = "http://schemas.microsoft.com/cdo/configuration/sendpassword"	Dim objConfig	Dim objMessage	Dim Campi	Set objConfig = Server.CreateObject("CDO.Configuration")	Set Campi = objConfig.Fields	With Campi	.Item(cdoSendUsingMethod)       = cdoSendUsingPort	.Item(cdoSMTPServer)            = SMTPServer	.Item(cdoSMTPServerPort)        = 25	.Item(cdoSMTPConnectionTimeout) = 30	.Update	End With	Set objMessage = Server.CreateObject("CDO.Message")	Set objMessage.Configuration = objConfig	objMessage.Bodypart.Charset = "UTF-8"		'EMAIL AL VISITATORE	'sql="select * from news where stato='0' and tipo='E0' order by ordine;"	'set rsb=conn.execute(sql)	'if not rsb.eof then	'	HTML = HTML &rsb("testo")	'else	'	add2log "Manca testo per email di registrazione (0)",2	'end if	'rsb.close	'set rsb= nothing		HTML = HTML & "Gentile visitatore,<br>"	HTML = HTML & "abbiamo ricevuto la sua richiesta di iscrizione alla newsletter di "&lcase(nomesito)&"<br><br>"		HTML = HTML & "L'indirizzo di posta che ricever&agrave; le nostre comunicazioni &egrave;: "&email&"<br><br>"	HTML = HTML & "La preghiamo di confermare l'effettiva volont&agrave; di iscrizione alla newsletter cliccando su questo link: "	HTML = HTML & "<a href=""http://" & lcase(nomesito) & "/searcher.asp?conferma_email="&email&"&verifica="&codice_verifica&"""><b>CONFERMA L'ISCRIZIONE ALLA NEWSLETTER</b></a><br><br>"	HTML = HTML & "Se invece non era sua intenzione iscriversi, pu&ograve; cancellare l'iscrizione cliccando qui: "	HTML = HTML & "<a href='http://" & lcase(nomesito) & "/searcher.asp?remove_email="&email&"&verifica="&codice_verifica	HTML = HTML & "'><b>RIMUOVI IL TUO INDIRIZZO EMAIL</b></a><br><br>"	HTML = HTML & "La ringraziamo per l'interesse dimostrato.<br>"	HTML = HTML & "<b>"&nomesito&"</b>"				objMessage.To =  email	objMessage.From = nomesito  & "<" & Application("email_sito") & ">"	objMessage.Subject = "Iscrizione alla newsletter di " & nomesito	objMessage.HtmlBody = "<!DOCTYPE html PUBLIC ""-//W3C//DTD XHTML 1.0 Transitional//EN"" ""http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd""><html xmlns=""http://www.w3.org/1999/xhtml""><head><meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" /><title>"&"Registrazione su " & nomesito&"</title></head><body>"&HTML&"</body></html>"	on error resume next	objMessage.Send	If err.number <> 0 Then		add2log "Errore invio email di iscrizione alla newsletter a "&email,3		txt_error=" (invio email di iscrizione fallito)"			else		'add2log "Inviata email di registrazione a [utente="&rs("iduser")&"]"&nominativo(rs("nome"),rs("cognome"),rs("azienda"))&"[/utente]"&vbcrlf&"Email:"&rs("email"),2		'rs("password_inviata")=now()		'rs.update			End If	Set objMessage = Nothing		end sub%>