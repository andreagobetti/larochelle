rifica=request("verifica")	if not isnumeric(verifica) then		response.end	end if		sql="UPDATE email_news SET email_news.data_verifica = now() WHERE codice_verifica='"&verifica&"' and email='"&email&"'"	conn.execute sql,num	if num=0 then		session("conferma_email")="ko"	else		session("conferma_email")="ok"	end if	call connclose()	Response.redirect "newsletter.asp"end ifif request("remove_email")<>"" then		email=request("remove_email")	call determina_sqlinjection(email)	verifica=request("verifica")	if not isnumeric(verifica) then		response.end	end if		sql="UPDATE email_news SET data_rimosso = now() WHERE codice_verifica='"&verifica&"' and email='"&email&"'"	conn.execute sql,num	if num=0 then		session("conferma_email")="rimossoko"	else		session("conferma_email")="rimossook"	end if	call connclose()	Response.redirect "newsletter.asp"end ifif request("txt_errore")<>"" then	grave=Request.querystring("grave")	if grave="" then		grave=0	end if	if request("titolo")<>"" then		add2log request("titolo")&" ("&Request.ServerVariables("HTTP_REFERER")&")"&vbcrlf&request("txt_errore"),grave	else		add2log "Segnalazione errore in "&Request.ServerVariables("HTTP_REFERER")&vbcrlf&request("txt_errore"),grave	end if	call rsclose()	response.endend ifif request("oper")="checkout" then	Response.ContentType = "application/json; charset=utf-8"	Response.CodePage = 65001	Set Js = jsObject()	tipotrasporto=request("tipo_trasporto")	tot_carrello=replace(request("subtot_carrello"),".",",")		tot_carrello=ccur(tot_carrello)	tot_carrello_tmp=tot_carrello	trasporto=calcola_importo_trasporto(cint(tipotrasporto),tot_carrello)	pagamento=request("tipo_pagamento")	call determina_sqlinjection(pagamento)	js("testo")="TRASPORTO"	maggiorazione_gestione=cdbl(conn.execute("select maggiorazione_gestione FROM metodi_pagamento where id="& pagamento )(0))	if maggiorazione_gestione>0 then		importo_maggiorazione_gestione=roundup(tot_carrello*maggiorazione_gestion