<!--#include virtual="/setup.asp" --><!--#include virtual="/multidict_cl.asp" --><%if session("idadmin") = "" then call login()%><%'------------------------------------oper=request.form("oper")if request.form("elimina")<>"" then	sql="DELETE FROM agenti WHERE idagente =" & request.form("idagente") & ";"	conn.execute(sql)end ifselect case lcase(request("oper"))	case "annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case else		oper="view"		if request.form("modifica")<>"" then oper="edit"end selectif oper="add" or oper="update" then	'controlliend ifif oper="add" or oper="update" then	Set rs = Server.CreateObject("ADODB.Recordset")	sql="select * from agenti"	if oper="add" then		rs.Open sql, conn, 3, 3		rs.addnew	else		idagente=request.form("idagente")		sql= sql & " where idagente=" & idagente		rs.Open sql, conn, 3, 3	end if	rs("Nominativo")=AllFirstUp(trim(request.form("Nominativo")))	rs("iduser")=request.form("iduser")	rs("clienti_provincie")=trim(request.form("clienti_provincie"))	rs("clienti_pa")=request.form("clienti_pa")	rs.update	rs.close		IF oper="update" then						'GESTIONE TABELLA PROVVIGIONI		str_provvigioni=request.form("provvigioni")		if str_provvigioni<>"" then			'response.write "<br>varianti:<br>"			arr_provvigioni = split(str_provvigioni,", ")						'CARICO LE VARIANTI FORM IN DICT			Dim Dict    'The Dict Object			Dim Record    'The Record Object			Dim Field    'The Field Object			Set Dict = New MultiDimensionalDictionary 'Create an Instance of the Class						for i = 0 to ubound(arr_provvigioni)					id=cint(arr_provvigioni(i))					response.write "carico vara "&id&"<br>"					Dict.SetKey = id 'Key record					Dict.SetField "sconto", request.form("sconto_"&id)					Dict.SetField "provvigione", request.form("provvigione_"&id)					Dict.SetField "elimina", request.form("elimina_"&id)					Dict.Update 'Bind the record and preapre for the next record			Next						'Apro tabella varianti			set rs_var=Server.CreateObject("ADODB.Recordset")			rs_var.Open "select * from provvigioni_agente where idagente="&idagente, conn, 1, 3			do while not rs_var.eof				id=cint(rs_var("id"))				'Elimina variante				if dict.item(id,"elimina")<>"" then					idvara=rs_var("id")															rs_var.delete				else				'Modifica variante esistente					rs_var("sconto")=dict.item(id,"sconto")					rs_var("provvigione")=dict.item(id,"provvigione")										rs_var.update				end if				rs_var.movenext			loop			rs_var.close			set rs_var=nothing		end if		'Aggiunta varianti nuove		str_arr_provvigioni_new=request.form("provvigioni_new")		'response.write "provvigioni_new:"&str_arr_provvigioni_new&"<br>"		if str_arr_provvigioni_new<>"" then			set rs_var=Server.CreateObject("ADODB.Recordset")			rs_var.Open "select * from provvigioni_agente where idagente="&idagente,conn,1,3			arr_provvigioni_new = split(str_arr_provvigioni_new,", ")			for i = 0 to ubound(arr_provvigioni_new)				id=arr_provvigioni_new(i)				response.write "test variante new:"&"variantea_new_"&id&"<br>"				if request.form("provvigione_new_"&id)<>"" then					rs_var.addnew					rs_var("idagente")=idagente					rs_var("sconto")=request.form("sconto_new_"&id)					rs_var("provvigione")=request.form("provvigione_new_"&id)					rs_var.update								modifiche_rs= modifiche_rs& "Aggiunto provvigioni A: "&request.form("sconto_new_"&id)&"<br>"				end if			next			rs_var.close			set rs_var=nothing		end if		set dict=nothing'GESTIONE PROVVIGIONI A FINE			end if				oper="view"end if'response.write oper%><!--#include virtual="/sub_head_adm.asp" --><% if oper<>"view" then%><script Language="JavaScript"> annulla=false;function Validator(theForm) {if (annulla==true)  { 	return(true);      }   if (theForm.nominativo.value == "")  {     alert("Inserisci il nominativo.");     theForm.nominativo.focus();     return (false);   }   } </script><%end if%></head><body> <div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>" class="Amministra_piccolo">Agenti</a></div>        <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" <%if oper<>"view" then%> onSubmit="return Validator(this)"<%end if%> style="margin-top:0px;">        <%sql="select * from agenti  "if oper="view" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="3" class="ui-widget-header">Elenco agenti</td>            </tr>            <tr align="right">               <td colspan="3" style="border-bottom:1px solid;"><a href="<%=questofile%>?oper=new"><strong>Aggiungi agente</strong></a></td>            </tr>            <tr>               <%if oper="view" then%>              <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Modifica&nbsp;</td>              <%end if%>              <td nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">Nominativo </td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>            </tr>            <%	sql= sql & "ORDER BY nominativo;"	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="modifica" value="<%=rs("idagente")%>" onClick="this.form.submit()">               </td>              <td nowrap style="border-bottom:1px solid;"><%=AllFirstUp(rs("nominativo"))%></td>              <td style="border-bottom:1px solid;">&nbsp;</td>            </tr>            <%	rs.movenext	loop	set rs = nothing	call connclose()	%>          </table>          <%elsetxt=request.form("modifica")if request.form("idagente")<>"" then txt=request.form("idagente")	sql=sql & " where idagente =" & txt	if request.form("modifica")<>"" then		set rs=conn.execute(sql)		testo= "Modifica lista"			else		testo= "Nuova lista"	end if		  %>          <input type="hidden" name="idagente" value="<%=txt%>">          <%if error<>"" then			  		descrizione=request.form("descrizione")			  	elseif oper="new" then			  		descrizione=""				end if%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header"><%response.write testo%></td>            </tr>            <tr>               <td valign="top">Nominativo</td>              <td>  <%if error<>"" then			  		var=request.form("nominativo")				elseif oper="edit" then					var=rs("nominativo")			  	elseif oper="new" then			  		var=""				end if%> <input name="nominativo" type="text" id="nominativo" value="<%=var%>" size="40">              </td>            </tr>			<tr>		        <td>Utente admin:</td>		        <td><%				if oper="view" then					val=cint(rs("iduser"))										if val>0 then						set rsm=conn.execute("select * from admin where iduser= "&val)						if not rsm.eof then response.write rsm("nominativo")					else						response.write "Nessuno"					end if				else								if oper="new" then							val=request.form("idagente")						else							val=cint(rs("iduser"))						end if %>		          <select name="iduser" <%=disabled%>>		            <option value="0" <%if val=0 then response.write " selected"%>>Nessuno</option>		            <%					set rsm=conn.execute("select * from admin order by nominativo ;")					do while not rsm.eof					response.write "<option value=""" & rsm("iduser") &""""					if val=rsm("iduser") then response.write " selected"					response.write ">" & rsm("nominativo")& "</option>"					rsm.movenext					loop					rsm.close					set rsm = Nothing			%>		          </select>				  <%end if		  %></td>		</tr>		<tr>		        <td>Visualizza clienti di queste province:</td>		        <td>			        <%if error<>"" then			  		val=request.form("clienti_provincie")				elseif oper="edit" then					val=rs("clienti_provincie")			  	elseif oper="new" then			  		val=""				end if%> <input name="clienti_provincie" type="text" value="<%=val%>" size="40">				</td>		</tr>		<tr>	        <td>Visualizza clienti PA:</td>	        <td>			        <%if error<>"" then			  		val=request.form("clienti_pa")				elseif oper="edit" then					val=rs("clienti_pa")			  	elseif oper="new" then			  		val=0				end if%>	          <select  name="clienti_pa" >	            <option value="0" <%if val=0 then response.write " selected"%> >Tutti</option>	            <option value="1" <%if val=1 then response.write " selected"%> >Clienti PA</option>	            <option value="2" <%if val=2 then response.write " selected"%> >Clienti non PA</option>	          </select>			</td>		</tr>      <%if oper="edit" then %>            <%call elenco_provvigioni(rs("idagente"))%>                  <%end if %>                        <tr>              <td colspan="2" align="center" valign="top">        <%	if oper="view" then		txt=puls_new	elseif oper="new" or error<>"" then		txt="Aggiungi"	elseif oper="edit" then		txt="Modifica"	end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Annulla" onClick="annulla=true;">    <%end if%>    <%if oper="edit" and num=0 and error="" then%>    <input type="submit" name="elimina" value="Elimina" onClick="annulla=true;">    <%end if	set rs = nothing	call connclose()	%></td>            </tr>                    </table><%end if%>        </form>         <!-- Colonna CORPO FINE-->      </div>    <div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%	sub elenco_provvigioni(idagente)	%>		<table border="0" cellpadding="2" cellspacing="0" class="tabella1" id="tabella_provvigioni">            <tr style="border-bottom:1px solid;">              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Sconto</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Provvigione</td>              <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Elimina&nbsp;</td>            </tr>            <%	set rs_vara=conn.execute("select * from provvigioni_agente where idagente="&idagente)	do until rs_vara.EOF	id=rs_vara("id")%>            <tr style="border-bottom:1px solid;">				<td >	                <input type="text" name="sconto_<%=id%>"  value="<%=rs_vara("sconto")%>" style="width:100px;" >                </td>				<td style="border-bottom:1px solid;"><input type="hidden" name="provvigioni"  value="<%=id%>">	                <input type="text" name="provvigione_<%=id%>"  value="<%=rs_vara("provvigione")%>" style="width:200px;" >                </td>              <td align="center" style="border-bottom:1px solid;"><input type="checkbox" name="elimina_<%=id%>" value="<%=id%>" ></td>            </tr>            <%	rs_vara.movenext	loop	rs_vara.close	set rs_vara=nothing	%>            <tr style="border-bottom:1px solid;">				<td ><input type="hidden" name="provvigioni_new"  value="1">	                <input type="text" name="sconto_new_1"  value="" style="width:100px;" >                </td>              <td ><input type="text" name="provvigione_new_1" CLASS="n_riga" value="" style="width:100px; text-align:right;<%=bgcolor_ve%>" <%=disabled_ve%>></td>              <td align="center" ><input type="checkbox" name="eliminanew_1" value="" ></td>            </tr>          </table>          <script>$(function() {var new_id=1;function aggiungi_riga(){	$( ".n_riga" ).blur(function() {		var pieno = true;		$(".n_riga").each(function () {			if ($(this).val() == "") {				pieno = false;			}		});		if (pieno)		{			new_id++;			$( "#tabella_provvigioni" ).append(nuova_riga(new_id,""));		}	aggiungi_riga();	});}aggiungi_riga();});function nuova_riga(id,valore)	{		return '<tr id="nuova_riga_'+id+'" style="border-bottom:1px solid;"><td><input type="text" name="sconto_new_'+id+'" value="" style="width:100px;" ></td><td ><input type="hidden" name="provvigioni_new"  value="'+id+'"><input type="text"  class="n_riga" id="sconto_new_'+id+'" name="sconto_new_'+id+'"  value="'+valore+'"  style="width:200px;"></td><td align="center" style="border-bottom:1px solid;"> <input type="checkbox" name="eliminanew_'+id+'" value="" ></td><td></td></tr>';	}</script>				<%end sub		%>