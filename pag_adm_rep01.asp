<%'Verifica chiusure 02_12_2015%><!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()mese=request("mese")if mese="" then	mese=0	anno=year(date())else	anno=request("anno")end ifporto=request.form("porto")%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%><div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Elenco spedizioni</a></div>    </div>       <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >       <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>            <td colspan="4" class=ui-widget-header>Spedizioni: </td>          </tr>          <tr>             <td colspan="4" style="border-bottom:1px solid;">Mese              <select name="MESE" onChange="this.form.submit()">                <option value="">Selezionare</option>                <%for n=1 to nome_mese(0)	response.write "<option value='"&n&"'"	if n=cint(mese) then response.write " selected"	response.write  ">" & nome_mese(n)&"</option>"next%>              </select>               Anno              <input type="text" name="anno" value="<%=anno%>"> <select name="porto" onChange="this.form.submit()">			  <option value="">Tutti</option>			  <%				for n=1 to porto_ddt(-1)				%>				<option value="<%=n%>" <%if porto=cstr(n) then response.write " selected"%>><%=porto_ddt(n)%></option>				<%								next			  			  %>			  </select>              <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;"></td>          </tr></table></form>        <%if mese<>"0" then%>		<%		sql="select fatture.nfat,fatture.porto as fatture_porto, ddt.nddt,ddt.porto as ddt_porto, ordini.*" sql=sql& " FROM (ordini LEFT JOIN fatture ON ordini.idord = fatture.idord) LEFT JOIN ddt ON ordini.idord = ddt.idord  where ordini.stato=6 and ordini.eliminato=0 " sql=sql & " and month(ordini.data_stato6)="&mese &" and year(ordini.data_stato6)="&annoif porto<>"" then sql=sql&" and (fatture.porto="&porto&" or ddt.porto="&porto&") "sql=sql&" order by data_stato6"PaginazioneString = "&mese="&mese&"&anno="&annocall paginazione_start(sql,10000,"access")%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="8" class=ui-widget-header>Spedizioni mese di <%=nome_mese(mese)%>&nbsp<%=anno%></td>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Ordine</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Destinatario</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">BDA</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Porto</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Peso - Dimensioni</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Trasporto</td>          </tr>          <%		  totale=0Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>          <tr>            <td style="border-bottom:1px solid;"><input name="" type="checkbox" value=""></td>             <td style="border-bottom:1px solid;"><%if objPagingRS("data_stato6")<>"" then%><%=formatDateTime(objPagingRS("data_stato6"), vbShortDate)%><%end if%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;" align="right"><a href="pag_adm_ordini.asp?idord=<%=objPagingRS("idord")%>"><b><%=objPagingRS("nord")%></b></a></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;">			<%			if objPagingRS("d_azienda")<>"" then val=objPagingRS("d_azienda") else val=objPagingRS("azienda")						%>			<%=denominazione(objPagingRS("nome"),objPagingRS("cognome"),val)%></td>            <td style="border-bottom:1px solid;">            <%if objPagingRS("nddt")<>"" then			porto=porto_ddt(objPagingRS("ddt_porto")) %>            ddt <%=objPagingRS("nddt")%>                        <%elseif objPagingRS("nfat")<>"" then			porto=porto_ddt(objPagingRS("fatture_porto")) %>            fat <%=objPagingRS("nfat")%><%			else			porto=""			end if%>            </td>            <td style="border-bottom:1px solid;"><%=porto%></td>            <%			testo=""			if objPagingRS("peso")<>"" then testo=objPagingRS("peso")&"Kg."			if objPagingRS("dimensione")<>"" then				if testo<>"" then testo=testo&" - "				testo=testo&objPagingRS("dimensione")&""			end if			%>            <td style="border-bottom:1px solid;"><%=testo%>            </td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%=formatcurrency(objPagingRS("trasporto"),2)%></td>          </tr>          <% 			  totale=totale+cdbl(objPagingRS("trasporto"))		iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(8,true)	%><tr><td colspan="7"><b>Totale:</b></td><td><b><%=formatnumber(totale,2)%></b></tr></tr>        </table><%		else				call connclose()			end if%>        <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>