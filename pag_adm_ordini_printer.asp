ding-top: 3px; padding-bottom:3px;"><br>        <%=ordine.campo("note_gestore")%>        <br></td>    </tr>  </table>  <table width="100%" border="1" cellpadding="0" cellspacing="0" bordercolor="#E5E5E5" class="tabella1">    <tr>      <td colspan="2" class="ui-widget-header">Conferma <%=cosa%>:</td>    </tr>    <tr valign="middle" align="right" >      <td align="left" style="border-bottom: 1px solid gray; padding-top: 3px; padding-bottom:3px;"><br>        <%=ordine.campo("conferma_ordine")%>        <br></td>    </tr>  </table>  <!-- Colonna CORPO FINE-->  </form>  </td>  </tr>  <tr>    <td colspan="2" height="1">&nbsp;</td>  </tr>  </table></center></body></html><%	'sql = "select * FROM ordini WHERE idord="&idord	'Set rs = Server.CreateObject("ADODB.Recordset")	'rs.Open sql, conn, 3, 3	Set rs = Server.CreateObject("ADODB.Recordset")	sql="select ordini.* from ordini where idord="&idord	rs.Open sql, conn, 3, 3	rs("da_stampare")=0	comunicazioni_precedenti= now()&" <b>"&session("nominativo")&":</b> ordine stampato"	rs("comunicazioni_precedenti")=ordine.campo("comunicazioni_precedenti")&"<hr />"& comunicazioni_precedenti	rs.update	rs.close	set rs = Nothing	call connclose()	call CheckConnChiusa()%>