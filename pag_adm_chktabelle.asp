<!--#include virtual="/setup.asp" --><%if request.querystring("op")=1 then    sql="DELETE magazzino.*, magazzino.idpro, prodotti.IDpro FROM magazzino LEFT JOIN prodotti ON magazzino.idpro = prodotti.IDpro WHERE (((prodotti.IDpro) Is Null));"    conn.execute sqlend ifif request.querystring("op")=2 then    sql="DELETE varianti_a.*, prodotti.IDpro FROM prodotti RIGHT JOIN varianti_a ON prodotti.IDpro = varianti_a.idpro WHERE (((prodotti.IDpro) Is Null));"    conn.execute sql    'txt=txt&"Cancellato<br>"end ifif request.querystring("op")=3 then    sql="DELETE varianti_b.*, prodotti.IDpro FROM prodotti RIGHT JOIN varianti_b ON prodotti.IDpro = varianti_b.idpro WHERE (((prodotti.IDpro) Is Null));"    conn.execute sqlend ifif request.querystring("op")=4 then    sql="DELETE magazzino.* FROM magazzino LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara WHERE (((varianti_a.IDvara) Is Null) AND ((magazzino.idvara)>0));"    conn.execute sqlend ifif request.querystring("op")=5 then    sql="DELETE magazzino.* FROM magazzino LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb WHERE (((varianti_b.IDvarb) Is Null) AND ((magazzino.idvarb)>0));"    conn.execute sqlend if%><!DOCTYPE html><html><head>  <title><%=application("brwstitle")%></title>  <meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">  <!--#include virtual="/sub_head.asp" -->  <style type="text/css">.rosso {    color: #F00;  }  </style>  <style type="text/css">table.c2 {border-collapse: collapse}  td.c1 {font-weight: bold}  </style></head><body>  <div id="wrap">    <div id="header">      <%=titolo_top%><%barra=0%><!--#include virtual="/sub_barra_adminsf2.asp" -->      <div class="ui-widget-header ui-corner-all titolo_admin">        <a href="<%=questofile%>">Controllo integrità tabelle</a>      </div><%		rosso="class='rosso'"		txt=txt& "<b>UTENTI</b><br>"		Set rs = Server.CreateObject("ADODB.Recordset")		sql="select COUNT( * ) , GROUP_CONCAT(utenti_clienti.iduser SEPARATOR ', ') FROM utenti_clienti LEFT JOIN utenti ON utenti_clienti.iduser = utenti.iduser WHERE (((utenti.iduser) Is Null))"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" utenti_clienti senza utente "&conn.execute(sql)(1)&"</span>"		txt=txt&"<br>"				Set rs = Server.CreateObject("ADODB.Recordset")		sql="select COUNT( * ) , GROUP_CONCAT(utenti_fornitori.iduser SEPARATOR ', ')  FROM utenti_fornitori LEFT JOIN utenti ON utenti_fornitori.iduser = utenti.iduser WHERE (((utenti.iduser) Is Null));"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" utenti_fornitori senza utente "&conn.execute(sql)(1)&"</span>"		txt=txt&"<br>"				'prodotti e tabelle connesse a prodotti		txt=txt& "<b>ARTICOLI</b><br>"		sql="select COUNT( * )  FROM prodotti  WHERE codice Is Null;"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" ARTICOLI con codice nullo</span>"		txt=txt&"<br>"						sql="select count(*) FROM prodotti LEFT JOIN settori_prodotti ON prodotti.IDpro = settori_prodotti.IDpro WHERE (((settori_prodotti.ID) Is Null));"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" ARTICOLI senza settore</span>"		txt=txt&"<br>"				txt=txt& "<b>PREFERITI</b><br>"		'cerca in preferiti senza prodotto		sql="select count(*) FROM preferiti LEFT JOIN prodotti ON preferiti.idpro = prodotti.IDpro WHERE (((prodotti.IDpro) Is Null));"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" record in preferiti senza prodotto padre</span>"		txt=txt&"<br>"				'cerca in preferiti senza utente		sql="select count(*) FROM preferiti LEFT JOIN utenti ON preferiti.iduser = utenti.iduser WHERE (((utenti.iduser) Is Null));"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" record in preferiti senza utente padre</span>"		txt=txt&"<br>"				txt=txt& "<b>CARRELLO</b><br>"		sql="select count(*) FROM carrello LEFT JOIN prodotti ON carrello.idpro = prodotti.IDpro WHERE (((prodotti.IDpro) Is Null));"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" record in carrello senza prodotto</span>"		txt=txt&"<br>"				txt=txt& "<b>MAGAZZINO</b><br>"		sql="select count(*) FROM magazzino LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara WHERE (((varianti_a.IDvara) Is Null) AND ((magazzino.idvara)>0))"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" elementi magazzino senza corrispondenza variante_A</span>"		if n>0 then 		              txt=txt&"    <a href='"&questofile&"?op=4'>Aggiusta</a><br>"		end if		txt=txt&"<br>"		sql="select count(*) FROM magazzino left JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb WHERE (((magazzino.idvarb)<>0) AND ((varianti_b.IDvarb) Is Null));"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" elementi magazzino  senza corrispondenza variante_B</span>"		if n>0 then               txt=txt&"    <a href='"&questofile&"?op=5'>Aggiusta</a><br>"		end if		txt=txt&"<br>"				'cerca in magazzino senza prodotti		sql="select count(*) FROM prodotti RIGHT JOIN magazzino ON prodotti.IDpro = magazzino.idpro WHERE (((prodotti.IDpro) Is Null));"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" elementi magazzino senza articolo padre</span>"		if n>0 then		  txt=txt&"    <a href='"&questofile&"?op=1'>Aggiusta</a><br>"		end if		txt=txt&"<br>"						sql="select count(*) FROM prodotti LEFT JOIN magazzino ON prodotti.IDpro = magazzino.idpro WHERE (((magazzino.IDmag) Is Null));"		n=clng(conn.execute(sql)(0))		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" articoli senza magazzino</span>"		txt=txt&"<br>"				txt=txt& "<b>prodotti_consigliati</b><br>"		'prodotti_consigliati duplicati		sql="select prodotti_consigliati.idconsigliato, prodotti_consigliati.IDpro, Count(prodotti_consigliati.ID) AS ConteggioDiID FROM prodotti_consigliati GROUP BY prodotti_consigliati.idconsigliato, prodotti_consigliati.IDpro HAVING (((Count(prodotti_consigliati.ID))>1)); "		rs.Open sql, conn, 3, 3		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" record duplicati in prodotti_consigliati</span>"          		do while not rs.eof			txt=txt & " ["&rs("idconsigliato")&"-"&rs("idpro")&"]"			rs.movenext		loop		rs.close		txt=txt&"<br>"		'cerca in prodotti_consigliati senza prodotto		sql="select prodotti_consigliati.ID, prodotti.IDpro FROM prodotti_consigliati LEFT JOIN prodotti ON prodotti_consigliati.IDpro = prodotti.IDpro WHERE (((prodotti.IDpro) Is Null)); "		rs.Open sql, conn, 3, 3		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" record in prodotti_consigliati senza articolo</span>"          		do while not rs.eof			txt=txt & " [id="&rs("id")&"]"			rs.movenext		loop		rs.close		txt=txt&"<br>"										txt=txt& "<b>settori_prodotti</b><br>"		'cerca in settori_prodotti senza prodotto		sql="select settori_prodotti.ID, prodotti.IDpro FROM settori_prodotti LEFT JOIN prodotti ON settori_prodotti.IDpro = prodotti.IDpro WHERE (((prodotti.IDpro) Is Null)); "		rs.Open sql, conn, 3, 3		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" record in settori_prodotti senza articolo</span>"          		do while not rs.eof			txt=txt & " [id="&rs("id")&"]"			rs.movenext		loop		rs.close		txt=txt&"<br>"          'cerca varianti_a senza prodotto          sql="select varianti_a.IDvara, prodotti.IDpro FROM prodotti RIGHT JOIN varianti_a ON prodotti.IDpro = varianti_a.idpro WHERE (((prodotti.IDpro) Is Null));"          rs.Open sql, conn, 3, 3          if n>0 then classe=rosso else classe=""          txt=txt&"<span "&classe&">Trovato "&n&" varianti_a senza articolo padre<br></span>"          if not rs.eof then              txt=txt&"    <a href='"&questofile&"?op=2'>Aggiusta</a><br>"          end if          rs.close          'cerca varianti_b senza prodotto          sql="select varianti_b.IDvarb, prodotti.IDpro FROM prodotti RIGHT JOIN varianti_b ON prodotti.IDpro = varianti_b.idpro WHERE (((prodotti.IDpro) Is Null));"          rs.Open sql, conn, 3, 3          if n>0 then classe=rosso else classe=""          txt=txt&"<span "&classe&">Trovato "&n&" varianti_b senza articolo padre<br></span>"          if not rs.eof then              txt=txt&"    <a href='"&questofile&"?op=3'>Aggiusta</a><br>"          end if          rs.close          		          		                                          		'prodotti_tags senza prodotto		txt=txt& "<b>prodotti_tags</b><br>"		sql="select prodotti_tags.IDtag, prodotti_tags.IDpro, Count(prodotti_tags.ID) AS ConteggioDiID FROM prodotti_tags GROUP BY prodotti_tags.IDtag, prodotti_tags.IDpro HAVING (((Count(prodotti_tags.ID))>1)); "		rs.Open sql, conn, 3, 3		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" record duplicati in prodotti_tags</span>"          		do while not rs.eof			txt=txt & " [idsettore="&rs("idtag")&" idpro="&rs("idpro")&"]"			rs.movenext		loop		rs.close		txt=txt&"<br>"		        'prodotti_tags  duplicati		sql="select prodotti_tags.IDtag, prodotti_tags.IDpro, Count(prodotti_tags.ID) AS ConteggioDiID FROM prodotti_tags GROUP BY prodotti_tags.Idtag, prodotti_tags.IDpro HAVING (((Count(prodotti_tags.ID))>1)); "		rs.Open sql, conn, 3, 3		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" record duplicati in prodotti_brand</span>"          		do while not rs.eof			txt=txt & " [idsettore="&rs("idtag")&" idpro="&rs("idpro")&"]"			rs.movenext		loop		rs.close		txt=txt&"<br>"						txt=txt& "<b>prodotti_brand</b><br>"        'prodotti_brand  duplicati		sql="select prodotti_brand.IDbrand, prodotti_brand.IDpro, Count(prodotti_brand.ID) AS ConteggioDiID FROM prodotti_brand GROUP BY prodotti_brand.Idbrand, prodotti_brand.IDpro HAVING (((Count(prodotti_brand.ID))>1)); "		rs.Open sql, conn, 3, 3		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" record duplicati in prodotti_brand</span>"          		do while not rs.eof			txt=txt & " [idsettore="&rs("idtag")&" idpro="&rs("idpro")&"]"			rs.movenext		loop		rs.close		txt=txt&"<br>"				'cerca prodotti_brand senza prodotto		sql="select prodotti_brand.IDbrand, prodotti.IDpro FROM prodotti RIGHT JOIN prodotti_brand ON prodotti.IDpro = prodotti_brand.idpro WHERE (((prodotti.IDpro) Is Null));"		rs.Open sql, conn, 3, 3		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" prodotti_brand senza prodotto<br></span>"		if not rs.eof then		  txt=txt&"    <a href='"&questofile&"?op=3'>Aggiusta</a><br>"		end if		rs.close				txt=txt& "<b>prodotti_dettagli</b><br>" 		'cerca prodotti_dettagli senza prodotto		sql="select prodotti_dettagli.ID, prodotti.IDpro FROM prodotti RIGHT JOIN prodotti_dettagli ON prodotti.IDpro = prodotti_dettagli.idpro WHERE (((prodotti.IDpro) Is Null));"		rs.Open sql, conn, 3, 3		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" prodotti_dettagli senza prodotto<br></span>"		if not rs.eof then			txt=txt & " ["&rs("id")&"]"		end if		rs.close                     'settori          txt=txt& "<b>settori</b><br>"                    'cerca in settori senza padre          sql="select settori.idsettore, settori.Nome_Settore, settori_1.idsettore, settori.idpadre FROM settori LEFT JOIN settori AS settori_1 ON settori.idpadre = settori_1.idsettore WHERE (((settori_1.idsettore) Is Null) AND (Not (settori.idpadre)=0)); "          rs.Open sql, conn, 3, 3          if n>0 then classe=rosso else classe=""          txt=txt&"<span "&classe&">Trovato "&n&" settori senza padre<br></span>"          rs.close                                                  		'cerca in settori_prodotti duplicati		sql="select settori_prodotti.IDsettore, settori_prodotti.IDpro, Count(settori_prodotti.ID) AS ConteggioDiID FROM settori_prodotti GROUP BY settori_prodotti.IDsettore, settori_prodotti.IDpro HAVING (((Count(settori_prodotti.ID))>1)); "		rs.Open sql, conn, 3, 3		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" record duplicati in settori_prodotti</span>"          		do while not rs.eof			txt=txt & " [idsettore="&rs("idsettore")&" idpro="&rs("idpro")&"]"			rs.movenext		loop		rs.close		txt=txt&"<br>"                    'cerca in settori_prodotti senza settore          sql="select settori_prodotti.ID, settori.idsettore FROM settori RIGHT JOIN settori_prodotti ON settori.idsettore = settori_prodotti.IDsettore WHERE (((settori.idsettore) Is Null));"          rs.Open sql, conn, 3, 3          if n>0 then classe=rosso else classe=""          txt=txt&"<span "&classe&">Trovato "&n&" record in settori_prodotti senza settore padre<br></span>"          rs.close		'ordini		txt=txt& "<b>ordini</b><br>"				'cerca in ordini_dett senza ordini		sql="select ordini_dett.iddett, ordini.idord FROM ordini RIGHT JOIN ordini_dett ON ordini.idord = ordini_dett.idord WHERE (((ordini.idord) Is Null));"		rs.Open sql, conn, 3, 3		if n>0 then classe=rosso else classe=""		txt=txt&"<span "&classe&">Trovato "&n&" ARTICOLI di ordini senza ordine padre</span>"		do while not rs.eof			txt=txt & " [iddett="&rs("iddett")&"]"			rs.movenext		loop		rs.close		txt=txt&"<br>"          sql="select incassi.idincasso, ordini.idord FROM incassi LEFT JOIN ordini ON incassi.idord = ordini.idord WHERE (((ordini.idord) Is Null));"          rs.Open sql, conn, 3, 3          if n>0 then classe=rosso else classe=""          txt=txt&"<span "&classe&">Trovato "&n&" incassi di ordini senza ordine padre<br></span>"          do while not rs.eof          txt=txt & "[incasso="&rs("idincasso")&"] "          rs.movenext          loop          if n>0 then txt=txt&"<br>"          rs.close          'cerca in ordini senza utente          sql="select ordini.idord, utenti.iduser FROM utenti RIGHT JOIN ordini ON utenti.iduser = ordini.iduser WHERE (((utenti.iduser) Is Null));"          rs.Open sql, conn, 3, 3          if n>0 then classe=rosso else classe=""          txt=txt&"<span "&classe&">Trovato "&n&" ordini senza utente padre<br></span>"          do while not rs.eof          txt=txt & "[ordine="&rs("idord")&"] "          rs.movenext          loop          if n>0 then txt=txt&"<br>"          rs.close          txt=txt& "<b>PREVENTIVI</b><br>"          'cerca in dettaglio preventivi senza articoli          sql="select preventivi_dett.iddett, prodotti.IDpro, preventivi_dett.idpro FROM preventivi_dett LEFT JOIN prodotti ON preventivi_dett.idpro = prodotti.IDpro WHERE (((prodotti.IDpro) Is Null) AND ((preventivi_dett.idpro)>0));"          rs.Open sql, conn, 3, 3          if n>0 then classe=rosso else classe=""          txt=txt&"<span "&classe&">Trovato "&n&" record in dettaglio preventivo senza articolo padre<br></span>"          rs.close                          response.Write(txt)            set rs=conn.execute ("SELECT table_name, table_rows, data_length, index_length, round(((data_length + index_length) / 1024 / 1024),2) 'Size in MB' FROM information_schema.TABLES where table_schema = '"&mysql_database&"';")            totale=0          %>          <br>      <table class="c2">        <tr>          <td class="c1">table_name</td>          <td class="c1">table_rows</td>          <td class="c1">data_length</td>          <td class="c1">index_length</td>          <td class="c1">Size in MB</td>        </tr><%            do while not rs.eof  %>        <tr>          <td><%=rs(0)%></td>          <td><%=rs(1)%></td>        <td><%=rs(2)%></td>          <td><%=rs(3)%></td>          <td><%=rs(4)%></td>        </tr><%        	totale=totale+cdbl(rs(4))            rs.movenext            loop            set rs=Nothing                                                                                                            call connclose()        %>      </table>      <%            response.write "Dimensione totale:"&totale%>    </div>    <div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" -->  </div></body></html>