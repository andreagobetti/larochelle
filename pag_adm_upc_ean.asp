<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()oper=request.form("oper")if request.form("elimina")<>"" then	sql="DELETE FROM utenti_tipologia WHERE id =" & request.form("id") & ";"	conn.execute(sql)end ifselect case lcase(request("oper"))	case "annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case else		oper="view"		if request.form("modifica")<>"" then oper="edit"end selectif oper="add" or oper="update" then	'controlliend ifif oper="add" or oper="update" then	Set rs = Server.CreateObject("ADODB.Recordset")	sql="select * from upc_ean"	codici_non_caricati=""	codici_caricati=0	elenco_codici=split(request.form("elenco_codici"),vbcrlf)	n=ubound(elenco_codici)	rs.Open sql, conn, 3, 3	for i=0 to n		if trim(elenco_codici(i))<>"" then			rs.addnew			rs("upc_ean")=elenco_codici(i)			on error resume next			rs.update			if err.number<>0 then				codici_non_caricati=codici_non_caricati&elenco_codici(i)&"<br>"			else				codici_caricati=codici_caricati+1			end if			err.clear		end if	next	testo="Caricati "&codici_caricati&" codici"	if codici_non_caricati<>"" then testo=testo&"<br><b>I seguenti codici non sono stati caricati:</b><br>"&codici_non_caricati	rs.close	oper="view"end if'response.write oper%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><link rel="stylesheet" type="text/css" href="Jquery/js/colpick/colpick.css"/><style>/*notification-bubble  */.notification-bubble {	font-size:inherit;	float:none;	display:inline-block;}</style></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Codici upc ean</a></div>        <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>"  style="margin-top:0px;">		        <%	    response.write testosql="select upc_ean.*, prodotti.codice, prodotti.articolo from (upc_ean left join prodotti on upc_ean.idpro = prodotti.idpro) "if oper="view" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr align="right">               <td colspan="3" style="border-bottom:1px solid;"><span style="float:right;">	                             <input type="button"  value="Carica codici" style="FONT: 12px;" onclick="window.location.href='<%=questofile%>?oper=new'"></span>                                </td>            </tr>            <tr>               <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Modifica&nbsp;</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Codice</td><td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Articolo</td>            </tr>            <%	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;">	               <%if false then %> <input type="radio" name="modifica" value="<%=rs("upc_ean")%>" onclick="this.form.submit()">               <%end if %>              </td>              <td nowrap style="border-bottom:1px solid;"><%=rs("upc_ean")%></td>              <td nowrap style="border-bottom:1px solid;"><%=rs("codice")&" "&rs("articolo")%></td>            </tr>            <%	rs.movenext	loop	set rs = Nothing	%>          </table>          <%elsetxt=request.form("modifica")if request.form("id")<>"" then txt=request.form("id")	sql=sql & " where id =" & txt	if request.form("modifica")<>"" then		set rs=conn.execute(sql)		testo= "Modifica tipologia"			else		testo= "Aggiungi codici"	end if		  %>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header"><%response.write testo%></td>            </tr>            <tr>               <td align="right" valign="top">Incolla i codici nella casella</td>              <td>  <textarea name="elenco_codici" rows="20" cols="15"></textarea>              </td>            </tr>			<tr><td colspan="2">        <%	        Set rs = Nothingif oper="view" then	txt=puls_newelseif oper="new" or error<>"" then	txt="Aggiungi"elseif oper="edit" then	txt="Modifica"end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Annulla" onclick="annulla=true;">    <%end if%>    <%if oper="edit" and num=0 and error="" then%>    <input type="submit" name="elimina" value="Elimina">            <%end if	%></td></tr>	          </table>    <%end if	call connclose()%>        </form>         <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%rsClose%>