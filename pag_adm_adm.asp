<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/paginazione.asp" --><!--#include virtual="/parser.asp" --><%	if session("idadmin") = "" then call login()if not ha_il_permesso("Z1") and not utente_andrea then	add2log "Tentativo di accesso a pagina gestione admin eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",3	call via_senza_permesso("Z1")end ifoper=lcase(request("oper"))iduser=request.form("iduser")if request.form("modifica")<>"" then	iduser=request.form("modifica")end if'response.write operdim permessipermessi=array("A1","A2","A3","A4","A5","A6","B1","B2","B3","C1","C2","C3","C4","C5","D1","D2","E1","E2","E3","E4","E5","F1","F2","G1","Z1","Z2")select case oper	case "annulla"		oper="list"	case "new"		oper="new"	case "aggiungi"		oper="edit"	case "modifica"		oper="update"	case else		oper="list"		if request.form("modifica")<>"" then oper="view"		if request.form("edit")<>"" then oper="edit"		if request.querystring("iduser")<>"" then			oper="view"			iduser=request("iduser")		end ifend select'response.write operif oper="add" or oper="update" then	'controlliend iftabella="utenti"tabellaid="iduser"if ha_il_permesso("Z1") or utente_andrea then	if oper="add" or oper="update" and error="" then				txt_nominativo=get_nominativo(iduser)		set rs = nothing		'Gestione tabella admin		Set rs_admin = Server.CreateObject("ADODB.Recordset")		sql= "select * from admin where iduser=" & iduser		rs_admin.Open sql, conn, 1, 3		if rs_admin.eof then			'Non c'è, aggiungo record			rs_admin.addNew			rs_admin("iduser")=iduser		end if		rs_admin("nominativo")=txt_nominativo		if request.form("admin_l")>0 then			if rs_admin("admin_l")<>cint(request.form("admin_l")) then				txt="Impostato privilegio admin livello "& livello_admin(request.form("admin_l"))			else				txt="Impostato permessi "			end if			rs_admin("admin_l")=request.form("admin_l")			'rs_admin("admin")=true			rs_admin("fine")=NULL			permessi_txt=""			for n=0 to UBound(permessi)				if request.form(permessi(n))="si" then					call concatena_stringa( permessi_txt,",",permessi(n)&"=1")				end if			next			rs_admin("permessi")=permessi_txt						admin=true		else			'rs_admin("admin")=false			rs_admin("fine")=now()			rs_admin("admin_l")=0			txt="Tolto privilegio admin "			admin=false		end if		testo_log="[b]"&txt&"[/b] a [utente="&iduser&"]"&txt_nominativo&"[/utente] eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin], permessi:"&replace(permessi_txt,",",", ")		if rs_admin("registro")<>"" then rs_admin("registro")=rs_admin("registro")&"<hr>"		rs_admin("registro")=rs_admin("registro")&now()&"-"&testo_log		rs_admin.update		rs_admin.Close		set rs_admin=Nothing				add2log testo_log,3		oper="list"	end ifend if	'response.write oper%><!--#include virtual="/sub_head_adm.asp" --><script Language="JavaScript"> function Valida_ricerca() {		if ((document.form1.cercain.value == 'nominativo' )&&(document.form1.cerca.value == '')) {		alert("Inserire il nominativo nella casella cerca.");		document.form1.cerca.focus();		return false;	}	if ((document.form1.cercain.value == 'id' )&&(document.form1.cerca.value == '')) {		alert("Inserire id cliente nella casella cerca.");		document.form1.cerca.focus();		return false;	}	if ((document.form1.cercain.value == 'citta' )&&(document.form1.cerca.value == '')) {		alert("Inserire il nome citta nella casella cerca.");		document.form1.cerca.focus();		return false;	}	if ((document.form1.cercain.value == 'azienda' )&&(document.form1.cerca.value == '')) {		alert("Inserire il nome azienda nella casella cerca.");		document.form1.cerca.focus();		return false;	}	if ((document.form1.cercain.value == 'email' )&&(document.form1.cerca.value == '')) {		alert("Inserire l\'indirizzo email nella casella cerca.");		document.form1.cerca.focus();		return false;	}	document.form1.submit();} function Valida_form(txt) {    if (document.form1.iduser.value == "" ) {     alert("Inserire ID utente");	document.form1.iduser.focus(); 	return (false);   }document.form1.oper.value=txt;document.form1.submit();}</script><script type="text/javascript">function show_confirm(){if (	document.form1.admin.checked ==true){	var r=confirm('Confermi l\'impostazione di admin?');	if (r==true){ 		document.form1.admin.checked =true;	  	  }	else	  {		document.form1.admin.checked =false;		document.getElementById('admin_l').selectedIndex = 0;	  }  }    else  {	  	  document.getElementById('admin_l').selectedIndex = 0;  }}</script>           <script>function Errore(){<%if error<>"" then%>	alert('<%=error%>');<%end if%>	}</script><style>	.soloio{		<%if not utente_andrea then %>		display: none;		<%end if %>			}		</style></head><body onLoad="Errore()"><div id="wrap"><div id="header"><%=titolo_top%> <!-- Box CORPO INIZIO-->      	  <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>" class="Amministra_piccolo">Gestione admin</a></div>            <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;" >          <!-- Colonna CORPO INIZIO-->          <%if oper="list" then		'sql="select admin.iduser, admin.Nominativo, admin.fine, admin.admin_l, utenti.nome, utenti.cognome, utenti.email, utenti.numvisit,utenti.lastvisit, utenti.password_inviata, utenti.HTTP_USER_AGENT FROM admin INNER JOIN utenti ON admin.iduser = utenti.iduser where admin.fine is null"		sql="select admin.iduser, admin.Nominativo, admin.fine, admin.admin_l, utenti.lastvisit FROM admin left join utenti on admin.iduser=utenti.iduser where admin.fine is null "		if not utente_andrea then			sql=sql&" and admin.iduser>1 "		end if		ordine=" order by admin.iduser desc"		'-----------sezione ricerca inizio		if cercain<>"" or request.form("cerca_hidden")<>"" then			select case cercain			case "novisite"				sql1=" numvisit=0"			case "id"				sql1=" iduser=" &cerca			case "nominativo"				sql1=" iduser=" &cerca				sql1=" InStr([nome],'" & cerca& "')>0 or InStr([cognome],'" & cerca& "')>0"			case "nominativo2"				sql1=" [nome]&' '&[cognome]='"&cerca&"'"			case "admin"				sql1=" admin=true"			case "piva"				sql1=" piva like '%"&cerca&"%'"			case else				if cercain<>"" then	sql1=" InStr([" & cercain &"],'" & cerca& "')>0"				if request.form("cerca_hidden")<>"" then sql1=" iduser="& request.form("cerca_hidden")			end select			if instr(sql,"where")=0 then				sql1=" where admin=true" & sql1			else				sql1=" and " & sql1			end if			sql=sql & sql1		end if		order="&cercain="&cercain&"&cerca="&cerca		'-----------sezione ricerca fine		'response.write sql		strSql = sql &ordine		%>         <%=response.write (errore)%>                 <table width="100%" border="0" cellpadding="2" cellspacing="0" bordercolor="#CCCCCC" class="tabella1">            <tr>              <td colspan="4" align="right"><a href="<%=questofile%>?oper=new"><strong>Nuovo admin</strong></a></td>            </tr>            <tr>              <td align="center" bgcolor="#E5E5E5"><p> Edit</p></td>              <td bgcolor="#E5E5E5">Nominativo/Email</td>              <td align="center" bgcolor="#E5E5E5">Livello admin</td>              <td align="center" bgcolor="#E5E5E5">Ultimo accesso</td>            </tr>            <%call paginazione_start(strsql,1000,"mysql")Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>            <tr>              <td align="center" style="border-bottom:1px solid;"><input type="radio" name="modifica" value="<%=objPagingRS("iduser")%>" onClick="this.form.submit()"></td>              <td style="border-bottom:1px solid;"><b><%=objPagingRS("nominativo")%>&nbsp;<%'=objPagingRS("cognome")%></b><br>                <a href='mailto:<%'=objPagingRS("email")%>'><%'=objPagingRS("email")%></a>                                <br>                <%'=objPagingRS("password_inviata")%></td>                            <td align="center" style="border-bottom:1px solid;"><%=livello_admin(objPagingRS("admin_l"))%></td>              <td align="center" style="border-bottom:1px solid;"><%=objPagingRS("lastvisit")%></td>            </tr>            <% 			iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop			call paginazione_end(4,false)%>                                  </table>					  			<div class="ui-widget-header ui-corner-top" style="line-height: 30px;">Vecchi admin</div>			<table width="100%" border="0" cellpadding="2" cellspacing="0" bordercolor="#CCCCCC" class="ui-widget ui-widget-content">            <tr bgcolor="#E5E5E5">              <td align="" style="border-bottom:1px solid;"></td>              <td align="" style="border-bottom:1px solid;">Nominativo</td>              <td  align="" style="border-bottom:1px solid;">Fine permesso admin</td>            </tr><%	        set rs_admin=conn.execute ("select * from admin where fine is not null order by fine desc")    	        do while not rs_admin.eof            %>            <tr>              <td align="center" style="border-bottom:1px solid;"><input type="radio" name="modifica" value="<%=rs_admin("iduser")%>" onClick="this.form.submit()"></td>              <td style="border-bottom:1px solid;"><b><%=rs_admin("nominativo")%></b></td>              <td align="" style="border-bottom:1px solid;"><%=rs_admin("fine")%></td>            </tr><%			rs_admin.MoveNext			loop			set rs_admin=nothing    %>          </table>          <%else %>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>              <td colspan="3" class=ui-widget-header><%			  if oper<>"new" then				if request.querystring("iduser")<>"" then iduser=request.querystring("iduser")					if request.form("oper")="Aggiungi" then												sql="select admin.iduser, admin.Nominativo, admin.fine, admin.admin_l, admin.registro, utenti.nome, utenti.cognome, utenti.email, utenti.numvisit,utenti.lastvisit, utenti.password_inviata, utenti.data, utenti.HTTP_USER_AGENT FROM admin RIGHT JOIN utenti ON admin.iduser = utenti.iduser where utenti.iduser=" & iduser						sql="select utenti.*, utenti_intestazioni.nome, utenti_intestazioni.cognome, admin.Nominativo, admin.fine, admin.admin_l, admin.registro FROM utenti left join admin on utenti.iduser=admin.iduser left join utenti_intestazioni on utenti.idintestazione = utenti_intestazioni.id  where utenti.iduser=" & iduser											else						sql="select admin.iduser, admin.Nominativo, admin.fine, admin.admin_l, admin.registro, utenti.nome, utenti.cognome, utenti.email, utenti.numvisit,utenti.lastvisit, utenti.password_inviata, utenti.data, utenti.HTTP_USER_AGENT FROM admin INNER JOIN utenti ON admin.iduser = utenti.iduser where admin.iduser=" & iduser						sql="select admin.iduser, admin.Nominativo, admin.fine, admin.admin_l, admin.registro, admin.permessi FROM admin where admin.iduser=" & iduser					end if					permessi=""					set rs=conn.execute(sql)					if  request.form("oper")="Aggiungi" then											nominativo_v=rs("nome")&" "&rs("cognome")					else						nominativo_v=rs("nominativo")						permessi=rs("permessi")					end if				end if					if oper="view" then%>Scheda admin<%else%>                Modifica admin                  <%end if		  %>              </td>            </tr>            	            	            	                        <%if oper="view" then disabled=" disabled"%>            <tr>              <td colspan="3" valign="top"><strong>Dati utente               <%if oper="view" and (iduser>1 or utente_andrea) then%> <input name="edit" type="submit"  style="FONT: 12px;" value="Modifica" class="nostampa" ><input name="reset_pw" type="submit"  style="FONT: 12px;" value="Resetta password 123456" class="nostampa"><%end if%>              </strong></td>            </tr>            <tr>              <td>&nbsp;</td>              <td>&nbsp;</td>              <td>&nbsp;</td>            </tr>            <tr>              <td>&nbsp;ID utente:</td>              <td>&nbsp;</td>              <td width="70%"><%if oper<>"new" then%><input type="hidden" name="iduser" value="<%=iduser%>"><%=rs("iduser")%><%else%><input name="iduser" type="text" id="iduser" value="" ><%end if%>              </td>            </tr>            <%if oper<>"new" then%>            <td valign="top">&nbsp;Nominativo</td>              <td valign="top">&nbsp;</td>              <td><b><%=nominativo_v%></b></td>            </tr>            <%if oper="view" then %>			<tr>              <td valign="top">&nbsp;Registro</td>              <td valign="top">&nbsp;</td>              <td><%=FormatText(""&rs("registro"))%></td>            </tr>            			<%end if%>            <%if ha_il_permesso("Z1") or utente_andrea then%>            <tr>              <td>&nbsp;Livello admin</td>              <td>&nbsp;</td>              <td><%	           val=""	           	admin_disabled=disabledif oper="edit" then	if isnull(rs("fine")) then val=" checked"	if rs("admin_l")=4 and not utente_andrea then 		admin_disabled=" disabled"	end if	elseif oper="new" then	val=" checked"else	val=request.form("admin")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>                <select name="admin_l" id="admin_l" <%=admin_disabled%>>                  <option value="0">Nessuno</option>                  <%for n=1 to livello_admin(0)response.write "<option value='"&n&"'"if rs("admin_l")=cint(n) then response.write " selected style='color:red;'"response.write ">" & livello_admin(n)&"</option>"next%>                </select>              </td>            </tr>            <%end if			end if%>				  <%if oper="view"  then	  set rs=conn.execute("select * from utenti where iduser="&iduser)	  	  %>	<tr style="border-top: 1px solid black;">        <td>&nbsp;HTTP_USER_AGENT</td>        <td>&nbsp;</td>        <td><%=rs("HTTP_USER_AGENT")%></td>      </tr>		<tr>            <td valign="top">&nbsp;Data registrazione</td>              <td valign="top">&nbsp;</td>              <td><%=rs("data")%></td>            </tr>            <tr>              <td valign="top">&nbsp;Ultima visita</td>              <td valign="top">&nbsp;</td>              <td><%=rs("lastvisit")%></td>            </tr>            <tr>              <td valign="top">&nbsp;Email attuale</td>              <td valign="top">&nbsp;</td>              <td><%=rs("email")%></td>            </tr>	<%end if%>				</table>		<%if oper<>"new" then %>	<table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">	<tr>        <td colspan="2" class="ui-widget-header">Permessi specifici<%if oper="edit" then %><span style="float: right;"><input type="button" id="pr1" value="Preset AGENTE"><input type="button" id="pr2" value="Preset FATTURAZIONE"><input type="button" id="pr3" value="Preset ADMIN"></span><%end if %></td>      </tr>			<tr>        <td colspan="2" style="background-color: #E5E5E5 ">Clienti</td>	</tr>			<tr>        <td>Crea, modifica</td>                <td><%				val=""				if instr(permessi,"E1=1")>0 then val=" checked"				%>			<input name="E1" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>		<tr>        <td>Visualizza</td>                <td><%				val=""				if instr(permessi,"E2=1")>0 then val=" checked"				%>			<input name="E2" type="checkbox" value="si" <%=disabled%> <%response.write val%>>        </td>	</tr>	<tr>        <td>Menu altro</td>                <td><%				val=""				if instr(permessi,"E5=1")>0 then val=" checked"				%>			<input name="E5" type="checkbox" value="si" <%=disabled%> <%response.wr