4").click(function(){						if($(this).is(':checked')){							$("#a3").prop( "checked", true );						}					});										$("#a3").click(function(){						if(!$(this).is(':checked')){							$("#a4").prop( "checked", false );						}					});										$("#b1").click(function(){						if($(this).is(':checked')){							$("#b2").prop( "checked", true );						}					});					$("#b2").click(function(){						if(!$(this).is(':checked')){							$("#b1").prop( "checked", false );						}					});					$("#pr1").click(function(){						console.log("Preset1");						$("input:checkbox").prop('checked', false);						var arrayLength = preset1.length;						console.log("Da settare:"+arrayLength)						for (var i = 0; i < arrayLength; i++) {						    //Do something							$( "input[name='"+preset1[i].toUpperCase()+"']" ).prop( "checked", true );						}					});					$("#pr2").click(function(){						console.log("Preset2");						$("input:checkbox").prop('checked', false);						var arrayLength = preset2.length;						console.log("Da settare:"+arrayLength)						for (var i = 0; i < arrayLength; i++) {						    //Do something							$( "input[name='"+preset2[i].toUpperCase()+"']" ).prop( "checked", true );						}					});					$("#pr3").click(function(){						console.log("Preset3");						$("input:checkbox").prop('checked', true);					});									})	            	            </script>	<%if oper="view" then %>                      <%sql="select * from log where instr(evento,'[utente="& iduser&"]')>0  "		  set rs=conn.execute (sql)		  %>      <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">        <tr>          <td colspan="3" class="ui-widget-header">Eventi ultimo anno</td>        </tr>        <tr>          <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Data</td>          <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>          <td align="left" bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Evento&nbsp;</td>        </tr>        <%do while not rs.eof%>        <tr>          <td style="border-bottom:1px solid;"><%=rs("data")%></td>          <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%		  	testo=rs("causale")		  select case testo		  case 1			  txt="sem_verde_t.gif"		  case 2			  txt="sem_giallo_t.gif"		  case 3		  	txt="sem_rosso_t.gif"		  case else		  	txt="sem_rosso_t.gif"		  end select		  		  %>            <img src="/images/<%=txt%>" width="20" height="20" /></td>          <td style="border-bottom:1px solid;"><%txt=rs("evento")	          response.write FormatText(left(txt,instr(txt,vbcrlf))&"")					  'response.write left(txt,instr(txt,vbcrlf))%></td>        </tr>        <% 			rs.MoveNext	Loop	%>      </table>                                                  <%	          end if		set rs = nothingend ifcall connclose()%>        </form>                <!-- Box CORPO FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div> </body></html>