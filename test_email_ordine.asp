<!--#include virtual="/md5-2.asp"--><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/setup.asp" --><!--   http://webdesign.tutsplus.com/articles/creating-a-simple-responsive-html-email--webdesign-12978 --><%		if request.form("invia")<>"" then	test=true		HTML=""'call invia_mail_registrazione(1)call email_ordine_new(0,"ordine", true)end if%><form action="<%=questofile%>" method="post">	<center>	Email:	<input type="text" name="email" value="<%=request.form("email")%>"> <input type="submit" name="invia" value="Invia"><hr>	</center>	</form><%response.write HTMLsub email_ordine_new(idord,cosa, tabella)	spaziatore="<!-- Spaziatore--><tr><td><br></td></tr>"	set fs=Server.CreateObject("Scripting.FileSystemObject")	filename=Server.MapPath("/email/ordine_inline.html")	if fs.FileExists(filename) then		set t=fs.OpenTextFile(filename,1,false)		html=t.ReadAll		t.close	else		response.write "Il file non esiste:"&filename	end if		dim timertmp,timertmp2	timertmp=timer()	timertmp2=timertmp	if cosa="ordine" then tipo_checkout="ordini"	if cosa="preventivo" then tipo_checkout="preventivi"	sqlm="select "&tipo_checkout&".*, utenti.trattamento_iva, utenti.email, utenti.telefono, utenti.fax, utenti.cellulare FROM "&tipo_checkout&" INNER JOIN utenti ON "&tipo_checkout&".iduser = utenti.iduser  where idord="&idord &";"	if test then		'Modifica per test		sqlm="select "&tipo_checkout&".*, utenti.trattamento_iva, utenti.email, utenti.telefono, utenti.fax, utenti.cellulare FROM "&tipo_checkout&" INNER JOIN utenti ON "&tipo_checkout&".iduser = utenti.iduser order by idord desc limit 1;"	end if	Set rs_ordine = conn.execute (sqlm)	if rs_ordine.eof=false then		idord=rs_ordine("idord")		sql="select impostazioni.dati_trasporto FROM impostazioni"		set rst=conn.execute(sql)		dati_trasporto=split(rst("dati_trasporto"),vbcrlf)		rst.close		set rst=nothing				'Modifico dati base		html=replace(html,"[title]","Nuova registrazione su " & nomesito)		link="http://" & lcase(nomesito) & "/images/logo_email.png"		html=Replace(html,"[nominativo]",nominativo(rs_ordine("nome"),rs_ordine("cognome"),rs_ordine("azienda")))		html=replace(html,"[logo]",link)		html=replace(html,"[nomesito]",nomesito)		set rs_dati_vari=conn.execute ("select dati_vari.* from dati_vari where chiave='mail_fondo'")		if rs_dati_vari.eof then			dati_vari=""			'response.write ubound(dati_vari)				else			dati_vari=rs_dati_vari("valore")		end if		html=replace(html,"[dati_footer]",dati_vari)				'Dati specifici		html=replace(html,"[tit_ordine]",cosa&" <strong>" & rs_ordine("nord")& "</strong> del "&formatdatetime(rs_ordine("data"),2))		stato=rs_ordine("stato")		if test then			stato=3		end if						'COMUNICAZIONE		txtHTML=""		val=rs_ordine("conferma_ordine")		if test then			val="Buongiorno, abbiamo evaso il suo ordine"		end if				if val<>"" then			txtHTML="<tr><td style=""color:#153643;font-family:sans-serif;font-size:16px;line-height:22px;"" >"			txtHTML=txtHTML&"C'&egrave; un messaggio per lei: "			txtHTML=txtHTML&"</td></tr>"			txtHTML=txtHTML&"<tr><td style=""color:#153643;font-family:sans-serif;font-size:16px;line-height:22px;"" >"			txtHTML=txtHTML& val			txtHTML=txtHTML&"</td></tr>"		end if		html=replace(html,"[comunicazione]",txtHTML)				'STATO ORDINE		txtHTML=""		if cosa="ordine" and stato>0 then			//	txtHTML=txtHTML&tr_fatturazione("<strong>Stato ordine:</strong>","<strong>"&stato_ordine(stato)&"</strong>")						txtHTML="<tr><td style=""padding: 8px;line-height: 20px;text-align: left;vertical-align: top; "" >"			txtHTML=txtHTML&"<strong>Stato ordine:</strong></td><td style=""padding: 8px;line-height: 20px;text-align: left;vertical-align: top; ""> " & "<strong>"&stato_ordine(stato)&"</strong>"			txtHTML=txtHTML&"</td></tr>"		end if		html=replace(html,"[stato]",txtHTML)							txtHTML=""					txtHTML=txtHTML&"<tr><td colspan=""2"" style=""padding: 8px;line-height: 20px;text-align: left;vertical-align: top;border-top: 1px solid #ddd; border-bottom: 1px solid black;""><b>Dati fatturazione:</b></td></tr>"&vbcrlf				'txtHTML=txtHTML&tr_fatturazione("Email:",rs_ordine("email"))		if rs_ordine("nome")<>"" or rs_ordine("cognome")<>"" then			txtHTML=txtHTML&tr_fatturazione("Nominativo:",rs_ordine("nome")&" "&rs_ordine("cognome"))		end if		if rs_ordine("azienda")<>"" then			txtHTML=txtHTML&tr_fatturazione("Azienda:",rs_ordine("azienda"))		end if		txtHTML=txtHTML&tr_fatturazione("Indirizzo:",rs_ordine("indirizzo"))		txtHTML=txtHTML&tr_fatturazione("Citt&agrave;:",rs_ordine("citta"))		txtHTML=txtHTML&tr_fatturazione("Cap:",rs_ordine("cap"))		txtHTML=txtHTML&tr_fatturazione("Provincia:",rs_ordine("provincia"))		if rs_ordine("piva")<>"" then			txtHTML=txtHTML&tr_fatturazione("Partita Iva:",rs_ordine("piva"))		end if		txtHTML=txtHTML&tr_fatturazione("Codice Fiscale:",rs_ordine("cf"))		if rs_ordine("D_indirizzo")<>"" then			txtHTML=txtHTML&"<tr><td colspan=""2"" style=""padding: 8px;line-height: 20px;text-align: left;vertical-align: top;border-top: 1px solid #ddd; border-bottom: 1px solid black;""><b>Consegna della merce:</b></td></tr>"&vbcrlf			txtHTML=txtHTML&tr_fatturazione("Azienda:",rs_ordine("d_azienda"))			txtHTML=txtHTML&tr_fatturazione("Indirizzo:",rs_ordine("d_indirizzo"))			txtHTML=txtHTML&tr_fatturazione("Citt&agrave;:",rs_ordine("d_citta"))			txtHTML=txtHTML&tr_fatturazione("Cap:",rs_ordine("cap"))					end if		txtHTML=txtHTML&"<tr><td colspan=""2"" style=""padding: 8px;line-height: 20px;text-align: left;vertical-align: top;border-top: 1px solid #ddd; border-bottom: 1px solid black;""><b>Pagamento e trasporto:</b></td></tr>"&vbcrlf		txtHTML=txtHTML&tr_fatturazione("Metodo di pagamento:",pagamento_fattura(rs_ordine("tipopagamento"),0))		txtHTML=txtHTML&tr_fatturazione("Trasporto:",ucase(tipo_trasporto(rs_ordine("tipo_trasporto"))))		val=rs_ordine("note_spedizione")		if val<>"" then			txtHTML=txtHTML&tr_fatturazione("Note trasporto:",val)		end if		val=rs_ordine("note")		if val<>"" then			txtHTML=txtHTML&tr_fatturazione("Note:",val)		end if		html=replace(html,"[dati_fatturazione]",txtHTML)											txtHTML="<thead>"							txtHTML=txtHTML&"<tr><td colspan=""6"" style=""padding: 8px;line-height: 20px;text-align: left;vertical-align: top;border-top: 1px solid #ddd; border-bottom: 1px solid black;""><b>Articoli ordinati:</b></td></tr>"&vbcrlf		txtHTML=txtHTML&"<tr>"&tr_articoli("<strong>Codice</strong>","<strong>Articolo</strong>", "<strong>Quantit&agrave;</strong>","<strong>Prezzo</strong>", "<strong>Sconto</strong>", "<strong>Totale</strong>")&"</tr></thead>"									sqlm="select * FROM "&tipo_checkout&"_dett "		sqlbase="select xxx.*, magazzino.quantita_magazzino, magazzino.Data_arrivo, magazzino.quantita_riordino, magazzino.quantita_ordinata, varianti_a.variante_a, varianti_b.variante_b FRom ((magazzino RIGHT JoIN xxx oN (magazzino.idvarb = xxx.idvarb) aND (magazzino.idvara = xxx.idvara) aND (magazzino.idpro = xxx.idpro)) LEFT JoIN varianti_b oN xxx.idvarb = varianti_b.IDvarb) LEFT JoIN varianti_a oN xxx.idvara = varianti_a.IDvara where idord="&idord		sqlm=replace(sqlbase,"xxx",tipo_checkout&"_dett")										set rsm=conn.execute(sqlm)		'Ciclo articoli		totord=0		do until rsm.eof			'Articolo			articolo=rsm("articolo_ordine")			if rsm("var1")<>"" then				articolo =articolo & "<br>" & rsm("variante1_ordine") & ": " & rsm("var1") 			end if			if rsm("var2")<>"" then				articolo =articolo & "<br>" & rsm("variante2_ordine") & ": " & rsm("var2")			end if						'Prezzo			prezzo=cdbl(rsm("prezzo"))			sconto_prodotto=cdbl(rsm("sconto_prodotto"))			if sconto_prodotto>0 then				prezzo=prezzo-(sconto_prodotto/100)*prezzo				sconto=formatnumber(sconto_prodotto,2)&"%"			else					sconto="&nbsp;"			end if			txtHTML=txtHTML&"<tr>"&tr_articoli(rsm("codice_ordine"),Articolo, rsm("um")&"&nbsp;"&rsm("quantita"),simbolo_valuta&formatnumber(prezzo,2), sconto, simbolo_valuta&formatnumber(rsm("totale_riga"),2))&"</tr>"									rsm.movenext								loop		rsm.close		set rsm=nothing				'Totali		txtHTML=txtHTML&"<tr><td colspan=""6"" style=""padding: 8px;line-height: 20px;text-align: left;vertical-align: top;border-top: 1px solid #ddd; border-bottom: 1px solid black;""><b>Totali:</b></td></tr>"&vbcrlf		trasporto=cdbl(rs_ordine("trasporto"))		txtHTML=txtHTML&tr_totali("Spese di spedizione:",simbolo_valuta&formatnumber(trasporto,2),0)		totale_merce_ordine=cdbl(rs_ordine("totale_merce_ordine"))		imponibile_ordine=totale_merce_ordine+trasporto		txtHTML=txtHTML&tr_totali("Totale Iva esclusa:",simbolo_valuta&formatnumber(imponibile_ordine,2),0)		if esenzione_iva(rs_ordine("trattamento_iva")) then			valore_iva=0		else			valore_iva=totord*iva(rs_ordine("data"))/100			totord=totord*(1+iva(rs_ordine("data"))/100)		end if		testo_esenzione=" "&trattamento_iva(rs_ordine("trattamento_iva"))		imposta_ordine=cdbl(rs_ordine("imposta_ordine"))		txtHTML=txtHTML&tr_totali("IVA "&iva(rs_ordine("data"))&"%  "&testo_esenzione&":",simbolo_valuta&formatnumber(imposta_ordine,2),0)		totale_ordine=imponibile_ordine+imposta_ordine		txtHTML=txtHTML&tr_totali("Totale Iva inclusa:",simbolo_valuta&formatnumber(totale_ordine,2),0)		'Se c'è applico lo sconto		sconto=cdbl(rs_ordine("sconto_ordine"))		if sconto>0 then			txtHTML=txtHTML&tr_totali("Sconto:",simbolo_valuta&formatnumber(sconto,2),0)			totale_ordine=totale_ordine-sconto		end if		'Totale		txtHTML=txtHTML&tr_totali("<strong>Totale ordine:</strong>","<strong>"&simbolo_valuta&formatnumber(totale_ordine,2)&"</strong>",16)		html=replace(html,"[dati_articoli]",txtHTML)								'Aggiunge pagamento PAYPAL		txtHTML=""		if instr(lcase(pagamento_fattura(rs_ordine("tipopagamento"),0)),"paypal")>0 and Application("codice_paypal")<>"" and cosa="ordine" and rs_ordine("stato")>=3 or test then		 txtHTML=spaziatore&"<!-- Single Column Text Row PAYPAL-->"&_					"<tr>"&_					    "<td  style=""border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#f2eeed;"" >"&_					        "<table width=""100%"" border=""0"" cellspacing=""0"" cellpadding="""" style=""max-width:100%;background-color:transparent;border-collapse:collapse;border-spacing:0;"" >"&_							"<tr><td style=""color:#153643;font-family:sans-serif;font-size:16px;line-height:22px;"" >Pu&ograve; procedere al pagamento con Paypal cliccando sul logo.</td></tr>"&_					           " <tr>"&_					                "<td  style=""color:#153643;font-family:sans-serif;font-size:16px;line-height:22px; text-align: center; "" >"&_					                "<a href=""http://" & lcase(nomesito) & "/orders-list.asp""><img src=""https://www.paypalobjects.com/it_IT/i/btn/x-click-but6.gif"" border=""0"" alt=""Effettua i tuoi pagamenti con PayPal. È un sistema rapido, gratuito e sicuro.""></a>"&_					                "</td></tr><tr><td><br></td></tr></table></td></tr>"		  		  		end if		html=replace(html,"[paypal]",txtHTML)				txtHTML=""		if stato<5 then			'Aggiungo metodi di pagamento			set rs_dati_vari=conn.execute ("select dati_vari.* from dati_vari where chiave='mail_pag'")			if rs_dati_vari.eof then				'Manca il testo					else				txtHTML=spaziatore&"<tr><td><!-- Single Column Text Row METODI PAGAMENTO-->"&rs_dati_vari("valore")&"</td></tr>"			end if								end if		html=replace(html,"[pagamento]",txtHTML)				'[LINK]		link="http://" & lcase(nomesito) & "/order.asp?idord=" & idord		html=replace(html,"[link]",link)						'[FOOTER]		txtHTML=""		set rs_dati_vari=conn.execute ("select dati_vari.* from dati_vari where chiave='mail_ofoot'")		if rs_dati_vari.eof then			'Manca il testo				else			txtHTML=spaziatore&"<tr><td><!-- Single Column Text Row mail_ofoot-->"&rs_dati_vari("valore")&"</td></tr>"		end if		html=replace(html,"[footer]",txtHTML)												toemail=rs_ordine("email")		if test then			'Modifica per test			toemail=request.form("email")		end if		timerstr=timerstr&"----creazione del testo: "&formatnumber(timer()-timertmp,3)&" - "&time()&"<br>"		timertmp=timer()		Const cdoSendUsingMethod        = "http://schemas.microsoft.com/cdo/configuration/sendusing"		Const cdoSendUsingPort          = 2		Const cdoSMTPServer             = "http://schemas.microsoft.com/cdo/configuration/smtpserver"		Const cdoSMTPServerPort         = "http://schemas.microsoft.com/cdo/configuration/smtpserverport"		Const cdoSMTPConnectionTimeout  = "http://schemas.microsoft.com/cdo/configuration/smtpconnectiontimeout"		Const cdoSMTPAuthenticate       = "http://schemas.microsoft.com/cdo/configuration/smtpauthenticate"		Const cdoBasic                  = 1		Const cdoSendUserName           = "http://schemas.microsoft.com/cdo/configuration/sendusername"		Const cdoSendPassword           = "http://schemas.microsoft.com/cdo/configuration/sendpassword"		Dim objConfig		Dim objMessage		Dim Campi		Set objConfig = Server.CreateObject("CDO.Configuration")		Set Campi = objConfig.Fields		With Campi		.Item(cdoSendUsingMethod)       = cdoSendUsingPort		.Item(cdoSMTPServer)            = SMTPServer		.Item(cdoSMTPServerPort)        = 25		.Item(cdoSMTPConnectionTimeout) = 30		.Update		End With		timerstr=timerstr&"----Configurazione email: "&formatnumber(timer()-timertmp,3)&" - "&time()&"<br>"		timertmp=timer()	'EMAIL AL CLIENTE	Set objMessage = Server.CreateObject("CDO.Message")	Set objMessage.Configuration = objConfig			objMessage.Bodypart.Charset = "UTF-8"			if cosa="ordine" then				sql="select * from news where  tipo='E2' order by ordine;"			else				sql="select * from news where  tipo='E3' order by ordine;"			end if			set rsb=conn.execute(sql)			if not rsb.eof then				'HTML = HTML &"<br>" & rsb("testo") & "<br>"			else				add2log "Manca testo per email conferma "&cosa,2			end if									if stato=3 then				rsb.movenext				if not rsb.eof then					'HTML = HTML &"<br>" & rsb("testo") & "<br>"				else					add2log "Manca testo coda per email conferma "&cosa,2				end if			end if			rsb.close			set rsb= nothing			nord=rs_ordine("nord")			objMessage.From = nomesito  & "<" & Application("email_sito") & ">"			objMessage.To = toemail			if stato=0 then				objMessage.Subject = "Conferma ricevimento "&cosa&" " & nord & " su " & nomesito			else				objMessage.Subject = "Aggiornamento "& cosa&" " & nord & " su " & nomesito			end if			objMessage.HtmlBody = HTML 			'on error resume next			if toemail<>"" then objMessage.Send			txtreport="email inviata"			If err.number <> 0 Then				if session("report")<>"" then session("report")=session("report")&"<hr>"				session("report")=session("report")&"<span style=""color: red;""><strong>Errore nell'invio della mail per l'ordine "&nord&" all'indirizzo "&toemail&"</strong></span>"				txtreport="<span style=""color: red;""><strong>Errore nell'invio della mail all'indirizzo "&toemail&"</strong></span>"				add2log "Errore nell'invio della mail per l'ordine "&nord&" all'indirizzo "&toemail&"</strong>",1			End If			set objMessage = Nothing			if false then				Set rs_ordine2 = Server.CreateObject("ADODB.Recordset")				sql="select "&tipo_checkout&".* FROM "&tipo_checkout&" where idord="&idord &";"				rs_ordine2.Open sql, conn, 1, 3				rs_ordine2("comunicazioni_precedenti")=rs_ordine2("comunicazioni_precedenti")&"<hr>"&now()&" <b>"&session("nominativo")&":</b> "&txtreport&"<br>Messaggio: "&request.form("conferma_ordine")				rs_ordine2.update				rs_ordine2.close				set rs_ordine2 = Nothing			end if						timerstr=timerstr&"----Inoltro al cliente: "&formatnumber(timer()-timertmp,3)&" - "&time()&"<br>"			timertmp=timer()			if false then				'EMAIL AL GESTORE				Set objMessage = Server.CreateObject("CDO.Message")				Set objMessage.Configuration = objConfig				objMessage.Bodypart.Charset = "UTF-8"					objMessage.From = nomesito  & "<" & Application("email_sito") & ">"				objMessage.To = Application("email_suppl")&";"				if stato=0 then									objMessage.Subject = "Ricevuto "&cosa&" " & nord & " su " & nomesito				else				objMessage.Subject = "Inviato aggiornamento "& cosa &" "& nord & " da " & nomesito				end if				objMessage.HtmlBody = HTML 				objMessage.Send				set objMessage = Nothing				timerstr=timerstr&"----Inoltro al gestore: "&formatnumber(timer()-timertmp,3)&" - "&time()&"<br>"				timerstr=timerstr&"--Esco da email_ordine, totale: "&formatnumber(timer()-timertmp2,3)&" - "&time()&"<br>"					timertmp=timer()				err.clear				on error goto 0			end if	else		response.write "ordine non trovato"		error=cosa&" "&idord&" non trovato."	end if	set rs_ordine=nothingend subsub invia_mail_registrazione(id)	set fs=Server.CreateObject("Scripting.FileSystemObject")	filename=Server.MapPath("/email/login_inline.html")	if fs.FileExists(filename) then					set t=fs.OpenTextFile(filename,1,false)		html=t.ReadAll		t.close	else		response.write "Il file non esiste:"&filename	end if				dim h	set h = new MD5	dim txt_error	txt_error=""	sql="select utenti.* FROM utenti where iduser=" & id	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 1, 3	if request.QueryString("test")="" then			'Genera password con numero casuale			dim temp_passw					temp_passw=gen_passw()			'rs("password_md5")=h.hash(temp_passw)			'rs.update	end if		'Modifico il testo	html=replace(html,"[title]","Registrazione su " & nomesito)	link="http://" & lcase(nomesito) & "/images/logo_email.png"	html=replace(html,"[logo]",link)			html=replace(html,"[nomesito]",nomesito)	html=Replace(html,"[nome]",rs("nome"))	html=replace(html,"[user]",rs("email"))	html=replace(html,"[password]",temp_passw)		link="http://" & lcase(nomesito) & "/login.asp?email_login=" & rs("email") & "&pass=" & temp_passw	html=replace(html,"[link]",link)	html=replace(html,"[footer]",Application("intestazione_ddt"))			'Response.Write(html)						Const cdoSendUsingMethod        = "http://schemas.microsoft.com/cdo/configuration/sendusing"	Const cdoSendUsingPort          = 2	Const cdoSMTPServer             = "http://schemas.microsoft.com/cdo/configuration/smtpserver"	Const cdoSMTPServerPort         = "http://schemas.microsoft.com/cdo/configuration/smtpserverport"	Const cdoSMTPConnectionTimeout  = "http://schemas.microsoft.com/cdo/configuration/smtpconnectiontimeout"	Const cdoSMTPAuthenticate       = "http://schemas.microsoft.com/cdo/configuration/smtpauthenticate"	Const cdoBasic                  = 1	Const cdoSendUserName           = "http://schemas.microsoft.com/cdo/configuration/sendusername"	Const cdoSendPassword           = "http://schemas.microsoft.com/cdo/configuration/sendpassword"	Dim objConfig	Dim objMessage	Dim Campi	Set objConfig = Server.CreateObject("CDO.Configuration")	Set Campi = objConfig.Fields	With Campi	.Item(cdoSendUsingMethod)       = cdoSendUsingPort	.Item(cdoSMTPServer)            = SMTPServer	.Item(cdoSMTPServerPort)        = 25	.Item(cdoSMTPConnectionTimeout) = 30	.Update	End With	Set objMessage = Server.CreateObject("CDO.Message")	Set objMessage.Configuration = objConfig	objMessage.Bodypart.Charset = "UTF-8"		'EMAIL AL VISITATORE	'sql="select * from news where stato='0' and tipo='E0' order by ordine;"	'set rsb=conn.execute(sql)	'if not rsb.eof then	'	HTML = HTML &rsb("testo")	'else	'	add2log "Manca testo per email di registrazione (0)",2	'end if	'rsb.close	'set rsb= nothing		objMessage.To =  rs("email")	objMessage.From = nomesito  & "<" & Application("email_sito") & ">"	objMessage.Subject = "Registrazione su " & nomesito	objMessage.HtmlBody = html	'on error resume next	objMessage.Send	If err.number <> 0 Then		add2log "Errore invio email di registrazione a [utente="&rs("iduser")&"]"&nominativo(rs("nome"),rs("cognome"),rs("azienda"))&"[/utente]"&" Email:"&rs("email"),3		txt_error=" (invio email di regitrazione fallito)"			else		add2log "Inviata email di registrazione a [utente="&rs("iduser")&"]"&nominativo(rs("nome"),rs("cognome"),rs("azienda"))&"[/utente]"&vbcrlf&"Email:"&rs("email"),2		rs("password_inviata")=now()		rs.update			End If	Set objMessage = Nothing					set fs=Server.CreateObject("Scripting.FileSystemObject")	filename=Server.MapPath("/email/loginadmin_inline.html")	if fs.FileExists(filename) then		set t=fs.OpenTextFile(filename,1,false)		html=t.ReadAll		t.close	else		response.write "Il file non esiste:"&filename	end if	'Modifico il testo	html=replace(html,"[title]","Nuova registrazione su " & nomesito)	link="http://" & lcase(nomesito) & "/images/logo_email.png"	html=replace(html,"[logo]",link)			html=replace(html,"[nomesito]",nomesito)	html=Replace(html,"[nominativo]",rs("nome")&" "&rs("cognome"))	html=replace(html,"[email]",rs("email"))	html=replace(html,"[telefono]",rs("telefono"))		link="http://" & lcase(nomesito) & "/pag_adm_user.asp?iduser=" & id	html=replace(html,"[link]",link)	html=replace(html,"[dati_footer]",Application("intestazione_ddt"))					'EMAIL AL GESTORE	Set objMessage = Server.CreateObject("CDO.Message")	Set objMessage.Configuration = objConfig	objMessage.Bodypart.Charset = "UTF-8"	objMessage.From = nomesito  & "<" & Application("email_sito") & ">"	'objMessage.to = Application("email_sito")	objMessage.to = request.form("email")	objMessage.Subject = "Nuova registrazione su " & nomesito&txt_error	objMessage.HtmlBody = HTML	objMessage.Send	Set objMessage = Nothing	'add2log "Inviata email di registrazione a [utente="&rs("iduser")&"]"&nominativo(rs("nome"),rs("cognome"),rs("azienda"))&"[/utente]"&vbcrlf&"Email:"&rs("email"),2	rs.close	Set rs = Nothingend subfunction tr_fatturazione(key,value)	td="<td style=""padding: 8px;line-height: 20px;text-align: left;vertical-align: top;border-top: 1px solid #ddd;"">"	tr_fatturazione="<tr>"&td&key&"</td>"&td&value&"</td></tr>"end functionfunction tr_articoli(codice,articolo, quantita,prezzo, sconto, totale)	td="<td style=""padding-top:8px;padding-bottom:8px;padding-right:8px;padding-left:8px;line-height:20px;text-align:left;vertical-align:top;border-top-width:1px;border-top-style:solid;border-top-color:#ddd;"" >"	tr_articoli=td&codice&"</td>"&td&articolo&"</td>"&td&quantita&"</td>"&td&prezzo&"</td>"&td&sconto&"</td>"&td&totale&"</td>"end functionfunction tr_totali(key,value,font_size)	dim fontsize	fontsize=""	if font_size>0 then		fontsize="font-size:"&font_size&"px;"	end if	td5="<td colspan=""5"" style=""padding-top:8px;padding-bottom:8px;padding-right:8px;padding-left:8px;line-height:20px;text-align:right;vertical-align:top;border-top-width:1px;border-top-style:solid;border-top-color:#ddd;"&fontsize&" "" >"	td1="<td style=""padding-top:8px;padding-bottom:8px;padding-right:8px;padding-left:8px;line-height:20px;text-align:right;vertical-align:top;border-top-width:1px;border-top-style:solid;border-top-color:#ddd;"&fontsize&" "" >"		tr_totali="<tr>"&td5&key&"</td>"&td1&value&"</td>"&"</tr>"end function%>