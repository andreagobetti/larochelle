<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include file="JSON_latest.asp"--><!--#include file="jsonObject.class.asp"--><%if session("idadmin") = "" then call login()if request("elimina_allegato")<>"" then	call elimina_allegato(request("elimina_allegato"))end ifidset=request("idset")if isnumeric(idset) then idset=cint(idset)cercain=request("cercain")if request("idfor")<>"" then	cercain="idfor"elseif idset>0 then	cosa="settore"	cercain="settore"end ifif request.querystring("ordina")<>"" then	if idset>0 then		response.write "ordino per settore<br>"		'ordino per categoria		getItems = Request.QueryString("id[]")		'split them junks into array		getItems = Split(getItems, ",")		'For each one, define and then execute the sql statement		For i = LBound(getiTems) TO UBound(getItems)		   		   sql_update="UPDATE settori_prodotti SET settori_prodotti.ordine=" & i & " WHERE (settori_prodotti.IDpro = " & getItems(i)&" AND settori_prodotti.IDsettore = "&idset&")"		   'execute this bitch		   conn.Execute sql_update		   'below used for debugging - comment out		   'Response.Write("ID " & getItems(i) & " was set to position " & i)			response.write "."		Next		response.write "<br>"& i&" articoli di questo settore ordinati correttamente"		add2log "Articoli idset " &idset&" ordinati da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2	end ifelsewidth=400 'Larghezza input boxaction=request("action")oper=lcase(request("oper"))'response.write "oper"&oper'response.endselect case oper	case "new"		oper="new"	case "annulla"		action=""		oper="view"	case "duplica"		response.redirect "pag_adm_art_op.asp?cosa=dup&id="&request.form("idpro")	case "elimina"		response.redirect "pag_adm_art_op.asp?cosa=eli&id="&request.form("idpro")	case "riordina_az_cat"		call riordina_az_cat()		oper="view"	case "riordina_az_set"		call riordina_az_set()		oper="view"	case "edit"		call via_senza_permesso("A1")		oper="edit"		idpro=request("idpro")	case else	if request("modifica")<>"" then		call via_senza_permesso("A1")		oper="edit"		idpro=request("modifica")	else		oper="view"	end ifend selectif action<>"" then	'call add2log (queryeform(),0)	idpro=request.form("idpro")	if idpro="" then		sql="select * FROM prodotti "		txt_inizio="Aggiunto" 		nuovo=true	else		sql="select * FROM prodotti WHERE idpro=" & idpro		txt_inizio="Modifica"		nuovo=false	end if	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 1, 3	'------------inserimento modifica dati'Aggiornamento record prodotti	if not nuovo then 'se non è nuovo record memorizzo situazione iniziale		n=rs.fields.count-1		Set Flds = rs.Fields		dim nome_campo()		redim nome_campo(n)		dim valore_campo()		redim valore_campo(n)		'memorizzo i nomi dei campi e i valori attuali		for i=0 to n			nome_campo(i)=RS.Fields(i).Name			valore_campo(i)=converti_typevar14(rs(i))					next	end if	prezzi_aggiornati=false	dim variazione_prezzi	variazione_prezzi=""	'call add2log(queryeform(),0)			rs("datamod")=now()			'SETTORE		str_arr_settori=request.form("settori")		arr_settori = split(str_arr_settori,",")		settore_predefinito=0				set rs_settori=conn.execute( "select settori_prodotti.idsettore from settori_prodotti where idpro="&idpro)		do while not rs_settori.eof			'response.write "trovato settore"&rs("idsettore")&"<br>"			if str_arr_db<>"" then str_arr_db=str_arr_db&","			str_arr_db=str_arr_db&rs_settori("idsettore")			rs_settori.movenext		loop		set rs_settori=nothing		str_arr_db=str_arr_db		'response.write "settori da db:" &str_arr_db&" settori da form:"&str_arr_form&"<br>"		arr_db = split(str_arr_db,",")		'trovo record da eliminare		for i = 0 to ubound(arr_db)			found = "false"				for j = 0 to ubound(arr_settori)				 if (cint(arr_db(i)) = cint(arr_settori(j))) then				 found = "true"				 exit for				 end if				next			if found ="false" then				conn.execute "delete  from settori_prodotti where idpro="&idpro&" and idsettore="&arr_db(i) 				modifiche_rs= modifiche_rs&"Eliminato settore "&arr_db(i)&"<br>"			end if		next				set rs_settori=Server.CreateObject("ADODB.Recordset")		rs_settori.Open "select settori_prodotti.* from settori_prodotti where idpro="&idpro, conn, 1, 3		'trovo record da aggiungere		strOutput = "("		for i = 0 to ubound(arr_settori)			if i=0 then				settore_predefinito=cint(arr_settori(i))			end if			found = "false"				for j = 0 to ubound(arr_db)				 if (cint(arr_settori(i)) = cint(arr_db(j))) then					 found = "true"					 exit for				 end if				next			if found ="false" then				 rs_settori.addnew				 rs_settori("idpro")=idpro				 rs_settori("idsettore")=cint(arr_settori(i))				 rs_settori("ordine")=1				 rs_settori.update				 modifiche_rs= modifiche_rs& "aggiunto settore "&arr_settori(i)&"<br>"				 strOutput=strOutput & arr_settori(i) & ","				 'call aggiungi_settori_bkw(cint(arr_settori(i)))				 'ARR2temp = arr_settori(i)			end if		next		rs_settori.close		set rs_settori=nothing		'SETTORE FINE'MODELLO		str_arr_modelli=request.form("modello")		arr_modelli = split(str_arr_modelli,",")		str_arr_db=""		set rs_settori=conn.execute( "select prodotti_marca_modello.idmodello from prodotti_marca_modello where idpro="&idpro)		do while not rs_settori.eof			'response.write "trovato settore"&rs("idsettore")&"<br>"			if str_arr_db<>"" then str_arr_db=str_arr_db&","			str_arr_db=str_arr_db&rs_settori("IDmodello")			rs_settori.movenext		loop		set rs_settori=nothing		str_arr_db=str_arr_db		'response.write "settori da db:" &str_arr_db&" settori da form:"&str_arr_modelli&"<br>"		arr_db = split(str_arr_db,",")		'trovo record da eliminare		for i = 0 to ubound(arr_db)			found = "false"				for j = 0 to ubound(arr_modelli)				 if (cint(arr_db(i)) = cint(arr_modelli(j))) then				 found = "true"				 exit for				 end if				next			if found ="false" then				conn.execute "delete from prodotti_marca_modello where idpro="&idpro&" and IDmodello="&arr_db(i) 				modifiche_rs= modifiche_rs&"Eliminato modello "&arr_db(i)&"<br>"			end if		next				set rs_settori=Server.CreateObject("ADODB.Recordset")		rs_settori.Open "select prodotti_marca_modello.* from prodotti_marca_modello where idpro="&idpro, conn, 1, 3		'trovo record da aggiungere		strOutput = "("		for i = 0 to ubound(arr_modelli)			found = "false"				for j = 0 to ubound(arr_db)				 if (cint(arr_modelli(i)) = cint(arr_db(j))) then					 found = "true"					 exit for				 end if				next			if found ="false" then				 rs_settori.addnew				 rs_settori("idpro")=idpro				 rs_settori("idmodello")=cint(arr_modelli(i))				 rs_settori.update				 modifiche_rs= modifiche_rs& "aggiunto modello "&arr_modelli(i)&"<br>"				 strOutput=strOutput & arr_modelli(i) & ","				 'ARR2temp = arr_modelli(i)			end if		next		rs_settori.close		set rs_settori=nothing		'MODELLO FINE'TAGS		str_arr_tags=request.form("ttags")		arr_tags = split(str_arr_tags,",")		iubound=ubound(arr_tags)		str_arr_db=""		set rs_settori=conn.execute( "select prodotti_tags.idtag from prodotti_tags where idpro="&idpro)		do while not rs_settori.eof			'response.write "trovato tag"&rs("idtag")&"<br>"			if str_arr_db<>"" then str_arr_db=str_arr_db&","			str_arr_db=str_arr_db&rs_settori("IDtag")			rs_settori.movenext		loop		set rs_settori=nothing		arr_db = split(str_arr_db,",")				'trovo record da eliminare		for i = 0 to ubound(arr_db)			found = "false"				for j = 0 to ubound(arr_tags)				 if (cint(arr_db(i)) = cint(arr_tags(j))) then				 found = "true"				 exit for				 end if				next			if found ="false" then				conn.execute "delete from prodotti_tags where idpro="&idpro&" and IDtag="&arr_db(i) 				modifiche_rs= modifiche_rs&"Eliminato tag "&arr_db(i)&"<br>"			end if		next				set rs_settori=Server.CreateObject("ADODB.Recordset")		rs_settori.Open "select prodotti_tags.* from prodotti_tags where idpro="&idpro, conn, 1, 3		'trovo record da aggiungere		strOutput = "("		for i = 0 to iubound			found = "false"				for j = 0 to ubound(arr_db)				 if (cint(arr_tags(i)) = cint(arr_db(j))) then					 found = "true"					 exit for				 end if				next			if found ="false" then				 rs_settori.addnew				 rs_settori("idpro")=idpro				 rs_settori("idtag")=cint(arr_tags(i))				 rs_settori.update				 modifiche_rs= modifiche_rs& "aggiunto tag "&arr_tags(i)&"<br>"				 strOutput=strOutput & arr_tags(i) & ","				 'ARR2temp = arr_modelli(i)			end if		next		rs_settori.close		set rs_settori=nothing		'TAGS FINE'CORRELATI		str_arr_correlati=request.form("id_pro_consigliati")		'response.write "id_pro_consigliati"&request.form("id_pro_consigliati")&"<br>"		arr_correlati = split(str_arr_correlati,",")		iubound=ubound(arr_correlati)		'response.write "iubound"&iubound&"<br>"		str_arr_db=""		if str_arr_correlati="" then			id_pro_consigliati=null		elseif iubound=0 then			'response.write request.form("id_pro_consigliati")			id_pro_consigliati=cint(request.form("id_pro_consigliati"))		else			id_pro_consigliati=cint(arr_correlati(0))		end if		set rs_settori=conn.execute( "select prodotti_consigliati.idconsigliato from prodotti_consigliati where idpro="&idpro)		do while not rs_settori.eof			'response.write "trovato tag"&rs("idtag")&"<br>"			if str_arr_db<>"" then str_arr_db=str_arr_db&","			str_arr_db=str_arr_db&rs_settori("idconsigliato")			rs_settori.movenext		loop		set rs_settori=nothing		arr_db = split(str_arr_db,",")				'trovo record da eliminare		for i = 0 to ubound(arr_db)			found = "false"				for j = 0 to iubound				 if (cint(arr_db(i)) = cint(arr_correlati(j))) then				 found = "true"				 exit for				 end if				next			if found ="false" then				conn.execute "delete from prodotti_consigliati where idpro="&idpro&" and idconsigliato="&arr_db(i) 				modifiche_rs= modifiche_rs&"Eliminato prodotto consigliato "&arr_db(i)&"<br>"			end if		next				set rs_settori=Server.CreateObject("ADODB.Recordset")		rs_settori.Open "select prodotti_consigliati.* from prodotti_consigliati where idpro="&idpro, conn, 1, 3		'trovo record da aggiungere		strOutput = "("		for i = 0 to iubound			found = "false"				for j = 0 to ubound(arr_db)				 if (cint(arr_correlati(i)) = cint(arr_db(j))) then					 found = "true"					 exit for				 end if				next			if found ="false" then				 rs_settori.addnew				 rs_settori("idpro")=idpro				 rs_settori("idconsigliato")=cint(arr_correlati(i))				 rs_settori.update				 modifiche_rs= modifiche_rs& "aggiunto prodotto consigliato "&arr_correlati(i)&"<br>"				 strOutput=strOutput & arr_correlati(i) & ","				 'ARR2temp = arr_modelli(i)			end if		next		rs_settori.close		set rs_settori=nothing		'CORRELATI FINE'MEPA CATEGORIE		str_arr=request.form("mepa_categorie")		arr = split(str_arr,",")		iubound=ubound(arr)		str_arr_db=""		set rs_settori=conn.execute( "select prodotti_mepa_campi.idcategoria from prodotti_mepa_campi where idpro="&idpro)		do while not rs_settori.eof			'response.write "trovato tag"&rs("idtag")&"<br>"			if str_arr_db<>"" then str_arr_db=str_arr_db&","			str_arr_db=str_arr_db&rs_settori("IDcategoria")			rs_settori.movenext		loop		set rs_settori=nothing		arr_db = split(str_arr_db,",")				'trovo record da eliminare		for i = 0 to ubound(arr_db)			found = "false"				for j = 0 to ubound(arr)				 if (cint(arr_db(i)) = cint(arr(j))) then				 found = "true"				 exit for				 end if				next			if found ="false" then				conn.execute "delete from prodotti_mepa_campi where idpro="&idpro&" and IDcategoria="&arr_db(i) 				modifiche_rs= modifiche_rs&"Eliminato categoria mepa "&arr_db(i)&"<br>"			end if		next				set rs_settori=Server.CreateObject("ADODB.Recordset")		rs_settori.Open "select prodotti_mepa_campi.* from prodotti_mepa_campi where idpro="&idpro, conn, 1, 3		'trovo record da aggiungere		strOutput = "("		for i = 0 to iubound			found = "false"				for j = 0 to ubound(arr_db)				 if (cint(arr(i)) = cint(arr_db(j))) then					 found = "true"					 exit for				 end if				next			if found ="false" then				 rs_settori.addnew				 rs_settori("idpro")=idpro				 rs_settori("idcategoria")=cint(arr(i))				 modifiche_rs= modifiche_rs& "aggiunto categoria mepa "&arr(i)&"<br>"				 strOutput=strOutput & arr(i) & ","			end if			'MEPA CAMPI			elenco_mepa_campi=request.form("elenco_mepa_campi_"&rs_settori("idcategoria"))			if elenco_mepa_campi<>"" then				'trovato mepa campi per questa categoria				arr_campi=split(elenco_mepa_campi,",")				Set Js = jsObject()				for n_campi = 0 to UBound(arr_campi)										n_campo=arr_campi(n_campi)					Js(n_campo)=request.form("mepa_campo_"&n_campo)				next				rs_settori("mepa_campi")=js.jsString											end if						 rs_settori.update					next		rs_settori.close		set rs_settori=nothing		'MEPA CATEGORIE FINE					prezzo_in_varianti=false'GESTIONE VARIANTE A		str_varianti_a=request.form("varianti_a")		if str_varianti_a<>"" then			'response.write "<br>varianti:<br>"			arr_varianti = split(str_varianti_a,", ")						'CARICO LE VARIANTI FORM IN DICT			Dim Dict    'The Dict Object			Dim Record    'The Record Object			Dim Field    'The Field Object			Set Dict = New MultiDimensionalDictionary 'Create an Instance of the Class						for i = 0 to ubound(arr_varianti)					id=cint(arr_varianti(i))					response.write "carico vara "&id&"<br>"					Dict.SetKey = id 'Key record					Dict.SetField "codicevara", request.form("codicevara_"&id)					Dict.SetField "variantea", request.form("variantea_"&id)					Dict.SetField "prezzo_ve", request.form("prezzo_ve_"&id)					Dict.SetField "prezzo_ac", request.form("prezzo_ac_"&id)					Dict.SetField "elimina", request.form("elimina_"&id)					Dict.Update 'Bind the record and preapre for the next record										if request.form("prezzo_ve_"&id)>0 then						prezzo_in_varianti=true					end if			Next						'Apro tabella varianti			set rs_var=Server.CreateObject("ADODB.Recordset")			rs_var.Open "select varianti_a.* from varianti_a where idpro="&idpro, conn, 1, 3			do while not rs_var.eof				id=cint(rs_var("idvara"))				'Elimina variante				if dict.item(id,"elimina")<>"" then					idvara=rs_var("idvara")					set rs_mag=conn.execute("select idmag FROM magazzino WHERE idvara =" & idvara & ";")					do while not rs_mag.EOF						'Elimino movimenti di magazzino						conn.execute "DELETE FROM magazzino_movimenti WHERE idmag =" & rs_mag("idmag") & ";",n						modifiche_rs= modifiche_rs& "Eliminato "&n&" movimenti di magazzino<br>"						conn.execute "DELETE FROM distinta_base WHERE idmag_ven =" & rs_mag("idmag") &" or idvara_ven="&idvara & ";",n						modifiche_rs= modifiche_rs& "Eliminato "&n&" distinte basi prodotto di vendita<br>"						conn.execute "DELETE FROM distinta_base WHERE idmag_acq =" & rs_mag("idmag") &" or idvara_acq="&idvara &  ";",n						modifiche_rs= modifiche_rs& "Eliminato "&n&" distinte basi prodotto di vendita<br>"						rs_mag.MoveNext					loop					set rs_mag= Nothing										conn.execute "DELETE FROM magazzino WHERE idvara =" & rs_var("idvara") & ";",n					modifiche_rs= modifiche_rs& "Eliminato variante A idvara:"&idvara&" "&dict.item(id,"variantea")&" e "&n&" Voci magazzino<br>"										rs_var.delete				else				'Modifica variante esistente					rs_var("codicevara")=dict.item(id,"codicevara")					rs_var("variante_a")=dict.item(id,"variantea")										if ha_il_permesso("A4") then						'Modifica prezzo di acquisto						tmp=cdbl(rs_var("prezzo_ac_va"))						if isnumeric(dict.item(id,"prezzo_ac")) then rs_var("prezzo_ac_va")=aggiusta_decimale(dict.item(id,"prezzo_ac"),"asp")						if tmp<>cdbl(rs_var("prezzo_ac_va")) then							prezzi_aggiornati=true						end if					end if					if ha_il_permesso("A2") then						'Modifica prezzo di vendita						tmp=cdbl(rs_var("prezzo_ve_va"))						if isnumeric(dict.item(id,"prezzo_ve")) then rs_var("prezzo_ve_va")=aggiusta_decimale(dict.item(id,"prezzo_ve"),"asp")						if tmp<>cdbl(rs_var("prezzo_ve_va")) then							prezzi_aggiornati=true							call concatena_stringa( variazione_prezzi ,"<br>","Variazione prezzo variante "&rs_var("variante_a")&" da "&tmp&" a "&rs_var("prezzo_ve_va") )						end if					end if	'ha_il_permesso("A2")					rs_var.update				end if				rs_var.movenext			loop			rs_var.close			set rs_var=nothing		end if		'Aggiunta varianti nuove		str_arr_varianti_new=request.form("varianti_a_new")		'response.write "varianti_a_new:"&str_arr_varianti_new&"<br>"		if str_arr_varianti_new<>"" then			set rs_magazzino=Server.CreateObject("ADODB.Recordset")			set rs_var=Server.CreateObject("ADODB.Recordset")			rs_var.Open "select varianti_a.* from varianti_a where idpro="&idpro,conn,1,3			arr_varianti_new = split(str_arr_varianti_new,", ")			for i = 0 to ubound(arr_varianti_new)				id=arr_varianti_new(i)				response.write "test variante new:"&"variantea_new_"&id&"<br>"				if request.form("variantea_new_"&id)<>"" then					rs_var.addnew					rs_var("idpro")=idpro					rs_var("codicevara")=request.form("codicevara_new_"&id)					rs_var("variante_a")=request.form("variantea_new_"&id)					if ha_il_permesso("A4") then						if isnumeric(request.form("prezzo_ac_new_"&id)) then 							rs_var("prezzo_ac_va")=aggiusta_decimale( request.form("prezzo_ac_new_"&id),"asp")						end if					end if					if ha_il_permesso("A2") then						if isnumeric(request.form("prezzo_ve_new_"&id)) then							rs_var("prezzo_ve_va")=aggiusta_decimale( request.form("prezzo_ve_new_"&id),"asp")							call concatena_stringa( variazione_prezzi ,"<br>","Impostato prezzo variante "&rs_var("variante_a")&" da "&tmp&" a "&rs_var("prezzo_ve_va") )						end if					end if					rs_var.update								modifiche_rs= modifiche_rs& "Aggiunto variante A: "&request.form("variantea_new_"&id)&"<br>"				end if			next			rs_var.close			set rs_var=nothing		end if		set dict=nothing'GESTIONE VARIANTE A FINE'GESTIONE VARIANTE B		str_varianti_b=request.form("varianti_b")		if str_varianti_b<>"" then			'response.write "<br>varianti:<br>"			arr_varianti = split(str_varianti_b,", ")						'CARICO LE VARIANTI FORM IN DICT			Set Dict = New MultiDimensionalDictionary 'Create an Instance of the Class						'response.write "trovate "& ubound(arr_varianti)&" varianti<br>"			for i = 0 to ubound(arr_varianti)					id=cint(arr_varianti(i))					response.write "carico varb "&id&"<br>"					Dict.SetKey = id 'Key record					Dict.SetField "varianteb", request.form("varianteb_"&id)					Dict.SetField "elimina", request.form("elimina_"&id)					Dict.Update 'Bind the record and preapre for the next record			Next			'Apro tabella varianti			set rs_var=Server.CreateObject("ADODB.Recordset")			rs_var.Open "select varianti_b.* from varianti_b where idpro="&idpro, conn, 1, 3			do while not rs_var.eof				id=cint(rs_var("idvarb"))				if dict.item(id,"elimina")<>"" then					idvarb=rs_var("idvarb")					set rs_mag=conn.execute("select idmag FROM magazzino WHERE idvarb =" & idvarb  & ";")					do while not rs_mag.EOF						'Elimino movimenti di magazzino						conn.execute "DELETE FROM magazzino_movimenti WHERE idmag =" & rs_mag("idmag") & ";",n						modifiche_rs= modifiche_rs& "Eliminato "&n&" movimenti di magazzino<br>"						conn.execute "DELETE FROM distinta_base WHERE idmag_ven =" & rs_mag("idmag") &" or idvarb_ven="&idvarb &  ";",n						modifiche_rs= modifiche_rs& "Eliminato "&n&" distinte basi prodotto di vendita<br>"						conn.execute "DELETE FROM distinta_base WHERE idmag_acq =" & rs_mag("idmag") &" or idvarb_ven="&idvarb &  ";",n						modifiche_rs= modifiche_rs& "Eliminato "&n&" distinte basi prodotto di vendita<br>"						rs_mag.MoveNext					loop					set rs_mag= Nothing					conn.execute "DELETE FROM magazzino WHERE idvara =" & rs_var("idvarb") & ";",n					modifiche_rs= modifiche_rs& "Eliminato variante B idvarb:"&idvarb&" "&dict.item(id,"varianteb")&" e "&n&" Voci magazzino<br>"					rs_var.delete				else					rs_var("variante_b")=dict.item(id,"varianteb")					rs_var.update				end if				rs_var.movenext			loop			rs_var.close			set rs_var=nothing		end if		'Aggiunta varianti nuove		str_arr_varianti_new=request.form("varianti_b_new")		'response.write "varianti_b_new:"&str_arr_varianti_new&"<br>"		if str_arr_varianti_new<>"" then			set rs_var=Server.CreateObject("ADODB.Recordset")			rs_var.Open "select varianti_b.* from varianti_b where idpro="&idpro,conn,1,3			arr_varianti_new = split(str_arr_varianti_new,", ")			for i = 0 to ubound(arr_varianti_new)				id=arr_varianti_new(i)				response.write "test variante new:"&"varianteb_new_"&id&"<br>"				if request.form("varianteb_new_"&id)<>"" then					rs_var.addnew					rs_var("idpro")=idpro					rs_var("variante_b")=request.form("varianteb_new_"&id)					rs_var.update					modifiche_rs= modifiche_rs& "Aggiunto variante B: "&request.form("varianteb_new_"&id)&"<br>"				end if			next			rs_var.Close			set rs_var=Nothing		end if'GESTIONE VARIANTE B FINE'GESTIONE BRANDbrand=cint(request.form("idbrand"))set rs_brand=Server.CreateObject("ADODB.Recordset")rs_brand.Open "select prodotti_brand.* from prodotti_brand where idpro="&idpro, conn, 1, 3if brand=0 and not rs_brand.eof then	'Elimino brand	modifiche_rs= modifiche_rs& "Eliminato brand: "&rs_brand("idbrand")&"<br>"	rs_brand.deleteelseif brand=0 then	'nessun brandelse	'Modifico brand	if rs_brand.eof then		rs_brand.addnew		rs_brand("idpro")=idpro		rs_brand("idbrand")=brand		modifiche_rs= modifiche_rs& "Aggiunto brand<br>"	else		if rs_brand("idbrand")<>brand then 			rs_brand("idbrand")=brand			modifiche_rs= modifiche_rs& "Modificato brand<br>"		end if	end if	rs_brand.Update end ifrs_brand.Closeset rs_brand=Nothing'GESTIONE BRAND FINE				rs("codice")=ucase(pulisci_stringa(request.form("codice")))		rs("articolo")=firstup(pulisci_stringa(request.form("articolo")))		rs("um")=firstup(request.form("um"))		rs("descrizione")=firstup(request.form("descrizione"))		if edit_lang_en then			rs("articolo_en")=firstup(pulisci_stringa(request.form("articolo_en")))			rs("descrizione_en")=firstup(request.form("descrizione_en"))		end if		rs("parole_ricerca")=trim(request.form("parole_ricerca"))		rs("MetaDescription")=left(trim(request.form("MetaDescription")),200)		rs("descrizione_listino")=request.form("descrizione_listino")		'rs("descreg")=firstup(request.form("descreg"))		rs("idcat")=cint(settore_predefinito)		rs("variante1")=firstup(request.form("variante1"))		rs("variante2")=firstup(request.form("variante2"))		rs("note_prodotto")=trim(request.form("note_prodotto"))				'Prezzo		if (ha_il_permesso("A2") and prezzo_in_varianti=false)  then			if isnumeric(request.form("prezzo")) then				old_prezzo=cdbl(rs("prezzo"))				rs("prezzo")=aggiusta_decimale(request.form("prezzo"),"asp")				if old_prezzo<>cdbl(rs("prezzo")) then					prezzi_aggiornati=true					call concatena_stringa( variazione_prezzi ,"<br>","Variazione prezzo da "&old_prezzo&" a "&rs("prezzo") )					rs("data_agg_prezzo")=date()				else					if request.form("data_agg_prezzo")<>"" then rs("data_agg_prezzo")=request.form("data_agg_prezzo")				end if			end if		end if		if prezzo_in_varianti then			rs("prezzo")=0		end if		'CALCOLO PREZZO MINIMO		set minimo=conn.execute ("Select min(prezzo_ve_va) as prezzo_minimo from varianti_a where prezzo_ve_va>0 and idpro="&idpro)		if minimo.eof then 'Nessun prezzo su varianti			rs("prezzo_ve_min")=null		else						prezzo=cdbl(rs("prezzo"))			prezzo_minimo=minimo("prezzo_minimo")			if isnull(prezzo_minimo) then				prezzo_minimo=0			else				prezzo_minimo=cdbl(prezzo_minimo)			end if			if prezzo<prezzo_minimo and prezzo>0 then				rs("prezzo_ve_min")=prezzo			else				rs("prezzo_ve_min")=prezzo_minimo			end if		end if		set minimo=nothing																		if ha_il_permesso("A2")  then						rs("fascia_di_sconto")=request.form("fascia_di_sconto")						if (ha_il_permesso("A4") and ha_il_permesso("A3")) and prezzo_in_varianti=false and isnumeric(request.form("costo")) then								old_costo=cdbl(rs("costo"))				rs("costo")=aggiusta_decimale(request.form("costo"),"asp")				if old_costo<>cdbl(rs("costo")) then					prezzi_aggiornati=true					rs("data_agg_costo")=date()					call concatena_stringa( variazione_prezzi ,"<br>","Variazione prezzo acquisto da "&old_costo&" a "&rs("costo") )				else					if request.form("data_agg_costo")<>"" then rs("data_agg_costo")=request.form("data_agg_costo")				end if			end if			rs("prezzo_visibile")=Request.form("prezzo_visibile")		end if				rs("visibilita")=request.form("visibilita")		if request.form("prodata")="" then			txt=null		else			txt=request.form("prodata")		end if		rs("prodata")=txt		if request.form("promozione")="si" then			rs("promozione")=1		else			rs("prodata")=NULL			rs("promozione")=0		end if		txt=trim(request.form("sconto"))		if len(txt)>0 then			txt=cint(txt)		else			txt=0		end if		rs("sconto")=txt		rs("protesto")=firstup(request.form("protesto"))		if request.form("novita")="si" or request.form("novdata")<> "" then			rs("novita")=1		else			rs("novita")=0		end if		if request.form("novdata")="" then			rs("novdata")=null		else			rs("novdata")=request.form("novdata")		end if		txt=""		raggruppa=split(request.form("raggruppa"), ", ")		for i= 0 to ubound(raggruppa)			txt=txt & "," & raggruppa(i)		next		'response.write "i=" & i & "|txt="&txt		if (i)>0 then txt=txt & ","		rs("raggruppa")=txt		if request.form("vendita")="si" then			rs("vendita")=1		else			rs("vendita")=0		end if		rs("disponibilita")=request.form("disponibilita")		rs("misura_articolo")=request.form("misura_articolo")				val=request.form("peso_articolo")		if val="" then val=0		rs("peso_articolo")=val				val=request.form("colli")		if val="" then val=0		rs("colli")=val				if request.form("richiedi_seriale")="si" then			rs("richiedi_seriale")=1		else			rs("richiedi_seriale")=0		end if		rs("id_pro_consigliati")=id_pro_consigliati		if ha_il_permesso("A5") then			rs("idfor")=cint(request.form("idfor"))			rs("codice_fornitore")=trim(request.form("codice_fornitore"))		end if		rs("flag")=cint(request.form("flag"))		rs("aggiungi_a_ordine")=cint(request.form("aggiungi_a_ordine"))		if mod_dip then			tipo_taglia_new=cint(request.form("tipo_taglia"))			if not nuovo then				if tipo_taglia_new<>cint(rs("tipo_taglia")) then					aggiorna_misure=true				else					log_aggiorna_misure_articolo_in_ordini=vbcrlf&"tipo_taglia invariato"				end if			end if			rs("tipo_taglia")=tipo_taglia_new		end if						if request.form("yatego")="si" then rs("yatego")=1 else rs("yatego")=0		if request.form("in_evidenza")="si" then rs("in_evidenza")=1 else rs("in_evidenza")=0								'IMMAGINE PREDEFINITA		set rs_file=conn.execute("select files.* from files where cosa=4 and idcosa="&idpro&" order by ordine")		if not rs_file.eof then			rs("fileimg")=rs_file("filename")		else			rs("fileimg")="no_img.jpg"		end if		set rs_file=Nothing		add2logLiv=2		if not nuovo then 'se non è nuovo record confronto con situazione iniziale			for i=0 to n				val_rs=converti_typevar14(rs(i))				if ((valore_campo(i)<>val_rs) or (isnull(valore_campo(i)) and not isnull(rs(i)))) and i<>2 then					modifiche_rs=modifiche_rs&"modificato campo "&nome_campo(i)&"<br>"				end if			next			if modifiche_rs="" then				modifiche_rs="Nessuna modifica"				add2logLiv=1			else				application("cache_settori_admin")=""				sql="DELETE FROM carrello WHERE (((carrello.idpro)="&idpro&"))"				conn.execute sql,num				if num>0 then					modifiche_rs=modifiche_rs&"Articolo eliminato da "&num&" carrelli<br>"				end if			end if		end if		testo=rs("codice") & " " & rs("articolo")		codice=rs("codice")		id=rs("idpro")		rs.update		if oper="add" then			id=Get_last_id("prodotti")		end if		rs.Close				if aggiorna_misure then			log_aggiorna_misure_articolo_in_ordini=vbcrlf& aggiorna_misure_articolo_in_ordini(idpro)		end if								call aggiusta_magazzino()		if variazione_prezzi<>"" then			variazione_prezzi="<br>"&variazione_prezzi		end if		add2log txt_inizio&" [articolo="& id&"]"&codice&"[/articolo] eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]"&vbcrlf&modifiche_rs&str_add2log&variazione_prezzi&log_aggiorna_misure_articolo_in_ordini, add2logLiv		Set rs = Nothing		call connclose()		txt="product.asp?idpro="&id		call reset_contenuti_home()		response.redirect txtend ifsub riordina_az_cat_tutto()	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	sql_order = "select prodotti.idcat FROM prodotti GROUP BY prodotti.idcat;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof			sql="select * from prodotti where idcat="&rs_order("idcat")&" order by articolo;"			'response.write sql			rs.open sql, conn,3,3			'response.end			ordine=10			do while not rs.eof			rs("ordine")=ordine			rs.update			ordine=ordine+10			rs.movenext			loop			rs.close		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Subsub riordina_az_cat()	'declaring		dim rs		sql="select * from prodotti where idcat="&request.querystring("idcat")&" order by articolo;"		Set rs = Server.CreateObject("ADODB.Recordset")		rs.open sql, conn,3,3		'response.end		ordine=1		do while not rs.eof		rs("ordine")=ordine		rs.update		ordine=ordine+1		rs.movenext		loop		rs.close		set rs=nothing		add2log "Articoli idcat " &request.querystring("idcat")&" ordinati per articolo da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2End Sub	sub riordina_az_set()	'declaring			dim rs			sql="select settori_prodotti.id, settori_prodotti.IDsettore, settori_prodotti.ordine, prodotti.articolo FROM settori_prodotti INNER JOIN prodotti ON settori_prodotti.IDpro = prodotti.IDpro where settori_prodotti.IDsettore="&request.querystring("idset")&" order by articolo;"			Set rs = Server.CreateObject("ADODB.Recordset")			rs.open sql, conn,3,3			'response.end			ordine=1			do while not rs.eof						conn.execute("update settori_prodotti set ordine="&ordine& " where id="&rs("id"))			ordine=ordine+1			rs.movenext			loop			rs.close			set rs=nothing			add2log "Articoli idset " &request.querystring("idset")&" ordinati per articolo da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2End Sub	sub mappasetselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	sql_order = "select * FROM settori WHERE idpadre = " & id &"  order by nome_settore;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next		response.write "<option value=""" & rs_order("idsettore") &""""	if int(val)=int(rs_order("idsettore")) then response.write " selected"	response.write ">" &spaceing& rs_order("nome_settore")& "</option>"		'calling again to find more childs - if not rs_order=nothing		call mappasetselezione(layer+1,rs_order("idsettore"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include vi