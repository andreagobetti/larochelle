n Validator(theForm) {if (annulla==true)  { 	return(true);      } <%if view="" then%>  if (theForm.codice.value == "")  {     alert("Inserire il codice.");	theForm.codice.focus(); 	return (false);   }  <%end if%>  return (true); } charCount = 1;maxCharCount = 2000;function displayRemLength(fieldName) {	remField = document.getElementById(fieldName);	remField.innerHTML = (maxCharCount - charCount > 0) ? maxCharCount - charCount : 0;}function evalEntryLength(curField, maxLimit, discardXtra, errClass, normalClass) {	maxCharCount = maxLimit;	var fieldLength = getCharCount(curField);		if (fieldLength > maxLimit) {		if (errClass != "") {			curField.className = errClass;		}		if (discardXtra) {			showAllowedLength(curField, maxLimit);		}	} else if (normalClass != "") {		curField.className = normalClass;	}}function getCharCount(curField) {	charCount = curField.value.length;		return charCount;}function showAllowedLength(curField, maxLimit) {	curField.value = curField.value.substr(0, maxLimit);	window.status = curField.value;}</script>    <form name="form1" id="form1" method='post' action="<%=questofile%>?action=<%=action%>" style="margin-top:0px;"  >	<input type="hidden" name="idpro" value="<%=idpro%>" />      <%	if oper="edit" then		cancellabile=true		n_ordini=clng(conn.Execute("select Count(*) FROM ordini_dett where idpro="& idpro &";")(0).Value)		n_preventivi=clng(conn.Execute("select Count(*) AS num FROM preventivi_dett where idpro="& idpro &";")(0).Value)		n_ordini_fornitore=clng(conn.Execute("select Count(*) AS num FROM ordini_fornitori_dett where idpro="& idpro &";")(0).Value)		sql="select  Count(carrello.iduser), Max(utenti.Lastvisit) FROM carrello INNER JOIN utenti ON carrello.iduser = utenti.iduser where (((carrello.idpro)="& idpro &"));"		set rsm=conn.execute(sql)		n_carrelli=rsm(0)		if not isnull(n_carrelli) then n_carrelli=clng(n_carrelli)		lastvisit=rsm(1)		set rsm=nothing	end if	%>      <div class="div_titolo"><%=testo_titolo%></div>      <div class="div_testo" style="text-align:center;">        <input type="submit" name="oper" value="<%=txt1%>" id="submitbt">        <button   style="FONT: 12px;" id="annulla">Esci senza salvare</button>        <%if oper<>"new" then%>        <button   style="FONT: 12px;" id="elimina">Elimina</button>        <button   style="FONT: 12px;" id="duplica">Duplica</button>                <%end if%>      </div>      <%if cancellabile=false then%>      <div class="div_testo" style="text-align:center;"><%=cancellabile_testo%></div>      <%end if%>      <%	            if rs("visibilita")>2 then      %>      <div class="div_testo" style="background:#F00; text-align:center;">Questo articolo è disattivato: non è visibile dai clienti</div>      <%end if%>            <div id="tabs" <%="style=""display:none;"""%>>        <ul>          <li><a href="#tabs-1">Descrizioni</a></li>          <li><a href="#tabs-2">Classificazione</a></li>          <li><a href="#tabs-3">Varianti</a></li>          <li><a href="#tabs-5">Opzioni</a></li>          <li><a href="#tabs-4">Altri dati</a></li>          <li><a href="#tabs-6">Ordini</a></li>          <li><a href="#tabs-7">Allegati</a></li>          <li><a href="#tabs-8">Immagini</a></li>          <li><a href="#tabs-9">Dati MEPA</a></li>        </ul>        <div id="tabs-1" class="tab-panel">			<label>ID articolo: <%=idpro%></label><br />          <%if oper<>"new" then%>          <label style="width:100%; padding-bottom:5px;"> Articolo inserito il <%=rs("data")%>, ultima modifica il <%=rs("datamod")%></label><br />          <label style="width:100%; padding-bottom:5px;"> Articolo presente in <%=n_ordini%> ordini, <%=n_preventivi%> preventivi, <%=n_ordini_fornitore%> ordini fornitore</label>          <br/>		  <%if n_carrelli>0 then%>		  <label style="width:100%; padding-bottom:5px; color:red;"> Articolo presente in <%=n_carrelli%> carrelli con aggiunta più recente il <%=lastvisit%>, <b>salvando le modifiche verrà  eliminato dai carrelli degli utenti</b></label>          <br/>		  <%end if%>          <%end if%>          <%if oper="edit" then	val=rs("codice")	maxlength= rs("codice").DefinedSizeelseif oper="new" then	maxlength= rs("codice").DefinedSizeelse	val=request.form("codice")end if%>          <label>Codice</Label>          <input name="codice" id="codice" type="text" value="<%=val%>" maxlength="<%=maxlength%>" class="richiesto" title="Inserisci il codice dell'articolo, campo alfanumerico, campo obbligatorio, massimo <%=maxlength%> caratteri" >          <br/>		  <div id="subtabs">		  <%if edit_lang_en then%>		  <ul>			<li><a href="#subtabs-1"><img src="images/it.png"/></a></li>			<li><a href="#subtabs-2"><img src="images/en.png"/></a></li>		  </ul>		  <%end if%>		  <div id="subtabs-1">          <%if oper="edit" then	val=rs("articolo")	maxlength= rs("articolo").DefinedSizeelseif oper="new" then	maxlength= rs("articolo").DefinedSizeelse	val=request.form("articolo")end if%>          <label>Descrizione breve</label>          <input name="articolo" type="text"  value="<%=val%>" maxlength="<%=maxlength%>"  class="richiesto" title="Inserisci la descrizione breve dell'articolo, campo alfanumerico, campo obbligatorio, massimo <%=maxlength%> caratteri" >          <br/>                    <%if oper="edit" then      	val=rs("descrizione")      else      	val=request.form("descrizione")      end if      %>		<label>Descrizione estesa</label>		<br/>		<textarea name="descrizione" class="mceEditor" id="descrizione" style="width:100%; height:500px;"><%=val%></textarea>				</div>		<%if edit_lang_en then%>		<div id="subtabs-2">		<%			if oper="edit" then				val=rs("articolo_en")				maxlength= rs("articolo").DefinedSize			else				val=request.form("articolo_en")			end if			%>          <label>Descrizione breve</label>          <input name="articolo_en" type="text" value="<%=val%>" maxlength="<%=maxlength%>"  <%if view="view" then response.write " disabled"%>  title="Inserisci la descrizione breve dell'articolo, campo alfanumerico max 100 caratteri">          <br/>             <%if oper="edit" then      	val=rs("descrizione_en")      else      	val=request.form("descrizione_en")      end if      %>          <label>Descrizione estesa</label>          <br/>          <textarea name="descrizione_en" class="mceEditor"  style="width:100%; height:500px;"><%=val%></textarea>		  </div>          <%end if %>                              		</div>		<label>Descrizione per listino</label>		<br/>		<%if oper="edit" then			val=rs("descrizione_listino")		else			val=request.form("descrizione_listino")		end if		%>		<textarea name="descrizione_listino" class="" id="descrizione_listino" style="width:100%;"><%=val%></textarea>		<br><button id="striphtmldescrizione_listino">Copia da descrizione senza HTML</button>		  		  <br>		 Parole supplementari utili per la ricerca interna al sito, separare con spazio<br>          <%		if oper="edit" then			val=rs("parole_ricerca")					else			val=request.form("parole_ricerca")		end if		%>          <textarea name="parole_ricerca" cols="50" rows="3" <%if view="view" then response.write " disabled"%>="<%if view="view" then response.write " disabled"%>" style="width:95%;"><%=val%></textarea>    <br>               Descrizione per motore di ricerca, solo testo, no HTML, ottimale 150-160 caratteri<br>          <%if oper="edit" then      	val=rs("MetaDescription")else      	val=request.form("MetaDescription")end if%>          <textarea name="MetaDescription" id="MetaDescription" cols="50" rows="5" style="width:95%;"><%=val%></textarea><br>          <span id="MetaDescriptioncnt"></span>      <br><button id="striphtml">Copia da descrizione senza HTML</button> <script type="text/javascript">  $(document).ready(function () {	  $("#striphtml").click(function(e){		  e.preventDefault();		  $("#MetaDescription").val(RemoveHTML($("#descrizione").val()));		  $("#MetaDescription").val($("#MetaDescription").val().replace(/(\r\n|\n|\r)/gm,", ").replace(/\s+/g, " ").replace(/^\s+|\s+$/g, ""));		  $('#MetaDescription').keyup();		  	  });	  	  $("#striphtmldescrizione_listino").click(function(e){		  e.preventDefault();		  $("#descrizione_listino").val(RemoveHTML($("#descrizione").val()));		  $("#descrizione_listino").val($("#descrizione_listino").val().replace(/(\r\n|\n|\r)/gm,", ").replace(/\s+/g, " ").replace(/^\s+|\s+$/g, ""));		  $('#descrizione_listino').keyup();		  	  });		  // avvio il controllo all'evento keyup$('#MetaDescription').keyup(function() {  // definisco il limite massimo di caratteri  var limite_max = 160;  var limite_min = 150;  var text;  var quanti = $(this).val().length;  // mostro il conteggio in real-time  //$('#MetaDescriptioncnt').html(quanti + ' di ' + limite_min+" - "+ limite_max + ' caratteri consigliati');  text=quanti + ' di ' + limite_min+" - "+ limite_max + ' caratteri consigliati';  // quando raggiungo il limite  if(quanti > limite_max) {    // mostro un avviso    //$('MetaDescriptioncnt').html($('#MetaDescriptioncnt').html()+'<strong>La descrizione è troppo lunga!</strong>');    text+=' <strong>La descrizione è troppo lunga!</strong> Verrà troncata a 200 caratteri';  }  if(quanti < limite_min) {    // mostro un avviso    //$('MetaDescriptioncnt').html($('#MetaDescriptioncnt').html()+'<strong>La descrizione è troppo corta!</strong>');    text+=' <strong>La descrizione è troppo corta!</strong>';  }  $('#MetaDescriptioncnt').html(text);    });$('#MetaDescription').keypress(function(e){   if (e.keyCode == 13) return false   })	  function RemoveHTML (html)		{		   var tmp = document.createElement("DIV");		   tmp.innerHTML = html;			var tmpstr=tmp.textContent||tmp.innerText;		   return tmpstr;		}  });         </script>        </div>		        <div id="tabs-2" class="tab-panel">          <label>settori merceologici</label>          Il primo settore è quello predefinito, puoi riordinare i settori spostandoli con il mouse			<input type='hidden' name='settori' id='settori' style="width:500px;" value=" "/> <script type="text/javascript">  <%if oper="edit" then	Dim Js	Set Js = jsArray()	if rs("idcat")<>"" then		''Settore predefinito		set rsm=conn.execute("select settori.* from settori where idsettore="&rs("idcat"))		if not rsm.eof then 			Set Js(Null) = jsObject()			js(null)("id")=rsm("idsettore")			Js(null)("text")=gerarchia_settori_bkw(rsm("idsettore"),"")		end if		set rsm=nothing			set rsm=conn.execute("select settori_prodotti.IDpro, settori.idsettore, settori.Nome_Settore FROM settori INNER JOIN settori_prodotti ON settori.idsettore = settori_prodotti.IDsettore where idpro="&idpro&" and settori_prodotti.IDsettore<>"&rs("idcat"))		do while not rsm.eof			Set Js(Null) = jsObject()			js(null)("id")=rsm("idsettore")			Js(null)("text")=gerarchia_settori_bkw(rsm("idsettore"),"")			rsm.movenext		loop		set rsm=nothing	end if		%>  var vara = <%js.Flush%>;	<%else%>  var vara = '';<%set js=nothingend if%>  $(document).ready(function () {  	$('#settori').select2({  		tags: true,  		multiple: true,  		placeholder: 'Seleziona i settori articolo',  		minimumInputLength: 0,  		allowClear: true,  		initSelection : function (element, callback) {	        callback(vara);	    },  		ajax: {  			quietMillis: 150,  			url: "ajax_function.asp?select2=settori",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  		  	});  	$("#settori").select2("container").find("ul.select2-choices").sortable({	    containment: 'parent',	    start: function() { $("#settori").select2("onSortStart"); },	    update: function() { $("#settori").select2("onSortEnd"); }	});  	$("#settori").select2("data",vara);  });</script>          <br />                                       <label>Gruppo articoli correlati</label>Il primo gruppo è quello predefinito, puoi riordinare i gruppi spostandoli con il mouse			<input type='hidden' name='id_pro_consigliati' id='id_pro_consigliati' style="width:500px;" value=" "/> <script type="text/javascript"><%if oper="edit" then	Dim Js11	Set Js11 = jsArray()				''gruppo predefinito	if not isnull(rs("id_pro_consigliati")) and rs("id_pro_consigliati")>0 then		set rsm=conn.execute("select articoli_consigliati.id_pro_consigliati, articoli_consigliati.nome_ragruppamento from articoli_consigliati where id_pro_consigliati="&rs("id_pro_consigliati"))		if not rsm.eof then 			Set Js11(Null) = jsObject()			js11(null)("id")=rsm("id_pro_consigliati")			Js11(null)("text")=rsm("nome_ragruppamento")		end if	end if	sql="select articoli_consigliati.id_pro_consigliati, articoli_consigliati.nome_ragruppamento, prodotti_consigliati.idpro FROM articoli_consigliati INNER JOIN prodotti_consigliati ON articoli_consigliati.id_pro_consigliati = prodotti_consigliati.idconsigliato where idpro="&idpro	if not isnull(rs("id_pro_consigliati")) then		sql=sql& " and id_pro_consigliati<>"&rs("id_pro_consigliati")	end if		set rsm=conn.execute(sql)	do while not rsm.eof		Set Js11(Null) = jsObject()		js11(null)("id")=rsm("id_pro_consigliati")		Js11(null)("text")=rsm("nome_ragruppamento")		rsm.movenext	loop	rsm.close		%>  var varconsigliati = <%js11.Flush%>;	<%else %>  var varconsigliati = '';<%set js11=nothingend if%>  $(document).ready(function () {  	$('#id_pro_consigliati').select2({  		tags: true,  		multiple: true,  		placeholder: 'Seleziona i gruppi',  		minimumInputLength: 0,  		allowClear: true,  		initSelection : function (element, callback) {	        callback(varconsigliati);	    },  		ajax: {  			quietMillis: 150,  			url: "ajax_function.asp?select2=consigliati",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  		  	});  	$("#id_pro_consigliati").select2("container").find("ul.select2-choices").sortable({	    containment: 'parent',	    start: function() { $("#id_pro_consigliati").select2("onSortStart"); },	    update: function() { $("#id_pro_consigliati").select2("onSortEnd"); }	});  	$("#id_pro_consigliati").select2("data",varconsigliati);  });</script>                                                                                                                                                                <br />          <label>Tags</label>			<input type='hidden' name='ttags' id='ttags' style="width:500px;" value=" "/> <script type="text/javascript"><%if oper="edit" then	Dim Js1	Set Js1 = jsArray()			set rsm=conn.execute("select prodotti_tags.IDpro, tags.idtag, tags.Nometag FROM tags INNER JOIN prodotti_tags ON tags.idtag = prodotti_tags.IDtag where idpro="&idpro)	do while not rsm.eof		Set Js1(Null) = jsObject()		js1(null)("id")=rsm("idtag")		Js1(null)("text")=rsm("nometag")		rsm.movenext	loop	rsm.close		%>  var vartags = <%js1.Flush%>;	<%else%>  var vartags = '';<%set js1=nothingend if%>  $(document).ready(function () {  	$('#ttags').select2({  		tags: true,  		multiple: true,  		placeholder: 'Seleziona i tag',  		minimumInputLength: 0,  		allowClear: true,  		initSelection : function (element, callback) {	        callback(vartags);	    },  		ajax: {  			quietMillis: 150,  			url: "ajax_function.asp?select2=tags",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  		  	});  	$("#ttags").select2("data",vartags);  });</script><br>                              <label>Marca modello</label>			<input type='hidden' name='modello' id='modello' style="width:500px;" value=" "/> <script type="text/javascript">  <%if oper="edit" then	Dim Js2	Set Js2 = jsArray()	set rsm=conn.execute("select prodotti_marca_modello.IDpro, prodotti_marca_modello.idmodello, marca_modello.Nome,marca_modello.Nomeconmarca FROM marca_modello INNER JOIN prodotti_marca_modello ON marca_modello.id = prodotti_marca_modello.IDmodello where idpro="&idpro&" ")	do while not rsm.eof		Set Js2(Null) = jsObject()		js2(null)("id")=rsm("idmodello")		Js2(null)("text")=rsm("nomeconmarca")		rsm.movenext	loop	rsm.close	%>  var varmodelli = <%js2.Flush%>;	<%else%>  var varmodelli = '';<%	set js2=nothingend if%>  $(document).ready(function () {  	$('#modello').select2({  		tags: true,  		multiple: true,  		placeholder: 'Seleziona i modelli compatibili',  		minimumInputLength: 0,  		allowClear: true,  		initSelection : function (element, callback) {	        callback(varmodelli);	    },  		ajax: {  			quietMillis: 150,  			url: "ajax_function.asp?select2=modelli",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  		  	});  	$("#modello").select2("data",varmodelli);  });</script>          <label>Categorie MEPA</label>			<input type='hidden' name='mepa_categorie' id='mepa_categorie' style="width:500px;" value=" "/> <script type="text/javascript">  <%if oper="edit" then	Dim Js3	Set Js3 = jsArray()	set rsm=conn.execute("select prodotti_mepa_campi.IDpro, prodotti_mepa_campi.idcategoria, mepa_categorie.descrizione FROM mepa_categorie INNER JOIN prodotti_mepa_campi ON mepa_categorie.id = prodotti_mepa_campi.idcategoria where idpro="&idpro&" ")	do while not rsm.eof		Set Js3(Null) = jsObject()		js3(null)("id")=rsm("idcategoria")		Js3(null)("text")=rsm("descrizione")		rsm.movenext	loop	rsm.close	%>  var varmepacampi = <%js3.Flush%>;