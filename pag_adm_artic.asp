ampi.eof			        	if elenco_mepa_campi<>"" then elenco_mepa_campi=elenco_mepa_campi&","			        	elenco_mepa_campi=elenco_mepa_campi&rs_campi("id")			        	richiesto=rs_campi("obbligatorio")			        	if richiesto="S" then			        		richiesto="richiesto"			        	else				        	richiesto=""				        end if						valori_default=rs_campi("valori_default")			        				        	%>			        	<label><%=rs_campi("label")%></label>						<%if valori_default="" or isnull(valori_default) then %>												<input type="text" name="mepa_campo_<%= rs_campi("id")%>" class="<%=richiesto%>" value="<%=JSON(""&rs_campi("id"))%>">						<%else						arr_option=split(valori_default,"||")												%>						<select name="mepa_campo_<%= rs_campi("id")%>">							<% for n=0 to ubound(arr_option) %>							<option value="<%=arr_option(n)%>" <% if JSON(""&rs_campi("id"))=arr_option(n) then response.write " selected" %>><%=arr_option(n)%></option>							<%next %>						</select>												<%end if %>												<br>			        				        	<%			        		rs_campi.MoveNext			        	Loop		        		        		        		        %>		        		            				<input type="hidden" name="elenco_mepa_campi_<%=rs_mepa_categorie("idcategoria")%>" value="<%=elenco_mepa_campi%>" >		        <%			        rs_mepa_categorie.MoveNext		        loop		        		        %>        </div><!-- #tabs-9 -->                              </div>    </form>	<!--JQUERY INIZIO--><script src="jquery/ui/i18n/jquery.ui.datepicker-it.min.js"></script><script type="text/javascript" src="Jquery/js/jquery.validate.min.js"></script><script type="text/javascript" src="Jquery/js/jquery.validate.min_it.js"></script><script>	$(function() {	var variante_aggiungi_riga;	$("#load_vara").click(function(e){		variante_aggiungi_riga="a";		var dialog=$("#dialog").dialog();		dialog.html("Attendi...");				$.ajax({			url     : "pag_adm_dialog_varianti.asp",			type    : "post",			cache	: false,			//dataType: 'json',			//data	: dati,			success: function(data){				dialog.html(data);				dialog.dialog({					autoOpen: true,					modal: true,					resizable: false,					width: 600,					height: "auto",					title: "Seleziona varianti"				}); 			}			,error: function(xhr, textStatus, error){				toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};				toastr.error('Errore nel caricamento della pagina');				var txt="";				txt+="Errore in "+location.href+"<br>";				txt+="<br>querystring: ?"+querystring[1];				txt+="<br>"+xhr.statusText;				txt+="<br>"+xhr.responseText;				txt+="<br>textStatus:"+textStatus;				txt+="<br>error:"+error;								$.ajax({					url     : "searcher.asp",					type    : "post",					data	: "txt_errore="+encodeURIComponent(txt)				});								}		});						});					$('#prezzo').keyup(function() {		var prezzo=parseFloat($(this).val().replace(',','.'));		var iva=$("#iva").val();		if (prezzo==0){			var prezzo_con_iva="";		}				if (prezzo>0){			var prezzo_con_iva="Prezzo con iva: "+prezzo*(1+iva/100).toFixed(2);		}		if (prezzo==-1){			prezzo_con_iva="Telefonare";		}					 $("#prezzo_con_iva").text(prezzo_con_iva);	});			$( "#prodata" ).datepicker($.datepicker.regional['it']);	$( "#novdata" ).datepicker($.datepicker.regional['it']);	$( "#data_agg_costo" ).datepicker($.datepicker.regional['it']);	$( "input" ).tooltip();	$( ".tooltip" ).tooltip();	$( "select" ).tooltip();	$( "#tabs" ).tabs();	<%if edit_lang_en then%>	$( "#subtabs" ).tabs();	<%end if%>	$( "#tabs" ).show();	$( "#tabs" ).focus();	$(".ui-tabs-anchor").click(function(e){				$( ".ui-tooltip " ).hide();						});	jQuery.validator.addMethod("nomevar1", function(value, element){	    if (/^[0-9]{9}[vVxX]$/.test(value)) {	        return false;  // FAIL validation when REGEX matches	    } else {	        return true;   // PASS validation otherwise	    };	}, "wrong nic number"); 			$('#form1').validate({       ignore: "",       ignoreTitle: true,             rules: {						codice:{				required:true,minlength:3,				remote:{	                url: "ajax_function.asp?oper=codiceunico&idpro=<%=idpro%>", //make sure to return true or false with a 200 status code	                type: "post",	                dataType: 'json',	                cache:false,	                	                dataFilter: function(data) {				        var json = JSON.parse(data);				        if(json.isError == "true") {				            return "\"" + decodeURIComponent(encodeURIComponent(json.errorMessage)) + "\"";				        } else {				            return true;				        }								    },	                	                error:function(xhr, textStatus, error,data){								  txt="Errore in validazione aggiunta/modifica articolo";								  txt+="<br>xhr.statusText:"+xhr.statusText;								  txt+="<br>xhr.responseText:"+xhr.responseText;								  txt+="<br>textStatus:"+textStatus;								  txt+="<br>error:"+error;								  txt+="<br>data:"+data;								  								  								  								    $.ajax({									cache: false,									url     : "searcher.asp",									type    : "post",									data	: "txt_errore="+encodeURIComponent(txt)																		});									return true;							}	            }	        },											articolo: {required: true,minlength: 3}		}  ,            messages: {		codice: {			remote:	'Questo codice è già in uso.'		}},	          invalidHandler: function(e, validator){           if(validator.errorList.length){           			//console.log($(validator.errorList[0].element).closest(".tab-panel").attr('id'));				var tabConErrore=$(validator.errorList[0].element).closest(".tab-panel").attr('id');tabConErrore=tabConErrore.substring(5);				console.log(tabConErrore);						$( "#tabs" ).tabs( "option", "active", tabConErrore-1);		}		        }   });   $("#duplica").click(	function(e){		window.location.href = "pag_adm_art_op.asp?cosa=dup&id=<%=idpro%>";		return false;	});	$("#copiacla").click(	function(e){		window.location.href = "pag_adm_art_op.asp?cosa=copiacla&idpro=<%=idpro%>";		return false;	});$("#elimina").click(	function(e){		window.location.href = "pag_adm_art_op.asp?cosa=eli&id=<%=idpro%>";		return false;	});	$("#annulla").click(	function(e){		window.location.href = "<%=questofile%>";		return false;	});});function enableSaveBtn(t_this){	return true;}function aggiungi_righe_varianti(id,elenco){		console.log("Aggiungi varianti id:"+id);	console.log(elenco);	var arrayelenco = elenco.split("|");	var arrayLength = arrayelenco.length;			var new_id=1;						for (var i = 0; i < arrayLength; i++) {			new_id++;			console.log("aggiungo "+arrayelenco[i]);			$( "#tabvara" ).append(nuova_riga(new_id,arrayelenco[i]));			    //Do something	}		}function nuova_riga(id,valore)	{		return '<tr id="nuova_riga_'+id+'" style="border-bottom:1px solid;"><td><input type="text" name="codicevara_new_'+id+'" value="" style="width:100px;" ></td><td ><input type="hidden" name="varianti_a_new"  value="'+id+'"><input type="text"  class="n_riga" id="variantea_new_'+id+'" name="variantea_new_'+id+'"  value="'+valore+'"  style="width:200px;"></td><td style="border-bottom:1px solid;"><input type="text" name="prezzo_ve_new_'+id+'"  value="" style="width:100px;<%=bgcolor_ve%>" <%=disabled_ve%>></td><td style="border-bottom:1px solid;"><%if ha_il_permesso("A3") then %> <input type="text" name="prezzo_ac_new_'+id+'"  value="" style="width:100px;<%=bgcolor_ac%>" <%=disabled_ac%> ><%end if %></td><td align="center" style="border-bottom:1px solid;"> <input type="checkbox" name="eliminanew_'+id+'" value="" ></td><td></td></tr>';	}</script>    <%end if%>    <!-- Box CORPO FINE-->   </div>  <div id="footer"></div>  <%	  	call connclose()  	  %><!--#include virtual="/pag_adm_footer_inc.asp" --></div><script type="text/javascript" src="Jquery/js/select2.js"></script> <%if oper<>"view" then%><script>		$(function() {		$(".select2").select2();		});	</script><%end if%></body></html><%end iffunction pulisci_stringa(testo)	pulisci_stringa=trim(replace(testo,chr(9),""))end functionsub differenze_uno()	'memorizzo situazione iniziale	n=rs.fields.count-1	Set Flds = rs.Fields	dim nome_campo(50)	dim valore_campo(50)	'memorizzo i nomi dei campi e i valori attuali	for i=0 to n		nome_campo(i)=RS.Fields(i).Name		valore_campo(i)=rs(i)	nextend subsub differenze_due()	'modifico	'...	'verifico dopo rs.update	for i=0 to n		if valore_campo(i)<>rs(i) then			stringa=stringa&"modificato campo "&nome_campo(i)&"<br>"		end if	next	session("aggiornamento_articolo")=stringaend subsub aggiusta_magazzino()	Set rs_mag = Server.CreateObject("ADODB.Recordset")	Set rs_var_a = Server.CreateObject("ADODB.Recordset")	Set rs_var_b = Server.CreateObject("ADODB.Recordset")	aggiunto=0	variante_a=false	variante_b=false	rs_var_a.Open "select * from varianti_a where idpro=" & idpro, conn, 1, 3	if not rs_var_a.eof then		variante_a=true		conn.execute "delete from magazzino where idpro="&idpro&" and idvara=0"	end if	rs_var_a.Close	set rs_var_a=Nothing	rs_var_b.Open "select SQL_CALC_FOUND_ROWS * from varianti_b where idpro=" & idpro, conn, 1, 3	lngTotalRecords=clng(conn.Execute("Select Found_Rows();")(0).Value)	if not rs_var_b.eof then		variante_b=true		conn.execute "delete from magazzino where idpro="&idpro&" and idvarb=0"	end if	sql="select prodotti.IDpro, IF(IsNull(idvara),0,idvara) AS ID_vara, IF(IsNull(idvarb),0,idvarb) AS ID_varb FROM (prodotti LEFT JOIN varianti_a ON prodotti.IDpro = varianti_a.idpro) LEFT JOIN varianti_b ON prodotti.IDpro = varianti_b.idpro where prodotti.idpro="&id		set prodotti_varianti=conn.execute (sql)	do while not prodotti_varianti.EOF	'ciclo sulle varianti		set rs_magazzino=conn.execute ("select magazzino.IDmag, magazzino.idpro, magazzino.idvara, magazzino.idvarb FROM magazzino WHERE (((magazzino.idpro)="&prodotti_varianti("idpro")&") AND ((magazzino.idvara)="&prodotti_varianti("ID_vara")&") AND ((magazzino.idvarb)="&prodotti_varianti("ID_varb")&"));")		if rs_magazzino.eof then			'creo voce magazzino			sql="INSERT INTO magazzino (idpro,idvara,idvarb,quantita_magazzino) VALUES ("&prodotti_varianti("idpro")&","&prodotti_varianti("ID_vara")&","&prodotti_varianti("ID_varb")&",0);"			conn.execute (sql)			modifiche_rs=modifiche_rs&vbcrlf& "Nuova voce magazzzino per idvara:"&prodotti_varianti("ID_vara")&" idvarb:"&prodotti_varianti("ID_varb")		end if			prodotti_varianti.MoveNext	loop	set prodotti_varianti=Nothing			n_colonne=lngTotalRecords	rs_var_b.Close	set rs_var_b=Nothing	conn.execute "DELETE magazzino FROM magazzino LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara WHERE (((varianti_a.IDvara) Is Null) AND ((magazzino.idvara)>0) and magazzino.idpro="&idpro&");",num	if num>0 then modifiche_rs=modifiche_rs&vbcrlf& "Eliminato "&num&" voci magazzino per variante A inesistente" 	conn.execute "DELETE magazzino FROM magazzino LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb WHERE (((varianti_b.IDvarb) Is Null) AND ((magazzino.idvarb)>0) and magazzino.idpro="&idpro&");",num	if num>0 then modifiche_rs=modifiche_rs&vbcrlf& "Eliminato "&num&" voci magazzino per variante B inesistente"end subfunction tipo_taglia_misura(stato)	if not isnumeric(stato) then		tipo_taglia_misura=stato	else		select case stato		case -1		tipo_taglia_misura=19		case 0		tipo_taglia_misura="Nessuna"		case 1		tipo_taglia_misura="Giacca"		case 2		tipo_taglia_misura="Pantaloni"		case 3		tipo_taglia_misura="Camicia"		case 4		tipo_taglia_misura="Scarpa"		case 5		tipo_taglia_misura="Berretto"		case 6		tipo_taglia_misura="Guanto"		case 7		tipo_taglia_misura="Maglieria"		case 8		tipo_taglia_misura="Giacca Tecnica"		case 9		tipo_taglia_misura="Pantalone Tecnico"		case 10		tipo_taglia_misura="Arma"		case 11		tipo_taglia_misura="Gonna"		case 12		tipo_taglia_misura="Cappotto"		case 13		tipo_taglia_misura="Cintura"		case 14		tipo_taglia_misura="Grado"		case 15		tipo_taglia_misura="Cinturone"		case 16		tipo_taglia_misura="Matricola"		case 17		tipo_taglia_misura="Bandiere"		case 18		tipo_taglia_misura="Collant"		case 19		tipo_taglia_misura="Polo / T-schirt"								end select	end ifend functionfunction aggiorna_misure_articolo_in_ordini(idpro)	aggiorna_misure_articolo_in_ordini=""    dim rs_misure_in_ordini    sql="select  ordini_dett_spettanze.id,ordini_dett_spettanze.iddip, ordini_dett.iddett, ordini_dett.articolo_ordine, ordini.nord, ordini.idord, prodotti.tipo_taglia from ((ordini_dett_spettanze inner join ordini_dett on ordini_dett_spettanze.iddett = ordini_dett.iddett) inner join ordini on ordini_dett.idord = ordini.idord) inner join prodotti on ordini_dett.idpro = prodotti.idpro where ordini.stato<=3 and ordini_dett.idpro="&idpro    set rs_misure_in_ordini=conn.execute (sql)    do while not rs_misure_in_ordini.EOF    	if clng(rs_misure_in_ordini("iddip"))>0 then	    	conn.execute ("update ordini_dett_spettanze set taglia_misura='"&replace(recupera_taglia(rs_misure_in_ordini("tipo_taglia"),rs_misure_in_ordini("iddip")),"'","''") &"' where id="&rs_misure_in_ordini("id"))			aggiorna_misure_articolo_in_ordini=aggiorna_misure_articolo_in_ordini&"<br>Aggiornata misura in [ordine="&rs_misure_in_ordini("idord")&"]"&rs_misure_in_ordini("nord")&"[/ordine] riga: "&rs_misure_in_ordini("iddett")&"  ordini_dett_spettanze.id="&rs_misure_in_ordini("id")		end if	    rs_misure_in_ordini.MoveNext    loopend function%>