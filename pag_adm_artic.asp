" <%if cercain="nota_breve" then response.write selected%>>Con nota breve</option>                            <option value="recenti_add" <%if cercain="recenti_add" then response.write selected%>>Aggiunti di recente</option>              <option value="recenti_edit" <%if cercain="recenti_edit" then response.write selected%>>Modificati di recente</option>              <option value="noidfor" <%if cercain="noidfor" then response.write selected%>>Senza fornitore</option>              <option value="nopreac" <%if cercain="nopreac" then response.write selected%>>Senza prezzo acquisto</option>              <option value="modprezzo" <%if cercain="modprezzo" then response.write selected%>>Prezzo modificato</option>              <%if mod_dip then %>              <option value="notipotaglia" <%if cercain="notipotaglia" then response.write selected%>>Senza tipo taglia misura</option>              <%end if %>			  </select>			  <input type="button" id="filtri" value="+filtri" style="FONT: 12px;"><input type="button" id="esporta" value="Esporta Excel" style="FONT: 12px;">		   <span style="float:right;">			<%if ha_il_permesso("A1") then %>            <input type="button"  value="Nuovo" style="FONT: 12px;" onclick="window.location.href='<%=questofile%>?oper=new&idcat=<%=idcat%>'">			<%end if %>            </span>          </form><script type="text/javascript" src="Jquery/js/select2.js"></script> <script>$(function() {	$(".select2").select2({width: "element"});	$(".bigdrop .select2-results").css("max-height","600px");	$("#esporta").click(function(){		location.href="pag_adm_excel_articoli.asp?"+$( "#form1" ).serialize();	});});</script>                    </td>	<%if filtro then			display=""		else			display="display: none;"	  end if	  	  %>      </tr>  	  <tr style="border-bottom:1px solid; <%=display%>" id="tr_filtri">  	  	<td colspan="3"><form name="form12" id="form2" method="post"  action="<%=Request.ServerVariables("Script_Name")%>" >	  	  