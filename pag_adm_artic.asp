n() {		var pieno = true;		$(".n_rigb").each(function () {			if ($(this).val() == "") {				pieno = false;			}		});		if (pieno)		{			new_id++;			$( "#tabvarb" ).append(nuova_rigb(new_id,""));		}	aggiungi_rigb();	});}aggiungi_rigb();function nuova_rigb(id,valore)	{		return '<tr style="border-bottom:1px solid;"><td ><input type="hidden" name="varianti_b_new"  value="'+id+'"><input type="text"  class="n_rigb" id="varianteb_new_'+id+'" name="varianteb_new_'+id+'"  value=""  style="width:300px;"></td><td align="center" style="border-bottom:1px solid;"> <input type="checkbox" name="eliminanew_'+id+'" value="" ></td></tr>';	}		});</script> <b>Attenzione: l'eliminazione di una variante A o variante B causerà l'eliminazione dei seguenti dati collegati alle varianti: <ul><li>Giacenze di magazzino</li><li>Movimenti di magazzino</li><li>Distinte basi</li></ul> </b>        </div>        <div id="tabs-4" class="tab-panel">          <label>Unit&agrave; di misura</label>          <%if oper="edit" then	val=rs("um")else	val=request.form("um")end if%>          <input type="text" name="um" size="30" value="<%=val%>"  <%if view="view" then response.write " disabled"%> title="Unit&agrave; di misura, campo alfanumerico max 15 caratteri, clicca sui pulsanti a destra per inserire un unit&agrave; di misura" style="width:100px;">          <%if view<>"view" then%>          <%if len(elencoum)>0 then		  um=split(elencoum,VbCrLf)			   	for i=0 to ubound(um)				%>          <input name="" type="button" onClick="addum('<%=um(i)%>')" value="<%=um(i)%>" >          <%				next			else				response.write "<b>Elenco unit&agrave; di misura vuoto!</b>"			end if			  %>          <br />          <%end if%>          <label>Prezzo di vendita iva esclusa</label>          <%		if oper="edit" then			prezzo=cdbl(rs("prezzo"))			val=prezzo			if not isnull(val) then val=FormatNumber(val,2,,,0)		else			val=request.form("prezzo")		end if			if prezzo_in_varianti=true 