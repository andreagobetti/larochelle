>1 then	'if PaginazioneString<>"" then 	'	PaginazioneString="&"&PaginazioneString	'end if	response.write "<tr><td colspan="""&colspan&""" align=""center"" style=""border-top: 1px solid black;"">"	response.write "<table border=""0"" cellpadding=""0"" cellspacing=""0"" class=""testotabella""><tr align=""center"">"	response.write "<td width=""50"">"	If iPageCurrent <> 1 Then		response.write "<a class=""paging"" href="""&questofile&"?page=1"&PaginazioneString&"""><img src=""images/frecciaSXf.gif"" border=""0"" alt=""Prima pagina""></a>"	end if	response.write "</td><td width=""50"">"	If iPageCurrent <> 1 Then		response.write "<a class=""paging"" href="""&questofile&"?page="& iPageCurrent - 1 &PaginazioneString&"""><img src=""images/frecciaSX.gif"" border=""0"" alt=""Pagina precedente""></a>"	end if	response.write "</td><td>"	if iPageCount > 1 then		response.write "Pagina "& iPageCurrent &" di "& iPageCount	end if	response.write "</td><td width=""50"">"	If iPageCurrent < iPageCount Then		response.write "<a class=""paging"" href="""&questofile&"?page="& iPageCurrent + 1 &PaginazioneString&"""><img src=""images/frecciadX.gif"" border=""0"" alt=""Pagina successiva""></a>"	end if	response.write "</td><td width=""50"">"	If iPageCurrent < iPageCount Then		response.write "<a class=""paging"" href="""&questofile&"?page="& iPageCount &PaginazioneString&"""><img src=""images/frecciadXf.gif"" border=""0"" alt=""Ultima pagina""></a>"	End If	response.write "</td></tr></table></td></tr>"	end ifend sub	sub paginazione_close()	set objPagingRS=nothingend sub%>