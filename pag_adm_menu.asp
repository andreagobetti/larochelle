<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()if request.querystring("ordina")<>"" then	array_=Request.QueryString	'add2log array_,1	array_=replace(array_,"null","0")	'add2log "inizio ordina categoria",1	'response.write array_	array_=split(array_,"&")	For i = LBound(array_)+1 TO UBound(array_)		idmen=mid(array_(i),4,instr(array_(i),"]")-4)		idpadre=mid(array_(i),instr(array_(i),"=")+1,len(array_(i)))		'add2log "idpadre"&idpadre&"idmen"&idmen&"ordine"&i,2			   sql_update = "UPDATE menu SET idpadre = " & idpadre &",ordine="&i& " WHERE idmen = " & idmen	   'Response.Write(sql_update&"<br>")	   'execute this bitch	   'add2log "sql_update: "&sql_update,1	   conn.Execute sql_update	   'add2log "aggiornato idmen"&idmen,1	   'below used for debugging - comment out	   	'Response.Write(sql_update&"<br>")	Next	response.write i &" voci menu aggiornate"	add2log "Ordine menu aggiornato da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2	application("cache_menu")=""else'------------------------------------oper=request.form("oper")if request.form("elimina")<>"" then		Set rs = Server.CreateObject("ADODB.Recordset")		rs.Open "select * FROM menu WHERE idmen=" & request.form("idmen")  , conn, 3,2		add2log "Eliminata voce menu"&rs("Voce")&" eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",3		rs.delete		rs.close		application("cache_menu")=""		set rs = nothing		call connclose()		response.redirect questofileend ifselect case lcase(request("oper"))	case "","annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case "riordina_az"		call riordina_az(0,0)		oper="view"	case "edit"		oper="edit"		idmen=request("idmen")	case else		oper="view"end selectif oper="add" or oper="update" then	sql="select * from menu"	Set rs = Server.CreateObject("ADODB.Recordset")	if oper="add" then		rs.Open sql, conn, 3, 3		rs.addnew		rs("ordine")=0	else		sql= sql & " where idmen=" & request.form("idmen")		rs.Open sql, conn, 3, 3	end if	if request.form("ordine")<>"" then rs("ordine")= cint(trim(request.form("ordine")))	rs("voce")=firstup(trim(request.form("voce")))	'rs("title")=firstup(trim(request.form("title")))	if edit_lang_en then		rs("voce_en")=firstup(trim(request.form("voce_en")))		'rs("title_en")=firstup(trim(request.form("title_en")))	end if	rs("link")=trim(request.form("link"))	rs("target")=trim(request.form("target"))	idpadre=request.form("idpadre")	rs("idpadre")=idpadre	rs.update	add2log "Modificata voce menu <b>"&rs("Voce")&"</b> eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2	rs.close	set rs = nothing	call riordina_ramo(idpadre)	application("cache_menu")=""	oper="view"end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!-- Stile: <%=Application("skins")%> --><!--#include virtual="/sub_head.asp" --><%if oper="view" then%><script src="Jquery/js/jquery.mjs.nestedSortable.js"></script>	<style type="text/css">		.placeholder {			outline: 1px dashed #4183C4;			/*-webkit-border-radius: 3px;			-moz-border-radius: 3px;			border-radius: 3px;			margin: -1px;*/			width:300px;		}		.mjs-nestedSortable-error {			background: #fbe3e4;			border-color: transparent;		}		ol {			margin: 0;			padding: 0;			padding-left: 30px;		}		ol.sortable, ol.sortable ol {			margin: 0 0 0 75px; /*spostamento*/			padding: 0;			list-style-type: none;		}		ol.sortable {			margin: 1em 0;		}		.sortable li {			margin: 5px 0 0 0;			padding: 0;		}		.sortable li div  {			width:350px;			border: 1px solid #d4d4d4;			-webkit-border-radius: 3px;			-moz-border-radius: 3px;			border-radius: 3px;			border-color: #D4D4D4 #D4D4D4 #BCBCBC;			padding: 6px;			margin: 0;			cursor: move;			background: #f6f6f6;			background: -moz-linear-gradient(top,  #ffffff 0%, #f6f6f6 47%, #ededed 100%);			background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#ffffff), color-stop(47%,#f6f6f6), color-stop(100%,#ededed));			background: -webkit-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: -o-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: -ms-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: linear-gradient(to bottom,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ffffff', endColorstr='#ededed',GradientType=0 );		}		.sortable li.mjs-nestedSortable-branch div {			background: -moz-linear-gradient(top,  #ffffff 0%, #f6f6f6 47%, #f0ece9 100%);			background: -webkit-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#f0ece9 100%);		}		.sortable li.mjs-nestedSortable-leaf div {			background: -moz-linear-gradient(top,  #ffffff 0%, #f6f6f6 47%, #bcccbc 100%);			background: -webkit-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#bcccbc 100%);		}		li.mjs-nestedSortable-collapsed.mjs-nestedSortable-hovering div {			border-color: #999;			background: #fafafa;		}		.disclose {			cursor: pointer;			width: 10px;			display: none;		}		.sortable li.mjs-nestedSortable-collapsed > ol {			display: none;		}		.sortable li.mjs-nestedSortable-branch > div > .disclose {			display: inline-block;		}		.sortable li.mjs-nestedSortable-collapsed > div > .disclose > span:before {			content: '+  ';			font-weight:bold;			font-size:130%;		}		.testo  {			padding-left:5px;		}		.sortable li.mjs-nestedSortable-expanded > div > .disclose > span:before {			content: '-  ';			font-weight:bold;			font-size:150%;		}	</style>	<script>	$(document).ready(function(){		$('ol.sortable').nestedSortable({			forcePlaceholderSize: true,			handle: 'div',			helper:	'clone',			items: 'li',			opacity: .6,			placeholder: 'placeholder',		//	revert: 250,			tabSize: 25,			tolerance: 'pointer',			toleranceElement: '> div',		//	maxLevels: 3,			isTree: true,			expandOnHover: 700,			startCollapsed: true		});		$('.disclose').on('click', function() {			$(this).closest('li').toggleClass('mjs-nestedSortable-collapsed').toggleClass('mjs-nestedSortable-expanded');		})		$("#ordina").click(function() { 			var ordine = $('ol.sortable').nestedSortable('serialize'); 			//alert(ordine);			$("#info").load("<%=questofile%>?ordina=si&"+ordine); 		});		$('#serialize').click(function(){			serialized = $('ol.sortable').nestedSortable('serialize');						$('#serializeOutput').text(serialized+'\n\n');		})		$('#toHierarchy').click(function(e){			hiered = $('ol.sortable').nestedSortable('toHierarchy', {startDepthCount: 0});			hiered = dump(hiered);			(typeof($('#toHierarchyOutput')[0].textContent) != 'undefined') ?			$('#toHierarchyOutput')[0].textContent = hiered : $('#toHierarchyOutput')[0].innerText = hiered;		})		$('#toArray').click(function(e){			arraied = $('ol.sortable').nestedSortable('toArray', {startDepthCount: 0});			arraied = dump(arraied);			(typeof($('#toArrayOutput')[0].textContent) != 'undefined') ?			$('#toArrayOutput')[0].textContent = arraied : $('#toArrayOutput')[0].innerText = arraied;		})	});	function dump(arr,level) {		var dumped_text = "";		if(!level) level = 0;		//The padding given at the beginning of the line.		var level_padding = "";		for(var j=0;j<level+1;j++) level_padding += "    ";		if(typeof(arr) == 'object') { //Array/Hashes/Objects			for(var item in arr) {				var value = arr[item];				if(typeof(value) == 'object') { //If it is an array,					dumped_text += level_padding + "'" + item + "' ...\n";					dumped_text += dump(value,level+1);				} else {					dumped_text += level_padding + "'" + item + "' => \"" + value + "\"\n";				}			}		} else { //Strings/Chars/Numbers etc.			dumped_text = "===>"+arr+"<===("+typeof(arr)+")";		}		return dumped_text;	}</script><%end if%><%if oper<>"view" then%>	<script>	$(function() {		$( "input" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });		$( "select" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });		$( "textarea" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });	});		</script>    	<style>	label {		display: inline-block;		width: 5em;	}	</style>    <script Language="JavaScript"> 	annulla=false;	function Validator(theForm) 	{	if (annulla==true)  { 		return(true);    	  } 		  if (theForm.categoria.value == "")  { 		alert("Specificare una nome per la categoria.");		theForm.categoria.focus();		return (false); 	}		  if (theForm.idpadre.selectedIndex == 0)  { 		alert("Seleziona una posizione per la categoria.");		theForm.idpadre.focus(); 		return (false); 	  }	  	  return (true); 	} </script><%end if%></head><body> <div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa"> <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Gestione menu</a></div></div>        <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         		        <%if oper="view" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>              <td style="border-bottom:1px solid;" ><button id="ordina" >Aggiorna ordine manuale</button><span style="float:right;">                <input type="button"  value="Nuova voce" style="FONT: 12px;" onclick="window.location.href='<%=questofile%>?oper=new'"></span><div id="info"></div></td>            </tr>            <tr>              <td style="border-bottom:1px solid;" >              Ordina e sposta con il mouse		        <ol class="sortable"><%	call mappamenu_sortable(0,0,"","")%></ol>	  			  </td>            </tr>          </table>          <%else	sql="select * from menu where idmen=" & idmen & ";"	if oper="edit" then		set rs=conn.execute(sql)		testo= "Modifica voce menu"		voce=rs("voce")		voce_en=rs("voce_en")		title=rs("title")		title_en=rs("title_en")		link=rs("link")		target=rs("target")		ordine=rs("ordine")		rs.close		set rs = nothing	else		testo= "Nuova voce menu"	end if  	sql=sql & " where idmen =" & idmen	if request.form("modifica")<>"" then		set rs=conn.execute(sql)		voce=rs("voce")		voce_en=rs("voce_en")		title=rs("title")		title_en=rs("title_en")		link=rs("link")		target=rs("target")		ordine=rs("ordine")		idpadre=rs("idpadre")		rs.close		set rs = nothing		testo= "Modifica voce menu"			else		testo= "Nuova voce menu"	end if		  %>		<form name='form1' id="form1" method='post' action="<%=questofile%>" style="margin-top:0px;" >          <input type="hidden" name="idmen" value="<%=idmen%>">          <%if error<>"" then			  		descrizione=request.form("descrizione")			  	elseif oper="new" then			  		descrizione=""				end if%>												          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header"><%response.write testo%></td>            </tr>            <tr>               <td align="right" valign="top">Voce</td>              <td> <input type="text" name="voce" value="<%=voce%>" size="40" class="richiesto">               </td>            </tr>			<%if edit_lang_en then%>            <tr>               <td align="right" valign="top">Voce <img src="images/en.png"/></td>              <td> <input type="text" name="voce_en" value="<%=voce_en%>" size="40">               </td>            </tr>			<%end if%>            <tr>               <td align="right" valign="top">URL</td>              <td> <input type="text" name="link" value="<%=link%>" size="40" id="link" class="richiesto">               </td>            </tr>						 <tr>               <td align="right" valign="top">Posizione</td>              <td>                <%				  where=""				  if oper="edit" then					val=idpadre				else					val=0					idmen=0				end if				%>                            <select name="idpadre" class="richiesto">              <%				response.write "<option value=""0"""				if val=0 then response.Write(" selected")				response.Write ">Root</option>"				call mappamenuselezione(1,0,val,idmen)				%></select>				</td>            </tr>            <tr>              <td align="right" valign="top">Collega a settore</td>              <td>              <%			  			  if instr(link,"[settore=")>0 then				  val=estrainumero(link)				  if val="" then val=0			  else				  val=null			  end if			  %><select name="settore" id="settore" >              <option value="">Nessuno</option><%	              if isnull(val) then val=0				Set rsm=conn.execute("select * from settori where idpadre=0 "&where&" order by nome_settore ;")				response.write "<option value=""0"""				if val=0 then response.Write(" selected")				response.Write ">settore principale</option>"				do while not rsm.eof				response.write "<option value=""" & rsm("idsettore") &""""				if int(val)=int(rsm("idsettore")) then response.write " selected"				response.write ">" & rsm("nome_settore")& "</option>"				call mappacatselezione(1,rsm("idsettore"),val,idsettore)				rsm.movenext				loop				rsm.close				%></select><script>$(function () {    $("#settore").on("change", function (e) {				//e.preventDefault();				var val=$("#settore").val();				$("#link").val("[settore="+val+"]");		});});</script></td>            </tr>            <tr>              <td align="right" valign="top">Collega a pagina</td>              <td>              <%			  			  if instr(link,"[settore=")>0 then				  val=estrainumero(link)			  else				  val=null			  end if			  %><select name="pagina" id="pagina" >              <option value="">Nessuno</option><%				Set rsm=conn.execute("select * from news where tipo='pagina'  order by titolo ;")				do while not rsm.eof				response.write "<option value=""" &"id="& rsm("idnews")&"&chk="&chkDataUser(rsm("data")) &""""				if int(val)=int(rsm("idnews")) then response.write " selected"				response.write ">" & rsm("titolo")& "</option>"				rsm.movenext				loop				rsm.close				set rsm = nothing				%></select>				<script>$(function () {    $("#pagina").on("change", function (e) {				//e.preventDefault();				var val=$("#pagina").val();				$("#link").val("single-page.asp?"+val+"");		});});</script></td>            </tr>            <tr>              <td align="right" valign="top">Collega a pagina predefinita</td>              <td>              <select  id="paginapred" >              <option value="">Nessuno</option>                            <option value="index.asp" <%if link="index.asp" then%>selected<%end if%>>Home</option>              <option value="category.asp" <%if link="category.asp" then%>selected<%end if%>>Catalogo</option>              <option value="cart.asp" <%if link="cart.asp" then%>selected<%end if%>>Carrello</option>              <option value="condizioni.asp" <%if link="condizioni.asp" then%>selected<%end if%>>Condizioni</option>              <option value="contact.asp" <%if link="contact.asp" then%>selected<%end if%>>Contatti</option>              <option value="login.asp" <%if link="login.asp" then%>selected<%end if%>>Login</option>              <option value="manuals.asp" <%if link="manuals.asp" then%>selected<%end if%>>Manuali</option>              <option value="category.asp" <%if link="category.asp" then%>selected<%end if%>>prodotti</option>                            </select><script>$(function () {    $("#paginapred").on("change", function (e) {				//e.preventDefault();				var val=$("#pagina").val();				$("#link").val($(this).val());		});});</script></td>            </tr>            <tr>               <td align="right" valign="top">Target</td>              <td> <select name="target" >                  <option value="" >Finestra corrente</option>                  <option value="_blank" <%if target="_blank" then response.write " selected"%>>Nuova                   finestra</option>                </select> </td>            </tr>            <tr>               <td align="right" valign="top">Ordine</td>              <td> <input type="text" name="ordine" value="<%=ordine%>" size="5">               </td>            </tr>          </table>        <%if oper="view" then	txt=puls_newelseif oper="new" or error<>"" then	txt="Aggiungi"elseif oper="edit" then	txt="Modifica"end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Annulla" onClick="annulla=true;">    <%end if%>    <%if oper="edit" and num=0 and error="" then%>    <input type="submit" name="elimina" value="Elimina">    <%end if	end if	call connclose()	%>                 </form>         <!-- Colonna CORPO FINE-->      </div>        <div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><%if oper="edit" or oper="new" then%>	<script src="jquery/js/jquery.validate.min.js" type="text/javascript"></script>	<script src="jquery/js/jquery.validate.min_it.js" type="text/javascript"></script>	<script>	$("#form1").validate({			ignore: "",			rules: {				voce: {required: true},				link: {required: true}			}		});	</script><%end if%> </body></html><%end ifrsClose%><%sub mappamenu_sortable(layer,id,testo,testo_dopo)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	sql_order="select menu.idmen, menu.Voce, menu.idpadre, Count(menu_1.idmen) AS ConteggioDiidmen, menu.ordine FROM menu AS menu_1 RIGHT JOIN menu ON menu_1.idpadre = menu.idmen GROUP BY menu.idmen, menu.Voce, menu.idpadre, menu.ordine HAVING  (menu.idpadre)= " & id 	'sql_order = "select * FROM menu WHERE idpadre = " & id 	if id=0 then sql_order=sql_order&" or (menu.idpadre) Is Null "	sql_order=sql_order&" order by menu.ordine"		rs_order.open sql_order,conn	nodo=true	testo=testo&testo_dopo	testo_dopo=""	if not 	rs_order.eof then 		if layer>0 then testo=testo& "<ol>"	else		nodo=false	end if	do until rs_order.eof				testo=testo&  "<li id=""id_"&rs_order("idmen")&""""&">"		testo_dopo="<div style="""&classe&"""><span class=""disclose""><span></span></span><span class=""testo"">"&rs_order("voce")&"</span><span style=""float:right; text-align:right;"">"		testo_dopo=testo_dopo&"<button style=""font-size:9px;"" onclick=""window.location.href='"&questofile&"?oper=edit&idmen="&rs_order("idmen")&"'"">Modifica</button>"		testo_dopo=testo_dopo&"</div>"		'calling again to find more childs - if not rs_order=nothing	    call mappamenu_sortable(layer+1,rs_order("idmen"),testo,testo_dopo)	'testo=testo& "</li>"&vbcrlf		rs_order.movenext	loop	if nodo=true and layer>0 then testo=testo& "</ol>"&vbcrlf	'closing object	rs_order.close	set rs_order=nothing	if layer=0 then response.write testoEnd Sub	sub mappamenuselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM menu WHERE idpadre = " & id &" and idmen<>"&escludi&" order by ordine;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("idmen") &""""		if int(val)=int(rs_order("idmen")) then response.write " selected"		response.write ">" &spaceing& rs_order("voce")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappamenuselezione(layer+1,rs_order("idmen"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	sub riordina_az(layer,id)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	sql_order = "select menu.idpadre FROM menu GROUP BY menu.idpadre;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof			sql="select * from menu where idpadre="&rs_order("idpadre")&" order by categoria;"			'response.write sql			rs.open sql, conn,3,3			'response.end			ordine=2			do while not rs.eof			rs("ordine")=ordine			rs.update			ordine=ordine+2			rs.movenext			loop			rs.close		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothing	add2log "menu ordinate per descrizione da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2End Sub	sub riordina_ramo(idpadre)	sql="select * from menu where idpadre="&idpadre&" order by ordine;"	'response.write sql	Set rs = Server.CreateObject("ADODB.Recordset")	rs.open sql, conn,3,3	'response.end	ordine=2	do while not rs.eof	rs("ordine")=ordine	rs.update	ordine=ordine+2	rs.movenext	loop	rs.close	set rs = nothingend subsub mappacatselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM settori WHERE idpadre = " & id &" and idsettore<>"&escludi&" order by nome_settore;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("idsettore") &""""		if int(val)=int(rs_order("idsettore")) then response.write " selected"		response.write ">" &spaceing& rs_order("nome_settore")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappacatselezione(layer+1,rs_order("idsettore"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	%>