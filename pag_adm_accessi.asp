<!--#include virtual="/setup.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()if request.QueryString("cancella")<>"" then	conn.execute "delete FROM log_action;"end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body><div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>" class="Amministra_piccolo">Registro accessi</a></div>        <!-- Colonna CORPO INIZIO-->		<%sql="select SQL_CALC_FOUND_ROWS log_action.data, log_action.idloged, log_action.testo, log_action.idpro, prodotti.codice, prodotti.articolo, utenti.Cognome, utenti.Nome, utenti.azienda, settori.Nome_Settore, log_action.ip FROM (prodotti RIGHT JOIN (log_action LEFT JOIN utenti ON log_action.iduse = utenti.iduser) ON prodotti.IDpro = log_action.idpro) LEFT JOIN settori ON log_action.idpro = settori.idsettore ORDER BY log_action.data DESC " if request.querystring("idloged")<>"" then	filtro=true	sql=sql & " where idloged=" & request.querystring("idloged")end ifif request.querystring("iduser")<>"" then				rs.Open "select idloged,nome,cognome,azienda FROM utenti where iduser="& request.querystring("iduser"), conn, 3, 3			lngTotalRecords=clng(conn.Execute("Select Found_Rows();")(0).Value)			idloged=rs("idloged")			nominativo_v=nominativo(rs("nome"),rs("cognome"),rs("azienda"))			rs.close	filtro=true	sql=sql & " where idloged=" & idlogedend if'sql=sql&" order by data desc"iPageSize=200order="idlog="&request.querystring("idlog")'order = ""page = Request.QueryString("page")strSql = sqlNameOfFile = Request.ServerVariables("Script_Name")%>        <!-- INIZIO BLOCCO CENTRALE -->        <table width="100%" border="1" cellpadding="2" cellspacing="0" bordercolor="#CCCCCC" class="tabella1">                  <%if filtro=true then%>          <tr>                       <td colspan="5" class="ui-widget-header">Azioni utente <%=nominativo_v%></td>          </tr>          <%else	          call paginazione_start(strsql,iPageSize,"access")	          %>                    <tr>             <td colspan="4" bgcolor="#E5E5E5" style="border-right: none;">Log accessi: <%=lngTotalRecords%> elementi</td>            <td align="right"  bgcolor="#E5E5E5" style="border-left: none;"><a href="<%=questofile%>?cancella=si">Cancella elenco</a></td>          </tr>            <%end if%>          <tr bgcolor="#E5E5E5">             <td>               <p><b>&nbsp;Data</b></p></td>            <td align="center"><b>&nbsp;Visitatore&nbsp;</b></td>            <td>IP</td>            <td><strong>Azione</strong></td>            <td><b>&nbsp;</b></td>          </tr>          <%Do While iRecordsShown < iPageSize And Not objPagingRS.EOFtesto1=""select case objPagingRS("Testo")case "ric"	testo="Cercato parole:" & idcase "pro"	testo="Visualizzato prodotto:"	testo1= objPagingRS("codice")&" " &objPagingRS("articolo")case "cate"	testo="Selezionato CATEGORIA " 	testo1= objPagingRS("categoria")case "reg"	testo="Registrato l'utente "	testo1="<a href='pag_adm_user.asp?iduser=" & objPagingRS("idpro")&"'>"&objPagingRS("nome")&" "&objPagingRS("cognome")&"</a>"case "log"	testo="Ha effettuato il login"case "flog"	testo="Login automatico"case "new"	testo="Nuovo"case "rit"	testo="Ritornato "case "wap"	testo="Accesso al Wap"case "logwap"	testo="Login Wap al Wap"case "pagl"	testo="Accesso area riservata"case "sett"	testo="Selezionato SETTORE "	testo1= objPagingRS("nome_settore")case else	testo=objPagingRS("Testo")end select%>          <tr>             <td nowrap class=corpobox><%=objPagingRS("data")%></td>            <td class=corpobox>               <%			  nominativo_v=nominativo(objPagingRS("nome"),objPagingRS("cognome"),objPagingRS("azienda"))			  if nominativo_v<>" " then			 	response.Write nominativo_v			 elseif objPagingRS("idloged")=0 then				 			 else				 response.Write objPagingRS("idloged")			end if%></td>            <td class=corpobox>	            <%= objPagingRS("ip")%>	            	            </td>            <td class=corpobox><%=testo%></td>            <td class=corpobox><%=testo1%></td>          </tr>          <% 			iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(5,true)	%>        </table>        <!-- Box CORPO FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%rsClose%>