<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include file="JSON_latest.asp"--><%if session("idadmin") = "" then call login()if request("salva_dati")<>"" then	Set rs = Server.CreateObject("ADODB.Recordset")	if request("dati_vari")="" then		sql="select * from impostazioni order by id"		rs.Open sql, conn, 3, 3		rs.movefirst		'Backup impostazioni		n=rs.fields.count-1		'response.write n&"<br>"		dim campo(100)		for i=0 to n			campo(i)=rs(i)		next					'rs.addnew		'for i=0 to n		'	if campo(i)<>"id" then rs(i)=campo(i)		'next		'rs.update		'rs.movefirst		session(questofile+"test")="prova chiamato: "&now()&"<br>Form<br>"&queryeform()				For Each item In Request.form			if item<>"salva_dati" then				valore=Request.form(item)				if valore="-si-" then					valore=1				elseif valore="-no-" then					valore=0				end if				rs(item)=valore				session(questofile+"test")= session(questofile+"test")&"(" & item & "):" & valore & "|"			end if		Next		if len(request.form("testo_filigrana"))>0 then			Set Jpeg = Server.CreateObject("Persits.Jpeg")			' Create a "blank" image			Jpeg.New 1000, 150, &HFFFFFF			'Image.Canvas.Font.Align=2			Jpeg.Canvas.Font.Size = 18			larg=Jpeg.Canvas.PrintTextEx (request.form("testo_filigrana"),0 , Jpeg.height/2, "c:\Windows\Fonts\Arial.ttf")			rs("width_filigrana")=larg			'call add2log("Larghezza filigrana:"&larg,0)		else			rs("width_filigrana")=0		end if		rs.update		rsclose		Application("ConfigOk")=questofile		txt_succes="Dati salvati"	end if	if request("salva_dati")="form-4" then		sql="select * from impostazioni order by id"		rs.Open sql, conn, 1, 3		rs("dati_trasporto")=trim(request.form("contrassegno"))&vbcrlf&trim(request.form("minimo"))&vbcrlf&trim(request.form("fatt_min"))&vbcrlf&trim(request.form("inpercentuale"))&vbcrlf& trim(request.form("fatt_max"))&vbcrlf&trim(request.form("minimo2"))&vbcrlf&trim(request.form("fatt_min2"))&vbcrlf&trim(request.form("minimo3"))&vbcrlf&trim(request.form("fatt_min3"))		rs.update		rsclose		Application("ConfigOk")=questofile		txt_succes="Dati salvati"	end if	if request("salva_dati")="form-9" then		sql="select dati_vari.* from dati_vari where chiave='invio_fattura'"		rs.Open sql, conn, 1, 3		if rs.eof then			rs.addnew			rs("chiave")="invio_fattura"		end if		rs("valore")=request("oggetto_email_fattura")+"||"+request("messaggio_email_fattura")+"||"+request("email_copia_fattura")		rs.update		rsclose					txt_succes="Dati invio fattura salvati"	end if	if request("salva_dati")="form-10" then		sql="select dati_vari.* from dati_vari where chiave='pagina-contacts'"		rs.Open sql, conn, 1, 3		if rs.eof then			rs.addnew			rs("chiave")="pagina-contacts"		end if		rs("valore")=request("contacts-google-keys")+"||"+request("contacts-coord")+"||"+request("contacts-telefono")+"||"+request("contacts-cellulare")+"||"+request("contacts-email")+"||"+request("contacts-skype")		rs.update		rsclose		txt_succes="Dati pagina contacst salvati"	end if	if request("salva_dati")="form-11" then		sql="select dati_vari.* from dati_vari where chiave='index-slider'"		rs.Open sql, conn, 1, 3		if rs.eof then			rs.addnew			rs("chiave")="index-slider"		end if		rs("valore")=request("contenuto")		rs.update		rsclose		txt_succes="Dati Slider salvati"	end if	if request("salva_dati")="form-13" then		sql="select * from impostazioni order by id"		rs.Open sql, conn, 1, 3		pagamenti_ordine_v=replace(request.form("Pagamenti_ordine"),", ","")&"-"		pagamenti_ordine_v_old=rs("pagamenti_ordine")		rs("pagamenti_ordine")=pagamenti_ordine_v		rs.update		rs.close		add2log "Aggiornato metodi di pagamento utilizzati per ordini eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]"&vbcrlf&"Prima:"&pagamenti_ordine_v_old&vbcrlf&"Dopo:"&pagamenti_ordine_v,2		Application("ConfigOk")=questofile		txt_succes="Dati salvati"	end if	if request("salva_dati")="form-15" then		sql="select * from impostazioni_ebay where id=1"		rs.Open sql, conn, 1, 3		if rs.eof then			rs.addnew		end if		n_fields=rs.fields.count-1		Set Flds = rs.Fields		'memorizzo i nomi dei campi e i valori attuali		for i=1 to n_fields			RS.Fields(i)=request.form(RS.Fields(i).Name)		next		rs.update		rsclose		Application("ConfigOk")=questofile		txt_succes="Dati salvati"	end if	if request("salva_dati")="form-16" then		chiave="mail_fondo"		sql="select dati_vari.* from dati_vari where chiave='"&chiave&"'"		rs.Open sql, conn, 1, 3		if rs.eof then			rs.addnew			rs("chiave")=chiave		end if		rs("valore")=request(chiave)		rs.update		rs.Close				chiave="mail_pag"		sql="select dati_vari.* from dati_vari where chiave='"&chiave&"'"		rs.Open sql, conn, 1, 3		if rs.eof then			rs.addnew			rs("chiave")=chiave		end if		rs("valore")=request(chiave)		rs.update		rs.Close								chiave="mail_ofoot"		sql="select dati_vari.* from dati_vari where chiave='"&chiave&"'"		rs.Open sql, conn, 1, 3		if rs.eof then			rs.addnew			rs("chiave")=chiave		end if		rs("valore")=request(chiave)		rs.update		rs.Close				chiave="mail_pfoot"		sql="select dati_vari.* from dati_vari where chiave='"&chiave&"'"		rs.Open sql, conn, 1, 3		if rs.eof then			rs.addnew			rs("chiave")=chiave		end if		rs("valore")=request(chiave)		rs.update		rs.Close				txt_succes="Dati salvati"		rsclose	end if				Response.ContentType = "application/json; charset=utf-8"	Set Js = jsObject()	Js("status")="success"	Js("message")=txt_succes	session("test")= session("test") &"<br>"&js.jsString		js.Flush	set js=Nothing	call ResponseEnd()end ifdim active_tabif request("cosa")="contact" then	active_tab=9else	active_tab=0end ifSet metodipagamento = New ClasseMetodipagamento 'Create an Instance of the Class%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><script>	$(function() {		$( "#tabs" ).tabs({		  active: <%=active_tab%>		});	});	</script>	<style>label{float: left;width: 220px;}input, textarea{/*width: 180px;*/margin-bottom: 5px;}input[type="radio"]{width: 30px;margin-bottom: 5px;}textarea{width: 550px;height: 50px;}.boxes{width: 1em;}.b_salva{margin-left: 120px;margin-top: 5px;}br{clear: left;}.sezione{ background:#E5E5E5; width:100%; margin-bottom: 5px; padding:3px 0px 3px 3px;}.tabSplit { clear: both; }</style></head><body><div id="wrap"><div id="header"><%=titolo_top%> <div id="barra_fissa">	   <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Configurazione</a></div></div>		<%'for each item in Request.Form'  Response.write item & ": " & Request.Form(item) & "<br>"'nextsql="select impostazioni.* FROM impostazioni order by id"Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 3, 3%><div id="tabs">        <ul>			<li><a href="#tabs-1">Generali</a></li>			<li><a href="#tabs-14">Catalogo</a></li>			<li><a href="#tabs-2">Ordini</a></li>			<li><a href="#tabs-4">Costi trasporto</a></li>            <li><a href="#tabs-12">Metodi di incasso</a></li>            <li><a href="#tabs-13">Metodi di pagamento</a></li>			<li><a href="#tabs-3">PDF</a></li>			<li><a href="#tabs-8">Gestione concorrenza sui dati</a></li>			<li><a href="#tabs-9">Invio fattura via email</a></li>			<li class="tabSplit"><a href="#tabs-11">Pagina Home: Slider rev</a></li>            <li><a href="#tabs-10">Pagina contacts</a></li>            <li><a href="#tabs-15">eBay</a></li>            <li><a href="#tabs-16">Email</a></li>        </ul>            <div id="tabs-1">    <form id="form-1">        <label>Titolo nel browser</label>        <input type="text" name="brwstitle" title="Testo visualizzato come nome pagina nel browser" value="<%=rs("brwstitle")%>" class="i_text" size="60"><br />        <label>Tag description</label>        <textarea name="tag_desc" rows="3" style="FONT: 12px;" title="La meta tag description ha la funzione di un testo pubblicitario, deve attirare i lettori di un sito web dai risultati e, quindi, è una parte estremamente importante del search marketing. Le Meta tag description possono essere di qualsiasi lunghezza, ma in generale i motori di ricerca troncano frammenti più lunghi di 160 caratteri, per questo motivo è meglio mantenerle tra i 150-160 caratteri." class="i_text"><%=rs("tag_desc")%></textarea><br />        <label>Tag keywords</label>        <textarea name="tag_key"  rows="3" style="FONT: 12px;" title="Il tag keywords non è più utilizzato dalla maggior parte dei motori di ricerca" class="i_text"><%=rs("tag_key")%></textarea><br />        <label>Sezione head</label><textarea name="head" cols="45" rows="3" style="FONT: 12px; height:150px;" title="Utilizzare per aggiungere ulteriori tag o script"  class="i_text"><%=rs("head")%></textarea><br />         <% val_si="" val_no=""	if rs("logBoot") then val_si=" checked" else val_no=" checked"%>               <label>Registra accessi boot e crawler</label>Si<input name="logBoot" type="radio" value="-si-" <%=val_si%>>No<input name="logBoot" type="radio" value="-no-" <%=val_no%>><br />        <div class="sezione">Email</div>        <label>Indirizzo email del sito</label><input type="text" name="email_sito" value="<%=rs("email_sito")%>" size="60" title="Indirizzo per risposta visualizzato nelle email inviate dal sito" class="i_text"> <br />        <label>Immagine nella testata delle email</label><input type="text" name="img_email" size="60" value="<%=rs("img_email")%>" class="i_text"> <br />        <div class="sezione">Notifiche via Email</div>        <p>Separare gli indirizzi con ;</p>        <label>Indirizzi email notifica nuova registrazione</label><input type="text" name="noti_email_registr" size="60" value="<%=rs("noti_email_registr")%>" title="Separare gli indirizzi con ;" class="i_text"><br />        <label>Indirizzi email per l'inoltro di comunicazioni</label><input type="text" name="email_suppl" size="60" value="<%=rs("email_suppl")%>" title="Separare gli indirizzi con ;" class="i_text"><br />                        <div class="sezione">Filigrana</div> <% val_si="" val_no=""	if rs("filigrana")=1 then val_si=" checked" else val_no=" checked"%>               <label>Applica filigrana</label>Si<input name="filigrana" type="radio" value="-si-" <%=val_si%>>No<input name="filigrana" type="radio" value="-no-" <%=val_no%>><br />        <label>Testo</label><input type="text" name="testo_filigrana" value="<%=rs("testo_filigrana")%>" size="60" title="Testo visualizzato in sovraimpressione" class="i_text"> Larghezza <%=rs("width_filigrana")%><br />        <div class="sezione">Catalogo</div>               <label>Domini per esclusione da sito suggerito</label><textarea name="escludi_sito_suggerito" cols="45" rows="5" style="FONT: 12px;" class="i_text"><%=rs("escludi_sito_suggerito")%></textarea> <br />        <label>Codice mi piace</label><textarea name="mipiace" cols="45" rows="5" style="FONT: 12px;" class="i_text"><%=rs("mipiace")%></textarea>    <br />        </form><button id="salva-1" class="b_salva" disabled>Salva modifiche</button>            </div>    <div id="tabs-14">	    <form id="form-14">		 <%		 val_si=""		 val_no=""			if rs("consenti_acquisti")=1 then val_si=" checked" else val_no=" checked"		%>               <label>Consenti acquisti</label>Si<input name="consenti_acquisti" type="radio" value="-si-" <%=val_si%>>No<input name="consenti_acquisti" type="radio" value="-no-" <%=val_no%>><br />		 <%		 val_si=""		 val_no=""			if rs("consenti_registrazione")=1 then val_si=" checked" else val_no=" checked"		%>               <label>Consenti registrazione</label>Si<input name="consenti_registrazione" type="radio" value="-si-" <%=val_si%>>No<input name="consenti_registrazione" type="radio" value="-no-" <%=val_no%>><br />		    		    		    		    <label>Articoli visualizzati in category</label>		    <%val=cint(rs("category_predefinito"))			    response.write val		    %>		    <select name="category_predefinito">			    <option value="0" <%if val=0 then response.write "selected"%>>Niente </option>			    <option value="-1" <%if val=-1 then response.write "selected"%>>Nuovi articoli</option>		    </select><br><% val_si="" val_no=""	if rs("scopri_prezzi")=1 then val_si=" checked" else val_no=" checked"%>               <label>Visualizza prezzi senza login</label>Si<input name="scopri_prezzi" type="radio" value="-si-" <%=val_si%>>No<input name="scopri_prezzi" type="radio" value="-no-" <%=val_no%>><br />	<% val_si="" val_no=""	if rs("prezzi_con_iva")=1 then val_si=" checked" else val_no=" checked"%>               <label>Visualizza i prezzi iva compresa</label>Si<input name="prezzi_con_iva" type="radio" value="-si-" <%=val_si%>>No<input name="prezzi_con_iva" type="radio" value="-no-" <%=val_no%>><br /> <% val_si="" val_no=""	if rs("disponibilita_auto")=1 then val_si=" checked" else val_no=" checked"%>               <label>Gestione automatica disponibilità</label>Si<input name="disponibilita_auto" type="radio" value="-si-" <%=val_si%>>No<input name="disponibilita_auto" type="radio" value="-no-" <%=val_no%>><br /> 	    		    		    	    </form>	    <button id="salva-14" class="b_salva" disabled>Salva modifiche</button>            </div>              <div id="tabs-2">    <form id="form-2">		<%		val_si=""		val_no=""		if rs("azzera_numerazioni") then val_si=" checked" else val_no=" checked"		%> 		<label>Azzera numerazione ordini, preventivi, ordini fornitori con nuovo anno</label>Si<input name="azzera_numerazioni" type="radio" value="-si-" <%=val_si%>>No<input name="azzera_numerazioni" type="radio" value="-no-" <%=val_no%>><br /><br>		 <%		val_si=""		val_no=""		if rs("pagamento_immediato") then val_si=" checked" else val_no=" checked"		%> 	    <label>Abilita pagamento Paypal dopo ordine senza attesa stato ordine confermato</label>Si<input name="pagamento_immediato" type="radio" value="-si-" <%=val_si%>>No<input name="pagamento_immediato" type="radio" value="-no-" <%=val_no%>><br /><br>	    <label>Account Paypal</label><input name="codice_paypal" type="text" value="<%=rs("codice_paypal")%>" size="60" class="i_text"><br />		<label>Banca d'appoggio</label><input type="text" name="banca_appoggio" value="<%=rs("banca_appoggio")%>" size="60" class="i_text"> <br />		<label>IBAN</label><input type="text" name="iban" value="<%=rs("iban")%>" size="60" class="i_text"> </br>		<label>Importo minimo per preventivo</label><input type="text" name="minimo_preventivo" value="<%=rs("minimo_preventivo")%>" size="60" class="i_text"></br>		<label>Indirizzo email per inoltro copia email gestione ordini</label><input type="text" name="copia_email_ordini" value="<%=rs("copia_email_ordini")%>" size="60" class="i_text">		    </form>    <button id="salva-2" class="b_salva" disabled>Salva modifiche</button>    </div>	<div id="tabs-4">		<form id="form-4">			<input type="hidden" name="dati_vari" value="si"/>			<%						val=split(rs("dati_trasporto"),vbcrlf)			n=ubound(val)			if n<6 then				Redim PRESERVE val(15)			end if						%>			<label>Contrassegno</label><input type="text" name="contrassegno" class="richiesto i_text" value="<%=val(0)%>" title="Prezzo del trasporto in modlità contrassegno" ><br>			<label>Spese trasporto</label><input type="text" name="minimo" class="richiesto i_text" value="<%=val(1)%>" title="Prezzo del trasporto applicato se l'importo dell'ordine è sotto il valore minimo"><br>			<label>Fino a importo ordine minimo</label><input type="text" name="fatt_min" class="richiesto i_text" value="<%=val(2)%>" title="Sotto questo importo viene applicato il prezzo fisso, sopra viene calcolato in percentuale"><br><br>			<label>Spese trasporto</label><input type="text" name="minimo2" class="richiesto i_text" value="<%=val(5)%>" title="Prezzo del trasporto applicato se l'importo dell'ordine è sotto il valore minimo"><br>			<label>Fino a importo ordine</label><input type="text" name="fatt_min2" class="richiesto i_text" value="<%=val(6)%>" title="Sotto questo importo viene applicato il prezzo fisso, sopra viene calcolato in percentuale">Inserire 0 se non si utilizza questa fascia di importo<br><br>			<label>Spese trasporto</label><input type="text" name="minimo3" class="richiesto i_text" value="<%=val(7)%>" title="Prezzo del trasporto applicato se l'importo dell'ordine è sotto il valore minimo"><br>			<label>Fino a importo ordine</label><input type="text" name="fatt_min3" class="richiesto i_text" value="<%=val(8)%>" title="Sotto questo importo viene applicato il prezzo fisso, sopra viene calcolato in percentuale">Inserire 0 se non si utilizza questa fascia di importo<br><br>			<label>Spese trasporto in % del</label><input type="text" name="inpercentuale" class="richiesto i_text" value="<%=val(3)%>" title="Valore di percentuale applicata sull'importo dell'ordine quando viene superato l'importo minimo minimo"><br>			<label>A Ns. carico  per fatturato oltre</label><input type="text" name="fatt_max" class="richiesto i_text" value="<%=val(4)%>" title="Importo dell'ordine oltre il quale le spese di trasporto sono gratuite"><br>	    </form>	    <button id="salva-4" class="b_salva" disabled>Salva modifiche</button>    </div>        	<div id="tabs-3">		<form id="form-3">		<label>Intestazione D.d.T e Fattura</label><textarea name="intestazione_ddt"  style="FONT: 12px; height:150px;" class="i_text"><%=rs("intestazione_ddt")%></textarea><br />		<label>Piè di pagina listino e scheda articolo</label><textarea name="fondo_listino"  style="FONT: 12px; height:150px;" class="i_text"><%=rs