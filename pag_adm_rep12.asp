<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><%if session("idadmin") = "" then call login()mese=request.form("mese")if mese="" then	mese=month(date())	anno=year(date())else	anno=request.form("anno")end ifal_iva=1+iva(date())/100%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%><div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Margine lordo per cliente</a></div>    </div>       <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >               <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr >             <td colspan="4" style="border-bottom:1px solid;">Mese              <select name="MESE" onChange="this.form.submit()">                <option value="">Selezionare</option>                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(mese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select>               Anno              <input name="anno" type="text" value="<%=anno%>" size="4">              <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;"> <%if mese>0 then%>              <a href="pag_adm_rep07_excel.asp?mese=<%=mese%>&anno=<%=anno%>">Esporta excel</a>              <%end if%></td>          </tr></table></form>        <%if mese<>"0" thensql="select utenti.iduser, i.nome,i.cognome,i.azienda, sum(totale_riga) as totale_riga, sum(ordini_dett.costo_ordine) as totale_materiali, count(fatture.idfat) as conteggio_fatture, fatture.idfat, fatture.nfat, year(fatture.data) as anno, month(fatture.data) as mese from ((utenti inner join fatture on utenti.iduser = fatture.iduser) inner join ordini_fatture on fatture.idfat = ordini_fatture.idfat) inner join ordini_dett on ordini_fatture.idord = ordini_dett.idord inner join utenti_intestazioni i on utenti.idintestazione = i.id group by iduser,anno HAVING ((mese="&mese &") AND (anno="&anno&"))"set rs=conn.execute (sql)				%>	<table id="example" class="display" cellspacing="0" width="100%">                <thead>                  <tr>                    <th>Cliente</th>                    <th>Totale fatture</th>                    <th>Conteggio fatture</th>                    <th>Margine lordo</th>                    <th>Margine lordo perc</th>                  </tr>                </thead>                <tfoot>                  <tr>                    <th>Cliente</th>                    <th>Totale fatture</th>                    <th>Conteggio fatture</th>                    <th>Margine lordo</th>                    <th>Margine lordo perc</th>                  </tr>                </tfoot>                <tbody>                  <%do while not rs.eof				  if isnull(rs("totale_materiali")) then					no_mlc=true				else					no_mlc=false				end if				totale_riga_tmp=cdbl(rs("totale_riga"))				totale_materiali=cdbl(rs("totale_materiali"))				  %>                                    <tr>                    <td><%=denominazione(rs("nome"),rs("cognome"),rs("azienda"))%></td>                    <td align="right"><%=replace(formatnumber(rs("totale_riga"),0),".",",")%></td>                    <td align="center"><%=rs("conteggio_fatture")%></td>                    <td align="right"><%if no_mlc=false then%><%=replace(formatnumber(totale_riga_tmp-(totale_materiali*al_iva),0),".",",")%><%end if%></td>                    <td align="right"><%if no_mlc=false then%><%=formatnumber(mlc_percentuale(totale_riga_tmp,totale_materiali*al_iva),0)%><%end if%></td>                  </tr><%rs.movenextloopset rs = Nothingcall connclose()%>                </tbody>              </table><%end if%>        <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><script type="text/javascript" src="Jquery/js/DataTables/jquery.dataTables.min.js"></script><script type="text/javascript" language="javascript" class="init">$(document).ready(function() {	var tabella=$('#example').dataTable( {		"bPaginate": false,		"bSort": true,		"bJQueryUI": true,		"aaSorting": [[ 2, "desc" ]],		"language": {			"decimal": ",",			"thousands": "."		},		"oLanguage": {			"sUrl": "Jquery/js/DataTables/italiano.txt"		}	});} );	</script></body></html>