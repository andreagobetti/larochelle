<!--#include virtual="/setup.asp" --><%	if request.form("esegui")<>"" then		call watermark(request.form("id"))	end if				%><form action="<%=questofile%>" method="post">	Esempio watermark<br>	ID articolo:<input type="text" name="id" >	<input type="submit" name="esegui" name="Esegui"/></form> <%	sub watermark (id)	dim rot45	rot45=true		txt = "La Rochelle"	font_size=18	margine=100	Set Jpeg = Server.CreateObject("Persits.Jpeg")		' Create a "blank" image	Jpeg.New 500, 150, &HFFFFFF	'Image.Canvas.Font.Align=2	Jpeg.Canvas.Font.Size = font_size		larg=Jpeg.Canvas.PrintTextEx (txt,0 , Jpeg.height/2, "c:\Windows\Fonts\Arial.ttf")		if rot45 then		larg=larg/1.4141	end if	rapporto=larg/font_size			'txt=txt&"("&larg&")"			' Open source image	immaginePath=server.MapPath("/public")&"/foto/bk/"&conn.execute("select prodotti.fileimg from prodotti where idpro="&id)(0)		Jpeg.Open immaginePath		' Font path	FontPath = Jpeg.WindowsDirectory & "\fonts\courbd.ttf"	y=Jpeg.Height/3*2	x=Jpeg.width	'Calcolato in base al margine	font_size=(x-(margine*2))/rapporto		'Calcolato in base all'ingombro in larghezza	font_size=(x/2)/rapporto	margine=(x/2/2)			Jpeg.Canvas.Font.Color = &HFAC83C 	jpeg.Canvas.Font.Size = font_size	jpeg.Canvas.Font.Opacity = 0.5	Jpeg.Canvas.Font.Rotation = 45	jpeg.Canvas.PrintTextEx txt, margine, y, "c:\Windows\Fonts\Arial.ttf"						Jpeg.SendBinary	set Jpeg = nothingend sub%>