<!--#include virtual="/setup.asp" --><%	if request.form("esegui")<>"" then		call watermark(request.form("id"))	end if				%><form action="<%=questofile%>" method="post">Applica filigrana su tutte le immagini	<input type="submit" name="esegui" name="Esegui"/></form> <%	sub watermark (id)	Server.ScriptTimeout=60*3	'Cartelle	savefolder=upl_img_cat	'"/public/img_prod/"	savefolderbk=savefolder&"bk/"	'Filigrana					txt = Application("testo_filigrana")	if txt="" then		response.write "Manca testo filigrana"		response.end	end if	if Application("width_filigrana")=0 then		response.write "Manca larghezza filigrana"		response.end	end if	rapporto=Application("width_filigrana")/18		'Se manca creo la cartella	set fsoobject = CreateObject("Scripting.filesystemObject" )	if not fsoobject.FolderExists(Server.MapPath(savefolderbk)) then		fsoobject.CreateFolder(Server.MapPath(savefolderbk))		response.write "Creata cartella "&savefolderbk&"<br>"	end if			Set Jpeg = Server.CreateObject("Persits.Jpeg")					on error resume next						set rs=conn.execute("select files.* from files where cosa=4")	do while not rs.eof			newname=rs("filename")		'Controllo se backup esiste		if fsoobject.FileExists(server.mappath(savefolderbk&newname)) then			response.write(savefolderbk&newname&" esiste<br>")		else			fsoobject.CopyFile Server.MapPath(savefolder&newname),Server.MapPath(savefolderbk&newname),true			response.write(savefolderbk&newname&" copiato<br>")		end if						' Open source image		Jpeg.Open server.mappath(savefolderbk&newname)			' Font path		FontPath = Jpeg.WindowsDirectory & "\fonts\courbd.ttf"		y=Jpeg.Height/3*2		x=Jpeg.width		'Calcolato in base al margine		'font_size=(x-(margine*2))/rapporto				'Calcolato in base all'ingombro in larghezza		font_size=(x/2)/rapporto		margine=(x/2/2)						Jpeg.Canvas.Font.Color = &HFAC83C 		jpeg.Canvas.Font.Size = font_size		jpeg.Canvas.Font.Opacity = 0.5		txt=txt&vbcrlf&larg		jpeg.Canvas.PrintTextEx txt, margine, y, "c:\Windows\Fonts\Arial.ttf"		if err.number<>0 then			response.write "Filigrana non applicata su "&rs("idcosa")&"<br>"			err.clear		end if						Jpeg.save server.mappath(savefolder&newname)				rs.MoveNext	loop	set Jpeg = nothingend sub%>