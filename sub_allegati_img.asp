<%'Verifica chiusure 04_12_2015%><%sql="select * from files where idcosa="&id_tipo_allegato &" and cosa="&tipo_allegato &" order by ordine"set rs_files=conn.execute(sql)if not rs_files.eof then%><script>	$(function() {		var id_file;		$.ajaxSetup({			cache: false		});		var dialog, form;		$(".edit_img").on("click", function (e) {			var id_file=$(this).closest("li").attr("id").substring(8);			console.log("idfile:"+id_file);			$.get("ajax_function.asp?oper=load_descrizione_img&id_file=" + id_file, function (result) {			//alert("qui");			if (result.success==true)			{				//toastr.options = {"positionClass": "toast-bottom-right"};				//toastr.success(result.Message);								$("#dialog_idfile").val(id_file);				$("#descrizione_img").val(result.descrizione_img);				dialog.dialog( "open" );			}			else			{				toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};				toastr.error(result.Message);			}			});			});		dialog = $( "#dialog-form" ).dialog({			  autoOpen: false,			  height: 300,			  width: 650,			  modal: true,			  buttons: {				"Modifica": saveDescimg,				Cancel: function() {				  dialog.dialog( "close" );				}			  },			  close: function() {				//form[ 0 ].reset();				//allFields.removeClass( "ui-state-error" );			  }			});		function saveDescimg() {			var id_file=$("#dialog_idfile").val();			var descrizione_img=$( "#descrizione_img" ).val();			//alert($("#id_file_"+id_file).children().attr('id'));			$("#id_file_"+id_file).children().attr("title",descrizione_img);			var dati=encodeURI("oper=save_descrizione_img&descrizione_img="+descrizione_img+"&id_file="+id_file);			//alert(dati);			var posting = $.post( "ajax_function.asp",dati);			posting.success(function( data ) {					dialog.dialog( "close" );										toastr.options = {"positionClass": "toast-bottom-right"};					toastr.success(data.Message);			});			posting.error(function() {			alert( "Errore" );			});		  return true;		}			$(".delete_img" ).button({icons: {primary: "ui-icon-trash"},text: false});			$(".edit_img" ).button({icons: {primary: "ui-icon-clipboard"},text: false});			$(".aggiustaratio" ).button({icons: {primary: "ui-icon-arrowthick-2-se-nw"},text: false});			$("#tr_allegati<%=tipo_allegato%>").show();						$(".delete_img").on("click", function (e) {				id_file=$(this).closest("li").attr("id").substring(8);								 $( "#dialog-confirm" ).dialog({				 title:"Conferma eliminazione",			      resizable: false,			      height:140,			      modal: true,			      buttons: {			        "Si, cancella immagine": function() {			        			        $.ajaxSetup({ cache: false });					$.get("ajax_function.asp?oper=elimina_immagine&idpro=<%=idpro%>&id_file="+id_file, function(result){					//alert("qui");					if (result.success==true)					{						toastr.options = {"positionClass": "toast-bottom-right"};						toastr.success(result.Message);						$("#id_file_"+id_file).remove();					}					else					{						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};						toastr.error(result.Message);					}					});				          $( this ).dialog( "close" );			        },			        "No": function() {			          $( this ).dialog( "close" );			        }			      }			    });			});			$(".aggiustaratio").on("click", function (e) {				id_file=$(this).closest("li").attr("id").substring(8);					$.get("ajax_function.asp?oper=ridimensiona_immagine&id_file="+id_file, function(result){					//alert("qui");					if (result.success==true)					{						toastr.options = {"positionClass": "toast-bottom-right"};						toastr.success(result.Message);					$.get("ajax_function.asp?oper=aggiorna_elenco_immagini&tipo_allegato=<%=tipo_allegato%>&id_tipo_allegato=<%=id_tipo_allegato%>&idpro=<%=idpro%>", function(result){						$("#sub_allegati_img").html(result);					 });						}					else					{						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};						toastr.error(result.Message);					}					});								});		$( "#griglia" ).sortable({			cursor: 'pointer',			tolerance: 'pointer', 			update : function () { 				var order = $('#griglia').sortable('serialize'); 				$.get("ajax_function.asp?oper=ordina_immagini&idpro=<%=idpro%>&"+order, function(result){				if (result.success==true)				{					toastr.options = {"positionClass": "toast-bottom-right"};					toastr.success(result.Message);				}				else				{					toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};					toastr.error(result.Message);				}				});				}		});				});	</script><div id="dialog-form" title="Work in progress, non toccare" style="display:none;">	<p class="validateTips">Descrizione immagine</p>	<fieldset>	  <textarea name="descrizione_img" id="descrizione_img" value="" class=""  style="width:100%; height:100px; border: none; background:none;"></textarea>	  <input type="hidden" name="dialog_idfile" id="dialog_idfile" value="" >	  <!-- Allow form submission with keyboard without duplicating the dialog button -->	  <input type="submit" tabindex="-1" style="position:absolute; top:-1000px">	</fieldset></div><div id="dialog-confirm" style="display:none;">  Vuoi eliminare l'immagine?</div>  <div class="div_titolo">Immagini</div>  <%	maxWidth=800*2	maxHeight=1120*2	set fs=Server.CreateObject("Scripting.filesystemObject")	Set Jpeg = Server.CreateObject("Persits.Jpeg")    %>            <div class="div_testo" style="display:none;" id="tr_allegati<%=tipo_allegato%>">	            La prima immagine è quella predefinita, puoi riordinare le immagini trascinandole con il mouse.              <ul id="griglia">              <%	do until rs_files.EOF		on error resume next	Jpeg.Open Server.MapPath(rs_files("path")&rs_files("filename"))	If Err.Number = 0 Then		AspectRatio=jpeg.originalWidth/jpeg.originalHeight		if AspectRatio<0.71 or AspectRatio>0.73 then			showAspectRatio=true		else			showAspectRatio=false		end if		if jpeg.Width>maxWidth or jpeg.Height>maxHeight then			showAspectRatio=true		end if				set f=fs.GetFile(Server.MapPath(rs_files("path")&rs_files("filename")))		size=f.Size		set f = Nothing		kbsize=formatnumber(size/1024,0)	end if						%><li id="id_file_<%=rs_files("idfiles")%>"><a href="<%=rs_files("path")&rs_files("filename")%>" target="new" class="tooltip" title="<%=rs_files("descrizione")%>"><img src="send_img.asp?path=<%=rs_files("path")&rs_files("filename")%>&max=180x180"/></a><span class="file"><%=rs_files("filename")%><br><%=jpeg.Width&"x"&jpeg.Height&":"&round(AspectRatio,2)%><br><%=kbsize%>k<a class="delete_img" >Cancella</a><a class="edit_img" >Modifica testo</a><%if showAspectRatio then%><a class="aggiustaratio" >Aggiusta ratio</a><%end if%></span></li><%	rs_files.movenext	loop	set fs=nothing	Set Jpeg = Nothing	rs_files.close	%>    </ul></div>    <%end if	set rs_files = Nothing	%>