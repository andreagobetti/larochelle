<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/ClasseOrdine.asp" --><%	iduser=request("iduser")	idord=request("idord")		if request.form("calcola")<>"" then		calcola=true	else		calcola=false	end if	if request.form("aggiungi")<>"" then		set ordine= (new ClasseOrdine)(array("aggiungi_spettanze",idord,iduser))		set ordine_Dictionary = Nothing		call connclose()		Response.redirect "pag_adm_ordini.asp?idord="&idord	end if			%><!--#include virtual="/sub_head_adm.asp" --><style>	 th {  position: relative;  padding: 10px;}th span {  transform-origin: 0 50%;  transform: rotate(-90deg);   white-space: nowrap;   display: block;  position: absolute;  bottom: 0;  left: 50%;}tr {	border-bottom:1px solid;}</style></head><body> <div id="wrap">	<div id="header">		<%=titolo_top%>		<!-- Div Content INIZIO-->		 <%barra=0%>		<!--#include virtual="/sub_barra_adminsf2.asp" -->	    <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Carica spettanze</a></div>	    <div class="ui-widget-header" style="padding: 5px;">		    <%			    set rs=conn.execute("select utenti.nome, utenti.cognome, utenti.azienda from utenti where iduser="&iduser)			    response.write denominazione(rs(0),rs(1),rs(2))			    set rs = nothing			    %>	    </div>	    <%		    set rs_dipendenti=conn.execute ("select iddip, nominativo from dipendenti where iduser="&iduser)		    arrRS=rs_dipendenti.getrows()		    ubound_arrRS=ubound(arrRS,2)		    		    		    	    %>	    <form method="POST" action="<%=questofile%>">			<table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1" id="spettanze">				<thead >				<tr> 					<th >Articolo</th>		            <%		            for n = 0 to ubound_arrRS		            %>		            <th><span><%=arrRS(1,n)%></span></th>		            <%		            Next		            		            %>				</tr>				</thead>				<tbody>					<%					sql="select prodotti_spettanze.id, prodotti.idpro, prodotti_spettanze.idvara,prodotti_spettanze.idvarb, prodotti.codice, prodotti.articolo, varianti_a.variante_a,  varianti_b.variante_b, prodotti_spettanze.tipo_prodotto from ((prodotti_spettanze INNER JOIN prodotti on prodotti_spettanze.idpro=prodotti.idpro) left join varianti_a on prodotti_spettanze.idvara = varianti_a.idvara ) left join varianti_b on prodotti_spettanze.idvarb = varianti_b.idvarb where iduser="&iduser&" order by prodotti_spettanze.ordine"						set rs_prodotti=conn.execute(sql)						do while not rs_prodotti.EOF						%>						<tr>							<td><%=rs_prodotti("codice")&" "&rs_prodotti("articolo")%></td>				            <%				            for n = 0 to ubound_arrRS					        val=request.form("quantita_"&rs_prodotti("idpro")&"_"&rs_prodotti("idvara")&"_"&rs_prodotti("idvarb")&"_"&arrRS(1,n))				            				            %>				            <td align="center"><input type="text" name="quantita_<%=rs_prodotti("idpro")&"_"&rs_prodotti("idvara")&"_"&rs_prodotti("idvarb")&"_"&arrRS(0,n)%>" size="2" value="<%=val%>"></td>				            <%				            Next		            				            %>						</tr>						<%						rs_prodotti.MoveNext						Loop						call connclose()						%>				</tbody>				<tfoot>					<tr>						<td colspan="<%=ubound_arrRS+2%>">							<input type="hidden" name="iduser" value="<%=iduser%>"><input type="hidden" name="idord" value="<%=idord%>"> <input type="submit" name="calcola" Value="Calcola totali" disabled> <input type="submit" name="aggiungi" Value="Aggiungi a ordine">						</td>					</tr>				</tfoot>			</table>	    </form>        <!-- Div Content FINE-->	</div><!-- End #header --><div id="footer"></div><script>	$(function() {    var header_height = 0;    $('table th span').each(function() {        if ($(this).outerWidth() > header_height) header_height = $(this).outerWidth();    });    $('table th').height(header_height);});	</script><!--#include virtual="/pag_adm_footer_inc.asp" --></div><!-- End #wrap --></body></html><%%>