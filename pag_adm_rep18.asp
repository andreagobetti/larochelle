<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/pag_adm_fatture_for_inc.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()damese=request.form("damese")amese=request.form("amese")mese=request("mese")if mese<>"" then	amese=mese	damese=meseend ifanno=request.form("anno")if damese="" then	damese=month(date())end ifif amese="" then	amese=month(date())end ifif anno="" then	anno=year(date())end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><script>$(function() {	$("#damese").change(function(){		console.log("damese:"+$("#damese").val()+" amese:"+$("#amese").val());		if (Number($("#damese").val())>Number($("#amese").val())){		$("#amese").val($("#damese").val()) ;		}	});	$("#amese").change(function(){		if (Number($("#damese").val())>Number($("#amese").val())){		$("#damese").val($("#amese").val()) ;		}	});});</script></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%><div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Report fatture fornitori</a></div>    </div>       <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >               <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr >             <td style="border-bottom:1px solid;">Dal mese              <select name="DAMESE" id="damese" >                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(damese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select> al mese              <select name="AMESE" id="amese" >                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(amese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select>               Anno              <input name="anno" id="anno" type="text" value="<%=anno%>" size="4"> <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;">                             </td>          </tr>          <tr >             <td style="border-bottom:1px solid;">                            <select name="conto" id="conto">                              <option value="">Qualsiasi conto</option>							  <option value="rag" <%if request("conto")="rag" then%> selected <%end if%>>Raggruppa</option>							  <%for n=1 to conto(-1)%>							  <option value="<%=n%>" <%if request("conto")=""&n then%> selected <%end if%>><%=conto(n)%></option>							  <% next%>              </select>              <button id="esporta_excel">Esporta excel</button>              <script>$(function () {    $("#esporta_excel").on("click", function (e) {				e.preventDefault();				var str_link="pag_adm_rep18_excel.asp?damese="+$("#damese").val()+"&amese="+$("#amese").val()+"&anno="+$("#anno").val()+"&conto="+$("#conto").val();						window.location = str_link;								});			  });			  </script>              </td>          </tr></table></form>        <%if amese<>"" and damese<>"" then%>		<%sql="select fatture_for.IDfat, fatture_for.Nfat, i.Azienda, i.Cognome, i.Nome, fatture_for.data, utenti.iduser, i.provincia, fatture_for.totale_fattura, fatture_for.pagamento, fatture_for.conto FROM utenti INNER JOIN fatture_for ON utenti.iduser = fatture_for.idfor inner join utenti_intestazioni i on utenti.idintestazione = i.id "sql=sql & "where month(fatture_for.data)>="&damese &" and month(fatture_for.data)<="&amese &" and year(fatture_for.data)="&annofiltro_iva=request("iva")colspan=7'Selezione PROVINCIAconto_v=request("conto")if conto_v="rag" then	raggruppa_testa=true	raggruppa_coda=true	raggruppa="conto"	ordine=" order by conto, fatture_for.data"elseif conto_v<>"" then	raggruppa_testa=true		sql=sql& " and conto="&conto_v&""	ordine=" order by fatture_for.data"else	ordine=" order by fatture_for.data"end ifcall paginazione_start(sql&ordine,100000,"access")%>        <table width="100%" border="1" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="<%=colspan%>" class="ui-widget-header">Fatture fornitore dal mese di <%=nome_mese(damese)%>&nbsp;al mese di <%=nome_mese(amese)%>&nbsp;<%=anno%></td>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Fatt.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">ID Cli.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Nominativo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Tot. fattura</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Tipo conto</td>          </tr>          <%iRecordsShown = 0Totale=0conto_tmp=0n=0Do While iRecordsShown < iPageSize And Not objPagingRS.EOF	n=n+1	totale_fattura=cdbl(objPagingRS("totale_fattura"))	contov=clng(objPagingRS("conto"))	totale=totale+totale_fattura         if raggruppa_coda_tmp and conto_tmp<>contov then%>                        <tr>                        <td colspan="5"><b>Totale conto</b></td>            <td  align="right"><strong><%=formatnumber(totale_conto,2)%></strong></td>                       <td colspan="<%=colspan-6%>"></td>          </tr>          <%	totale_conto=0	raggruppa_coda_tmp=false	totale_iva2=0	totale_iva=0		  end if		  	totale_conto=totale_conto+totale_fatturaif ((raggruppa<>"" or raggruppa_testa) and conto_tmp<>contov)  then%> <tr>             <td bgcolor="#E5E5E5" colspan="<%=colspan%>" ><b><%=conto(objPagingRS("conto"))%></b></td>          </tr><%	conto_tmp=objPagingRS("conto")	if raggruppa_coda then raggruppa_coda_tmp=trueend if%>          <tr>            <td style="border-bottom:1px solid;"><input name="" type="checkbox" value="" class="selezione" id="selezione_<%=n%>"></td>             <td style="border-bottom:1px solid;"><%=objPagingRS("NFAT")%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=formatDateTime(objPagingRS("data"), vbShortDate)%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("iduser")%></td>            <td nowrap style="border-bottom:1px solid;"><%=objPagingRS("azienda")%></td>            <td align="right" class="corpobox" style="border-bottom:1px solid;"><span id="importo_<%=n%>"><%=formatnumber(objPagingRS("totale_fattura"),2)%></span></td>		            <td style="border-bottom:1px solid;" class="corpobox"><%=conto(objPagingRS("conto"))%></td>          </tr><% 		iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown	objPagingRS.MoveNextLoopcall paginazione_close()call connclose()         if raggruppa_coda_tmp then%>                        <tr>                        <td colspan="5"><b>Totali conto</b></td>            <td  align="right"><strong><%=formatnumber(totale_conto,2)%></strong></td>                      <td colspan="<%=colspan-6%>"></td>          </tr>          <%	totale_conto=0	raggruppa_coda_tmp=false	totale_iva2=0	totale_iva=0		  end if%>              <tr>            <td colspan="<%=colspan%>" align="right"><strong>Totale fatture fornitori: <%=formatcurrency(totale,2)%></strong></td>          </tr>              </table>              <%if request.querystring("idlog")<>"" then%> <a href="<%=Request.ServerVariables("Script_Name")%>"><b>Visualizza               tutti</b></a> <%end if%> </td>          </tr>        </table><%end if%>       <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><script>$(function() {    $(".selezione").on("change", function (e) {		var importo=0;		var conteggio=0;		$('input[type=checkbox]').each(function () {			if(this.checked){				conteggio++;				id=$(this).attr("id").replace("selezione_", "");				var importo_txt=$("#importo_"+id).text().replace(".","").replace(",", ".");				importo+=parseFloat(importo_txt);			}		});		toastr.clear();		toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};		toastr.info(conteggio+" elementi","<b>Totale: "+Number(importo).toLocaleString("it-IT", {minimumFractionDigits: 2})+"</b>");	});});		</script>	</body></html>