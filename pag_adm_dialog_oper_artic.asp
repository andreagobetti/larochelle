<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include file="JSON_latest.asp"--><!--#include file="classeordine.asp"--><!--#include file="classemagazzino.asp"--><%idord=request.form("idord")operazione=request.form("operazione")m_tabella=request.form("tabella")if request.form("esegui")<>""  then	call add2log(queryeform(),0)	dim ordina_tutti, ordina_mancanti, raggruppa	raggruppa=true	stringa_iddett=request.form("stringa_iddett")	Response.ContentType = "application/json; charset=utf-8"	Set Js = jsObject()	if operazione="ordina_fornitore" then		call add2log("Ordino",0)		if stringa_iddett<>"" then							dim rs_ordine,idord_fornitore,nord_cliente,RS			gravita=1			'Acquisisco dati sull'ordine cliente			Set rs_ordine = conn.execute ("select * FROM ordini WHERE ordini.idord="& idord&";")			nord_cliente=rs_ordine("nord")			spettanze=rs_ordine("spettanze")			set rs_ordine=nothing						session("proc_ordina")="Avviata procedura ordini a fornitori ("&operazione&") per [ordine="&idord&"]"&nord_cliente&"[/ordine] da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]:<br>"			session("report")=""						session("proc_ordina")=session("proc_ordina")&"stringa_iddett:"&stringa_iddett&"<br>"						sql = "select ordini_dett.*, prodotti.idfor,prodotti.codice,prodotti.articolo,prodotti.costo,magazzino.quantita_magazzino FROM (ordini_dett LEFT JOIN prodotti ON ordini_dett.idpro = prodotti.IDpro) left join magazzino oN (ordini_dett.idvarb = magazzino.idvarb) AND (ordini_dett.idvara = magazzino.idvara) AND (ordini_dett.idpro = magazzino.idpro) WHERE iddett in(" & stringa_iddett &") ORDER BY ordini_dett.iddett "			on error resume next			Set dett_ordini = conn.execute (sql)			if err.number<>0 then				call add2log("Errore in sql:"&sql,0)				response.end			end if			on error goto 0			if dett_ordini.eof then				session("proc_ordina")=session("proc_ordina")&now()&" Nessun record trovato<br>"				gravita=3			end if			Set dett_fornitori = Server.CreateObject("ADODB.Recordset")			do while NOT dett_ordini.EOF				session("proc_ordina")=session("proc_ordina")&" Processo iddett:"&dett_ordini("iddett")				quantita=TRIM(Request("quantita"&dett_ordini( "iddett")))				IF TRIM(Request("iddett"&dett_ordini( "iddett")))="SI" THEN									if dett_ordini("idpro")=0 then						session("proc_ordina")=session("proc_ordina")&" trovata riga campo libero.<br>"						dett_ordini.MoveNext					elseif dett_ordini("idfor")=0 or  isnull(dett_ordini("idfor")) then						session("report")=session("report")&"fornitore non specificato, impossibile creare ordine.<br>"						session("proc_ordina")=session("proc_ordina")&" "&dett_ordini("codice")&" "&dett_ordini("articolo")&" fornitore non specificato, impossibile creare ordine a fornitore.<br>"						dett_ordini.MoveNext					elseif quantita="" THEN						session("proc_ordina")=session("proc_ordina")&" "&dett_ordini("codice")&" "&dett_ordini("articolo")&" quantità nulla <br>"					elseif quantita=0 THEN						session("proc_ordina")=session("proc_ordina")&" "&dett_ordini("codice")&" "&dett_ordini("articolo")&" quantità zero <br>"					else													idfor=dett_ordini("idfor")						session("proc_ordina")=session("proc_ordina")&" "&dett_ordini("codice")&" "&dett_ordini("articolo")&" quantita ordinata:"&quantita&"<br>"							'cerca ordine fornitore, se non c'è viene creato												sql="select * from ordini_fornitori where stato<=1 and eliminato=0 and iduser="&idfor&" order by idord desc"						set rs_for=conn.execute(sql)						if rs_for.eof then							set ordine= (new ClasseOrdine)(array("nuovo","ordini_fornitori",idfor,0))							idord_fornitore=ordine.idord()														session("nord_fornitore")=ordine.nord()							session("proc_ordina")=session("proc_ordina")&"creato nuovo [ordine_fornitore="&idord_fornitore&"]"&ordine.nord()&"[/ordine_fornitore] "&get_denominazione(idfor)&"<br> "						else							idord_fornitore=rs_for("idord")							session("proc_ordina")=session("proc_ordina")&"trovato [ordine_fornitore="&rs_for("idord")&"], "&get_denominazione(idfor)&"<br>"							session("nord_fornitore")=rs_for("nord")						end if												rs_for.close												if session("nord_fornitore")="" then add2log "Manca nord",1						'response.write "select Max(ordini_fornitori_dett.ordine) AS MaxDiordine FROM ordini_fornitori_dett WHERE (((ordini_fornitori_dett.idord)="&idord_fornitore&"));"												'Cerco valore per ordinamento articoli						set max_ordine=conn.execute ("select Max(ordini_fornitori_dett.ordine) AS MaxDiordine FROM ordini_fornitori_dett WHERE (((ordini_fornitori_dett.idord)="&idord_fornitore&"));")						MaxDiordine=max_ordine("MaxDiordine")						if isnull(MaxDiordine) then MaxDiordine=0						MaxDiordine=MaxDiordine+2						if quantita>0 then														sql="select ordini_fornitori_dett.* FROM ordini_fornitori_dett where idord="&idord_fornitore&" and idpro="&dett_ordini("idpro")&" and idvara="&dett_ordini("idvara")&" and idvarb="&dett_ordini("idvarb")							dett_fornitori.Open sql, conn, 3, 3														if not dett_fornitori.eof and raggruppa then								iddett_fornitori=dett_fornitori("iddett")								'Esiste già questo articolo nell'ordine e devo raggruppare								dett_fornitori("quantita")=dett_fornitori("quantita")+quantita								dett_fornitori.update								session("proc_ordina")=session("proc_ordina")&" Aggiungo quantita ad articolo esistente<br>"							else								dett_fornitori.addnew								dett_fornitori("idord")=idord_fornitore								dett_fornitori("idpro")=dett_ordini("idpro")								'dett_fornitori("var1")=dett_ordini("var1")								'dett_fornitori("var2")=dett_ordini("var2")								dett_fornitori("um")=dett_ordini("um")								dett_fornitori("quantita")=quantita								dett_fornitori("prezzo")=dett_ordini("costo")								dett_fornitori("codice_ordine")=dett_ordini("codice_ordine")								dett_fornitori("articolo_ordine")=dett_ordini("articolo_ordine")								'dett_fornitori("variante1_ordine")=dett_ordini("variante1_ordine")								'dett_fornitori("variante2_ordine")=dett_ordini("variante2_ordine")								dett_fornitori("idvara")=dett_ordini("idvara")								dett_fornitori("idvarb")=dett_ordini("idvarb")								dett_fornitori("ordine")=MaxDiordine								dett_fornitori("varianti_ordine")=codifica_varianti_ordine(dett_ordini("var1"), dett_ordini("variante1_ordine"), dett_ordini("var2"), dett_ordini("variante2_ordine"))								dett_fornitori.update								iddett_fornitori=Get_last_id("ordini_fornitori_dett")								session("proc_ordina")=session("proc_ordina")&"Aggiungo articolo iddett_fornitori:"&iddett_fornitori&"<br>"							end if							dett_fornitori.close							if spettanze=1 then								quantita_spettanze=0								quantita_spettanze_caricate=0								'Creo spettanze ordine fornitore								Set rs_spettanze_fornitore = Server.CreateObject("ADODB.Recordset")								set rs_spettanze=conn.execute ("select ordini_dett_spettanze.* from ordini_dett_spettanze where iddett="&dett_ordini("iddett"))								do while not rs_spettanze.eof 									sql="select ordini_fornitori_dett_spettanze.* from ordini_fornitori_dett_spettanze where iddett="&iddett_fornitori&" and iddip="&rs_spettanze("iddip")									rs_spettanze_fornitore.Open sql,conn,3,3																		quantita=clng(dett_ordini("quantita"))-clng(dett_ordini("quantita_magazzino"))																		if (quantita_spettanze_caricate+cdbl(rs_spettanze("quantita")))>quantita then										quantita_spettanze=quantita-quantita_spettanze_caricate									else										quantita_spettanze=cdbl(rs_spettanze("quantita"))									end if									'quantita_spettanze=rs_spettanze("quantita")									if rs_spettanze_fornitore.eof then										rs_spettanze_fornitore.addnew										rs_spettanze_fornitore("iddett")=iddett_fornitori										rs_spettanze_fornitore("iddip")=rs_spettanze("iddip")										rs_spettanze_fornitore("quantita")=quantita_spettanze										rs_spettanze_fornitore("taglia_misura")=rs_spettanze("taglia_misura")									else										rs_spettanze_fornitore("quantita")=rs_spettanze_fornitore("quantita")+quantita_spettanze									end if									rs_spettanze_fornitore.update									rs_spettanze_fornitore.close									quantita_spettanze_caricate=quantita_spettanze_caricate+quantita_spettanze									'sql="insert into ordini_fornitori_dett_spettanze (iddett,iddip,quantita) values("&iddett_fornitori&","&rs_spettanze("iddip")&","&rs_spettanze("quantita")&");"									'response.write sql									'conn.execute (sql)									session("proc_ordina")=session("proc_ordina")&"Aggiunto spettanza iddip:"&rs_spettanze("iddip")&", quantita:"&rs_spettanze("quantita")&"<br>"									rs_spettanze.movenext								loop								set rs_spettanze = Nothing								Set rs_spettanze_fornitore = Nothing								conn.execute ("update ordini_fornitori set spettanze=1 where idord="&idord_fornitore)								session("proc_ordina")=session("proc_ordina")&"Impostato spettanze in ordini_fornitori<br> "							end if							'ordini_dett_ordini_fornitori_dett							Set ordini_dett_ordini_fornitori_dett = Server.CreateObject("ADODB.Recordset")							ordini_dett_ordini_fornitori_dett.open "select ordini_dett_ordini_fornitori_dett.* from ordini_dett_ordini_fornitori_dett where iddett_ordini="&dett_ordini("iddett")&" and iddett_fornitori="&idord_fornitore,conn,3,3							if ordini_dett_ordini_fornitori_dett.eof then								ordini_dett_ordini_fornitori_dett.addnew								ordini_dett_ordini_fornitori_dett("iddett_fornitori")=iddett_fornitori								ordini_dett_ordini_fornitori_dett("iddett_ordini")=dett_ordini("iddett")								quantita=clng(dett_ordini("quantita"))-clng(dett_ordini("quantita_magazzino"))								ordini_dett_ordini_fornitori_dett("quantita")=quantita								ordini_dett_ordini_fornitori_dett.update								session("proc_ordina")=session("proc_ordina")&"Creato legame in ordini_dett_ordini_fornitori_dett con quantita:"&quantita&"<br> "							else																						end if														ordini_dett_ordini_fornitori_dett.close							Set ordini_dett_ordini_fornitori_dett = Nothing																					session("proc_ordina")=session("proc_ordina")&"Impostato quantita_ordinato in ordini_dett:"&quantita&"<br> "							conn.execute("update ordini_dett set quantita_ordinato="&aggiusta_decimale(quantita,"sql")&" where iddett="&dett_ordini("iddett"))							session("proc_ordina")=session("proc_ordina")&" aggiunto articolo "&dett_ordini("codice_ordine")&"iddett:"&Get_last_id("ordini_fornitori_dett")&"<br> "							session("report")=session("report")&"Aggiunto articolo "&dett_ordini("codice_ordine")&" a [ordine_fornitore="&idord_fornitore&"]"&session("nord_fornitore")&"[/ordine_fornitore]<br>"							testo=""						else							session("proc_ordina")=session("proc_ordina")&" salto perchè già a magazzino articolo "&dett_ordini("codice_ordine")&"iddett:"&Get_last_id("ordini_fornitori_dett")&","						end if					END IF					set ordine= (new ClasseOrdine)(array("apri","ordini_fornitori",idord_fornitore))					n=ordine.CalcolaTotaleMerce(false)					set ordine= nothing									else					session("proc_ordina")=session("proc_ordina")&" non selezionato.<br>"									end if				dett_ordini.MoveNext			loop			set dett_ordini= nothing			set dett_fornitori = Nothing			sql="select * FROM ordini WHERE ordini.idord="& idord&";"			Set rs = Server.CreateObject("ADODB.Recordset")			rs.Open sql, conn, 3, 3			comunicazioni_precedenti= now()&" <b>"&session("nominativo")&"</b> ordinato articoli a fornitore:<br> "&session("report")			rs("comunicazioni_precedenti")=rs("comunicazioni_precedenti")&"<hr />"& comunicazioni_precedenti			rs.update			rs.close			Set rs = Nothing						add2log session("proc_ordina"),gravita			add2log "<b>"&session("nominativo")&"</b> Ordinati articoli a fornitore per [ordine="&idord&"]"&nord_cliente&"[/ordine]:<br>"&session("report"),2			'call aggiorna_ordine (idord_fornitore,"ordini_fornitori",true)			oper=""			cercain="niente"			idord=""			session("nord_fornitore")=""			Js("status")="success"			Js("message")="Ordini fornitori creati"		else			call add2log("Niente da ordinare",0)			Js("status")="success"			Js("message")="Niente da ordinare"		end if	'if stringa_iddett<>"" then	end if	if operazione="impegna_articoli" then			call add2log("Impegno",0)			quantita_massima=null			set magazzino = new classeMagazzino			call magazzino.impegna_per_ordine(idord)			set magazzino = Nothing		Js("status")="success"		Js("message")="Articoli impegnati per questo ordine"	end if	if operazione="sposta_articoli" then		'nuovo_ordine=sposta_articoli(idord,m_tabella)		'm_tabella="ordini"		set ordine= (new ClasseOrdine)(array("sposta_articoli",m_tabella,idord))				Js("status")="success"		Js("message")="Articoli spostati su nuovo ordine "&ordine.campo("nord")		set ordine = Nothing					end if	if operazione="copia_articoli" then		'nuovo_ordine=sposta_articoli(idord,m_tabella)		'm_tabella="ordini"		set ordine= (new ClasseOrdine)(array("copia_articoli",m_tabella,idord))				Js("status")="success"		Js("message")="Articoli copiati su nuovo ordine "&ordine.campo("nord")		set ordine = Nothing					end if			js.Flush	Session.Contents.remove("proc_ordina")	call connclose()	response.end	end ifdim colonna_fornitore, titolo_colonnacolonna_fornitore=falseselect case operazione	case "impegna_articoli"		titolo_colonna="impegna"			case "ordina_fornitore"		titolo_colonna="Ordinare"		colonna_fornitore=true	case "seleziona_articoli"		titolo_colonna=""		colonna_fornitore=false	end select%>        <form name="form_oper_artic" id="form_oper_artic" method="post" action="<%=questofile%>">		<input type="hidden" name="idord" value="<%=idord%>">		<input type="hidden" name="operazione" id="operazione_dialog" value="<%=operazione%>">		<input type="hidden" name="esegui" value="esegui">        <%	        m_modifica_articoli=true	        mostra_giacenze=true	    idord=request.form("idord")	    filtro=request.form("filtro")        sql="select ordini_dett.*, magazzino.quantita_magazzino,magazzino.idmag, magazzino.Data_arrivo, magazzino.quantita_riordino, magazzino.quantita_ordinata, varianti_a.variante_a, varianti_b.variante_b, prodotti.idfor, prodotti.codice FRom (((magazzino RIGHT JoIN ordini_dett oN (magazzino.idvarb = ordini_dett.idvarb) AND (magazzino.idvara = ordini_dett.idvara) AND (magazzino.idpro = ordini_dett.idpro)) LEFT JoIN varianti_b oN ordini_dett.idvarb = varianti_b.IDvarb) LEFT JoIN varianti_a oN ordini_dett.idvara = varianti_a.IDvara ) left join prodotti on  magazzino.idpro = prodotti.idpro where codice_ordine<>'' "        sql=replace(sql,"ordini",m_tabella)        	    if filtro="tutti" then		            elseif filtro="mancanti" then 	        sql=sql&" and quantita>(quantita_magazzino+quantita_ordinato) "        elseif filtro="selezionati" then         	sql=sql&" and iddett in("&request.form("selezionati")&") "        elseif filtro="disponibili" then         	sql=sql&" and quantita_magazzino>0 "        	        	        end if        sql=sql&" and idord="&idord &" order by ordine,iddett;"        if m_tabella="ordini" then	        spettanze=conn.execute("select spettanze from ordini where idord="&idord)(0)        end if                'response.write soloio(sql)        response.write soloio("operazione:"&request.form("operazione")&" filtro:"&filtro)%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">	      <tr style="border-bottom: 1px solid gray; background: #E5E5E5; font-size:11px;">		      <td>Codice		      </td>		      <td>Articolo		      </td>		      <%if colonna_fornitore then %>		      <td >Fornitore		      </td>		      <%end if %>		      <td align="center">Venduto		      </td>		      <td align="center">A magazzino		      </td>		      <%if titolo_colonna<>"" then %>  		      <td align="center"><%=titolo_colonna%>		      </td>		      <%end if %>	      </tr>	          <%		set rs=conn.execute(sql)		stringa_iddett=""		do while not rs.eof								selcs=""				ordinabile=true				stile=""				da_ordinare=0					  			  if stringa_iddett<>"" then stringa_iddett=stringa_iddett&", "				  stringa_iddett=stringa_iddett&rs("iddett")				if operazione="ordina_fornitore" then					if  rs("codice_ordine")<>"" then						if cdbl(rs("quantita"))>cdbl(rs("quantita_magazzino")) then stile=" color:red;"						if isnull(rs("quantita_magazzino") ) then							stile=" color:blue;"							ordinabile=false						else							da_ordinare=clng(rs("quantita"))-cdbl(rs("quantita_magazzino"))							if da_ordinare<0 then da_ordinare=0						end if						giacenza=CancellettoSeNull(rs("quantita_magazzino"))											else						giacenza=""					end if					if rs("idfor")=0 or isnull(rs("idfor")) then						ordinabile=false						testo_errore="Manca fornitore"						fornitore="<span class=""rosso"">Manca fornitore</span>"					else						fornitore=conn.execute("select utenti_intestazioni.azienda from utenti left join utenti_intestazioni on utenti.idintestazione = utenti_intestazioni.id where utenti.iduser="&rs("idfor"))(0)										end if					if  isnull(rs("codice")) then						ordinabile=false						testo_errore="Non in anagrafica"					end if				elseif operazione="impegna_articoli" then					if  rs("codice_ordine")<>"" then						if isnull(rs("quantita_magazzino") ) then							stile=" color:blue;"							ordinabile=false						else							da_impegnare=rs("quantita")-rs("quantita_scalato_magazzino")							if da_impegnare>rs("quantita_magazzino") then								da_impegnare=rs("quantita_magazzino")							end if																					end if						giacenza=CancellettoSeNull(rs("quantita_magazzino"))											else						giacenza=""					end if																end if									%>	          <tr valign="top" style="border-top: 1px solid black; padding-bottom:10px; padding-top:10px;">			      <td align="center" >              <%			txt="product.asp?idpro=" & RS("idpro")		%>              <b><a href="<%=txt%>" title="Clicca per le opzioni" class="menu_idpro" data-idmag="<%=RS("idmag")%>" data-idpro="<%=RS("idpro")%>"><%=RS("codice_ordine")%></a></b><%if utente_andrea then %><%=RS("idmag")%><%end if %>            </td>            <td >				<%=rs("articolo_ordine")%>	            <%if rs("varianti_ordine")<>"" then response.write "<br>"&rs("varianti_ordine")                    if spettanze=1 then			            call dettaglio_spettanze( m_tabella, rs("iddett"), rs("quantita"),true,"")		            end if	            %>	        </td>	        <%if colonna_fornitore then %>			<td >				<%=fornitore%>	        </td>	        <%end if %>                       <td align="center" valign="top" style="<%=stile%>"><%=rs("um")%>&nbsp;              <%=rs("quantita")%>              </td>            <td align="center" valign="middle" style="<%=stile%>">	            <%=giacenza%>              </td>              <%if titolo_colonna<>"" then %>            <td align="center" valign="middle" style="<%=stile%>">	            	            	        <%if operazione="ordina_fornitore"    then %>			<%if ordinabile then%>			  <input type="hidden" name="iddett<%=rs("iddett")%>" value="SI">              <input type="text" name="quantita<%=rs("iddett")%>" size="3" value="<%=da_ordinare%>" style="text-align:right;">			  <%				  if stringa_iddett<>"" then stringa_iddett=stringa_iddett&", "				  stringa_iddett=stringa_iddett&rs("iddett")			  else					response.write testo_errore				%>			  <%end if %>			  			  <%				  elseif operazione="impegna_articoli" then %>				  <%=da_impegnare%>				  <%elseif operazione="sposta_articoli" then 	  			  if stringa_iddett<>"" then stringa_iddett=stringa_iddett&", "				  stringa_iddett=stringa_iddett&rs("iddett")					  end i