<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()%><%'------------------------------------oper=request("oper")if request.form("elimina")<>"" then		sql="DELETE  FROM news WHERE idnews =" & request.form("id") & ";"	conn.execute(sql)	application("cache_banner_slider")=""	oper="list"end ifselect case lcase(oper)	case "annulla"		oper="list"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "salva modifiche"		oper="update"	case "list"	case else		oper="list"		if request.form("modifica")<>"" then oper="edit"		if request.form("elimina")<>"" then oper="edit"		if request.form("aggiungi")<>"" then oper="edit"end selectif oper="add" or oper="update" then	'controlliend ifif oper="add" or oper="update" then	Set rs = Server.CreateObject("ADODB.Recordset")	sql="select * from news"	if oper="add" then		rs.Open sql, conn, 3, 3		rs.addnew	else		sql= sql & " where idnews=" & request.form("id")		rs.Open sql, conn, 3, 3	end if	rs("tipo")="cb"	rs("titolo")=firstup(trim(request.form("titolo")))	imgurl=trim(request.form("ImmagineBrand"))	imgurl=replace(imgurl,"//","")	imgurl=mid(imgurl,instr(imgurl,"/"))	rs("testata")=imgurl	rs("testo")=request.form("testo")	if isnumeric(request.form("ordine")) then		ordine=cint(request.form("ordine"))	else 		ordine=0	end if	rs("ordine")=ordine		rs.update	rs.close	application("cache_banner_slider")=""	call riordina()	oper="list"end if//response.write oper%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!-- Stile: <%=Application("skins")%> --><!--#include virtual="/sub_head.asp" --><% if oper<>"list" then%><script Language="JavaScript"> var immagineok=false;annulla=false;function Validator(theForm) {if (annulla==true)  { 	return(true);      }   if (theForm.titolo.value == "")  {     alert("Inserisci un nome per il titolo banner.");     theForm.titolo.focus();     return (false);   } 	if (immagineok == false ) {		alert("L'immagine non è conforme");		return false;	}    return (true); } </script><%end if%><link href="Jquery/Js/fancyBox/jquery.fancybox.css" rel="stylesheet"></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->         <%barra=0%><div id="barra_fissa">	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Banner pagina category.asp</a></div> </div>         <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" <%if oper<>"list" then%> onSubmit="return Validator(this)"<%end if%> style="margin-top:0px;">		        <%sql="select * from news where tipo='cb' "if oper="list" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr align="right">               <td colspan="2" style="border-bottom:1px solid;"><a href="<%=questofile%>?oper=new"><strong>Aggiungi banner</strong></a></td>            </tr>            <tr>               <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Modifica&nbsp;</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Nome banner</td>            </tr>            <%	sql= sql & "ORDER BY ordine;"	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="modifica" value="<%=rs("idnews")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=rs("titolo")%></td>            </tr>            <%	rs.movenext	loop	rs.close	%>          </table>          <%elseid=request.form("modifica")if request.form("id")<>"" then id=request.form("id")	sql=sql & " and idnews =" & id	if oper="edit" then		set rs=conn.execute(sql)		testo= "Modifica banner"	else		testo= "Nuovo banner"	end if		  %>          <input type="hidden" name="id" value="<%=id%>">          <%if error<>"" then			  		descrizione=request.form("descrizione")			  	elseif oper="new" then			  		descrizione=""				end if%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header"><%response.write testo%></td>            </tr>            <tr>              <td align="right" valign="top">Nome banner</td>              <td><%if error<>"" then			  		testo=request.form("titolo")				elseif oper="edit" then					testo=rs("titolo")			  	elseif oper="new" then			  		testo=""				end if%>                  <input type="text" name="titolo" value="<%=testo%>" size="40">              </td>            </tr>            <tr>               <td align="right" valign="top">Immagine</td>              <td>  <%if error<>"" then			  		testo=request.form("testata")				elseif oper="edit" then					testo=rs("testata")			  	elseif oper="new" then			  		testo=""				end if%> <img src="<%=testo%>" <%if testo<>"" then %> style="display: hidden;"<%end if%> id="immagine" ><input type="hidden" name="ImmagineBrand" value="<%=testo%>" id="ImmagineBrand">   <span id="msg"></span> <br><input type="button" id="apriFileManager" value="Seleziona immagine"><br>				Dimensione immagine brand: 270px X 400px          </td>            </tr>            			<%if error<>"" then			  		val=request.form("testo")				elseif oper="edit" then					val=rs("testo")			  	elseif oper="new" then			  		val=""				end if%>            <tr>              <td align="right" valign="top">Collegamento</td>              <td><input type="text" name="testo" id="link" value="<%=val%>" size="40">Collega a settore              <%			  if instr(val,"idsettore=")>0 then				  val=estrainumero(val)			  else				  val=null			  end if			  %><select name="settore" id="settore" >              <option value="">Nessuno</option><%Set rsm=conn.execute("select * from settori where idpadre=0 "&where&" order by nome_settore ;")do while not rsm.eofresponse.write "<option value=""" & rsm("idsettore") &""""if int(val)=int(rsm("idsettore")) then response.write " selected"response.write ">" & rsm("nome_settore")& "</option>"call mappacatselezione(1,rsm("idsettore"),val,idsettore)rsm.movenextlooprsm.close%></select><script>$(function () {    $("#settore").on("change", function (e) {				//e.preventDefault();				var val=$("#settore").val();				if (val==""){					$("#link").val("");						}					else					{				$("#link").val("category.asp?idsettore="+val+"");						}	});});</script></td>            </tr>            <tr>              <td align="right" valign="top">Ordine di visualizzazione</td>              <td><%if error<>"" then			  		testo=request.form("ordine")				elseif oper="edit" then					testo=rs("ordine")			  	elseif oper="new" then			  		testo=-10				end if%>                  Posiziona dopo:                                    <select name="ordine" id="ordine" >              <option value="0">Inizio</option><%	              sql="select * from news where tipo='cb' "if oper="edit" then sql=sql&" and idnews<>"&id&" order by ordine ;"Set rsm=conn.execute(sql)do while not rsm.eofresponse.write "<option value=""" & rsm("ordine")+5 &""""if int(testo)=int(rsm("ordine")+10) then response.write " selected"response.write ">" & rsm("titolo")& "</option>"rsm.movenextlooprsm.closeset rsm= Nothing%></select>              </td>            </tr>            <tr>              <td colspan="2" align="center"> <%		if oper="list" then			txt=puls_new		elseif oper="new" or error<>"" then			txt="Aggiungi"		elseif oper="edit" then			txt="Salva modifiche"		end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"list" then%>    <input type="submit" name="oper" value="Annulla" onClick="annulla=true;">    <%end if%>    <%if oper="edit" and num=0 and error="" then%>    <input type="submit" name="elimina" value="Elimina">    <%end if%></td>            </tr>          </table>       <%if oper="edit" and false thenrs.close%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td class="ui-widget-header">Aggiungi articolo</td>            </tr>            <tr>               <td style="border-bottom:1px solid;">  Articolo da aggiungere                <input name="testo" type="text" style="font-size:16px; height: 22px; width:240px;" size="45" autocomplete=off onKeyUp="ajax_showOptions(this,'articolo',event)">         <input type="hidden" id="testo_hidden" name="idpro"><input type="hidden" name="aggiungi"> <input type="button" value="Aggiungi" onClick="Valida_aggiungi()"></td>            </tr>          </table><%sql="select articoli_consigliati_prodotti.*, prodotti.codice, prodotti.articolo "sql=sql &" FROM articoli_consigliati_prodotti INNER JOIN prodotti ON articoli_consigliati_prodotti.idpro = prodotti.IDpro WHERE (((articoli_consigliati_prodotti.id_pro_consigliati)="& id_pro_consigliati &")) "sql= sql & "ORDER BY codice;"'set rs=conn.execute(sql)rs.Open sql,conn,3,3%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header">Articoli visualizzati <%=rs.recordcount%></td>            </tr>            <tr>               <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Elimina&nbsp;</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Correlazioni</td>            </tr>            <%	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="elimina" value="<%=rs("id")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=rs("codice") & " " & rs("articolo")%></td>            </tr>            <%	rs.movenext	loop	rs.close	%>          </table>			<%end ifend ifset rs=nothingcall connclose()%>        </form>  <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><script src="Jquery/Js/fancyBox/jquery.fancybox.js"></script><script type="text/javascript" src="Jquery/js/jquery.validate.min.js"></script><script type="text/javascript" src="Jquery/js/jquery.validate.min_it.js"></script><script>jQuery(document).ready(function ($) {      $('#apriFileManager').click().fancybox({			  'width'	: 900,			  'height'	: 600,			  'type'	: 'iframe',			  'autoScale'   : false,			  'autoResize': false,			  'minHeight':600,			  'href':'filemanager123/dialog.php?type=1&field_id=ImmagineBrand&fldr=banner'      });});</script><script type="text/javascript" language="javascript">	function responsive_filemanager_callback(field_id){	console.log(field_id);	var url=jQuery('#'+field_id).val();	//alert('update '+field_id+" with "+url);	$("#immagine").attr("src", url);		$("#immagine").load(function(){		var w=270, h=400		$(this).removeAttr('width').removeAttr('height')		var actualHeight =$(this).height(),actualWidth=$(this).width()		$(this).attr({height:h,width:w}).data({height: actualHeight, width: actualWidth})		console.log(this.src,actualHeight,actualWidth)		var testo="";		if (actualWidth < (w-5) || actualWidth > (w+5)) {			testo="<br>La larghezza dell'immagine è di "+actualWidth+"pixel";			}		if (actualHeight < (h-5) || actualHeight > (h+5)) {			testo+="<br>L'altezza dell'immagine è di "+actualHeight+"pixel";			}		if (testo!=""){			testo+="<br><b>Immagine non conforme</b><br>Le dimensioni dell'immagine devono essere:<br>Larghezza: "+w+"pixel  Altezza: "+h+"pixel"			$("#msg").html(testo);			immagineok=false;					}		else		{				$("#msg").html("");				immagineok=true;		}				})				//your code}$(function() {	responsive_filemanager_callback("ImmagineBrand");});</script></body></html><%rsClosesub mappacatselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM settori WHERE idpadre = " & id &" and idsettore<>"&escludi&" order by nome_settore;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("idsettore") &""""		if int(val)=int(rs_order("idsettore")) then response.write " selected"		response.write ">" &spaceing& rs_order("nome_settore")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappacatselezione(layer+1,rs_order("idsettore"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	sub riordina()			sql="select * from news where tipo='cb'  order by ordine;"			rs.open sql, conn,3,3			ordine=10			do while not rs.eof			rs("ordine")=ordine			rs.update			ordine=ordine+10			rs.movenext			loop			rs.closeEnd Sub	%>