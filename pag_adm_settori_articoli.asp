<!--#include virtual="/setup.asp" --><!--#include file="JSON_latest.asp"--><!--#include virtual="/multidict_cl.asp" --><!--#include virtual="/jsonObject.class.asp" --><%dim mytimerSet mytimer = new c_mytimerif session("idadmin") = "" then call login()oper=lcase(request("oper"))select case oper	case "new"		oper="new"	case "modifica tutti"		oper="edit"		idcategoria=request.form("idcategoria")	case "esporta excel"		oper="edit"		response.redirect "pag_adm_articoli_mepa_excel.asp?id="&request.form("idcategoria")	case "anteprima"		'response.write "Anteprima"		dim n_prodotti,ordine,metodo		n_prodotti=0		id=request.form("id")		call add2log("Visualizzata anteprima "&nome_settore(id)&"("&id&")",0)				ordine=lcase(request.form("ordine_"&id))		metodo=cint(request.form("metodo_"&id))				stringa_idpro=prendi_prodotti(0, request.form("id"),"","")				if utente_andrea then response.write "id:"&id&" metodo:"&metodo&" ordine:"&ordine&"<br>"		response.write "<strong>Trovati "&n_prodotti&" articoli</strong><br>"		if stringa_idpro<>"" then			set rs=conn.execute ("select prodotti.* from prodotti where idpro  in("&stringa_idpro&")")			do while not rs.EOF				Response.write rs("codice")&" "&rs("articolo")&"<br>"									rs.MoveNext			loop			response.write "<input type=""hidden"" id=""stringa_idpro"" value="""&stringa_idpro&""">"			response.write "<input type=""hidden"" id=""id"" value="""&id&""">"			Response.write "<button type=""button"" id=""salva"">Salva questi articoli</button>"		else			Response.write "Nessun prodotto trovato."		end if		call connclose()		response.End	case "vedi"		id=request.form("id")				stringa_idpro=conn.execute("select idpro_virtuali from settori where idsettore="&id)(0)				if stringa_idpro<>"" then			set rs=conn.execute ("select prodotti.* from prodotti where idpro  in("&stringa_idpro&")")			do while not rs.EOF				Response.write rs("codice")&" "&rs("articolo")&"<br>"									rs.MoveNext			loop			response.write "<input type=""hidden"" id=""stringa_idpro"" value="""&stringa_idpro&""">"			response.write "<input type=""hidden"" id=""id"" value="""&id&""">"			Response.write "<button type=""button"" id=""salva"">Salva questi articoli</button>"		else			Response.write "Nessun prodotto trovato."		end if		call connclose()		response.End	case "elimina1"	'Elimina articoli		id=request.form("id")				conn.execute "delete from settori_prodotti where idsettore="&id,num		Set Js = jsObject()		js("success")=true		js("message")="Eliminati "&num& " articoli dal settore"		js.Flush		set js=Nothing		call add2log("Eliminati prodotti "&nome_settore(id)&"("&id&")",2)				call connclose()		Application.Lock		Application("cache_analisi_settori")=""		Application.Unlock		response.end	case "elimina2"		id=request.form("id")				conn.execute ("Update settori set idpro_virtuali='' where idsettore="&id)		Set Js = jsObject()		js("success")=true		js("message")="Eliminati articoli virtuali"		js.Flush		set js=Nothing		call add2log("Eliminati prodotti virtuali "&nome_settore(id)&"("&id&")",2)				call connclose()		Application.Lock		Application("cache_analisi_settori")=""		Application.Unlock		response.end	case "update"			call aggiorna_dati()		Set Js = jsObject()		js("success")=true		js("message")="dati aggiornati"		js.Flush		set js=Nothing		call connclose()		Application.Lock		Application("cache_analisi_settori")=""		Application.Unlock		response.end	case "salva"		id=request.form("id")				conn.execute ("Update settori set idpro_virtuali='"&request.form("stringa_idpro")&"' where idsettore="&id)		Set Js = jsObject()		js("success")=true		js("message")="dati aggiornati"		js.Flush		set js=Nothing		call add2log("Salvati prodotti virtuali "&nome_settore(id)&"("&id&")",2)				call connclose()		Application.Lock		Application("cache_analisi_settori")=""		Application.Unlock		response.end	case "analizza"		Application.Lock		Application("cache_analisi_settori")=""		Application.Unlock		oper="list"		case else		oper="list"end selectdim Js_settoriSet Js_settori = jsArray()tot_record=0tot_settori=0'http://www.w3schools.com/colors/colors_picker.aspgrayscale=split("#fff|#0099ff|#33adff|#66c2ff|#99d6ff|#ccebff|#e6f5ff","|")%><!--#include virtual="/sub_head_adm.asp" --><style>	/*	input  {    min-width: 30px;	}	*/</style><style>	/* Intestazione tabella in verticale */ th {  position: relative;  padding: 15px;}th span {  transform-origin: 0 50%;  transform: rotate(-90deg);   white-space: nowrap;   display: block;  position: absolute;  bottom: 0;  left: 50%;  text-align: left;}tr {	border-bottom:1px solid;}.div_icona {display: inline-block; float:right;}</style></head><body> <div id="wrap"><div id="header"><%=titolo_top%><div id="barra_fissa">  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Articoli nei settori</a></div></div>        <font color="#FF0000"><b><%=error%></b></font>                <%'if oper="list" then %>	<form id="form1" name="form1" method="post" action="<%=questofile%>" style="margin-top:0px;" >  	     <table width="100%" id="elenco" border="1" cellpadding="2" cellspacing="0" class="tabella1">		<tr><td>			<input type="submit" name="oper" value="Analizza"					</td></tr>	</table>	</form>	 	     <%	if Application("cache_analisi_settori")= "" then	'if true then		call analizzo_settori(0,0,"","")		mytimer.aggiungi("Ricalcolo")	end if	'response.write Application("cache_analisi_settori")&"<br>"	set JSON = New JSONobject	set JSONarr = New JSONarray	set JSONarr = JSON.Parse(Application("cache_analisi_settori"))    %>	<script>	$(function() {	    var header_height = 0;	    var header_height2 = 0;	    $('#tr_head2 span').each(function() {	        if ($(this).outerWidth() > header_height2) header_height2 = $(this).outerWidth();	    });	    $('#tr_head2').height(header_height2+15);	    	    	    $('#tr_head span').each(function() {	        if ($(this).outerWidth() > header_height) header_height = $(this).outerWidth();	    });	    $('#tr_head').height(header_height-header_height2);	    	    	});		</script><form  id="myform">    <table width="100%" id="elenco" border="1" cellpadding="2" cellspacing="0" class="tabella1" style="width: auto;">	    <thead>		    <tr id="tr_head">			    <th rowspan="2">Settore</th><th rowspan="2"><span>Articoli nel settore</span></th><th rowspan="2"><span>Settori nel settore</span></th><th rowspan="2"><span>Articoli nei<br>settori inferiori</span></th><th rowspan="2"><span>Settori con articoli<br>nei settori inferiori</span></th><th rowspan="2"><span>Prendi dai<br>settori inferiori</span></th><th rowspan="2"><span>Cedi ai <br>settori superiori</span></th><th rowspan="2"><span>Articoli virtuali</span></th><th colspan="2">Parametri</th>		    </tr>		    <tr id="tr_head2">			    <th><span>Metodo<br>selezione articoli</span></th><th>Parametri</th>		    </tr>	    </thead>	    <tbody>	    	    <%		    ' faster but less readable			for i = 0 to JSONarr.length - 1			        set item = JSONarr(i)						        	ids=item("id")	        			spaceing=""	        			lay=item("lay")						for MessageSpacing=1 to lay							spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"						next						if lay>5 then lay=5						if item("totp")=0 and item("tots")=0 then							bgcolor="red"						else							bgcolor=""						end if						if item("totps")>0 then parametri=true else parametri=false									        				        				        					        %>				        <tr id="ids_<%=ids%>" bgcolor="<%=grayscale(item("lay"))%>" data-lay="<%=item("lay")%>">					        <td>						        <%=spaceing&item("text")%>								<%								copie=item("copie")								if  copie>1 then response.write " <b> X"&copie&"</b>"								%>					        </td>					        <td align="right" bgcolor="<%=bgcolor%>">						        <span id="quanti_<%=ids%>"><%=item("totp")%></span>					        </td>					        <td align="right" bgcolor="<%=bgcolor%>">						        <%=item("tots")%>					        </td>					        <td align="right">						        <%=item("totps")%>					        </td>					        <td align="right">						        <%=item("totss")%>					        </td>					        <td align="center">						        <%if item("tots")>0 then %>						        <input type="checkbox" name="prendi_<%=ids%>" value="1" <%if item("prendi")=1 then response.write "checked" %>>						        <% end if %>					        </td>					        <td align="center">						        <%if item("lay")>0 then %>						        <input type="checkbox" name="cedi_<%=ids%>" value="1" <%if item("cedi")=1 then response.write "checked" %>>						        <%end if %>					        </td>					        <%if parametri then %>					        <td align="center">						        <%stringa_idpro=item("virtuali")							        							        val=len(stringa_idpro) - len(replace(stringa_idpro, ",", ""))%>						        <span id="quantiv_<%=ids%>"><%=val%></span>					        </td>					        <td nowrap="nowrap">						        <select name="metodo_<%=ids%>">							        <option value="1" >Top 5 Prezzo</option>							        <option value="2">Top 5 Ordine</option>							        <option value="3">Top 5 Casuale</option>						        </select>					        </td>					        <td nowrap="nowrap">						        						        <button type="button" class="anteprima">Anteprima</button><div class="div_icona"><span class="ui-icon ui-icon-triangle-1-s ui-corner-all left_menu bg-gray"  data-ordine=""></span></div>					        </td>					        <%else %>					        <td colspan="3"></td>					        					        <%end if %>					        				        </tr>				        <%			next		    %>	    </tbody>    </table></form>	<script>	$(function() {	    $(".anteprima").click(function(e){		   var id=$(this).closest("tr").attr("id").replace("ids_","");		   console.log("ids:"+id); 	        var dati="oper=anteprima&id="+id;	        console.log("dati_tabella: "+dati);			var dialog=$("#dialog").dialog();			dialog.html("Attendi...");								$.ajax({					url     : "pag_adm_settori_articoli.asp",					type    : "post",					cache	: false,					//dataType: 'json',					data	: dati,					success: function(data){						dialog.html(data);						dialog.dialog({							autoOpen: true,							modal: true,							resizable: false,							width: 600,							height: "auto",							title: "Anteprima articoli "						}); 					}					,error: function(xhr, textStatus, error){						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};						toastr.error('Errore nel caricamento della pagina');						var txt="";						txt+="Errore in "+location.href+"<br>";						txt+="<br>"+xhr.statusText;						txt+="<br>"+xhr.responseText;						txt+="<br>textStatus:"+textStatus;						txt+="<br>error:"+error;												$.ajax({							url     : "searcher.asp",							type    : "post",							data	: "txt_errore="+encodeURIComponent(txt)						});										}				});	   	    }); 	    	    $(document).on("click", "#salva", function(e){		   		   		var dati={			   		oper: "salva",			   		id: $("#id").val(),			   		stringa_idpro: $("#stringa_idpro").val()		   		}		      				$.ajax({					url     : "pag_adm_settori_articoli.asp",					type    : "post",					cache	: false,					dataType: 'json',					data	: dati,					success: function(data){						$("#dialog").dialog("close");											console.log("dati aggiornati");					}					,error: function(xhr, textStatus, error){						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};						toastr.error('Errore nel caricamento della pagina');						var txt="";						txt+="Errore in "+location.href+"<br>";						txt+="<br>"+xhr.statusText;						txt+="<br>"+xhr.responseText;						txt+="<br>textStatus:"+textStatus;						txt+="<br>error:"+error;												$.ajax({							url     : "searcher.asp",							type    : "post",							data	: "txt_errore="+encodeURIComponent(txt)						});										}				});		    });		//???????????????????????????????????????????????????????????????????????????????????		//Cosa è questa funzione?	checkAnyFormFieldEdited();	    	    	    $.widget("moogle.contextmenu3", $.moogle.contextmenu, {});// 2. Now we can bind this new widget to the same DOM element without//    destroying a previous widget.$(document).contextmenu3({		delegate: ".left_menu",		preventSelect: true,		apertura: "click",		taphold: true,		menu: [			{title: "Vedi articoli virtuali", cmd: "vedi", uiIcon: "ui-icon-pencil" },			{title: "----"},			{title: "Rimuovi articoli", cmd: "elimina1", uiIcon: "ui-icon-trash" },			{title: "Rimuovi articoli virtuali", cmd: "elimina2", uiIcon: "ui-icon-trash" }			],		select: function(event, ui) {			var $target = ui.target;			var id=$target.closest("tr").attr("id").replace("ids_","");			console.log("id:"+id);			switch(ui.cmd){			case "vedi":								var dati="oper=vedi&id="+id;				var dialog=$("#dialog").dialog();				dialog.html("Attendi...");				$.ajaxSetup({ cache: false });				$.ajax({					url     : "pag_adm_settori_articoli.asp",					type    : "post",					//dataType: 'json',					data	: dati,					success: function(data){						//alert(data.Message);												dialog.html(data);						dialog.dialog({							autoOpen: true,							modal: true,							resizable: false,							width: 600,							height: "auto",							title: "Articoli virtuali"						}); 					}					,error: function(xhr, textStatus, error){						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};						toastr.error('Errore nel caricamento della pagina');						console.log("xhr.statusText:"+xhr.statusText);						console.log("xhr.responseText:"+xhr.responseText);						console.log("textStatus:"+textStatus);						console.log("error:"+error);					}				});					break			case "elimina1":				var dati="oper=elimina1&id="+id;				   				$.ajax({					url     : "pag_adm_settori_articoli.asp",					type    : "post",					cache	: false,					dataType: 'json',					data	: dati,					success: function(data){											console.log(data.message);						$("#quanti_"+id).text("0");					}					,error: function(xhr, textStatus, error){						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};						toastr.error('Errore nel caricamento della pagina');						var txt="";						txt+="Errore in "+location.href+"<br>";						txt+="<br>"+xhr.statusText;						txt+="<br>"+xhr.responseText;						txt+="<br>textStatus:"+textStatus;						txt+="<br>error:"+error;												$.ajax({							url     : "searcher.asp",							type    : "post",							data	: "txt_errore="+encodeURIComponent(txt)						});										}				});					break			case "elimina2":				var dati="oper=elimina2&id="+id;   				$.ajax({					url     : "pag_adm_settori_articoli.asp",					type    : "post",					cache	: false,					dataType: 'json',					data	: dati,					success: function(data){											console.log(data.message);						$("#quantiv_"+id).text("0");					}					,error: function(xhr, textStatus, error){						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};						toastr.error('Errore nel caricamento della pagina');						var txt="";						txt+="Errore in "+location.href+"<br>";						txt+="<br>"+xhr.statusText;						txt+="<br>"+xhr.responseText;						txt+="<br>textStatus:"+textStatus;						txt+="<br>error:"+error;												$.ajax({							url     : "searcher.asp",							type    : "post",							data	: "txt_errore="+encodeURIComponent(txt)						});										}				});					break			}		},		// Implement the beforeOpen callback to dynamically change the entries		beforeOpen: function(event, ui) {			var $menu = ui.menu,				$target = ui.target;					//				.contextmenu("replaceMenu", [{title: "aaa"}, {title: "bbb"}])		//				.contextmenu("replaceMenu", "#options2")		//				.contextmenu("setEntry", "cut", {title: "Cuty", uiIcon: "ui-icon-heart", disabled: true})		// Optionally return false, to prevent opening the menu now		}	});		});			function enableSaveBtn(obj){		var objrow=$(obj).closest("tr");		var id=$(objrow).attr("id").replace("ids_","");            var dati={};            	            dati["oper"]="update";	            dati["id"]=id;	            $(objrow).find('input,select,textarea').each(function(){					var name=$(this).attr('name');					console.log(name);		            if ($(this).is(':checkbox')){									            if ($(this).is(":checked")){			                var val=1;}			            else{			                var val=0;			            }						$("input[name='"+name+"']").each(function(){						if (val==1){								$(this).prop("checked",true);							}else							{								$(this).prop("checked",false);							}							console.log("trovato imposto"+val);						});												dati[$(this).attr('name')]=val;								            }else{						var val=$(this).val();						$("input[name='"+name+"']").each(function(){							$(this).val(val);						});														                dati[$(this).attr('name')]=val;														            }	                	            });												console.log(dati);						$.ajax({					url     : "pag_adm_settori_articoli.asp",					type    : "post",					cache	: false,					dataType: 'json',					data	: dati,					success: function(data){						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "1000","extendedTimeOut": "0", "closeButton": true};						toastr.info('Dati aggiornati');						console.log("dati aggiornati ");											}					,error: function(xhr, textStatus, error){						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};						toastr.error('Errore nel caricamento della pagina');						var txt="";						txt+="Errore in "+location.href+"<br>";						txt+="<br>"+xhr.statusText;						txt+="<br>"+xhr.responseText;						txt+="<br>textStatus:"+textStatus;						txt+="<br>error:"+error;												$.ajax({							url     : "searcher.asp",							type    : "post",							data	: "txt_errore="+encodeURIComponent(txt)						});										}				});						}				</script>	<%'=Js_settori.jsstring%>		       <!-- Div Content FINE--></div><div id="footer"></div><%  	call connclose()	%>	<%%><div id="footer"><%mytimer.visualizza()%></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%sub analizzo_settori(layer,id,testo,testo_dopo)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	sql_order="select settori.idsettore, settori.nome_settore, settori.nascondi_prezzi, settori.cedi_prodotti, settori.prendi_prodotti, settori_settori.idpadre, settori.metodo, settori.idpro_virtuali from settori_settori inner join settori on settori_settori.idfiglio = settori.idsettore where nascondi=0 and settori_settori.idpadre="&id&" order by settori_settori.ordine"	'response.write sql_order	if layer=0 then testo=testo&"<ol class=""sortable"">"	set rs_order=conn.execute(sql_order)	nodo=true	testo=testo&testo_dopo	testo_dopo=""	if not 	rs_order.eof then 		if layer>0 then testo=testo& "<ol>"	else		nodo=false	end if	do until rs_order.eof							conteggiodiidpro=clng(conn.execute("select count(*) from settori_prodotti where idsettore="&rs_order("idsettore"))(0))		conteggiosubsettori=clng(conn.execute("select count(*) from settori_settori where idpadre="&rs_order("idsettore"))(0))		if conteggiodiidpro=0 and conteggiosubsettori=0 then			vuoto=1		else			vuoto=0		end if							tot_record=0		tot_settori=0		call analisi_prodotti_virtuali(rs_order("idsettore"))				Set Js_settori(Null) = jsObject()		Js_settori(null)("id")=rs_order("idsettore")		Js_settori(null)("text")=rs_order("nome_settore")		Js_settori(null)("idp")=rs_order("idpadre")		Js_settori(null)("totp")=conteggiodiidpro		Js_settori(null)("tots")=conteggiosubsettori		Js_settori(null)("lay")=layer		Js_settori(null)("totss")=tot_settori		Js_settori(null)("totps")=tot_record		Js_settori(null)("v")=vuoto		Js_settori(null)("cedi")=rs_order("cedi_prodotti")		Js_settori(null)("prendi")=rs_order("prendi_prodotti")		Js_settori(null)("me")=rs_order("metodo")		Js_settori(null)("virtuali")=rs_order("idpro_virtuali")		Js_settori(null)("copie")=clng(conn.execute("select count(*) from settori_settori where idfiglio="&rs_order("idsettore"))(0))												'calling again to find more childs - if not rs_order=nothing	    call analizzo_settori(layer+1,rs_order("idsettore"),testo,testo_dopo)	'testo=testo& "</li>"&vbcrlf		rs_order.movenext	loop		'closing object	rs_order.close	set rs_order=nothing	if layer=0 then		response.write "Analisi eseguita<br>"		'response.write testo		Application.Lock		Application("cache_analisi_settori")= Js_settori.jsString		Application.Unlock	end ifEnd Sub	sub analisi_prodotti_virtuali(idsettore)	dim stringa_tmp, result	set rs = conn.execute("select settori_settori.idfiglio from settori_settori where idpadre="&idsettore)	do while not rs.EOF	'Ciclo su settori		sql="select count(*) from prodotti inner join settori_prodotti on prodotti.idpro= settori_prodotti.idpro where settori_prodotti.idsettore="&rs("idfiglio")		numrec=clng(conn.execute(sql)(0))		if numrec>0 then			tot_settori=tot_settori+1		end if		tot_record=tot_record+numrec						call analisi_prodotti_virtuali(rs("idfiglio")) 		rs.MoveNext	loopend subsub aggiorna_dati()	idsettore=request.form("id")	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open "select settori.* from settori where idsettore="&idsettore, conn, 3, 3	val=request.form("cedi_"&idsettore)	if val="" then val=0	rs("cedi_prodotti")=val		val=request.form("prendi_"&idsettore)	if val="" then val=0	rs("prendi_prodotti")=val	val=request.form("metodo_"&idsettore)	if val="" then val=0	rs("metodo")=val	rs.update	rs.close	set rs = nothing	call add2log("aggiorna dati:"&queryeform(),0)end subsub prendi_prodotti(layer,id,testo,testo_dopo)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")		sql_order="select settori.idsettore, settori.nome_settore, settori.nascondi_prezzi, settori.cedi_prodotti, settori.prendi_prodotti, settori_settori.idpadre from settori_settori inner join settori on settori_settori.idfiglio = settori.idsettore where settori_settori.idpadre="&id&" order by settori_settori.ordine"	'response.write sql_order	if layer=0 then testo=testo&"<ol class=""sortable"">"	rs_order.open sql_order,conn	nodo=true	testo=testo&testo_dopo	testo_dopo=""	if not 	rs_order.eof then 		if layer>0 then testo=testo& "<ol>"	else		nodo=false	end if	do until rs_order.eof				testo_tmp=conn.execute("select GROUP_CONCAT(idpro SEPARATOR ',') from settori_prodotti  where idsettore="&rs_order("idsettore"))(0)		if not isnull(testo_tmp) then			if testo<>"" then				testo=testo&","&testo_tmp			else				testo=testo_tmp			end if		end if					conteggiodiidpro=clng(conn.execute("select count(*) from settori_prodotti where idsettore="&rs_order("idsettore"))(0))		conteggiosubsettori=clng(conn.execute("select count(*) from settori_settori where idpadre="&rs_order("idsettore"))(0))				if conteggiodiidpro=0 and conteggiosubsettori=0 then			vuoto=1		else			vuoto=0		end if							tot_record=0		tot_settori=0		call analisi_prodotti_virtuali(rs_order("idsettore"))														'calling again to find more childs - if not rs_order=nothing	    call prendi_prodotti(layer+1,rs_order("idsettore"),testo,testo_dopo)	'testo=testo& "</li>"&vbcrlf		rs_order.movenext	loop		'closing object	rs_order.close	set rs_order=nothing	if layer=0 then		response.write testo	end ifEnd Sub	function prendi_prodotti(layer,id,testo,testo_dopo)	'declaring	dim sql_order,sql	'create recordset	set rs_order=server.createObject("adodb.recordset")		sql_order="select settori.idsettore, settori.nome_settore, settori.nascondi_prezzi, settori.cedi_prodotti, settori.prendi_prodotti, settori_settori.idpadre from settori_settori inner join settori on settori_settori.idfiglio = settori.idsettore where cedi_prodotti=1 and settori_settori.idpadre="&id&" order by settori_settori.ordine"	'response.write sql_order	rs_order.open sql_order,conn	do until rs_order.eof		testo_tmp=""		sql="select prodotti.idpro from prodotti inner join settori_prodotti on prodotti.idpro = settori_prodotti.idpro where idsettore="&rs_order("idsettore")		if metodo=1 then			sql=sql&" order by prezzo desc"		elseif metodo=2 then			sql=sql&" order by settori_prodotti.ordine"		end if		sql=sql&" limit 5"		set prodotti=conn.execute(sql)		do while not prodotti.eof			if testo_tmp<>"" then testo_tmp=testo_tmp&","			testo_tmp=testo_tmp&prodotti(0)			n_prodotti=n_prodotti+1			prodotti.movenext		loop		if not isnull(testo_tmp) and testo_tmp<>"" then			if testo="" then				testo=testo_tmp			else				testo=testo&","&testo_tmp			end if		end if				'conteggiodiidpro=clng(conn.execute("select count(*) from settori_prodotti where idsettore="&rs_order("idsettore"))(0))		'conteggiosubsettori=clng(conn.execute("select count(*) from settori_settori where idpadre="&rs_order("idsettore"))(0))									'call analisi_prodotti_virtuali(rs_order("idsettore"))														'calling again to find more childs - if not rs_order=nothing	    n= prendi_prodotti(layer+1,rs_order("idsettore"),testo,testo_dopo)	'testo=testo& "</li>"&vbcrlf		rs_order.movenext	loop		'closing object	rs_order.close	set rs_order=nothing	prendi_prodotti=testoEnd function	function nome_settore(id)	nome_settore=conn.execute ("select nome_settore from settori where idsettore="&id)(0)end function	%>