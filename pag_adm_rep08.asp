<%'Verifica chiusure 01_12_2015%><!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()mese=request.form("mese")anno=request.form("anno")if anno="" then	mese="0"	anno=year(date())else	anno=request.form("anno")end ifidpro=request("idpro")dettaglio=falseif request("dettaglio")<>"" then	dettaglio=trueelse	dettaglio=falseend if%><!--#include virtual="/sub_head_adm.asp" --></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->         <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Totale venduto articolo</a></div>        <%if request("idpro")<>"" then%>        <%		if dettaglio=true then		  sql="select ordini_dett.idpro, ordini_dett.var1, ordini_dett.var2, Count(ordini_dett.quantita) AS ConteggioDiquantita, Sum(ordini_dett.quantita) AS SommaDiquantita, Year(data) AS anno, Month(data) AS mese, ordini_dett.codice_ordine, ordini_dett.articolo_ordine, ordini.verde FROM ordini_dett INNER JOIN ordini ON ordini_dett.idord = ordini.idord where ordini.stato=6 and ordini.eliminato=0 GROUP BY ordini_dett.idpro, ordini_dett.var1, ordini_dett.var2, Year(data), Month(data), ordini_dett.codice_ordine, ordini_dett.articolo_ordine HAVING (((ordini_dett.idpro)="&request("idpro")&")) ORDER BY Year(data) DESC , Month(data) DESC;"		  else		  sql="select ordini_dett.idpro, ordini_dett.var1, ordini_dett.var2, Count(ordini_dett.quantita) AS ConteggioDiquantita, Sum(ordini_dett.quantita) AS SommaDiquantita, ordini_dett.codice_ordine, ordini_dett.articolo_ordine, Year(data) AS Anno, ordini.verde FROM ordini_dett INNER JOIN ordini ON ordini_dett.idord = ordini.idord  where ordini.stato=6 and  ordini.eliminato=0 GROUP BY ordini_dett.idpro, ordini_dett.var1, ordini_dett.var2, ordini_dett.codice_ordine, ordini_dett.articolo_ordine, Year(data) HAVING (((ordini_dett.idpro)="&request("idpro")&")) ORDER BY Year(data) DESC "		  end if%>		  		                    <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="6" class="ui-widget-header"><a href="<%=questofile%>?idpro=<%=idpro%>&dettaglio=si">Vedi ordini</a></td>          </tr>          <tr>            <td align="center" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Mese</td>            <td align="center" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Anno</td>            <td align="center" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Variante</td>            <td align="center" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Variante</td>            <td align="center" bgcolor="#E5E5E5" style="border-bottom:1px solid;">n&deg; ordini</td>            <td align="center" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Quantit&agrave;</td>          </tr>		<%			set rs=conn.execute(sql)			do while not rs.eof		if rs("verde")= 1 then			colore="bgcolor='#99FF99'"		else			colore=""		end if%>          <tr <%=colore%>>            <td align="center" style="border-bottom:1px solid;"><%if dettaglio then%><%=rs("mese")%><%end if%></td>             <td align="center" style="border-bottom:1px solid;"><%=rs("anno")%></td>            <td align="center" class="corpobox" style="border-bottom:1px solid;"><%=rs("var1")%></td>            <td align="center" class="corpobox" style="border-bottom:1px solid;"><%=rs("var2")%></td>            <td align="center" class="corpobox" style="border-bottom:1px solid;"><%=rs("conteggioDiquantita")%></td>            <td align="center" class="corpobox" style="border-bottom:1px solid;"><%=rs("SommaDiquantita")%></td>          </tr>        <% 			  if dettaglio=true then		  sql_ordini="select Month(data) AS mese, Year(data) AS anno, ordini.idord, ordini.Azienda, ordini.data, ordini.nord FROM ordini INNER JOIN ordini_dett ON ordini.idord = ordini_dett.idord GROUP BY ordini_dett.idpro, Month(data), Year(data), ordini.idord, ordini.Azienda HAVING (((ordini_dett.idpro)="&request("idpro")&") AND ((Month(data))="&rs("mese")&") AND ((Year(data))="&rs("anno")&")); "		  		 ' sql_ordini="select ordini.*, ordini_dett.idpro, Month(data) AS mese, Year(data) AS anno FROM ordini INNER JOIN ordini_dett ON ordini.idord = ordini_dett.idord WHERE (((ordini_dett.idpro)="&request("idpro")&") AND ((Month(data))="&rs("mese")&") AND ((Year(data))="&rs("anno")&")); "		  'response.Write(sql_ordini)		  set rs_ordini=conn.execute(sql_ordini)		  %>		   <tr>            <td colspan="6" style="border-bottom:1px solid;" >						<%do while not rs_ordini.eof%>			<a href="pag_adm_ordini.asp?idord=<%=rs_ordini("idord")%>">			Ordine <%=rs_ordini("nord")&"/"&rs_ordini("anno")%></a>&nbsp;  <%=rs_ordini("azienda")%><br>            <%			  	rs_ordini.movenext			loop			rs_ordini.close			end if			%>                        </td>           </tr>                    <%					rs.movenext			loop			set rs_ordini = Nothing			Set rs = Nothing	%>        </table>        <%end if	        	        			call connclose()        %>        <!-- FINE BLOCCO CENTRALE -->        <!-- Colonna CORPO FINE-->        <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>