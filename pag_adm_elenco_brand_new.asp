<!--#include virtual="/setup.asp" --><%meta_title=traduci("logintxt")dim rs_editid=request("id")oper=lcase(request("oper"))if oper="elimina" then		conn.execute("delete FROM brand WHERE id=" & id)		add2log "Eliminato brand id "&request.form("id")&" da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",3		oper="list"		id=""end ifif oper="add" or oper="update" then	sqlbase="select news.* from news "	Set rs = Server.CreateObject("ADODB.Recordset")	if oper="add" then		rs.Open sqlbase, conn, 3, 3		rs.addnew		operazione="Aggiunto"		rs("tipo")="pagina"	else		sql= sqlbase & " where id=" & id		rs.Open sql, conn, 3, 3		operazione="Modificato"	end if	if trim(request.form("data"))<>"" then rs("data")=trim(request.form("data"))	rs("titolo")=firstup(trim(request.form("titolo")))	rs("titolo_en")=firstup(trim(request.form("titolo_en")))	rs("testo")=trim(request.form("testo"))	rs("testo_en")=trim(request.form("testo_en"))	if request.form("visualizza")<>"" then		rs("visualizza")=true	else		rs("visualizza")=false	end if	rs("tipo")="pagina"	rs.update	add2log operazione&" contenuto "&rs("titolo")&" da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",3	rs.close	call riordina (trim(request.form("tipo")))	oper="list"	id=""	'response.redirect Request.ServerVariables("Script_Name")end ifif isnumeric(id) and id<>"" and oper="" then oper="edit"select case oper	case "annulla"		oper="view"	case "new"		IconaPuls="fa-list"		LinkPuls="oper=list"	case "edit"		IconaPuls="fa-list"		LinkPuls="oper=list"		TitlePuls="Visualizza lista"	case else		oper="list"		IconaPuls="fa-plus"		LinkPuls="oper=new"		TitlePuls="Aggiungi nuovo"end selectcss_form=trueselect2=true%><!--#include virtual="/config/header_inc.asp" -->        <section id="content">        	<div id="breadcrumb-container">        		<div class="container">					<ul class="breadcrumb">						<li><a href="/">Home</a></li>						<li class="active" href="<%=questofile%>">Pagine</li>					</ul>        		</div>        	</div>        	<div class="container">	        	<div class="row">		        	<div class="col-md-12">		        		<header class="content-title">							<h1 class="title">Brand								<span class="pull-right">								<%if oper="list" then%>								  <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-expanded="false">								    Filtro <span class="caret"></span>								  </button>								  <ul class="dropdown-menu" role="menu">								    <li><a href="<%=questofile%>?tipo=pagina">Pagine</a></li>								    <li><a href="#">...</a></li>								    <li><a href="#">...</a></li>								    <li class="divider"></li>								    <li><a href="#">...</a></li>								  </ul>								  <%end if%>								<a href="<%=questofile%>?<%=LinkPuls%>" title="<%=TitlePuls%>" class="btn btn-info"><i class="fa <%=IconaPuls%> fa-lg"></i></a>								</span>							</h1>						</header>		        	</div>	        	</div>        		<%if oper="list" then%>				<form action="<%=questofile%>" method="post" id="form-2">				<%		       	sql="select  * FROM traduzioni where pagina='index.asp' and chiave='brands_slider'"				set rs=conn.execute(sql)				if not rs.eof then					valore=rs("valore")					valore_en=rs("valore_en")				end if				rs.close		        		        %>        		<div class="row">	        		<div class="col-md-4">		        					        		<div class="input-group">								<span class="input-group-addon"><span class="input-text">Titolo sezione</span><span style="display: inline-block; vertical-align: middle;"><img src="images/it.png"/></span></span>								<input type="text"  class="form-control input-lg" placeholder="Titolo della pagina" name="titolo" value="<%=valore%>">							</div><!-- End .input-group -->	        		</div>                    <div class="col-md-4">			        		<div class="input-group">								<span class="input-group-addon"><span class="input-text">Titolo sezione</span><span style="display: inline-block; vertical-align: middle;"><img src="images/en.png"/></span></span>								<input type="text"  class="form-control input-lg" placeholder="Titolo della pagina" name="titolo" value="<%=valore_en%>">							</div><!-- End .input-group -->                    </div>                    <div class="col-md-4">	                    <button type="submit" class="btn btn-success btn-sm">Aggiorna titoli</button>                    </div>	        		        		</div>				</form>        		<div class="row">					<table class="table checkout-table" >						<thead>							<tr>								<th class="table-title" style="width: 100px;"></th>								<th class="table-title">Nome brand</th>								<th class="table-title">Immagine</th>								<th class="table-title">Link</th>							</tr>						</thead>													<tbody>						<%													sql="select * from brand "						sql= sql & "ORDER BY NomeBrand;"						Set rs_list=conn.Execute(sql)						do while not rs_list.EOF						%>							<tr>								<td class=""><a href="<%=questofile%>?id=<%=rs_list("id")%>" class="btn btn-info btn-sm" ><i class="fa fa-pencil fa-lg"></i></a></td>								<td class=""><span class="pull-left"><%=rs_list("NomeBrand")%></span></td>								<td class=""><%if rs_list("ImmagineBrand")<>"" then%><img src="<%=rs_list("ImmagineBrand")%>"><%end if%></td>								<td class=""><%=rs_list("link")%></td>							</tr>							<%							rs_list.MoveNext							loop							%>						</tbody>					</table>        						</div><!-- End .row -->				<%end if%>				<%if oper="edit" or oper="new" then																		if oper="edit" then			'response.write "OPER:" & oper			sql="select brand.* from brand  where id =" & id			set rs_edit=conn.execute(sql)			if rs_edit.eof then NonTrovato=true		end if		if NonTrovato then %>					Non trovato		<% 		else		dim ValoreCampo			%>						<form action="<%=questofile%>" method="post" id="form">				<input type="hidden" name="id" value="<%=id%>">          		<%if error<>"" then			  		ValoreCampo=request.form("NomeBrand")				elseif oper="edit" then					ValoreCampo=rs_edit("NomeBrand")			  	elseif oper="new" then			  		ValoreCampo=""				end if%>				<div class="input-group">					<span class="input-group-addon"><span class="input-text">Nome brand</span></span>					<input type="text"  class="form-control input-lg col-md-4" placeholder="Nome del brand" name="NomeBrand" value="<%=ValoreCampo%>">				</div><!-- End .input-group -->																	                                        	                                                  		<%if error<>"" then			  		ValoreCampo=request.form("ImmagineBrand")				elseif oper="edit" then					ValoreCampo=rs_edit("ImmagineBrand")			  	elseif oper="new" then			  		ValoreCampo=""				end if%>				<div class="input-group">					<span class="input-group-addon" style="height: 110px;"><span class="input-text">Immagine</span></span>					<span class="form-control" style="height: 110px; vertical-align: middle; ">					 <span style="float: left;"><img src="<%=ValoreCampo%>" <%if ValoreCampo<>"" then %> style="display: hidden;"<%end if%> id="immagine"  ></span>					<span style="float: left;"><a href="#" class="btn btn-info btn-sm" id="apriFileManager">Seleziona immagine</a></span></span>				</div><!-- End .input-group -->                                                                                				<%if error<>"" then			  		ValoreCampo=request.form("in_home")				elseif oper="edit" then					ValoreCampo=rs_edit("in_home")			  	elseif oper="new" then			  		ValoreCampo=true				end if				if ValoreCampo then					ValoreCampo="checked" 				else 					ValoreCampo=""				end if				%>                <div class="input-group">					<span class="input-group-addon" style="height: 48px;"><span class="input-text">Visualizza in Home</span></span><span class="form-control" style="height: 48px;">					<input type="checkbox" data-on-color="success" data-on-text="Si" data-off-text="No" name="in_home" class="switch" <%=ValoreCampo%>></span>				</div><!-- End .input-group -->								<%if error<>"" then			  		ValoreCampo=request.form("link")				elseif oper="edit" then					ValoreCampo=rs_edit("link")			  	elseif oper="new" then			  		ValoreCampo=""				end if%>				<div class="input-group">					<span class="input-group-addon"><span class="input-text">Link</span></span>					<input type="text"  class="form-control input-lg col-md-4" placeholder="Collegamento web" name="link" id="link" value="<%=ValoreCampo%>">				</div><!-- End .input-group -->												<div class="input-group select2-bootstrap-prepend">					<span class="input-group-addon"><span class="input-text">Collega a settore</span></span>				                    <select id="settore" class="select2 form-control input-lg">                        <option value="">Nessuno</option><%						Set rsm=conn.execute("select * from settori where idpadre=0 "&where&" order by nome_settore ;")						do while not rsm.eof						response.write "<option value=""" & rsm("idsettore") &""""						if int(val)=int(rsm("idsettore")) then response.write " selected"						response.write ">" & rsm("nome_settore")& "</option>"						call mappacatselezione(1,rsm("idsettore"),val,idsettore)						rsm.movenext						loop						rsm.close						%>                    </select>				</div><!-- End .input-group -->				                                				<div class="input-group select2-bootstrap-prepend">					<span class="input-group-addon"><span class="input-text">Posizione</span></span>				                    <select name="ordine" id="ordine" class="select2 form-control input-lg">                        <option value="0">Inizio</option><%			              sql="select * from brand"						if oper="edit" then sql=sql&" where id<>"&id&" order by ordine ;"						Set rsm=conn.execute(sql)						do while not rsm.eof						response.write "<option value=""" & rsm("ordine")+5 &""""						if int(testo)=int(rsm("ordine")+10) then response.write " selected"						response.write ">Dopo " & rsm("nomebrand")& "</option>"						rsm.movenext						loop						rsm.close						%>                    </select>				</div><!-- End .input-group -->																				<%					dim TestoPulsante					dim OperPulsante					if oper="new" then						TestoPulsante="Aggiungi"						OperPulsante="add"					elseif oper="edit" then						TestoPulsante="Salva modifiche"						OperPulsante="update"										end if									%>				<div class="row pull-right">				<input type="hidden" name="oper" value="<%=OperPulsante%>" id="oper"><button type="button" class="btn btn-success" id="invia"><%=TestoPulsante%></button>&nbsp; <button type="button" class="btn btn-danger btn-sm" id="elimina"><i class="fa fa-trash-o fa-lg"></i></button>         		</div><!-- End .row -->               				</form>				<div id="myModalmm" class="modal fade" tabindex="-1" role="dialog">					<div class="modal-header">						<button type="button" class="close" data-dismiss="modal">×</button>							<h3>Dialog</h3>					</div>					<div class="modal-body">				      prova					</div>					<div class="modal-footer">						<button class="btn" data-dismiss="modal">OK</button>					</div>				</div>				<div class="modal fade" id="myModal" aria-hidden="true" style="display: none;"><div class="modal-dialog" style="width: 900px; height: 600px;">  <div class="modal-content">    <div class="modal-header">	          <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>      <h4 class="modal-title">Seleziona immagine</h4>    </div>    <div class="modal-body">      <iframe width="100%" height="600px;" src="filemanager123/dialog.php" frameborder="0" style="overflow: scroll; overflow-x: hidden; overflow-y: scroll; "></iframe>    </div>  </div><!-- /.modal-content --></div><!-- /.modal-dialog --></div>											<%end if 'non trovato %>											<%end if%>								   			</div><!-- End .container -->                </section><!-- End #content -->	<!--#include virtual="/footer_inc.asp" -->    <!-- END -->		<script src="Jquery/js/select2/select2.min.js"></script>	        		<script src="Jquery/js/select2/select2_locale_it.js"></script>	<!--#include virtual="/script_inc.asp" -->	<!--#include virtual="/tinymce4_conf4.asp" -->	<script src="Jquery/Js/fancyBox/jquery.fancybox.js"></script>	<script src="js/Jqueryvalidate/jquery.validate.min.js"></script>	<script src="js/Jqueryvalidate/localization/messages_it.min.js"></script>	<script type="text/javascript" language="javascript">		function responsive_filemanager_callback(field_id){		console.log(field_id);		var url=jQuery('#'+field_id).val();		//alert('update '+field_id+" with "+url);		$("#immagine").attr("src", url);				$("#immagine").load(function(){			var h=100,w=170			$(this).removeAttr('width').removeAttr('height')			var actualHeight =$(this).height(),actualWidth=$(this).width()			$(this).attr({height:h,width:w}).data({height: actualHeight, width: actualWidth})			console.log(this.src,actualHeight,actualWidth)			var testo="";			if (actualWidth < 165 || actualWidth > 175) {				testo="<br>La larghezza dell'immagine è di "+actualWidth+"pixel";				}			if (actualHeight < 98 || actualHeight > 101) {				testo+="<br>L'altezza dell'immagine è di "+actualHeight+"pixel";				}			if (testo!=""){				testo+="<br><b>Immagine non conforme</b><br>Le dimensioni dell'immagine devono essere:<br>Larghezza: 170pixel  Altezza: 100pixel"				$("#msg").html(testo);				immagineok=false;							}			else			{					$("#msg").html("");					immagineok=true;				}					})						//your code	}	$(function() {		responsive_filemanager_callback("ImmagineBrand");	});</script>	<script>		$(function() {									$('#apriFileManager').click(function(){			    $('#myModal').on('show', function () {			        $('#iframe').attr("src","blog.html");			        //$('#iframe').attr("src",'filemanager123/dialog.php?type=1&field_id=ImmagineBrand&fldr=brands');			      				});			    $('#myModal').modal({show:true})			});												$("#elimina").click(function(){				$("#oper").val("elimina");				$("#form").submit();			});			$("#invia").click(function(){				$("#form").submit();			});			$('.select2').select2({		  		allowClear: true		  	});					  	$("#settore").on('select2-selecting', function(e) {				//e.preventDefault();				var val=e.object.id;				if (val==""){					$("#link").val("");						}					else					{				$("#link").val("category.asp?idsettore="+val+"");						}			});																			});	</script>    </body></html><%	sub mappacatselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM settori WHERE idpadre = " & id &" and idsettore<>"&escludi&" order by nome_settore;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("idsettore") &""""		if int(val)=int(rs_order("idsettore")) then response.write " selected"		response.write ">" &spaceing& rs_order("nome_settore")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappacatselezione(layer+1,rs_order("idsettore"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub						%>