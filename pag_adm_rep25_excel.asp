<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()da=request("da")a=request("a")ordina=request("ordina")if ordina="" then ordina="r"if not tdebug then	Response.ContentType = "application/vnd.ms-excel"	Response.AddHeader "content-disposition", "attachment; filename=Ricarico_articoli.xls"else	Response.ContentType = "text/html"end ifsql="select prodotti.IDpro, prodotti.codice, prodotti.articolo, varianti_a.variante_a, varianti_b.variante_b, prodotti.prezzo, prodotti.costo, prodotti.data_agg_costo, magazzino.inventario, magazzino.quantita_riordino AS riordino, magazzino.data_aggiornamento, magazzino.quantita_magazzino, magazzino.db_ven, varianti_a.prezzo_ve_va, varianti_a.prezzo_ac_va, IF(prezzo_ve_va >0, (prezzo_ve_va-prezzo_ac_va)/prezzo_ac_va*100,(prezzo-costo)/costo*100) as ricarico FROM ((magazzino RIGHT JOIN prodotti ON magazzino.idpro = prodotti.IDpro) LEFT JOIN varianti_a ON magazzino.idvara = varianti_a.IDvara) LEFT JOIN varianti_b ON magazzino.idvarb = varianti_b.IDvarb "filtro=falseif isnumeric(da) and isnumeric(a) and a<>"" and da<>"" then	if da>a then		tmp=a		a=da		da=a	end if	sql=sql&" having ricarico between "&da& " and "&a	filtro=trueelseif request("dati_mancanti")<>"" thensql=sql&" having ricarico is null"end ifif ordina="r" then	sql=sql&" order by ricarico desc"else	sql=sql&" order by data_agg_costo"end ifPaginazioneString="&da="&da&"&a="&a&"&ordina="&ordinacall paginazione_start(sql,10000,"")%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">	        <%if filtro then %>          <tr class="ui-widget-header">             <td colspan="7" >Articoli con ricarico da <%=da%> a <%=a%></td>          </tr>          <%end if %>          <tr style="border-bottom:1px solid;" bgcolor="#E5E5E5">            <td  style="border-bottom:1px solid;">Codice</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Articolo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Varianti</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Prezzo di vendita</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Prezzo di acquisto</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data revisione</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Ricarico %</td>          </tr>          <%totale=0iRecordsShown = 0Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>          <tr style="border-bottom:1px solid;">            <td ><a href="http://<%=nomesito%>/product.asp?idpro=<%=objPagingRS("idpro")%>"><%=objPagingRS("codice")%></a></td>            <td ><%=objPagingRS("articolo")%></td>            <td ><%=codifica_varianti_ordine(objPagingRS("variante_a"), "", objPagingRS("variante_b"), "")%></td>            <%	            prezzo=objPagingRS("prezzo")	            costo=objPagingRS("costo")	            if not isnull(objPagingRS("prezzo_ve_va")) then	            if cdbl(objPagingRS("prezzo_ve_va"))>0 then		            prezzo=objPagingRS("prezzo_ve_va")		            costo=objPagingRS("prezzo_ac_va")	            end if	            end if	            %>            <td align="right"><%=prezzo%></td>            <td align="right"><%=costo%></td>            <%	            if not isnull(objPagingRS("data_agg_costo")) then	            	ricarico=formatdatetime(objPagingRS("data_agg_costo"),0)	            else		            ricarico=""		        end if	            %>            <td align="right"><%=ricarico%></td>                        <%	            if not isnull(objPagingRS("ricarico")) then	            	ricarico=formatnumber(objPagingRS("ricarico"),0)	            else		            ricarico="???"		        end if	            %>            <td align="right"><%=ricarico%></td>          </tr>          <% 		iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(7,true)		%>        </table>