 rsm("titolo")&"</option>"rsm.movenextlooprsm.close%></select>              </td>            </tr>  <tr>               <td valign="top">Box superiore settore</td>              <td> <%if error<>"" then			  		val=request.form("id_testata")				elseif oper="edit" then					val=rs("id_testata")			  	elseif oper="new" then			  		val=0				end if%>                  <select name="id_testata" >              <option value="">Nessuno</option><%Set rsm=conn.execute("select * from news where tipo='p' order by titolo ;")do while not rsm.eofresponse.write "<option value=""" & rsm("idnews") &""""if int(val)=int(rsm("idnews")) then response.write " selected"response.write ">"&rsm("idnews")&"-" & rsm("titolo")&"</option>"rsm.movenextlooprsm.closeset rsm = Nothing%></select>              </td>            </tr>                        <tr>               <td valign="top">Colore</td>              <td>                 <%if error<>"" then			  		val=request.form("nome_settore")				elseif oper="edit" then					val=rs("colore")			  	elseif oper="new" then			  		val=""				end if%> <div style=" width:100px; height:20px;  border:#6F0 1px solid; background:#<%=val%>;"  id="picker"></div> <input type="hidden" id="colore" name="colore" value="<%=val%>" size="40" style="border-right:20px solid #<%=val%>;">               </td>            </tr>            	<script type="text/javascript" src="Jquery/js/colpick/colpick.js"></script><script>	$('#picker').colpick({	layout:'hex',	submit:true,	colorScheme:'dark',	color:'<%=val%>',	onChange:function(hsb,hex,rgb,el,bySetColor) {		//$(el).css('border-right','20px solid #'+hex);		$("#colore").val(hex);		$(el).css("background","#"+hex);		// Fill the text box just if the color was set using the picker, and not the colpickSetColor function.		//if(!bySetColor) $(el).val(hex);	}}).keyup(function(){	$(this).colpickSetColor(this.value);});	</script>                                                            <%			if oper="edit" then			cancellabile=true		sql="select Count(*)  FROM settori_prodotti where idsettore="& idsettore &";"		'sql="select settori_prodotti.IDsettore, Count(settori_prodotti.IDpro) AS ConteggioDiIDpro FROM settori_prodotti INNER JOIN prodotti ON settori_prodotti.IDpro = prodotti.IDpro GROUP BY settori_prodotti.IDsettore having idsettore="& idsettore &";"		numprodotti=clng(conn.execute(sql)(0))		if numprodotti>0 then					'cancellabile=true			testo="Questo settore contiene <b>"&numprodotti&"</b> articoli.<br>"		end if		sql="select Count(*) FROM settori_settori where idpadre="& idsettore &";"		num=clng(conn.execute(sql)(0))		if num then					cancellabile=false			testo=testo&"Non &egrave; possibile eliminare questo settore perch&egrave; contiene <b>"&num&"</b> sottosettori."		end if		if testo<>"" then			%>            <tr>              <td colspan="2" align="center" valign="top"><%=testo%></td>            </tr>            <%end if			end if%>            <tr>              <td colspan="2" align="center" valign="top"><%if oper="view" then	txt=puls_newelseif oper="new" or error<>"" then	txt="Aggiungi"elseif oper="edit" then	txt="Modifica"end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Esci senza salvare" onClick="annulla=true;">    <%end if%></td>            </tr>                <%if oper="edit" and cancellabile=true and error="" then    %>            <tr>	            <td colspan="2" align="center">				    <input type="submit" name="elimina1" value="Elimina" onClick="annulla=true;">				    <%    if numprodotti>0 then					    testo_elimina2="Elimina e sposta "&numprodotti&" articoli nel settore superiore"					    testo_elimina3="Elimina e sposta "&numprodotti&" articoli nel settore specificato"					    if rs("idpadre")<>0 then					%>				    <input type="submit" name="elimina2" value="<%=testo_elimina2%>" onClick="annulla=true;">				    <%end if %>				    				    <input type="submit" name="elimina3" value="<%=testo_elimina3%>" onClick="annulla=true;"><%  where=""  if oper="edit" then	val=rs("idpadre")else	if request.form("settore")<>"" then		val=cint(request.form("idpadre"))	else		val=cint(session("tmp_settori_idpadre"))	end ifend if%>            				<input type='hidden' name='spostain' id='spostain' style="width: 300px;" value=" "/>																			<script>			  $(document).ready(function () {														  	$('#spostain').select2({				  		placeholder: 'Seleziona il settore',				  		minimumInputLength: 0,				  		allowClear: true,				  		initSelection : function (element, callback) {					    },				  		ajax: {							cache: false,				  			quietMillis: 150,				  			url: "ajax_function.asp?select2=settori",				  			dataType: 'json',				  			data: function (term, page) {				  				return {				  					term: term,									escludi : <%=idsettore%>,									cercaloop : "true"				  				};				  			},				  			results: function (data) {				  				return {				  					results: data				  				};				  			}				  		}				  						  	});		  	});																				</script>				    				    <%end if%>				    	            </td>            </tr>            <%	            	            end ifset rs = nothing	                        %>          </table></form><%end if%>                <!-- Colonna CORPO FINE-->      </div>        <div id="footer"></div><%		call connclose()	%><!--#include virtual="/pag_adm_footer_inc.asp" --></div>  </body></html><%sub elenco_settori_sortable(layer,id,testo,testo_dopo)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	'find child with thread_parent=his parent id	'sql_order="select settori.idsettore, settori.settore, settori.idpadre, settori.nascondi, settori.ordine, settori.nascondi_prezzi, Count(prodotti.IDpro) AS ConteggioDiIDpro, Count(settori_1.idsettore) AS ConteggioDiidsettore FROM settori AS settori_1 RIGHT JOIN (settori LEFT JOIN prodotti ON settori.idsettore = prodotti.idsettore) ON settori_1.idpadre = settori.idsettore GROUP BY settori.idsettore, settori.settore, settori.idpadre, settori.nascondi, settori.ordine, settori.nascondi_prezzi HAVING (((settori.idpadre)=" & id & ")) order by settori.ordine"		'Sotto SQL funzionante prima	'sql_order="select settori.idsettore, settori.Nome_Settore, settori.idpadre, settori.nascondi_prezzi, settori.cedi_prodotti, settori.ordine, Count(prodotti.IDpro) AS ConteggioDiIDpro, Count(settori_1.idsettore) AS ConteggioDiidsettore FROM settori AS settori_1 RIGHT JOIN ((settori LEFT JOIN settori_prodotti ON settori.idsettore = settori_prodotti.IDsettore) LEFT JOIN prodotti ON settori_prodotti.IDpro = prodotti.IDpro) ON settori_1.idsettore = settori.idpadre GROUP BY settori.idsettore, settori.Nome_Settore, settori.idpadre, settori.cedi_prodotti,settori.ordine, settori.nascondi_prezzi HAVING (((settori.idpadre)=" & id & ")) order by settori.ordine"		sql_order="select settori.idsettore, settori.nome_settore,  settori.nascondi_prezzi, 0 as ConteggioDiIDpro , 0 as ConteggioDiidsettore from settori_settori inner join settori on settori_settori.idfiglio = settori.idsettore where settori_settori.idpadre="&id&" order by settori_settori.ordine"	'response.write sql_order	if layer=0 then testo=testo&"<ol class=""sortable"">"	set rs_order=conn.execute(sql_order)	nodo=true	testo=testo&testo_dopo	testo_dopo=""	if not 	rs_order.eof then 		if layer>0 then testo=testo& "<ol>"	else		nodo=false	end if	do until rs_order.eof									'conteggiodiidpro=clng(rs_order("conteggiodiidpro"))				conteggiodiidpro=clng(conn.execute("select count(*) from settori_prodotti where idsettore="&rs_order("idsettore"))(0))		conteggiosubsettori=clng(conn.execute("select count(*) from settori_settori where idpadre="&rs_order("idsettore"))(0))				if analizza=true then						tot_record=0			tot_settori=0			call analisi_prodotti_virtuali(rs_order("idsettore"))					end if								if conteggiodiidpro=0 and conteggiosubsettori=0 then			classe="vuoto"			settori_vuoti=settori_vuoti+1		else			classe=""		end if		 		'Conteggio ricorrenze stesso settore		ricorrenze=clng(conn.execute("select count(*) from settori_settori where idfiglio="&rs_order("idsettore"))(0))		if ricorrenze>1 then			ricorrenze="&nbsp;<strong>X "&ricorrenze&"</strong>"		else			ricorrenze=""		end if		if conteggiodiidpro=0 and conteggiosubsettori=0 then			ricorrenze=ricorrenze&"&nbsp;<strong>VUOTO</strong>"		end if				testo=testo&  "<li id=""id_"&rs_order("idsettore")&""""&" class="""&classe&""">"		testo_dopo="<div><span class=""disclose""><span></span></span><span class=""testo"">"&rs_order("nome_settore")&ricorrenze&"</span><span style=""float:right; text-align:right;"">"		testo_dopo=testo_dopo&"<button style=""font-size:9px;"" onclick=""window.location.href='"&questofile&"?oper=edit&idsettore="&rs_order("idsettore")&"'"">Modifica</button>"		testo_dopo=testo_dopo&"<button style=""font-size:9px;"" onclick=""copyToClipboard("&rs_order("idsettore")&");"">Copia link</button>"				if conteggiodiidpro>0 then			testo_dopo=testo_dopo&"<br><button style=""font-size:9px;"" onclick=""window.location.href='pag_adm_artic.asp?oper=view&idset="&rs_order("idsettore")&"'"">Vedi articoli</button>"			'testo_dopo=testo_dopo&"<br><button style=""font-size:9px;"" onclick=""window.location.href='pdf_listino.asp?mepa=si&idsettore="&rs_order("idsettore")&"'"">Listino mepa</button>"		end if		testo_dopo=testo_dopo&"</span><br>&nbsp;&nbsp;"&conteggiodiidpro&" articoli"		'if rs_order("nascondi") then testo_dopo=testo_dopo&" - Nascosta"		if rs_order("nascondi_prezzi") then testo_dopo=testo_dopo&" - Prezzi nascosti"		if analizza=true then			testo_dopo=testo_dopo&"<br>Sottosettori con articoli: "&tot_settori&"<br>Articoli in sottosettori: "&tot_record		end if								testo_dopo=testo_dopo&"</div>"		'calling again to find more childs - if not rs_order=nothing	    call elenco_settori_sortable(layer+1,rs_order("idsettore"),testo,testo_dopo)	'testo=testo& "</li>"&vbcrlf		rs_order.movenext	loop	if nodo=true and layer>0 then testo=testo& "</ol>"&vbcrlf		'closing object	rs_order.close	set rs_order=nothing	if layer=0 then		testo=testo&"</ol>"		if settori_vuoti>0 then testo=testo&"<div id=""label_vuoto"">Ci sono "&settori_vuoti&" settori vuoti </div>"						'response.write testo		Application.Lock		Application("cache_adm_settori")= cstr(testo)		Application.Unlock	end ifEnd Sub	sub analisi_prodotti_virtuali(idsettore)	dim stringa_tmp, result	set rs = conn.execute("select settori_settori.idfiglio from settori_settori where idpadre="&idsettore)	do while not rs.EOF	'Ciclo su settori		sql="select count(*) from prodotti inner join settori_prodotti on prodotti.idpro= settori_prodotti.idpro where settori_prodotti.idsettore="&rs("idfiglio")		numrec=clng(conn.execute(sql)(0))		if numrec>0 then			tot_settori=tot_settori+1		end if		tot_record=tot_record+numrec						call analisi_prodotti_virtuali(rs("idfiglio")) 		rs.MoveNext	loopend subsub mappacatselezione(layer,id,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM settori WHERE idpadre = " & id &" and idsettore<>"&escludi&" order by nome_settore;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("idsettore") &""""		if int(val)=int(rs_order("idsettore")) then response.write " selected"		response.write ">" &spaceing& rs_order("nome_settore")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappacatselezione(layer+1,rs_order("idsettore"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	sub riordina_az(id)	'declaring	dim sql_order, ordine	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	sql_order = "select settori.nome_settore, settori_settori.idpadre, settori_settori.id FROM settori_settori inner join settori on settori_settori.idfiglio = settori.idsettore where settori_settori.idpadre ="&id&" order by nome_settore"	rs_order.open sql_order,conn	nodo=true	ordine=1		do until rs_order.eof		call riordina_az(rs_order("id"))		sql="update settori_settori set ordine= "&ordine&" where id="&rs_order("id")		conn.execute (sql)		ordine=ordine+1		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothing	End Subfunction cercaloop(layer,id,catenasettori)	'Eseguo scansione all'indietro	tmp=false	if layer>100 then		tmp=true		response.write "superato 100"	end if	catenasettori=catenasettori&"|"&id&"|"	'declaring	dim sql_order,str,MessageSpacing	'create recordset	'find child with thread_parent=his parent id	sql_order = "select * FROM settori_settori WHERE idfiglio = " & id 	set rs_order=conn.execute( sql_order)	if not rs_order.eof then		if instr(catenasettori,"|"&rs_order("idpadre")&"|")>0 then			tmp=true								else			tmp=cercaloop(layer,rs_order("idpadre"),catenasettori)		end if			end if	'closing object	'rs_order.close	set rs_order=nothing	cercaloop=tmpEnd functionsub reset_cache_settori()	Application.Lock	Application("cache_adm_settori")= ""	Application("cache_settori")=""	Application("cache_settorien")=""	Application.Unlockend subsub ordina()	strordine=request.form("strOrdine")	idpadre=request.form("idpadre")	array_=split(strordine,",")	on error resume next	For i = 0 TO UBound(array_)	   sql_update = "UPDATE settori_settori SET ordine="&i& " WHERE idfiglio = " & array_(i)&" and idpadre="&idpadre	   conn.Execute sql_update	   if err.number<>0 then 		   		   response.write "Errore in sql:"&sql_update		   response.end	   end if	Next	'call imposta_nodo()	add2log "Ordine settori aggiornato da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",1	Response.ContentType = "application/json; charset=utf-8"	Response.CodePage = 65001	Set Js = jsObject()	js("success")=true	js("message")="Ordine settori aggiornato"	js.Flush	set js=Nothing	call reset_cache_settori()	call connclose()	response.endend sub%>