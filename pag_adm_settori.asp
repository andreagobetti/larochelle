<!--#include virtual="/setup.asp" --><!--#include file="JSON_latest.asp"--><%if session("idadmin") = "" then call login()%><%'------------------------------------oper=request.form("oper")if request.form("elimina1")<>"" then	'Elimino e basta	idsettore=request.form("idsettore")		num2=elimina_settori_settori(idsettore)		'Elimino da settori_prodotti	conn.execute "DELETE FROM settori_prodotti WHERE (((settori_prodotti.IDsettore)="&idsettore&"))",num	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open "select * FROM settori WHERE idsettore=" & idsettore  , conn, 3,2	add2log "Eliminato [settore="&rs("idsettore")&"]"&rs("nome_settore")&"[/settore], rimosso da "&num&" articoli, eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]"&vbcrlf&"Eliminato "&num2&" collegamenti",3	rs.delete	rs.close	set rs = Nothing	'call connclose()	call reset_cache_settori()	oper="view"	'response.redirect questofileend ifif request.form("elimina2")<>"" then	'Sposto articoli nel settore superiore	idsettore=request.form("idsettore")	num2=elimina_settori_settori(idsettore)	set rs_settori=conn.execute ("select settori.idsettore, settori.idpadre FROM settori WHERE (((settori.idsettore)="&idsettore&"))")	idpadre=rs_settori("idpadre")	set rs_settori=Nothing	sql="UPDATE settori_prodotti SET IDsettore = "&idpadre&" WHERE settori_prodotti.IDsettore ="&idsettore	conn.execute sql,num	conn.execute ("DELETE FROM settori_prodotti WHERE (((settori_prodotti.IDsettore)="&idsettore&"))")	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open "select * FROM settori WHERE idsettore=" & idsettore  , conn, 3,2	add2log "Eliminato [settore="&rs("idsettore")&"]"&rs("nome_settore")&"[/settore], spostati "&num&" articoli nel settore superiore, eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]"&vbcrlf&"Eliminato "&num2&" collegamenti",3	rs.delete	rs.close	set rs = Nothing	call reset_cache_settori()	oper="view"end ifif request.form("elimina3")<>"" and request.form("spostain")<>"" then	'Sposto articoli nel settore scelto	idsettore=request.form("idsettore")	num2=elimina_settori_settori(idsettore)		spostain=request.form("spostain")	set rs_settori=conn.execute ("select settori.idsettore, settori.nome_settore FROM settori WHERE (((settori.idsettore)="&spostain&"))")	nome_settore=rs_settori("nome_settore")	set rs_settori=Nothing	set rs_settori=Nothing	sql="UPDATE settori_prodotti SET IDsettore = "&spostain&" WHERE IDsettore="&idsettore	on error resume next	conn.execute sql,num	conn.execute ("DELETE FROM settori_prodotti WHERE (((settori_prodotti.IDsettore)="&idsettore&"))")	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open "select * FROM settori WHERE idsettore=" & idsettore  , conn, 3,2	add2log "Eliminato [settore="&rs("idsettore")&"]"&rs("nome_settore")&"[/settore], spostati "&num&" articoli nel settore "&nome_settore&", eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]"&vbcrlf&"Eliminato "&num2&" collegamenti",3	rs.delete	rs.close	set rs = Nothing	call reset_cache_settori()	oper="view"end iffunction elimina_settori_settori(idsettore)	conn.execute "delete from settori_settori where idfiglio="&idsettore,elimina_settori_settoriend functionselect case lcase(request("oper"))	case "","annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case "riordina_az"		call riordina_az(0)		call reset_cache_settori()		add2log "Settori ordinati per descrizione da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",1		oper="view"	case "edit"		oper="edit"		idsettore=request("idsettore")	case "ordina":		call ordina()			case "analizza":		analizza=true			Application.Lock		Application("cache_adm_settori")= ""		Application.Unlock		dim tot_record		dim tot_settori		tot_record=0		tot_settori=0		oper="view"	case else		oper="view"end selectif oper="add" or oper="update" then	if request.form("nome_settore")="" then		error="Inserire il nome del settore"		idsettore=request("idsettore")		oper="edit"	end ifend ifif oper="add" or oper="update" then	sql="select * from settori"	Set rs = Server.CreateObject("ADODB.Recordset")	idsettore=request.form("idsettore")	if oper="add" then			rs.Open sql, conn, 3, 3		rs.addnew		rs("ordine")=0		rs.update		rs.close		idsettore=get_last_id("settori")		sql= sql & " where idsettore=" & idsettore		rs.Open sql, conn, 3, 3		session("tmp_settori_idpadre")=request.form("idpadre")	else		sql= sql & " where idsettore=" & idsettore		rs.Open sql, conn, 3, 3	end if		Dim objDict	'Create an instance of the Dictionary object	Set objDict = Server.CreateObject("Scripting.Dictionary")	set rsm=conn.execute("select settori.idsettore, settori.nome_settore from settori")	objDict.Add "0","Principale"	do while not rsm.eof		objDict.Add cstr(rsm("idsettore").value),rsm("nome_settore").value		rsm.movenext	loop				rs("nome_settore")=request.form("nome_settore")	rs("nome_settore_en")=request.form("nome_settore_en")	rs("colore")=request.form("colore")			'SETTORE		str_arr_settori=request.form("settori_padre")		if str_arr_settori="" then			'settore_predefinito=0			str_arr_settori="0"		end if						arr_settori = split(str_arr_settori,",")		settore_predefinito=arr_settori(0)				set rs_settori=conn.execute( "select settori_settori.idpadre from settori_settori where idfiglio="&idsettore)		do while not rs_settori.eof			'modifiche_rs= modifiche_rs& "trovato settore padre "&rs("idpadre")&"<br>"			if str_arr_db<>"" then str_arr_db=str_arr_db&","			str_arr_db=str_arr_db&rs_settori("idpadre")			rs_settori.movenext		loop		set rs_settori=nothing		str_arr_db=str_arr_db		'response.write "settori da db:" &str_arr_db&" settori da form:"&str_arr_form&"<br>"		modifiche_rs= modifiche_rs& "creato str_arr_db "&str_arr_db&", confronto con str_arr_settori "&str_arr_settori&"<br>"		arr_db = split(str_arr_db,",")		'trovo record da eliminare		for i = 0 to ubound(arr_db)			found = "false"				for j = 0 to ubound(arr_settori)				 if (cint(arr_db(i)) = cint(arr_settori(j))) then				 found = "true"				 exit for				 end if				next			if found ="false" then				'eliminato=conn.execute("select nome_settore from settori inner join settori_settori on settori.idsettore=settori_settori.idpadre where id="&arr_db(i))(0)				conn.execute "delete  from settori_settori where idPADRE="&arr_db(i)&" AND IDFIGLIO="&idsettore ,N				IF N=0 then				modifiche_rs= modifiche_rs&"<strong>ATTENZIONE:</strong> impossibile eliminare settore padre "&arr_db(i)&"<br>"				else					modifiche_rs= modifiche_rs&"Eliminato settore padre "&objDict.Item(cstr(arr_db(i)))&"<br>"				end if							end if		next				set rs_settori=Server.CreateObject("ADODB.Recordset")		rs_settori.Open "select settori_settori.* from settori_settori where idfiglio="&idsettore, conn, 1, 3		'trovo record da aggiungere		strOutput = "("		for i = 0 to ubound(arr_settori)			found = "false"				for j = 0 to ubound(arr_db)				 if (cint(arr_settori(i)) = cint(arr_db(j))) then					 found = "true"					 exit for				 end if				next			if found ="false" then				 rs_settori.addnew				 rs_settori("idfiglio")=idsettore				 rs_settori("idpadre")=cint(arr_settori(i))				 rs_settori.update				 modifiche_rs= modifiche_rs& "Aggiunto settore padre "&objDict.Item(cstr(arr_settori(i)))&"<br>"				 strOutput=strOutput & arr_settori(i) & ","				 call aggiungi_settori_bkw(cint(arr_settori(i)))				 'ARR2temp = arr_settori(i)			end if		next		rs_settori.close		set rs_settori=nothing		'SETTORE FINE	rs("idpadre")=settore_predefinito					if request.form("id_sinistra")="" then 		rs("id_sinistra")=null	else		rs("id_sinistra")=request.form("id_sinistra")	end if	if request.form("id_testata")="" then 		rs("id_testata")=null	else		rs("id_testata")=request.form("id_testata")	end if	if request.form("nascondi_prezzi")="si" then		rs("nascondi_prezzi")=1	else		rs("nascondi_prezzi")=0	end if	if request.form("cedi_prodotti")="si" then		rs("cedi_prodotti")=1	else		rs("cedi_prodotti")=0	end if	if request.form("prendi_prodotti")="si" then		rs("prendi_prodotti")=1	else		rs("prendi_prodotti")=0	end if	if request.form("nascondi")="si" then		rs("nascondi")=1	else		rs("nascondi")=0	end if	if request.form("marcamodello")="si" then		rs("marcamodello")=1	else		rs("marcamodello")=0	end if	rs.update	if oper="add" then		txt= "Aggiunto"	else		txt= "Modifica"	end if	call add2log(txt&" [settore="&rs("idsettore")&"]"&rs("nome_settore")&"[/settore] eseguita da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]"&vbcrlf&modifiche_rs,2)	rs.close	Set rs = Nothing	'call reconfig	call imposta_nodo()	if request.form("nascondi_prezzi")="si" then		conn.execute ("update  prodotti a  INNER JOIN settori_prodotti b ON a.IDpro = b.IDpro set a.prezzo_visibile=2 where  b.IDsettore="&idsettore)	end if	call reset_cache_settori()	oper="view"end ifsub imposta_nodo()	sql="select settori.* from settori"	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 3, 3	do while not rs.EOF		set rstmp=conn.execute ("select settori.* from settori where idpadre="&rs("idsettore"))		rs("nodo")=not rstmp.eof		rs.update		rs.MoveNext	loop	Set rs = Nothingend subdim settori_vuotisettori_vuoti=0meta_title="Settori"%><!--#include virtual="/sub_head_adm.asp" --><link rel="stylesheet" type="text/css" href="Jquery/js/colpick/colpick.css"/><style>/*notification-bubble  */.notification-bubble {	font-size:inherit;	float:none;	display:inline-block;}</style><%if oper="view" then%><script src="Jquery/js/jquery.mjs.nestedSortable.js"></script>	<style type="text/css">		.placeholder {			outline: 1px dashed #4183C4;			/*-webkit-border-radius: 3px;			-moz-border-radius: 3px;			border-radius: 3px;			margin: -1px;*/			width:300px;		}		.mjs-nestedSortable-error {			background: #fbe3e4;			border-color: transparent;		}		ol {			margin: 0;			padding: 0;			padding-left: 30px;		}		ol.sortable, ol.sortable ol {			margin: 0 0 0 75px; /*spostamento*/			padding: 0;			list-style-type: none;		}		ol.sortable {			margin: 1em 0;		}		.sortable li {			margin: 5px 0 0 0;			padding: 0;		}		.sortable li div  {			width:350px;			border: 1px solid #d4d4d4;			-webkit-border-radius: 3px;			-moz-border-radius: 3px;			border-radius: 3px;			border-color: #D4D4D4 #D4D4D4 #BCBCBC;			padding: 6px;			margin: 0;			height:auto;			cursor: move;			background: #f6f6f6;			background: -moz-linear-gradient(top,  #ffffff 0%, #f6f6f6 47%, #ededed 100%);			background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#ffffff), color-stop(47%,#f6f6f6), color-stop(100%,#ededed));			background: -webkit-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: -o-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: -ms-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: linear-gradient(to bottom,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ffffff', endColorstr='#ededed',GradientType=0 );		}					.sortable li.vuoto div {			background: #FB5D60 !important;									}		.sortable li.mjs-nestedSortable-branch div {			background: -moz-linear-gradient(top,  #ffffff 0%, #f6f6f6 47%, #f0ece9 100%);			background: -webkit-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#f0ece9 100%);		}		.sortable li.mjs-nestedSortable-leaf div {			background: -moz-linear-gradient(top,  #ffffff 0%, #f6f6f6 47%, #bcccbc 100%);			background: -webkit-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#bcccbc 100%);		}		li.mjs-nestedSortable-collapsed.mjs-nestedSortable-hovering div {			border-color: #999;			background: #fafafa;		}		.disclose {			cursor: pointer;			width: 10px;			display: none;		}		.sortable li.mjs-nestedSortable-collapsed > ol {			display: none;		}		.sortable li.mjs-nestedSortable-branch > div > .disclose {			display: inline-block;		}		.sortable li.mjs-nestedSortable-collapsed > div > .disclose > span:before {			content: '+  ';			font-weight:bold;			font-size:130%;		}		.testo  {			padding-left:5px;		}		.sortable li.mjs-nestedSortable-expanded > div > .disclose > span:before {			content: '-  ';			font-weight:bold;			font-size:150%;		}														#label_vuoto {			width:350px;			border: 1px solid #d4d4d4;			-webkit-border-radius: 3px;			-moz-border-radius: 3px;			border-radius: 3px;			border-color: #D4D4D4 #D4D4D4 #BCBCBC;			padding: 6px;			margin: 3;			margin-top: 8px;			background: #FB5D60 !important;			background: -moz-linear-gradient(top,  #ffffff 0%, #f6f6f6 47%, #ededed 100%);			background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#ffffff), color-stop(47%,#f6f6f6), color-stop(100%,#ededed));			background: -webkit-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: -o-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: -ms-linear-gradient(top,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			background: linear-gradient(to bottom,  #ffffff 0%,#f6f6f6 47%,#ededed 100%);			filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ffffff', endColorstr='#ededed',GradientType=0 );		}																												</style>	<script>	 function copyToClipboard (text) {	     window.prompt ("Premi Ctrl+C per copiare", "/category.asp?idsettore="+text);	 }	$(document).ready(function(){		$('ol.sortable').nestedSortable({			forcePlaceholderSize: true,			handle: 'div',			helper:	'clone',			items: 'li',			opacity: .6,			placeholder: 'placeholder',		//	revert: 250,			tabSize: 25,			tolerance: 'pointer',			toleranceElement: '> div',		//	maxLevels: 3,			isTree: true,			expandOnHover: 700,			startCollapsed: true,			disableParentChange : true		});											$("ol.sortable").nestedSortable({			change: function(){			//console.log("change");		},			relocate: function(){			var idmoved=$(this).data().uiSortable.currentItem;			var idpadre=$(idmoved).closest("ol").closest("li");			console.log("relocate "+idmoved.attr("id"));			console.log("padre "+idpadre.attr("id"));			if(idpadre.attr("id")== undefined){				idpadrestr=null;			}			else			{				idpadrestr=idpadre.attr("id").replace("id_","");			}			console.log("idpadrestr "+idpadrestr);			var arraied = $('ol.sortable').nestedSortable('toArray', {startDepthCount: 0});			console.log(arraied);						var strOrdine="";			arraied.forEach( function (arrayItem)			{								if (arrayItem.parent_id == idpadrestr)				{					if (arrayItem.id!=undefined){					if (strOrdine!=""){						strOrdine+=",";					}				//console.log("trovato:"+arrayItem.id);				strOrdine+=arrayItem.id;				}					}			});			if(idpadrestr==null){				idpadrestr=0;					}				console.log("strOrdine:"+strOrdine);									   $.ajax({				url     : "pag_adm_settori.asp?oper=ordina",				type    : "post",				cache: false,				dataType: 'json',					data	: { strOrdine: strOrdine,								idpadre: idpadrestr										},					success: function(data){												console.log(data);						if(data.success){							console.log(data.message);							toastr.options = {"positionClass": "toast-bottom-right","timeOut": "2000","extendedTimeOut": "0", "closeButton": true};							toastr.success(data.message);							return;													}else{														toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};							toastr.error(data.message);													}											}					,error: function(xhr, textStatus, error){						toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};						toastr.error('Errore nel caricamento della pagina');												var txt="xhr.statusText : " + xhr.statusText+"<br>xhr.responseText : " + xhr.responseText+"<br>textStatus : " + textStatus+"<br>error : " + error+"<br>Useragent : "+navigator.userAgent;						invia_errore("Errore in chk_settore",txt );					}				});																		}		});																																							$('.disclose').on('click', function() {			$(this).closest('li').toggleClass('mjs-nestedSortable-collapsed').toggleClass('mjs-nestedSortable-expanded');		})		$('#espandi').on('click', function() {			$(".mjs-nestedSortable-collapsed").toggleClass('mjs-nestedSortable-collapsed').addClass('mjs-nestedSortable-expanded');		})		$('#comprimi').on('click', function() {			$(".mjs-nestedSortable-expanded").toggleClass('mjs-nestedSortable-expanded').addClass('mjs-nestedSortable-collapsed');		})		$("#ordina").click(function() { 			var ordine = $('ol.sortable').nestedSortable('serialize'); 			//alert(ordine);											$.ajax({			cache :false,			url     : "<%=questofile%>?ordina=si",			type    : "post",			dataType: '',			data	: ordine,			success: function(data){				alert(data);				}			,error:function(xhr, textStatus, error){				      console.log("xhr.statusText:"+xhr.statusText);				      console.log("xhr.responseText:"+xhr.responseText);				      console.log("textStatus:"+textStatus);				      console.log("error:"+error);					  }									});																											});		$('#serialize').click(function(){			serialized = $('ol.sortable').nestedSortable('serialize');						$('#serializeOutput').text(serialized+'\n\n');		})		$('#toHierarchy').click(function(e){			hiered = $('ol.sortable').nestedSortable('toHierarchy', {startDepthCount: 0});			hiered = dump(hiered);			(typeof($('#toHierarchyOutput')[0].textContent) != 'undefined') ?			$('#toHierarchyOutput')[0].textContent = hiered : $('#toHierarchyOutput')[0].innerText = hiered;		})		$('#toArray').click(function(e){			arraied = $('ol.sortable').nestedSortable('toArray', {startDepthCount: 0});			arraied = dump(arraied);			(typeof($('#toArrayOutput')[0].textContent) != 'undefined') ?			$('#toArrayOutput')[0].textContent = arraied : $('#toArrayOutput')[0].innerText = arraied;		})	});	function dump(arr,level) {		var dumped_text = "";		if(!level) level = 0;		//The padding given at the beginning of the line.		var level_padding = "";		for(var j=0;j<level+1;j++) level_padding += "    ";		if(typeof(arr) == 'object') { //Array/Hashes/Objects			for(var item in arr) {				var value = arr[item];				if(typeof(value) == 'object') { //If it is an array,					dumped_text += level_padding + "'" + item + "' ...\n";					dumped_text += dump(value,level+1);				} else {					dumped_text += level_padding + "'" + item + "' => \"" + value + "\"\n";				}			}		} else { //Strings/Chars/Numbers etc.			dumped_text = "===>"+arr+"<===("+typeof(arr)+")";		}		return dumped_text;	}</script><%end if%><%if oper<>"view" then%>	<script>	$(function() {		$( "input" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });		$( "select" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });		$( "textarea" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });	});		</script>    	<style>	label {		display: inline-block;		width: 5em;	}										.select2-results .select2-disabled {			background: #FFF;		  color: #A9A9A9;		  display: list-item;		  cursor: pointer;		  font-weight: normal;		}	</style>    <script Language="JavaScript"> 	annulla=false;	function Validator(theForm) 	{	if (annulla==true)  { 		return(true);    	  } 		  if (theForm.nome_settore.value == "")  { 		alert("Specificare un nome per il settore.");		theForm.nome_settore.focus();		return (false); 	}	  	  return (true); 	} </script><%end if%></head><body> <div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa"> <!--#include virtual="/sub_barra_adminsf2.asp" 