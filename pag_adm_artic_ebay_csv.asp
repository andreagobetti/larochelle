<!--#include virtual="/setup.asp" --><%'call add2log(queryeform(),0)dim RS1set rs_impostazioni_ebay=conn.execute ("select impostazioni_ebay.* from impostazioni_ebay where id=1")sql="SELECT '"&request("action")&"' as action,prodotti.codice as productname, category_1, title, subtitletext, description, '1000' as conditionid, picurl, quantity, 'FixedPrice' as format, starting_price, '' as buyitnowprice, '30' as duration, '"&rs_impostazioni_ebay("ImmediatePayRequired")&"' as ImmediatePayRequired, '"&rs_impostazioni_ebay("location")&"' as location, '' as gallery, '1' as accept_paypal, '"&rs_impostazioni_ebay("PayPalEmailAddress")&"' as PayPalEmailAddress, payment_instructions, store_category, '' as ShippingDiscountProfileID, '' as DomesticRateTable, 'Flat' as shippingtype, 'IT_OtherCourier3To5Days' as ShippingService_1_Option, '"&rs_impostazioni_ebay("ShippingService_1_Cost")&"' as ShippingService_1_Cost,'"&rs_impostazioni_ebay("ShippingService_1_AdditionalCost")&"' as ShippingService_1_AdditionalCost, '' as ShippingService_1_Priority, '' as ShippingService_1_ShippingSurcharge, '' as ShippingService_2_Option, '' as ShippingService_2_Cost, '' as ShippingService_2_Priority, '' as ShippingService_2_ShippingSurcharge , '"&rs_impostazioni_ebay("DispatchTimeMax")&"' as DispatchTimeMax, concat_WS('-',idebay,codice) as CustomLabel, 'ReturnsAccepted' as ReturnsAcceptedOption, '' as RefundOption, '' as ReturnsWithinOption, 'Buyer' as ShippingCostPaidByOption, '' as AdditionalDetails, '' as ShippingProfileName, '' as ReturnProfileName, '' as PaymentProfileName,brand.nomebrand as c_marca, prodotti_ebay.idpro as mpn,upc_ean as product_ean FROM ((((prodotti_ebay left join prodotti on prodotti_ebay.idpro = prodotti.idpro) left join upc_ean  on prodotti.idpro = upc_ean.idpro) left join prodotti_brand on prodotti.idpro = prodotti_brand.idpro) left join brand on prodotti_brand.idbrand = brand.id)"sql=sql& " WHERE IDebay in("&request.querystring("includi")&")"on error resume nextset RS1 = conn.execute (sql)if err.number<>0 then	response.write "Errore in sql:"&sql	call add2log("Errore in sql csv:"&sql,0)	response.endend ifResponse.ContentType = "text/csv"fine_file=aggiungi_zeri( day(date),2)&"_"&aggiungi_zeri( month(date()),2)&"_"&replace(formatdatetime(now(),4),":","")Response.AddHeader "Content-Disposition", "attachment;filename=ebay_"&request("action")&"_"&fine_file&".csv"call Write_CSV_EBay("*Action(SiteID=Italy|Country=IT|Currency=EUR|Version=941),*ProductName,*Category,*Title,Subtitle,*Description,*ConditionID,PicURL,*Quantity,*Format,*StartPrice,BuyItNowPrice,*Duration,ImmediatePayRequired,*Location,GalleryType,PayPalAccepted,PayPalEmailAddress,PaymentInstructions,StoreCategory,ShippingDiscountProfileID,DomesticRateTable,ShippingType,ShippingService-1:Option,ShippingService-1:Cost,ShippingService-1:AdditionalCost,ShippingService-1:Priority,ShippingService-1:ShippingSurcharge,ShippingService-2:Option,ShippingService-2:Cost,ShippingService-2:Priority,ShippingService-2:ShippingSurcharge,*DispatchTimeMax,CustomLabel,ReturnsAcceptedOption,RefundOption,ReturnsWithinOption,ShippingCostPaidByOption,AdditionalDetails,ShippingProfileName,ReturnProfileName,PaymentProfileName, *C:Marca, *C:MPN, Product:EAN",rs1)sub Write_CSV_EBay(intestazione,RS)    '    ' Export Recordset to CSV    ' http://salman-w.blogspot.com/2009/07/export-recordset-data-to-csv-using.html    '    ' This sub-routine Response.Writes the content of an ADODB.RECORDSET in CSV format    ' The function closely follows the recommendations described in RFC 4180:    ' Common Format and MIME Type for Comma-Separated Values (CSV) Files    ' http://tools.ietf.org/html/rfc4180    '    ' @RS: A reference to an open ADODB.RECORDSET object    '		'	' EXAMPLE USAGE	'	' - Open a RECORDSET object (forward-only, read-only recommended)	' - Send appropriate response headers	' - Call the function	'		    if RS.EOF then            '        ' There is no data to be written        '        exit sub        end if    dim RX    set RX = new RegExp        RX.Pattern = "\r|\n|,|"""    dim i    dim Field    dim field_name    dim Separator    dim Separator_tmp    Separator = ","        '    ' Writing the header row (header row contains field names)    '    Response.Write replace(intestazione,",", Separator)&vbNewLine        '    ' Writing the data rows    '    do until RS.EOF        Separator_tmp = ""        for i = 0 to RS.Fields.Count - 1            '            ' Note the concatenation with empty string below            ' This assures that NULL values are converted to empty string            '            field_name=RS.Fields(i).name            Field=RS.Fields(i).Value            if field_name="starting_price" or field_name="buyitnowprice" or field_name="ShippingService_1_Cost" then	            	            	            if Field<>"" then 		            		            Field=replace(FormatNumber(Field,2,,,0),",",".")	            end if	        elseif field_name="picurl" then	        	field="http://"&Request.ServerVariables("SERVER_NAME")&upl_img_cat&field	        elseif field_name="product_ean" or field_name="c_marca" then	        	if isnull(Field) then		        	Field="Non applicabile"		        end if	        else	            Field = Field & ""            end if            if RX.Test(Field) then                Field = """" & Replace(Field, """", """""") & """"            end if            Field=replace(Field,vbcrlf,"")            Response.Write Separator_tmp & Field            Separator_tmp = Separator         next        Response.Write vbNewLine        RS.MoveNext    loopend subfunction aggiungi_zeri(stringa,n_zeri)	aggiungi_zeri=string(n_zeri-len(stringa),"0")&stringaend function%>