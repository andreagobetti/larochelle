<!--#include virtual="/setup.asp" --><%		tipo_prodotto=1	iddip=1	testo_taglia=recupera_taglia(tipo_prodotto,iddip)		response.write "recupera_taglia("&tipo_prodotto&","&iddip&")="&testo_taglia&" tipo"&VarType(testo_taglia)&"<br>"	tipo_prodotto=4	iddip=3	testo_taglia=recupera_taglia(tipo_prodotto,iddip)		response.write "recupera_taglia("&tipo_prodotto&","&iddip&")="&testo_taglia&" tipo"&VarType(testo_taglia)&"<br>"	function recupera_taglia(tipo_prodotto,iddip)	sql="SELECT *, MAX(data_rilievo) AS maxdate FROM dipendenti_misure where iddip="&iddip&" GROUP BY iddip "	set rs_misure=conn.execute (sql)	if not rs_misure.eof then		select case cint(tipo_prodotto)			case 0				'Nessuna				recupera_taglia=""			case 1				'tipo_prodotto_spettanze="Giacca"				recupera_taglia="TG:"&rs_misure(3)&" Fondo:"&rs_misure(4)&" Manica:"&rs_misure(5)&" Torace:"&rs_misure(6)&" Vita:"&rs_misure(7)&" Spalle"&rs_misure(8)&""			case 2				'tipo_prodotto_spettanze="Pantaloni"				recupera_taglia="TG:"&rs_misure(9)&" Lunghezza:"&rs_misure(10)&" Vita:"&rs_misure(12)&" Bacino:"&rs_misure(12)&" Cosce:"&rs_misure(18)&" Cavallo:"&rs_misure(19)&" Polpacci:"&rs_misure(20)&" "			case 3				'tipo_prodotto_spettanze="Camicia"				recupera_taglia=rs_misure(13)			case 4				'tipo_prodotto_spettanze="Scarpa"				recupera_taglia=rs_misure(14)			case 5				'tipo_prodotto_spettanze="Berretto"				recupera_taglia=rs_misure(15)			case 6				'tipo_prodotto_spettanze="Guanto"				recupera_taglia=rs_misure(16)			case 7				'tipo_prodotto_spettanze="Maglieria"				recupera_taglia=rs_misure(21)			case 8				'tipo_prodotto_spettanze="Giacca tecnica"				recupera_taglia="TG:"&rs_misure(23)&" Fondo:"&rs_misure(4)&" Manica:"&rs_misure(5)&" Torace:"&rs_misure(6)&" Vita:"&rs_misure(7)&" Spalle"&rs_misure(8)			case 9				'tipo_prodotto_spettanze="Pantaloni tecnici"				recupera_taglia="TG:"&rs_misure(22)&" Lunghezza:"&rs_misure(10)&" Vita:"&rs_misure(12)&" Bacino:"&rs_misure(12)&" Cosce:"&rs_misure(18)&" Cavallo:"&rs_misure(19)&" Polpacci:"&rs_misure(20)&" "											case else				recupera_taglia=-1		end select	else		recupera_taglia=-2			end if	'Ritorna -1 se tipo_prodotto non trovato	'Ritorna -1 se misura dipendente non trovataend function%>