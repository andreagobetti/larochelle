<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()%><%'------------------------------------oper=request.form("oper")if request.form("elimina")<>"" then	sql="delete FROM banche WHERE idbanca =" & request.form("id") & ";"	conn.execute(sql)end ifselect case lcase(request("oper"))	case "annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case else		oper="view"		if request.form("modifica")<>"" then oper="edit"end selectif oper="add" or oper="update" then	'controlliend ifif oper="add" or oper="update" then	Set rs = Server.CreateObject("ADODB.Recordset")	sql="select * from banche"	if oper="add" then		rs.Open sql, conn, 3, 3		rs.addnew	else		sql= sql & " where idbanca=" & request.form("id")		rs.Open sql, conn, 3, 3	end if	rs("nome_breve")=firstup(trim(request.form("nome_breve")))	rs("denominazione")=trim(request.form("denominazione"))	rs("iban")=ucase(trim(request.form("iban")))	if request.form("predefinita")="si" then		sql="UPDATE banche SET banche.Predefinita = 0 where idbanca<>" & request.form("id")		conn.execute(sql)		rs("predefinita")=1	else		rs("predefinita")=0	end if	rs.update	rs.close	Application("banca")=request.form("id")	oper="view"end if'response.write oper%><!DOCTYPE html><html><head>  <title><%=application("brwstitle")%></title>  <meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">  <!--#include virtual="/sub_head.asp" -->  <style type="text/css">.rosso {    color: #F00;  }  </style>  <style type="text/css">table.c2 {border-collapse: collapse}  td.c1 {font-weight: bold}  </style>  <% if oper<>"view" then%><script Language="JavaScript"> annulla=false;function Validator(theForm) {if (annulla==true)  { 	return(true);      }   if (theForm.nome_breve.value == "")  {     alert("Inserisci il nome breve");     theForm.nome_risposta.focus();     return (false);   } 	if (theForm.denominazione.value == "")  {     alert("Inserisci la denominazione");     theForm.nome_risposta.focus();     return (false);   } 	if (theForm.iban.value == "")  {     alert("Inserisci l\'iban");     theForm.nome_risposta.focus();     return (false);   }   return (true); } </script><%end if%></head><body>  <div id="wrap">    <div id="header">      <%=titolo_top%><%barra=0%><!--#include virtual="/sub_barra_adminsf2.asp" -->      <div class="ui-widget-header ui-corner-all titolo_admin">        <a href="<%=questofile%>">Elenco banche</a>      </div>        <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>         <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" <%if oper<>"view" then%> onSubmit="return Validator(this)"<%end if%> style="margin-top:0px;">		        <%sql="select * from banche  "if oper="view" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr align="right">               <td colspan="3" style="border-bottom:1px solid;"><a href="<%=questofile%>?oper=new"><strong>Nuova banca</strong></a></td>            </tr>            <tr>               <%if oper="view" then%>              <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Modifica&nbsp;</td>              <%end if%>              <td nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">Nome breve</td>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Iban</td>            </tr>            <%	sql= sql & "ORDER BY nome_breve;"	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="modifica" value="<%=rs("idbanca")%>" onClick="this.form.submit()">               </td>              <td nowrap style="border-bottom:1px solid;<%if rs("predefinita") then%>font-weight:bold;<%end if%>"><%=rs("nome_breve")%></td>              <td style="border-bottom:1px solid;"><%=rs("iban")%></td>            </tr>            <%	rs.movenext	loop	%>          </table>          <%elsetxt=request.form("modifica")if request.form("id")<>"" then txt=request.form("id")	sql=sql & " where idbanca =" & txt	if request.form("modifica")<>"" then		set rs=conn.execute(sql)		testo= "Modifica banca"			else		testo= "Nuova banca"	end if		  %>          <input type="hidden" name="id" value="<%=txt%>">          <%if error<>"" then			  		descrizione=request.form("descrizione")			  	elseif oper="new" then			  		descrizione=""				end if%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" class="ui-widget-header"><%response.write testo%></td>            </tr>            <tr>               <td align="right" valign="top">Nome breve (uso interno)</td>              <td>  <%if error<>"" then			  		var=request.form("nome_breve")				elseif oper="edit" then					var=rs("nome_breve")			  	elseif oper="new" then			  		var=""				end if%> <input type="text" name="nome_breve" value="<%=var%>" size="40">              </td>            </tr>            <tr>              <td align="right" valign="top">Denominazione</td>              <td>                <%if error<>"" then			  		var=request.form("denominazione")				elseif oper="edit" then										var=rs("denominazione")			  	elseif oper="new" then			  		var=""				end if%>				<textarea name="denominazione"   rows="6" style="width:100%;"><%=var%></textarea>              </td>            </tr>            <tr>              <td align="right" valign="top">Iban</td>              <td><%if error<>"" then			  		var=request.form("iban")				elseif oper="edit" then					var=rs("iban")			  	elseif oper="new" then			  		var=""				end if%>                <input type="text" name="iban" value="<%=var%>" size="40" /></td>            </tr>            <tr>              <td align="right" valign="top">Predefinita</td>              <td><%val=""if oper="edit" then	if rs("predefinita") then val=" checked"else	val=request.form("predefinita")	if val="si" then val=" checked"end ifif val<>" checked" then val=""%>              <input type="checkbox" name="predefinita" value="si" <%if view="view" then response.write " disabled"%> <%response.write val%>></td>            </tr>            <tr>	            <td colspan="2" align="center">        <%if oper="view" then	txt=puls_newelseif oper="new" or error<>"" then	txt="Aggiungi"elseif oper="edit" then	txt="Modifica"end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Annulla" onClick="annulla=true;">    <%end if%>    <%if oper="edit" and num=0 and error="" then%>    <input type="submit" name="elimina" value="Elimina" onClick="annulla=true;">    <%end if%>	            </td>            </tr>                </table>  <%end if%>        </form>         <%Set rs = Nothing	        	      call connclose()          %>        <!-- Colonna CORPO FINE-->    </div>    <div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" -->  </div><%  rsClose  %></body></html>