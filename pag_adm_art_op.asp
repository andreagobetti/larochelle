relati,",")		iubound=ubound(arr_correlati)		'response.write "iubound"&iubound&"<br>"		str_arr_db=""		if str_arr_correlati="" then			id_pro_consigliati=null		elseif iubound=0 then			'response.write request.form("id_pro_consigliati")			id_pro_consigliati=cint(request.form("id_pro_consigliati"))		else			id_pro_consigliati=cint(arr_correlati(0))		end if		set rs_settori=conn.execute( "select prodotti_consigliati.idconsigliato from prodotti_consigliati where idpro="&idpro)		do while not rs_settori.eof			'response.write "trovato tag"&rs("idtag")&"<br>"			if str_arr_db<>"" then str_arr_db=str_arr_db&","			str_arr_db=str_arr_db&rs_settori("idconsigliato")			rs_settori.movenext		loop		set rs_settori=nothing		arr_db = split(str_arr_db,",")				'trovo record da eliminare		for i = 0 to ubound(arr_db)			found = "false"				for j = 0 to iubound				 if (cint(arr_db(i)) = cint(arr_correlati(j))) then				 found = "true"				 exit for				 end if				next			if found ="false" then				conn.execute "delete from prodotti_consigliati where idpro="&idpro&" and idconsigliato="&arr_db(i) 				modifiche_rs= modifiche_rs&"Eliminato prodotto consigliato "&arr_db(i)&"<br>"			end if		next				set rs_settori=Server.CreateObject("ADODB.Recordset")		rs_settori.Open "select prodotti_consigliati.* from prodotti_consigliati where idpro="&idpro, conn, 1, 3		'trovo record da aggiungere		strOutput = "("		for i = 0 to iubound			found = "false"				for j = 0 to ubound(arr_db)				 if (cint(arr_correlati(i)) = cint(arr_db(j))) then					 found = "true"					 exit for				 end if				next			if found ="false" then				 rs_settori.addnew				 rs_settori("idpro")=idpro				 rs_settori("idconsigliato")=cint(arr_correlati(i))				 rs_settori.update				 modifiche_rs= modifiche_rs& "aggiunto prodotto consigliato "&arr_correlati(i)&"<br>"				 strOutput=strOutput & arr_correlati(i) & ","				 'ARR2temp = arr_modelli(i)			end if		next		rs_settori.close		set rs_settori=nothing		'CORRELATI FINE	rs("idcat")=cint(settore_predefinito)	'rs("idconsigliato")=request.form("idconsigliato")	rs.Update 	rs.Close	add2log modifiche_rs,2					next set rs = nothing	idpro=request.form("idpro")	end ifelseif action="eli" then	if request.form("elimina")="Si" then		idpro=request.form("id")		sql="select ordini_dett.* from ordini_dett where idpro="&idpro		set rs=conn.execute (sql)		if rs.eof then in_ordini=false else in_ordini=true		if in_ordini then str_log=str_log&"Presente in ordini: "		do while not rs.eof		str_log=str_log&rs("idord")& " "		rs.movenext		loop		rs.close		if in_ordini then			str_log=str_log& "<br> "		else			str_log=str_log& "Presente in nessun ordine<br> "		end if					'elimina da tabella preferiti		sql="delete from preferiti where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in preferiti<br>"				'elimina da tabella carrello		sql="delete from carrello where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in carrello<br>"				'elimina da tabella magazzino		sql="delete from magazzino where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in magazzino<br>"				'elimina da tabella prodotti_consigliati		sql="delete from prodotti_consigliati where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in articoli_consigliati<br>"				'elimina da tabella settori_prodotti		sql="delete from settori_prodotti where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in settori<br>"		'elimina da tabella varianti_a		sql="delete from varianti_a where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in varianti_a<br>"				'elimina da tabella varianti_b		sql="delete from varianti_b where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in varianti_b<br>"				'elimina da tabella prodotti_brand		sql="delete from prodotti_brand where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in prodotti_brand<br>"				'elimina da tabella prodotti_dettagli		sql="delete from prodotti_dettagli where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in prodotti_brand<br>"				'elimina da tabella prodotti_gruppihome		sql="delete from prodotti_gruppihome where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in prodotti_gruppihome<br>"				'elimina da tabella prodotti_marca_modello		sql="delete from prodotti_marca_modello where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in prodotti_marca_modello<br>"		'elimina da tabella prodotti_tags		sql="delete from prodotti_tags where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in prodotti_tags<br>"				'elimina da tabella prodotti_mepa_campi		sql="delete from prodotti_mepa_campi where idpro=" & idpro		conn.execute sql,num		str_log=str_log&"Eliminati "&num&" record in prodotti_mepa_campi<br>"						'elimina da tabella files				sql="select * from files where cosa=4 and idcosa="&idpro		rs.Open sql, conn, 1, 3		do while not rs.eof			call elimina_file(rs("path")&rs("filename"))			call elimina_file(rs("path")&"s/"&rs("filename"))									rs.delete			rs.movenext		loop		rs.close						'elimina da tabella prodotti		Set fsoMyFile = CreateObject("Scripting.filesystemObject")		sql="select * from prodotti where idpro=" & idpro		rs.Open sql, conn, 3, 3		if not rs.eof then			call elimina_file(upl_img_cat&idpro&"_b.jpg")			call elimina_file(upl_img_cat&idpro&"_s.jpg")						add2log "Eliminato [articolo="& idpro&"]"&rs("codice")& " idpro "&idpro&"[/articolo] eseguito da "& session("nominativo")&vbcrlf&"Articolo:"&rs("articolo")&"<br>"&str_log, 3				rs.delete		end if		set rs = nothing		call connclose()		call checkconnchiusa()		response.redirect "pag_adm_artic.asp"	elseif request.form("elimina")="No" then		call connclose()		call checkconnchiusa()		response.redirect "pag_adm_artic.asp"	end ifend ifselect case cosacase "dup"	titolo="Duplica articolo"case "eli"	titolo="Elimina articolo"end select%><!--#include virtual="/sub_head_adm.asp" --><script Language="JavaScript"><%if cosa="dup" then%>function Validator(theForm) { 	if (theForm.oldcodice.value == "")  {     alert("Inserire il codice esistente.");	theForm.oldcodice.focus(); 	return (false);   }	if (theForm.newcodice.value == "")  {     alert("Inserire il codice nuovo.");	theForm.newcodice.focus(); 	return (false);   }  return (true); } <%end if%></script></head><body> <div id="wrap"><div id="header"><%=titolo_top%>      	  <%barra=0%>          <div id="barra_fissa">	   <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>"><%=titolo%></a></div></div>        <%if cosa="dup" then		action=cosa		%>					<%if ok then		response.write "Nuovo codice <b>"& request.form("newcodice")&"</b> creato<br>"		response.write replace(txt_log,vbcrlf,"<br>")		end if		%>			      <form name="form1" method="post" action="<%=questofile%>?cosa=dup&action=dup">	        <br><%if errore<>"" then response.write errore%>	        <table border="1" cellpadding="0" cellspacing="0">	          <tr align="center">	            <td colspan="2">Duplica articolo</td>	          </tr>	          <tr align="center"> 	            <td>&nbsp;Codice&nbsp;esistente</td>	            <td>&nbsp;Codice nuovo&nbsp;</td>	          </tr>	          <tr align="top"> 	            <td><b>&nbsp; 	<% if request.querystring("id")<>"" then		sql="select codice from prodotti where idpro=" & cint(request.querystring("id"))		set rs = conn.execute (sql)		txt=rs("codice")		rs.close		set rs=nothing	else		txt=request.form("oldcodice")	end if%>	              <input type="text" name="oldcodice" value="<%=txt%>" class="richiesto">	              </b></td>	            <td><b>&nbsp; 	<%if ok then		txt=""	else		txt=request.form("newcodice")	end if%>	              <input type="text" name="newcodice" value="<%=txt%>" class="richiesto"></b><br><input type="checkbox" name="nuovo" value="si" checked /> Imposta nuovo articolo per 30gg<br><input type="checkbox" name="immagini" value="si" checked/>Duplica immagini				  				  </td>	          </tr>	        </table>				        <br>	        <input type="submit" name="oper" value="Duplica" onClick="return Validator(this.form)">	        <input type="submit" name="oper" value="Esci">			<%if ok then			sql="select * from prodotti where codice='" & request.form("newcodice") &"'"			set rs = conn.execute (sql)			txt=rs("idpro")			rs.close			set rs = nothing						%>			<input type="hidden" name="vaiid" value="<%=txt%>">	        <input type="submit" name="vai" value="Articolo <%=ucase(request.form("newcodice"))%>">						<%end if%>	        <input type="hidden" name="id" value="<%=request.querystring("id")%>">	      </form>	      	      	      	<%elseif cosa="copiacla" then		idpro=request("idpro")		oper="edit"		set rs=conn.execute ("select prodotti.* from prodotti where idpro="&idpro)				 %>  	        <div id="tabs-2" class="tab-panel">	      <form name="form1" method="post" action="<%=questofile%>?cosa=copiacla&action=copiacla">		  <p>Copia questa classificazione:</p>          <label>settori merceologici</label><br>Il primo è quello predefinito, puoi riordinare i gruppi spostandoli con il mouse			<input type='hidden' name='settori' id='settori' style="width:500px;" value=" "/> <script type="text/javascript">  <%if oper="edit" then	Dim Js	Set Js = jsArray()		''Settore predefinito	set rsm=conn.execute("select settori.* from settori where idsettore="&rs("idcat"))	if not rsm.eof then 		Set Js(Null) = jsObject()		js(null)("id")=rsm("idsettore")		Js(null)("text")=gerarchia_settori_bkw(rsm("idsettore"),"")	end if			set rsm=conn.execute("select settori_prodotti.IDpro, settori.idsettore, settori.Nome_Settore FROM settori INNER JOIN settori_prodotti ON settori.idsettore = settori_prodotti.IDsettore where idpro="&idpro&" and settori_prodotti.IDsettore<>"&rs("idcat"))	do while not rsm.eof		Set Js(Null) = jsObject()		js(null)("id")=rsm("idsettore")		Js(null)("text")=gerarchia_settori_bkw(rsm("idsettore"),"")		rsm.movenext	loop	rsm.close		%>  var vara = <%js.Flush%>;	<%else%>  var vara = '';<%end if%>  $(document).ready(function () {  	$('#settori').select2({  		tags: true,  		multiple: true,  		placeholder: 'Seleziona i settori articolo',  		minimumInputLength: 0,  		allowClear: true,  		initSelection : function (element, callback) {	        callback(vara);	    },  		ajax: {  			quietMillis: 150,  			url: "ajax_function.asp?select2=settori",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  		  	});  	$("#settori").select2("container").find("ul.select2-choices").sortable({	    containment: 'parent',	    start: function() { $("#settori").select2("onSortStart"); },	    update: function() { $("#settori").select2("onSortEnd"); }	});  	$("#settori").select2("data",vara);  });</script>          <br />            <label>Gruppo articoli correlati</label><br>Il primo è quello predefinito, puoi riordinare i gruppi spostandoli con il mouse			<input type='hidden' name='id_pro_consigliati' id='id_pro_consigliati' style="width:500px;" value=" "/><%          Dim Js11	Set Js11 = jsArray()				''gruppo predefinito	if not isnull(rs("id_pro_consigliati")) and rs("id_pro_consigliati")>0 then		set rsm=conn.execute("select articoli_consigliati.id_pro_consigliati, articoli_consigliati.nome_ragruppamento from articoli_consigliati where id_pro_consigliati="&rs("id_pro_consigliati"))		if not rsm.eof then 			Set Js11(Null) = jsObject()			js11(null)("id")=rsm("id_pro_consigliati")			Js11(null)("text")=rsm("nome_ragruppamento")		end if	end if	sql="select articoli_consigliati.id_pro_consigliati, articoli_consigliati.nome_ragruppamento, prodotti_consigliati.idpro FROM articoli_consigliati INNER JOIN prodotti_consigliati ON articoli_consigliati.id_pro_consigliati = prodotti_consigliati.idconsigliato where idpro="&idpro	if not isnull(rs("id_pro_consigliati")) then		sql=sql& " and id_pro_consigliati<>"&rs("id_pro_consigliati")	end if		set rsm=conn.execute(sql)	do while not rsm.eof		Set Js11(Null) = jsObject()		js11(null)("id")=rsm("id_pro_consigliati")		Js11(null)("text")=rsm("nome_ragruppamento")		rsm.movenext	loop	rsm.close		%>	<script>  var varconsigliati = <%js11.Flush%>;<%set js11=nothing%>  $(document).ready(function () {  	$('#id_pro_consigliati').select2({  		tags: true,  		multiple: true,  		placeholder: 'Seleziona i gruppi',  		minimumInputLength: 0,  		allowClear: true,  		initSelection : function (element, callback) {	        callback(varconsigliati);	    },  		ajax: {  			quietMillis: 150,  			url: "ajax_function.asp?select2=consigliati",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  		  	});  	$("#id_pro_consigliati").select2("container").find("ul.select2-choices").sortable({	    containment: 'parent',	    start: function() { $("#id_pro_consigliati").select2("onSortStart"); },	    update: function() { $("#id_pro_consigliati").select2("onSortEnd"); }	});  	$("#id_pro_consigliati").select2("data",varconsigliati);  });</script>            <br />          <label>Tags</label>			<input type='hidden' name='ttags' id='ttags' style="width:500px;" value=" "/>          <br />          <label>Marca modello</label>			<input type='hidden' name='modello' id='modello' style="width:500px;" value=""/><br>			<%if modifiche_rs<>"" then%>			<br>			<p><strong>Copia eseguita</strong></p>			<br>			<%end if%>			<br>  		  <p><strong>Su questi articoli:</strong></p>			<input type='hidden' name='elencoarticoli' id='elencoarticoli' style="width:500px;" value=""/><br>			<input type='hidden' name='idpro'  value="<%=idpro%>"/><br>	        <input type="submit" name="copiacla" value="Conferma" onClick="">			</form> <script type="text/javascript">  <%      if oper="edit" then	Dim Js1	Set Js1 = jsArray()			set rsm=conn.execute("select prodotti_tags.IDpro, tags.idtag, tags.Nometag FROM tags INNER JOIN prodotti_tags ON tags.idtag = prodotti_tags.IDtag where idpro="&idpro)	do while not rsm.eof		Set Js1(Null) = jsObject()		js1(null)("id")=rsm("idtag")		Js1(null)("text")=rsm("nometag")		rsm.movenext	loop	rsm.close	set rsm = nothing		%>  var vartags = <%js1.Flush%>;	<%else %>  var vartags = '';<%end if%>  $(document).ready(function () {  	$('#ttags').select2({  		tags: true,  		multiple: true,  		placeholder: 'Seleziona i tag',  		minimumInputLength: 0,  		allowClear: true,  		initSelection : function (element, callback) {	        callback(vartags);	    },  		ajax: {  			quietMillis: 150,  			url: "ajax_function.asp?select2=tags",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  		  	});  	$("#ttags").select2("data",vartags);  });    <%if oper="edit" then	Dim Js2	Set Js2 = jsArray()	set rsm=conn.execute("select prodotti_marca_modello.IDpro, prodotti_marca_modello.idmodello, marca_modello.Nome,marca_modello.Nomeconmarca FROM marca_modello INNER JOIN prodotti_marca_modello ON marca_modello.id = prodotti_marca_modello.IDmodello where idpro="&idpro&" ")	do while not rsm.eof		Set Js2(Null) = jsObject()		js2(null)("id")=rsm("idmodello")		Js2(null)("text")=rsm("nomeconmarca")		rsm.movenext	loop	rsm.close	set rsm=nothing	%>  var varmodelli = <%js2.Flush%>;	<%else%>  var varmodelli = '';<%	end if%>  $(document).ready(function () {  	$('#modello').select2({  		tags: true,  		multiple: true,  		placeholder: 'Seleziona i modelli compatibili',  		minimumInputLength: 0,  		allowClear: true,  		initSelection : function (element, callback) {	        callback(varmodelli);	    },  		ajax: {  			quietMillis: 150,  			url: "searcher.asp?cosa=modelli",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  		  	});  	$("#modello").select2("data",varmodelli);  });    $(document).ready(function () {  	$('#elencoarticoli').select2({  		tags: true,  		multiple: true,  		placeholder: 'Seleziona gli articoli',  		minimumInputLength: 0,  		allowClear: true,  		initSelection : function (element, callback) {	        //callback(varmodelli);	    },  		ajax: {  			quietMillis: 150,  			url: "ajax_function.asp?select2=articoli_sel2",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  		  	});  });</script>                            </div>	      	      	      	<%		Set rs = Nothing		elseif cosa="eli" then	sql="select fileimg, codice, articolo  from prodotti where idpro=" & request.querystring("id")	rs=conn.execute (sql)	Set fsoMyFile = CreateObject("Scripting.filesystemObject")	strfile=Server.MapPath(imgdir&rs("fileimg"))	if fsoMyFile.FileExists(strfile)=true then		txt= " e file immagine"	end if	Set fsoMyFile = Nothing		%>	<form name="form1" method="post" action="<%=questofile%>?cosa=eli&action=eli">        <br>        <table border="1" cellpadding="0" cellspacing="0">          <tr>            <td colspan="2" align="center">Elimina articolo</td>          </tr>          <tr>             <td align="center">&nbsp;Codice&nbsp;</td>            <td align="left">&nbsp;Articolo&nbsp;</td>          </tr>          <tr>             <td align="center"><b>&nbsp;<%=rs("codice")%>&nbsp;</b></td>            <td align="left"><b>&nbsp;<%=rs("articolo")%>&nbsp;</b></td>          </tr>        </table>		<%				set rs = nothing		%>  <br>        Conferma eliminazione articolo<%=txt%>:        <input type="submit" name="elimina" value="Si">  <input type="submit" name="elimina" value="No">        <input type="hidden" name="id" value="<%=request.querystring("id")%>">      </form>  	  	  	  	  	  <%end if 'cosa="eli"	  	  call connclose()	  %>        <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%sub elimina_file(pathAndFilename)	dim MapPathPathAndFilename	Set fsoMyFile = CreateObject("Scripting.filesystemObject")	MapPathPathAndFilename=Server.MapPath(pathAndFilename)			if fsoMyFile.FileExists(MapPathPathAndFilename) then				testo=testo&VbCrLf&"File eliminato"				fsoMyFile.DeleteFile(MapPathPathAndFilename)				str_log=str_log&"Eliminato file "&pathAndFilename&"<br>"			else				str_log=str_log&VbCrLf&"File "&pathAndFilename&" non trovato"			end if	Set fsoMyFile = Nothingend sub%>