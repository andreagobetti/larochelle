g=txt_log&"Duplicato "&num&" varianti_b"&vbcrlf								'duplico brand				sql="INSERT INTO prodotti_brand ( IDbrand,idpro) select prodotti_brand.IDbrand, "&new_idpro&" FROM prodotti_brand WHERE (((prodotti_brand.idpro)="&idpro &"));"				conn.execute sql,num				txt_log=txt_log&"Duplicato "&num&" brand"&vbcrlf								'duplico dettagli				sql="INSERT INTO prodotti_dettagli ( idpro, titolo, titolo_en, testo, testo_en, ordine, inschedaarticolo ) select "&new_idpro&", prodotti_dettagli.titolo, prodotti_dettagli.titolo_en, prodotti_dettagli.testo, prodotti_dettagli.testo_en, prodotti_dettagli.ordine, prodotti_dettagli.inschedaarticolo FROM prodotti_dettagli WHERE (((prodotti_dettagli.idpro)="&idpro &"));"				conn.execute sql,num				txt_log=txt_log&"Duplicato "&num&" dettagli prodotto"&vbcrlf								'duplico prodotti_marca_modello				sql="INSERT INTO prodotti_marca_modello ( idmodello,idpro) select prodotti_marca_modello.idmodello, "&new_idpro&" FROM prodotti_marca_modello WHERE (((prodotti_marca_modello.idpro)="&idpro &"));"				conn.execute sql,num				txt_log=txt_log&"Duplicato "&num&" marca e modello"&vbcrlf								'duplico settori				sql="INSERT INTO settori_prodotti ( IDsettore,idpro) select settori_prodotti.IDsettore, "&new_idpro&" FROM settori_prodotti WHERE (((settori_prodotti.idpro)="&idpro &"));"				conn.execute sql,num				txt_log=txt_log&"Duplicato "&num&" settori"&vbcrlf								'duplico tags				sql="INSERT INTO prodotti_tags ( IDtag,idpro) select prodotti_tags.IDtag, "&new_idpro&" FROM prodotti_tags WHERE (((prodotti_tags.idpro)="&idpro &"));"				conn.execute sql,num				txt_log=txt_log&"Duplicato "&num&" tags"&vbcrlf								'duplico correlati				sql="INSERT INTO prodotti_consigliati ( idconsigliato,idpro) select prodotti_consigliati.idconsigliato, "&new_idpro&" FROM prodotti_consigliati WHERE (((prodotti_consigliati.idpro)="&idpro &"));"				conn.execute sql,num				txt_log=txt_log&"Duplicato "&num&" consigliati"&vbcrlf								if requ