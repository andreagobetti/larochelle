inativo_da&"</a> a <a href='pag_adm_user.asp?iduser="&A_utente_hidden&"> utente "&nominativo_a&"</a>"	oper="view"end ifif request.form("step")="1" thenoper="conferma"end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><script Language="JavaScript"> function Valida() {		if ((document.form1.Da_utente_hidden.value == '' )) {		alert("Inserire il nominativo nella casella Da utente.");		document.form1.Da_utente.focus();		return false;	}	if ((document.form1.A_utente_hidden.value == '' )) {		alert("Inserire il nominativo nella casella A utente.");		document.form1.A_utente.focus();		return false;	}	if ((document.form1.Da_utente_hidden.value == document.form1.A_utente_hidden.value )) {		alert("Gli utenti devono essere differenti.");		document.form1.Da_utente.focus();		return false;	}	document.form1.submit();} </script><script type="text/javascript" src="js/ajax.js"></script>	<script type="text/javascript" src="js/ajax-dynamic-list.js">	/************************************************************************************************************	(C) www.dhtmlgoodies.com, April 2006		This is a script from www.dhtmlgoodies.com. You will find this and a lot of other scripts at our website.			Terms of use:	You are free to use this script as long as the copyright message is kept intact. However, you may not	redistribute, sell or repost it without our permission.		Thank you!		www.dhtmlgoodies.com	Alf Magne Kalleland		************************************************************************************************************/		</script>    <style type="text/css">	/* Big box with list of options */	#ajax_listOfOptions{		position:absolute;	/* Never change