<!--#include virtual="/setup.asp" --><%'if session("idadmin") = "" then call login()if request("c")<>"" then	response.cookies(request("c"))(request("k")) =""end ifif request("reset")<>"" then	' Application.Contents.RemoveAll	For i = 1 To Application.Contents.Count	    Application.Contents.Remove(Application.Contents.key(i))	nextend if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body><div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa">  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>" class="Amministra_piccolo">Variabili</a></div></div><!-- Box CORPO INIZIO-->		        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="3" class="ui-widget-header">Scegli il tipo <span style="float:right;"><a href="<%=Request.ServerVariables("Script_Name")%>?reset=si">Azzera         variabili</a> </span></td>          </tr>          <tr>             <td width="33%"><a href="<%=questofile%>?oper=cookie">Cookie</a></td>            <td width="33%"><a href="<%=questofile%>?oper=session">Variabili               Session</a></td>            <td width="33%"><a href="<%=questofile%>?oper=application">Variabili               Application</a></td>          </tr>        </table>        <%oper=request("oper")select case opercase "cookie"%>        <table width="100%"  border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>            <td colspan="2" class="ui-widget-header">Cookie</td>          </tr><%	For Each cookie in Request.Cookies	%>          <tr bgcolor="#E5E5E5">             <td colspan="2" style="border-top:1px solid; border-bottom:1px solid;"><b><%=cookie%></b></td>          </tr>          <tr>             <td>&nbsp;&nbsp;&nbsp;&nbsp;</td>            <td>               <%	  If request(cookie).HasKeys Then		For Each key in Request.Cookies(cookie)		 %> <a href="<%=Request.ServerVariables("Script_Name")%>?c=<%=cookie%>&k=<%=key%>&oper=cookie">               <%		 Response.Write  "(" & key & ") = " & Request.Cookies(cookie)(key) & "<br>"	%>              </a> <%		Next	  Else		Response.write(cookie & " = " & Request.Cookies(cookie) & "<br>")	  End If%>            </td>          </tr>        <%Next%>        </table>						        <%case "session"VariabiliSession=Session.Contents.Count%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="2" class="ui-widget-header">Variabili Session attive:               <%= VariabiliSession%></td>          </tr>          <tr>             <td  style="border-bottom:1px solid;">Session ID</td>            <td  style="border-bottom:1px solid;"><%=Session.SessionID%></td>          </tr>          <%For I=1 to VariabiliSession%>          <tr>             <td style="border-bottom:1px solid;"><%=Session.Contents.Key(I)%></td>            <td style="border-bottom:1px solid;"><%=Session.Contents.Item(I)%></td>          </tr>          <%  next  %>        </table>        <%case "application"%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan=2 class="ui-widget-header"><b>Variabili Application attive: <%= Application.Contents.Count%></b></td>          </tr>          <%For I=1 to Application.Contents.Count%>          <tr>             <td style="border-bottom:1px solid;">&nbsp;<%=Application.Contents.key(i)%></td>            <td style="border-bottom:1px solid;"> &nbsp;               <%				if instr(Application.Contents.key(i),"cache")=0 then					If IsObject(Application.Contents(i)) Then						Response.Write " e' utilizzato come <b>""Oggetto""</b>" & "<BR>"							    ElseIf IsArray(Application.Contents(i)) Then						Response.Write " e' utilizzato come <b>""array""</b>" & "<BR>"										aLMatrice = Application.Contents(i)										For y = 0 to Ubound(aLMatrice)							    Response.write "&nbsp;&nbsp;&nbsp;elemento " & y & " - " & aLMatrice(y) & "<br>"							Next			 					Else							Response.Write   Application.Contents(i) 					End If				else					if Application.Contents(i) <>"" then response.write "Cache OK"				end if		%>            </td>          </tr>          <%  next  %>        </table>        <%end select				call connclose()%>       <!-- Box CORPO FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>