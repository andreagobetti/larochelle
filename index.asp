<!--#include virtual="/setup.asp" --><%if request.querystring("logout")<>"" then	Session.Contents.remove("iduser")	Session.Contents.remove("idadmin")	Session.Contents.remove("admin_l")	Session.Contents.remove("idagente")	Session.Contents.remove("permessi")	'Session.Abandon	response.cookies(nomesito)("remlogin") = ""end ifif Request.querystring("lang")<>"" then	call determina_lingua()end ifselect2=true%><!--#include virtual="/config/header_inc.asp" -->        <section id="content"><%dim num_contenuti,index_layoutindex_layout=split(get_index_layout(),"|")num_contenuti=ubound(index_layout)if num_contenuti>0 then	if index_layout(0)="sliderrev" then		call slider_rev()	end ifend if%>        	<div class="md-margin"></div><!-- Space -->        	<div class="container">			<div class="row">				<div class="col-md-12">	        			<!--#include virtual="/contenuti_home.asp" -->	        			<%		        			'if Application("cache_contenuti_home"&lingua)="" then							if Application("cache_contenuti_home"&lingua)="" then								dim cache_tmp_home			        			cache_tmp_home=""			        			'Output dei contenuti			        			for n=0 to num_contenuti			        				select case index_layout(n)			        				case "brandslider"			        					cache_tmp_home=cache_tmp_home& brand_slider_container()			        				case "nuoviarticoli"										session("nuoviarticolili")="si"			        					cache_tmp_home=cache_tmp_home& new_items()			        				case "gruppihome"			        					cache_tmp_home=cache_tmp_home& products_tabs()			        				case "promozione"			        					cache_tmp_home=cache_tmp_home& hot_items()			        				case "contenuto1"										cache_tmp_home=cache_tmp_home& contenuto_libero(1)			        				case "contenuto2"										cache_tmp_home=cache_tmp_home& contenuto_libero(2)			        				case "contenuto3"										cache_tmp_home=cache_tmp_home& contenuto_libero(3)			        				case "contenuto4"										cache_tmp_home=cache_tmp_home& contenuto_libero(4)			        				case "contenuto5"										cache_tmp_home=cache_tmp_home& contenuto_libero(5)			        				case "sliderrev"										cache_tmp_home=cache_tmp_home& slider_rev()			        				case "materiali"										cache_tmp_home=cache_tmp_home& materiali_tabs()									case "marcamod"										'Risolvere problema script										application("script_marcamodello")=true										cache_tmp_home=cache_tmp_home& marcamod()									case "news"										cache_tmp_home=cache_tmp_home& latestnews_slider()									case else										session("nonriconosciuto")=index_layout(n)			        				end select			        			next			        			Application.Lock			        			Application("cache_contenuti_home"&lingua)=cache_tmp_home								Application.unlock								add2log "Ricreata cache "&"cache_contenuti_home"&lingua,1		        			end if		        			%>		        			<%		        			if utente_ha_il_permesso("B1") and utente_ha_il_permesso("A1") then %>		        			<header class="content-title">		        			<h1 class="title">Foglio spettanze</h1>		        			<p>			        			Siete abilitati alla compilazione del foglio spettanze da allegare all'ordine.</p>		        			</header>			        			<h3>Aggiunta articoli al foglio spettanze</h3>			        			<p>Gli articoli selezionati come preferiti verranno visualizzati nelle righe del foglio spettanze.<br>			        			Potete selezionare gli articoli da aggiungere al foglio spettanze navigando nel nostro catalogo e selezionando gli articoli come preferiti.<br>								Potete aggiungere tutti gli articoli di una categoria cliccando sulla voce <b>Aggiungi tutti a preferiti</b> nel menu <b>Operazioni</b> in fondo alla pagina della categoria</p>								<h3>Aggiunta dipendenti al foglio spettanze</h3>			        			<p>			        			Cliccando sulla voce dipendenti potete aggiungere o modificare nominativi dei dipendenti che verranno visualizzati nelle colonne del foglio spettanze.</p>			        			<p><strong>Trovate i link per accedere agli articoli preferiti, ai dipendenti e al foglio spettanze in alto a destra di ogni pagina.</strong><br>			        			<strong>I dati raccolti verranno utilizzati unicamente per perseguire le finalita&#768; del servizio e in nessun caso verranno comunicati a terzi. </strong>		        			</p>		        			<div class="md-margin"></div><!-- space -->		        			<%			        			end if		        			Response.write Application("cache_contenuti_home"&lingua)		        			%>					</div><!-- End .col-md-12 -->				</div><!-- End .row -->			</div><!-- End .container -->        </section><!-- End #content --><!--#include virtual="/footer_inc.asp" -->	<!-- END -->    <%page_script="default"%>	<!--#include virtual="/script_inc.asp" --><script src="Jquery/js/select2/select2.min.js"></script><script src="Jquery/js/select2/select2_locale_it.js"></script><script>$(function() {	// Slider Revolution	jQuery('#slider-rev').revolution({	    delay:8000,	    startwidth:1170,	    startheight:400,	    onHoverStop:"true",	    hideThumbs:250,	    navigationHAlign:"center",	    navigationVAlign:"bottom",	    navigationHOffset:0,	    navigationVOffset:20,	    soloArrowLeftHalign:"left",	    soloArrowLeftValign:"center",	    soloArrowLeftHOffset:0,	    soloArrowLeftVOffset:0,	    soloArrowRightHalign:"right",	    soloArrowRightValign:"center",	    soloArrowRightHOffset:0,	    soloArrowRightVOffset:0,	    touchenabled:"on",	    stopAtSlide:-1,	    stopAfterLoops:-1,	    dottedOverlay:"none",	    fullWidth:"on",	    spinned:"spinner5",	    shadow:0,	    hideTimerBar: "on",	    // navigationStyle:"preview4"	  });<%if application("script_marcamodello")=true then %>  	var idmarca,idserie,idmodello;	$('#marca').select2({  		minimumInputLength: 0,  		//allowClear: true,  		ajax: {  			quietMillis: 150,  			url: "searcher.asp?cosa=marca",  			dataType: 'json',  			data: function (term, page) {  				return {  					term: term  				};  			},  			results: function (data) {  				return {  					results: data  				};  			}  		}  	});  	$("#marca").on('select2-selecting', function(e) {		idmarca=e.object.id;		console.log(idmarca);		$("#serie").attr("readonly", false);		$('#serie').select2({			minimumInputLength: 0,			//allowClear: true,			ajax: {	  			quietMillis: 150,	  			url: "searcher.asp?cosa=modello&idmarca="+idmarca,	  			dataType: 'json',	  			data: function (term, page) {	  				return {	  					term: term	  				};	  			},	  			results: function (data) {	  				return {	  					results: data	  				};	  			}	  		}	  	});	  	$("#serie").on('select2-selecting', function(e) {			idserie=e.object.id;			console.log(idserie);			$("#modello").attr("readonly", false);		});    });      	$("#serie").on('select2-selecting', function(e) {		idmarca=e.object.id;		console.log(idmarca);		$("#modello").attr("readonly", false);		$('#modello').select2({			minimumInputLength: 0,			//allowClear: true,			ajax: {	  			quietMillis: 150,	  			url: "searcher.asp?cosa=modello&idmarca="+idmarca,	  			dataType: 'json',	  			data: function (term, page) {	  				return {	  					term: term	  				};	  			},	  			results: function (data) {	  				return {	  					results: data	  				};	  			}	  		}	  	});	  	$("#modello").on('select2-selecting', function(e) {			idmodello=e.object.id;			console.log(idmarca);			location.replace("category.asp?idmodello="+idmodello);		});    });<%end if %>});</script>    </body></html><!--#include virtual="/dettaglio_inc.asp" --><%function get_index_layout()	dim stringa, rs_layout	stringa=""	if application("cache_index_layout")="" then		set rs_layout=conn.execute ("select layout.* from layout where pagina='index.asp' order by ordine")		do while not rs_layout.EOF			if stringa<>"" then stringa=stringa&"|"			stringa=stringa&rs_layout("contenuto")			rs_layout.MoveNext		loop		set rs_layout=Nothing		Application.Lock		Application("cache_index_layout")=stringa		Application.Unlock	end if	get_index_layout=Application("cache_index_layout")end function%>