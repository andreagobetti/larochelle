<%'Verifica chiusure 30_11_2015%><!--#include virtual="/setup.asp" --><%idpro=request("idpro")if idpro=""  then 	session("codice_errore")=3	session("oggetto_errore")=idpro	call connclose()	response.redirect ("404.asp")end ifif not isnumeric(idpro)  then	call determina_sqlinjection(idnews&chk)	session("codice_errore")=3	session("oggetto_errore")=idpro	call connclose()	response.redirect ("404.asp")end ifsql="select * from prodotti where idpro="&idproset rs_prodotto=conn.execute(sql)if rs_prodotto.eof then	session("codice_errore")=3	session("oggetto_errore")=idpro	set rs_prodotto = Nothing	call connclose()	response.redirect ("404.asp")end if'meta_title=rs_prodotto("titolo"&lingua)	%><!--#include virtual="/config/header_inc.asp" -->        <section id="content">        	<div id="breadcrumb-container">        		<div class="container">					<ul class="breadcrumb">						<li><a href="/">Home</a></li>						<li class="active">Immagini <%=rs_prodotto("articolo"&lingua)%></li>					</ul>        		</div>        	</div>        	<div class="container">        		<div class="row">        			<div class="col-md-12">						<header class="content-title">							<h1 class="title">Galleria immagini</h1>						</header>        				<%set rs_files=conn.execute("select * from files where idcosa="&idpro &" and cosa=4 order by ordine")	        				        			row=true	        			n=1	        			 do while not rs_files.EOF	        			 	        			 if n=1 then %>         				<div class="xs-margin"></div><!-- space -->        				<div class="row">	        			 <%		        			 end if		        			 	 		        		n=n+1	 	 						path=rs_files("path")		        			  %>        					<div class="col-md-3 col-sm-6 col-xs-12">	        					<a data-rel="prettyPhoto[product]" href="<%=path&rs_files("filename")%>" data-image="<%=path&rs_files("filename")%>" data-zoom-image="<%=path&rs_files("filename")%>"><img src="<%=path&"s/"&rs_files("filename")%>" ></a>	        					        					</div><!-- End .col-md-12 -->        					<%	        					if n>=5 then %>		        				</div><!-- End .row -->	        						        					<%		        					n=1		        					end if	        			 	        			  rs_files.MoveNext	        			  	        			  loop		        			set rs_files = nothing	        			set rs_prodotto = nothing	        			%>        				        				        			</div><!-- End .col-md-12 -->        		</div><!-- End .row -->			</div><!-- End .container -->        </section><!-- End #content -->	<!--#include virtual="/footer_inc.asp" -->    <!-- END -->	<!--#include virtual="/script_inc.asp" -->    </body></html>