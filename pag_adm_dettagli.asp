<%'Verifica chiusure 05_12_2015%><!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()'for each item in Request.Form'  Response.write item & ": " & Request.Form(item) & "<br>"'nextpuls_new="Nuovo contenuto"idpro=request("idpro")goback=request("goback")'------------------------------------sqlbase="select * from prodotti_dettagli "oper=request.form("oper")if request.form("elimina")<>"" then	sql="DELETE  FROM prodotti_dettagli WHERE id=" & request.form("id") 	conn.execute(sql)	if goback<>"" then response.redirect "product.asp?idpro="&idpro	sql=""end ifselect case lcase(request("oper"))	case "annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case else		oper="view"		if request("modifica")<>"" then			oper="edit"			id=request("modifica")		end ifend selectif oper="add" or oper="update" then	'controlliend ifif oper="add" or oper="update" then	Set rs = Server.CreateObject("ADODB.Recordset")	Set rs = Server.CreateObject("ADODB.Recordset")	if oper="add" then		rs.Open sqlbase, conn, 3, 3		rs.addnew        rs("idpro")=idpro		'rs("ordine")=MaxDiordine	else		sql= sqlbase & " where id=" & request.form("id")		rs.Open sql, conn, 3, 3	end if	rs("titolo")=firstup(trim(request.form("titolo")))	rs("testo")=trim(request.form("testo"))	if edit_lang_en then		rs("titolo_en")=firstup(trim(request.form("titolo_en")))		rs("testo_en")=trim(request.form("testo_en"))	end if	if request.form("inschedaarticolo")="si" then		rs("inschedaarticolo")=true	else		rs("inschedaarticolo")=false	end if	txt=trim(request.form("ordine2"))	if txt="" then txt=0	rs("ordine")=txt	rs.update    idpro= rs("idpro")	rs.close	Set rs = Nothing	call riordina (idpro)	if goback<>"" then response.redirect "product.asp?idpro="&idpro	oper="view"	'response.redirect Request.ServerVariables("Script_Name")end ifsub riordina(idpro)	sql="select * from prodotti_dettagli where  idpro=" & idpro&" order by ordine;"	'response.write sql	Set rs = Server.CreateObject("ADODB.Recordset")	rs.open sql, conn,3,3	'response.end	ordine=10	do while not rs.eof	rs("ordine")=ordine	rs.update	ordine=ordine+10	rs.movenext	loop	rs.close	Set rs = Nothingend sub%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><SCRIPT language=JavaScript>function editor(from) {   popupWin = window.open('editor/editor.asp?from='+from,'editor','toolbar=no,width=700,height=525,location=no,directories=no,status=no,menubar=no,toolbar=no,resizable=yes,scrollbars=yes');  popupWin.focus();}</script><%if oper="new" or oper="edit" then%><!--#include virtual="/tinymce4_conf1.asp" --><%end if%></head><body><div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa"> <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Gestisci pannelli articolo</a></div></div>        <!-- Box CORPO INIZIO-->		<form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;">        <%		if oper="view" thenordine=request.form("ordine")cercain=request("cercain")if trim(request.form("tipo"))<>"" then cercain=trim(request.form("tipo"))sql=""%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="5" align="right" style="border-bottom:1px solid;"><a href="<%=questofile%>?oper=new&idpro=<%=idpro%>"><strong>Nuovo                contenuto</strong></a></td>            </tr>            <%	sql= sqlbase & " where idpro="&idpro	'response.write sql	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="modifica" value="<%=rs("id")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><a href="../pag_singprodotti_dettagli.asp?n=<%=rs("id")%>" target="_blank"><%=rs("id")%>-<%=rs("titolo")%></a></td>            </tr>            <%	rs.movenext	loop	set rs = Nothing	%>          </table>          <%else	'--  SEZIONE MODIFICA  --  SEZIONE MODIFICA--  SEZIONE MODIFICA--  SEZIONE MODIFICA--  SEZIONE MODIFICA	if oper<>"new" then		set rs=conn.execute(sqlbase& " where id =" & id)		idpro=rs("idpro")		titolo= "Modifica pannello"			else		titolo= "Inserimento nuovo pannello"	end if	%>          <input type="hidden" name="id" value="<%=id%>"><input type="hidden" name="idpro" value="<%=idpro%>"><input type="hidden" name="goback" value="<%=goback%>">          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="3" class="ui-widget-header"><%=titolo%>                </td>            </tr>          </table>		  <div id="linguatabs">		  <ul>			<li><a href="#lingua-it"><img src="images/it.png"/></a></li>			<li><a href="#lingua-en"><img src="images/en.png"/></a></li>		  </ul>		  		  <div id="lingua-it">            <label>Titolo pannello</label>                           <%if error<>"" then			  		testo=request.form("titolo")				elseif oper="edit" then					testo=rs("titolo")			  	elseif oper="new" then			  		testo=""				end if%> <input type="text" name="titolo" value="<%=fixquotes(testo)%>" size="40"><br />				            <label>Testo</label>                <%if error<>"" then			  		testo=request.form("testo")				elseif oper="edit" then					testo=rs("testo")			  	elseif oper="new" then			  		testo=""				end if%> <textarea name="testo" class="mceEditor" cols="40" rows="20" style="width:100%"><%=Testo%></textarea> 		  </div>		  <div id="lingua-en">			<label>Titolo </label>              <%if error<>"" then			  		testo=request.form("titolo_en")				elseif oper="edit" then					testo=rs("titolo_en")			  	elseif oper="new" then			  		testo=""				end if%> <input type="text" name="titolo_en" value="<%=fixquotes(testo)%>" size="40"><br/>				              <label>Testo </label>                <%if error<>"" then			  		testo=request.form("testo_en")				elseif oper="edit" then					testo=rs("testo_en")			  	elseif oper="new" then			  		testo=""				end if%> <textarea name="testo_en" class="mceEditor" cols="40" rows="20" style="width:100%"><%=Testo%></textarea> 		  </div>		<label>Visualizza questo pannello nel PDF scheda articolo</label>		<%val=""			if oper="edit" then				if rs("inschedaarticolo") then val=" checked"			elseif oper="new" then				val=""			else				val=request.form("inschedaarticolo")				if val="si" then val=" checked"			end if			if val<>" checked" then val=""			%>              <input type="checkbox" name="inschedaarticolo" value="si" title="Visualizza il dettaglio nella scheda articolo." <%response.write val%><%if view="view" then response.write " disabled"%>><br/>              <label>Ordine:</label>                       <%if error<>"" then			  		val=request.form("ordine")				elseif oper="edit" then					val=rs("ordine")			  	elseif oper="new" then					sql_max="select Max(prodotti_dettagli.ordine) AS MaxDiordine FROM prodotti_dettagli GROUP BY prodotti_dettagli.idpro HAVING (((prodotti_dettagli.idpro)="&idpro&"));"					set rs_max=conn.execute(sql_max)					if not rs_max.eof then val=rs_max("MaxDiordine")+10 else val=10					set rs_max = Nothing			  						end if%> <input type="text" name="ordine2" value="<%=val%>" size="4"> <br/>        <%if oper="view" then	txt=puls_newelseif oper="new" or error<>"" then	txt="Aggiungi"elseif oper="edit" then	txt="Modifica"end ifset rs = Nothing%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Annulla">    <%end if%>    <%if oper="edit" and num=0 and error="" then%>    <input type="submit" name="elimina" value="Elimina">    <%end ifend ifcall connclose()%>        </form>         <!-- Box CORPO FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div><script>$(function() {	$( "#linguatabs" ).tabs();	$( "#linguatabs" ).show();});</script></body></html>