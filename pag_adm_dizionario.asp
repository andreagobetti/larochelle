<!--#include virtual="/setup.asp" --><!--#include file="JSON_latest.asp"--><%if session("idadmin") = "" then call login()if request("mostrachiavi")<>"" then session("mostrachiavi")=truepagina=request.form("cerca_pagina")if request("cosa")="pagina" then	max=100	Dim Js	Set Js = jsArray()	sql="select DISTINCT pagina FROM traduzioni where pagina like '%"&request("term")&"%' order by pagina"	set rs=conn.execute(sql)	do while (not rs.eof) and i<max		Set Js(Null) = jsObject()		Js(null)("id")=rs("pagina")		Js(null)("text")=rs("pagina")		rs.movenext		i=i+1	loop	set rs=nothing	call connclose()	js.Flush	response.endend ifif request("mostrachiavi")="si" then	 session("mostrachiavi")=trueend ifif request("mostrachiavi")="no" then	 session("mostrachiavi")=falseend ifif request.form("elimina")<>"" then		sql= "DELETE traduzioni.id FROM traduzioni WHERE id=" & request("id_it")  		conn.execute(sql)		'response.redirect questofileend ifselect case lcase(request("oper"))	case "annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case "edit"		oper="edit"		idcat=request("idcat")	case else		if request("modifica")<>"" then			oper="edit"		else			oper="view"		end ifend selectif oper="update" then	sql="select  traduzioni.* FROM traduzioni where id="&request("id_it")	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 3, 3	old_valore=rs("valore")	old_valore_en=rs("valore_en")	rs("valore")=request.form("valore_it")	rs("valore_en")=request.form("valore_en")	rs.update	new_valore=rs("valore")	new_valore_en=rs("valore_en")	add2log "Modificato chiave dizionario "&rs("pagina")&" "&rs("chiave")&" eseguita da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]"&vbcrlf&"old_valore:"&old_valore&vbcrlf&"new_valore:"&new_valore&vbcrlf&"old_valore_en:"&old_valore_en&vbcrlf&"new_valore_en:"&new_valore_en,2	rs.close	'call reconfig	oper="view"end ifif oper="add" then	sql="select  traduzioni.* FROM traduzioni "	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 3, 3	rs.addnew	if request("pagina_new")<>"" then		rs("pagina")=request("pagina_new")	else		rs("pagina")=request("pagina")	end if	rs("chiave")=request("chiave")	rs("valore")=request.form("valore_it")	rs("valore_en")=request.form("valore_en")	rs.update	add2log "Aggiunto chiave dizionario "&rs("pagina")&" "&rs("chiave")&" eseguita da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2	rs.close	pagina=request("pagina")	'call reconfig	oper="view"end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><link rel="stylesheet" type="text/css" href="Jquery/css/select2.css"/><!--TINY MCE--><script type="text/javascript" src="/Jquery/js/tinymce/tinymce.min.js"></script><script type="text/javascript" src="tinymce4_conf3.js"></script></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Gestione dizionario</a></div><form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >               <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr >             <td colspan="4" style="border-bottom:1px solid;">                            <select name="cerca_pagina" onchange="this.form.submit();"><%	sql="select DISTINCT pagina FROM traduzioni  order by pagina"	set rs=conn.execute(sql)	do while (not rs.eof) 	response.write "<option value=""" & rs("pagina") &""""if pagina=rs("pagina") then response.write " selected"response.write ">" & rs("pagina")& "</option>"rs.movenextloopSet rs = Nothing%></select>             <input type="submit" name="Submit" value="Vedi traduzioni" style="FONT: 12px;"> <%if session("mostrachiavi")=true then%> <a href="<%=questofile%>?mostrachiavi=no">Nascondi chiavi</a><%else%><a href="<%=questofile%>?mostrachiavi=si">Mostra chiavi</a><%end if%>              </td>          </tr></table>                  <%		modifica=request("modifica")		if pagina<>"" and modifica=""  then%>		<%	sql="select  traduzioni.* FROM traduzioni where  pagina='"&pagina&"' order by chiave"	set rs=conn.execute(sql)%>        <table width="100%" border="1" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="4" class="ui-widget-header">Traduzioni per pagina <a href="<%=pagina%>" target="_blank"><%=pagina%></a><input type="hidden" name="pagina" value="<%=pagina%>" /><span style="float:right;">                <input type="button"  value="Nuova chiave" style="FONT: 12px;" onclick="window.location.href='<%=questofile%>?oper=new&pagina=<%=pagina%>'"></span> </td>          </tr>          <tr>		  <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Modifica</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Chiave</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Valore IT</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Valore <img src="images/en.png"/></td>           </tr><%do while not rs.eof%>          <tr>            <td style="border-bottom:1px solid;"><input type="radio" name="modifica" value="<%=rs("pagina")%>|<%=rs("chiave")%>" onClick="this.form.submit()"> </td>             <td  style="border-bottom:1px solid;"><%=rs("chiave")%></td>            <td  style="border-bottom:1px solid;"><%=rs("valore")%></td>            <td  style="border-bottom:1px solid;"><%=rs("valore_en")%></td>          </tr><%rs.movenextloopSet rs = Nothing%>		  </table><%end ifif oper="edit" or oper="new" then	if oper="edit" then		modifica=split(modifica,"|")		sql="select  traduzioni.* FROM traduzioni where pagina='"&modifica(0)&"' and chiave='"&modifica(1)&"' "		'response.write sql		set rs=conn.execute(sql)	end if	if oper="new" then	pagina=request.querystring("pagina")	end if		%>	<table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" valign="top" class="ui-widget-header"><%=testo%></td>            </tr>			<%if oper="new" then%>	    <tr>	      <td valign="top">Pagina</td>		      <td><input name="pagina_new" type="text" class="richiesto"  value="" size="40" /></td>        </tr>			<%end if%>	    <tr>               <td valign="top"><input type="hidden" name="pagina" value="<%=pagina%>"/>Chiave</td>              <td>                  <input name="chiave" type="text" class="richiesto"  value="" size="40">               </td>            </tr>					<tr>               <td valign="top">Valore it</td>              <td>                 <%if error<>"" then			  		testo=request.form("valore_it")				elseif oper="edit" then					testo=rs("valore")					%><input type="hidden" name="id_it" value="<%=rs("id")%>"> <%			  	elseif oper="new" then			  		testo=""				end if%> <textarea name="valore_it"  class="richiesto mceEditor"  size="40"><%=testo%></textarea>              </td>            </tr>            <tr>               <td valign="top">Valore en</td>              <td>  <%if error<>"" then			  		testo=request.form("valore_en")				elseif oper="edit" then					testo=rs("valore_en")					%><input type="hidden" name="id_en" value="<%=rs("id")%>"><%			  	elseif oper="new" then			  		testo=""				end if%> <textarea name="valore_en"  class="richiesto mceEditor"  size="40"><%=testo%>  </textarea>              </td>            </tr>            <tr>              <td colspan="2" align="center" valign="top"><%if oper="view" then	txt=puls_newelseif oper="new" or error<>"" then	txt="Aggiungi"elseif oper="edit" then	txt="Modifica"end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then    Set rs = Nothing    %>    <input type="submit" name="oper" value="Annulla" onClick="annulla=true;">    <%end if%>    <%if oper="edit"  and error="" then%>    <input type="submit" name="elimina" value="Elimina">    <%end if%></td>            </tr>          </table>				<%end ifcall connclose()%>          </form>       <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%rsClose%>