ordine = Nothing							sql="select fatture.*, ordini_fatture.idord FROM fatture INNER JOIN ordini_fatture ON fatture.IDfat = ordini_fatture.idfat where  ordini_fatture.idord="&idord							set rs_fatture=conn.execute(sql)														sql="select ddt.* FROM ddt where idord="&idord							set rs_ddt=conn.execute(sql)														if (not rs_fatture.eof) or (not rs_ddt.eof) then 							%>						  	 							<div class="panel"><!-- Documenti--><!-- Documenti--><!-- Documenti--><!-- Documenti--><!-- Documenti-->								<div class="accordion-header">									<div class="accordion-title"><span><%=traduci("step7")%></span></div><!-- End .accordion-title -->									<a class="accordion-btn"  data-toggle="collapse" data-target="#documenti"></a>								</div><!-- End .accordion-header -->																								<div id="documenti" class="collapse in">									<div class="panel-body">										<%										if not rs_fatture.eof then 										pdf_fattura="pdf_fattura"										'if rs_fatture("fine_mese")=false then										'	pdf_fattura="pdf_fattura_acc"										'else										'	pdf_fattura="pdf_fattura_fm"										'end if										%>										<div class="row">											<div class="col-md-6 col-sm-6 col-xs-12">												<div class="input-group">													<span class="input-group-addon"><span class="input-icon input-icon-subject"></span><span class="input-text"><%=traduci("fattura")%></span></span>													<span class="form-control input-lg" > <%=rs_fatture("nfat")%> del <%=formatdatetime(rs_fatture("data"),2)%></span>												</div><!-- End .input-group -->											</div>											<div class="col-md-6 col-sm-6 col-xs-12">																							<a href="<%=pdf_fattura%>.asp?idfat=<%=rs_fatture("idfat")%>&id2=<%=chkDataUser(rs_fatture("data"))%>" class="btn btn-custom-2" id="btnstep5" ><%=traduci("scaricapdf")%></a>																							</div><!-- End .col-md-6 -->										</div><!-- End .row -->												<%												e