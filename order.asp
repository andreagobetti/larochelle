><!-- End .panel-collapse -->							  </div><!-- End .panel -->							  							  <div class="panel"><!-- .panel 3 step--><!-- .panel 3 step--><!-- .panel 3 step--><!-- .panel 3 step--><!-- .panel 3 step-->								<div class="accordion-header">									<div class="accordion-title"><span><%=traduci("step3")%></span></div><!-- End .accordion-title -->									<a class="accordion-btn"   data-toggle="collapse" data-target="#delivery-details"></a>								</div><!-- End .accordion-header -->																<div id="delivery-details" class="collapse in">								  <div class="panel-body">								  <%if rs_ordine("d_indirizzo")="" then%>													 <%=traduci("txt11")%>									<%else %>									<div id="consegna">	  								   <div class="row">										   	<div class="col-md-6 col-sm-6 col-xs-12">			                                    <h2 class="checkout-title"><%=traduci("tit13")%></h2>			                                    <div class="input-group">													<span class="input-group-addon"><span class="input-icon input-icon-company"></span><span class="input-text"><%=traduci("azienda")%></span></span>													<span class="form-control input-lg" ><%=rs_ordine("d_azienda")%></span>												</div><!-- End .input-group -->			                                    <div class="input-group">													<span class="input-group-addon"><span class="input-icon input-icon-address"></span><span class="input-text"><%=traduci("indir")%></span></span>													<span class="form-control input-lg" ><%=rs_ordine("d_indirizzo")%></span>												</div><!-- End .input-group -->												<div class="input-group">													<span class="input-group-addon"><span class="input-icon input-icon-city"></span><span class="input-text"><%=traduci("citta")%></span></span>													<span class="form-control input-lg" ><%=rs_ordine("d_citta")%></span>												</div><!-- End .input-group -->												<div class="input-group">													<span class=