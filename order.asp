i_b.variante_b, prodotti.fileimg FROM ((ordini_dett LEFT JOIN varianti_b ON ordini_dett.idvarb = varianti_b.IDvarb) LEFT JOIN varianti_a ON ordini_dett.idvara = varianti_a.IDvara) LEFT JOIN prodotti ON ordini_dett.idpro = prodotti.IDpro where idord="&idord								tot_carrello=0								Set rs_dett_ordine=conn.Execute(sql)								do while not rs_dett_ordine.EOF								prezzoeff=cdbl(rs_dett_ordine("prezzo"))								prezzoeff=prezzoeff-(cdbl(rs_dett_ordine("sconto_prodotto"))/100*prezzoeff)								fileimg=			rs_dett_ordine("fileimg")												'subtot=prezzoeff*rs_dett_ordine("quantita")								%>									<tr>										<td class="item-name-col">										<%if not isnull(fileimg) then%>											<figure>												<a href="#"><img src="send_img.asp?imgs1=<%=fileimg%>" alt="<%=rs_dett_ordine("articolo_ordine")%>"></a>											</figure>											<%end if%>											<header class="item-name"><a href="product.asp?idpro=<%=rs_dett_ordine("idpro")%>"><%=rs_dett_ordine("articolo_ordine")%></a></header>											 <%											 											 											 txt=""											if rs_dett_ordine("var1")<>"" then												txt ="<li>" & rs_dett_ordine("variante1_ordine") & ": " & rs_dett_ordine("var1") &"</li>"											end if											if rs_dett_ordine("var2")<>"" then												txt =txt & "<li>" & rs_dett_ordine("variante2_ordine") & ": " & rs_dett_ordine("var2")&"</li>"											end if											if txt<>"" then%><ul><%=txt%></ul><%end if																							if cint(rs_dett_ordine("numeri_di_serie"))>0 then																		response.write "<br>"&elenca_seriali(rs_dett_ordine("iddett"),0)											end if																														%>										</td>										<td class="item-code"><%=rs_dett_ordine("codice_ordine")%></td>																				<td class="item-price-col"><%if rs_dett_ordine("quantita")>0 then %><span class="item-price-special"><%=simbolo_valuta&FormatNumber(prezzoeff,2)%></span><%end if%></td>										<td class="item-price-col"><%if rs_dett_ordine("quantita")>0 then %><span class="item-price-special"><%=rs_dett_ordine("quantita")%></span><%end if%></td>										<td class="item-total-col"><%if rs_dett_ordine("quantita")>0 then %><span class="item-price-special"><%=simbolo_valuta&FormatNumber(rs_dett_ordine("totale_riga"),2)%></span><%end if%></td>									</tr>									<%									idpro=rs_dett_ordine("idpro")									tot_carrello=tot_carrello+subtot									rs_dett_ordine.MoveNext									loop									set rs_dett_ordine = Nothing																		%>									</tbody>									 <tfoot>										<tr>											<td class="checkout-table-title" colspan="4"><%=traduci("subtot")%>:</td>											<td class="checkout-table-price"><%=simbolo_valuta&FormatNumber(rs_ordine("totale_merce_ordine"),2)%></td>										</tr>										<tr>											<td class="checkout-table-title" colspan="4"><%=traduci("ship")%>:</td>											<td class="checkout-table-price"><%=simbolo_valuta&FormatNumber(rs_ordine("trasporto"))%></td>										</tr>										<%										spese_bancarie_ordine=cdbl(rs_ordine("spese_bancarie_ordine"))																				if spese_bancarie_ordine>0 then %>										<tr>											<td class="checkout-table-title" colspan="4"><%=traduci("spese_banc")%>&nbsp;:</td>											<td class="checkout-table-price"><%=simbolo_valuta&FormatNumber(rs_ordine("spese_bancarie_ordine"),2)%></td>										</tr>										<%end if										%>										<tr>											<td class="checkout-table-title" colspan="4"><%=traduci("impo")%>&nbsp;:</td>											<td class="checkout-table-price"><%=simbolo_valuta&FormatNumber(cdbl(rs_ordine("totale_merce_ordine"))+cdbl(rs_ordine("trasporto"))+spese_bancarie_ordine,2)%></td>										</tr>										<tr>											<td class="checkout-table-title" colspan="4"><%=traduci("tax")%>&nbsp;<%=rs_ordine("iva_ordine")%>%:</td>											<td class="checkout-table-price"><%=simbolo_valuta&FormatNumber(rs_ordine("imposta_ordine"),2)%></td