<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()if request.form("aggiorna")<>"" then	sql="select * from impostazioni"	rs.Open sql, conn, 3, 3	rs.movefirst	rs("testo_settore")=request.form("testo_settore")	rs("testo_categoria")=request.form("testo_categoria")	rs.update	rs.close	set rs = Nothing	Application("ConfigOk")="" 	call connclose()	response.redirect "pag_cat.asp"end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body><div id="wrap"><div id="header"><%=titolo_top%> </div><div id="sidebar"><!--#include virtual="/sub_menu.asp" --> </div><div id="content_large">        <!-- Div Content INIZIO-->        <div class="Aministra"><a href="pag_adm_main.asp" class="Aministra_rosso" ><span class="rosso">Amministrazione</span></a>&gt;<a href="<%=questofile%>" class="Amministra_piccolo">Intestazione raggruppamenti</a></div>		<%'for each item in Request.Form'  Response.write item & ": " & Request.Form(item) & "<br>"'nextsql="select impostazioni.* FROM impostazioni "Set rs = conn.execute (sql)%>        <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;">          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr class="ui-widget-header">               <td colspan="3" valign="top" class=rigasotto>Setup</td>            </tr>            <tr bgcolor="#E5E5E5">               <td colspan="3" valign="top" class=rigasotto>Impostazioni testi </td>            </tr>            <tr>               <td align="right" valign="top" class=rigasotto>Testo per settore</td>              <td align="right" valign="top" class=rigasotto><img src="images/question_s.gif" style="cursor:hand" alt="Visualizzato nella barra del titolo del browser" width="16" height="16"></td>              <td class=rigasotto> <input type="text" name="testo_settore" value="<%=rs("testo_settore")%>" size="46">              </td>            </tr>            <tr>               <td align="right" valign="top" class=rigasotto>Testo per categoria<br> </td>              <td align="right" valign="top" class=rigasotto><img src="images/question_s.gif" style="cursor:hand" alt="E' il testo che utilizzer&agrave; il motore di ricerca per descrivere il tuo sito" width="16" height="16"></td>              <td class=rigasotto><input type="text" name="testo_categoria" value="<%=rs("testo_categoria")%>" size="46"></td>            </tr>            <tr>              <td align="right" valign="top" class=rigasotto>&nbsp;</td>              <td align="center" class=rigasotto>&nbsp;</td>              <td class=rigasotto>&nbsp;</td>            </tr>            <tr>               <td colspan="3" align="center" class=rigasotto> <input name="Aggiorna" type="submit" id="Aggiorna" value="Aggiorna">              </td>            </tr>          </table>        </form>        <!-- Div Content FINE-->        <%	        set rs = Nothing	        call connclose()	        	        	        %></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>