<%'Verifica chiusure 04_12_2015%><!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><%if session("idadmin") = "" then call login()tdebug=falsedamese=request("damese")amese=request("amese")	anno=request("anno")if not tdebug then	Response.ContentType = "application/vnd.ms-excel"else	Response.ContentType = "text/html"end if	if not tdebug then Response.AddHeader "content-disposition", "attachment; filename=fatture_"&nome_mese(damese)&"_"&nome_mese(amese)&"_"&anno&".xls"sql="select fatture.IDfat, fatture.Nfat,fatture.fattura_ce, fatture.pa, i.Azienda, i.Cognome, i.Nome, agenti.Nominativo, fatture.data, utenti.iduser,i.provincia, fatture.totale_fattura, fatture.pagamento, ordini.idord, utenti.tipologia, fatture.trattamento_iva FROM ((agenti RIGHT JOIN utenti ON agenti.IDagente = utenti.idagente) INNER JOIN fatture ON utenti.iduser = fatture.iduser) INNER JOIN ordini ON fatture.idord = ordini.idord inner join utenti_intestazioni i on fatture.idintestazione = i.id "sql=sql & "where month(fatture.data)>="&damese &" and month(fatture.data)<="&amese &" and fatture.anno="&annofiltro_iva=request("iva")colspan=6'Selezione IVAif filtro_iva="1" then	sql=sql& " and ( fatture.trattamento_iva=10)"elseif filtro_iva="2" then	sql=sql& " and fatture.trattamento_iva<>10"elseif filtro_iva="-1" then	separa_iva=true	colspan=colspan+2end ifif request("tipologia")<>"" then sql=sql& " and instr(tipologia,',"&request("tipologia")&",')>0"'Selezione PROVINCIAprovincia=request("provincia")if provincia="raggruppa" then	raggruppa="provincia"	ordine=" order by utenti.provincia, idfat"elseif provincia<>"" then	sql=sql& " and utenti.provincia='"&request("provincia")&"'"	ordine=" order by idfat"else	ordine=" order by idfat"end if'Selezione AGENTEagente=request("agente")if agente="-1" then	colspan=colspan+1	mostra_agente=trueelseif agente<>"" then	colspan=colspan+1	mostra_agente=true	sql=sql& " and utenti.idagente="&agente&""	'response.write "filtro agenet"end ifSet metodipagamento = New ClasseMetodipagamento 'Create an Instance of the ClassSet rs = Server.CreateObject("ADODB.Recordset")rs.Open sql&ordine, conn, 3, 3%>        <table width="100%" border="1" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="<%=colspan%>" class="ui-widget-header">fatture dal mese di <%=nome_mese(damese)%>&nbsp;al mese di <%=nome_mese(amese)%>&nbsp;<%=anno%>: <%=rs.recordcount%> elementi</td>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Fatt.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">ID Cli.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Nominativo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Tot. fattura</td>			<%if separa_iva then%>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">IVA ad esigibilit&agrave; o VS. carico</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Escluso IVA ad esigibilit&agrave; o VS. carico</td>			<%end if%>			<%if mostra_agente then%>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Agente</td>            <%end if%>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Modalit&agrave; pagamento</td>          </tr>          <%Totale=0provincia="0"Do While Not rs.EOF	totale_fattura=cdbl(rs("totale_fattura"))	totale=totale+totale_fattura         if raggruppa_coda and provincia<>ucase(rs("provincia")) then%>                        <tr>                        <td colspan="4"><b>Totali provincia</b></td>            <td  align="right"><strong><%=formatnumber(totale_provincia,2)%></strong></td>			<%if separa_iva then%>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><strong><%=formatnumber(totale_iva2,2)%></strong></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><strong><%=formatnumber(totale_iva,2)%></strong></td>			<%end if%>                        <td colspan="<%=colspan-8%>"></td>          </tr>          <%	totale_provincia=0	raggruppa_coda=false	totale_iva2=0	totale_iva=0		  end if		  	totale_provincia=totale_provincia+totale_fatturaif raggruppa<>"" and provincia<>ucase(rs("provincia")) then%> <tr>             <td bgcolor="#E5E5E5" colspan="<%=colspan%>" ><b>Provincia di <%=rs("provincia")%></b></td>          </tr><%	provincia=ucase(rs("provincia"))	raggruppa_coda=trueend if%>          <tr>            <td style="border-bottom:1px solid;"><%=rs("NFAT")&get_fattura_pa(rs("pa"),rs("fattura_ce"))%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=formatDateTime(rs("data"), vbShortDate)%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=rs("iduser")%></td>            <td nowrap style="border-bottom:1px solid;"><%=denominazione(rs("nome"),rs("cognome"),rs("azienda"))%></td>            <td align="right" class="corpobox" style="border-bottom:1px solid;"><%=formatnumber(totale_fattura,2)%></td>			<%if separa_iva then			iva_tipo_2_10=false			%>            <td style="border-bottom:1px solid;" class="corpobox" align="right">	            <%if rs("trattamento_iva")=10 then	            iva_tipo_2_10=true				totale_iva2=totale_iva2+totale_fattura			%><%=formatnumber(totale_fattura,2)%><%end if%></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><%if iva_tipo_2_10=false then			totale_iva=totale_iva+totale_fattura			%><%=formatnumber(totale_fattura,2)%><%end if%></td>			<%end if%>			<%if mostra_agente then%>            <td style="border-bottom:1px solid;" class="corpobox"><%=rs("nominativo")%></td>			<%end if%>            <td style="border-bottom:1px solid;" class="corpobox"><%=metodipagamento.descrizione(rs("pagamento"))%></td>          </tr><% 		rs.MoveNextLoopset rs = nothingcall connclose()         if raggruppa_coda  then%>            <tr>            <td colspan="4"><b>Totali provincia</b></td>            <td  align="right"><strong><%=formatnumber(totale_provincia,2)%></strong></td>			<%if separa_iva then%>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><strong><%=formatnumber(totale_iva2,2)%></strong></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><strong><%=formatnumber(totale_iva,2)%></strong></td>			<%end if%>                        <td colspan="<%=colspan-8%>"></td>          </tr>          <%	totale_provincia=0	raggruppa_coda=false	totale_iva2=0	totale_iva=0		  end if%>			<%if separa_iva then%>			<tr>				<td></td>				<td></td>				<td></td>				<td></td>				<td></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><strong><%=formatnumber(totale_iva2,2)%></strong></td>            <td style="border-bottom:1px solid;" class="corpobox" align="right"><strong><%=formatnumber(totale_iva,2)%></strong></td>			</tr>			<%end if%>            	<tr>		<td colspan="<%=colspan%>" align="right"><strong>Totale fatture: <%=formatnumber(totale,2)%></strong></td>	</tr></table>