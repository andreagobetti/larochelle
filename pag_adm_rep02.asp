<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()mese=request("mese")if mese="" then	mese="0"end ifanno=request("anno")if anno="" then	anno=year(date())end ifal_iva=1+iva(date())/100%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!-- Stile: <%=Application("skins")%> --><!--#include virtual="/sub_head.asp" --></head><body> <div id="wrap"><div id="header"><%=titolo_top%>         <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Margine lordo</a></div>        <!-- Div Content INIZIO-->        <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;" >               <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="4" class="ui-widget-header">Filtri: </td>          </tr>          <tr >             <td colspan="4" style="border-bottom:1px solid;">Filtri:  <select name="MESE" onChange="this.form.submit()"><option value="0" <%if 0=cint(mese) then response.write " selected" %>>Tutti i mesi</option>                <%for n=1 to nome_mese(0)response.write "<option value='"&n&"'"if n=cint(mese) then response.write " selected"response.write  ">" & nome_mese(n)&"</option>"next%>              </select>                             <input type="text" name="anno" value="<%=anno%>">              <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;"></td>          </tr></table></form>	<%if mese=0 then%>	          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="8" class="ui-widget-header">Totali per mese anno <%=anno%></td>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;" align="center">Mese</td>             <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Importo totale fatture</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Conteggio fatture</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Importo totale ordini</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Conteggio ordini</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Costo totale</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Margine lordo</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Margine lordo &#37;</td>          </tr>		<%				sql="select Year(fatture.data) AS Anno, Month(fatture.data) AS Mese, Sum(fatture.totale_fattura) AS totale_fatture, Sum(subtot_fatture.ConteggioDiidord) AS conteggio_ordini, Sum(subtot_fatture.SommaDicosto_totordine) AS totale_materiali, Sum(subtot_fatture.SommaDiTotale) AS totale_ordini, Count(fatture.IDFat) AS conteggio_fatture FROM fatture INNER JOIN (SELECT ordini_fatture.idfat, Count(ordini.idord) AS ConteggioDiidord, Sum(ordini.costo_totordine) AS SommaDicosto_totordine, Sum(ordini.Totale) AS SommaDiTotale FROM ordini_fatture INNER JOIN ordini ON ordini_fatture.idord = ordini.idord GROUP BY ordini_fatture.idfat) as subtot_fatture ON fatture.IDFat = subtot_fatture.idfat GROUP BY Year(data), Month(data) HAVING ((anno="&anno&"));"									set rs=conn.execute(sql)			totale_fatture=0			Totale_ordini=0			totale_materiali=0			do while not rs.eof			totale_materiali_iva=cdbl(rs("totale_materiali"))*al_iva			totale_fatture=totale_fatture+cdbl(rs("totale_fatture"))			Totale_ordini=Totale_ordini+cdbl(rs("Totale_ordini"))			totale_materiali=totale_materiali+totale_materiali_iva			totale_fatture_tmp=cdbl(rs("totale_fatture"))%>          <tr>            <td style="border-bottom:1px solid;" align="center"><a href="<%=questofile%>?anno=<%=anno%>&mese=<%=rs("mese")%>"><%=rs("mese")%></a></td>             <td align="right" style="border-bottom:1px solid;"><%=formatcurrency(rs("totale_fatture"),0)%></td>			<td align="right" style="border-bottom:1px solid;"><%=rs("conteggio_fatture")%></td>            <td align="right" style="border-bottom:1px solid;"><%=formatcurrency(rs("Totale_ordini"),0)%></td>			<td align="right" style="border-bottom:1px solid;"><%=rs("conteggio_ordini")%></td>			<td align="right"  style="border-bottom:1px solid;"><%=formatcurrency(totale_materiali_iva,0)%> </td>			<td align="right" style="border-bottom:1px solid;"><%=formatcurrency(totale_fatture_tmp-totale_materiali_iva,0)%></td>            <td align="right" style="padding : 0 1 0 1; border-bottom:1px solid;"><%=formatnumber((totale_fatture_tmp-totale_materiali_iva)/totale_fatture_tmp*100,2)%></td>          </tr>          <% 			  rs.movenext        loop		set rs = nothing		%> 		          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b>Totale</b></td>             <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b><%=formatcurrency(totale_fatture,0)%></b></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b><%=formatcurrency(totale_ordini,0)%></b></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b><%=formatcurrency(totale_materiali,0)%></b></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b><%=formatcurrency(totale_fatture-totale_materiali,0)%></b></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b><%=formatnumber((totale_fatture-totale_materiali)/totale_fatture*100,2)%></b></td>          </tr>        </table>		<%end if%>	<%if mese>0 then%>	          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="8" class="ui-widget-header">Mese di <%=nome_mese(mese)%> anno <%=anno%></td>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;" align="center">Fattura</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>             <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Importo Fattura</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Importo totale ordini</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Conteggio ordini</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Costo totale</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Margine lordo</td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;">Margine lordo &#37;</td>          </tr>		<%		sql="select fatture.IDFat, fatture.Nfat, fatture.data, fatture.iduser, fatture.causale, fatture.totale_fattura, fatture.trattamento_iva, subtot_fatture.ConteggioDiidord as conteggio_ordini, subtot_fatture.SommaDicosto_totordine as totale_materiali, subtot_fatture.SommaDiTotale as Totale_ordini FROM fatture INNER JOIN subtot_fatture ON fatture.IDFat = subtot_fatture.idfat WHERE ((Month(data)="&mese&") and (year(data)="&anno&"));"					set rs=conn.execute(sql)			totale_fatture=0			Totale_ordini=0			totale_materiali=0do while not rs.eofif isnull(rs("totale_materiali")) then	no_mlc=true	colore="bgcolor='#FFCCCC'"else	colore=""	no_mlc=false	totale_materiali_iva=rs("totale_materiali")*al_iva	totale_materiali=totale_materiali+totale_materiali_ivaend if			totale_fatture=totale_fatture+rs("totale_fattura")			Totale_ordini=Totale_ordini+rs("Totale_ordini")%>          <tr <%=colore%>>            <td style="border-bottom:1px solid;" align="center"><a href="pag_adm_fatture.asp?idfat=<%=rs("idfat")%>" target="_blank"><%=rs("nfat")%></a></td>             <td style="border-bottom:1px solid;"><%=formatDateTime(rs("data"), vbShortDate)%></td>             <td align="right" style="border-bottom:1px solid;"><%=formatcurrency(rs("totale_fattura"),0)%></td>            <td align="right" style="border-bottom:1px solid;"><%=formatcurrency(rs("Totale_ordini"),0)%></td>			<td align="right" style="border-bottom:1px solid;"><%=rs("conteggio_ordini")%></td>						<td align="right"  style="border-bottom:1px solid;"><%if no_mlc then%>N/D<%else%><%=formatcurrency(totale_materiali_iva,0)%><%end if%> </td>            <td align="right" style="border-bottom:1px solid;"><%if no_mlc then%>N/D<%else%><%=formatcurrency(rs("totale_fattura")-totale_materiali_iva,0)%><%end if%></td>            <td align="right" style="padding : 0 1 0 1; border-bottom:1px solid;"><%if no_mlc then%>N/D<%else%><%=formatnumber((rs("totale_fattura")-totale_materiali_iva)/rs("totale_fattura")*100,2)%><%end if%></td>          </tr>          <% 			  rs.movenext        loop%> 				          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b>Totale</b></td>             <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b><%=formatcurrency(totale_fatture,0)%></b></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b><%=formatcurrency(totale_ordini,0)%></b></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b><%=formatcurrency(totale_materiali,0)%></b></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b><%=formatcurrency(totale_fatture-totale_materiali,0)%></b></td>            <td align="right" bgcolor="#E5E5E5" style="border-bottom:1px solid;"><b><%=formatnumber((totale_fatture-totale_materiali)/totale_fatture*100,2)%></b></td>          </tr>        </table>		<%		set rs = nothing		end if		call connclose()		%>        <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>