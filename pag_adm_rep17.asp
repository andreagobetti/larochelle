<!--#include virtual="/setup.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()ordine=request.form("ordine")if ordine="" then	ordine="c"end ifordini=request.form("ordini")if ordini="" then	ordini="t"end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --><script>function aggiusta_amese(){	if (document.getElementById('AMESE').selectedIndex<document.getElementById('DAMESE').selectedIndex){	document.getElementById('AMESE').selectedIndex = document.getElementById('DAMESE').selectedIndex;	}}function aggiusta_damese(){	if (document.getElementById('AMESE').selectedIndex<document.getElementById('DAMESE').selectedIndex){	document.getElementById('DAMESE').selectedIndex = document.getElementById('AMESE').selectedIndex;	}}</script></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Elenco comuni clienti</a></div>        		<form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin:0px 0px 0px 0px;" >		<table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr >             <td colspan="4" style="border-bottom:1px solid;">              <select name="ordine" onChange="this.form.submit()">				<option value="c" <%if ordine="c" then response.write " selected" %>>Ordina per: Citt&agrave;</option>				<option value="u" <%if ordine="u" then response.write " selected" %>>Ordina per: Numero utenti</option>              </select>              <select name="ordini" onChange="this.form.submit()">				<option value="t" <%if ordini="t" then response.write " selected" %>>Con e senza ordini</option>				<option value="s" <%if ordini="s" then response.write " selected" %>>Solo con ordini</option>              </select>              <input type="submit" name="Submit" value="Aggiorna" style="FONT: 12px;">               </td>          </tr></table></form>        <%if true then%>		<%sql="SELECT i.Citta, Count(utenti.iduser) AS ConteggioDiiduser, Count(ordini.idord) AS ConteggioDiidord FROM utenti LEFT JOIN ordini ON utenti.iduser =ordini.iduser inner join utenti_intestazioni i on utenti.idintestazione = i.id WHERE ((utenti.Fornitore =0) AND i.citta <>  '' AND i.citta IS NOT NULL)"sql=sql&" GROUP BY i.Citta "if ordini="s" then	sql=sql& " having ConteggioDiidord>0 "end ifif ordine="c" then	sql=sql&" order by i.citta"elseif ordine="u" then	sql=sql&" order by ConteggioDiiduser desc, i.citta"end ifcall paginazione_start(sql,10000,"access")%>        <table width="100%" border="1" cellpadding="2" cellspacing="0" class="tabella1">          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Citta</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Numero utenti</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Numero ordini</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;"></td>          </tr>          <%iRecordsShown = 0totale=0solo_una_volta=trueDo While iRecordsShown < iPageSize And Not objPagingRS.EOF%>	          <tr <%=colore%>>            <td style="border-bottom:1px solid;"><input name="" type="checkbox" value=""></td>             <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("citta")%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("ConteggioDiiduser")%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=objPagingRS("ConteggioDiidord")%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"></td>          </tr>		  		  		  		            <% 			iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	set objPagingRS = Nothing	call paginazione_close()	call connclose()	%></table><%end if%>        <!-- FINE BLOCCO CENTRALE -->        <!-- Colonna CORPO FINE-->       <!-- Div Content FINE--></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html><%function formatDateTime_my(data,tipo)	if not isnull(data) then		formatDateTime_my=formatDateTime(data, tipo)	else		formatDateTime_my=""	end ifend function			%>