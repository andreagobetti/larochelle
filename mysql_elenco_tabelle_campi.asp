<!--#include virtual="/setup.asp" --><%				sql="SHOW TABLES"	set tables=conn.execute (sql)	do while not tables.eof	    response.write "<br>TABELLA: <b>"&tables("Tables_in_Sql886196_1")&"</b><br>"	    	    nome_tabella=tables("Tables_in_Sql886196_1")	    	        sql="select * FROM  "&nome_tabella	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 1, 3		n=rs.fields.count-1		Set Flds = rs.Fields		for i=0 to n			response.write RS.Fields(i).Name&" "			response.write tipovar(vartype(rs(i)))&"<br>"		next	   rs.close	    	    tables.MoveNext	loop										function tipovar(tipo)		select case tipo		case 0			tipovar="Empty (uninitialized)"		case 1			tipovar="Null (no valid data) "		case 2			tipovar="Integer"		case 3			tipovar="Long Integer"		case 4			tipovar="Single-precision floating-point number"		case 5			tipovar="Double-precision floating-point number"		case 6			tipovar="Currency"		case 7			tipovar="Date"		case 8			tipovar="String"		case 9			tipovar="Automation object"		case 10			tipovar="Error"		case 11			tipovar="Boolean"		case 12			tipovar="Variant (used only with arrays of Variants)"		case 13			tipovar="A data-access object"		case 14			tipovar="<b>Decimal subtype</b>"		case 17			tipovar="Byte"		case 8192			tipovar="Array"		case else			tipovar="Non riconosciuto: "&tipo		end Select																	end function			%>