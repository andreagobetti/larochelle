<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()if request.form("aggiorna")<>"" then	sql="UPDATE impostazioni SET "	sql= sql & " elencoum = '" & toglivcl(trim(request.form("elencoum"))) & "'"	sql= sql & ";"	conn.Execute (Sql)	call reconfig	response.redirect Request.ServerVariables("Script_Name")end ifsql="select impostazioni.* FROM impostazioni "set rs=conn.execute( sql)%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!--#include virtual="/sub_head.asp" --></head><body> <div id="wrap"><div id="header"><%=titolo_top%>        <!-- Div Content INIZIO-->      <%barra=0%>	  <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Unità di misura</a></div>        <!-- Colonna CORPO INIZIO-->        <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top: 0px;">        <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td valign="top">Elenco</td>            <td><%			elencoum=rs("elencoum")	txt=split(elencoum,vbcrlf)	row=ubound(txt)	%><textarea name="elencoum" cols="20" rows="<%=row+3%>" style="FONT: 12px;" ><%=elencoum%></textarea></td>          </tr>		  <tr>		  <td colspan="2"><input type="submit" name="Aggiorna" value="Aggiorna"></td>		  </tr>        </table>        </form>        <!-- Div Content FINE-->        <%	        set rs = Nothing	        call connclose()	        	        %></div><div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body></html>