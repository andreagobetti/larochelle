<!--#include virtual="/setup.asp" --><!--#include virtual="/multidict_cl.asp" --><!--#include virtual="/paginazione.asp" --><%if session("idadmin") = "" then call login()idgruppo=request("idgruppo")mese=request.form("mese")cercain=request("cercain")cerca=request("cerca")if mese="" then	mese="0"	anno=year(date())else	anno=request("anno")end if'response.write ucase(request.form("cf"))if request.querystring("cancella_report")<>"" then session("report")=""if request.form("nuovo")<>"" then	sql="select * FROM aggiungi_a_ordine "	Set rs = Server.CreateObject("ADODB.Recordset")	rs.Open sql, conn, 3, 3	rs.addnew	rs("nome_gruppo")=request.form("nome_gruppo")	rs.update	idgruppo=get_last_id("aggiungi_a_ordine")	rs.close	set rs = nothing	add2log "Aggiunto raggruppamento aggiungi a ordine eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]" ,2	oper="edit"end ifif request.Form("Aggiorna_elenco")<>"" then			Set rs = Server.CreateObject("ADODB.Recordset")			rs.Open "select aggiungi_a_ordine.* from aggiungi_a_ordine where idgruppo="&idgruppo,conn,1,3			rs("nome_gruppo")=request.form("nome_gruppo")			rs.update			rs.close			set rs = nothing			str_elenco=request.form("voci")			'response.write "<br>varianti:"&str_elenco&"<br>"		if str_elenco<>"" then			arr_varianti = split(str_elenco,", ")						'CARICO LE VARIANTI FORM IN DICT			Dim Dict    'The Dict Object			Dim Record    'The Record Object			Dim Field    'The Field Object			Set Dict = New MultiDimensionalDictionary 'Create an Instance of the Class						'response.write "trovate "& ubound(arr_varianti)&" varianti<br>"			for i = 0 to ubound(arr_varianti)					id=cint(arr_varianti(i))					'response.write "carico vara "&id&"<br>"					Dict.SetKey = id 'Key record					Dict.SetField "nome_voce", request.form("nome_voce_"&id)					'Dict.SetField "prezzo", request.form("prezzo_"&id)					'Dict.SetField "quantita", request.form("quantita_"&id)										'Dict.SetField "elimina", request.form("elimina_"&id)					Dict.Update 'Bind the record and preapre for the next record			Next			'Apro tabella varianti			set rs_var=Server.CreateObject("ADODB.Recordset")			rs_var.Open "select aggiungi_a_ordine_dett.* from aggiungi_a_ordine_dett where idgruppo="&idgruppo, conn, 1, 3			ordine=0			do while not rs_var.eof				id=cint(rs_var("id"))					str_add2log= str_add2log& "Analizzo quantita id: "&id&"  "&dict.item(id,"quantita")&"<br>"				if dict.item(id,"nome_voce")=""  then					str_add2log= str_add2log& "Eliminato voce: "&id&"<br>"					rs_var.delete				else									rs_var("nome_voce")=dict.item(id,"nome_voce")					rs_var.update					str_add2log= str_add2log& "Aggiornato voce: "&id&"<br>"				end if				rs_var.movenext				ordine=ordine+1			loop			rs_var.close			set rs_var=nothing		end if		'Aggiunta varianti nuove		str_elenco_new=request.form("voci_new")		'response.write "varianti_a_new:"&str_elenco_new&"<br>"		if str_elenco_new<>"" then			set rs_var=Server.CreateObject("ADODB.Recordset")			rs_var.Open "select aggiungi_a_ordine_dett.* from aggiungi_a_ordine_dett where idgruppo="&idgruppo,conn,1,3			arr_varianti_new = split(str_elenco_new,", ")						for i = 0 to ubound(arr_varianti_new)				id=arr_varianti_new(i)				if request.form("nome_voce_new_"&id)<>"" then					rs_var.addnew					rs_var("idgruppo")=idgruppo					rs_var("nome_voce")=request.form("nome_voce_new_"&id)					rs_var("quantita")=-1					rs_var("ordine")=i+ordine					rs_var.update					str_add2log= str_add2log& "Aggiunto voce: "&request.form("nome_voce_new_"&id)&"<br>"				end if			next			set dict=nothing			rs_var.close			set rs_var=nothing		end if		numrec=clng(conn.execute("select count(*) from aggiungi_a_ordine_dett where idgruppo="&idgruppo)(0))		if numrec=0 then			conn.execute ("delete from aggiungi_a_ordine where idgruppo="&idgruppo)				end if				add2log str_add2log,1'GESTIONE VARIANTE A FINEend ifif oper="" then	oper=request("oper")	select case oper		case "annulla"			oper="view"		case "new"			oper="new"		case "aggiungi"			oper="add"		case "modifica"			oper="update"		case "delete_pro"			sql="UPDATE prodotti SET aggiungi_a_ordine=0 WHERE idpro="&request("id_pro")			conn.execute sql			call elenco_prodotti(true,idgruppo)			response.end		case "add_pro"			sql="UPDATE prodotti SET aggiungi_a_ordine="&idgruppo&" WHERE idpro="&request("id_pro")			conn.execute sql			call elenco_prodotti(true,idgruppo)			response.end				case else			oper="view"			if request.form("modifica")<>"" then				oper="edit"				idgruppo=request.form("modifica")			end if			if request.querystring("idord")<>"" then				 oper="edit"				 idord=request.querystring("idord")			end if			if isnumeric(request.form("cerca")) and (request.form("cercain")="" or request.form("cercain")="idord") and request.form("cerca")<>"" then				oper="edit"				nord=request.form("cerca")			end if	end selectend ifif oper="add" or oper="update" then	'controlliend iftabella="ordini"tabellaid="idord"display_none="display:none;"if request("anno")="" then	anno=year(date())else	anno=request("anno")end if%><!--#include virtual="/regioni_inc.asp" --><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml">  <head>  <title><%=application("brwstitle")%></title>  <meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />  <!--#include virtual="/sub_head.asp" -->  <script type="text/javascript" language="javascript"><%=script_errore%>function Valida_ricerca() {		if ((document.form1.cercain.value == 'idord' )&&(document.form1.cerca.value == '')) {		alert("Inserire il numero ordine nella casella cerca.");		document.form1.cerca.focus();		return false;	}	if ((document.form1.cercain.value == 'iduser' )&&(document.form1.cerca.value == '')) {		alert("Inserire id cliente nella casella cerca.");		document.form1.cerca.focus();		return false;	}	if ((document.form1.cercain.value == 'azienda' )&&(document.form1.cerca.value == '')) {		alert("Inserire il nome azienda nella casella cerca.");		document.form1.cerca.focus();		return false;	}	document.form1.submit();} function Valida_crea_ordine() {		if (document.form1.cerca_iduser.value == '' ) {		alert("Selezionare un cliente");		document.form1.cerca.focus();		return false;	}	document.form1.operazione.value='crea_ordine';	document.form1.submit();} </script>  <script Language="JavaScript"> annulla=false;function Validator(theForm) {if (annulla==true)  { 	return(true);      }    return (true); } </script>  <style type="text/css"><!--.piccolo {	font-size: 9px;}.pulsanti {	padding: 3px;	overflow: visible;	margin: 1px;	font-size: 10px;}span.red {	color: red;}-->  </style>  <style>.ui-menu {	position: absolute;	width: 200px;	font-size: 8px;}#apDiv1 {	position: absolute;	width: 200px;	height: 115px;	z-index: 1;}.div_icona {display: inline-block; float:left;}.right{ float:right;}  </style>  </head>  <body>  <div id="wrap">    <div id="header"> <%=titolo_top%>       <!-- Box CORPO INIZIO-->      <%barra=4%>      <div id="barra_fissa">         <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>"> Aggiunta automatica voci a ordine</a></div>      </div>      <form id="form1" name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;" onSubmit="return Validator(this)">        <!-- Box CORPO INIZIO-->        <input type="hidden" name="operazione">               <%if oper="view" then		sql="select aggiungi_a_ordine.* FROM aggiungi_a_ordine  "		sql="select aggiungi_a_ordine.idgruppo, aggiungi_a_ordine.Nome_gruppo, Count(prodotti.IDpro) AS ConteggioDiIDpro FROM aggiungi_a_ordine LEFT JOIN prodotti ON aggiungi_a_ordine.idgruppo = prodotti.aggiungi_a_ordine GROUP BY aggiungi_a_ordine.idgruppo, aggiungi_a_ordine.Nome_gruppo"				if cerca<>"" and isnumeric(cerca) and cercain="" then cercain="idord"		order= " order by aggiungi_a_ordine.descrizione "		where_fisso = "  "		where_anno  = "   "		ordine=" order by aggiungi_a_ordine.descrizione "		'-----------sezione ricerca inizio		if request.form("cerca_iduser")<>"" and request.form("elimina")="" and cercain<>"niente" then			cercain="iduser"			cerca=request.form("cerca_iduser")		end if		if request("iduser")<>"" and request.form("elimina")="" and cercain<>"niente" then			cercain="iduser"			cerca=request("iduser")		end if		if request("ffm")<>"" then			cercain="finemese"			fine_mese=true		end if				if cercain<>"" then			select case cercain			case "a"				where=" stato=0"				where_anno=""			end select			where=where_fisso&" and "&where&where_anno					else	'nessun parametro di ricerca allora applico filtro anno			where=where_fisso& where_anno		end if		if where<>"" then where=" where "&where		'-----------sezione ricerca fine		'add2log strsql,1		'response.write strSql						%>        <table width="100%" border="0" cellpadding="2" cellspacing="0" bordercolor="#CCCCCC" class="tabella1">          <tr>            <td colspan="3">Nuovo raggruppamento              <input type="text" name="nome_gruppo" />              <input type="submit" name="nuovo" value="Nuovo" style="FONT: 12px;"  id="nuovo"></td>          </tr>          <tr>            <td align="center" bgcolor="#E5E5E5"><p>Modifica</p></td>            <td align="center" bgcolor="#E5E5E5">Nome gruppo</td>            <td bgcolor="#E5E5E5">prodotti</td>          </tr>          <%call paginazione_start(sql,20,"access")Do While iRecordsShown < iPageSize And Not objPagingRS.EOF%>          <tr class=coprobox <%=colore%>>            <td align="center" style="border-top:1px solid;"><input type="radio" name="modifica" value="<%=objPagingRS("idgruppo")%>" onClick="this.form.submit()"></td>            <td align="center" style="border-top:1px solid;"><%=objPagingRS("nome_gruppo")%></td>            <td style="border-top:1px solid;"><%=objPagingRS("ConteggioDiIDpro")%>          </tr>          <% 			iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown		objPagingRS.MoveNext	Loop	call paginazione_end(3,true)	%>                            </table>        <%else		cancellabile=true		cambia_stato=true		sql1="select aggiungi_a_ordine.* FROM aggiungi_a_ordine where idgruppo="&idgruppo 		Set rs1 = Server.CreateObject("ADODB.Recordset")		rs1.open sql1,conn,3,3        sql="select * FROM aggiungi_a_ordine_dett where idgruppo="&idgruppo &" order by ordine;"		set rs=conn.execute(sql)		if rs.eof then fase="due"%>        <table width="100%" border="1" cellpadding="0" cellspacing="0" bordercolor="#E5E5E5" class="tabella1">          <tr>            <td class="ui-widget-header">Gruppo <input type="text" name="nome_gruppo" value="<%=rs1("nome_gruppo")%>" title="Svuota il campo per eliminare il gruppo"/>              <input name="idgruppo" type="hidden" value="<%=idgruppo%>" id="idord">            </td>          </tr>        </table>        <%	    set rs1 = Nothing	        %>        <!-- DETTAGLIO ORDINE -->        <input type="hidden" name="ordinati" id="ordinati" />        <table width="100%" border="1" cellpadding="0" cellspacing="0" bordercolor="#E5E5E5" class="tabella1" id="tab_articoli">          <tbody id="tab_articoli_testa">          <tr>            <td class="ui-widget-header">Voci da aggiungere all'ordine:</td>          </tr>          </tbody>          <tbody id="tab_articoli_body">          <%totord=0	  do while not rs.eof				%>          <tr>            <td style="border-bottom: 1px solid gray;"><input type="hidden" name="voci"  value="<%=rs("id")%>">              <input type="text" name="nome_voce_<%=rs("id")%>" value="<%=rs("nome_voce")%>" style="width:99%;" class="chkchge" title="Svuota il campo per eliminare la voce">            </td>            </tr>          <%			'totord=totord+round(prezzoeff*rs("quantita"),2)            rs.movenext			loop			Set rs = Nothing			%>          <tr>            <td style="border-bottom: 1px solid gray;"><input type="hidden" name="voci_new"  value="1">              <input type="text" name="nome_voce_new_1" value="" style="width:99%;" class="n_riga" title="Compila il campo vuoto per aggiungere una nuova voce">            </td>            </tr>          </tbody>          <tr valign="middle" align="right">            <td colspan="2" align="center" style="border-bottom: 1px solid gray; background: #E5E5E5; padding-top: 3px; padding-bottom:3px;"><input type="submit" name="Aggiorna_elenco" id="Aggiorna_elenco" value="Aggiorna elenco"></td>          </tr>        </table>        <!-- Dettaglio ordine ARTICOLI ORIGINALI-->       <%		call elenco_prodotti(false,idgruppo)call connclose()%>Aggiungi articoli a questo gruppo<input type='hidden' name='idpro' id='idpro' style="width:350px;" /> <script>$(function() {	$( "input" ).tooltip();	var new_id=1;function aggiungi_riga(){	$( ".n_riga" ).blur(function() {		var pieno = true;		$(".n_riga").each(function () {			if ($(this).val() == "") {				pieno = false;			}		});		if (pieno)		{			new_id++;			$( "#tab_articoli_body" ).append(nuova_riga(new_id));		}	aggiungi_riga();	});}aggiungi_riga();function nuova_riga(id)	{		return '<tr><td style="border-bottom: 1px solid gray;"><input type="hidden" name="voci_new"  value="'+id+'"><input type="text" name="nome_voce_new_'+id+'" value="" style="width:99%;" class="n_riga"</td></tr>';	}});	$('#idpro').select2({		placeholder: 'Seleziona articolo',		minimumInputLength: 3,		allowClear: true,		ajax: {			quietMillis: 150,			url: "ajax_function.asp?select2=articoli_sel2",			dataType: 'json',			data: function (term, page) {				return {					term: term				};			},			results: function (data) {				return {					results: data				};			}		}	});</script><%end if%>      </form>      <!-- Box CORPO FINE-->     </div>    <div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" -->  </div></body></html><%function zero (numero)	if isnull(numero) then		zero="#"	else		zero=numero	end ifend functionfunction elenco_prodotti(aggiorna,idgruppo)		 sql="select * from prodotti where aggiungi_a_ordine="&idgruppo'response.write sqlset rs=conn.execute(sql)if not rs.eof thenif not aggiorna then%><script>	$(function() {			$(".delete_file" ).button({icons: {primary: "ui-icon-trash"},text: false});			$("#tr_allegati<%=tipo_allegato%>").show();function delete_prodotto(){						 $(".delete_file").on("click", function (e) {				var id_pro=$(this).closest("span").attr("id").substring(8);				$.ajaxSetup({ cache: false });				$.get("<%=questofile%>?oper=delete_pro&id_pro="+id_pro+"&idgruppo=<%=idgruppo%>", function(result){				//alert("qui");				if (result.search("errore")!=-1)				{					toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};					toastr.error(result);				}				else				{					$("#Elenco_prodotti").replaceWith(result);					$(".delete_file" ).button({icons: {primary: "ui-icon-trash"},text: false});					delete_prodotto();					toastr.options = {"positionClass": "toast-bottom-right"};					toastr.success("Articolo rimosso dal gruppo.");				}					//$("#Aggiorna_ordine").trigger("click");				});								});}				$("#idpro").on('change', function (e) {				var id_pro = $("#idpro").select2('data').id;				$.ajaxSetup({ cache: false });				$.get("<%=questofile%>?oper=add_pro&id_pro="+id_pro+"&idgruppo=<%=idgruppo%>", function(result){				//alert("qui");				if (result.search("errore")!=-1)				{					toastr.options = {"positionClass": "toast-bottom-right","timeOut": "0","extendedTimeOut": "0", "closeButton": true};					toastr.error(result);				}				else				{					$("#Elenco_prodotti").replaceWith(result);					$(".delete_file" ).button({icons: {primary: "ui-icon-trash"},text: false});					delete_prodotto();					toastr.options = {"positionClass": "toast-bottom-right"};					toastr.success("Articolo aggiunto al gruppo.");				}					//$("#Aggiorna_ordine").trigger("click");				});					});	delete_prodotto();	});	</script>    <%end if%>              <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1" id="Elenco_prodotti">            <tr>              <td  class="ui-widget-header">Articoli collegati al gruppo</td>            </tr>            <tr  id="tr_allegati<%=tipo_allegato%>">              <td><%	do until rs.EOF%><span id="id_file_<%=rs("idpro")%>"><%=rs("codice")%><a class=" delete_file" >Cancella</a>&nbsp;&nbsp;</span><%	rs.movenext	loop	rs.close	%></td></tr></table><%end if	Set rs = Nothingend function%>