<!--#include virtual="/setup.asp" --><!--#include file="JSON_latest.asp"--><%if request("cosa")="codiceunico" then	sql="select * from prodotti where codice = '"&request("term")&"' and idpro<>"&request("idpro")	set rs=conn.execute(sql)	if (not rs.eof) then response.write "false" else response.write "true"	'session("test_autocomplete")="record:"&i	response.endend ifResponse.ContentType = "application/json; charset=utf-8"'Response.ContentType = "text/html"'Response.AddHeader "Content-Type", "application/json;charset=UTF-8"Response.CodePage = 65001'Response.CharSet = "UTF-8"	if request("cosa")="categorie" then			Set Js = jsArray()			sql="select categorie.* from categorie "			sql="select categorie.IDcat, categorie.categoria, categorie.idpadre, Count(prodotti.IDpro) AS ConteggioDiIDpro FROM categorie LEFT JOIN prodotti ON categorie.IDcat = prodotti.idcat GROUP BY categorie.IDcat, categorie.categoria, categorie.idpadre "			set rs=conn.execute(sql)			do while (not rs.eof) 				Set Js(Null) = jsObject()				Js(null)("nome")=rs("categoria")				Js(null)("idcat")=rs("idcat")				Js(null)("idpadre")=rs("idpadre")				Js(null)("conteggio")=rs("ConteggioDiIDpro")				rs.movenext			loop	end if	if request("cosa")="log" then			Set Js = jsArray()			sql="select log.* from log order by data desc limit 0,100"			set rs=conn.execute(sql)			do while (not rs.eof) 				Set Js(Null) = jsObject()				Js(null)("data")=rs("data")				Js(null)("evento")=rs("evento")				Js(null)("causale")=rs("causale")				rs.movenext			loop	end if	set rs=nothing	conn.close	set conn=nothing	js.Flush%>