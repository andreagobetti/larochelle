<!--#include virtual="/setup.asp" --><!--#include virtual="/pag_adm_ordini_inc.asp" --><!--#include virtual="/pag_adm_fatture_for_inc.asp" --><%if session("idadmin") = "" then call login()damese=request.form("damese")amese=request.form("amese")anno=request.form("anno")if not tdebug then	Response.ContentType = "application/vnd.ms-excel"else	Response.ContentType = "text/html"end ifif not tdebug then Response.AddHeader "content-disposition", "attachment; filename=fatture_fornitori_"&nome_mese(damese)&"_"&nome_mese(amese)&"_"&anno&".xls"if damese="" then	damese=month(date())end ifif amese="" then	amese=month(date())end ifif anno="" then	anno=year(date())end ifsql="select fatture_for.IDfat, fatture_for.Nfat, utenti.Azienda, utenti.Cognome, utenti.Nome, fatture_for.data, utenti.iduser, utenti.provincia, fatture_for.totale_fattura, fatture_for.pagamento, fatture_for.conto FROM utenti INNER JOIN fatture_for ON utenti.iduser = fatture_for.idfor "sql=sql & "where month(fatture_for.data)>="&damese &" and month(fatture_for.data)<="&amese &" and year(fatture_for.data)="&annofiltro_iva=request("iva")colspan=7'Selezione PROVINCIAconto_v=request("conto")if conto_v="rag" then	raggruppa_testa=true	raggruppa_coda=true	raggruppa="conto"	ordine=" order by conto, fatture_for.data"elseif conto_v<>"" then	raggruppa_testa=true		sql=sql& " and conto="&conto_v&""	ordine=" order by fatture_for.data"else	ordine=" order by fatture_for.data"end if'response.write strSqlrs.Open sql&ordine, conn, 3, 3%>        <table width="100%" border="1" cellpadding="2" cellspacing="0" class="tabella1">          <tr>             <td colspan="<%=colspan%>" class="ui-widget-header">fatture fornitore dal mese di <%=nome_mese(damese)%>&nbsp;al mese di <%=nome_mese(amese)%>&nbsp;<%=anno%>: <%=rs.recordcount%> elementi</td>          </tr>          <tr>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;</td>             <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Fatt.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Data</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">ID Cli.</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Nominativo</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Tot. fattura</td>            <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Tipo conto</td>          </tr>          <%Totale=0conto_tmp=0Do While Not rs.EOF	totale=totale+rs("totale_fattura")         if raggruppa_coda_tmp and conto_tmp<>rs("conto") then%>                        <tr>                        <td colspan="5"><b>Totale conto</b></td>            <td  align="right"><strong><%=formatnumber(totale_conto,2)%></strong></td>                       <td colspan="<%=colspan-6%>"></td>          </tr>          <%	totale_conto=0	raggruppa_coda_tmp=false	totale_iva2=0	totale_iva=0		  end if		  	totale_conto=totale_conto+rs("totale_fattura")if ((raggruppa<>"" or raggruppa_testa) and conto_tmp<>rs("conto"))  then%> <tr>             <td bgcolor="#E5E5E5" colspan="<%=colspan%>" ><b><%=conto(rs("conto"))%></b></td>          </tr><%	conto_tmp=rs("conto")	if raggruppa_coda then raggruppa_coda_tmp=trueend if%>          <tr>            <td style="border-bottom:1px solid;"><input name="" type="checkbox" value=""></td>             <td style="border-bottom:1px solid;"><%=rs("NFAT")%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=formatDateTime(rs("data"), vbShortDate)%></td>            <td style="padding : 0 1 0 1; border-bottom:1px solid;"><%=rs("iduser")%></td>            <td nowrap style="border-bottom:1px solid;"><%=rs("azienda")%></td>            <td align="right" class="corpobox" style="border-bottom:1px solid;"><%=formatnumber(rs("totale_fattura"),2)%></td>		            <td style="border-bottom:1px solid;" class="corpobox"><%=conto(rs("conto"))%></td>          </tr><% 		iRecordsShown = iRecordsShown + 1 ' Increment the number of records we've shown	rs.MoveNextLoop         if raggruppa_coda_tmp then%>                        <tr>                        <td colspan="5"><b>Totali conto</b></td>            <td  align="right"><strong><%=formatnumber(totale_conto,2)%></strong></td>                      <td colspan="<%=colspan-6%>"></td>          </tr>          <%	totale_conto=0	raggruppa_coda_tmp=false	totale_iva2=0	totale_iva=0		  end if%>              <tr>            <td colspan="<%=colspan%>" align="right"><strong>Totale fatture fornitori: <%=formatnumber(totale,2)%></strong></td>          </tr>              </table>              <%if request.querystring("idlog")<>"" then%> <a href="<%=Request.ServerVariables("Script_Name")%>"><b>Visualizza               tutti</b></a> <%end if%> </td>          </tr>        </table>        <%	        	        call rsclose()	        %>