<!--#include virtual="/setup.asp" --><%if session("idadmin") = "" then call login()%><%oper=request.form("oper")if request.form("elimina")<>"" then		Set rs = Server.CreateObject("ADODB.Recordset")		rs.Open "select * FROM tags WHERE idtag=" & request.form("idtag")  , conn, 3,2		add2log "Eliminato [tags="&rs("idtag")&"]"&rs("nometag")&"[/nome] eseguito da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",3		rs.delete		rs.close		response.redirect questofileend ifselect case lcase(request("oper"))	case "annulla"		oper="view"	case "new"		oper="new"	case "aggiungi"		oper="add"	case "modifica"		oper="update"	case "riordina_az"		call riordina_az(0,0)		oper="view"	case "edit"		oper="edit"		idtag=request("idtag")	case else	if request("modifica")<>"" then				oper="edit"		idtag=request("modifica")	else		oper="view"	end ifend selectif oper="add" or oper="update" then	if request.form("nometag")="" then		error="Inserire il nome della nome"		oper="edit"	end ifend ifif oper="add" or oper="update" then	idpadre=request.form("idpadre")	if idpadre="" then idpadre=0	sql="select * from tags"	Set rs = Server.CreateObject("ADODB.Recordset")	if oper="add" then		rs.Open sql, conn, 3, 3		rs.addnew	else		sql= sql & " where idtag=" & request.form("idtag")		rs.Open sql, conn, 3, 3	end if	rs("nometag")=request.form("nometag")	rs("testo")=request.form("testo")	rs("tipo")=request.form("tipo")	rs.update	if oper="add" then		txt= "Aggiunto"	else		txt= "Modifica"	end if	add2log txt&" [tags="&rs("idtag")&"]"&rs("nometag")&"[/nome] eseguita da [admin="&session("idadmin")&"]"&session("nominativo")&"[/admin]",2	rs.close	'call imposta_modello()	oper="view"end if%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml"><head><title><%=application("brwstitle")%></title><meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/><!-- Stile: <%=Application("skins")%> --><!--#include virtual="/sub_head.asp" --><%if oper="view" then%><script>	 function copyToClipboard (text) {	     window.prompt ("Premi Ctrl+C per copiare", "/category.asp?"+text);	 }</script><%end if%><%if oper<>"view" then%>	<script>	$(function() {		$( "input" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });		$( "select" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });		$( "textarea" ).tooltip({position: { my: 'left center',   at: 'right center'  }  });	});		</script>    	<style>	label {		display: inline-block;		width: 5em;	}	</style><%end if%></head><body> <div id="wrap"><div id="header"><%=titolo_top%> <%barra=0%>	<div id="barra_fissa"> <!--#include virtual="/sub_barra_adminsf2.asp" -->        <div class="ui-widget-header ui-corner-all titolo_admin"><a href="<%=questofile%>">Tags</a></div></div>        <!-- Colonna CORPO INIZIO-->        <font color="#FF0000"><b><%=error%></b></font>                 <form name="form1" method="post" action="<%=Request.ServerVariables("Script_Name")%>" style="margin-top:0px;">        <%if oper="view" then%>          <%sql="select tags.IdTag, tags.NomeTag, Count(prodotti_tags.Id) AS ConteggioDiId FROM tags LEFT JOIN prodotti_tags ON tags.IdTag = prodotti_tags.IdTag GROUP BY tags.IdTag, tags.NomeTag order by nometag"if oper="view" then%>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr align="right">               <td colspan="2" style="border-bottom:1px solid;"><a href="<%=questofile%>?oper=new"><strong>Aggiungi tag</strong></a></td>            </tr>            <tr>               <td width="10" align="center" nowrap bgcolor="#E5E5E5" style="border-bottom:1px solid;">&nbsp;Modifica&nbsp;</td>              <%end if%>              <td bgcolor="#E5E5E5" style="border-bottom:1px solid;">Tag</td>            </tr>            <%	set rs=conn.execute(sql)	do until rs.EOF%>            <tr>               <td align="center" style="border-bottom:1px solid;"> <input type="radio" name="modifica" value="<%=rs("idtag")%>" onClick="this.form.submit()">               </td>              <td style="border-bottom:1px solid;"><%=rs("nometag")%> (<%=rs("ConteggioDiId")%> articoli)</td>            </tr>            <%	rs.movenext	loop	rs.close	%>          </table>          <%else          sql="select * from tags where (((tags.idtag)=" & idtag & "));"	if oper="edit" then		set rs=conn.execute(sql)		testo= "Modifica elemento"	else		testo= "Nuova elemento"	end if%>		<form name="form1" method="post" action="<%=questofile %>" style="margin-top:0px;" <%if oper<>"view" then%> onSubmit="return Validator(this)"<%end if %>>          <table width="100%" border="0" cellpadding="2" cellspacing="0" class="tabella1">            <tr>               <td colspan="2" valign="top" class="ui-widget-header"><%=testo%></td>            </tr>            <tr>               <td valign="top">Nome</td>              <td> <input type="hidden" name="idtag" value="<%=idtag%>">                 <%if error<>"" then			  		testo=request.form("nometag")				elseif oper="edit" then					testo=rs("nometag")			  	elseif oper="new" then			  		testo=""				end if%> <input name="nometag" type="text" class="richiesto" title="Nome, campo obbligatorio" value="<%=testo%>" size="40">               </td>            </tr>            <tr>               <td valign="top">Testo</td>              <td>                 <%if error<>"" then			  		testo=request.form("testo")				elseif oper="edit" then					testo=rs("testo")			  	elseif oper="new" then			  		testo=""				end if%>				<textarea name="testo" id="testo" class="mceEditor"  rows="6" style="width:100%; height: 400px;"><%=testo%></textarea>				<script language="javascript" type="text/javascript" src="jquery/js/tinymce/tinymce.min.js"></script><script>/* Configurazione 4 per: 	setup.asp							pag_adm_artic.aspAbilitato codemirror														 */tinyMCE.init({	forced_root_block : "", force_br_newlines : false, force_p_newlines : false, //Evita tags p	language : 'it',	selector:"textarea.mceEditor",	statusbar: false, 	toolbar_items_size: 'small',	auto_focus : false,	plugins: [ 	"advlist autolink lists link image charmap print preview hr anchor pagebreak",	"searchreplace wordcount visualblocks visualchars code fullscreen",	"insertdatetime media nonbreaking save table contextmenu directionality",	"paste textcolor responsivefilemanager youtube textcolor codemirror"	],	toolbar1: "insertfile undo redo | styleselect fontsizeselect | bold italic forecolor | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image youtube | code",	image_advtab: true ,	    font_size_style_values: "12px,13px,14px,16px,18px,20px",		external_filemanager_path:"/filemanager123/",	filemanager_title:"Responsive Filemanager" ,	external_plugins: { "filemanager" : "/filemanager123/plugin.min.js"},    codemirror: {    indentOnInit: true, // Whether or not to indent code on init.     path: 'CodeMirror', // Path to CodeMirror distribution    config: {           // CodeMirror config object       //mode: 'application/x-httpd-php',       lineNumbers: true,       indentWithTabs:true    },    jsfiles: [          // Additional JS files to load       'mode/clike/clike.js',       'mode/php/php.js'    ]  }	});</script>              </td>            </tr>            <tr>               <td valign="top">Tipo</td>              <td>                 <%if error<>"" then			  		testo=request.form("tipo")				elseif oper="edit" then					testo=rs("tipo")			  	elseif oper="new" then			  		testo=0				end if%> <select name="tipo">					<option value="0" <%if testo=0 then response.write "selected"%>>Non specificato</option>					<option value="1" <%if testo=1 then response.write "selected"%>>Materiale</option>									</select>               </td>            </tr>                                    <%			if oper="edit" then				testo=""			cancellabile=true			num=clng(conn.execute("select Count(*) AS num FROM prodotti_tags where idtag="& idtag &";")(0))		if num>0 then			testo=testo&"Questo tag è associato a <b>"&num&"</b> articoli."		end if					if testo<>"" then			%>            <tr>              <td colspan="2" align="center" valign="top"><%=testo%></td>            </tr>            <%end if			end if%>            <tr>              <td colspan="2" align="center" valign="top"><%if oper="view" then	txt=puls_newelseif oper="new" or error<>"" then	txt="Aggiungi"elseif oper="edit" then	txt="Modifica"end if%>    <input type="submit" name="oper" value="<%=txt%>">    <%if oper<>"view" then%>    <input type="submit" name="oper" value="Annulla" onClick="annulla=true;">    <%end if%>    <%if oper="edit" and cancellabile=true and error="" then%>    <input type="submit" name="elimina" value="Elimina">    <%end if%></td>            </tr>          </table></form>         <%end if	Set rs = Nothing	call connclose()%>        <!-- Colonna CORPO FINE-->      </div>    <div id="footer"></div><!--#include virtual="/pag_adm_footer_inc.asp" --></div></body>	<script>	 function copyToClipboard (text) {	     window.prompt ("Premi Ctrl+C per copiare", text);	     return false;	 }	 </script></html><%sub mappacat(layer,id,testo,testo_dopo)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id		sql_order="select tags.Idtag, tags.Nometag, tags.idpadre, Count(tags_1.idtag) AS ConteggioDiid FROM tags LEFT JOIN tags AS tags_1 ON tags.Idtag = tags_1.IdPadre GROUP BY tags.Idtag, tags.Nometag, tags.idpadre  HAVING (((tags.idpadre)=" & id & ")) ORDER BY tags.nometag"	sql_order="select tags.idtag, tags.nometag, tags.idpadre, Count(prodotti_tags.IdTag) AS ConteggioDiIdTag FROM tags LEFT JOIN prodotti_tags ON tags.idtag = prodotti_tags.idtag GROUP BY tags.idtag, tags.nometag, tags.idpadre HAVING (((tags.idpadre)=" & id & ")) order by tags.nometag"	rs_order.open sql_order,conn	nodo=true	testo=testo&testo_dopo	testo_dopo=""	if not 	rs_order.eof then 		if layer>0 then testo=testo& "<ol>"	else		nodo=false	end if	do until rs_order.eof		'if rs_order("conteggiodiidpro")=0 and rs_order("ConteggioDiid")=0 then classe="" else classe=""		testo=testo&  "<li id=""id_"&rs_order("idtag")&""""&">"		testo_dopo="<div style="""&classe&"""><span class=""disclose""><span></span></span><span class=""testo"">"&rs_order("nometag")&"</span><span style=""float:right; text-align:right;"">"		testo_dopo=testo_dopo&"<button style=""font-size:9px;"" onclick=""window.location.href='"&questofile&"?oper=edit&idtag="&rs_order("idtag")&"'"">Modifica</button>"		testo_dopo=testo_dopo&"<button style=""font-size:9px;"" onclick=""copyToClipboard('idtag="&rs_order("idtag")&"');"">Copia link</button>"		'if rs_order("conteggiodiidpro")>0 then testo_dopo=testo_dopo&"<br><button style=""font-size:9px;"" onclick=""window.location.href='pag_adm_artic.asp?oper=view&id="&rs_order("idtag")&"'"">Vedi articoli</button>"		testo_dopo=testo_dopo&"</span><br>&nbsp;&nbsp;"&rs_order("ConteggioDiIdTag")&" articoli"		testo_dopo=testo_dopo&"</span><br>&nbsp;&nbsp;"		'if rs_order("ConteggioDiidtag")>0 then testo_dopo=testo_dopo&" - "&rs_order("ConteggioDiidtag")&" sottospecie"		testo_dopo=testo_dopo&"</div>"		'calling again to find more childs - if not rs_order=nothing	    call mappacat(layer+1,rs_order("idtag"),testo,testo_dopo)	'testo=testo& "</li>"&vbcrlf		rs_order.movenext	loop	if nodo=true and layer>0 then testo=testo& "</ol>"&vbcrlf	'closing object	rs_order.close	set rs_order=nothing	if layer=0 then response.write testoEnd Sub	sub mappacatselezione(layer,idtag,val,escludi)	'declaring	dim sql_order,str,MessageSpacing,mesid,spaceing,tid	'create recordset	set rs_order=server.createObject("adodb.recordset")	'find child with thread_parent=his parent id	if escludi="" then escludi=0	sql_order = "select * FROM tags WHERE idpadre = " & idtag &" and idtag<>"&escludi&" order by nometag;"	rs_order.open sql_order,conn	nodo=true	do until rs_order.eof		spaceing=""		'this actually looking for 1,2,3 space		'if it's doesn't find it's eof - if not it makes spaces as needed		for MessageSpacing=1 to layer			spaceing=spaceing & "&nbsp;&nbsp;&nbsp;&nbsp;"		next				response.write "<option value=""" & rs_order("idtag") &""""		if int(val)=int(rs_order("idtag")) then response.write " selected"		response.write ">" &spaceing& rs_order("nometag")& "</option>"				'calling again to find more childs - if not rs_order=nothing	    call mappacatselezione(layer+1,rs_order("idtag"),val,escludi)		rs_order.movenext	loop	'closing object	rs_order.close	set rs_order=nothingEnd Sub	sub imposta_modello()	dim rs_tags	set rs_tags=server.createObject("adodb.recordset")	rs_tags.open "select tags.* from tags " ,conn,1,3	do while not rs_tags.EOF		set rs_ricerca=conn.execute ("select tags.* from tags where idpadre="&rs_tags("idtag"))		rs_tags("figlio")=rs_ricerca.eof		if rs_tags("idpadre")>0 then			str=cerca_nonno(rs_tags("idpadre"),str)			'response.write str&"<br>"			str=split(str,"|")			rs_tags("idnonno")=str(0)			rs_tags("NomeConParenti")=str(1)&" "&rs_tags("nometag")		else			rs_tags("idnonno")=0			rs_tags("NomeConParenti")=""		end if		rs_tags.Update 		rs_tags.MoveNext	loop	set rs_tags=nothingend sub		function cerca_nonno(id,tmp)	dim rs_modello	set rs_modello=conn.execute ("select * FROM tags WHERE idtag = " & id&";")			if not rs_modello.eof then		tmp=cerca_nonno(rs_modello("idpadre"),rs_modello("idtag")&"|"&rs_modello("nometag"))	end if	cerca_nonno=tmp	set rs_modello=nothingEnd function%>